<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../.cultiway-dev.props" Condition="Exists('../../.cultiway-dev.props')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseAppHost>false</UseAppHost>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <GameRootPath Condition="'$(GameRootPath)' == ''">$(MSBuildThisFileDirectory)../../../../</GameRootPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- 测试入口避免使用 .cs 扩展名，防止游戏加载器把它当成模组源码。 -->
    <Compile Include="Program.test" />
    <Compile Include="SkillSettingsMigration.test" />
    <Compile Include="../../Source/Core/SkillLibV3/Blueprints/SkillBlueprintMigration.cs" />
    <Compile Include="../../Source/Core/SkillLibV3/Wanfa/Persistence/Migrations/WanfaPavilionV4ToV5.cs" />
    <Compile Include="../../Source/Core/SkillLibV3/Wanfa/Persistence/Migrations/WanfaPavilionV5ToV6.cs" />
    <Compile Include="../../Source/Content/Persistence/WorldObjectsV1ToV2.cs" />
    <Compile Include="../../Source/Content/Persistence/WorldObjectsV2ToV3.cs" />
    <Compile Include="../../Source/Core/Persistence/*.cs" Exclude="../../Source/Core/Persistence/WorldSaveCoordinator.cs" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameRootPath)/worldbox_Data/Managed/Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="Friflo.Json.Fliox.Annotation"><HintPath>../../Assemblies/Friflo.Json.Fliox.Annotation.dll</HintPath></Reference>
  </ItemGroup>
</Project>
