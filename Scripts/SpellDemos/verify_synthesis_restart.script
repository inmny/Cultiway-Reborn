// 真正重启后恢复逐部位生成结果、玩家修订和第四版未完成请求。
using System;using System.IO;using System.Linq;using System.Collections.Generic;using System.Threading.Tasks;using Newtonsoft.Json;using Newtonsoft.Json.Linq;using Cultiway.Const;using Cultiway.Core;using Cultiway.Core.Skills;using Cultiway.Content.Skills;using Cultiway.Utils.Extension;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/synthesis");var e=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));if((int)e["process"]==System.Diagnostics.Process.GetCurrentProcess().Id)throw new InvalidOperationException("需要真正退出并重启游戏");var checks=new List<string>();void Check(bool v,string n){if(!v)throw new InvalidOperationException(n);checks.Add(n);Log.Info(n);}JObject Canon(AbilityDefinition d){var j=JObject.Parse(JsonConvert.SerializeObject(d));j.Remove("Id");return j;}var runnerType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=runnerType.GetProperty("Instance").GetValue(null);async Task Boundary()=>await Game.WaitUntil(()=>(bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);async Task Advance(){Config.paused=false;double until=World.world.getCurWorldTime()+.15f;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;await Boundary();}bool enabled=GeneralSettings.EnableSkillSystems;
try{var stats=new BaseStats();stats.addTag("frozen_ai");stats.addTag("immovable");if(Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.SynthesisHold")==null)Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SynthesisHold").SetStats(stats).SetDuration(10000).Build();GeneralSettings.SwitchSkillSystems(false);Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();var author=World.world.units.get((long)e["author"]).GetExtend();var reader=World.world.units.get((long)e["reader"]).GetExtend();var waiting=World.world.units.get((long)e["waiting"]).GetExtend();var access=ConstructionEditing.Access;var original=e["original"].ToObject<AbilityDefinition>();var revised=e["revised"].ToObject<AbilityDefinition>();
Check(JToken.DeepEquals(JObject.Parse(JsonConvert.SerializeObject(access.Read(original.Id))),e["original"])&&JToken.DeepEquals(JObject.Parse(JsonConvert.SerializeObject(access.Read(revised.Id))),e["revised"]),"原始新树与玩家修订的全部结构、参数、名称和来源完整恢复");Check(ConstructedAbilityService.Knows(author,revised.Id)&&!ConstructedAbilityService.Knows(author,original.Id)&&ConstructedAbilityService.Knows(reader,original.Id)&&!ConstructedAbilityService.Knows(reader,revised.Id),"作者及其他读者的独立版本归属保持");var pending=waiting.GetComponent<ConstructedCreationState>();Check(pending.Pending&&pending.Inspiration.Rules==2&&JToken.DeepEquals(JObject.Parse(JsonConvert.SerializeObject(pending.Inspiration)),e["input"]),"第四版待处理请求保留新规则及完整输入");Check(pending.Resources!=null&&JToken.DeepEquals(JObject.Parse(JsonConvert.SerializeObject(pending.Resources)),e["resources"]),"受理时完整模型尺寸、制作坐标、挂点、动作及身体模板恢复");Check(JToken.DeepEquals(Canon(ConstructedAbilityService.Generate(waiting,pending.Seed,pending.Inspiration,pending.Source,pending.Resources)),Canon(e["pending"].ToObject<AbilityDefinition>())),"恢复后同一规则与种子生成同一完整结果");GeneralSettings.SwitchSkillSystems(true);await Advance();pending=waiting.GetComponent<ConstructedCreationState>();Check(!pending.Pending&&pending.LastFailure==null&&pending.Source==null&&pending.Resources==null&&access.List(waiting).Count==(int)e["known"]+1&&JToken.DeepEquals(Canon(access.Read(pending.LastAbility)),Canon(e["pending"].ToObject<AbilityDefinition>())),"实际共同周期只授予一次新结果，并释放待处理结构");string completed=pending.LastAbility;await Advance();Check(waiting.GetComponent<ConstructedCreationState>().LastAbility==completed&&access.List(waiting).Count==(int)e["known"]+1,"后续更新不重复创作或学习");Check(Cultiway.ModClass.I.WorldSaves.LastReport.Skipped.Count==0&&Cultiway.ModClass.I.WorldSaves.LastReport.BackupError==null,"当前格式没有丢弃其他世界资料");SaveManager.saveWorldToDirectory(Path.Combine(folder,"after-save"));World.world.save_manager.loadWorld(Path.Combine(folder,"after-save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();waiting=World.world.units.get((long)e["waiting"]).GetExtend();await Advance();Check(waiting.GetComponent<ConstructedCreationState>().LastAbility==completed&&ConstructedAbilityService.Knows(waiting,completed),"再次存读档保留完成结果，不重新运行生成规则");var result=new{passed=true,checks,process=System.Diagnostics.Process.GetCurrentProcess().Id,completed};File.WriteAllText(Path.Combine(folder,"restart-result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{GeneralSettings.SwitchSkillSystems(enabled);}
