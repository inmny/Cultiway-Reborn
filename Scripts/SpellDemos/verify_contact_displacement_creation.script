// C5：有限种子查真实生成与派生，旧输入比较在正式存档段完成。
Actor source = Make(64); var owner = source.GetExtend(); owner.NewCultisys(Cultisyses.Xian); owner.GetCultisys<Xian>().level = 2;
owner.MarkCultiwayStatsDirty(); source.setStatsDirty(); source.updateStats(); owner.GetCultisys<Xian>().wakan = 10000;
var inspiration = ConstructedAbilityService.ReadInspiration(owner);
JObject Canon(AbilityDefinition definition) { var value = JObject.FromObject(definition); value.Remove("Id"); value.Remove("Creator"); return value; }
IEnumerable<ConstructionNode> Nodes(ConstructionNode node) { if (node == null) yield break; yield return node; foreach (var child in node.Children) foreach (var nested in Nodes(child)) yield return nested; }
var attempts = new List<object>(); var representatives = new Dictionary<string, AbilityDefinition>();
var capture = service.GetMethod("CaptureCreationResources", F);
try
{
    Check(inspiration.Rules == 13, "新受理创作使用第十三版");
    for (int seed = 0; seed < 16 && (!representatives.ContainsKey("knockback") || !representatives.ContainsKey("exchange")); seed++)
    {
        try
        {
            var resources = (SynthesisResources)capture.Invoke(null, new object[] { owner, seed, inspiration });
            var generated = ConstructedAbilityService.Generate(owner, seed, inspiration, resources: resources);
            Check(JToken.DeepEquals(Canon(generated), Canon(ConstructedAbilityService.Generate(owner, seed, inspiration, resources: resources))), "同一冻结输入保持完整结果 " + seed);
            var impacts = Nodes(generated.Root).Select(n => n.Impact ?? generated.Impact).Where(v => v != null).Concat(generated.Body?.Impact == null ? Array.Empty<ConstructionImpact>() : new[] { generated.Body.Impact }).Concat(generated.Body?.Stages?.Where(s => s.Impact != null).Select(s => s.Impact) ?? Enumerable.Empty<ConstructionImpact>()).ToArray();
            if (impacts.Any(v => v.Knockback != null)) representatives["knockback"] = generated;
            if (impacts.Any(v => v.Exchange != null)) representatives["exchange"] = generated;
            Check(impacts.All(v => v.Targets != SkillUseTargetRelation.Self || v.Exchange == null), "不生成自己和自己换位 " + seed);
            var plan = AbilityCompiler.Compile(generated, false);
            Check(plan.Measure.ContactDisplacementWork > 0 && generated.Cost > ConstructionPricing.Price(ConstructionEditing.Copy(generated), contactRules: 12).Cost, "真实位移需求计入独立创作 " + seed);
            attempts.Add(new { seed, generated.Id, generated.Cost });
        }
        catch (InvalidDataException error) { attempts.Add(new { seed, rejected = error.Message }); }
        await Game.NextFrame();
    }
    Check(representatives.ContainsKey("knockback") && representatives.ContainsKey("exchange"), "自主独立创作覆盖击退和换位");
    foreach (var item in representatives) File.WriteAllText(Path.Combine(folder, item.Key + ".json"), JsonConvert.SerializeObject(item.Value, Formatting.Indented));
    var basis = JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root, "Scripts/SpellDemos/fixtures/construction-batch/01-charge.json")));
    basis.Id = "test.contact-displacement.original"; basis.Resource = "wakan"; basis.Root.Operations[0].Id = "outward";
    basis.Steps = new[] { new ConstructionStep { Id = "spin", Operation = new ConstructionOperation { Kind = ConstructionOperationKind.Spin, Vector = new[] { 0f, 0f, 90f } }, Inputs = new Dictionary<string, ConstructionOutputReference> { ["part"] = new() { Node = "root" }, ["after"] = new() { Node = "root", Operation = "outward", Output = "flight", Stage = ConstructionOutputStage.Started } } } };
    AbilityDefinition derived = null; int chosenSeed = -1;
    for (int seed = 0; seed < 64 && derived == null; seed++)
    {
        try { var result = ConstructedAbilityService.Generate(owner, seed, inspiration, basis); if (result.Parent.Change == "接触位移") { derived = result; chosenSeed = seed; } }
        catch (InvalidDataException error) { attempts.Add(new { seed, otherDerivationRejected = error.Message }); }
        await Game.NextFrame();
    }
    Check(derived != null && JToken.DeepEquals(JArray.FromObject(basis.Steps), JArray.FromObject(derived.Steps)) && JToken.DeepEquals(JArray.FromObject(basis.Root.Operations), JArray.FromObject(derived.Root.Operations)), "接触位移派生保留命名步骤和引用", new { chosenSeed });
    var expected = ConstructionPricing.Reprice(basis, ConstructionEditing.Copy(derived), contactRules: 13);
    Check(derived.Cost == expected.Cost && derived.Cost > basis.Cost && AbilityCompiler.Compile(derived, false).Measure.ContactDisplacementWork > 0, "派生按原术前后需求调整收费");
    File.WriteAllText(Path.Combine(folder, "source.json"), JsonConvert.SerializeObject(basis, Formatting.Indented));
    File.WriteAllText(Path.Combine(folder, "derived.json"), JsonConvert.SerializeObject(derived, Formatting.Indented));
    File.WriteAllText(Path.Combine(folder, "selected.json"), JsonConvert.SerializeObject(new { seed = chosenSeed, inspiration }, Formatting.Indented));
    return new { passed = true, closed = "接触位移独立创作及派生", checks, process = System.Diagnostics.Process.GetCurrentProcess().Id };
}
finally { File.WriteAllText(Path.Combine(folder, "attempts.json"), JsonConvert.SerializeObject(attempts, Formatting.Indented)); ConstructedAbilityService.ContactConfirmed -= Hit; ConstructedAbilityService.CastEnded -= Ended; Config.paused = true; ControllableUnit.clear(false); }
