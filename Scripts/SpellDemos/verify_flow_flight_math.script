// 流散中的普通定时投送、真实条件换向、准确边界、守恒与预测恢复。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using Newtonsoft.Json;
using UnityEngine;
using Cultiway.Core.Skills;
const BindingFlags F=BindingFlags.Instance|BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/flow-flight");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}
object Call(object o,string n,params object[] args)=>o.GetType().GetMethod(n,F).Invoke(o,args);
ConstructionOperation Fly(float at,float speed=4,bool inherit=false)=>new(){Kind=ConstructionOperationKind.Fly,At=at,Vector=new[]{speed,0f,0f},WorldVelocity=true,InheritVelocity=inherit};
AbilityDefinition Definition()=>new(){Id="test.flow-flight",Resource="none",Cost=0,Lifetime=3,Root=new ConstructionNode{Id="water",Form="water_flow",Matter="water",Volume=12,Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Flow,Flow=new ConstructionFlow{Cells=16,Size=32,Gravity=0,Drag=0,Evaporation=0,OpenBoundary=false}},Fly(.5f)}}};
AbilityDefinition Copy(AbilityDefinition d)=>JsonConvert.DeserializeObject<AbilityDefinition>(JsonConvert.SerializeObject(d));
AbilityCast Cast(AbilityDefinition d)=>new(AbilityCompiler.Compile(d),Matrix4x4.identity,inputs:new AbilityInputs(new Vector3(64,72),new Vector3(80,72),Vector3.right,1),force:20,paidResource:8);
object Flow(AbilityCast c)=>((Array)typeof(AbilityCast).GetField("flows",F).GetValue(c)).GetValue(0);
AbilityMaterialData Data(AbilityCast c)=>(AbilityMaterialData)Call(Call(c,"CaptureMaterial",0),"Capture");
Vector3 Centre(AbilityCast c){var d=Data(c);double sum=0,x=0,y=0;int n=d.Flow.Settings.Cells;for(int i=0;i<n*n;i++){double h=d.Flow.Water[i*3];sum+=h;x+=h*(d.Flow.X+(i%n+.5)*d.Flow.Cell);y+=h*(d.Flow.Y+(i/n+.5)*d.Flow.Cell);}return new Vector3((float)(x/sum),(float)(y/sum),0);}
List<AbilityCapsule> Shapes(AbilityCast c){var list=new List<AbilityCapsule>();c.AppendContacts(list);return list;}
var d=Definition();var c=Cast(d);Vector3 start=Centre(c);c.Advance(.49f,Vector3.right);Check(Vector3.Distance(start,Centre(c))<.00001&&c.Velocity(0)==Vector3.zero,"普通延迟投送之前水体不提前移动");var old=Shapes(c).First();Call(c,"SaveStep");c.Advance(.01f,Vector3.right);Check(Math.Abs(c.Age-.5f)<.00001&&Vector3.Distance(start,Centre(c))<.00001&&Math.Abs(c.Velocity(0).x-4)<.00001,"到达投送边界只改变实际速度，不预支一小步位移");Check(!c.IsCurrent(old),"投送改变运动后旧接触候选立即失效");var state=Data(c);Check(state.Flow.Water.Where((_,i)=>i%3==1).Any(v=>v>0)&&state.Volume>11.9999&&state.Resource==8&&c.RemainingForce(0)==20,"真实水格获得动量，不复制材料、攻击或支付");c.Advance(.25f,Vector3.right);Check(Math.Abs(Centre(c).x-start.x-1)<.001&&Math.Abs(c.Velocity(0).x-4)<.0001,"新速度只按后续真实时间推进，定时投送不重复叠加");var expected=Data(c);Call(c,"RestoreStep");Check(Math.Abs(c.Age-.49f)<.00001&&c.Velocity(0)==Vector3.zero,"预测回退恢复尚未执行的投送与零动量");c.Advance(.01f,Vector3.right);c.Advance(.25f,Vector3.right);Check(JsonConvert.SerializeObject(expected)==JsonConvert.SerializeObject(Data(c)),"回退重放恢复全部水格、时点及一次执行标记");
var inherit=Definition();inherit.Root.Operations[1].InheritVelocity=true;var inherited=Cast(inherit);Call(Flow(inherited),"SetVelocity",new Vector3(2,0,0));inherited.Advance(.5f,Vector3.right);Check(Math.Abs(inherited.Velocity(0).x-6)<.0001,"继承投送读取当时真实平均流速并只加一次");inherited.Advance(.2f,Vector3.right);Check(Math.Abs(inherited.Velocity(0).x-6)<.0001,"后续推进不重新领取初始速度");
var local=Definition();local.Root.Rotation=new[]{0f,0f,90f};local.Root.Operations[1].WorldVelocity=false;var rotated=Cast(local);rotated.Advance(.5f,Vector3.right);Check(Math.Abs(rotated.Velocity(0).x)<.0001&&Math.Abs(rotated.Velocity(0).y-4)<.0001,"局部投送按当时真实朝向映射到地面方向");
var early=Definition();early.Root.Operations[0].At=.5f;early.Root.Operations[1]=Fly(0,3);var handed=Cast(early);handed.Advance(.5f,Vector3.right);Check(Data(handed).Flow!=null&&Math.Abs(handed.Velocity(0).x-3)<.0001,"早于流散的投送只向新水格交接一次真实速度");handed.Advance(.3f,Vector3.right);Check(Math.Abs(handed.Velocity(0).x-3)<.0001,"流散接管后不重新启动已执行的普通投送");
var eventDef=Definition();eventDef.Root.OnContact=ConstructionContactResponse.Stop;eventDef.Root.Operations[1]=Fly(.6f,4);var conditional=Fly(0,2);conditional.When=new ConstructionCondition{Trigger=ConstructionChangeTrigger.ActorContact,Delay=.2f};eventDef.Root.Operations=eventDef.Root.Operations.Concat(new[]{conditional}).ToArray();var events=Cast(eventDef);Call(Flow(events),"SetVelocity",new Vector3(2,0,0));events.Advance(.2f,Vector3.right);events.ConfirmContact(0,1);start=Centre(events);Check(events.Velocity(0)==Vector3.zero&&Data(events).Flow.Water.Where((_,i)=>i%3!=0).All(v=>v==0),"接触停止清除真实内部动量，不只暂停根节点");events.Advance(.19f,Vector3.right);Check(Vector3.Distance(start,Centre(events))<.00001,"真实条件的额外延迟不提前恢复流动");events.Advance(.01f,Vector3.right);Check(Vector3.Distance(start,Centre(events))<.00001&&Math.Abs(events.Velocity(0).x-2)<.0001,"条件投送边界同样只改变速度，不补走旧时间");events.Advance(.2f,Vector3.right);Check(Math.Abs(Centre(events).x-start.x-.4f)<.001&&Math.Abs(events.Velocity(0).x-4)<.0001,"后到的普通投送可替换已运行的条件控制");events.Advance(.1f,Vector3.right);Check(Math.Abs(Centre(events).x-start.x-.8f)<.001,"两阶段控制共用同一水量和实际路径");
var accelerated=Definition();accelerated.Root.Operations[1].Acceleration=new[]{2f,0f,0f};var accelerating=Cast(accelerated);accelerating.Advance(.75f,Vector3.right);Check(Math.Abs(accelerating.Velocity(0).x-4.5f)<.0002,"水平加速度只累计投送开始之后的世界时间");
var tracking=Definition();tracking.Root.Operations[1].TurnRate=90;var turning=Cast(tracking);turning.Advance(.5f,new Vector3(0,-90));turning.Advance(.2f,new Vector3(0,-90));Check(turning.Velocity(0).y<-.5f&&turning.Velocity(0).x>3.5f&&turning.Velocity(0).magnitude<4.001f,"水平追踪使用本轮新目标并按真实角速度换向，不瞬移或提高速度");
var phase=Definition();phase.Root.Operations[1]=Fly(.9f,4);phase.Root.Operations=phase.Root.Operations.Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.ConvertMatter,At=.4f,Matter="ice"},new ConstructionOperation{Kind=ConstructionOperationKind.ConvertMatter,At=.8f,Matter="water"}}).ToArray();var frozen=Cast(phase);Call(Flow(frozen),"SetVelocity",new Vector3(2,0,0));start=Centre(frozen);frozen.Advance(.4f,Vector3.right);Check(Math.Abs(Centre(frozen).x-start.x-.8f)<.001&&frozen.Velocity(0)==Vector3.zero,"凝固前完整走到真实时点，不丢掉最后一小步");var held=Centre(frozen);frozen.Advance(.50001f,Vector3.right);Check(Vector3.Distance(held,Centre(frozen))<.0001&&Math.Abs(frozen.Velocity(0).x-4)<.0001,"冻结及解冻保持原位，后续新投送准确启动；age="+frozen.Age+"; delta="+Vector3.Distance(held,Centre(frozen))+"; velocity="+frozen.Velocity(0));frozen.Advance(.1f,Vector3.right);Check(Math.Abs(Centre(frozen).x-held.x-.4f)<.001,"解冻后的定时投送驱动实际剩余水体");
var cancelled=Cast(Definition());cancelled.Cancel();cancelled.Advance(1,Vector3.right);Check(cancelled.Finished&&cancelled.Velocity(0)==Vector3.zero,"取消后的延迟投送不再发生");
var leave=Definition();leave.Root.Operations=leave.Root.Operations.Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Leave,At=.3f,Residue=new ConstructionResidue{Lifetime=0}}}).ToArray();var leaving=Cast(leave);leaving.Advance(.7f,Vector3.right);Check(leaving.Velocity(0)==Vector3.zero&&(bool)Call(leaving,"HasLeave",0),"已经开始留置的主体不会被未来投送重新驱动");
void Reject(AbilityDefinition input,string label){try{AbilityCompiler.Compile(input);throw new Exception("未拒绝："+label);}catch(InvalidDataException){checks.Add(label);}}
var invalid=Definition();invalid.Root.Operations[1].Vector=new[]{4f,0f,2f};Reject(invalid,"流散后的普通三维速度由入口明确拒绝");invalid=Definition();invalid.Root.Operations[1].Acceleration=new[]{0f,0f,-2f};Reject(invalid,"流散后的普通竖向加速度由入口明确拒绝");var pre=Copy(invalid);pre.Root.Operations[0].At=1;pre.Root.Operations[1].At=.2f;AbilityCompiler.Compile(pre);checks.Add("原形阶段的真实三维运动仍可在流散前发生");
var poolType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.SimulationWorkerPool");var pool=poolType.GetProperty("Instance",F).GetValue(null);var run=poolType.GetMethod("RunIndexed",F);var reports=new List<object>();foreach(int count in new[]{32,128}){var plan=AbilityCompiler.Compile(Definition());AbilityCast Make()=>new(plan,Matrix4x4.identity);var serial=Enumerable.Range(0,count).Select(_=>Make()).ToArray();var parallel=Enumerable.Range(0,count).Select(_=>Make()).ToArray();foreach(float time in new[]{.49f,.01f,.25f}){foreach(var value in serial)value.Advance(time,Vector3.right);Action<int> action=i=>parallel[i].Advance(time,Vector3.right);run.Invoke(pool,new object[]{0,count,action});}Check(serial.Select(value=>JsonConvert.SerializeObject(Data(value))).SequenceEqual(parallel.Select(value=>JsonConvert.SerializeObject(Data(value)))),"准确投送和全部水格在实际工作池与串行一致："+count);reports.Add(new{count,error=0});await Game.NextFrame();}
var result=new{passed=true,checks,reports,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"math.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
