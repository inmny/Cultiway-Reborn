// 复用正式御器、同一个铁剑和同一个敌人，不另外挑身体或装备。
const bool thrustOnly = false;
PrepareAppearanceBackdrop(61, 75, 69, 75);
void PlaceEnemy(float x)
{
    enemy.stopForce(); enemy.stopMovement(); enemy.batch.c_action_landed.Remove(enemy); enemy.position_height = 0;
    enemy.current_position = new Vector2(x, 72);
    enemy.setCurrentTile(World.world.GetTileSimple((int)x, 72)); enemy.updatePos();
    enemy.restoreHealth(enemy.getMaxHealth());
}
var executions = new List<Entity>();
void Configured(Entity e)
{
    if (e.HasComponent<MotionRibbonTrail>() && e.GetComponent<SkillEntity>().SkillContainer == handle.Source)
        executions.Add(e);
}
bool Use() => ActiveAbilityService.TryUse(owner, handle, new ActiveAbilityTarget(enemy, enemy.GetSimPos()), ActiveAbilityUseOrigin.Script);
var ribbonView = typeof(ActorExtend).Assembly.GetType("Cultiway.Core.Visuals.MotionRibbonTrailView");
var sourceEntityId = ribbonView.GetField("sourceEntityId", F);
Component BoundView(Entity e) => Resources.FindObjectsOfTypeAll(ribbonView).OfType<Component>()
    .FirstOrDefault(v => v.gameObject.activeInHierarchy && (int)sourceEntityId.GetValue(v) == e.Id);
var damageCallback = typeof(ActorExtend).GetField("action_on_damage_resolved", F);
var oldDamageCallback = damageCallback.GetValue(null);
float settled = 0f;
ActorExtend.RegisterActionOnDamageResolved((victim, attacker, damage, elements, type) =>
{
    if (victim.Base == enemy && attacker == owner.Base && type == AttackType.Weapon &&
        Cultiway.Core.Combat.DamageResolutionContext.CurrentSourceScopeId > 0) settled += damage;
});
Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured += Configured;
try
{
    PlaceEnemy(90);
    Check(!Use() && !Casting() && executions.Count == 0, "超出实际御器范围无残影和施放");
    foreach (var shape in new[] { MotionRibbonShape.RadialSweep, MotionRibbonShape.AxialThrust })
    {
        if (thrustOnly && shape != MotionRibbonShape.AxialThrust) continue;
        bool inspected = false;
        for (int attempt = 0; !inspected && attempt < 5; attempt++)
        {
            for (int i = 0; i < 35 && (!SkillCooldownService.IsReady(owner, handle.Source) || enemy.isFlying()); i++)
                await Advance(.125f);
            PlaceEnemy(shape == MotionRibbonShape.RadialSweep ? 67f : 74.25f);
            int before = enemy.data.health;
            settled = 0f;
            float closest = float.PositiveInfinity;
            executions.Clear();
            SetWakan();
            Check(Use(), shape + "正式御器受理", new { cooldown = SkillCooldownService.GetRemaining(owner, handle.Source),
                casting = Casting(), sourceFlying = owner.Base.isFlying(), targetFlying = enemy.isFlying(),
                age = World.world.getCurWorldTime(), distance = Vector2.Distance(owner.Base.current_position, enemy.current_position),
                canAttack = owner.Base.canAttackTarget(enemy) });
            Entity viewed = default;
            for (int i = 0; i < 24; i++)
            {
                await Advance(.025f);
                await Game.NextFrame();
                foreach (var e in executions)
                {
                    if (!e.IsAvailable()) continue;
                    var trail = e.GetComponent<MotionRibbonTrail>();
                    if (trail.Shape != shape) continue;
                    if (e.GetComponent<ColliderConfig>().Enabled)
                        closest = Mathf.Min(closest, Vector2.Distance(e.GetComponent<Position>().value, enemy.current_position));
                    var view = BoundView(e);
                    if (view == null) continue;
                    Mesh mesh = view.transform.Find("core").GetComponent<MeshFilter>().sharedMesh;
                    if (mesh.vertexCount == 0) continue;
                    var point = e.GetComponent<Position>().value;
                    Vector3 p = new Vector3(point.x, point.y + point.z);
                    Vector3 origin = new Vector3(trail.SourceOrigin.x, trail.SourceOrigin.y + trail.SourceOrigin.z);
                    float nearOrigin = mesh.vertices.Min(v => Vector3.Distance(v, origin));
                    float farFromTip = mesh.vertices.Max(v => Vector3.Distance(v, p));
                    float reach = Vector3.Distance(p, origin);
                    if (reach < 2f) continue;
                    float limit = shape == MotionRibbonShape.AxialThrust
                        ? trail.LocalLength + trail.ThrustTipExtension : trail.LocalLength + reach * .33f + trail.SweepOuterExtension;
                    Check(nearOrigin >= reach * .36f && farFromTip <= limit + .2f,
                        shape + "可见面留在兵器附近", new { farFromTip, nearOrigin, trail.LocalLength, trail.HistorySeconds });
                    float radius = e.GetComponent<ColliderSphere>().Radius;
                    Check(Mathf.Abs(radius - (shape == MotionRibbonShape.AxialThrust ? Mathf.Max(.72f, trail.CoreWidth * .55f) : .72f)) < .0001f,
                        shape + "仍按正式碰撞宽度", new { radius });
                    Vector3 center = Vector3.Lerp(origin, p, .55f);
                    await FrameAppearance(shape + "-native", center.x, center.y, 4.5f);
                    await FrameCleanupSide(shape + "-worldfall", center, 7f, -.25f);
                    viewed = e;
                    inspected = true;
                    break;
                }
                if (inspected) break;
            }
            for (int i = 0; i < 40 && Casting(); i++) await Advance(.2f);
            await Advance(1.6f);
            if (inspected)
                Check(settled > 0f, shape + "仍真实命中", new { before, after = enemy.data.health, settled, closest = float.IsInfinity(closest) ? (float?)null : closest,
                    hostile = owner.Base.canAttackTarget(enemy), source = owner.Base.current_position.ToString(),
                    target = enemy.current_position.ToString() });
            Check(!Casting() && owner.Base.getWeaponAsset() == weaponAsset && (!inspected || !viewed.IsAvailable()), shape + "退场并归还原武器");
        }
        Check(inspected, shape + "取得实际动作的原版与三维截图");
    }
    return new { passed = true };
}
finally
{
    Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured -= Configured;
    damageCallback.SetValue(null, oldDamageCallback);
    Config.paused = true;
}

void SetWakan()
{
    owner.GetCultisys<Xian>().wakan = owner.Base.stats[BaseStatses.MaxWakan.id] * .9f;
}
