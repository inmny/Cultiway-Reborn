// 真正冷启动恢复原版雨云；不重放原法术，不重新等待三秒成云。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using DebugToolbox.Runtime.Scripting;
using Cultiway.Core;
using Cultiway.Core.Skills;
using Cultiway.Content.Skills;
using Cultiway.Content.Combat;
using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Static|BindingFlags.Instance|BindingFlags.Public|BindingFlags.NonPublic;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/rain-process");var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));
var checks=new List<string>();void Check(bool ok,string name){if(!ok)throw new InvalidOperationException(name);checks.Add(name);Log.Info(name);}Check(System.Diagnostics.Process.GetCurrentProcess().Id!=(int)expected["process"],"真正退出后由另一个游戏进程恢复天气");
var stats=new BaseStats{["mana"]=1000};stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.RainProcessHold")??Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.RainProcessHold").SetStats(stats).SetDuration(10000).Build();
var rt=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=rt.GetProperty("Instance").GetValue(null);async Task Boundary()=>await Game.WaitUntil(()=>(bool)rt.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;await Boundary();}
var cloudsType=typeof(ConstructedAbilityService).Assembly.GetType("Cultiway.Content.Skills.ConstructedRainClouds");JObject Weather()=>JObject.Parse(JsonConvert.SerializeObject(cloudsType.GetMethod("Capture",F).Invoke(null,null)));IDictionary Clouds()=>(IDictionary)cloudsType.GetField("Clouds",F).GetValue(null);
Config.paused=true;Game.Resume();ControllableUnit.clear(false);Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(folder,"save"));while(SmoothLoader.isLoading()){Config.paused=true;await Game.NextFrame();}Config.paused=true;await Boundary();World.world.console.Hide();foreach(var screen in Resources.FindObjectsOfTypeAll<LoadingScreen>())screen.gameObject.SetActive(false);
var actor=World.world.units.get((long)expected["actor"]);Check(actor!=null&&actor.isAlive(),"原版人物及正式已学关系仍存在");var saves=Cultiway.ModClass.I.WorldSaves;JToken Section(string text,string key)=>JObject.Parse(text)["sections"][key];Check(JToken.DeepEquals(Section((string)expected["world"],"ability_constructions"),Section(saves.World.Capture(World.world,"rain"),"ability_constructions")),"含持续参数的完整构造按正式世界区段恢复");Check(JToken.DeepEquals(expected["weather"],Weather()),"云身份、原术、位置、云龄、移动、雨滴间隔与消散阶段完全恢复");Check(saves.LastReport.Skipped.Count==0&&saves.LastReport.BackupError==null,"正式恢复没有局部丢弃或备份错误");
var starts=new List<ConstructedCastStarted>();var ends=new List<ConstructedCastEnded>();var contacts=new List<ConstructedWorldContact>();void Started(ConstructedCastStarted e)=>starts.Add(e);void Ended(ConstructedCastEnded e)=>ends.Add(e);void Contact(ConstructedWorldContact e)=>contacts.Add(e);ConstructedAbilityService.CastStarted+=Started;ConstructedAbilityService.CastEnded+=Ended;ConstructedAbilityService.WorldContactConfirmed+=Contact;
using var drops=Trace.Method(typeof(DropManager),"spawn",argumentTypes:new[]{typeof(WorldTile),typeof(string),typeof(float),typeof(float),typeof(long)});var times=new List<double>();try{
var paused=Weather();for(int i=0;i<60;i++)await Game.NextFrame();Check(JToken.DeepEquals(paused,Weather()),"恢复后暂停仍不额外推进实际天气");float previousAge=(float)paused["Clouds"][0]["Age"];World.world.camera.transform.position=new Vector3(69,90,World.world.camera.transform.position.z);MoveCamera.instance.forceZoom(40);World.world.camera.orthographicSize=40;World.world.setZoomOrthographic(40);await Advance(.6f);Check(Weather()["Clouds"].Count()==1&&(float)Weather()["Clouds"][0]["Age"]>previousAge,"原版在恢复进度上继续推进同一朵云");Check(drops.Events.Any(e=>e.Arguments?.ToString().Contains("rain")==true),"恢复后立即继续真实降雨，不重新等待三秒成云");Check(starts.Count==0&&ends.Count==0&&contacts.Count==0,"恢复天气没有重放旧施放、旧世界接触或旧结束");
string frames=Path.Combine(folder,"frames");if(Directory.Exists(frames))Directory.Delete(frames,true);Directory.CreateDirectory(frames);double start=World.world.getCurWorldTime(),next=start;Config.paused=false;while(World.world.getCurWorldTime()<start+3){await Game.NextFrame();double now=World.world.getCurWorldTime();if(now<next)continue;World.world.camera.transform.position=new Vector3(69,90,World.world.camera.transform.position.z);MoveCamera.instance.forceZoom(40);World.world.camera.orthographicSize=40;World.world.setZoomOrthographic(40);new ScreenFacade().Capture(Path.Combine(frames,times.Count.ToString("00000")+".png"));times.Add(now-start);next=now+.1;}Config.paused=true;await Boundary();
double recordedDuration = World.world.getCurWorldTime() - start;
actor.dieAndDestroy(AttackType.Other);await Advance(.2f);Check(Clouds().Count==1&&Weather()["Clouds"][0]["Source"].Value<long>()==(long)expected["actor"],"已形成的独立天气在来源死亡后继续，历史来源编号不变");
var before=Weather();SaveManager.saveWorldToDirectory(Path.Combine(folder,"resave"));World.world.save_manager.loadWorld(Path.Combine(folder,"resave"));while(SmoothLoader.isLoading()){Config.paused=true;await Game.NextFrame();}Config.paused=true;await Boundary();Check(JToken.DeepEquals(before,Weather()),"再次正式存读档恢复同一进度，不叠加第二朵云");Check(saves.LastReport.Skipped.Count==0,"来源已死亡的历史天气仍可正式恢复");
// 一条坏记录只影响这一朵云，不丢弃同区段的其他有效天气。
var mixed=(JObject)Weather().DeepClone();var bad=(JObject)mixed["Clouds"][0].DeepClone();bad["Id"]=(long)bad["Id"]+100;bad["X"]=float.MaxValue;((JArray)mixed["Clouds"]).Add(bad);int skipped=saves.LastReport.Skipped.Count;var saveType=cloudsType.GetNestedType("SaveData",F);cloudsType.GetMethod("Restore",F).Invoke(null,new[]{mixed.ToObject(saveType)});Check(Clouds().Count==1&&saves.LastReport.Skipped.Count==skipped+1,"损坏一朵云时只报告并丢弃该记录，其他天气继续");
var remaining = Weather()["Clouds"].Single();
await Advance(Mathf.Max(0f, (float)remaining["Lifespan"] - (float)remaining["Age"]) + 4f);
Check(Clouds().Count == 0, "原版按原保存时长自然消散，过期天气不再保存");
Check(starts.Count == 0 && ends.Count == 0, "整个恢复与消散期间没有伪造新的施放结束");
var result = new { passed = true, checks, times, duration = recordedDuration, view = "native",
    restored = before, drops = drops.Events.Count, process = System.Diagnostics.Process.GetCurrentProcess().Id };
File.WriteAllText(Path.Combine(folder, "restart-result.json"), JsonConvert.SerializeObject(result, Formatting.Indented));
return result;
}finally{ConstructedAbilityService.CastStarted-=Started;ConstructedAbilityService.CastEnded-=Ended;ConstructedAbilityService.WorldContactConfirmed-=Contact;Config.paused=true;File.WriteAllText(Path.Combine(folder,"restart-partial.json"),JsonConvert.SerializeObject(new{checks,times,weather=Weather(),starts,ends,contacts},Formatting.Indented));}
