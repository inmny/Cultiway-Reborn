// 5.06正式世界中保存新旧等待请求，授予一次后实际使用当前成品并再次保存。
Actor source = Make(64), legacy = Make(62), enemy = Make(72, "wolf");
foreach (Actor actor in new[] { source, legacy })
{
    var extend = actor.GetExtend(); extend.NewCultisys(Cultisyses.Xian); extend.GetCultisys<Xian>().level = 2;
    extend.MarkCultiwayStatsDirty(); actor.setStatsDirty(); actor.updateStats(); extend.GetCultisys<Xian>().wakan = 10000;
}
for (int frame = 0; frame < 3; frame++) await Game.NextFrame();
var owner = source.GetExtend(); var saves = Cultiway.ModClass.I.WorldSaves; var access = ConstructionEditing.Access;
JObject Canon(AbilityDefinition value) { var json = JObject.FromObject(value); json.Remove("Id"); json.Remove("Creator"); return json; }
var active = new List<AbilityCast>();
void Started(ConstructedCastStarted fact)
{
    if (fact.SourceId != source.id) return;
    foreach (object running in (IEnumerable)service.GetField("casts", F).GetValue(null))
        if ((long)Field(running, "Id") == fact.CastId) active.Add((AbilityCast)Field(running, "Cast"));
}
ConstructedAbilityService.CastStarted += Started;
try
{
    var basis = new AbilityDefinition
    {
        Id = "test.progressive-formation.basis", Name = "原枝术", Lifetime = 5, Cost = 3, Cooldown = .1f, TargetRange = 100,
        Root = new ConstructionNode { Id = "stem", Form = "branch", Matter = "wood", Scale = .4f }
    };
    ConstructedAbilityService.Register(basis); ConstructedAbilityService.Learn(owner, basis.Id);
    var inspiration = ConstructedAbilityService.ReadInspiration(owner);
    int seed = -1;
    foreach (int candidate in new[] { 14 }.Concat(Enumerable.Range(0, 96).Where(value => value != 14)))
    {
        var result = ConstructedAbilityService.Generate(owner, candidate, inspiration, basis);
        if (result.Parent.Change == "逐段成形" && result.Root.Children.Any(node => node.Activation == null)) { seed = candidate; break; }
        await Game.NextFrame();
    }
    Check(seed >= 0 && ConstructedAbilityService.TryQueueCreation(owner, seed, basis.Id), "实际人物受理带逐段成形的新规则创法请求");
    var pending = owner.GetComponent<ConstructedCreationState>();
    var predicted = ConstructedAbilityService.Generate(owner, pending.Seed, pending.Inspiration, pending.Source, pending.Resources);
    Check(pending.Inspiration.Rules == 23 && predicted.Parent.Change == "逐段成形", "新等待请求冻结规则23、完整原术和实际成形输入");
    var envelope = JObject.Parse(saves.Actors.Capture(owner, "progressive-formation"));
    Check((int)envelope["sections"]["ability_creation"]["version"] == 24, "当前请求使用正式第二十四版人物区段");
    var old = JObject.Parse(File.ReadAllText(Path.Combine(folder, "rule22.json")));
    var oldEnvelope = JObject.Parse(saves.Actors.Capture(legacy.GetExtend(), "progressive-formation-old"));
    oldEnvelope["sections"]["ability_creation"] = old["section"].DeepClone();
    var report = new SaveLoadReport();
    saves.Actors.Restore(legacy.GetExtend(), oldEnvelope.ToString(), report, "progressive-formation-old", section => section.Id == "ability_creation", false);
    Check(report.Upgraded == 1 && report.Skipped.Count == 0, "真实旧等待区段23原样升级至24");
    var expectedOld = old["expected"].ToObject<AbilityDefinition>();
    long sourceId = source.id, legacyId = legacy.id, enemyId = enemy.id;
    int known = access.List(owner).Count, oldKnown = access.List(legacy.GetExtend()).Count;
    File.WriteAllText(Path.Combine(folder, "pending-expected.json"), JsonConvert.SerializeObject(new
    { sourceId, legacyId, enemyId, predicted, expectedOld, pending, known, oldKnown, process = System.Diagnostics.Process.GetCurrentProcess().Id }, Formatting.Indented));
    string save = Path.Combine(folder, "pending-save"); SaveManager.saveWorldToDirectory(save);
    World.world.save_manager.loadWorld(save); await Game.WaitUntil(() => !SmoothLoader.isLoading(), 1800);
    Config.paused = true; await Game.WaitUntil(Boundary, 1800);
    source = World.world.units.get(sourceId); legacy = World.world.units.get(legacyId); enemy = World.world.units.get(enemyId); owner = source.GetExtend();
    var loaded = owner.GetComponent<ConstructedCreationState>();
    Check(loaded.Pending && JToken.DeepEquals(JObject.FromObject(loaded.Resources), JObject.FromObject(pending.Resources)) &&
        JToken.DeepEquals(Canon(ConstructedAbilityService.Generate(owner, loaded.Seed, loaded.Inspiration, loaded.Source, loaded.Resources)), Canon(predicted)),
        "正式世界保存读取保持新请求完整成形输入、依赖和费用");
    await Advance(.2f);
    var completed = owner.GetComponent<ConstructedCreationState>(); var oldCompleted = legacy.GetExtend().GetComponent<ConstructedCreationState>();
    var learned = access.Read(completed.LastAbility); var oldLearned = access.Read(oldCompleted.LastAbility);
    Check(!completed.Pending && completed.LastFailure == null && learned != null && JToken.DeepEquals(Canon(learned), Canon(predicted)) &&
        !oldCompleted.Pending && oldCompleted.LastFailure == null && oldLearned != null && JToken.DeepEquals(Canon(oldLearned), Canon(expectedOld)),
        "正式逻辑边界完整授予新旧结果，旧报价及后续结构不重抽");
    await Advance(.2f);
    Check(access.List(owner).Count == known + 1 && access.List(legacy.GetExtend()).Count == oldKnown + 1, "新旧等待请求各授予一次");
    owner.GetCultisys<Xian>().wakan = source.stats[BaseStatses.MaxWakan.id] * .9f;
    Check(learned.Cost <= owner.GetCultisys<Xian>().wakan, "正式新成品在实际资源容量内可支付", new { learned.Cost, capacity = source.stats[BaseStatses.MaxWakan.id] });
    Ready(source); Place(source, 64); Place(enemy, 72);
    float balance = owner.GetCultisys<Xian>().wakan;
    await Fire(learned, source, enemy); float paid = balance - owner.GetCultisys<Xian>().wakan;
    owner.E.RemoveComponent<ConstructedKnowledge>(); await Advance(.12f);
    var live = active.Last(); var views = new List<FormVisualInstance>(); live.AppendVisuals(views);
    var child = learned.Root.Children.Single(node => node.Id.StartsWith("forming_"));
    Check(Math.Abs(paid - learned.Cost) < .001f && views.Any(view => view.Resource.Description.Id == child.Form && view.BuildProgress < 1),
        "正式授予的成品实际支付，并从真实未长成进度施放", new { paid, learned.Cost, live.Age, child.Form });
    await Advance(child.Operations.Single(operation => operation.Id == "formation").Seconds + .1f);
    Check(live.StepStateOf(child.Id + "_continue") is ConstructionStepState.Running or ConstructionStepState.Completed,
        "正式新成品在实际成形完成后执行原后续过程");
    await Advance(learned.Lifetime + .2f);
    Check(live.Finished && !BodyControlState.IsBusy(source.id), "正式成品自然结束并归还控制");
    ConstructedAbilityService.Learn(owner, learned.Id);
    File.WriteAllText(Path.Combine(folder, "completed-expected.json"), JsonConvert.SerializeObject(new
    { sourceId, legacyId, learned, oldLearned, known = access.List(owner).Count, oldKnown = access.List(legacy.GetExtend()).Count }, Formatting.Indented));
    SaveManager.saveWorldToDirectory(Path.Combine(folder, "completed-save"));
    File.WriteAllText(Path.Combine(folder, "created-definition.json"), JsonConvert.SerializeObject(learned, Formatting.Indented));
    return new { passed = true, closed = "成形请求正式存读、各授予一次及实际使用", process = System.Diagnostics.Process.GetCurrentProcess().Id };
}
finally
{
    ConstructedAbilityService.CastStarted -= Started; ConstructedAbilityService.ContactConfirmed -= Hit;
    ConstructedAbilityService.CastEnded -= Ended; Config.paused = true; ControllableUnit.clear(false);
}
