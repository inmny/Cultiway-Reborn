const BindingFlags Flags = BindingFlags.Instance | BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic;
            string root = Cultiway.ModClass.I.GetDeclaration().FolderPath, folder = Path.Combine(root, "artifacts/skill_rebuild/operation-registration"); Directory.CreateDirectory(folder);
            var checks = new List<object>(); void Check(bool pass, string name, object evidence = null) => checks.Add(new { pass, name, evidence });
            bool Near(float a, float b) => Math.Abs(a - b) < .0002f; bool Same(Vector3 a, Vector3 b) => (a - b).magnitude < .0003f;
            AbilityDefinition Input() => JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root, "Doc/技能系统全面重构/构造输入/折向续行.json")));
            var frame = new AbilityInputs(Vector3.zero, Vector3.right * 12, Vector3.right, 1);
            AbilityCast Cast(AbilityDefinition d) => new(AbilityCompiler.Compile(d, false), Matrix4x4.identity, inputs: frame, force: 80, paidResource: 120);
            Vector3 Position(AbilityCast c) => c.ContactOrigin(0);
            void Reject(AbilityDefinition d, string field, string name) { try { AbilityCompiler.Compile(d, false); Check(false, name); } catch (InvalidDataException e) { Check(e.Message.Contains(field), name, e.Message); } }
            var save = (Action<AbilityCast>)typeof(AbilityCast).GetMethod("SaveStep", Flags).CreateDelegate(typeof(Action<AbilityCast>)); var restore = (Action<AbilityCast>)typeof(AbilityCast).GetMethod("RestoreStep", Flags).CreateDelegate(typeof(Action<AbilityCast>));
            var data = Input(); var cast = Cast(data); cast.Advance(.49f, Vector3.right * 12); Check(Same(cast.Velocity(0), Vector3.right * 2) && cast.OperationStateOf("root", "turn") == ConstructionStepState.Waiting, "定时时点前保留原运动及等待状态");
            cast.Advance(.01f, Vector3.right * 12); Check(Same(Position(cast), new Vector3(1, 0, .25f)) && Same(cast.Velocity(0), Vector3.up * 2), "新登记操作在准确时点转折，位置不跳变");
            Check(cast.OperationStateOf("root", "turn") == ConstructionStepState.Completed && cast.StepStateOf("freeze") == ConstructionStepState.Completed && cast.Matter(0).Id == "ice", "原操作真实结果放行普通改质步骤");
            cast.Advance(.5f, Vector3.right * 12); Check(Same(Position(cast), new Vector3(1, 1, .25f)) && Near(cast.RemainingForce(0), 80) && cast.TryGetOperationOutput("root", "turn", "deflected", out var fact) && Near((float)fact.Resource, 120), "运动改变但不复制主体、力量或支付份额");
            var views = new List<FormVisualInstance>(); cast.AppendVisuals(views); Check(views.Count == 1 && Same(views[0].Transform.GetColumn(3), Position(cast)), "正式显示读取转折后的同一实际主体");
            var timed = Input(); timed.Steps = Array.Empty<ConstructionStep>(); timed.Root.Operations[1].Id = null; var anonymous = Cast(timed); anonymous.Advance(1, Vector3.zero); Check(Same(Position(anonymous), new Vector3(1, 1, .25f)), "没有输出名的定时操作仍由共用时点执行");
            timed.Root.Operations = timed.Root.Operations.Concat(new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Deflect, At = 1, Vector = new[] { 0f, 0, 90 }, WorldVelocity = true } }).ToArray(); var repeated = Cast(timed); repeated.Advance(1.5f, Vector3.zero); Check(Same(Position(repeated), new Vector3(0, 1, .25f)), "多个新定时操作各执行一次，不被原专用字段的单项限制覆盖");
            var named = Input(); var turn = named.Root.Operations[1]; turn.Id = null; named.Root.Operations = named.Root.Operations.Take(1).ToArray(); named.Steps = new[] { new ConstructionStep { Id = "bend", Operation = turn, Inputs = new() { ["part"] = new() { Node = "root" } } } }; var namedCast = Cast(named); namedCast.Advance(1, Vector3.zero); Check(Same(Position(namedCast), new Vector3(1, 1, .25f)) && namedCast.StepStateOf("bend") == ConstructionStepState.Completed, "同一登记自然支持独立命名步骤");
            var conditional = Input(); conditional.Steps = Array.Empty<ConstructionStep>(); conditional.Root.Operations[1].At = 0; conditional.Root.Operations[1].When = new ConstructionCondition { Delay = .1f }; var eventCast = Cast(conditional); eventCast.Advance(.4f, Vector3.zero); eventCast.ConfirmContact(0, 1); eventCast.Advance(.05f, Vector3.zero); Check(Same(eventCast.Velocity(0), Vector3.right * 2), "真实接触后的延迟不会提前改变速度"); eventCast.Advance(.05f, Vector3.zero); Check(Same(eventCast.Velocity(0), Vector3.up * 2), "相同登记接收原有真实事件，不额外编写法术编号判断");
            var snapshot = Cast(Input()); snapshot.Advance(.3f, Vector3.zero); save(snapshot); snapshot.Advance(.7f, Vector3.zero); Vector3 expected = Position(snapshot); restore(snapshot); Check(Same(snapshot.Velocity(0), Vector3.right * 2) && snapshot.OperationStateOf("root", "turn") == ConstructionStepState.Waiting, "共同回退撤销新操作的接受、实际转折和输出"); snapshot.Advance(.7f, Vector3.zero); Check(Same(Position(snapshot), expected), "回退后重放不会重复叠加转角");
            var independent = Cast(Input()); independent.Advance(.3f, Vector3.zero); Check(Same(independent.Velocity(0), Vector3.right * 2), "共享参数不把前一施放的转折写入另一施放");
            var source = Input(); var immutable = Cast(source); source.Root.Operations[1].Vector[2] = -90; immutable.Advance(1, Vector3.zero); Check(Same(Position(immutable), new Vector3(1, 1, .25f)), "编译后修改原始角度数组不改变已有施放");
            var local = Input(); local.Steps = Array.Empty<ConstructionStep>(); local.Root.Rotation = new[] { 90f, 0, 0 }; local.Root.Operations[1].WorldVelocity = false; var localCast = Cast(local); localCast.Advance(.5f, Vector3.zero); Check(Same(localCast.Velocity(0), Vector3.forward * 2), "局部转角在执行时读取实际主体朝向，保留三维高度方向");
            var path = Input(); path.Steps = Array.Empty<ConstructionStep>(); path.Root.Operations[0].Acceleration = new[] { 0f, .5f, 0 }; path.Root.Operations[0].Path = new ConstructionPath { Forward = null, Keys = new[] { new ConstructionPathKey { Out = new[] { 0f, .4f, 0 } }, new ConstructionPathKey { At = 2, Point = new[] { 1f, 2, .5f }, In = new[] { -.3f, -.5f, 0 } } } }; var reference = ConstructionEditing.Copy(path); reference.Root.Operations = reference.Root.Operations.Take(1).ToArray(); var original = Cast(reference); var curved = Cast(path); original.Advance(.5f, Vector3.zero); curved.Advance(.5f, Vector3.zero); Vector3 pivot = Position(original); Check(Same(Position(curved), pivot), "曲线转折围绕当前实际位置，不瞬移到重启曲线起点"); original.Advance(.4f, Vector3.zero); curved.Advance(.4f, Vector3.zero); var quarter = Quaternion.Euler(0, 0, 90); Check(Same(Position(curved), pivot + quarter * (Position(original) - pivot)) && Same(curved.Velocity(0), quarter * original.Velocity(0)), "曲线时钟、瞬时速度和加速度一起转折，没有遗失原路径");
            var attached = Input(); attached.Root.Operations = attached.Root.Operations.Skip(1).ToArray(); attached.Steps = Array.Empty<ConstructionStep>(); var unavailable = Cast(attached); unavailable.Advance(1, Vector3.zero); Check(unavailable.OperationStateOf("root", "turn") == ConstructionStepState.Interrupted && !unavailable.TryGetOperationOutput("root", "turn", "deflected", out _), "没有真实自由运动时如实中断，不伪造成功输出");
            var invalid = Input(); invalid.Root.Operations[1].Clip = "swim"; Reject(invalid, "Clip", "新操作仍拒绝无关参数"); invalid = Input(); invalid.Root.Operations[1].Vector[0] = float.NaN; Reject(invalid, "Vector", "新操作使用相同有限数值边界"); invalid = Input(); invalid.Root.Operations[1].Kind = (ConstructionOperationKind)9999; Reject(invalid, "Operations", "未登记编号拒绝编译，不默认为其他操作");
            invalid = Input(); invalid.Root.Operations = invalid.Root.Operations.Concat(new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Flow, At = 1, Flow = new ConstructionFlow() } }).ToArray(); Reject(invalid, "转折", "完整结构检查拒绝以刚体转折冒充水格动量改变");
            var workerPlan = AbilityCompiler.Compile(Input(), false); bool worker = await Task.Run(() => { var run = new AbilityCast(workerPlan, Matrix4x4.identity, inputs: frame, force: 80, paidResource: 120); run.Advance(1, Vector3.zero); return Same(Position(run), new Vector3(1, 1, .25f)); }); Check(worker, "新登记的参数与数值执行可在工作线程使用");
            var assembly = typeof(AbilityCast).Assembly; var stepType = assembly.GetType("Cultiway.Core.Skills.AbilityStep"); var ctor = stepType.GetConstructors(Flags).Single(); var batch = assembly.GetType("Cultiway.Core.Skills.AbilityBatch").GetMethod("Advance", Flags); var shared = AbilityCompiler.Compile(Input(), false); var runs = Enumerable.Range(0, 128).Select(i => new AbilityCast(shared, Matrix4x4.identity, inputs: frame)).ToArray(); var steps = Array.CreateInstance(stepType, runs.Length); for (int i = 0; i < runs.Length; i++) { save(runs[i]); steps.SetValue(ctor.Invoke(new object[] { runs[i], new AbilityInputs(Vector3.zero, Vector3.right * 12, Vector3.right, 1), null, Vector3.right * 12, 1f, false }), i); }
            batch.Invoke(null, new object[] { steps, false }); Vector3[] sequential = runs.Select(Position).ToArray(); foreach (var run in runs) restore(run); batch.Invoke(null, new object[] { steps, true }); Check(runs.Select(Position).Zip(sequential, Same).All(x => x), "128份新操作在正式工作池与串行回退重放一致");

            // 正式世界只检查新增原理的支付、实际命中和构造保存恢复。
            Game.Resume(); Config.paused = true; ControllableUnit.clear(false); World.world.save_manager.loadWorld(Path.Combine(root, "Scripts/WorldSaveTests/Fixtures/world-format-1")); await Game.NextFrame(); await Game.WaitUntil(() => !SmoothLoader.isLoading(), 3600); Config.paused = true;
            var runnerType = assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner"); object runner = runnerType.GetProperty("Instance").GetValue(null); async Task Boundary() => await Game.WaitUntil(() => (bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner), 3600); await Boundary();
            var groundProvider = (Func<Rect, AbilityHeightField>)typeof(ConstructedAbilityService).GetField("GroundProvider", Flags).GetValue(null); groundProvider(new Rect(60, 68, 16, 16)); object sampler = groundProvider.Target.GetType().GetField("sampler", Flags).GetValue(groundProvider.Target); sampler.GetType().GetMethod("ScanLandformsForTest", Flags).Invoke(sampler, null); var ground = groundProvider(new Rect(60, 68, 16, 16));
            var stats = new BaseStats(); stats.addTag("frozen_ai"); stats.addTag("immovable"); var hold = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("test.registration.hold").SetStats(stats).SetDuration(10000).Build(); void Place(Actor a, float x, float y) { a.stopMovement(); a.current_position = new Vector2(x, y); a.setCurrentTile(World.world.GetTileSimple((int)x, (int)y)); a.updatePos(); ConstructedAbilityService.NotifyActorChanged(a); }
            foreach (var a in World.world.units.getSimpleList().ToArray()) { CombatStatusEffects.ApplyStatus(a, hold, 10000, a); Place(a, 12, 12); }
            Actor Actor(int x, int y) { var a = World.world.units.createNewUnit("human", World.world.GetTileSimple(x, y), pAdultAge: true, pSpawnWithItems: false); a.addTrait("super_health"); CombatStatusEffects.ApplyStatus(a, hold, 10000, a); Place(a, x, y); a.setStatsDirty(); a.updateStats(); return a; }
            var actor = Actor(64, 72); var enemy = Actor(68, 76); var wolf = World.world.units.createNewUnit("wolf", World.world.GetTileSimple(12, 12), pAdultAge: true); enemy.setKingdom(wolf.kingdom); enemy.setMana(0); actor.addAggro(enemy); enemy.addAggro(actor); var owner = actor.GetExtend(); owner.AddComponent(new Xian { level = 2, wakan = 10000 }); owner.MarkCultiwayStatsDirty(); actor.setStatsDirty(); actor.updateStats();
            var formal = Input(); formal.Id = "test.registration.formal"; formal.Lifetime = 3.2f; formal.Steps = Array.Empty<ConstructionStep>(); formal.Root.Offset = new float[3]; formal.Root.Operations[1].At = 1;
            float height = (float)assembly.GetType("Cultiway.Content.Combat.SpatialActorPose").GetMethod("Height", Flags).Invoke(null, new object[] { enemy }); formal.Binding.Height = height * .4f; formal.Root.Operations[0].Vector = new[] { 4f, 0, (ground.Sample(68, 76) - ground.Sample(64, 72)) / 2f }; ConstructedAbilityService.Register(formal); ConstructedAbilityService.Learn(owner, formal.Id);
            var captured = JObject.Parse(Cultiway.ModClass.I.WorldSaves.World.Capture(World.world, "operation-registration")); var stored = captured["sections"]["ability_constructions"]; Check((int)stored["data"]["Definitions"].Single(d => (string)d["Id"] == formal.Id)["Root"]["Operations"][1]["Kind"] == 13, "正式世界构造保存新增稳定编号和实际参数"); var replacement = ConstructionEditing.Copy(formal); replacement.Root.Operations = replacement.Root.Operations.Take(1).ToArray(); ConstructedAbilityService.Register(replacement); var payload = new JObject { ["formatVersion"] = SaveSectionRegistry<MapBox>.FormatVersion, ["sections"] = new JObject { ["ability_constructions"] = stored.DeepClone() } }; string untouched = payload.ToString(); var report = new SaveLoadReport(); Cultiway.ModClass.I.WorldSaves.World.Restore(World.world, untouched, report, "operation-registration", section => section.Id == "ability_constructions"); var restored = ConstructionEditing.Access.Read(formal.Id); Check(restored.Root.Operations.Any(op => op.Kind == ConstructionOperationKind.Deflect) && payload.ToString() == untouched, "正式恢复重新登记实际转折，原读取资料保持原样");
            var hits = new List<ConstructedContact>(); void Hit(ConstructedContact contact) { if (contact.AbilityId == formal.Id && contact.SourceId == actor.id) hits.Add(contact); }
            ConstructedAbilityService.ContactConfirmed += Hit;
            try { float balance = owner.GetCultisys<Xian>().wakan; int health = enemy.data.health; var handle = new ActiveAbilityHandle("content.constructed", owner.E, formal.Id); Check(ActiveAbilityService.TryUse(owner, handle, new ActiveAbilityTarget(enemy, enemy.GetSimPos()), ActiveAbilityUseOrigin.Script) && Near(balance - owner.GetCultisys<Xian>().wakan, formal.Cost), "恢复后的新操作构造经正式入口一次支付"); Config.paused = false; double until = World.world.getCurWorldTime() + 2.5; await Game.WaitUntil(() => World.world.getCurWorldTime() >= until, 3600); Config.paused = true; await Boundary(); Check(hits.Count == 1 && hits[0].TargetId == enemy.id && enemy.data.health < health, "实际折向后的主体命中拐角另一侧目标并扣血", hits.Select(h => new { h.Age, h.Node, h.TargetId }).ToArray()); } finally { ConstructedAbilityService.ContactConfirmed -= Hit; Config.paused = true; }
            bool Pass(object value) => (bool)value.GetType().GetProperty("pass").GetValue(value); var result = new { passed = checks.All(Pass), checks, process = System.Diagnostics.Process.GetCurrentProcess().Id }; File.WriteAllText(Path.Combine(folder, "checks.json"), JsonConvert.SerializeObject(result, Formatting.Indented)); return new { result.passed, checks = checks.Count };
