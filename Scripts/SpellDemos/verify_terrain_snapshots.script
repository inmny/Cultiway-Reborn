// 局部地表快照的公开行为、旧姿态保持和实际四百万格点更新开销。
using System;using System.IO;using System.Linq;using System.Reflection;using System.Collections.Generic;using System.Diagnostics;using Newtonsoft.Json;using UnityEngine;using Cultiway.Core.Skills;
string folder=Path.Combine(Cultiway.ModClass.I.GetDeclaration().FolderPath,"artifacts/skill_rebuild/terrain-world");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new InvalidOperationException(n);checks.Add(n);}
var input=Enumerable.Range(0,48).Select(i=>(float)i).ToArray();var first=new AbilityHeightField(8,6,new Vector2(16,12),input,-2);input[10]=999;Check(first.Sample(5,3)==10,"采集后修改原数组不改共享地表");int calls=0;var changed=first.WithRegion(new Rect(4,2,4,4),(x,y)=>{calls++;return 100+x+y;});Check(calls==4,"非等距地图只采集区域内实际格中心");Check(changed.Sample(5,3)==108&&changed.Sample(7,5)==112,"局部更新覆盖实际横纵采样位置");Check(first.Sample(5,3)==10&&first.Sample(7,5)==19,"后续更新保持旧快照和旧画面原值");Check(changed.Sample(3,3)==first.Sample(3,3)&&changed.Sample(9,7)==first.Sample(9,7),"区域之外没有被回调改写");Check(changed.Sample(-1,0)==-2&&changed.Minimum<=-2&&changed.Maximum>=112,"边界和保守裁剪保持");Check(ReferenceEquals(changed,changed.WithRegion(new Rect(4,2,4,4),(x,y)=>100+x+y)),"地面未变化时继续复用原快照");Check(ReferenceEquals(changed,changed.WithRegion(new Rect(50,50,2,2),(x,y)=>999)),"地图外更新不建立空快照");Check(ReferenceEquals(changed,changed.WithRegion(new Rect(0,0,0,0),(x,y)=>999)),"空区域不建立快照");bool rejected=false;try{changed.WithRegion(new Rect(4,2,4,4),(x,y)=>float.NaN);}catch(InvalidDataException){rejected=true;}Check(rejected&&changed.Sample(5,3)==108,"损坏新采样被拒绝且不改原快照");rejected=false;try{changed.WithRegion(new Rect(float.NaN,0,1,1),(x,y)=>0);}catch(ArgumentException){rejected=true;}Check(rejected,"非法外部区域被明确拒绝");
var large=new AbilityHeightField(2048,2048,new Vector2(2048,2048),new float[2048*2048]);var retained=new List<AbilityHeightField>{large};long memory=GC.GetTotalMemory(true);var allocatedMethod=typeof(GC).GetMethod("GetAllocatedBytesForCurrentThread",BindingFlags.Public|BindingFlags.Static);var allocated=allocatedMethod==null?null:(Func<long>)Delegate.CreateDelegate(typeof(Func<long>),allocatedMethod);long probe=allocated?.Invoke()??0;GC.KeepAlive(new byte[4096]);bool allocationMeasured=allocated!=null&&allocated()>probe;long allocatedBefore=allocationMeasured?allocated():0;int sampled=0;var watch=Stopwatch.StartNew();for(int i=1;i<=64;i++){int n=i;large=large.WithRegion(new Rect(100,100,5,5),(x,y)=>{sampled++;return n;});retained.Add(large);}watch.Stop();long allocatedBytes=(allocationMeasured?allocated():0)-allocatedBefore;long growth=GC.GetTotalMemory(true)-memory;Check(sampled==1600,"四百万格点的64次局部更新只采集1600项");Check(retained[0].Sample(102.5f,102.5f)==0&&retained[17].Sample(102.5f,102.5f)==17&&retained[64].Sample(102.5f,102.5f)==64,"保留多个历史快照仍各自不可变");Check(growth<32L*1024*1024,"保留65份四百万格点快照不复制65张整图");if(allocationMeasured)Check(allocatedBytes<8L*1024*1024,"局部更新的实际线程分配低于八MiB");var copy=(float[])typeof(AbilityHeightField).GetMethod("CopyValues",BindingFlags.Instance|BindingFlags.NonPublic).Invoke(large,null);Check(copy[102*2048+102]==64&&copy[80*2048+80]==0,"绘制展开的数组包含相同局部结果");copy[102*2048+102]=999;Check(large.Sample(102.5f,102.5f)==64,"显示上传数组不会暴露共享可变格点");
var blockField=typeof(AbilityHeightField).GetField("blocks",BindingFlags.Instance|BindingFlags.NonPublic);var uniqueBlocks=new HashSet<float[]>();long directorySlots=0;foreach(var snapshot in retained){var blocks=(float[][])blockField.GetValue(snapshot);directorySlots+=blocks.Length;foreach(var block in blocks)uniqueBlocks.Add(block);}long retainedFloatBytes=uniqueBlocks.Sum(b=>(long)b.Length)*sizeof(float),directoryBytes=directorySlots*IntPtr.Size;Check(retainedFloatBytes+directoryBytes<32L*1024*1024,"65份真实快照共享数据，实际保留数值及目录小于32MiB");var result=new{passed=true,checks,sampled,retained=retained.Count,retainedFloatBytes,directoryBytes,uniqueBlocks=uniqueBlocks.Count,milliseconds=watch.Elapsed.TotalMilliseconds,managedGrowth=growth,allocationMeasured,allocatedBytes};File.WriteAllText(Path.Combine(folder,"snapshots.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
