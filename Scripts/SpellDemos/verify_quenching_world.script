// 混合水柱按来源比例蒸散；代表来源局部干燥、冰、微小余火及世界收束边界。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using Newtonsoft.Json;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Content.Skills;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/quenching");var checks=new List<string>();void Check(bool value,string name){if(!value)throw new Exception(name);checks.Add(name);}object Field(object target,string name)=>target.GetType().GetField(name,F).GetValue(target);object Call(object target,string name,params object[] args)=>target.GetType().GetMethod(name,F).Invoke(target,args);var service=typeof(WorldMaterialService);var instance=service.GetField("instance",F).GetValue(null);
Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;var actor=World.world.units.createNewUnit("human",World.world.GetTileSimple(70,72),pAdultAge:true,pSpawnWithItems:false);double clock=World.world.getCurWorldTime();
AbilityMaterial Material(double volume,double paid){var d=JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/蓄水御炎.json")));d.Root.Volume=(float)volume;d.Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Flow).Flow.OpenBoundary=true;var cast=new AbilityCast(AbilityCompiler.Compile(d),Matrix4x4.identity,inputs:new AbilityInputs(new Vector3(70,72),new Vector3(90,72),Vector3.right,1),force:0,paidResource:paid);return (AbilityMaterial)Call(cast,"CaptureMaterial",0);}
long Accept(AbilityMaterial material)=>(long)service.GetMethod("Accept",F).Invoke(null,new object[]{material,actor.id,actor.id,"mana",0f,clock});
Accept(Material(16,4));Accept(Material(48,12));Call(instance,"ConvertOpenWater");Call(instance,"RebuildIndex");var rows=(IDictionary)service.GetField("rows",F).GetValue(null);var group=rows.Values.Cast<object>().Where(r=>(bool)Field(r,"WorldGrid")).GroupBy(r=>{var m=(AbilityMaterial)Field(r,"Material");var f=Field(m,"Flow");return ((Vector2)Field(f,"Origin")).ToString();}).First(g=>g.Count()==2);var pair=group.OrderBy(r=>(long)Field(r,"Id")).ToArray();var left=(AbilityMaterial)Field(pair[0],"Material");var right=(AbilityMaterial)Field(pair[1],"Material");var lf=Field(left,"Flow");var rf=Field(right,"Flow");var lw=(Vector3[])Field(lf,"Water");var rw=(Vector3[])Field(rf,"Water");int index=Enumerable.Range(0,lw.Length).First(i=>lw[i].x>.001&&rw[i].x>.001);float cell=(float)Field(lf,"Cell");Vector2 origin=(Vector2)Field(lf,"Origin");int n=left.Cells;
AbilityCapsule Shape(int i,float height=0){var point=new Vector3(origin.x+(i%n+.5f)*cell,origin.y+(i/n+.5f)*cell,height);return (AbilityCapsule)Activator.CreateInstance(typeof(AbilityCapsule),F,null,new object[]{0,point,point,cell*.4f,"fire",0,0,AbilityMatters.Resolve("fire",null,"测试"),Vector3.zero,1f, null},null);}
double Evaporate(long id,int i,AbilityCapsule fire,double maximum,out bool contacted){var changed=new List<long>();var args=new object[]{id,i,fire,maximum,changed,false};double removed=(double)service.GetMethod("EvaporateWater",F).Invoke(null,args);contacted=(bool)args[5];return removed;}
double a=lw[index].x,b=rw[index].x,budget=left.Resource+right.Resource;double removed=Evaporate((long)Field(pair[0],"Id"),index,Shape(index),(a+b)*cell*cell*.1,out bool touched);Check(touched&&removed>0,"共同水柱按真实高度与火接触");Check(Math.Abs((a-lw[index].x)/(b-rw[index].x)-a/b)<.0001,"混合水柱各来源按实际份额同比失水");Check(left.Resource+right.Resource<budget,"共同逐格支付随真实失水减少");double sum=left.Volume+right.Volume;Evaporate((long)Field(pair[0],"Id"),index,Shape(index,20),1,out touched);Check(!touched&&Math.Abs(left.Volume+right.Volume-sum)<1e-7,"空中火体不蒸散地面水柱");
Call(left,"EvaporateWater",index,1000d);service.GetField("instance",F).GetValue(null).GetType().GetField("indexDirty",F).SetValue(instance,true);double before=right.Volume;removed=Evaporate((long)Field(pair[0],"Id"),index,Shape(index),.1,out touched);Check(touched&&removed>0&&right.Volume<before,"代表来源在该格已干时，其他来源仍真实参与，不陷入零时间重试");
var recovery=new ConstructionOperation{Kind=ConstructionOperationKind.Recover,Seconds=2,Recovery=new ConstructionRecovery{Efficiency=.75f}};var compiledType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Skills.CompiledRecovery");object settings=Activator.CreateInstance(compiledType,F,null,new object[]{recovery,4f,"测试"},null);var isolated=Material(32,8);long recoveringId=Accept(isolated);var record=rows[recoveringId];Call(record,"Begin",settings);Call(record,"Step",clock+.1,null);double converted=(double)Field(record,"InitialResource")*(float)Field(record,"Progress");var flow=Field(isolated,"Flow");var water=(Vector3[])Field(flow,"Water");index=Array.FindIndex(water,v=>v.x>.001);origin=(Vector2)Field(flow,"Origin");cell=(float)Field(flow,"Cell");n=isolated.Cells;service.GetField("indexDirty",F).SetValue(instance,true);removed=Evaporate(recoveringId,index,Shape(index),.1,out touched);Check(touched&&removed>0&&!(bool)Field(record,"Recovering"),"世界收束中的水仍可灭火，接触后解除旧收束");double remaining=isolated.Volume;Call(record,"Step",clock+.2,null);Check(isolated.Volume<=remaining+.0001,"打断后继续世界不会按旧收束基数补回水量");Check((double)Field(record,"InitialResource")==0&&converted>0,"旧返还基数被解除，后续不会用旧进度重新领款");
var result=new{passed=true,checks};File.WriteAllText(Path.Combine(folder,"world-math.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
