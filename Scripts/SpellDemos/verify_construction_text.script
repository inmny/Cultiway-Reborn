// 规则名称由实际结构产生，说明读取当前计划，中英文与编辑后不沿用旧说明。
using System;
using System.IO;
using System.Linq;
using System.Collections.Generic;
using Newtonsoft.Json;
using Cultiway.Core.Skills;
var checks=new List<string>();void Check(bool v,string n){if(!v)throw new InvalidOperationException(n);checks.Add(n);Log.Info(n);}
var d=new AbilityDefinition{Id="test.text.wave",Name="自定旧名称",Cost=8,Cooldown=4,Lifetime=3,Binding=new ConstructionBinding{Anchor=AbilityAnchor.Source,Follow=true},Root=new ConstructionNode{Id="wave",Form="water_wave",Matter="water",Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Grow,Seconds=.5f},new ConstructionOperation{Kind=ConstructionOperationKind.Fly,Vector=new[]{4f,0f,0f},TurnRate=180},new ConstructionOperation{Kind=ConstructionOperationKind.Recover,At=2,Seconds=.4f,Recovery=new ConstructionRecovery()}}}};
var plan=AbilityCompiler.Compile(d,false);string name=ConstructionPresentation.Name(d,plan);LocalizedTextManager.instance.setLanguage("cz");string cz=ConstructionPresentation.Explain(d,plan);Check(name.Contains("水")&&name.Contains("归")&&name.Contains("浪"),"名称读取真实材料、回收机制和形体");Check(cz.Contains("8")&&cz.Contains("真元")&&cz.Contains("3")&&cz.Contains("4")&&cz.Contains("收束")&&cz.Contains("追踪"),"中文说明包含实际费用、历时、冷却及真实过程");var dye=ConstructionEditing.Copy(d);dye.Root.Tint=new[]{1f,.1f,.1f};dye.Root.Surface="ice";Check(ConstructionPresentation.Name(dye,AbilityCompiler.Compile(dye,false))==name,"染色和表面覆盖不冒充实际材料改名");LocalizedTextManager.instance.setLanguage("en");string en=ConstructionPresentation.Explain(d,plan);Check(en.Contains(LocalizedTextManager.getText("Cultiway.Construction.Resource.wakan")),"英文费用使用实际资源名称");Check(en.Contains("recovery")&&en.Contains("homing")&&!en.Contains("Cultiway."),"英文说明使用当前语言且没有未解析编号");Check(ConstructionPresentation.Name(d,plan)==name&&d.Name=="自定旧名称","固定规则名不受语言切换影响，读取说明不改写已有名称");
var changed=ConstructionEditing.Copy(d);changed.Cost=12;changed.Root.Matter="ice";changed.Root.Operations=changed.Root.Operations.Where(o=>o.Kind!=ConstructionOperationKind.Recover).ToArray();string edited=ConstructionPresentation.Explain(changed,AbilityCompiler.Compile(changed,false));Check(edited.Contains("12")&&!edited.Contains("recovery")&&edited!=en,"编辑后说明读取新计划，不保留旧费用和已删除过程");
var stop=new AbilityDefinition{Id="test.text.stop",Root=new ConstructionNode{Id="blade",Form="sword",Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Stop,When=new ConstructionCondition{Delay=.2f}}}}};Check(ConstructionPresentation.Explain(stop,AbilityCompiler.Compile(stop,false)).Contains("actual contact"),"条件过程明确说明实际接触，未声称无条件发生");var permanent=new AbilityDefinition{Id="test.text.permanent",Root=new ConstructionNode{Id="blade",Form="sword",Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Leave}}}};Check(ConstructionPresentation.Explain(permanent,AbilityCompiler.Compile(permanent,false)).Contains("until consumed"),"无到期留置明确写作世界持续结果");var conductor=new AbilityDefinition{Id="test.text.conductor",Root=new ConstructionNode{Id="conductor",Form="sword",Matter="iron",ContactRole=ConstructionContactRole.Decoration,Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Conduct,Conduction=new ConstructionConduction()}}}};Check(ConstructionPresentation.Explain(conductor,AbilityCompiler.Compile(conductor,false)).Contains("hostile"),"仅传导伤害也列出实际接触关系，不产生空白目标说明");LocalizedTextManager.instance.setLanguage("cz");string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/transmission");Directory.CreateDirectory(folder);var result=new{passed=true,checks,name,cz,en,edited};File.WriteAllText(Path.Combine(folder,"text.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
