// 复用原掌击场景的近身距离，一次真实攻击同时摆出前后和侧面的对照。
var definition = JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(folder, "definition.json")));
Actor source = Make(64.5f), touch = Make(64.85f), near = Make(67.5f, "wolf"),
    far = Make(70.5f, "wolf"), side = Make(68.5f, "wolf"), behind = Make(63.5f, "wolf");
touch.setKingdom(World.world.kingdoms_wild.get(AssetManager.actor_library.get("wolf").kingdom_id_wild));
var owner = source.GetExtend();
owner.NewCultisys(Cultisyses.Xian);
owner.GetCultisys<Xian>().level = 2;
owner.MarkCultiwayStatsDirty(); source.setStatsDirty(); source.updateStats();
var quietStats = new BaseStats(); quietStats.addTag("frozen_ai");
var quiet = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.Verify.BuryMountainPalm.Quiet")
    .SetStats(quietStats).SetDuration(10000).Build();
foreach (Actor actor in new[] { near, far })
{
    CombatStatusEffects.RemoveStatus(actor, hold);
    CombatStatusEffects.ApplyStatus(actor, quiet, 10000, actor);
    actor.updateStats();
}
Ready(source); await Advance(.16f);
float lane = 72.5f;
void Stage()
{
    Place(source, 64.5f, lane); Place(touch, 64.85f, lane);
    Place(near, 67.5f, lane); Place(far, 70.5f, lane);
    Place(side, 68.5f, 75.5f); Place(behind, 63.5f, lane);
    source.target_angle.z = 0f; source.current_rotation.z = 0f;
    foreach (Actor actor in new[] { source, touch })
    {
        actor.position_height = 0; actor.move_jump_offset = Vector2.zero; actor.shake_offset = Vector2.zero;
    }
    source.lookTowardsPosition(touch.current_position);
    foreach (Actor enemy in new[] { touch, near, far, side, behind })
    {
        source.addAggro(enemy); enemy.addAggro(source);
        ConstructedAbilityService.NotifyActorChanged(enemy);
    }
}
bool VisibleWave() => FormVisualScene.Instances.Any(instance => instance.Layer != null && instance.Resource.Description.Id == definition.Root.Form);
object Trace() => contacts.Select(fact => new { fact.TargetId, fact.Node, fact.Age, x = fact.Position.x, y = fact.Position.y,
    z = fact.Position.z, fact.TargetHealthBefore, fact.TargetHealthAfter, fact.ForceApplied, push = fact.VelocityChange.x }).ToArray();
async Task Pay()
{
    float before = source.stats[BaseStatses.MaxWakan.id] * .82f;
    owner.GetCultisys<Xian>().wakan = before;
    await Fire(definition, source, touch, aggro:false);
    owner.E.RemoveComponent<ConstructedKnowledge>();
    Check(Math.Abs(before - owner.GetCultisys<Xian>().wakan - definition.Cost) < .003f,
        "同一次掌击和传播只收一份真元");
}
try
{
    CompiledAbility plan = AbilityCompiler.Compile(definition, false);
    Check(plan.HasPropagation && plan.Body != null, "同一构造有身体接触及有限地表过程");
    Stage();
    int touchLife = touch.data.health, nearLife = near.data.health, farLife = far.data.health,
        sideLife = side.data.health, behindLife = behind.data.health;
    await Pay(); await Advance(.11f);
    Check(!VisibleWave() && contacts.Count == 0, "没有真实掌面命中时没有提前产生地波", Trace());
    var early = new List<object>();
    for (int step = 0; step < 5; step++)
    {
        await Advance(.04f);
        object entry = ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>()
            .FirstOrDefault(item => ((AbilityCast)Field(item, "Cast")).Plan.Id == definition.Id);
        var cast = entry == null ? null : (AbilityCast)Field(entry, "Cast");
        early.Add(new { age = cast?.Age, palm = cast?.BodyPose?.Hand.ToString("F3"), at = touch.current_position.ToString("F3") });
    }
    Check(contacts.Count == 1 && contacts[0].TargetId == touch.id && contacts[0].Node == -1 &&
        touch.data.health < touchLife && near.data.health == nearLife && far.data.health == farLife,
        "触点先承伤，后排尚未承伤", new { early, contacts = Trace(), touchLife, after = touch.data.health });
    await Advance(.26f);
    Check(VisibleWave() && !BodyControlState.IsBusy(source.id) && near.data.health < nearLife && far.data.health == farLife,
        "收掌归还身体后，先抵达较近后排，较远处尚未命中", Trace());
    await Advance(.5f);
    Check(far.data.health < farLife && side.data.health == sideLife && behind.data.health == behindLife &&
        contacts.Count(c => c.TargetId == touch.id) == 1, "只向前方传播，触点不重复扣血，侧面和身后不受击", Trace());
    var rear = contacts.Where(c => c.TargetId == near.id || c.TargetId == far.id).OrderBy(c => c.Age).ToArray();
    Check(rear.Length == 2 && rear[0].TargetId == near.id && rear[1].TargetId == far.id && rear.All(c => c.Node >= 0 && c.ForceApplied && c.VelocityChange.x > 0f),
        "两次后段伤害由推进中的波面造成，受力朝出掌方向", Trace());
    await Advance(1.4f);
    Check(!VisibleWave() && endings.Count == 1 && !endings[0].Fact.Cancelled, "传播独立自然结束并撤去");
    var hit = Trace(); contacts.Clear();

    Stage(); await Pay();
    Place(touch, 64.85f, 76.5f); ConstructedAbilityService.NotifyActorChanged(touch);
    float elapsed = 0f;
    while (elapsed < 2.6f)
    {
        await Advance(.13f); elapsed += .13f;
        if (VisibleWave() || contacts.Count != 0) break;
    }
    Check(contacts.Count == 0 && !VisibleWave() && endings.Count == 2 && !BodyControlState.IsBusy(source.id),
        "再次受理后，真实空掌不造波，照常归还身体", Trace());
    return new { passed = true, hit, noHitNaturalEnd = true };
}
finally
{
    ConstructedAbilityService.CastEnded -= Ended;
    ConstructedAbilityService.ContactConfirmed -= Hit;
    Config.paused = true; ControllableUnit.clear(false);
}
