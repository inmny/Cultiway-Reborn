// 正式支付、延迟投送后命中、接触停止后条件再启动，以及实际动量的世界转交。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Usage;
using Cultiway.Content.Skills;
using Cultiway.Content.Components;
using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Instance|BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/flow-flight");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}
var runnerType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=runnerType.GetProperty("Instance").GetValue(null);async Task Boundary()=>await Game.WaitUntil(()=>(bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);
async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;await Boundary();}
Config.paused=true;Game.Resume();Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();for(int y=40;y<100;y++)for(int x=30;x<125;x++)World.world.GetTileSimple(x,y).setTileTypes("sand",null);
var stats=new BaseStats();stats["mana"]=1024;stats["damage"]=40;stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.FlowFlightHold").SetStats(stats).SetDuration(10000).Build();
Actor Actor(int x,bool cultivated=true){var p=World.world.units.createNewUnit("human",World.world.GetTileSimple(x,72),pAdultAge:true,pSpawnWithItems:false);p.addTrait("super_health");if(cultivated)p.GetExtend().AddComponent(new Xian{level=2,wakan=100});Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(p,hold,10000,p);p.GetExtend().MarkCultiwayStatsDirty();p.setStatsDirty();p.updateStats();p.setMana(512);return p;}void Place(Actor p,float x){p.stopMovement();p.current_position=new Vector2(x,72);p.setCurrentTile(World.world.GetTileSimple((int)x,72));p.updatePos();}
var source=Actor(50);var target=Actor(60,false);var faction=World.world.units.createNewUnit("wolf",World.world.GetTileSimple(12,12),pAdultAge:true);Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(faction,hold,10000,faction);target.setKingdom(faction.kingdom);source.addAggro(target);target.addAggro(source);await Advance(.1f);Place(source,50);Place(target,60);
ConstructionOperation Fly(float at,float speed)=>new(){Kind=ConstructionOperationKind.Fly,At=at,Vector=new[]{speed,0f,0f},WorldVelocity=true,InheritVelocity=false};
AbilityDefinition Definition(string id)=>new(){Id=id,Name="流散投送验证",Resource="mana",Cost=8,Cooldown=0,Power=1,Lifetime=4,TargetRange=40,Binding=new ConstructionBinding{Anchor=AbilityAnchor.Source},Root=new ConstructionNode{Id="water",Form="water_flow",Matter="water",Volume=12,Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Flow,Flow=new ConstructionFlow{Cells=32,Size=40,Gravity=0,Drag=0,Evaporation=0,OpenBoundary=false}},Fly(.8f,6)}}};
bool Fire(AbilityDefinition d,Actor aim){ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(source.GetExtend(),d.Id);return ActiveAbilityService.TryUse(source.GetExtend(),new ActiveAbilityHandle("content.constructed",source.GetExtend().E,d.Id),new ActiveAbilityTarget(aim,aim.GetSimPos()),ActiveAbilityUseOrigin.Script);}
IList Casts()=>(IList)typeof(ConstructedAbilityService).GetField("casts",F).GetValue(null);AbilityCast Running(string id)=>Casts().Cast<object>().Select(r=>(AbilityCast)r.GetType().GetField("Cast",F).GetValue(r)).Single(c=>c.Plan.Id==id);void Cancel(){foreach(var r in Casts())((AbilityCast)r.GetType().GetField("Cast",F).GetValue(r)).Cancel();}
AbilityMaterialData Data(AbilityCast cast){var material=typeof(AbilityCast).GetMethod("CaptureMaterial",F).Invoke(cast,new object[]{0});return (AbilityMaterialData)typeof(AbilityMaterial).GetMethod("Capture",F).Invoke(material,null);}
Vector2 Centre(AbilityMaterialData d){double sum=0,x=0,y=0;int n=d.Flow.Settings.Cells;for(int i=0;i<n*n;i++){double h=d.Flow.Water[i*3];sum+=h;x+=h*(d.Flow.X+(i%n+.5)*d.Flow.Cell);y+=h*(d.Flow.Y+(i/n+.5)*d.Flow.Cell);}return new Vector2((float)(x/sum),(float)(y/sum));}
var hits=new List<ConstructedContact>();void Hit(ConstructedContact e){if(e.AbilityId.StartsWith("test.flow-flight."))hits.Add(e);}ConstructedAbilityService.ContactConfirmed+=Hit;
try{
var delayed=Definition("test.flow-flight.delayed");Check(Fire(delayed,target),"普通延迟水流从正式入口学习支付并施放");var body=Running(delayed.Id);Check(body.PaidResource==8,"本次施放保留八点真实支付");var initial=Centre(Data(body));int health=target.data.health;await Advance(.65f);Check(hits.Count==0&&target.data.health==health&&body.Velocity(0).sqrMagnitude<.00001f&&Vector2.Distance(initial,Centre(Data(body)))<.0001f,"真实世界时点之前不移动、不接触或扣血");await Advance(1.8f);Check(hits.Count==1&&hits[0].TargetId==target.id&&hits[0].SourceId==source.id&&hits[0].Age>=.8f,"普通投送开始后在实际路径上命中指定目标一次");Check(target.data.health<health&&hits[0].DamageAttempted,"实际接触进入正常伤害并扣血；health="+health+"/"+target.data.health+"; attempted="+hits[0].DamageAttempted+"; sourceDamage="+source.stats["damage"]);Check(body.Plan.FormCount==1&&Math.Abs(body.RemainingVolume(0)-12)<.0002,"投送不增加第二份主体或材料");
Cancel();await Advance(.1f);hits.Clear();Place(source,50);Place(target,60);var resumed=Definition("test.flow-flight.contact-restart");resumed.Root.OnContact=ConstructionContactResponse.Stop;resumed.Root.Operations[1]=Fly(0,4);var afterContact=Fly(0,6);afterContact.When=new ConstructionCondition{Trigger=ConstructionChangeTrigger.ActorContact,Delay=.5f};resumed.Root.Operations=resumed.Root.Operations.Concat(new[]{afterContact}).ToArray();Check(Fire(resumed,target),"接触停止及条件再投送使用同一正式构造入口");body=Running(resumed.Id);Config.paused=false;await Game.WaitUntil(()=>hits.Count>0,3600);Config.paused=true;await Boundary();Check(hits.Count==1&&body.Velocity(0).sqrMagnitude<.00001f,"真实接触后水格和公开速度同时停止");var stopped=Data(body);initial=Centre(stopped);await Advance(.1f);Check(Vector2.Distance(initial,Centre(Data(body)))<.0001f,"真实条件等待期间不偷走后续位移");await Advance(.6f);Check(body.Velocity(0).x>5.99f&&Centre(Data(body)).x>initial.x+.5f,"延迟条件结束后重新驱动同一份实际水体");Check(hits.Count==1&&Math.Abs(body.RemainingVolume(0)-12)<.0002,"再启动保留原接触去重与有限水量，不重复伤害已命中目标");
Cancel();await Advance(.1f);hits.Clear();var left=Definition("test.flow-flight.leave");left.Impact=new ConstructionImpact{Targets=SkillUseTargetRelation.Self,DamageScale=0};left.Root.ContactRole=ConstructionContactRole.Decoration;left.Root.Operations=left.Root.Operations.Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Leave,At=1.2f,Residue=new ConstructionResidue{Lifetime=0}}}).ToArray();Check(Fire(left,source),"延迟投送后的材料可以正式转交世界");body=Running(left.Id);await Advance(1.4f);var archive=JObject.Parse(Cultiway.ModClass.I.WorldSaves.World.Capture(World.world,"flow-flight"));var rows=(JArray)archive["sections"]["world_materials"]["data"]["Records"];var material=rows.Single()["Material"].ToObject<AbilityMaterialData>();double total=material.Flow.Water.Where((_,i)=>i%3==0).Sum(v=>(double)v),momentum=material.Flow.Water.Where((_,i)=>i%3==1).Sum(v=>(double)v);Check(body.Finished&&WorldMaterialService.Count==1&&material.ShapeHeld==false,"原施放结束后只有一份独立活动材料");Check(Math.Abs(momentum/total-6)<.001&&material.Resource==8&&Math.Abs(material.Volume-12)<.0002,"世界转交继承实际动量、体积及原支付，没有重新发射");
foreach(var p in World.world.units.dict.Values.ToArray()){Cultiway.Content.Combat.CombatStatusEffects.RemoveStatus(p,hold);p.GetExtend().MarkCultiwayStatsDirty();p.setStatsDirty();p.updateStats();}SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,source=source.id,target=target.id,definitions=new[]{delayed,resumed,left},world=Cultiway.ModClass.I.WorldSaves.World.Capture(World.world,"flow-flight"),person=Cultiway.ModClass.I.WorldSaves.Actors.Capture(source.GetExtend(),"flow-flight")},Formatting.Indented));Check(File.Exists(Path.Combine(folder,"save/map.wbox")),"普通、条件构造及带真实动量的材料完成正式保存");var result=new{passed=true,checks,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"runtime.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{ConstructedAbilityService.ContactConfirmed-=Hit;Config.paused=true;}
