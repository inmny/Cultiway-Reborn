// 活动水格、零余力、保持态、结束、收束、预测回退与不可变表面。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using Newtonsoft.Json;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Core.Visuals.Forms;
const BindingFlags F=BindingFlags.Instance|BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/active-water");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}
var assembly=typeof(AbilityCast).Assembly;var waterType=assembly.GetType("Cultiway.Core.Skills.ConductingWater");var listType=typeof(List<>).MakeGenericType(waterType);object Field(object o,string key)=>o.GetType().GetField(key,F).GetValue(o);object Call(object o,string method,params object[] args)=>o.GetType().GetMethod(method,F).Invoke(o,args);
AbilityDefinition Definition()=>JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/活动导电验证水流.json")));
AbilityCast Cast(AbilityDefinition d)=>new AbilityCast(AbilityCompiler.Compile(d),Matrix4x4.identity,inputs:new AbilityInputs(Vector3.zero,Vector3.right,Vector3.right,1),force:80,paidResource:8);
IList Water(AbilityCast c,float cell=1){var list=(IList)Activator.CreateInstance(listType);Call(c,"AppendConductingWater",-2L,cell,list);return list;}
string Snapshot(IList list)=>string.Join(";",list.Cast<object>().Select(w=>Field(w,"Index")+":"+Field(w,"Depth")+":"+Field(w,"Bottom")+":"+Field(w,"Area")));
bool Read(AbilityCast c,object w){object[] args={w,.02f,1f,Activator.CreateInstance(waterType)};return (bool)typeof(AbilityCast).GetMethod("ReadConductingWater",F).Invoke(c,args);}
var cast=Cast(Definition());cast.Advance(.2f,Vector3.right);var water=Water(cast);Check(water.Count>0&&water.Cast<object>().All(w=>(long)Field(w,"Source")==-2),"未留存的活动水体导出真实水格及施放标识");double volume=water.Cast<object>().Sum(w=>{var r=(Rect)Field(w,"Area");return (double)(float)Field(w,"Depth")*r.width*r.height;});Check(Math.Abs(volume-cast.RemainingVolume(0))<.002,"导出实际水深和边缘保留原体积，不重采样或生成第二份水");Check(Snapshot(Water(cast,8))==Snapshot(water),"共同格宽改变不扩大活动水体范围");object wet=water.Cast<object>().OrderByDescending(w=>(float)Field(w,"Depth")).First();Check(Read(cast,wet),"同一真实水格可重新确认");
Call(cast,"SaveStep");string before=Snapshot(Water(cast));cast.Advance(.3f,Vector3.right);Check(Snapshot(Water(cast))!=before,"活动水格随真实流散推进");Call(cast,"RestoreStep");Check(Snapshot(Water(cast))==before,"预测回退恢复原水格，不导出未来水深");
double budget=cast.RemainingResource(0),amount=cast.RemainingVolume(0);int index=(int)Field(wet,"Index");Call(cast,"PulseConduction",index);var frame=(FormLayerFrame)Call(cast,"ConductingFrame",0);int cellIndex=index%4096,n=frame.Cells;float glow=(float)Call(frame,"ConductionAt",cellIndex%n,cellIndex/n);Check(glow>0&&cast.RemainingResource(0)==budget&&cast.RemainingVolume(0)==amount,"已确认明暗不改变水量和原支付");cast.Advance(.5f,Vector3.right);var expired=(FormLayerFrame)Call(cast,"ConductingFrame",0);Check((float)Call(expired,"ConductionAt",cellIndex%n,cellIndex/n)==0&&(float)Call(frame,"ConductionAt",cellIndex%n,cellIndex/n)==glow,"表面按施放时间到期，旧发布帧保持不变");Call(cast,"ConsumeForce",0,1000f);Check(cast.RemainingForce(0)==0&&Water(cast).Count>0&&cast.RemainingVolume(0)>0,"攻击余力归零但实际存在的水仍可导电");
var conserved=Cast(Definition());conserved.Advance(2,Vector3.right);Check(conserved.RemainingResource(0)==8,"无蒸散的封闭水体不把浮点通量误差累计成原支付损耗");
var material=(AbilityMaterial)Call(conserved,"CaptureMaterial",0);Call(material,"Advance",2f,null);Check(material.Resource==8,"转交世界的封闭材料同样不因舍入扣原支付");
var evaporating=Definition();evaporating.Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Flow).Flow.Evaporation=.4f;var vapor=Cast(evaporating);vapor.Advance(1,Vector3.right);Check(Math.Abs(vapor.RemainingResource(0)-8*Math.Exp(-.4))<.0001,"真实蒸散仍按丢失比例扣除原支付");
var draining=Definition();var open=draining.Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Flow).Flow;open.OpenBoundary=true;open.Size=6;var outflow=Cast(draining);outflow.Advance(1,Vector3.right);Check(outflow.RemainingResource(0)<7.9&&outflow.RemainingResource(0)>=0,"真实外流仍消耗原支付，不把修正变成无限资源");
var ending=Cast(Definition());ending.Advance(.2f,Vector3.right);var old=Water(ending).Cast<object>().First(w=>(float)Field(w,"Depth")>.02);Call(ending,"EndNode",0);Check(Water(ending).Count==0&&!Read(ending,old),"部位结束后旧活动水格失效");var cancelled=Cast(Definition());cancelled.Advance(.2f,Vector3.right);old=Water(cancelled).Cast<object>().First(w=>(float)Field(w,"Depth")>.02);cancelled.Cancel();Check(Water(cancelled).Count==0&&!Read(cancelled,old),"整次取消后不保留幽灵导体");
var delayed=Definition();delayed.Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Flow).At=1;var waiting=Cast(delayed);waiting.Advance(.5f,Vector3.right);Check(Water(waiting).Count==0,"尚未开始流散的形体不冒充活动水格");waiting.Advance(.6f,Vector3.right);Check(Water(waiting).Count>0,"真实流散开始后才加入水路");
var frozen=Definition();frozen.Root.Operations=frozen.Root.Operations.Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.ConvertMatter,At=.5f,Matter="water",State="solid"},new ConstructionOperation{Kind=ConstructionOperationKind.ConvertMatter,At=.8f,Matter="water",State="liquid"}}).ToArray();var freeze=Cast(frozen);freeze.Advance(.2f,Vector3.right);old=Water(freeze).Cast<object>().First(w=>(float)Field(w,"Depth")>.02);freeze.Advance(.4f,Vector3.right);Check(Water(freeze).Count==0&&!Read(freeze,old),"活动水体真实冻结后停止导电");freeze.Advance(.3f,Vector3.right);Check(Water(freeze).Count>0,"同一部位真实解冻后再次导电，不另造材料");
var returning=Definition();returning.Root.Operations=returning.Root.Operations.Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Recover,At=.3f,Seconds=1,Recovery=new ConstructionRecovery{Efficiency=.75f}}}).ToArray();var recover=Cast(returning);recover.Advance(.6f,Vector3.right);Check(Water(recover).Count>0&&recover.RemainingVolume(0)<256,"收束中的实际剩余水仍按真实水深参与");recover.Advance(1,Vector3.right);Check(Water(recover).Count==0,"收束完毕不保留已经返还的水体");
var poolType=assembly.GetType("Cultiway.Core.Performance.SimulationWorkerPool");var pool=poolType.GetProperty("Instance",F).GetValue(null);var run=poolType.GetMethod("RunIndexed",F);string serial=Snapshot(Water(conserved));foreach(int count in new[]{32,128}){var values=new string[count];Action<int> work=i=>values[i]=Snapshot(Water(conserved));run.Invoke(pool,new object[]{0,count,work});Check(values.All(v=>v==serial),"活动水格在主线程和实际工作池中读取一致："+count);await Game.NextFrame();}
var result=new{passed=true,checks};File.WriteAllText(Path.Combine(folder,"math.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
