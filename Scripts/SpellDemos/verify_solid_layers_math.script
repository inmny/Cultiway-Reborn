// 固态留置、部分提取、重新液化、旧状态转换及实际工作池的一致性。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Content.Skills;
const BindingFlags F=BindingFlags.Instance|BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/solid-layers");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}
object Call(object o,string n,params object[] p)=>o.GetType().GetMethod(n,F).Invoke(o,p);
AbilityDefinition Definition(string matter)=>new(){Id="test.solid-layers",Resource="none",Cost=0,Lifetime=4,Root=new ConstructionNode{Id="layer",Form="water_flow",Matter="water",Volume=12,Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Flow,Flow=new ConstructionFlow{Cells=16,Size=24,Drag=0,Evaporation=0,OpenBoundary=false}},new ConstructionOperation{Kind=ConstructionOperationKind.ConvertMatter,At=.2f,Matter=matter,State="solid"}}}};
AbilityCast Cast(string matter){var c=new AbilityCast(AbilityCompiler.Compile(Definition(matter)),Matrix4x4.identity,inputs:new AbilityInputs(new Vector3(64,72),new Vector3(76,72),Vector3.right,1),paidResource:8);c.Advance(.3f,Vector3.zero);return c;}
AbilityMaterial Take(AbilityCast c)=>(AbilityMaterial)Call(c,"CaptureMaterial",0);
AbilityMaterialData Data(AbilityMaterial m)=>(AbilityMaterialData)Call(m,"Capture");
AbilityMaterial Restore(AbilityMaterialData d)=>(AbilityMaterial)typeof(AbilityMaterial).GetMethod("Restore",F).Invoke(null,new object[]{d});
AbilityMaterial Convert(AbilityMaterial m,string matter,string state)=>(AbilityMaterial)Call(m,"ConvertTo",AbilityMatters.Resolve(matter,state,"test"),null);
var held=new List<AbilityMaterialData>();
foreach(string name in new[]{"iron","wood","physical","water"}){var cast=Cast(name);var body=Take(cast);var before=Data(body);Check(before.ShapeHeld==true&&before.Flow.Bed!=null&&before.Flow.Water.Where((_,i)=>i%3!=0).All(v=>v==0),"活动部位转交保留明确固态定形："+name);Call(body,"Advance",.4f,null);Check(JsonConvert.SerializeObject(before)==JsonConvert.SerializeObject(Data(body)),"定形层不重新流动或改动基底："+name);var restored=Restore(before);Check(JsonConvert.SerializeObject(before)==JsonConvert.SerializeObject(Data(restored)),"正式材料资料恢复完整定形状态："+name);held.Add(before);}
var metal=Restore(held[0]);var liquid=Convert(metal,"iron","liquid");var start=Data(liquid);Check(start.ShapeHeld==false&&start.Flow.Bed==null&&start.Resource==8&&Math.Abs(start.Volume-12)<.0001,"金属重新液化清除定形，保留数量及原份额");Call(liquid,"Advance",.3f,null);var moving=Data(liquid);Check(!moving.Flow.Water.SequenceEqual(start.Flow.Water)&&moving.Resource==8,"液化金属按真实水深重新推进，不补造支付");
var wood=Restore(held[1]);var original=Data(wood);var picked=Enumerable.Range(0,original.Flow.Water.Length/3).Where(i=>original.Flow.Water[i*3]>.001f).Take(5).ToList();var part=(AbilityMaterial)Call(wood,"Extract",picked,.4,null);var left=Data(wood);var taken=Data(part);Check(left.ShapeHeld==true&&taken.ShapeHeld==true&&taken.Flow.Bed.SequenceEqual(original.Flow.Bed),"部分提取保留双方定形及原基底");Check(Math.Abs(left.Volume+taken.Volume-original.Volume)<.0001&&Math.Abs(left.Resource+taken.Resource-original.Resource)<1e-9,"部分提取不复制材料及支付份额");
Call(part,"HeatWood",taken.Volume*.125,41L,new Vector3(64,72));Call(part,"Advance",.1f,null);var burned=Data(part);Check(burned.Burning.Value.Lit&&burned.Volume<taken.Volume&&burned.ShapeHeld==true,"非默认保持的木层仍按真实燃料烧损并保持剩余形状；lit="+burned.Burning?.Lit+"; volume="+burned.Volume+"/"+taken.Volume+"; held="+burned.ShapeHeld);Check(!(bool)part.GetType().GetProperty("CanMerge",F).GetValue(part),"存在独立热量或烧损的层不会被合并抹掉来源");var burnedPart=(AbilityMaterial)Call(part,"Extract",Enumerable.Range(0,burned.Flow.Water.Length/3).ToList(),.5,null);var one=Data(part);var two=Data(burnedPart);Check(Math.Abs(one.Burning.Value.Heat+two.Burning.Value.Heat-burned.Burning.Value.Heat)<1e-9&&Math.Abs(one.Burning.Value.Burned+two.Burning.Value.Burned-burned.Burning.Value.Burned)<1e-9,"燃烧材料分开时真实分摊热量与累计烧损");
void Reject(AbilityMaterialData data,string label){try{Restore(data);throw new Exception("未拒绝："+label);}catch(TargetInvocationException e)when(e.InnerException is InvalidDataException){checks.Add(label);}}
AbilityMaterialData Copy(AbilityMaterialData data)=>JsonConvert.DeserializeObject<AbilityMaterialData>(JsonConvert.SerializeObject(data));
var invalid=Copy(held[0]);invalid.ShapeHeld=null;Reject(invalid,"当前数值材料必须明确保存定形状态");invalid=Copy(held[0]);invalid.Flow.Bed=null;Reject(invalid,"定形材料缺基底时明确拒绝");invalid=Copy(held[0]);invalid.ShapeHeld=false;Reject(invalid,"活动状态不能携带冻结基底");invalid=Copy(held[0]);invalid.Flow.Water[1]=1;Reject(invalid,"定形状态不能保留虚假的内部动量");
var migration=Activator.CreateInstance(typeof(AbilityCast).Assembly.GetType("Cultiway.Content.Skills.WorldMaterialsV3ToV4"),true);
var legacy=new JObject{["Records"]=new JArray(held.Select(data=>new JObject{["Material"]=JObject.FromObject(data)}))};foreach(JObject row in (JArray)legacy["Records"]){((JObject)row["Material"]).Remove("ShapeHeld");if((string)row["Material"]["Matter"]!="water")row["Material"]["Flow"]["Bed"]=null;}var old=legacy.DeepClone();var upgraded=(JObject)Call(migration,"Apply",legacy.DeepClone());var records=(JArray)upgraded["Records"];Check(records.Take(3).All(r=>!(bool)r["Material"]["ShapeHeld"])&&(bool)records[3]["Material"]["ShapeHeld"],"旧第三版只按原水冰规则保持，不倒推未保存的施放历史");Check(JToken.DeepEquals(old,legacy),"版本转换使用独立资料，输入原档未被回写");Check(records.Zip((JArray)old["Records"],(a,b)=>(double)a["Material"]["Volume"]==(double)b["Material"]["Volume"]&&(double)a["Material"]["Resource"]==(double)b["Material"]["Resource"]).All(v=>v),"版本转换不改变旧体积或原支付份额");
var oldIce=(JObject)records[3].DeepClone();oldIce["Material"]["Flow"]["Water"][1]=9;var normalize=(JObject)Call(migration,"Apply",new JObject{["Records"]=new JArray(oldIce)});Check((float)normalize["Records"][0]["Material"]["Flow"]["Water"][1]==0,"旧冰层暂停前的内部冲势经明确转换清除");
foreach(string name in new[]{"iron","wood","physical"}){var d=Definition(name);d.Root.Operations[1].WorldMatter=new ConstructionWorldMatter{FromMatter="water",MaximumVolume=4};AbilityCompiler.Compile(d);}checks.Add("已登记的普通固态输出共用世界材料转换，不新增整招类");
var unsupported=Definition("water");unsupported.Root.Operations[1].Matter="fire";unsupported.Root.Operations[1].State="energy";unsupported.Root.Operations[1].WorldMatter=new ConstructionWorldMatter{FromMatter="water",MaximumVolume=4};try{AbilityCompiler.Compile(unsupported);throw new Exception("能量输出被误作永久材料");}catch(InvalidDataException){checks.Add("未登记的世界能量输出明确拒绝，不猜测持久状态");}
var poolType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.SimulationWorkerPool");var pool=poolType.GetProperty("Instance",F).GetValue(null);var run=poolType.GetMethod("RunIndexed",F);var rowType=typeof(AbilityCast).Assembly.GetType("Cultiway.Content.Skills.WorldMaterialRecord");var step=rowType.GetMethod("Step",F);var capture=rowType.GetMethod("Capture",F);var reports=new List<object>();
foreach(int count in new[]{32,128}){object Row(int i){var row=Activator.CreateInstance(rowType,true);rowType.GetField("Material",F).SetValue(row,Restore(held[i%held.Count]));return row;}var serial=Enumerable.Range(0,count).Select(Row).ToArray();var parallel=Enumerable.Range(0,count).Select(Row).ToArray();for(int k=1;k<=3;k++){double time=k/30d;foreach(var row in serial)step.Invoke(row,new object[]{time,null});Action<int> action=i=>step.Invoke(parallel[i],new object[]{time,null});run.Invoke(pool,new object[]{0,count,action});}Check(serial.Select(r=>JsonConvert.SerializeObject(capture.Invoke(r,null))).SequenceEqual(parallel.Select(r=>JsonConvert.SerializeObject(capture.Invoke(r,null)))),"多种固态层在实际工作池与串行一致："+count);reports.Add(new{count,error=0});await Game.NextFrame();}
var result=new{passed=true,checks,reports,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"math.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
