// 另一个真实进程恢复独立材料；坏条目只影响自身，不重放转交或已确认回能。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using Cultiway.Core.Skills;
using Cultiway.Content.Skills;
using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Static|BindingFlags.Instance;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/world-materials");var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));Check((int)expected["process"]!=System.Diagnostics.Process.GetCurrentProcess().Id,"依据来自真正退出前的另一进程");var saves=Cultiway.ModClass.I.WorldSaves;JObject Archive(string json)=>(JObject)JObject.Parse(json)["sections"]["world_materials"]["data"];
var changes=new List<WorldMaterialChange>();void Event(WorldMaterialChange e)=>changes.Add(e);WorldMaterialService.Changed+=Event;
try{
 Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;var actor=World.world.units.get((long)expected["actor"]);Check(actor!=null,"恢复真实原支付者");var before=Archive((string)expected["world"]);var after=Archive(saves.World.Capture(World.world,"restart"));Check((long)before["Next"]==(long)after["Next"]&&((JArray)before["Records"]).Count==((JArray)after["Records"]).Count,"独立稳定编号及记录集合恢复");
 foreach(var row in (JArray)before["Records"]){var restored=((JArray)after["Records"]).Single(r=>(long)r["Id"]==(long)row["Id"]);Check(JToken.DeepEquals(row["Material"],restored["Material"]),"水深、动量、姿态和未耗份额原样恢复："+row["Id"]);Check(new[]{"Recovering","Seconds","Efficiency","Progress","InitialResource","InitialVolume","Confirmed","Fraction","Provider","Controller","Resource"}.All(k=>JToken.DeepEquals(row[k],restored[k])),"独立收束进度及已确认累计恢复："+row["Id"]);}
 Check(changes.Count==0&&!saves.LastReport.RequiresBackup,"暂停读档没有重放支付、攻击、转交和回能，也没有丢弃有效资料");Check(Cultiway.Core.Visuals.Forms.FormVisualScene.Instances.Count>=((JArray)after["Records"]).Count,"暂停读档即发布实际材料，无需重新施法才显示");
 long selected=(long)expected["selected"];var original=((JArray)before["Records"]).Single(r=>(long)r["Id"]==selected);double maximum=(double)original["InitialResource"]*(double)original["Efficiency"]-(double)original["Confirmed"]+(double)original["Fraction"];
 var stats=new BaseStats();stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.WorldMaterialColdHold").SetStats(stats).SetDuration(10000).Build();Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(actor,hold,10000,actor);actor.setStatsDirty();actor.updateStats();
 double until=World.world.getCurWorldTime()+10;Config.paused=false;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,1800);Config.paused=true;var t=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=t.GetProperty("Instance").GetValue(null);await Game.WaitUntil(()=>(bool)t.GetProperty("IsAtCycleBoundary").GetValue(runner),1800);double grant=changes.Where(e=>e.Id==selected&&e.Kind=="credit").Sum(e=>e.Granted);Check(grant>0&&grant<=maximum+.00001&&Math.Abs(grant-maximum)<.001,"冷启动后只发尚未确认的份额，合计没有重复回能");Check(!((JArray)Archive(saves.World.Capture(World.world,"after"))["Records"]).Any(r=>(long)r["Id"]==selected),"独立收束结束后真实移除世界材料");
 // 只恢复世界材料区段，混入三个坏条目，其他世界和人物数据不改写。
 var valid=Archive(saves.World.Capture(World.world,"valid"));int count=((JArray)valid["Records"]).Count;var corrupted=(JObject)valid.DeepClone();var records=(JArray)corrupted["Records"];var bad=(JObject)records[0].DeepClone();bad["Id"]=(long)corrupted["Next"];corrupted["Next"]=(long)corrupted["Next"]+1;bad["Material"]["Form"]="removed-model";records.Add(bad);records.Add("wrong-record");records.Add(JValue.CreateNull());var instance=typeof(WorldMaterialService).GetField("instance",F).GetValue(null);typeof(WorldMaterialService).GetMethod("Clear",F).Invoke(instance,null);string source=new JObject{["formatVersion"]=1,["sections"]=new JObject{["world_materials"]=new JObject{["version"]=1,["data"]=corrupted}}}.ToString();saves.World.Restore(World.world,source,saves.LastReport,"materials-corrupt",s=>s.Id=="world_materials");Check(WorldMaterialService.Count==count&&saves.LastReport.RequiresBackup,"未知形体、错误条目和空值仅局部丢弃并报告，其他材料继续加载");Check(((JArray)valid["Records"]).Count==count,"输入原档的有效记录保持原样");
 var ui=JObject.Parse(File.ReadAllText(Path.Combine(folder,"ui/restart-expected.json")));Check((int)ui["process"]!=System.Diagnostics.Process.GetCurrentProcess().Id,"表单保存依据同样来自另一进程");World.world.save_manager.loadWorld(Path.Combine(folder,"ui/save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;var savedDefinitions=(JArray)JObject.Parse((string)ui["world"])["sections"]["ability_constructions"]["data"]["Definitions"];string editedId=(string)savedDefinitions.Single(d=>d["Root"] is JObject&&((JArray)d["Root"]["Operations"]).Any(o=>(int)o["Kind"]==(int)ConstructionOperationKind.Leave)&&((JArray)d["Root"]["Operations"]).Any(o=>(bool?)o["Recovery"]?["WorldMaterials"]==true))["Id"];var edited=ConstructionEditing.Access.Read(editedId);Check(edited.Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Leave).Residue.Lifetime==30&&edited.Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Recover).Recovery.WorldMaterials,"真实表单的独立时长及世界选择选项在冷启动恢复");Check(!saves.LastReport.RequiresBackup,"表单世界有效资料没有局部丢弃");
 var result=new{passed=true,checks,grant,maximum,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"restart.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{WorldMaterialService.Changed-=Event;Config.paused=true;}
