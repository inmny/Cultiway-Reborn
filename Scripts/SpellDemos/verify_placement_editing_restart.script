// 必须真正退出并重启游戏，核对编辑得到的随动、环绕及修士创作资料。
using System;
using System.IO;
using System.Linq;
using System.Collections.Generic;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core;
using Cultiway.Core.Skills;
using Cultiway.Core.Visuals.Forms;
using Cultiway.Utils.Extension;

string folder=Path.Combine(Cultiway.ModClass.I.GetDeclaration().FolderPath,"artifacts/skill_rebuild/placement-editing");
var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));
if((int)expected["process"]==System.Diagnostics.Process.GetCurrentProcess().Id)throw new InvalidOperationException("需要真正退出并重启游戏");
Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;
var actor=World.world.units.get((long)expected["actor"]);var saves=Cultiway.ModClass.I.WorldSaves;var access=ConstructionEditing.Access;var checks=new List<string>();
void Check(bool value,string name){if(!value)throw new InvalidOperationException(name);checks.Add(name);}
JToken Section(string value,string id)=>JObject.Parse(value)["sections"][id]["data"];
Check(actor!=null,"原版保存恢复实际持有者");
Check(JToken.DeepEquals(Section((string)expected["world"],"ability_constructions"),Section(saves.World.Capture(World.world,"placement"),"ability_constructions")),"完整连接、环绕及修士创法资料恢复，没有重新抽取");
Check(JToken.DeepEquals(Section((string)expected["person"],"ability_knowledge"),Section(saves.Actors.Capture(actor.GetExtend(),"placement"),"ability_knowledge")),"全部已学关系及顺序恢复");
var definition=access.Read("Cultiway.Demo.OrbitWave");
Check(definition.Root.Form=="pivot"&&definition.Root.Children[0].Form=="water_wave"&&definition.Binding.Anchor==AbilityAnchor.Source&&definition.Binding.Follow,"原浪体、旋转支点及随动连接重新载入");
var input=new AbilityInputs(new Vector3(2,4,0),new Vector3(10,0,0),Vector3.right,1);var cast=new AbilityCast(access.Validate(definition),Matrix4x4.identity,inputs:input);cast.Advance(1,input.Target);var views=new List<FormVisualInstance>();cast.AppendVisuals(views);
Check(views.Count==1&&Vector3.Distance(views[0].Transform.GetColumn(3),new Vector3(2,7,.15f))<.0002f,"重编译后只有实际浪体显示并沿保存的圆周运动");
Check(!saves.LastReport.RequiresBackup,"正式可选资料恢复没有局部丢弃");
var result=new{passed=true,checks,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"restart-result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
