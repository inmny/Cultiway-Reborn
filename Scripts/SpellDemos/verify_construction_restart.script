// 必须退出并重启独立测试游戏后运行，验证完整原版世界文件内的构造和人物关系。
using System;
using System.IO;
using System.Linq;
using System.Collections.Generic;
using Newtonsoft.Json.Linq;
using Cultiway.Content.Skills;
using Cultiway.Core;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.Skills;
using Cultiway.Utils.Extension;

string folder = Path.Combine(Cultiway.ModClass.I.GetDeclaration().FolderPath,"artifacts/skill_rebuild");
var expected = JObject.Parse(File.ReadAllText(Path.Combine(folder,"construction-restart-expected.json")));
if ((int)expected["process"]==System.Diagnostics.Process.GetCurrentProcess().Id)
    throw new InvalidOperationException("此检查需要退出并重启测试游戏");
Config.paused=true; Game.Resume();
World.world.save_manager.loadWorld(Path.Combine(folder,"constructed-save"));
await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800); Config.paused=true;
var actor = World.world.units.get((long)expected["actor"]);
if (actor==null) throw new InvalidOperationException("原版世界文件中缺少创造者，请核对保存前的新生单位收集步骤");
var abilities = new List<ActiveAbilityHandle>(); ActiveAbilityService.Collect(actor.GetExtend(),abilities);
string id=(string)expected["id"];
var handle=abilities.Single(item=>item.ProviderId=="content.constructed"&&item.EntryId==id);
string json=Cultiway.ModClass.I.WorldSaves.World.Capture(World.world,"test");
var definitions=JObject.Parse(json)["sections"]["ability_constructions"]["data"]["Definitions"];
// 新增的可选字段用当前正式默认值补全；缺省与显式保存同值在语义上相同。
JToken Normalized(JToken value)=>JToken.Parse(Newtonsoft.Json.JsonConvert.SerializeObject(
    value.ToObject<AbilityDefinition[]>(),new Newtonsoft.Json.JsonSerializerSettings{NullValueHandling=Newtonsoft.Json.NullValueHandling.Ignore}));
if (!JToken.DeepEquals(Normalized(expected["definition"]),Normalized(definitions))) throw new InvalidOperationException("冷启动后构造发生变化或重新随机创作");
string bodyId=(string)definitions.Single(item=>((string)item["Id"]).StartsWith("test.saved-body."))["Id"];
if (!abilities.Any(item=>item.ProviderId=="content.constructed"&&item.EntryId==bodyId))
    throw new InvalidOperationException("冷启动没有保留改造身体构造的已学关系");
var rigDefinition=definitions.Single(item=>((string)item["Id"]).StartsWith("test.saved-rig.")).ToObject<AbilityDefinition>();
if(!abilities.Any(item=>item.EntryId==rigDefinition.Id))throw new InvalidOperationException("冷启动没有保留连续形体构造的已学关系");
var rigCast=new AbilityCast(AbilityCompiler.Compile(rigDefinition),UnityEngine.Matrix4x4.identity);
rigCast.Advance(.7f,UnityEngine.Vector3.zero);
var rigViews=new List<Cultiway.Core.Visuals.Forms.FormVisualInstance>();rigCast.AppendVisuals(rigViews);
if(rigViews.Count!=2||rigViews[0].Skin.Length!=32||rigViews[0].Skin.All(m=>m==UnityEngine.Matrix4x4.identity))
    throw new InvalidOperationException("冷启动未恢复制作动作及尾部挂点构造");
string projection=(string)expected["projection"];
if(projection!=null&&!abilities.Any(item=>item.ProviderId=="content.constructed"&&item.EntryId==projection))
    throw new InvalidOperationException("冷启动没有保留连接及接触改造的已学关系");
var state=ActiveAbilityService.ResolveControlState(actor.GetExtend(),handle);
if (state.BlockReason!=ActiveAbilityControlBlockReason.Cooldown || state.CooldownRemaining<4f)
    throw new InvalidOperationException("冷启动未保留必要施放恢复时间");
if (Cultiway.ModClass.I.WorldSaves.LastReport.RequiresBackup)
    throw new InvalidOperationException("当前构造格式正常恢复却产生了局部丢弃");
// 旧正式v1没有接触频率字段，恢复必须继续每人一次，不能暗中新增周期伤害。
var legacy=JObject.Parse(json);
foreach(var value in ((JArray)legacy["sections"]["ability_constructions"]["data"]["Definitions"]).DescendantsAndSelf().OfType<JObject>().ToArray())
    value.Remove("Contact");
var report=new Cultiway.Core.Persistence.SaveLoadReport();
var saves=Cultiway.ModClass.I.WorldSaves;
saves.World.Restore(World.world,legacy.ToString(),report,"legacy-contact",section=>section.Id=="ability_constructions",false);
foreach(var entry in legacy["sections"]["ability_constructions"]["data"]["Definitions"])
{
    var plan=AbilityCompiler.Compile(entry.ToObject<AbilityDefinition>());
    var policies=(Array)typeof(CompiledAbility).GetProperty("ContactPolicies",System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic).GetValue(plan);
    foreach(var policy in policies)
        if((ConstructionContactMode)policy.GetType().GetField("Mode",System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic).GetValue(policy)!=ConstructionContactMode.Once)
            throw new InvalidOperationException("缺省接触规则未保持旧正式格式的每人一次");
}
saves.World.Restore(World.world,json,report,"current-contact",section=>section.Id=="ability_constructions",false);
if(report.RequiresBackup)throw new InvalidOperationException("旧正式缺省接触规则恢复发生丢弃");
var result=new {passed=true,process=System.Diagnostics.Process.GetCurrentProcess().Id,actor=actor.id,id,
    unchangedDefinition=true,learned=true,rigRestored=true,cooldown=state.CooldownRemaining,legacyDefaultOnce=true,validation="真实退出重启后的构造、已学关系、冷却、连续动作及旧正式接触默认值；未验收画面或性能"};
File.WriteAllText(Path.Combine(folder,"construction-restart-result.json"),Newtonsoft.Json.JsonConvert.SerializeObject(result));
return result;
