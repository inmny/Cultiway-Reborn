// 真正重启后验证版本书籍、读者、功法传承与未完成领悟。
using System;
using System.IO;
using System.Linq;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using Cultiway.Core;
using Cultiway.Core.Components;
using Cultiway.Core.Skills;
using Cultiway.Content.Components;
using Cultiway.Content.Extensions;
using Cultiway.Content.Skills;
using Cultiway.Utils.Extension;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/transmission");var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));if((int)expected["process"]==System.Diagnostics.Process.GetCurrentProcess().Id)throw new InvalidOperationException("需要真正退出重启游戏");var checks=new List<string>();void Check(bool v,string n){if(!v)throw new InvalidOperationException(n);checks.Add(n);Log.Info(n);}
var runnerType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=runnerType.GetProperty("Instance").GetValue(null);async Task Boundary()=>await Game.WaitUntil(()=>(bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);async Task Advance(){Config.paused=false;double until=World.world.getCurWorldTime()+.1;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;await Boundary();}
Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();var author=World.world.units.get((long)expected["author"]);var reader=World.world.units.get((long)expected["reader"]);var student=World.world.units.get((long)expected["student"]);var access=ConstructionEditing.Access;var original=expected["original"].ToObject<AbilityDefinition>();var revised=expected["revised"].ToObject<AbilityDefinition>();
Check(new[]{author,reader,student}.All(a=>a!=null&&a.isAlive()),"三名原版人物及其模组资料完整恢复");Check(JToken.DeepEquals(JObject.Parse(JsonConvert.SerializeObject(access.Read(original.Id))),expected["original"])&&JToken.DeepEquals(JObject.Parse(JsonConvert.SerializeObject(access.Read(revised.Id))),expected["revised"]),"旧术与作者新修订的完整构造、名称、创造者和直接来源保持");
Book book=World.world.books.get((long)expected["first"]);Check(book!=null&&book.GetExtend().GetComponent<ConstructionBook>().AbilityId==original.Id&&book.data.name==original.Name,"旧法术书恢复确定引用及正式名称，没有跟随作者改造");Check(ConstructedAbilityService.Knows(reader.GetExtend(),original.Id)&&ConstructedAbilityService.Knows(reader.GetExtend(),revised.Id),"读者已经掌握的两个版本独立恢复");var sect=Cultiway.WorldboxGame.I.Sects.get((long)expected["sect"]);Check(sect.Scriptures.ContainsConstruction(revised.Id)&&World.world.cities.get((long)expected["city"]).getBooks().Contains(book.id),"宗门和城市的实际藏书关系恢复");
var gong=Cultiway.Content.Libraries.Manager.CultibookLibrary.get((string)expected["gong"]);var improved=Cultiway.Content.Libraries.Manager.CultibookLibrary.get((string)expected["improved"]);var learner=student.GetExtend();Check(gong!=null&&improved!=null&&gong.ConstructionPool.Any(e=>e.AbilityId==original.Id)&&improved.ConstructionPool.Any(e=>e.AbilityId==original.Id)&&learner.GetMainCultibook()==gong,"功法及其改进保留确定传承，实际主修引用恢复");Check(reader.GetExtend().HasMaster()&&reader.GetExtend().GetMaster()==author&&reader.GetExtend().GetMainCultibook()==gong,"师徒传授得到的主修及实际师徒关系恢复");Check(Math.Abs(learner.GetComponent<ActorCultibookState>().ConstructionProgress[original.Id]-(float)expected["progress"])<1e-6f&&!ConstructedAbilityService.Knows(learner,original.Id),"未成功的领悟进度按长期能力编号恢复，未提前授予");gong.ConstructionPool[0].BaseChance=100;Check(learner.TryComprehendSkill()&&ConstructedAbilityService.Knows(learner,original.Id),"恢复后经原有领悟入口真正学会书中确定版本");Check(!learner.TryComprehendSkill()&&!learner.GetComponent<ActorCultibookState>().ConstructionProgress.ContainsKey(original.Id),"已经学会后不重复领悟，已完成进度释放");
SaveManager.saveWorldToDirectory(Path.Combine(folder,"after-save"));World.world.save_manager.loadWorld(Path.Combine(folder,"after-save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();await Advance();learner=World.world.units.get((long)expected["student"]).GetExtend();Check(ConstructedAbilityService.Knows(learner,original.Id)&&!learner.GetComponent<ActorCultibookState>().ConstructionProgress.ContainsKey(original.Id),"再次存读档保留正式掌握，不重放领悟");Check(Cultiway.ModClass.I.WorldSaves.LastReport.Skipped.Count==0&&Cultiway.ModClass.I.WorldSaves.LastReport.BackupError==null,"当前格式没有丢弃其他世界资料");var result=new{passed=true,checks,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"restart-result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
