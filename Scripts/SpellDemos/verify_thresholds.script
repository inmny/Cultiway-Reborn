// 损耗和尺寸条件、阈值事实、正式交锋与后段命中，独立保存世界。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core;
using Cultiway.Core.Skills;
using Cultiway.Core.Visuals.Forms;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Content.Skills;
using Cultiway.Content.Combat;
using Cultiway.Content.Components;
using Cultiway.Utils.Extension;

string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/thresholds");Directory.CreateDirectory(folder);
var checks=new List<string>();void Check(bool value,string name){if(!value)throw new InvalidOperationException(name);checks.Add(name);}
void Reject(Action action,string name){try{action();}catch(InvalidDataException){checks.Add(name);return;}throw new InvalidOperationException(name);}
const BindingFlags Instance=BindingFlags.Instance|BindingFlags.NonPublic;
AbilityDefinition Read(string name)=>JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/"+name+".json")));
var release=Read("长成后继续飞行");var seed=Read("损耗后独立长枝");var ward=Read("损耗验证迎击");var input=new AbilityInputs(Vector3.zero,Vector3.right*8,Vector3.right,1);
AbilityCast Cast(AbilityDefinition d)=>new(AbilityCompiler.Compile(d),Matrix4x4.identity,inputs:input,force:20);
List<FormVisualInstance> Views(AbilityCast c){var r=new List<FormVisualInstance>();c.AppendVisuals(r);return r;}
float Scale(AbilityCast c)=>Views(c).First().Transform.lossyScale.x;
void Spend(AbilityCast c,float amount,Vector3 point){typeof(AbilityCast).GetMethod("ConfirmClash",Instance).Invoke(c,new object[]{0,point,amount});typeof(AbilityCast).GetMethod("ConsumeForce",Instance).Invoke(c,new object[]{0,amount});}
var c=Cast(release);c.Advance(.5f,input.Target);c.ConfirmContact(0,1);c.Advance(.549f,input.Target);Check(c.Velocity(0)==Vector3.zero,"尚未长到指定尺寸时不提前改变飞行");c.Advance(.001f,input.Target);Check(c.Velocity(0).x==3&&Mathf.Abs(Scale(c)-.9f)<.00001f,"真实尺寸达到1.5时在共同边界改变同一主体的运动");var point=c.ContactOrigin(0);c.Advance(.2f,input.Target);Check(Mathf.Abs(c.ContactOrigin(0).x-point.x-.6f)<.0001f,"阈值之后的实际运动从当时位置继续");
var shrink=ConstructionEditing.Copy(release);shrink.Root.Operations.First(o=>o.Kind==ConstructionOperationKind.Grow).TargetScale=.5f;shrink.Root.Operations.Last().When.Trigger=ConstructionChangeTrigger.SizeBelow;shrink.Root.Operations.Last().When.Threshold=.75f;c=Cast(shrink);c.Advance(.5f,input.Target);c.ConfirmContact(0,1);c.Advance(.55f,input.Target);Check(c.Velocity(0).x==3&&Mathf.Abs(Scale(c)-.45f)<.0001f,"收缩按自己的向下阈值触发，不误作长大事件");
var initial=new AbilityDefinition{Id="test.threshold.initial",Lifetime=3,Resource="none",Root=new ConstructionNode{Id="grow",Form="branch",Matter="wood",Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Grow,Seconds=1}},Children=new[]{new ConstructionNode{Id="above",Form="sword",Activation=new ConstructionActivation{Trigger=ConstructionChangeTrigger.SizeAbove,Threshold=.5f,Delay=.1f}},new ConstructionNode{Id="below",Form="sword",Activation=new ConstructionActivation{Trigger=ConstructionChangeTrigger.SizeBelow,Threshold=.5f}}}}};
c=Cast(initial);Check(c.NodeAge(2)<0,"出生时的初始尺寸不伪造收缩事件");c.Advance(.59f,input.Target);Check(c.NodeAge(1)<0,"达到阈值后的延迟仍由正式开始时钟控制");c.Advance(.011f,input.Target);Check(Mathf.Abs(c.NodeAge(1)-.001f)<.00001f&&c.NodeAge(2)<0,"初始生长可开始新部位，反方向条件不会混触发");
var frozen=ConstructionEditing.Copy(release);frozen.Root.Operations=frozen.Root.Operations.Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.ConvertMatter,Matter="ice",At=.9f},new ConstructionOperation{Kind=ConstructionOperationKind.ConvertMatter,Matter="water",At=1.4f}}).ToArray();c=Cast(frozen);c.Advance(.5f,input.Target);c.ConfirmContact(0,1);c.Advance(1.04f,input.Target);Check(c.Velocity(0)==Vector3.zero,"冻结暂停真实成形，不按原预计世界秒数触发尺寸条件");c.Advance(.02f,input.Target);Check(c.Velocity(0).x==3,"解冻从保留进度继续，真正达到阈值后才触发");
var late=ConstructionEditing.Copy(release);late.Root.Operations.Last().At=1.2f;c=Cast(late);c.Advance(.5f,input.Target);c.ConfirmContact(0,1);c.Advance(1.5f,input.Target);Check(c.Velocity(0)==Vector3.zero,"最早接受时点不补发此前已经越过的尺寸事件");
var instant=ConstructionEditing.Copy(seed);instant.Root.Children[0].Activation.Delay=0;c=Cast(instant);c.Advance(.2f,input.Target);point=new Vector3(3,4,.3f);Spend(c,8,point);Check(c.RemainingForce(0)==12&&c.NodeAge(1)<0,"真正扣减但尚未低于比例时不生成后续部位");Spend(c,2,point);Check(c.RemainingForce(0)==10&&c.NodeAge(1)==0,"损耗始终相对初始作用量，并包含恰好达到的比例边界");Check(Vector3.Distance(c.ContactOrigin(1),point)<.00001f,"损耗后独立部位使用真实交锋位置，未退回主体原点");
c=Cast(seed);c.Advance(.2f,input.Target);typeof(AbilityCast).GetMethod("SaveStep",Instance).Invoke(c,null);Spend(c,12,point);Spend(c,8,point+Vector3.right);Check(!c.Finished&&c.RemainingForce(0)==0&&c.NodeAge(1)<0,"来源归零后已确认的独立延迟部位保留");c.Advance(.45f,input.Target);Check(c.NodeAge(1)>=0&&Vector3.Distance(c.ContactOrigin(1),point)<.0001f,"来源后续结束不改写首次损耗事实的位置或延迟");
typeof(AbilityCast).GetMethod("RestoreStep",Instance).Invoke(c,null);Check(c.RemainingForce(0)==20&&c.NodeAge(1)<0,"回退恢复初始基准、余力及尚未接受的数值条件");Spend(c,12,point);Spend(c,8,point+Vector3.right);c.Advance(.45f,input.Target);Check(c.NodeAge(1)>=0&&Vector3.Distance(c.ContactOrigin(1),point)<.0001f,"回退后损耗条件及独立开始得到相同结果");
var zero=ConstructionEditing.Copy(seed);zero.Root.Children[0].Activation.Threshold=0;zero.Root.Children[0].Activation.Delay=0;zero.Root.Children=zero.Root.Children.Concat(new[]{new ConstructionNode{Id="ended",Form="sword",Activation=new ConstructionActivation{Trigger=ConstructionChangeTrigger.End}}}).ToArray();c=Cast(zero);c.Advance(.2f,input.Target);Spend(c,20,point);Check(c.NodeAge(1)==0&&c.NodeAge(2)==0,"完全损耗先通知数值事件再结束，两种后续过程均可保留");Check(Vector3.Distance(c.ContactOrigin(2),point)<.0001f,"完全消耗的结束事件同样保留真实交锋位置");
var facts=ConstructionEditing.Copy(instant);facts.Root.Operations=facts.Root.Operations.Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.ConvertMatter,Matter="ice",When=new ConstructionCondition{Trigger=ConstructionChangeTrigger.ForceBelow,Threshold=.8f}}}).ToArray();c=Cast(facts);Spend(c,12,point);Check(c.Matter(0).Id=="ice"&&c.NodeAge(1)==0,"同次损耗可通知不同阈值，先发生的材料改变不覆盖数值事实");
var bad=ConstructionEditing.Copy(release);bad.Root.Operations.Last().When.Threshold=null;Reject(()=>AbilityCompiler.Compile(bad),"数值条件缺少明确阈值时在共同入口拒绝");bad=ConstructionEditing.Copy(seed);bad.Root.Children[0].Activation.Threshold=1;Reject(()=>AbilityCompiler.Compile(bad),"损耗比例不能填成出生时就满足的1");bad=ConstructionEditing.Copy(release);bad.Root.Operations=bad.Root.Operations.Where(o=>o.Kind!=ConstructionOperationKind.Grow).ToArray();Reject(()=>AbilityCompiler.Compile(bad),"不存在任何实际生长过程的来源不能提供成长事件");bad=ConstructionEditing.Copy(release);bad.Root.Operations.Last().When.Source="body";Reject(()=>AbilityCompiler.Compile(bad),"真实身体不能冒充生成主体的尺寸或余力来源");bad=ConstructionEditing.Copy(seed);bad.Root.Children[0].Activation.Trigger=ConstructionChangeTrigger.ActorContact;Reject(()=>AbilityCompiler.Compile(bad),"普通事件不能带未使用的数值阈值");
var longer=ConstructionMagnitudeEdits.Duration(release,2);Check(longer.Root.Operations.Last().When.Threshold==1.5f,"完整历时不改变局部尺寸阈值");c=Cast(longer);c.Advance(1,input.Target);c.ConfirmContact(0,1);c.Advance(1.1f,input.Target);Check(c.Velocity(0).x==1.5f,"历时修改后在对应真实成长阶段触发");
var copies=ConstructionMagnitudeEdits.Repeat(release,2,1,.2f);Check(copies.Root.Children.All(n=>n.Operations.Last(o=>o.When?.Trigger==ConstructionChangeTrigger.SizeAbove).When.Threshold==1.5f),"数量改造保留每份独立的数值条件");
Config.paused=true;Game.Resume();Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;
var runnerType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=runnerType.GetProperty("Instance").GetValue(null);bool Boundary()=>(bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner);await Game.WaitUntil(Boundary,1800);
var stats=new BaseStats();stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.MotionHold").SetStats(stats).SetDuration(10000).Build();
void Place(Actor a,float x,float y){a.stopMovement();a.current_position=new Vector2(x,y);a.setCurrentTile(World.world.GetTileSimple((int)x,(int)y));a.updatePos();}
foreach(var a in World.world.units.getSimpleList().ToArray()){CombatStatusEffects.ApplyStatus(a,hold,10000,a);a.setStatsDirty();a.updateStats();Place(a,12,12);}
Actor Make(string name,int x,int y){var a=World.world.units.createNewUnit("human",World.world.GetTileSimple(x,y),pAdultAge:true,pSpawnWithItems:false);a.data.name=name;a.addTrait("super_health");CombatStatusEffects.ApplyStatus(a,hold,10000,a);a.setStatsDirty();a.updateStats();a.attack_timer=999;Place(a,x,y);return a;}
var actor=Make("阈值过程创造者",64,72);var first=Make("第一接触目标",72,72);var later=Make("恢复飞行后的目标",74,72);var wolf=World.world.units.createNewUnit("wolf",World.world.GetTileSimple(12,12),pAdultAge:true);CombatStatusEffects.ApplyStatus(wolf,hold,10000,wolf);
foreach(var enemy in new[]{first,later}){enemy.setKingdom(wolf.kingdom);actor.addAggro(enemy);enemy.addAggro(actor);}var owner=actor.GetExtend();owner.AddComponent(new Xian{level=2,wakan=10000});
var rival=first.GetExtend();rival.AddComponent(new Xian{level=2,wakan=10000});foreach(var d in new[]{release,seed,ward}){ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(owner,d.Id);}ConstructedAbilityService.Learn(rival,ward.Id);
var contacts=new List<ConstructedContact>();var clashes=new List<ConstructedClash>();void Hit(ConstructedContact h){if(h.SourceId==actor.id)contacts.Add(h);}void Clash(ConstructedClash h){if(h.LeftSource==actor.id||h.RightSource==actor.id)clashes.Add(h);}ConstructedAbilityService.ContactConfirmed+=Hit;ConstructedAbilityService.ClashConfirmed+=Clash;
async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,1800);Config.paused=true;await Game.WaitUntil(Boundary,1800);}
bool Fire(AbilityDefinition d,Actor from,Actor to)=>ActiveAbilityService.TryUse(from.GetExtend(),new ActiveAbilityHandle("content.constructed",from.GetExtend().E,d.Id),new ActiveAbilityTarget(to,to.GetSimPos()),ActiveAbilityUseOrigin.Script);
try{
float balance=owner.GetCultisys<Xian>().wakan;Check(Fire(release,actor,first),"尺寸条件由正式学习及施放入口受理");await Advance(4.5f);Check(contacts.Any(h=>h.AbilityId==release.Id&&h.TargetId==first.id)&&contacts.Any(h=>h.AbilityId==release.Id&&h.TargetId==later.id),"长成后改变实际运动的主体真实接触前后人物");Check(balance-owner.GetCultisys<Xian>().wakan==release.Cost,"成长条件沿用一次实际支付");await Advance(.5f);Place(first,72,72);Place(later,12,12);balance=owner.GetCultisys<Xian>().wakan;float rivalBalance=rival.GetCultisys<Xian>().wakan;Check(Fire(ward,first,actor)&&Fire(seed,actor,first),"攻守双方均由正式入口施放并实际支付");await Advance(1.3f);Check(clashes.Count>0&&FormVisualScene.Instances.Any(v=>v.Resource.Description.Id=="branch"),"实际交锋损耗后，来源结束仍留下独立生长部位");await Advance(2.2f);var clash=clashes.Single();long cast=clash.LeftSource==actor.id?clash.LeftCast:clash.RightCast;Check(contacts.Any(h=>h.AbilityId==seed.Id&&h.CastId==cast&&h.Node==1&&h.TargetId==first.id),"真正损耗生成的后段实际命中人物，不以视觉重叠替代交锋");Check(balance-owner.GetCultisys<Xian>().wakan==seed.Cost&&rivalBalance-rival.GetCultisys<Xian>().wakan==ward.Cost,"损耗后续不再支付，双方原始费用各结算一次");
var created=new List<AbilityDefinition>();for(int i=0;i<20;i++)created.Add(ConstructionEditing.Access.Read(ConstructedAbilityService.Create(owner,i)));bool HasThreshold(ConstructionNode n)=>n!=null&&(n.Operations.Any(o=>o.When?.Threshold!=null)||n.Children.Any(HasThreshold));Check(created.Any(d=>HasThreshold(d.Root)),"修士通过共用条件创作出长到指定尺寸后改变运动的结构");
}finally{ConstructedAbilityService.ContactConfirmed-=Hit;ConstructedAbilityService.ClashConfirmed-=Clash;Config.paused=true;}
foreach(var unit in World.world.units.getSimpleList())foreach(var state in unit.GetExtend().GetStatuses().ToArray())if(state.GetComponent<Cultiway.Core.Components.StatusComponent>().Type.id==hold.id)unit.GetExtend().RemoveSharedStatus(state);
await Game.NextFrame();SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));var saves=Cultiway.ModClass.I.WorldSaves;File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,actor=actor.id,rival=first.id,world=saves.World.Capture(World.world,"threshold"),person=saves.Actors.Capture(owner,"threshold"),opponent=saves.Actors.Capture(rival,"threshold")},Formatting.Indented));
var result=new{passed=true,checks,contacts=contacts.Select(h=>new{h.AbilityId,h.CastId,h.Node,h.TargetId,h.Age}).ToArray(),clashes=clashes.Select(h=>new{h.LeftCast,h.RightCast,h.LeftAge,h.RightAge,h.LeftRemaining,h.RightRemaining,h.Absorbed}).ToArray()};File.WriteAllText(Path.Combine(folder,"checks.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
