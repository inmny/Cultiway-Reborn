ConstructionWeaponChamber Chamber() => Session().Draft.Root.Children[0].WeaponChamber;
void SetNumber(string key, string value)
{
    var input = Row(key).GetComponentsInChildren<InputField>(false).Single();
    input.text = value;
    input.onEndEdit.Invoke(value);
}

try
{
    Child();
    Check(Chamber().Radius == 1.85f && Button("Replace").interactable, "从正式构造读到器口真实尺寸");
    SetNumber("WeaponChamberRadius", "9");
    Check(Chamber().Radius == 1.85f, "过大的开口被拒绝且草稿保留原尺寸");
    SetNumber("WeaponChamberRadius", "2.25");
    Check(Chamber().Radius == 2.25f, "有效尺寸进入草稿");
    Row("WeaponChamber").GetComponentsInChildren<Toggle>(false).Single().isOn = false;
    Check(Chamber() == null, "关闭器口只移除接入原物规则");
    Click("Undo");
    Check(Chamber().Radius == 2.25f, "撤销恢复改过的器口");
    await Capture("cz");
    Click("Replace");
    var saved = ConstructionEditing.Access.Read(Session().SourceId);
    Check(saved.Root.Children[0].WeaponChamber.Radius == 2.25f, "正式替换保存改后的器口");
    Click("Close");
    await Frames();
    LocalizedTextManager.instance.setLanguage("en");
    WindowWanfaConstructionEditor.Open(saved.Id, source);
    await Frames();
    Child();
    Check(Chamber().Radius == 2.25f && T("WeaponChamber") == "Weapon chamber", "英文窗口重开后恢复数值");
    await Capture("en");
    return new { passed = true };
}
finally
{
    if (Field(editor, "session") != null) typeof(WindowWanfaConstructionEditor).GetMethod("CloseNow", F).Invoke(editor, null);
    ReleaseChecks();
    LocalizedTextManager.instance.setLanguage("cz");
}
