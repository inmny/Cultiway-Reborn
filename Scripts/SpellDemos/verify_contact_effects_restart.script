// 必须真正退出并重启游戏，核对编辑得到的接触作用及修士创作资料。
using System;
using System.IO;
using System.Linq;
using System.Collections.Generic;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core;
using Cultiway.Core.Skills;
using Cultiway.Core.Visuals.Forms;
using Cultiway.Utils.Extension;

string folder=Path.Combine(Cultiway.ModClass.I.GetDeclaration().FolderPath,"artifacts/skill_rebuild/contact-effects");
var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));
if((int)expected["process"]==System.Diagnostics.Process.GetCurrentProcess().Id)throw new InvalidOperationException("需要真正退出并重启游戏");
Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;
var actor=World.world.units.get((long)expected["actor"]);var saves=Cultiway.ModClass.I.WorldSaves;var access=ConstructionEditing.Access;var checks=new List<string>();
void Check(bool value,string name){if(!value)throw new InvalidOperationException(name);checks.Add(name);}
JToken Section(string value,string id)=>JObject.Parse(value)["sections"][id]["data"];
Check(actor!=null,"原版保存恢复实际持有者");
Check(JToken.DeepEquals(Section((string)expected["world"],"ability_constructions"),Section(saves.World.Capture(World.world,"contact-effects"),"ability_constructions")),"完整接触作用及修士创法资料恢复，没有重新抽取");
Check(JToken.DeepEquals(Section((string)expected["person"],"ability_knowledge"),Section(saves.Actors.Capture(actor.GetExtend(),"contact-effects"),"ability_knowledge")),"全部已学关系及顺序恢复");
var push=access.Read("test.effects.push");var pull=access.Read("test.effects.pull");var mixed=access.Read("test.effects.part-filter");var body=access.Read("test.effects.body");
Check(push.Impact.Force==10&&pull.Impact.Force==-10&&push.Impact.DamageScale==0&&push.Impact.Lift==.5f,"推拉方向、零伤害及真实离地力度完整恢复");
Check(mixed.Root.Impact.Targets==Cultiway.Core.SkillLibV3.Usage.SkillUseTargetRelation.Friendly&&mixed.Impact.Targets==Cultiway.Core.SkillLibV3.Usage.SkillUseTargetRelation.Hostile&&body.Body!=null&&body.Impact.DamageScale==0,"部位覆盖及真实身体作用恢复后重新编译");
Check(access.Validate(access.Read("test.effects.reflect-ward")).HasBarrier,"正式保存恢复后重新编译，纯屏障仍保留防御用途");
Check(!saves.LastReport.RequiresBackup,"可选接触作用资料恢复不丢弃其他世界内容");
var result=new{passed=true,checks,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"restart-result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
