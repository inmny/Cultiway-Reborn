// 新火质和通用火体使用原有材料／形体表单，保存后不丢失正式构造。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using UnityEngine;
using UnityEngine.UI;
using Cultiway.Core.Skills;
using Cultiway.Content.Skills;
using Cultiway.UI;
using Cultiway.UI.Prefab;
using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/quenching/ui");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool value,string name){if(!value)throw new Exception(name);checks.Add(name);}async Task Frames(int n=3){for(int i=0;i<n;i++)await Game.NextFrame();await Game.WaitUntil(()=>!ScrollWindow.isAnimationActive(),300);Canvas.ForceUpdateCanvases();}
Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;var actor=World.world.units.createNewUnit("human",World.world.GetTileSimple(64,72),pAdultAge:true,pSpawnWithItems:false);var definition=JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/离体炎流.json")));ConstructedAbilityService.Register(definition);ConstructedAbilityService.Learn(actor.GetExtend(),definition.Id);
string currentId=definition.Id;foreach(string language in new[]{"cz","en"}){LocalizedTextManager.instance.setLanguage(language);await Frames();WindowWanfaConstructionEditor.Open(currentId,actor);await Frames();var editor=(WindowWanfaConstructionEditor)typeof(WindowWanfaConstructionEditor).GetField("instance",F).GetValue(null);Button B(string name)=>editor.GetComponentsInChildren<Button>(false).First(b=>b.name==name);B("Page0").onClick.Invoke();await Frames();var texts=editor.GetComponentsInChildren<Text>(true).Select(t=>t.text).ToArray();Check(texts.Contains(language=="cz"?"连续火体":"Continuous fire body"),"形体表单显示完整本地化："+language);Check(texts.Contains(language=="cz"?"火质":"Fire energy"),"实际材料与显示表面分开且有可读名称："+language);Check(B("Replace").interactable,"普通表单接受新火质并通过共用编译："+language);World.world.console.Hide();Tooltip.hideTooltipNow();foreach(var loading in Resources.FindObjectsOfTypeAll<LoadingScreen>())loading.gameObject.SetActive(false);await Frames();Screen.Capture(Path.Combine(folder,"fire-"+language+".png"));await Frames();B("Replace").onClick.Invoke();currentId=((ConstructionEditSession)editor.GetType().GetField("session",F).GetValue(editor)).SourceId;B("Close").onClick.Invoke();await Frames();WindowWanfaConstructionEditor.Open(currentId,actor);await Frames();var session=(ConstructionEditSession)editor.GetType().GetField("session",F).GetValue(editor);Check(session.Draft.Root.Matter=="fire"&&session.Draft.Root.Form=="fire_body","保存关闭重开保留实际火质和通用形体："+language);B("Close").onClick.Invoke();await Frames();}
LocalizedTextManager.instance.setLanguage("cz");var result=new{passed=true,checks};File.WriteAllText(Path.Combine(folder,"checks.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
