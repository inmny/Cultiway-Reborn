// C15：就绪保留前序、事件与自己的较晚时点；运行仅复用一个剑形主体。
Actor source=Make(64),enemy=Make(64.2f,"wolf"); var owner=source.GetExtend(); owner.NewCultisys(Cultisyses.Xian); owner.GetCultisys<Xian>().level=2;
owner.MarkCultiwayStatsDirty(); source.setStatsDirty(); source.updateStats(); owner.GetCultisys<Xian>().wakan=10000;
var basis=JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Scripts/SpellDemos/fixtures/placement-starts.json")));
var edited=JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"artifacts/skill_rebuild/trajectories/placement-starts/ui/saved-definition.json")));
var input=new AbilityInputs(new Vector3(64,72,0),new Vector3(72,72,0),Vector3.right,1);
AbilityCast Numeric(AbilityDefinition d)=>new AbilityCast(AbilityCompiler.Compile(d,false),Matrix4x4.identity,inputs:input);
JObject Canon(AbilityDefinition d) { var v=JObject.FromObject(d); v.Remove("Id"); v.Remove("Creator"); return v; }
var views=new List<FormVisualInstance>(); Matrix4x4 Pose(AbilityCast cast) { views.Clear(); cast.AppendVisuals(views); return views.Single().Transform; }
var active=new List<AbilityCast>();
void Started(ConstructedCastStarted value) { if(value.SourceId==source.id) foreach(object running in (IEnumerable)service.GetField("casts",F).GetValue(null)) if((long)Field(running,"Id")==value.CastId) active.Add((AbilityCast)Field(running,"Cast")); }
ConstructedAbilityService.CastStarted+=Started;
var attempts=new List<object>();
try
{
    string original=JsonConvert.SerializeObject(basis);
    var transforms=new Dictionary<string,AbilityDefinition>{["follow"]=ConstructionPlacementEdits.Follow(basis,AbilityAnchor.Source),["placed"]=ConstructionPlacementEdits.Place(basis,AbilityAnchor.Target),["between"]=ConstructionPlacementEdits.Between(basis,.5f),["orbit"]=ConstructionPlacementEdits.Orbit(basis,AbilityAnchor.Source,2,4)};
    Check(transforms.Values.All(d=>d.Steps.Single(s=>s.Id=="outward").Operation.Kind==ConstructionOperationKind.Ready && d.Steps.Single(s=>s.Id=="outward").Inputs["after"].Step=="prepare" && d.Steps.Single(s=>s.Id=="spin").Inputs["after"].Output=="ready") && JsonConvert.SerializeObject(basis)==original,"四种放置改造共同保留完整开始链，原资料不变");
    var cast=Numeric(transforms["follow"]); cast.ConfirmContact(0,1); cast.Advance(.15f,input.Target);
    Check(cast.StepStateOf("prepare")==ConstructionStepState.Running && cast.StepStateOf("outward")==ConstructionStepState.Waiting,"已发生接触和延迟仍等待真实前序完成");
    cast.Advance(.2f,input.Target);
    Check(cast.TryGetOutput("outward","ready",out var ready) && Math.Abs(ready.At-.25f)<.0001f && cast.StepStateOf("spin")==ConstructionStepState.Waiting,"就绪在原前序完成时确认，后续仍等自己的较晚时点",new{ready.At});
    cast.Advance(.4f,input.Target); Check(cast.StepStateOf("spin")==ConstructionStepState.Running,"早发生的事件和就绪结果保留到较晚的旋转步骤");
    var quiet=Numeric(transforms["follow"]); quiet.Advance(.9f,input.Target);
    Check(quiet.StepStateOf("prepare")==ConstructionStepState.Completed && quiet.StepStateOf("outward")==ConstructionStepState.Waiting && quiet.StepStateOf("spin")==ConstructionStepState.Waiting,"未发生接触时不会按预估时点假造就绪");
    var rollback=Numeric(transforms["follow"]); rollback.Advance(.1f,input.Target); typeof(AbilityCast).GetMethod("SaveStep",F).Invoke(rollback,null);
    rollback.ConfirmContact(0,1); rollback.Advance(.3f,input.Target); Check(rollback.StepStateOf("outward")==ConstructionStepState.Completed,"预测内确认真实就绪");
    typeof(AbilityCast).GetMethod("RestoreStep",F).Invoke(rollback,null); rollback.Advance(.4f,input.Target);
    Check(rollback.StepStateOf("outward")==ConstructionStepState.Waiting && rollback.StepStateOf("spin")==ConstructionStepState.Waiting,"回退恢复事件和就绪状态，预测结果不提前流入后续");
    var native=ConstructionEditing.Copy(basis); native.Root.Operations=new[]{new ConstructionOperation{Id="cast_out",Kind=ConstructionOperationKind.Fly,Vector=new[]{0f,0f,2f},When=new ConstructionCondition{Delay=.1f}}};
    native.Steps=native.Steps.Where(s=>s.Id!="outward").ToArray(); native.Steps.Single(s=>s.Id=="spin").Inputs["after"]=new(){Node="root",Operation="cast_out",Output="flight",Stage=ConstructionOutputStage.Started};
    var nativeFollow=ConstructionPlacementEdits.Follow(native,AbilityAnchor.Source); var nativeCast=Numeric(nativeFollow); nativeCast.ConfirmContact(0,1); nativeCast.Advance(.15f,input.Target);
    bool nativeConfirmed=nativeCast.TryGetOperationOutput("root","cast_out","ready",out var nativeReady);
    Check(nativeFollow.Root.Operations.Single().Kind==ConstructionOperationKind.Ready && nativeConfirmed && Math.Abs(nativeReady.At-.1f)<.0001f,"原部位命名运动也沿自身事件延迟产生真实就绪",new{nativeReady.At});
    var completed=ConstructionEditing.Copy(basis); completed.Steps.Single(s=>s.Id=="spin").Inputs["after"].Stage=ConstructionOutputStage.Completed; string before=JsonConvert.SerializeObject(completed); string rejected=null;
    try { ConstructionPlacementEdits.Follow(completed,AbilityAnchor.Source); } catch(InvalidDataException error){rejected=error.Message;}
    Check(rejected!=null && rejected.Contains("Steps/spin/Inputs/after") && rejected.Contains("运动完成") && JsonConvert.SerializeObject(completed)==before,"需要已删除运动完成时明确拒绝，原术保持可用",rejected);
    var distance=ConstructionEditing.Copy(basis); distance.Root.Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Spin,Vector=new[]{0f,90f,0f},When=new ConstructionCondition{Trigger=ConstructionChangeTrigger.DistanceFromFlightStart,Threshold=1}}}; rejected=null;
    try { ConstructionPlacementEdits.Follow(distance,AbilityAnchor.Source); } catch(InvalidDataException error){rejected=error.Message;}
    Check(rejected!=null && rejected.Contains("飞行距离"),"依赖已删除行程的真实事件不能静默留下无效等待",rejected);
    rejected=null; try { ConstructionPlacementEdits.Follow(basis,AbilityAnchor.Source,preserveStarts:false); } catch(InvalidDataException error){rejected=error.Message;}
    Check(rejected!=null && rejected.Contains("额外事件"),"旧正式请求保留原选择边界，不追补新就绪行为");
    var inspiration=ConstructedAbilityService.ReadInspiration(owner); Check(inspiration.Rules==22,"新受理请求冻结第二十二版开始规则");
    int selected=-1; AbilityDefinition derived=null;
    for(int seed=0;seed<64 && selected<0;seed++)
    {
        try { var d=ConstructedAbilityService.Generate(owner,seed,inspiration,basis); attempts.Add(new{seed,d.Parent.Change}); if(d.Parent.Change=="随身"){selected=seed;derived=d;} }
        catch(InvalidDataException error){attempts.Add(new{seed,rejected=error.Message});}
        await Game.NextFrame();
    }
    Check(derived!=null && derived.Steps.Single(s=>s.Id=="outward").Operation.Kind==ConstructionOperationKind.Ready && JsonConvert.SerializeObject(basis)==original,"自主派生实际选择带完整开始链的随身改造",new{selected});
    File.WriteAllText(Path.Combine(folder,"selected.json"),JsonConvert.SerializeObject(new{seed=selected},Formatting.Indented));
    File.WriteAllText(Path.Combine(folder,"derived.json"),JsonConvert.SerializeObject(derived,Formatting.Indented));
    Ready(source); Place(source,64); Place(enemy,64.2f); float balance=owner.GetCultisys<Xian>().wakan; int hp=enemy.data.health;
    await Fire(edited,source,enemy); float paid=balance-owner.GetCultisys<Xian>().wakan; owner.E.RemoveComponent<ConstructedKnowledge>(); await Advance(.8f);
    var live=active.Last(); Check(Math.Abs(paid-edited.Cost)<.001f && contacts.Any(c=>c.AbilityId==edited.Id && c.TargetId==enemy.id) && enemy.data.health<hp && live.StepStateOf("outward")==ConstructionStepState.Completed && live.StepStateOf("spin")==ConstructionStepState.Running,"表单成品实际支付、真实接触触发就绪，较晚旋转实际执行",new{paid,hp,after=enemy.data.health,position=new[]{Pose(live).m03,Pose(live).m13,Pose(live).m23}});
    await Advance(edited.Lifetime+.2f); Check(live.Finished && endings.Any(e=>e.Fact.AbilityId==edited.Id && !e.Fact.Cancelled) && !BodyControlState.IsBusy(source.id),"保留开始条件的成品自然结束并无控制残留");
    Ready(source); Place(source,64); Place(enemy,64.2f); await Fire(edited,source,enemy); owner.E.RemoveComponent<ConstructedKnowledge>(); await Advance(edited.Lifetime+.2f); Check(active.Last().Finished,"结束后可再次使用同一开始链成品");
    return new{passed=true,closed="开始链转换、真实事件、明确失败、自主派生和实际结束恢复",checks,process=System.Diagnostics.Process.GetCurrentProcess().Id};
}
finally
{
    File.WriteAllText(Path.Combine(folder,"attempts.json"),JsonConvert.SerializeObject(attempts,Formatting.Indented));
    ConstructedAbilityService.CastStarted-=Started; ConstructedAbilityService.ContactConfirmed-=Hit; ConstructedAbilityService.CastEnded-=Ended; Config.paused=true; ControllableUnit.clear(false);
}
