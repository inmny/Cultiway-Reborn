// 直接使用原学习入口；只观察真实建筑、爆发、人物受击和实扣费用。
bool legacy = caseName == "legacy";
var baseline = legacy ? null : JObject.Parse(File.ReadAllText(buildingBaseline));
var original = Cultiway.Core.SkillLibV3.Manager.ConstructionEmission;
var hook = new HarmonyLib.Harmony("cultiway.test.building-flight." + Guid.NewGuid().ToString("N"));
var buildingHits = new List<JObject>();
var areas = new List<JObject>();
var originalTouches = new List<JObject>();
var actualTouches = new List<ConstructedActionEvent>();
var payments = new List<double>();
var reports = new JArray();
Building house = null;

Place(target, 78, 72);
target.joinLanguage(World.world.languages.newLanguage(target, true));
target.setCulture(World.world.cultures.newCulture(target, true));
World.world.kingdoms.makeNewCivKingdom(target);
var city = World.world.cities.buildNewCity(target, target.current_tile.zone);
target.joinCity(city);
source.setKingdom(enemyKingdom);

async Task PlaceHouse()
{
    WorldTile tile = World.world.GetTileSimple(69, 72);
    if (tile.building != null) tile.building.removeBuildingFinal();
    for (int x = 65; x <= 79; x++)
    for (int y = 69; y <= 76; y++)
    {
        WorldTile ground = World.world.GetTileSimple(x, y);
        ground.setTileTypes(TileLibrary.soil_low, TopTileLibrary.grass_low);
        ground.stopFire();
        ground.removeBurn();
    }
    city.addZone(tile.zone);
    house = World.world.buildings.addBuilding("house_human_0", tile);
    house.completeConstruction();
    await Advance(.30f);
    Check(house.isAlive() && house.city == city && source.kingdom.isEnemy(house.kingdom) &&
          house.isAnimationState(BuildingAnimationState.Normal), "完工房屋仍是敌对建筑");
}

void RemoveFixture(long id)
{
    // 原版会在炸毁后回收房屋对象，清理只读取当前地格还登记的同一座。
    Building stillPlaced = World.world.GetTileSimple(69, 72).building;
    if (stillPlaced != null && stillPlaced.getID() == id) stillPlaced.removeBuildingFinal();
    house = null;
}

bool Use(Entity skill, float row)
{
    Ready(source);
    Place(source, 64, row);
    Place(target, 78, row);
    Place(second, 12, 12);
    Place(outside, 12, 13);
    ConstructedAbilityService.NotifyActorChanged(source);
    ConstructedAbilityService.NotifyActorChanged(target);
    owner.GetCultisys<Xian>().wakan = source.stats[BaseStatses.MaxWakan.id] * .8f;
    bool accepted = ActiveAbilityService.TryUse(owner, new ActiveAbilityHandle("core.learned_skill", skill),
        new ActiveAbilityTarget(target, target.GetSimPos()), ActiveAbilityUseOrigin.Player);
    source.attack_timer = 999;
    CombatStatusEffects.ApplyStatus(source, hold, 10000, source);
    source.updateStats();
    return accepted;
}

void OnOldContact(Entity entity, BaseSimObject hit)
{
    var context = entity.GetComponent<SkillContext>();
    if (context.SourceObj != source) return;
    Vector3 pos = entity.GetComponent<Position>().value;
    entity.TryGetComponent(out Cultiway.Core.SkillLibV3.Components.TrajParams.MotionParams motion);
    originalTouches.Add(JObject.FromObject(new { subject = hit.getID(), building = hit.isBuilding(),
        position = new[] { pos.x, pos.y, pos.z }, aimedHeight = context.TargetPos.z,
        heightGate = motion.HasHeightGate, heightLimit = motion.HeightGateMax }));
}
void OnAction(ConstructedActionEvent evt)
{
    if (evt.SourceId == source.id && evt.Fact.Kind == AbilityActionEventKind.Contact &&
        evt.Fact.ContactKind == AbilityActionContactKind.Building) actualTouches.Add(evt);
}
BuildingFlightProbe.Hit = (targetBuilding, damage, before, damager) =>
{
    if (targetBuilding != house) return;
    buildingHits.Add(JObject.FromObject(new { damage, before,
        after = targetBuilding.getHealth(), ruins = targetBuilding.isRuin(), owned = source == damager }));
};
BuildingFlightProbe.Paid = (payer, payment) =>
{
    if (payer == owner)
        payments.Add(payment.Entries.Where(entry => entry.Resource == SkillCastResources.Wakan).Sum(entry => entry.Spent));
};
BuildingFlightProbe.Area = (pos, radius, damager) =>
{
    if (damager == source) areas.Add(JObject.FromObject(new { position = new[] { pos.x, pos.y, pos.z }, radius }));
};
hook.Patch(typeof(Building).GetMethods(F).Single(method => method.Name == "getHit" && method.GetParameters()[0].ParameterType == typeof(float)),
    prefix: new HarmonyLib.HarmonyMethod(typeof(BuildingFlightProbe), nameof(BuildingFlightProbe.Prior)),
    postfix: new HarmonyLib.HarmonyMethod(typeof(BuildingFlightProbe), nameof(BuildingFlightProbe.After)));
hook.Patch(typeof(SkillCastPayment).GetMethod("Commit", F),
    postfix: new HarmonyLib.HarmonyMethod(typeof(BuildingFlightProbe), nameof(BuildingFlightProbe.AfterPayment)));
hook.Patch(typeof(Cultiway.Core.SkillLibV3.Visuals.SkillGroundFx).GetMethod("OnImpact", F),
    postfix: new HarmonyLib.HarmonyMethod(typeof(BuildingFlightProbe), nameof(BuildingFlightProbe.AfterGround)));
if (legacy)
    Cultiway.Core.SkillLibV3.Manager.ConstructionEmission = emission =>
        chosenAssets.Contains(emission.SkillContainer.GetComponent<SkillContainer>().Asset.id)
            ? SkillEmissionResult.Unhandled : original(emission);
ConstructedAbilityService.CastStarted += Started;
ConstructedAbilityService.ActionConfirmed += OnAction;
Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured += LegacyExecution;
SkillHitResolver.ContactResolved += OnOldContact;
try
{
    foreach (var asset in buildingSpells)
    {
        bool projectileHasArea = asset == SkillEntities.Fireball, arc = asset == SkillEntities.RockProjectile;
        Entity skill = Learn(asset, 0, false);
        await PlaceHouse();
        Vector2 position = house.current_position;
        long houseId = house.getID();
        int priorPayment = payments.Count, priorDamage = buildingHits.Count, priorArea = areas.Count,
            priorOld = originalTouches.Count, priorBuilt = actualTouches.Count;
        int oldCount = oldExecutions, builtCount = casts.Count;
        int health = target.getHealth();
        Check(Use(skill, position.y), "有房屋时沿真实入口发射", asset.id);
        await Advance(1.42f);
        var damage = buildingHits.Skip(priorDamage).ToArray();
        var blast = areas.Skip(priorArea).ToArray();
        var oldTouches = originalTouches.Skip(priorOld).ToArray();
        var newTouches = actualTouches.Skip(priorBuilt).ToArray();
        int lost = health - target.getHealth();
        double paid = payments.Skip(priorPayment).Single();
        var record = JObject.FromObject(new { id = asset.id, house = houseId, center = new[] { position.x, position.y },
            lost, paid, damage, blast, oldTouches, newTouches = newTouches.Select(value => new
            {
                value.Fact.TargetId, value.Fact.Age, position = new[] { value.Fact.Point.x, value.Fact.Point.y, value.Fact.Point.z }
            }) });
        reports.Add(record);
        File.WriteAllText(Path.Combine(folder, "observed.json"), JsonConvert.SerializeObject(new { spells = reports }, Formatting.Indented));
        Check(legacy ? oldExecutions == oldCount + 1 && casts.Count == builtCount :
              oldExecutions == oldCount && casts.Count == builtCount + 1, "仍为原入口的一次真实发射", asset.id);
        if (arc)
        {
            if (legacy)
                Check(oldTouches.Length > 0, "记录旧飞石实际碰触和原高度设置", oldTouches);
            else
                Check(damage.Length == 0 && newTouches.Length == 0 && lost > 0,
                    "飞石的弧顶越过房屋，抵达后方目标才命中", new { damage, lost });
        }
        else
        {
            Check((legacy || newTouches.Length == 1 && newTouches[0].Fact.TargetId == houseId) &&
                  damage.Any(item => (projectileHasArea || (bool)item["owned"]) &&
                      ((float)item["after"] < (float)item["before"] || (bool)item["ruins"])),
                "建筑受到原范围冲击或来源直击伤害", record);
            Check(projectileHasArea ? blast.Length == 1 && lost == 0 : blast.Length == 0 && lost > 0,
                projectileHasArea ? "房屋先拦下火球，房后人物未受伤" : "水矢穿过房屋后仍真实命中后方人物", record);
            if (projectileHasArea && !legacy)
            {
                float[] center = blast[0]["position"].ToObject<float[]>();
                Check(Vector2.Distance(new Vector2(center[0], center[1]), newTouches[0].Fact.Point) < .001f,
                    "实际建筑接触点也是世界爆发中心", center);
            }
        }
        if (!legacy)
        {
            JToken prior = baseline["spells"].Single(item => (string)item["id"] == asset.id);
            float[] OwnedDamage(IEnumerable<JToken> items) => items.Where(item => (bool)item["owned"])
                .Select(item => (float)item["damage"]).ToArray();
            Check(Math.Abs((double)prior["paid"] - paid) < .001 &&
                  (arc || (projectileHasArea ? Math.Abs((float)prior["blast"][0]["radius"] - (float)blast[0]["radius"]) < .001f :
                      OwnedDamage(prior["damage"]).SequenceEqual(OwnedDamage(damage)))),
                "爆发半径或建筑直击伤害、每发费用保留原值", new { asset.id, paid, damage = OwnedDamage(damage) });
        }
        if (projectileHasArea)
        {
            RemoveFixture(houseId);
            int hitsBefore = actualTouches.Count, effectsBefore = areas.Count;
            Check(Use(skill, position.y), "移走房屋后同一入口可以再次施放");
            await Advance(1.42f);
            Check(actualTouches.Count == hitsBefore && areas.Count == effectsBefore + 1 && health > target.getHealth(),
                "移走房屋后火球在后方人物处爆发", new { after = target.getHealth(), health });
        }
        if (house != null) RemoveFixture(houseId);
    }
    return new { passed = true, legacy, process, spells = reports, checks };
}
finally
{
    hook.UnpatchSelf();
    BuildingFlightProbe.Hit = null;
    BuildingFlightProbe.Paid = null;
    BuildingFlightProbe.Area = null;
    Cultiway.Core.SkillLibV3.Manager.ConstructionEmission = original;
    Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured -= LegacyExecution;
    SkillHitResolver.ContactResolved -= OnOldContact;
    ConstructedAbilityService.CastStarted -= Started;
    ConstructedAbilityService.ActionConfirmed -= OnAction;
    ConstructedAbilityService.CastEnded -= Ended;
    ConstructedAbilityService.ContactConfirmed -= Hit;
    Config.paused = true;
}

public static class BuildingFlightProbe
{
    public static Action<Building, float, int, BaseSimObject> Hit;
    public static Action<ActorExtend, SkillCastPayment> Paid;
    public static Action<Vector3, float, BaseSimObject> Area;
    public static void Prior(Building __instance, out int __state) => __state = __instance.getHealth();
    public static void After(Building __instance, float __0, object[] __args, int __state) =>
        Hit?.Invoke(__instance, __0, __state, __args.OfType<BaseSimObject>().FirstOrDefault());
    public static void AfterPayment(SkillCastPayment __instance, ActorExtend ___payer) => Paid?.Invoke(___payer, __instance);
    public static void AfterGround(Vector3 pos, float radius, bool isArea, BaseSimObject sourceObj)
    {
        if (isArea) Area?.Invoke(pos, radius, sourceObj);
    }
}
