// 连通、干隙、高度、消耗、去重、回退及真实工作池。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using Newtonsoft.Json;
using UnityEngine;
using Cultiway.Core.Skills;
const BindingFlags F=BindingFlags.Instance|BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/conduction");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}var a=typeof(AbilityCast).Assembly;var waterType=a.GetType("Cultiway.Core.Skills.ConductingWater");var routeType=a.GetType("Cultiway.Core.Skills.AbilityConduction");var settingsType=a.GetType("Cultiway.Core.Skills.CompiledConduction");
object Field(object o,string name)=>o.GetType().GetField(name,F).GetValue(o);object Call(object o,string name,params object[] values)=>o.GetType().GetMethod(name,F).Invoke(o,values);
var shapeCtor=typeof(AbilityCapsule).GetConstructors(F).Single();AbilityCapsule Shape(float x,float y,float z,float radius=.15f)=>(AbilityCapsule)shapeCtor.Invoke(new object[]{0,new Vector3(x,y,z),new Vector3(x,y,z),radius,"water",0,0,null,Vector3.zero,1f});
Array Water(IEnumerable<(int X,int Y,float Bottom,float Depth)> values){var rows=values.ToArray();var array=Array.CreateInstance(waterType,rows.Length);for(int i=0;i<rows.Length;i++)array.SetValue(Activator.CreateInstance(waterType,F,null,new object[]{rows[i].X,rows[i].Y,rows[i].Bottom,rows[i].Depth},null),i);return array;}
object Trace(Array water,ConstructionConduction settings=null,float force=100,AbilityCapsule[] seeds=null,AbilityCapsule[] targets=null){settings??=new ConstructionConduction{Range=20,TravelCost=1,DamagePerTarget=2};var compiled=Activator.CreateInstance(settingsType,F,null,new object[]{settings,"test",0},null);return Activator.CreateInstance(routeType,F,null,new object[]{water,seeds??new[]{Shape(10.5f,10.5f,.1f)},targets??new[]{Shape(12.5f,10.5f,.1f),Shape(16.5f,10.5f,.1f)},compiled,1f,force},null);}
int Count(object trace,string key)=>((IList)Field(trace,key)).Count;float Spent(object t)=>(float)routeType.GetProperty("Spent",F).GetValue(t);string Coordinates(object t)=>string.Join(";",((IList)Field(t,"Route")).Cast<object>().Select(w=>Field(w,"X")+","+Field(w,"Y")));
var straight=Enumerable.Range(10,7).Select(x=>(X:x,Y:10,Bottom:0f,Depth:.2f)).ToArray();var line=Water(straight);var trace=Trace(line);Check(Count(trace,"Route")==7&&Count(trace,"Hits")==2&&Math.Abs(Spent(trace)-11)<1e-6,"真实连通水路逐格耗力，并对两位人物各消耗一次");
Check(Count(Trace(Water(straight.Where(w=>w.X!=13))),"Route")==3,"干隙阻断，不跨空地跳到后方水池");Check(Count(Trace(Water(straight.Select(w=>w.X==13?(w.X,w.Y,w.Bottom,.001f):w))),"Route")==3,"不足最低真实水深的薄膜不构成导电桥");Check(Count(Trace(Water(straight.Select(w=>w.X==13?(w.X,w.Y,1f,w.Depth):w))),"Route")==3,"平面相邻但高度不相接的水柱阻断");
Check(Count(Trace(line,seeds:new[]{Shape(10.5f,10.5f,3)}),"Route")==0,"悬空入口不能算触水");Check(Count(Trace(line,targets:new[]{Shape(12.5f,10.5f,3)}),"Hits")==0,"水路不扩大成空中人物伤害");
Check(Count(Trace(line,force:3.5f),"Hits")==0&&Spent(Trace(line,force:3.5f))==3,"余量不足完整人物作用时不借最低伤害放大微量余力");
Check(Count(Trace(line,new ConstructionConduction{Range=1,TravelCost=1,DamagePerTarget=2}),"Route")==2,"距离按水路长度限制，入口自身距离为零");Check(Count(Trace(line,new ConstructionConduction{MaximumCells=2}),"Route")==2,"总到达格数独立限制");Check(Count(Trace(line,new ConstructionConduction{MaximumTargets=1}),"Hits")==1,"同次传播人物上限有效");
var loop=Water(from y in Enumerable.Range(10,3) from x in Enumerable.Range(10,3) select (x,y,0f,.2f));var loopTrace=Trace(loop,targets:new[]{Shape(11,11,.1f,.4f)});Check(Count(loopTrace,"Route")==9&&Count(loopTrace,"Hits")==1,"循环和多格身体重叠不会重复传播或重复伤害");Check(Coordinates(Trace(Water(straight.Reverse())))==Coordinates(trace),"水柱输入顺序变化不改变稳定入口和水路顺序");
AbilityDefinition Definition()=>JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/引水行雷.json")));AbilityCast Cast(AbilityDefinition d)=>new AbilityCast(AbilityCompiler.Compile(d),Matrix4x4.identity,inputs:new AbilityInputs(Vector3.zero,Vector3.right,Vector3.right,1),force:30,paidResource:8);
int Take(AbilityCast c){var list=(IList)Activator.CreateInstance(typeof(List<>).MakeGenericType(a.GetType("Cultiway.Core.Skills.AbilityWorldMatterRequest")));Call(c,"TakeWorldMatterRequests",list);return list.Count;}
var d=Definition();var cast=Cast(d);cast.Advance(1.5f,Vector3.right);Call(cast,"SaveStep");cast.Advance(.11f,Vector3.right);Check(Take(cast)==1&&Take(cast)==0,"定时导电请求只领取一次");Call(cast,"RestoreStep");Check(Take(cast)==0,"预测回退不留下待确认导电");cast.Advance(.11f,Vector3.right);Check(Take(cast)==1,"真实重放恢复同一次请求");double budget=cast.RemainingResource(0);float forceBefore=cast.RemainingForce(0);Call(cast,"ConsumeForce",0,11f);Check(Math.Abs(cast.RemainingResource(0)-budget*(forceBefore-11)/forceBefore)<1e-6,"导电实际消耗同时扣除原支付份额，不能再次回收");
var cancelled=Cast(Definition());cancelled.Advance(1.7f,Vector3.right);cancelled.Cancel();Check(Take(cancelled)==0,"中断后的请求不再接受");var conditional=Definition();conditional.Root.ContactRole=ConstructionContactRole.Attack;conditional.Root.Operations[1].At=0;conditional.Root.Operations[1].When=new ConstructionCondition{Trigger=ConstructionChangeTrigger.ActorContact};var cc=Cast(conditional);Check(Take(cc)==0,"条件导电不提前触发");cc.ConfirmContact(0,1);Check(Take(cc)==1,"真实接触可触发同一个导电操作");
var indirectOnly=Definition();indirectOnly.Impact.Force=2;Check(AbilityCompiler.Compile(indirectOnly).ContactForce==0,"纯间接导电不被声明成尚未实现的主体推拉");
var resized=ConstructionMagnitudeEdits.Resize(d,2);Check(resized.Root.Operations[1].Conduction.Range==48&&resized.Root.Operations[1].Conduction.MaximumCells==2048&&d.Root.Operations[1].Conduction.Range==24,"尺寸改造扩大真实水路及容量，原资料独立保留");foreach(float bad in new[]{0f,-1f,float.NaN,float.PositiveInfinity}){var invalid=Definition();invalid.Root.Operations[1].Conduction.TravelCost=bad;try{AbilityCompiler.Compile(invalid);throw new Exception("无效导电消耗被接受");}catch(InvalidDataException){}}checks.Add("构造入口拒绝非法或不消耗的传播资料");
var poolType=a.GetType("Cultiway.Core.Performance.SimulationWorkerPool");var pool=poolType.GetProperty("Instance",F).GetValue(null);var run=poolType.GetMethod("RunIndexed",F);var reports=new List<object>();foreach(int n in new[]{32,128}){string[] seq=new string[n],par=new string[n];string Result(){var t=Trace(loop);return Coordinates(t)+"/"+Spent(t)+"/"+Count(t,"Hits");}for(int i=0;i<n;i++)seq[i]=Result();Action<int> action=i=>par[i]=Result();run.Invoke(pool,new object[]{0,n,action});Check(seq.SequenceEqual(par),"纯数值水路与去重在串行和实际工作池中一致："+n);reports.Add(new{count=n,error=0});await Game.NextFrame();}
var result=new{passed=true,checks,reports};File.WriteAllText(Path.Combine(folder,"math.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
