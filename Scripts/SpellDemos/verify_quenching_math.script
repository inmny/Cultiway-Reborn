// 水火真实减量、局部动量、刚性缩形、回退、来源份额及工作池一致性。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using Newtonsoft.Json;
using UnityEngine;
using Cultiway.Core.Skills;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/quenching");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool value,string name){if(!value)throw new Exception(name);checks.Add(name);}object Call(object target,string method,params object[] args)=>target.GetType().GetMethod(method,F).Invoke(target,args);object Field(object target,string name)=>target.GetType().GetField(name,F).GetValue(target);
AbilityDefinition Water(bool flow){var d=JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/蓄水御炎.json")));d.Root.Offset=new float[3];d.Root.Volume=8;d.Root.Scale=1;d.Lifetime=4;if(!flow){d.Root.Form="hand";d.Root.Operations=Array.Empty<ConstructionOperation>();}return d;}
AbilityCast Cast(AbilityDefinition d,float force=20)=>new AbilityCast(AbilityCompiler.Compile(d),Matrix4x4.identity,inputs:new AbilityInputs(Vector3.zero,Vector3.right,Vector3.right,1),force:force,paidResource:8);
double Evaporate(AbilityCast c,int shape,double maximum)=>(double)Call(c,"EvaporateWater",0,shape,maximum,Vector3.zero);
List<AbilityCapsule> Shapes(AbilityCast c){var output=new List<AbilityCapsule>();c.AppendContacts(output,includeMaterials:true);return output;}
var rigid=Cast(Water(false));double removed=Evaporate(rigid,0,2);Check(Math.Abs(removed-2)<1e-8&&Math.Abs(rigid.RemainingVolume(0)-6)<1e-8,"刚性生成水体只减少实际蒸散体积");Check(Math.Abs(rigid.RemainingResource(0)-6)<1e-6&&Math.Abs(rigid.RemainingForce(0)-15)<1e-6,"原支付和水体攻击力各按体积减一次");float radius=Shapes(rigid)[0].Radius;rigid.Advance(.2f,Vector3.right);Check(Math.Abs(Shapes(rigid)[0].Radius-radius)<1e-6,"后续姿态不会把已经消耗的水形补满");Call(rigid,"SaveStep");Evaporate(rigid,0,1);Call(rigid,"RestoreStep");Check(Math.Abs(rigid.RemainingVolume(0)-6)<1e-8&&Math.Abs(Shapes(rigid)[0].Radius-radius)<1e-6,"预测恢复同时还原数量和实际缩形");
Call(rigid,"StopNode",0,1f);rigid.Advance(.1f,Vector3.right);Check(Math.Abs(Shapes(rigid)[0].Radius-radius)<1e-6,"材料缩形在停止和恢复运动边界不重复缩小");
var recoveryDefinition=Water(false);recoveryDefinition.Root.Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Recover,At=.2f,Seconds=1,Recovery=new ConstructionRecovery{Efficiency=.75f}}};var recovering=Cast(recoveryDefinition);recovering.Advance(.5f,Vector3.right);Check(Shapes(recovering).Count>0,"正在收束的真实水体仍提供材料接触");double credited=recovering.RecoveredResource,remaining=recovering.RemainingVolume(0);Evaporate(recovering,0,.5);recovering.Advance(.5f,Vector3.right);Check(Math.Abs(recovering.RecoveredResource-credited)<1e-7&&Math.Abs(recovering.RemainingVolume(0)-(remaining-.5))<1e-5,"真实火作用中断收束，旧定时操作不重启或补满水量");
var flow=Cast(Water(true));flow.Advance(.01f,Vector3.right);var shapes=Shapes(flow);Check(shapes.Count>0,"装饰水体也能提供真实材料接触");var fluids=(Array)Field(flow,"flows");object fluid=fluids.GetValue(0);var water=(Vector3[])Field(fluid,"Water");float cell=(float)Field(fluid,"Cell");int index=Array.FindIndex(water,u=>u.x>.001f);int shape=Cultiway.Core.Visuals.Forms.FormResources.Load("water_flow").Contacts.Length+index;Vector3 velocityBefore=water[index];double volumeBefore=flow.RemainingVolume(0);removed=Evaporate(flow,shape,.1);Check(removed>0&&Math.Abs(flow.RemainingVolume(0)+removed-volumeBefore)<1e-5,"局部蒸散与剩余水量守恒");Check(Math.Abs((double)Field(fluid,"Evaporated")-removed)<1e-7,"真正失去的水量记入蒸散去向");Check(water[index].x<=velocityBefore.x&&Math.Abs(water[index].y*velocityBefore.x-velocityBefore.y*water[index].x)<1e-6,"移除水量同步移除对应动量");Check(Math.Abs(flow.RemainingResource(0)-8*(1-removed/volumeBefore))<1e-5,"活动水体按真实失水扣支付，不按整片水域扣款");double other=water.Where((v,i)=>i!=index).Sum(v=>(double)v.x);Evaporate(flow,shape,100);Check(water[index].x==0&&Math.Abs(water.Where((v,i)=>i!=index).Sum(v=>(double)v.x)-other)<1e-8,"清空接触格不抹除其他水格");Check(Evaporate(flow,shape,100)==0,"同一干格不能重复产生蒸散");
var powerless=Cast(Water(true),0);powerless.Advance(.01f,Vector3.right);Check(Shapes(powerless).Count>0,"零攻击力量的液态水仍可相消火质");var normal=new List<AbilityCapsule>();powerless.AppendContacts(normal);Check(normal.Count==0,"纯材料接触不会自动变为人物攻击");
var material=Call(flow,"CaptureMaterial",0);var save=Call(material,"Capture");var restored=typeof(AbilityMaterial).GetMethod("Restore",F).Invoke(null,new[]{save});Check(Math.Abs(((AbilityMaterial)restored).Volume-((AbilityMaterial)material).Volume)<1e-5&&Math.Abs(((AbilityMaterial)restored).Resource-((AbilityMaterial)material).Resource)<1e-7,"独立材料资料往返保留失水和剩余支付");
var fire=JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/离体炎流.json")));var flame=Cast(fire,20);Call(flame,"ConsumeForce",0,5f);var visuals=new List<Cultiway.Core.Visuals.Forms.FormVisualInstance>();flame.AppendVisuals(visuals);Check(visuals.Count==1&&Math.Abs(visuals[0].Tint.Value.a-.75f)<1e-6,"火体反馈读取尚存作用量");Check(AbilityMatters.Resolve("fire",null,"测试").State=="energy"&&AbilityMatters.Resolve("iron","liquid","测试").Id!="fire","明确火质与熔铁分别登记");Check(!Cultiway.Core.Visuals.Forms.FormResources.Ids.Contains("reaction_steam"),"纯蒸散不混入可选攻击形体");
var poolType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.SimulationWorkerPool");var pool=poolType.GetProperty("Instance",F).GetValue(null);var run=poolType.GetMethod("RunIndexed",F);var definition=Water(true);var plan=AbilityCompiler.Compile(definition);foreach(int count in new[]{32,128}){var left=Enumerable.Range(0,count).Select(i=>new AbilityCast(plan,Matrix4x4.identity,inputs:new AbilityInputs(Vector3.zero,Vector3.right,Vector3.right,1),force:20,paidResource:8)).ToArray();var right=Enumerable.Range(0,count).Select(i=>new AbilityCast(plan,Matrix4x4.identity,inputs:new AbilityInputs(Vector3.zero,Vector3.right,Vector3.right,1),force:20,paidResource:8)).ToArray();string State(AbilityCast c){c.Advance(.05f,Vector3.right);var shape=Shapes(c)[0];Evaporate(c,shape.Shape,.125);c.Advance(.1f,Vector3.right);var f=((Array)Field(c,"flows")).GetValue(0);return JsonConvert.SerializeObject(new{volume=c.RemainingVolume(0),resource=c.RemainingResource(0),force=c.RemainingForce(0),water=((Vector3[])Field(f,"Water")).SelectMany(v=>new[]{v.x,v.y,v.z}).ToArray(),evaporated=Field(f,"Evaporated")});}var serial=left.Select(State).ToArray();var parallel=new string[count];Action<int> work=i=>parallel[i]=State(right[i]);run.Invoke(pool,new object[]{0,count,work});Check(serial.SequenceEqual(parallel),"串行与真实工作池的水火减量一致："+count);await Game.NextFrame();}
var result=new{passed=true,checks};File.WriteAllText(Path.Combine(folder,"math.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
