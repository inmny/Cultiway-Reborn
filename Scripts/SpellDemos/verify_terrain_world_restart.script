// 不同真实进程恢复永久地貌，并分别录制原版和真实Worldfall的地点作用。
using System;using System.IO;using System.Linq;using System.Reflection;using System.Collections.Generic;using System.Threading.Tasks;using Newtonsoft.Json;using Newtonsoft.Json.Linq;using UnityEngine;using DebugToolbox.Runtime.Scripting;using Cultiway.Core;using Cultiway.Core.Skills;using Cultiway.Core.Visuals.Forms;using Cultiway.Core.SkillLibV3.ActiveAbilities;using Cultiway.Content.Skills;using Cultiway.Content.Combat;using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Instance|BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic;string root=Cultiway.ModClass.I.GetDeclaration().FolderPath;var ground=(Func<Rect,AbilityHeightField>)typeof(ConstructedAbilityService).GetField("GroundProvider",F).GetValue(null);string mode=ground==null?"native":"worldfall",folder=Path.Combine(root,"artifacts/skill_rebuild/terrain-world",mode);var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));var checks=new List<string>();void Check(bool v,string n){if(!v)throw new InvalidOperationException(n);checks.Add(n);Log.Info(n);}Check(System.Diagnostics.Process.GetCurrentProcess().Id!=(int)expected["process"],"真正使用另一游戏进程恢复永久地貌");var hs=new BaseStats();hs.addTag("frozen_ai");hs.addTag("immovable");var hold=Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.TerrainWorldHold")??Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.TerrainWorldHold").SetStats(hs).SetDuration(10000).Build();var rt=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=rt.GetProperty("Instance").GetValue(null);async Task Boundary()=>await Game.WaitUntil(()=>(bool)rt.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);async Task Advance(float sec){Config.paused=false;double end=World.world.getCurWorldTime()+sec;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=end,3600);Config.paused=true;await Boundary();}
Config.paused=true;Game.Resume();ControllableUnit.clear(false);World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();World.world.console.Hide();foreach(var screen in Resources.FindObjectsOfTypeAll<LoadingScreen>())screen.gameObject.SetActive(false);var actor=World.world.units.get((long)expected["actor"]);Check(actor!=null&&actor.isAlive(),"实际施法者恢复");var owner=actor.GetExtend();JToken Section(string s,string key)=>JObject.Parse(s)["sections"][key];var saves=Cultiway.ModClass.I.WorldSaves;Check(JToken.DeepEquals(Section((string)expected["world"],"ability_constructions"),Section(saves.World.Capture(World.world,"terrain-world"),"ability_constructions")),"四项世界操作及真实构造原样恢复");Check(JToken.DeepEquals(Section((string)expected["person"],"ability_knowledge"),Section(saves.Actors.Capture(owner,"terrain-world"),"ability_knowledge")),"实际已学关系与独立冷却保持");Check(saves.LastReport.Skipped.Count==0&&saves.LastReport.BackupError==null,"正式恢复没有资料丢弃或备份错误");foreach(var record in expected["records"])Check(record["tiles"].All(t=>World.world.GetTileSimple((int)t["X"],(int)t["Y"]).main_type.id==(string)t["main"]),"原版永久地貌保持："+(string)record["name"]);
var events=new List<ConstructedWorldContact>();void Contact(ConstructedWorldContact e){if(e.SourceId==actor.id)events.Add(e);}ConstructedAbilityService.WorldContactConfirmed+=Contact;var recordings=new List<object>();Type wf=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType("FirstPerson.WorldBoxMod",false)).FirstOrDefault(t=>t!=null);object wfRoot=wf?.GetProperty("Instance",F).GetValue(null);Type bridge=typeof(ConstructedAbilityService).Assembly.GetType("Cultiway.Content.Compatibility.Worldfall.FormWorldfallRenderer",true);try{await Advance(.2f);Check(events.Count==0,"读档不重放已经完成的地形作用");
for(int y=66;y<=92;y++)for(int x=60;x<=74;x++){var tile=World.world.GetTileSimple(x,y);if(tile.building!=null)tile.building.removeBuildingFinal();tile.setTileTypes(TileLibrary.soil_low,TopTileLibrary.grass_low);}
foreach(string view in ground==null?new[]{"native"}:new[]{"native","worldfall"}){
if(wfRoot!=null){wf.GetMethod("SetGodView",F).Invoke(wfRoot,new object[]{view=="worldfall"});wf.GetMethod("ViewForTest",F).Invoke(wfRoot,new object[]{false});await Game.WaitUntil(()=>view=="worldfall"?(bool)wf.GetProperty("GodShown",F).GetValue(wfRoot)&&(float)wf.GetProperty("GodAlpha",F).GetValue(wfRoot)>=.99f:!(bool)wf.GetProperty("GodShown",F).GetValue(wfRoot),1800);if(view=="worldfall"){wf.GetField("_godTip",F).SetValue(wfRoot,.55f);wf.GetField("_godTipRate",F).SetValue(wfRoot,0f);var settings=wf.GetField("Settings",F).GetValue(wfRoot);settings.GetType().GetField("TimeMode",F).SetValue(settings,1);}}
foreach(var test in new[]{new{name="raise",row=72,input=TileLibrary.soil_low},new{name="lower",row=72,input=TileLibrary.soil_high},new{name="fill",row=72,input=TileLibrary.pit_shallow_waters},new{name="drain",row=72,input=TileLibrary.shallow_waters}}){
for(int y=test.row-2;y<=test.row+2;y++)for(int x=61;x<=70;x++){var t=World.world.GetTileSimple(x,y);if(t.building!=null)t.building.removeBuildingFinal();t.setTileTypes(test.input,test.input==TileLibrary.soil_low?TopTileLibrary.grass_low:test.input==TileLibrary.soil_high?TopTileLibrary.grass_high:null);}if(test.name=="fill"||test.name=="drain")for(int y=test.row-2;y<=test.row+2;y++)for(int x=61;x<=70;x++)if(y!=test.row||x<64||x>(test.name=="drain"?64:67))World.world.GetTileSimple(x,y).setTileTypes(TileLibrary.soil_low,TopTileLibrary.grass_low);ground?.Invoke(new Rect(60,test.row-4,14,8));string id="test.terrain-world."+test.name;string key=view+"-"+test.name;string output=Path.Combine(folder,key);if(Directory.Exists(output))Directory.Delete(output,true);Directory.CreateDirectory(Path.Combine(output,"frames"));var times=new List<double>();int draws=0;double start=World.world.getCurWorldTime();World.world.camera.transform.position=new Vector3(65.5f,test.row+.5f,World.world.camera.transform.position.z);MoveCamera.instance.forceZoom(6);World.world.camera.orthographicSize=6;World.world.setZoomOrthographic(6);await Game.NextFrame();
int firstEvent=events.Count;Check(ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,id),new ActiveAbilityTarget(null,new Vector3(64.5f,test.row+.5f,0)),ActiveAbilityUseOrigin.Script),"恢复后的正式法术再次支付与施放："+key);Config.paused=false;double next=start;while(World.world.getCurWorldTime()<start+1.2){await Game.NextFrame();double now=World.world.getCurWorldTime();if(now<next)continue;World.world.camera.transform.position=new Vector3(65.5f,test.row+.5f,World.world.camera.transform.position.z);MoveCamera.instance.forceZoom(6);World.world.camera.orthographicSize=6;World.world.setZoomOrthographic(6);new ScreenFacade().Capture(Path.Combine(output,"frames",times.Count.ToString("00000")+".png"));times.Add(now-start);draws=Math.Max(draws,(int)bridge.GetProperty("LastDrawCount",F).GetValue(null));next=now+.075;}Config.paused=true;await Boundary();Check(events.Skip(firstEvent).Any(e=>e.AbilityId==id&&e.Result.Changed),"真实地形结果与录制施放保持："+key);if(view=="worldfall")Check(draws>0,"真正三维绘制提交了共同主体："+key);recordings.Add(new{key,view,times,draws});}
}
var result=new{passed=true,checks,mode,process=System.Diagnostics.Process.GetCurrentProcess().Id,contacts=events.Count,recordings};File.WriteAllText(Path.Combine(folder,"restart-result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{ConstructedAbilityService.WorldContactConfirmed-=Contact;wf?.GetMethod("SetGodView",F).Invoke(wfRoot,new object[]{false});Config.paused=true;}
