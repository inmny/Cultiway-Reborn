// 真正重启后恢复第四版固态层，并核对真实历史第一、二、三版的升级与原档保留。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using Cultiway.Core.Skills;
using Cultiway.Core.Persistence;
using Cultiway.Content.Skills;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/solid-layers");var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}int process=System.Diagnostics.Process.GetCurrentProcess().Id;Check((int)expected["process"]!=process,"真实退出后由另一游戏进程恢复");
var runnerType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=runnerType.GetProperty("Instance").GetValue(null);async Task Boundary()=>await Game.WaitUntil(()=>(bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);
async Task Load(string path){Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(path);await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();}
var saves=Cultiway.ModClass.I.WorldSaves;JObject Section(string json)=>(JObject)JObject.Parse(json)["sections"]["world_materials"];JObject Current()=>Section(saves.World.Capture(World.world,"solid-layers"));
JArray Normalize(JArray records){var copy=JArray.FromObject(records.Select(row=>row.ToObject<WorldMaterialData>()));foreach(JObject row in copy)row.Remove("Clock");return copy;}
JObject Upgrade(JObject section){var value=(JObject)section.DeepClone();while((int)value["version"]<4){int v=(int)value["version"];var m=(ISaveMigration)Activator.CreateInstance(typeof(AbilityCast).Assembly.GetType("Cultiway.Content.Skills.WorldMaterialsV"+v+"ToV"+(v+1)),true);value["data"]=m.Apply((JObject)value["data"]);value["version"]=v+1;}return value;}
await Load(Path.Combine(folder,"save"));Check(saves.LastReport.Skipped.Count==0&&saves.LastReport.BackupError==null&&!saves.LastReport.RequiresBackup,"第四版正式资料无升级或局部丢弃");var original=Section((string)expected["world"]);var current=Current();Check((int)current["version"]==4&&JToken.DeepEquals(Normalize((JArray)original["data"]["Records"]),Normalize((JArray)current["data"]["Records"])),"刚性、独立及共同固态层的材料、基底、热量与支付完整恢复");var rows=(JArray)current["data"]["Records"];Check(rows.Any(r=>!(bool)r["WorldGrid"]&&(string)r["Material"]["Matter"]=="iron"&&(bool)r["Material"]["ShapeHeld"])&&rows.Any(r=>!(bool)r["WorldGrid"]&&(string)r["Material"]["Matter"]=="wood"&&(bool)r["Material"]["ShapeHeld"]),"非默认保持材料的活动定形历史恢复后仍存在");Check(rows.Any(r=>(bool)r["WorldGrid"]&&(string)r["Material"]["Matter"]=="iron"&&(bool)r["Material"]["ShapeHeld"])&&rows.Any(r=>(bool)r["WorldGrid"]&&(string)r["Material"]["Matter"]=="wood"&&(bool)r["Material"]["ShapeHeld"]),"部分转换的共同金属及木层继续保持");var stable=rows.Where(r=>r["Material"]["ShapeHeld"]?.Value<bool>()==true).ToDictionary(r=>(long)r["Id"],r=>r["Material"].DeepClone());
var stats=new BaseStats();stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.SolidLayerRestartHold").SetStats(stats).SetDuration(10000).Build();foreach(var p in World.world.units.dict.Values.ToArray())Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(p,hold,10000,p);Config.paused=false;double until=World.world.getCurWorldTime()+.3;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;await Boundary();rows=(JArray)Current()["data"]["Records"];Check(stable.All(pair=>JToken.DeepEquals(pair.Value,rows.Single(r=>(long)r["Id"]==pair.Key)["Material"])),"跨进程继续推进，保持态不会进入普通水流计算");
var histories=new[]{("world-materials",1),("quenching/native-save",2),("solidification/cold-fixture",3),("burning/cold-fixture",3)};var reports=new List<object>();foreach(var pair in histories){string path=Path.Combine(root,"artifacts/skill_rebuild",pair.Item1);var meta=JObject.Parse(File.ReadAllText(Path.Combine(path,"restart-expected.json")));var section=Section((string)meta["world"]);Check((int)section["version"]==pair.Item2,"保留的真实历史夹具版本："+pair.Item1);byte[] bytes=File.ReadAllBytes(Path.Combine(path,"save/map.wbox"));await Load(Path.Combine(path,"save"));var actual=Current();var upgraded=Upgrade(section);Check((int)actual["version"]==4&&saves.LastReport.Upgraded==1&&saves.LastReport.Skipped.Count==0&&saves.LastReport.BackupError==null&&Directory.Exists(saves.LastReport.BackupDirectory),"历史格式逐版本升级并保留实际原档备份："+pair.Item1);Check(JToken.DeepEquals(Normalize((JArray)upgraded["data"]["Records"]),Normalize((JArray)actual["data"]["Records"])),"历史材料、剩余量、热量及支付按原事实恢复："+pair.Item1);Check(bytes.SequenceEqual(File.ReadAllBytes(Path.Combine(path,"save/map.wbox"))),"历史原世界文件没有被回写："+pair.Item1);if(pair.Item1=="burning/cold-fixture")Check(((JArray)actual["data"]["Records"]).Any(r=>r["Material"]["Burning"]?["Lit"]?.Value<bool>()==true),"第三版进行中的燃烧保留真实剩余燃料，不重新点火");reports.Add(new{fixture=pair.Item1,version=pair.Item2,backup=saves.LastReport.BackupDirectory});}
var result=new{passed=true,checks,reports,savedProcess=(int)expected["process"],process};File.WriteAllText(Path.Combine(folder,"restart.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
