// 真正退出后的另一个进程：共同水流、逐格份额和跨区整数累计继续；另核对版本1转换。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using Cultiway.Core.Skills;
using Cultiway.Content.Skills;
using Cultiway.Utils.Extension;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/conduction");var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));Check((int)expected["process"]!=System.Diagnostics.Process.GetCurrentProcess().Id,"保存来自真正退出前的另一进程");var saves=Cultiway.ModClass.I.WorldSaves;JObject Section(string json)=>(JObject)JObject.Parse(json)["sections"]["world_materials"];JObject Archive()=>Section(saves.World.Capture(World.world,"conduction"))["data"] as JObject;
var changes=new List<WorldMaterialChange>();void Event(WorldMaterialChange e)=>changes.Add(e);WorldMaterialService.Changed+=Event;
try{
 Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;var before=Section((string)expected["world"]);var after=Archive();Check((int)before["version"]==2,"本批实际保存世界材料版本2");Check(JToken.DeepEquals(before["data"]["RecoveryGroups"],after["RecoveryGroups"]),"跨区域的原资源累计账本完整恢复");var previous=(JArray)before["data"]["Records"];var current=(JArray)after["Records"];Check(previous.Count==current.Count&&(long)before["data"]["Next"]==(long)after["Next"],"区域、来源及稳定编号集合恢复");Check(previous.All(row=>{var r=current.Single(v=>(long)v["Id"]==(long)row["Id"]);return JToken.DeepEquals(JObject.FromObject(row["Material"].ToObject<AbilityMaterialData>()),JObject.FromObject(r["Material"].ToObject<AbilityMaterialData>()))&&new[]{"Lineage","WorldGrid","Provider","Controller","Resource","Recovering","RecoveryGroup","Progress","Confirmed"}.All(k=>JToken.DeepEquals(row[k],r[k]));}),"冰层基底、水深、动量、逐格份额、来源链和实际材料原样恢复");Check(changes.Count==0&&!saves.LastReport.RequiresBackup,"暂停读档不重放转交或入账，有效资料没有丢弃");Check(Cultiway.Core.Visuals.Forms.FormVisualScene.Instances.Any(v=>v.Layer!=null&&v.Layer.Sources>0),"共同水面暂停时立即恢复");
 var oldDefs=(JArray)JObject.Parse((string)expected["world"])["sections"]["ability_constructions"]["data"]["Definitions"];var newDefs=(JArray)JObject.Parse(saves.World.Capture(World.world,"conduction"))["sections"]["ability_constructions"]["data"]["Definitions"];var savedConductions=oldDefs.Where(d=>d.SelectTokens("$..Conduction").OfType<JObject>().Any()).ToArray();Check(savedConductions.Length>=5&&savedConductions.All(d=>newDefs.Any(n=>JToken.DeepEquals(d,n))),"导电时点、消耗、路径、上限和三份自创资料原样恢复");
 var actor=World.world.units.get((long)expected["actor"]);var other=World.world.units.get((long)expected["other"]);var middle=World.world.units.get((long)expected["middle"]);Check(actor!=null&&other!=null&&middle!=null,"原来源和目标稳定身份恢复");var stats=new BaseStats();stats["mana"]=256;stats["damage"]=40;stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.ConductionColdHold").SetStats(stats).SetDuration(10000).Build();foreach(var p in new[]{actor,other,middle}){Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(p,hold,10000,p);p.setStatsDirty();p.updateStats();p.setMana(128);}
 // 原版会按种族重建测试人物的野外阵营，临时战斗关系在验证场景中重新设置。
 actor.addAggro(other);other.addAggro(actor);actor.addAggro(middle);middle.addAggro(actor);
 var waves=new List<ConstructedConduction>();void Wave(ConstructedConduction e)=>waves.Add(e);ConstructedAbilityService.ConductionConfirmed+=Wave;
 async System.Threading.Tasks.Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;var t=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var r=t.GetProperty("Instance").GetValue(null);await Game.WaitUntil(()=>(bool)t.GetProperty("IsAtCycleBoundary").GetValue(r),3600);}
 bool Fire(Actor source,Actor target,AbilityDefinition d){ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(source.GetExtend(),d.Id);return Cultiway.Core.SkillLibV3.ActiveAbilities.ActiveAbilityService.TryUse(source.GetExtend(),new Cultiway.Core.SkillLibV3.ActiveAbilities.ActiveAbilityHandle("content.constructed",source.GetExtend().E,d.Id),new Cultiway.Core.SkillLibV3.ActiveAbilities.ActiveAbilityTarget(target,target.GetSimPos()),Cultiway.Core.SkillLibV3.ActiveAbilities.ActiveAbilityUseOrigin.Script);}
 try{
  await Advance(.4f);Check(waves.Count==0,"恢复后继续世界没有重放已完成导电或排队重复扣血");var thaw=JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/范围融冰.json")));thaw.Impact.Targets=Cultiway.Core.SkillLibV3.Usage.SkillUseTargetRelation.Self;Check(Fire(other,other,thaw),"读档后真实解冻原有水域");await Advance(.5f);
  var branch=newDefs.Single(d=>(string)d["Id"]=="Cultiway.Demo.WoodConduction").ToObject<AbilityDefinition>();Check(Fire(actor,other,branch),"第二种枝体通过保存恢复的普通操作正式导电");await Advance(.7f);var wave=waves.Single(w=>w.AbilityId==branch.Id);Check(wave.Route.Length>0&&wave.Targets.Contains(middle.id),"恢复后另一形体仍沿原有真实水域到达人物");Check(wave.HealthBefore.Zip(wave.HealthAfter,(a,b)=>a>b).All(v=>v),"第二种输入在冷启动后实际扣血并保持来源");Check(wave.OriginalSourceId==actor.id&&wave.OwnerId==actor.id,"读取后传播保留正确施放归属");
 }finally{ConstructedAbilityService.ConductionConfirmed-=Wave;}
 var result=new{passed=true,checks,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"restart.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{WorldMaterialService.Changed-=Event;Config.paused=true;}
