// 4.23：实际非手部原地关系，不通过反射直接建立关系或伪造接触。
const bool targetParts = false;
const string targetTransition = "";
const string targetMotion = "";
const int tailRank = 6;
var selectedTargets = Array.Empty<string>();
var surfaceType = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Skills.BodySurfacePose");
var surfaceBindingType = service.Assembly.GetType("Cultiway.Content.Skills.BodySurfaceBinding");
var surfaceCtor = surfaceType.GetConstructors(F).Single();
var findSurface = surfaceType.GetMethod("Find", F);
var spatial = service.Assembly.GetType("Cultiway.Content.Combat.SpatialActorPose");
var groundProvider = (Func<Rect, AbilityHeightField>)service.GetField("GroundProvider", F).GetValue(null);
var placementGround = groundProvider?.Invoke(new Rect(63, 71, 3, 2));
Vector3 NativeFoot(Actor a) => (Vector3)spatial.GetMethod("Foot", F).Invoke(null, new object[] { a });

Vector3 FootOf(Actor a)
{
    Vector3 foot = NativeFoot(a);
    foot.z += placementGround?.Sample(foot.x, foot.y) ?? 0f;
    return foot;
}

float HeightOf(Actor a) => (float)spatial.GetMethod("Height", F).Invoke(null, new object[] { a });

BodyFrame PhysicalFrame(object binding, Actor a) => (BodyFrame)bindingType.GetMethod("Frame", F, null,
    new[] { typeof(Vector3), typeof(float), typeof(BodySupportPose?) }, null).Invoke(binding,
    new object[] { FootOf(a), HeightOf(a), null });

float[] Coordinates(Vector3 v) => new[] { v.x, v.y, v.z };

object DescribeFrame(BodyFrame f) => new
{
    foot = Coordinates(f.Foot), forward = Coordinates(f.Forward), aim = Coordinates(f.AimForward),
    f.Height, shoulder = Coordinates(f.Shoulder), f.UpperLength, f.LowerLength, f.AimHeight, f.AimDistance,
    fit = f.Fit == null
        ? null
        : new { shoulder = Coordinates(f.Fit.Shoulder), f.Fit.Upper, f.Fit.Lower, f.Fit.HeightScale }
};

if (targetParts)
{
    // 最终合成与表面共用同一份归属；人工像素只用来核对明确的遮挡和透明边界。
    {
        var appearanceType = typeof(CreatureAppearanceService);
        var layerType = typeof(Cultiway.Content.CreatureCompositions.Libraries.CreatureVisualLayerAsset);
        var pixelParts = (IDictionary)appearanceType.GetField("parts", F).GetValue(null);
        var pixelSprites = new List<Sprite>();
        object pixelResult = null;

        Sprite PixelSprite(string name, int width, Color32[] colors)
        {
            var texture = new Texture2D(width, 2, TextureFormat.RGBA32, false);
            texture.SetPixels32(colors);
            texture.Apply();
            Sprite image = Sprite.Create(texture, new Rect(0, 0, width, 2), Vector2.zero, 1f);
            image.name = name;
            pixelSprites.Add(image);
            return image;
        }

        var red = new Color32(255, 0, 0, 255);
        var blue = new Color32(0, 0, 255, 255);
        var green = new Color32(0, 255, 0, 255);
        var clear = new Color32(0, 0, 0, 0);
        var yellow = new Color32(255, 255, 0, 255);
        Sprite pixelBody = PixelSprite("ownership.body", 3,
            new[] { red, red, clear, clear, new Color32(255, 0, 0, 128), red });
        Sprite pixelBack = PixelSprite("ownership.back", 3, Enumerable.Repeat(blue, 6).ToArray());
        Sprite pixelFront = PixelSprite("ownership.front", 3,
            new[] { clear, new Color32(0, 255, 0, 128), clear, green, clear, clear });
        Sprite pixelClip = PixelSprite("ownership.clip", 4,
            new[] { yellow, clear, yellow, yellow, clear, clear, clear, clear });
        var pixelLayers = Array.CreateInstance(layerType, 3);
        for (int layerIndex = 0; layerIndex < 3; layerIndex++)
        {
            string name = new[] { "back", "front", "clip" }[layerIndex];
            Sprite image = new[] { pixelBack, pixelFront, pixelClip }[layerIndex];
            var layer = new Cultiway.Content.CreatureCompositions.Libraries.CreatureVisualLayerAsset
            {
                id = name,
                Depth = layerIndex == 0
                    ? Cultiway.Content.CreatureCompositions.Libraries.CreatureLayerDepth.BehindBody
                    : Cultiway.Content.CreatureCompositions.Libraries.CreatureLayerDepth.AboveBody,
                ClipToBody = layerIndex == 2
            };
            layer.FramesByRig["ownership"] =
                new Dictionary<string, Cultiway.Content.CreatureCompositions.Libraries.CreatureLayerFrame>
                {
                    [pixelBody.name] = new() { SpritePath = image.name, BodyWidth = 3, BodyHeight = 2 }
                };
            pixelParts[image.name] = image;
            pixelLayers.SetValue(layer, layerIndex);
        }

        try
        {
            object pixelPlan = appearanceType.GetNestedType("AppearancePlan", F).GetConstructors(F).Single()
                .Invoke(new object[] { "ownership", pixelLayers });
            pixelResult = appearanceType.GetMethod("BuildFrame", F).Invoke(null,
                new object[] { "ownership", pixelPlan, pixelBody, pixelBody, null, null });
            Sprite pixelOutput = (Sprite)Field(pixelResult, "Sprite");
            var pixelAlpha = (byte[])Field(pixelResult, "Alpha");
            var pixelOwners = (int[])Field(pixelResult, "Owners");
            var pixelNames = (string[][])Field(pixelResult, "Layers");
            string[][] expectedOwners =
            {
                new[] { "<body>", "clip" }, new[] { "<body>", "front" }, new[] { "back" },
                Array.Empty<string>(),
                new[] { "front" }, new[] { "<body>", "back" }, new[] { "<body>" }, Array.Empty<string>()
            };
            Check(pixelOutput.rect.width == 4 && pixelOutput.rect.height == 2 &&
                  pixelAlpha.SequenceEqual(new byte[] { 255, 255, 255, 0, 255, 255, 255, 0 }) &&
                  Enumerable.Range(0, 8).All(i => pixelNames[pixelOwners[i]].Select(n => n ?? "<body>")
                      .OrderBy(n => n, StringComparer.Ordinal)
                      .SequenceEqual(expectedOwners[i].OrderBy(n => n, StringComparer.Ordinal))),
                "最终像素归属同时处理背景遮挡、半透明透出、身体区域和越界裁切");
            var painted = (Color32[])appearanceType.GetMethod("ReadPixels", F)
                .Invoke(null, new object[] { pixelOutput });
            Check(painted.Select(c => c.a).SequenceEqual(pixelAlpha) && painted[0].r == 255 &&
                  painted[0].g == 255 &&
                  painted[2].b == 255 && painted[4].g == 255 && painted[6].r == 255 &&
                  painted[1].r > 0 && painted[1].g > 0 && painted[1].b == 0 &&
                  painted[5].r > 0 && painted[5].b > 0 && painted[5].g == 0,
                "归属来自真正上传的合成帧，没有用另一张未叠加的图片代替");
            string[][] selections = pixelNames.Select(names => names.Reverse()
                .Select(n => n == null ? "torso" : "organ:pixel." + n).ToArray()).ToArray();
            var nativePixels = surfaceBindingType.GetNestedType("Native", F).GetMethod("Pixels", F);
            var physicalParts = (Array)nativePixels.Invoke(null,
                new object[] { pixelOutput, selections, Vector2.zero, 2f, pixelAlpha, pixelOwners });
            float area = 0f, depth = 0f;
            int intervals = 0;
            foreach (object piece in physicalParts)
            {
                var points = (Vector3[])Field(piece, "Vertices");
                for (int i = 0; i < points.Length; i += 8)
                {
                    area += (points[i + 1].x - points[i].x) *
                            (points[i + 3].y + points[i + 3].z - points[i].y - points[i].z);
                    depth = Mathf.Max(depth, Mathf.Abs(points[i + 4].y));
                    intervals++;
                }
            }

            Check(Mathf.Abs(area - 6f) < .00001f && intervals == 6 && Mathf.Abs(depth - 1.5f) < .00001f,
                "共享像素只生成一份几何，按归属切段后保留原整行深度", new { area, intervals, depth });
            object pixelSurface = surfaceCtor.Invoke(new object[]
            {
                physicalParts, Enumerable.Repeat(Matrix4x4.identity, physicalParts.Length).ToArray(),
                Vector3.zero, 2f, 0f
            });
            Check(Mathf.Abs((float)surfaceType.GetMethod("Radius", F).Invoke(pixelSurface,
                      new object[] { "organ:pixel.front" }) - 2.5f) < .00001f &&
                  (float)surfaceType.GetMethod("Radius", F)
                      .Invoke(pixelSurface, new object[] { "organ:pixel.missing" }) == 0f,
                "器官选择外伸只取真实所选三角面，不借用画布留白或其他部位");
            object pixelProbe = Sphere(new Vector3(1.5f, .5f, 0), new Vector3(1.5f, .5f, 0), .01f);
            Check((bool)findSurface.Invoke(null,
                      new object[]
                      {
                          pixelSurface, pixelSurface, pixelProbe, pixelProbe, "torso", 0f, null, Vector3.zero
                      }) &&
                  (bool)findSurface.Invoke(null,
                      new object[]
                      {
                          pixelSurface, pixelSurface, pixelProbe, pixelProbe, "organ:pixel.front", 0f, null,
                          Vector3.zero
                      }),
                "同一真实表面能按身体或仍可见器官选择，不复制面来伪造别名");
            pixelProbe = Sphere(new Vector3(1f, -.5f, 1f), new Vector3(1f, -.5f, 1f), .01f);
            Check(!(bool)findSurface.Invoke(null, new object[]
                    { pixelSurface, pixelSurface, pixelProbe, pixelProbe, "surface", 0f, null, Vector3.zero }),
                "像素归属分界没有新增内墙，身体内部不能因切段而提前接触");
            pixelProbe = Sphere(new Vector3(.5f, .5f, 0), new Vector3(.5f, .5f, 0), .01f);
            Check(
                !(bool)findSurface.Invoke(null,
                    new object[]
                    {
                        pixelSurface, pixelSurface, pixelProbe, pixelProbe, "organ:pixel.back", 0f, null,
                        Vector3.zero
                    }),
                "被身体挡住的背景器官不能从该处建立接触");
            var sourcePoses = Array.CreateInstance(surfaceType, 1);
            sourcePoses.SetValue(pixelSurface, 0);
            var compositionType =
                typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Skills.BodySurfaceComposition");
            object combined = compositionType.GetConstructors(F).Single()
                .Invoke(new object[] { sourcePoses, BodyOccupancy.None, false, false });
            object finalPixels = compositionType.GetMethod("Sample", F)
                .Invoke(combined, new object[] { sourcePoses });
            Check((bool)surfaceType.GetMethod("Supports", F)
                      .Invoke(finalPixels, new object[] { "organ:pixel.front" }) &&
                  (bool)surfaceType.GetMethod("Supports", F).Invoke(finalPixels, new object[] { "torso" }),
                "完整身体合并继续保留同一像素的多重选择");
        }
        finally
        {
            foreach (Sprite image in pixelSprites)
            {
                pixelParts.Remove(image.name);
                UnityEngine.Object.Destroy(image.texture);
                UnityEngine.Object.Destroy(image);
            }

            if (pixelResult != null)
            {
                var image = (Sprite)Field(pixelResult, "Sprite");
                UnityEngine.Object.Destroy(image.texture);
                UnityEngine.Object.Destroy(image);
            }
        }
    }
    var partType = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Skills.BodySurfacePart");
    object original = partType.GetConstructors(F).Single().Invoke(new object[]
    {
        "arm.right.lower", new[] { new Vector3(-1, 0, -1), new Vector3(1, 0, -1), new Vector3(0, 0, 1) },
        new[] { 0, 1, 2 }, null, 0, null
    });
    object[] split = { original, "hand.right", Vector3.zero, Vector3.forward, null, null };
    typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Skills.BodySurfacePartition").GetMethod("Split", F)
        .Invoke(null, split);

    float Area(object part)
    {
        var vertices = (Vector3[])Field(part, "Vertices");
        var triangles = (int[])Field(part, "Triangles");
        float area = 0;
        for (int i = 0; i < triangles.Length; i += 3)
            area += Vector3.Cross(vertices[triangles[i + 1]] - vertices[triangles[i]],
                vertices[triangles[i + 2]] - vertices[triangles[i]]).magnitude * .5f;
        return area;
    }

    Check(Mathf.Abs(Area(split[4]) + Area(split[5]) - Area(original)) < .00001f &&
          Mathf.Abs(Area(split[5]) - .5f) < .00001f, "掌足裁分保留原面总面积，不扩大区域或重复原面");
    Check(((Vector3[])Field(split[4], "Vertices")).All(v => v.z <= 0f && v.y == 0f) &&
          ((Vector3[])Field(split[5], "Vertices")).All(v => v.z >= 0f && v.y == 0f),
        "裁分两侧仍在原三角面内，不新增切口封面");
    var halves = Array.CreateInstance(partType, 2);
    halves.SetValue(split[4], 0);
    halves.SetValue(split[5], 1);
    object divided = surfaceCtor.Invoke(new object[]
        { halves, new[] { Matrix4x4.identity }, Vector3.zero, 1f, 0f });
    object probe = Sphere(new Vector3(-.6f, 0, -.5f), new Vector3(-.6f, 0, -.5f), .001f);
    object[] arm = { divided, divided, probe, probe, "arm.right.lower", 0f, null, Vector3.zero };
    object[] palm = { divided, divided, probe, probe, "hand.right", 0f, null, Vector3.zero };
    Check((bool)findSurface.Invoke(null, arm) && !(bool)findSurface.Invoke(null, palm),
        "前臂接触不能误当掌部接触，原完整前臂选择仍有效");
    Vector3 nearest = (Vector3)surfaceType.GetMethod("Nearest", F).Invoke(divided,
        new object[] { "hand.right", new Vector3(0, 2, -.5f) });
    Check(nearest.y == 0f && nearest.z >= 0f && nearest.magnitude < .00001f,
        "适配位置来自所选实际三角面，不取模型内部或未选前臂");
    var footPlan = AbilityCompiler.Compile(PartAction("foot.right", BodyRelationKind.Grab), false);
    var footFrame = new BodyFrame(Vector3.zero, Vector3.right, 1f, new Vector3(0, .16f, .62f), .24f, .27f,
        1f, aimOffset: new Vector3(0, 0, -2));
    BodyPose low =
        footPlan.Body.Sample((footPlan.Body.ActiveFrom + footPlan.Body.ActiveUntil) * .5f, footFrame);
    Check(low.RightLeg.Value.Foot.z >= -.00001f, "部位适配不能把发力足移入原地面以下");
}

AbilityDefinition PartAction(string part, BodyRelationKind kind)
{
    var d = Action(part.Replace(':', '.'), kind);
    d.Body = part.StartsWith("organ:")
        ? d.Body
        : BodyActionGenerator.Create(new BodyActionRequest
            { Effector = part, Kind = BodyActionKind.Thrust, Seconds = 2f });
    d.Body.Effector = "effector";
    d.Body.MatchDistance = false;
    // 肘和肩采用真实侧身接触；不把侧面的关节当成朝前的掌面。
    if (part.StartsWith("elbow.") || part.StartsWith("shoulder."))
        foreach (var key in d.Body.Keys)
        {
            key.Heading = part.EndsWith("left") ? -90f : 90f;
            key.Support = new BodySupportMotion();
        }

    d.Body.ImpactRecoil = 0;
    d.Body.Impact = new ConstructionImpact { DamageScale = 0f };
    string shape = part.Split('.')[0] == "hand" ? "palm" :
        part.StartsWith("organ:") ? "organ" : part.Split('.')[0];
    d.Body.Construction = new BodyConstructionDefinition
    {
        Parts = new[]
        {
            new BodyPartInput { Id = "effector", Part = part },
            new BodyPartInput { Id = "body", Subject = BodyPartSubject.Target, Part = "surface" }
        },
        Relations = new[]
        {
            new BodyRelationDefinition
                { Id = "hold", From = "effector", To = "body", FromAnchor = shape, Kind = kind }
        }
    };
    if (part.StartsWith("organ:"))
        foreach (var key in d.Body.Keys)
        {
            key.Hand = new float[3];
            key.Torso = new float[3];
            key.Rotation = new float[3];
            key.Turn = 0;
            key.PartAngle = key.At <= .25f ? -20f : 40f;
        }

    return d;
}

Actor source = New(64), target = New(65);
if (targetTransition != "" || targetMotion != "")
{
    source.joinLanguage(World.world.languages.newLanguage(source, true));
    source.setCulture(World.world.cultures.newCulture(source, true));
    World.world.kingdoms.makeNewCivKingdom(source);
    World.world.cities.buildFirstCivilizationCity(source);
}
target.setKingdom(World.world.units.getSimpleList().First(a => a.kingdom != source.kingdom).kingdom);
if (targetParts)
{
    await Advance(.2f);
    if (worldfall == null)
    {
        var sideDefinition = Action("native-leg-sides");
        sideDefinition.Body = BodyActionGenerator.Create(new BodyActionRequest
            { Effector = "foot.left", Kind = BodyActionKind.Thrust, Seconds = 2f });
        var sidePlan = AbilityCompiler.Compile(sideDefinition, false);
        Vector3 nativeRoot = FootOf(target);
        float nativeHeight = HeightOf(target);
        var sideFrame = new BodyFrame(nativeRoot, Vector3.right, nativeHeight, new Vector3(0, .16f, .62f),
            nativeHeight * .24f, nativeHeight * .27f, 1f);
        BodyPose legAction = sidePlan.Body.Sample(.7f, sideFrame);
        var legReports = new List<object>();
        var heights = new List<float>();
        bool oldFlip = target.flip;
        try
        {
            foreach (bool flip in new[] { false, true })
            {
                target.setFlip(flip);
                object sampled = surfaceBindingType.GetMethod("Create", F).Invoke(null, new object[] { target });
                object neutral = sampled.GetType().GetMethod("Sample", F).Invoke(sampled,
                    new object[] { nativeRoot, nativeHeight, World.world.getCurWorldTime() });
                object moved = sampled.GetType().GetMethod("Acting", F).Invoke(sampled,
                    new object[] { neutral, legAction, null, null, null, null });
                var regions = ((Array)Field(moved, "Parts")).Cast<object>().ToArray();
                var transforms = (Matrix4x4[])Field(moved, "Matrices");
                foreach (string role in new[] { "foot.left", "foot.right" })
                {
                    float minimum = Enumerable.Range(0, regions.Length)
                        .Where(i => (string)Field(regions[i], "Id") == role)
                        .SelectMany(i => ((Vector3[])surfaceType.GetMethod("Vertices", F)
                                .Invoke(moved, new object[] { i })).Select(v =>
                                transforms[(int)Field(regions[i], "TransformIndex") < 0 ? i :
                                    (int)Field(regions[i], "TransformIndex")].MultiplyPoint3x4(v).z)).Min();
                    heights.Add(minimum);
                    legReports.Add(new { flip, role, minimum, left = legAction.LeftLeg.Value.Foot.z,
                        right = legAction.RightLeg.Value.Foot.z });
                }
            }
        }
        finally { target.setFlip(oldFlip); }
        File.WriteAllText(Path.Combine(folder, "native-leg-sides.json"), JsonConvert.SerializeObject(legReports, Formatting.Indented));
        Check(Mathf.Abs(legAction.LeftLeg.Value.Foot.z - legAction.RightLeg.Value.Foot.z) > .02f &&
              Mathf.Abs(heights[0] - heights[2]) < .0001f && Mathf.Abs(heights[1] - heights[3]) < .0001f,
            "原版翻转不会把左足像素接到右腿动作，左右足分别跟随自己的同轮姿态");
    }
    foreach (string missing in new[] { "part:missing-body-part" })
    {
        var absent = PartAction("hand.right", BodyRelationKind.Grab);
        absent.Id += ".missing." + missing.Replace(':', '.');
        absent.TargetRange = 20;
        absent.Body.Construction.Parts.Single(p => p.Subject == BodyPartSubject.Target).Part = missing;
        var absentPlan = AbilityCompiler.Compile(absent, false);
        object actual = null;
        await Game.WaitUntil(() => (actual = surfaceBindingType.GetMethod("Create", F)
            .Invoke(null, new object[] { target })) != null && Binding(source, absentPlan) != null, 300);
        Check(actual != null && Binding(source, absentPlan) != null, missing + "双方真实模型已就绪");
        ConstructedAbilityService.Register(absent);
        ConstructedAbilityService.Learn(source.GetExtend(), absent.Id);
        CombatStatusEffects.RemoveStatus(source, quiet);
        source.updateStats();
        source.cancelAllBeh();
        source.attack_timer = 0;
        bool used = ActiveAbilityService.TryUse(source.GetExtend(),
            new ActiveAbilityHandle("content.constructed", source.GetExtend().E, absent.Id),
            new ActiveAbilityTarget(target, target.GetSimPos()), ActiveAbilityUseOrigin.Script);
        object preview = actual.GetType().GetMethod("Sample", F).Invoke(actual,
            new object[] { FootOf(target), HeightOf(target), World.world.getCurWorldTime() });
        Check(!used && !(bool)surfaceType.GetMethod("Supports", F).Invoke(preview, new object[] { missing }) &&
              !((IDictionary)service.GetField("bodySurfaces", F).GetValue(null)).Contains(target.id) &&
              !BodyControlState.IsBusy(source.id) && !BodyControlState.IsBusy(target.id),
            missing + "已采集真实目标后拒绝未提供的部位，不残留双方占用");
        Quiet(source);
    }

    if (worldfall == null)
    {
        CombatStatusEffects.RemoveStatus(source, quiet);
        source.updateStats();
        source.cancelAllBeh();
        var allowed = PartAction("hand.right", BodyRelationKind.Grab);
        allowed.TargetRange = 20;
        await Fire(allowed, source, target);
        Check(BodyControlState.IsBusy(source.id), "相同原版人物仍能正式施放已有完整表面关系");
        await Advance(2.1f);
    }
}

var sourceSamples = new[]
    {
        "elbow.right", "elbow.left", "shoulder.right", "shoulder.left",
        "knee.right", "knee.left", "foot.right", "foot.left", "head", "organ:yao.horn.thunder"
    }
    .Select(p => (Effector: p, Selection: "surface", Species: "human")).ToArray();
var targetSamples = new[]
{
    ("hand.right", "head", "human"), ("hand.right", "torso", "human"),
    ("hand.right", "arm.right.upper", "human"), ("hand.right", "arm.right.lower", "human"),
    ("hand.right", "arm.left.upper", "human"), ("hand.right", "arm.left.lower", "human"),
    ("foot.right", "leg.right.upper", "human"), ("foot.right", "leg.right.lower", "human"),
    ("foot.right", "leg.left.upper", "human"), ("foot.right", "leg.left.lower", "human"),
    ("hand.right", "hand.right", "human"), ("hand.left", "hand.left", "human"),
    ("foot.right", "foot.right", "human"), ("foot.left", "foot.left", "human"),
    ("hand.right", "head", "wolf"), ("foot.right", "surface", "fox"),
    ("foot.right", "surface", "turtle"), ("hand.right", "surface", "bear"),
    ("foot.right", "part:tail", "crocodile"), ("foot.right", "surface", "penguin"),
    ("foot.right", "surface", "snake"), ("hand.right", "surface", "buffalo"),
    ("hand.right", "surface", "rhino"),
    ("foot.right", "surface", "bee"), ("foot.right", "surface", "fly"),
    ("foot.right", "surface", "butterfly"),
    ("hand.right", "surface", "dragon"),
    ("hand.right", "organ:yao.horn.thunder", "wolf"),
    ("hand.right", "organ:yao.horn.evilspotter", "wolf"),
    ("foot.right", "organ:yao.crown.tails", "fox"),
    ("foot.right", "organ:yao.wing.fupeng", "penguin"),
    ("foot.right", "organ:yao.wing.fierce", "penguin"),
    ("foot.right", "organ:yao.shell.black", "turtle"),
    ("hand.right", "organ:yao.eye.illusion", "wolf"),
    ("foot.right", "organ:yao.feather.fire", "wolf"),
    ("foot.right", "organ:yao.fur.moonlight", "wolf"),
    ("foot.right", "organ:yao.scale.basic", "wolf"),
    ("foot.right", "organ:yao.scale.fine", "wolf")
};
int executedBodyCases = 0;
foreach (var sample in (targetParts ? targetSamples : sourceSamples).Where(s =>
             (selectedTargets.Length == 0 || selectedTargets.Contains(s.Item3 + "." + s.Item2)) &&
             (s.Item3 != "dragon" || selectedTargets.Contains("dragon.surface")) &&
             (!targetParts || worldfall != null || s.Item3 == "human" || s.Item2.StartsWith("organ:") ||
              s.Item3 is "bee" or "fly" or "butterfly" or "dragon")))
{
    executedBodyCases++;
    string part = sample.Item1, selection = sample.Item2, species = sample.Item3;
    bool hoveringTarget = species is "bee" or "fly" or "butterfly";
    bool addedGiant = hoveringTarget && worldfall != null && !source.hasTrait("giant");
    string label = targetParts ? species + "." + selection : part;
    Park();
    if (addedGiant)
    {
        // 使用真实巨人体型取得足够可达高度，不拉长骨骼，也不降低目标的真实悬浮高度。
        source.addTrait("giant"); source.setStatsDirty(); source.updateStats(); source.finishScale();
    }
    if (targetParts)
    {
        Check(AssetManager.actor_library.get(species) != null, label + "实际物种资源存在");
        target = Make(65, species);
        target.setKingdom(World.world.units.getSimpleList().First(a => a.kingdom != source.kingdom).kingdom);
    }

    if (selection.StartsWith("organ:"))
    {
        var owner = target.GetExtend();
        Check(YaoAwakeningService.TryAwakenByRain(owner), label + "目标实际启灵");
        var targetOrgans = new List<YaoOrganRecord>();
        var organLibrary = Cultiway.Content.Libraries.Manager.CreatureOrganLibrary;
        var rankLibrary = Cultiway.Content.Libraries.Manager.CreatureOrganRankLibrary;

        /// <summary>按真实器官类别和前置条件组成目标身体，允许贴身纹样作为真实表面。</summary>
        /// <param name="id">当前器官。</param><param name="rank">实际等级。</param>
        void AddTargetOrgan(string id, int rank)
        {
            if (targetOrgans.Any(record => record.OrganId == id)) return;
            var organ = organLibrary.get(id);
            string slot = Cultiway.Content.Libraries.Manager.CreatureBodySlotLibrary.list
                .First(s => (s.AcceptedCategoryMask & organ.Category) == organ.Category).id;
            targetOrgans.Add(new YaoOrganRecord
            {
                SlotId = slot, OrganId = id, Rank = rank, Origin = YaoOrganOrigin.GodEdited
            });
            foreach (string prerequisite in organ.PrerequisiteOrganIds)
                AddTargetOrgan(prerequisite, organLibrary.get(prerequisite).RankIds.Select(id => rankLibrary.get(id).Rank).Min());
        }
        string selectedOrgan = selection.Substring(6);
        AddTargetOrgan(selectedOrgan, selectedOrgan == "yao.crown.tails" ? tailRank :
            organLibrary.get(selectedOrgan).RankIds.Select(id => rankLibrary.get(id).Rank).Min());
        if (!targetOrgans.Any(record => record.SlotId == YaoContent.Slots.Surface)) AddTargetOrgan("yao.scale.basic", 1);
        if (!targetOrgans.Any(record => record.SlotId == YaoContent.Slots.Head)) AddTargetOrgan("yao.spirit.sense", 1);
        Check(YaoFormPlanService.TrySetOrgans(owner, YaoFormIds.TrueForm, targetOrgans.ToArray()),
            label + "目标表达实际器官");
        target.setStatsDirty();
        target.updateStats();
        target.finishScale();
    }

    if (part.StartsWith("organ:"))
    {
        source = Make(64, "wolf");
        var owner = source.GetExtend();
        Check(YaoAwakeningService.TryAwakenByRain(owner), "器官来源实际启灵");
        Check(YaoFormPlanService.TrySetOrgans(owner, YaoFormIds.TrueForm, new[]
        {
            new YaoOrganRecord
            {
                SlotId = YaoContent.Slots.Surface, OrganId = "yao.scale.basic", Rank = 1,
                Origin = YaoOrganOrigin.Innate
            },
            new YaoOrganRecord
            {
                SlotId = YaoContent.Slots.Head, OrganId = "yao.horn.thunder", Rank = 2,
                Origin = YaoOrganOrigin.GodEdited
            }
        }), "器官来源表达实际可见角");
        source.setStatsDirty();
        source.updateStats();
        source.finishScale();
    }

    made.Add(source);
    made.Add(target);
    Quiet(source);
    Quiet(target);
    Place(source, 64, 72);
    Place(target, 65, 72);
    if (targetTransition != "")
    {
        target.setFlying(targetTransition == "land");
        if (targetTransition == "dragon-state")
        {
            Check(species == "dragon", "龙动作切换使用真实龙，不能跳过场景");
            target.getActorComponent<Dragon>().setFrames(DragonState.SleepLoop, true);
        }
    }
    await Advance(.5f);
    if (selection.StartsWith("organ:"))
    {
        source.GetExtend().SetPowerLevel(target.GetExtend().GetPowerLevel());
        float response = target.GetExtend().ForceResponseScale(source);
        Check(Mathf.Abs(response - 1f) < .0001f, label + "以相同境界验证真实器官维持", new
        {
            sourcePower = source.GetExtend().GetPowerLevel(), targetPower = target.GetExtend().GetPowerLevel(),
            response
        });
    }

    if (hoveringTarget && targetMotion == "reach") part = "hand.right";
    var d = PartAction(part,
        part.StartsWith("shoulder") || part == "head" ? BodyRelationKind.Brace : BodyRelationKind.Grab);
    if (targetTransition != "" || targetMotion != "") d.Cooldown = 10f;
    if (hoveringTarget && targetMotion != "reach")
    {
        // 自然悬浮继续推进，以真正的短促动作检查动态目标，不冻结目标的悬浮输入。
        foreach (BodyMotionKey key in d.Body.Keys) key.At *= .25f;
        d.Body.ReleaseAt *= .25f; d.Body.ActiveFrom *= .25f; d.Body.ActiveUntil *= .25f; d.Lifetime *= .25f;
    }
    if (targetMotion == "reach")
    {
        foreach (BodyMotionKey key in d.Body.Keys)
            key.Support ??= new BodySupportMotion { LeftFoot = new[] { 0f, -.1f, 0f }, RightFoot = new[] { 0f, .1f, 0f } };
        d.Body.Construction.Relations.Single().ControlStrength = 100f;
        d.Body.Construction.Footwork = new ConstructionPath { Forward = null, Keys = new[]
        {
            new ConstructionPathKey { At = 0f, Point = new float[3] },
            new ConstructionPathKey { At = 1.1f, Point = new float[3] },
            new ConstructionPathKey { At = 1.4f, Point = new[] { -.8f, 0f, 0f } },
            new ConstructionPathKey { At = 2f, Point = new[] { -.8f, 0f, 0f } }
        }};
    }
    if (targetParts) d.Body.MatchDistance = true;
    if (targetTransition != "" || targetMotion != "")
    {
        // 本组隔离身体与移动状态；使用实际同阵营零伤害接触，避免普通战斗AI改写个人敌意。
        target.setKingdom(source.kingdom);
        source.finishAngryStatus(); source.clearAttackTarget();
        target.finishAngryStatus(); target.clearAttackTarget();
        d.Body.Impact.Targets = SkillUseTargetRelation.Friendly;
        d.Impact = new ConstructionImpact { DamageScale = 0f, Targets = SkillUseTargetRelation.Friendly };
    }
    // 本组按实际高低用掌部或足部核对器官目标，转身和重心动作由其他场景覆盖。
    if (selection.StartsWith("organ:"))
        foreach (var key in d.Body.Keys)
        {
            key.Torso = new float[3];
            key.Rotation = new float[3];
            key.Turn = key.Heading = 0f;
            if (part.StartsWith("hand.")) key.Support = null;
        }

    d.Id += "." + species + "." + selection.Replace(':', '.');
    d.Body.Construction.Parts.Single(p => p.Subject == BodyPartSubject.Target).Part = selection;
    var plan = AbilityCompiler.Compile(d, false);
    object binding = null;
    await Game.WaitUntil(() => (binding = Binding(source, plan)) != null, 300);
    Check(binding != null, label + "实际身体绑定可用");
    BodyFrame numeric = Frame(binding, source);
    float heldAge = plan.Body.ActiveFrom + .15f;
    BodyPose contactPose = plan.Body.Sample(heldAge, numeric);
    BodyPose pinned = plan.Body.Sample(heldAge + .2f,
        numeric.WithPoseConstraint(new BodyPoseConstraint(heldAge)), previous: contactPose);
    Check(Vector3.Distance(pinned.EffectorPoint, contactPose.EffectorPoint) < .0001f &&
          Quaternion.Angle(pinned.EffectorRotation, contactPose.EffectorRotation) < .01f &&
          Mathf.Abs(pinned.WorldAge - heldAge - .2f) < .00001f &&
          Mathf.Abs(pinned.ActionAge - contactPose.ActionAge) < .00001f,
        label + "维持实际姿态，世界时限仍正常推进");
    BodyPose returned = plan.Body.Sample(heldAge + .2f,
        numeric.WithPoseConstraint(new BodyPoseConstraint(heldAge, 0f)));
    BodyPose free = plan.Body.Sample(heldAge + .2f, numeric);
    Check(Vector3.Distance(returned.EffectorPoint, free.EffectorPoint) < .0001f,
        label + "解除权重归零后回到原动作");

    // 用真实几何挑选可达站位；正式建立仍须走游戏施放与连续接触。
    object targetBinding = surfaceBindingType.GetMethod("Create", F).Invoke(null, new object[] { target });
    Check(targetBinding != null, label + "目标真实表面可用");
    object baseSurface = targetBinding.GetType().GetMethod("Sample", F).Invoke(targetBinding,
        new object[] { FootOf(target), HeightOf(target), World.world.getCurWorldTime() });
    var baseMatrices = (Matrix4x4[])Field(baseSurface, "Matrices");
    Vector3 targetFoot = FootOf(target), sourceFoot = FootOf(source);
    Vector3 searchFoot = targetParts
        ? sourceFoot + targetFoot -
          (Vector3)surfaceType.GetMethod("Aim", F).Invoke(baseSurface, new object[] { selection })
        : sourceFoot;
    // 龙的整身中心远高于人物；从现有真实表面的近侧选站位，不围绕整身包围盒中心造场景。
    if (species == "dragon")
        searchFoot = sourceFoot + targetFoot - (Vector3)surfaceType.GetMethod("Nearest", F).Invoke(baseSurface,
            new object[] { selection, sourceFoot + Vector3.forward * HeightOf(source) * .7f });
    Vector3 selectedFoot = default;
    Vector3 selectedOffset = default;
    object selectedFrame = null;
    float depth = -1f;
    float requiredDepth = hoveringTarget ? .02f : .005f;
    int candidates = 0;
    for (int x = 0; x < 17 && depth < requiredDepth; x++)
    for (int y = -6; y <= 6 && depth < requiredDepth; y++)
    {
        Vector3 candidate = searchFoot + (targetParts
            ? new Vector3((x - 8) * .08f, y * .08f, 0)
            : new Vector3(.02f + x * .04f, y * .04f, 0));
        candidate.z = NativeFoot(target).z + (placementGround?.Sample(candidate.x, candidate.y) ?? 0f);
        Vector3 direction = candidate - sourceFoot;
        direction.z = 0;
        object attempt = bindingType.GetMethod("TryCreate", F).Invoke(null,
            new object[] { source, plan.Body, direction.normalized, candidate, HeightOf(target) });
        if (attempt == null) continue;
        var movedMatrices = baseMatrices.Select(m => Matrix4x4.Translate(candidate - targetFoot) * m).ToArray();
        object moved = surfaceCtor.Invoke(new[]
        {
            Field(baseSurface, "Parts"), movedMatrices,
            (object)candidate, HeightOf(target), Field(baseSurface, "Heading")
        });
        if (targetParts)
            bindingType.GetMethod("AimAt", F).Invoke(attempt,
                new[]
                {
                    moved,
                    (object)PhysicalFrame(attempt, source), plan.Body.Construction.Relations.Single()
                });
        BodyFrame input = PhysicalFrame(attempt, source);
        var preview = new AbilityCast(plan, Matrix4x4.identity, input,
            new AbilityInputs(sourceFoot, candidate, direction.normalized, input.Height),
            terrain: placementGround);
        for (; preview.Age < plan.Body.ActiveUntil && depth < requiredDepth; preview.Advance(hoveringTarget ? .005f : .02f, candidate))
        {
            float age = preview.Age;
            BodyPose pose = preview.BodyPose.Value;
            var shapes = new List<AbilityCapsule>();
            bindingType.GetMethod("AppendContacts", F).Invoke(attempt, new object[] { pose, shapes });
            if (candidates == 0 && shapes.Count > 0)
            {
                var originalParts = ((IEnumerable)Field(baseSurface, "Parts")).Cast<object>()
                    .Where(p => (bool)p.GetType().GetMethod("Matches", F).Invoke(p, new object[] { selection }))
                    .ToArray();
                var vertices = originalParts.SelectMany((p, i) =>
                {
                    int index = (int)Field(p, "TransformIndex");
                    return ((Vector3[])Field(p, "Vertices")).Select(v =>
                        baseMatrices[index < 0 ? i : index].MultiplyPoint3x4(v));
                }).ToArray();
                observed.Add(new
                {
                    label, part, selection, species, age, shapes = shapes.Select(s => new
                        { a = new[] { s.A.x, s.A.y, s.A.z }, b = new[] { s.B.x, s.B.y, s.B.z }, s.Radius }),
                    min = new[] { vertices.Min(v => v.x), vertices.Min(v => v.y), vertices.Min(v => v.z) },
                    max = new[] { vertices.Max(v => v.x), vertices.Max(v => v.y), vertices.Max(v => v.z) }
                });
                File.WriteAllText(Path.Combine(folder, "position-probe.json"),
                    JsonConvert.SerializeObject(observed, Formatting.Indented));
            }

            foreach (var shape in shapes)
            {
                object[] args = { moved, moved, shape, shape, selection, 0f, null, Vector3.zero };
                if (!(bool)findSurface.Invoke(null, args)) continue;
                Vector3 point =
                    (Vector3)args[6].GetType().GetMethod("Point", F).Invoke(args[6], new[] { moved });
                Vector3 segment = shape.B - shape.A;
                Vector3 nearest = shape.A + segment * (segment.sqrMagnitude == 0
                    ? 0f
                    : Mathf.Clamp01(Vector3.Dot(point - shape.A, segment) / segment.sqrMagnitude));
                float overlap = shape.Radius - Vector3.Distance(nearest, point);
                if (overlap > depth)
                {
                    depth = overlap;
                    selectedFoot = candidate;
                    selectedOffset = (Vector3)Field(attempt, "aimOffset");
                    selectedFrame = DescribeFrame(input);
                }
            }
        }

        if (++candidates % 16 == 0) await Game.NextFrame();
    }

    Check(depth > .0001f, label + "存在由实际作用形状触及的站位", new
    {
        depth, candidates,
        position = new[] { selectedFoot.x, selectedFoot.y, selectedFoot.z },
        offset = new[] { selectedOffset.x, selectedOffset.y, selectedOffset.z }, frame = selectedFrame
    });
    Place(target, selectedFoot.x, selectedFoot.y);
    if (selection.StartsWith("organ:"))
    {
        float range = (float)service.GetMethod("Range", F, null,
                new[] { typeof(ActorExtend), typeof(CompiledAbility), typeof(BaseSimObject) }, null)
            .Invoke(null, new object[] { source.GetExtend(), plan, target });
        Check(Vector2.Distance(source.current_position, target.current_position) <= range &&
              !BodyControlState.IsBusy(target.id), label + "按实际器官外伸允许选择，未提前取得目标控制",
            new { range, d.TargetRange });
    }

    int start = relations.Count;
    Vector2 targetBefore = target.current_position;
    CombatStatusEffects.RemoveStatus(source, quiet);
    source.updateStats();
    source.cancelAllBeh();
    await Fire(d, source, target, aggro: targetTransition == "" && targetMotion == "");
    var targetCast = (AbilityCast)Field(((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>()
        .Single(c => ((AbilityCast)Field(c, "Cast")).Plan.Id == d.Id), "Cast");
    if (targetMotion == "moving")
    {
        var mobileStats = new BaseStats(); mobileStats.addTag("ignore_fights");
        var mobileStatus = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.Verify.Flying.Move")
            .SetStats(mobileStats).SetDuration(10000).Build();
        CombatStatusEffects.RemoveStatus(target, quiet);
        CombatStatusEffects.ApplyStatus(target, mobileStatus, 10000, target);
        target.updateStats(); target.cancelAllBeh();
        Vector2 away = (targetBefore - source.current_position).normalized;
        Vector2 outbound = targetBefore + away * 2f;
        target.moveTo(World.world.GetTileSimple((int)outbound.x, (int)outbound.y));
        target.next_step_position = outbound;
        await Advance(.08f);
        Check(target.is_moving && Vector2.Distance(target.current_position, targetBefore) > .001f &&
              !BodyControlState.IsBusy(target.id) && !relations.Skip(start).Any(r => r.State == ConstructedBodyConnectionState.Active),
            label + "起势时真实振翼移动，未提前锁定身体");
        Vector2 inbound = targetBefore - away * 2f;
        target.moveTo(World.world.GetTileSimple((int)inbound.x, (int)inbound.y));
        target.next_step_position = inbound;
    }
    Config.paused = false;
    var path = new List<object>();
    float pathAge = -1f;

    bool Established()
    {
        object running = ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>()
            .FirstOrDefault(c => (long)Field(c, "SourceId") == source.id);
        if (running != null)
        {
            var cast = (AbilityCast)Field(running, "Cast");
            if (cast.BodyPose.HasValue && cast.Age >= pathAge + .04f)
            {
                pathAge = cast.Age;
                var shapes = new List<AbilityCapsule>();
                var idealShapes = new List<AbilityCapsule>();
                var actualFrame = (BodyFrame)Field(cast, "bodyFrame");
                BodyPose ideal = cast.Plan.Body.Sample(cast.Age, actualFrame);
                bindingType.GetMethod("AppendContacts", F).Invoke(Field(running, "Body"),
                    new object[] { ideal, idealShapes });
                bindingType.GetMethod("AppendContacts", F).Invoke(Field(running, "Body"),
                    new object[] { cast.BodyPose.Value, shapes });
                object[] actualSurface = { target.id, null, null };
                bool hasSurface = (bool)service.GetMethod("TryGetBodySurface", F).Invoke(null, actualSurface);
                Vector3 aim = hasSurface
                    ? (Vector3)surfaceType.GetMethod("Aim", F)
                        .Invoke(actualSurface[2], new object[] { selection })
                    : Vector3.zero;
                bool overlap = hasSurface && shapes.Any(s => (bool)findSurface.Invoke(null,
                    new object[]
                        { actualSurface[2], actualSurface[2], s, s, selection, 0f, null, Vector3.zero }));
                object authority = Field(running, "InitialOwner");
                bool matches = (bool)authority.GetType().GetMethod("Matches", F)
                    .Invoke(authority, new object[] { plan.Body.Impact.Targets, target });
                path.Add(new
                {
                    age = cast.Age, hasSurface, overlap, matches,
                    controlled = Field(running, "BodyControlled"),
                    frame = DescribeFrame(actualFrame),
                    window = new[] { cast.Plan.Body.ActiveFrom, cast.Plan.Body.ActiveUntil },
                    offset = new[]
                        { actualFrame.AimOffset.x, actualFrame.AimOffset.y, actualFrame.AimOffset.z },
                    ideal = idealShapes.Select(s => new
                    {
                        a = new[] { s.A.x, s.A.y, s.A.z },
                        b = new[] { s.B.x, s.B.y, s.B.z }, s.Radius
                    }),
                    aim = new[] { aim.x, aim.y, aim.z }, shapes = shapes.Select(s => new
                        { a = new[] { s.A.x, s.A.y, s.A.z }, b = new[] { s.B.x, s.B.y, s.B.z }, s.Radius })
                });
            }
        }

        return relations.Count > start || targetCast.Finished;
    }

    try
    {
        await Game.WaitUntil(Established, 900);
    }
    finally
    {
        File.WriteAllText(Path.Combine(folder, "actual-path-" + label.Replace(':', '.') + ".json"),
            JsonConvert.SerializeObject(path, Formatting.Indented));
    }

    Config.paused = true;
    await Game.WaitUntil(Boundary, 600);
    Check(relations.Count > start, label + "在正式动作结束前实际接触");
    var began = relations[start];
    Check(began.State == ConstructedBodyConnectionState.Active, label + "真实接触后建立原地关系",
        relations.Skip(start).Select(r => new { r.State, r.Reason }));
    await Advance(hoveringTarget ? .025f : .1f);
    var active = ConstructedAbilityService.GetBodyConnections().SingleOrDefault(c => c.CastId == began.CastId);
    Check(active.CastId == began.CastId && Vector3.Distance(active.SourcePoint, active.TargetPoint) < .0001f &&
          (targetMotion == "moving" || target.current_position == targetBefore) && active.Remaining < began.Remaining,
        label + "两端真实位置一致且持续消耗预算", relations.Skip(start).Select(r => new { r.State, r.Reason }));
    if (selection is "organ:yao.horn.thunder" or "organ:yao.crown.tails")
    {
        var struggle = Action("held-organ." + label.Replace(':', '.'), BodyRelationKind.Touch);
        struggle.TargetRange = 10f;
        struggle.Body.Construction.Parts.Single(p => p.Subject == BodyPartSubject.Source).Part = selection;
        struggle.Body.Construction.Relations.Single().FromAnchor = "organ";
        foreach (BodyMotionKey key in struggle.Body.Keys)
        {
            key.Hand = key.Torso = key.Rotation = new float[3];
            key.Turn = key.Heading = 0f;
            key.Support = null;
            key.PartAngle = key.At * 20f;
        }

        CompiledAbility strugglePlan = AbilityCompiler.Compile(struggle, false);
        Check((bool)bindingType.GetMethod("CanBind", F).Invoke(null,
                new object[] { target.GetExtend(), strugglePlan.Body }),
            label + "被抓住的真实器官仍有有效出招绑定，没有用缺失资源冒充占用拒绝");
        ConstructedAbilityService.Register(struggle);
        ConstructedAbilityService.Learn(target.GetExtend(), struggle.Id);
        CombatStatusEffects.RemoveStatus(target, quiet);
        target.updateStats();
        target.attack_timer = 0;
        Check(BodyControlState.IsBusy(target.id, strugglePlan.Body.Occupancy) &&
              !(bool)service.GetMethod("CanStartBody", F).Invoke(null,
                  new object[] { target.GetExtend(), struggle.Id }) &&
              !ActiveAbilityService.TryUse(target.GetExtend(),
                  new ActiveAbilityHandle("content.constructed", target.GetExtend().E, struggle.Id),
                  new ActiveAbilityTarget(source, source.GetSimPos()), ActiveAbilityUseOrigin.Script),
            label + "真实抓持期间正式器官动作不能夺走身体控制");
        var heldAfterAttempt = ConstructedAbilityService.GetBodyConnections()
            .Single(c => c.CastId == active.CastId);
        Check(Vector3.Distance(heldAfterAttempt.SourcePoint, active.SourcePoint) < .0001f &&
              Vector3.Distance(heldAfterAttempt.TargetPoint, active.TargetPoint) < .0001f &&
              target.current_position == targetBefore,
            label + "被拒绝的真实出招没有移动人物或破坏双方固定点");
        Quiet(target);
    }

    if (worldfall != null)
        await Pair(source, label.Replace(':', '.'), 0, true);
    else
    {
        World.world.camera.transform.position =
            new Vector3(target.current_position.x, target.current_position.y + .5f, 0);
        MoveCamera.instance.forceZoom(1.5f);
        World.world.console.Hide();
        Tooltip.hideTooltipNow();
        for (int frameIndex = 0; frameIndex < 10; frameIndex++) await Game.NextFrame();
        string picture = Path.Combine(folder, "movies", label.Replace(':', '.'), "native");
        Directory.CreateDirectory(picture);
        Screen.Capture(Path.Combine(picture, "00000.png"));
        for (int frameIndex = 0; frameIndex < 4; frameIndex++) await Game.NextFrame();
        ActorManager manager = World.world.units;
        int visibleIndex = Enumerable.Range(0, manager.visible_units.count)
            .Single(i => manager.visible_units.array[i] == target);
        object[] published = { target.id, null, null };
        service.GetMethod("TryGetBodySurface", F).Invoke(null, published);
        Sprite fixedImage = (Sprite)published[1].GetType().GetMethod("PinnedSprite", F).Invoke(published[1], new[] { published[2] });
        Check(manager.render_data.has_normal_render[visibleIndex] &&
              manager.render_data.main_sprite_colored[visibleIndex] == fixedImage,
            label + "接触读取的最终合成帧就是原版实际绘制帧");
    }

    // 每个三维场景都完成实际绘制；关闭三维镜头后留下的旧模型不是当前显示证据。
    CheckSurface(target, active, label);
    if (targetMotion == "moving")
    {
        CheckMovingContact(active, label);
        Check(!target.is_moving && BodyControlState.IsBusy(target.id), label + "移动中真实接触后才停止原移动");
        Quiet(target);
    }
    if (targetTransition != "")
    {
        Vector2 originalPosition = target.current_position;
        object[] pinnedTarget = { target.id, null, null };
        service.GetMethod("TryGetBodySurface", F).Invoke(null, pinnedTarget);
        if (targetTransition == "dragon-state")
            target.getActorComponent<Dragon>().setFrames(DragonState.SleepUp, true);
        else target.setFlying(targetTransition == "takeoff");
        Check(target.current_position == originalPosition &&
              (string)surfaceBindingType.GetProperty("ChangedReason", F).GetValue(pinnedTarget[1]) == "BodyChanged",
            label + "实际状态改变使旧固定表面失效");
        await Advance(.01f);
        var releases = relations.Skip(start).Where(r => r.CastId == began.CastId && r.State == ConstructedBodyConnectionState.Released).ToArray();
        Check(releases.Length == 1 && releases[0].Reason == "BodyChanged" &&
              !BodyControlState.IsBusy(target.id) && target.current_position == originalPosition,
            label + "切换实际状态后只解除一次且不拉回目标", new { targetTransition, reasons = releases.Select(r => r.Reason) });
    }
    if (selection.StartsWith("organ:"))
    {
        object[] snapshot = { target.id, null, null };
        service.GetMethod("TryGetBodySurface", F).Invoke(null, snapshot);
        var actualParts = ((IEnumerable)Field(snapshot[2], "Parts")).Cast<object>().ToArray();
        object running = ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>()
            .Single(c => (long)Field(c, "Id") == began.CastId);
        int picked = (int)Field(Field(Field(running, "Connection"), "Anchor"), "Part");
        Check((bool)actualParts[picked].GetType().GetMethod("Matches", F)
                .Invoke(actualParts[picked], new object[] { selection }),
            label + "接触固定在指定实际器官三角面，不借用躯干");
        string replaced = species == "fox" ? "part:tail" : species == "penguin" ? "part:wing_" : null;
        if (replaced != null)
            Check(actualParts
                    .Where(p => ((string)Field(p, "Id")).StartsWith(replaced, StringComparison.Ordinal))
                    .All(p => ((int[])Field(p, "Triangles")).Length == 0),
                label + "被升级器官替换的原部件不再参与接触");
        string changedReason;
        if (worldfall == null && species == "turtle")
        {
            CreatureAppearanceService.InvalidateResources();
            changedReason = "AppearanceResourceChanged";
        }
        else
        {
            Check(YaoFormPlanService.TrySetOrgans(target.GetExtend(), YaoFormIds.TrueForm, new[]
            {
                new YaoOrganRecord
                {
                    SlotId = YaoContent.Slots.Surface,
                    OrganId = selection == "organ:yao.scale.basic" ? "yao.fur.moonlight" : "yao.scale.basic",
                    Rank = selection == "organ:yao.scale.basic" ? 2 : 1,
                    Origin = YaoOrganOrigin.Innate
                },
                new YaoOrganRecord
                {
                    SlotId = YaoContent.Slots.Head, OrganId = "yao.spirit.sense", Rank = 1,
                    Origin = YaoOrganOrigin.Innate
                }
            }), label + "实际移除接触器官");
            changedReason = "OrgansChanged";
        }

        await Advance(.1f);
        Check(relations.Skip(start).Any(r =>
                  r.State == ConstructedBodyConnectionState.Released && r.Reason == changedReason) &&
              !BodyControlState.IsBusy(target.id), label + "实际外观变化解除旧固定点并归还控制", new { changedReason });
    }

    if (targetParts && species == "bear")
    {
        // 控制输入为已确认地表快照，原关系仍由真实施放取得；不直接修改关系或凭据。
        object engine = service.GetField("simulation", F).GetValue(null);
        var original = (AbilityHeightField)Field(engine, "terrain");
        var changed = original.WithRegion(new Rect(62, 70, 5, 5), (x, y) => original.Sample(x, y) + .004f);
        engine.GetType().GetMethod("ApplyTerrain", F).Invoke(engine, new object[] { changed });
        Check(relations.Skip(start).Any(r => r.State == ConstructedBodyConnectionState.Released &&
                                             r.Reason == "TerrainChanged") &&
              !BodyControlState.IsBusy(target.id),
            "真实接触后地表数值快照升高0.004格，零时长重采样前归还双方关系");
    }

    await Advance(2.1f);
    if (targetMotion == "reach")
        Check(relations.Skip(start).Count(r => r.CastId == began.CastId && r.State == ConstructedBodyConnectionState.Released && r.Reason == "OutOfReach") == 1,
            label + "来源真实退步后因超出肢体可达而解除");
    if (selection.StartsWith("organ:") || hoveringTarget && worldfall != null)
    {
        Check(
            endings.Any(e =>
                e.Fact.CastId == began.CastId && !e.Fact.Cancelled && e.Fact.Age >= d.Lifetime - .0001f),
            label + "本次正式动作确实按时完成");
        // 本次动作已自然结束；关闭夹具人物后来自动补出的普通掌击，供下一场独立核对。
        Quiet(source);
        await Advance(.1f);
    }

    Check(
        !BodyControlState.IsBusy(target.id) &&
        !ConstructedAbilityService.GetBodyConnections().Any(c => c.CastId == began.CastId),
        label + "按真实时限归还双方控制");
    if (addedGiant)
    {
        source.removeTrait("giant"); source.setStatsDirty(); source.updateStats(); source.finishScale();
    }
}

Check(executedBodyCases > 0 && (selectedTargets.Length == 0 || executedBodyCases == selectedTargets.Distinct().Count()),
    "实际执行全部指定身体场景，不以公共准备检查代替场景", new { executedBodyCases, selectedTargets });
File.WriteAllText(Path.Combine(folder, "observed.json"),
    JsonConvert.SerializeObject(observed, Formatting.Indented));
return new { passed = true, cases = executedBodyCases, checks = checks.Count };
