string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/city-constructions");Directory.CreateDirectory(folder);var previewTimes=new List<double>();var checks=new List<string>();void Check(bool ok,string name){if(!ok)throw new InvalidOperationException(name);checks.Add(name);Log.Info(name);}var rt=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=rt.GetProperty("Instance").GetValue(null);async Task Boundary()=>await Game.WaitUntil(()=>(bool)rt.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);async Task Advance(float seconds){Config.paused=false;double end=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=end,3600);Config.paused=true;await Boundary();}
Config.paused=true;Game.Resume();ControllableUnit.clear(false);Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();World.world.console.Hide();foreach(var screen in Resources.FindObjectsOfTypeAll<LoadingScreen>())screen.gameObject.SetActive(false);foreach(var old in World.world.units.getSimpleList().ToArray())old.dieAndDestroy(AttackType.Other);for(int y=55;y<=100;y++)for(int x=45;x<=110;x++){var t=World.world.GetTileSimple(x,y);if(t.building!=null)t.building.removeBuildingFinal();t.setTileTypes(TileLibrary.soil_low,TopTileLibrary.grass_low);t.burned_stages=0;t.heat=0;}
var holdStats=new BaseStats();holdStats.addTag("frozen_ai");holdStats.addTag("immovable");var hold=Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.CityConstructionHold")??Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.CityConstructionHold").SetStats(holdStats).SetDuration(10000).Build();var actor=World.world.units.createNewUnit("human",World.world.GetTileSimple(60,72),pAdultAge:true,pSpawnWithItems:false);actor.addTrait("super_health");CombatStatusEffects.ApplyStatus(actor,hold,10000,actor);var owner=actor.GetExtend();owner.AddComponent(new Xian{level=2,wakan=200});owner.MarkCultiwayStatsDirty();actor.setStatsDirty();actor.updateStats();await Advance(.1f);actor.joinLanguage(World.world.languages.newLanguage(actor,true));actor.setCulture(World.world.cultures.newCulture(actor,true));World.world.kingdoms.makeNewCivKingdom(actor);bool originalBuild=DebugConfig.isOn(DebugOption.SystemBuildTick);DebugConfig.setOption(DebugOption.SystemBuildTick,false);var city=World.world.cities.buildNewCity(actor,actor.current_tile.zone);actor.joinCity(city);for(int y=65;y<=90;y+=2)for(int x=55;x<=90;x+=2)city.addZone(World.world.GetTileSimple(x,y).zone);city.recalculateNeighbourZones();
AbilityDefinition Def(string name)=>new(){Id="test.city-constructions."+name,Name="城市构造·"+name,Resource="wakan",Cost=3,Cooldown=1,Lifetime=.5f,TargetRange=16,Power=0,Use=new ConstructionUse{Channels=ActiveAbilityChannel.World,Target=ActiveAbilityTargetMode.Point},Impact=new ConstructionImpact{DamageScale=0,WorldEffects=new[]{new ConstructionWorldEffect{Action="land.cleanse"}}},Root=new ConstructionNode{Id="surface",Form="sword",Matter="iron",Rotation=new[]{0f,90f,0f},ActiveFrom=.1f}};
var asm=typeof(ConstructedAbilityService).Assembly;var resolver=asm.GetType("Cultiway.Content.CollectiveProjects.MagicUtilitySpellResolver");var rules=asm.GetType("Cultiway.Content.CollectiveProjects.CityMagicUtilityProjectRules");var saveType=asm.GetType("Cultiway.Content.Persistence.CollectiveProjectSaveContent");JObject Payload(object p)=>(JObject)saveType.GetMethod("Capture",F).Invoke(null,new[]{p});JObject Projects()=>JObject.FromObject(typeof(CollectiveProjectService).GetMethod("CaptureWorldSave",F).Invoke(null,new object[]{(Func<object,JObject>)Payload}));var previewMethod=typeof(ConstructedAbilityService).GetMethod("TryPreviewWorld",F);var optionMethod=resolver.GetMethod("TryCreateOption",F);
Dictionary<string,HashSet<int>> Preview(AbilityDefinition d,Vector3 point){var args=new object[]{owner,AbilityCompiler.Compile(d),point,null};var timer=System.Diagnostics.Stopwatch.StartNew();bool ok=(bool)previewMethod.Invoke(null,args);previewTimes.Add(timer.Elapsed.TotalMilliseconds);Check(ok,"完整数值预估："+d.Id);return (Dictionary<string,HashSet<int>>)args[3].GetType().GetField("Tiles",F).GetValue(args[3]);}
void Dirty(int y){for(int x=63;x<=69;x++){var t=World.world.GetTileSimple(x,y);t.setBurnedStage(15);World.world.burned_layer.setTileDirty(t);}}
var starts=new List<ConstructedCastStarted>();var ends=new List<ConstructedCastEnded>();var contacts=new List<ConstructedWorldContact>();void Started(ConstructedCastStarted e){if(e.SourceId==actor.id)starts.Add(e);}void Ended(ConstructedCastEnded e){if(e.SourceId==actor.id)ends.Add(e);}void Contact(ConstructedWorldContact e){if(e.SourceId==actor.id)contacts.Add(e);}ConstructedAbilityService.CastStarted+=Started;ConstructedAbilityService.CastEnded+=Ended;ConstructedAbilityService.WorldContactConfirmed+=Contact;var states=new List<object>();try{
Check(!owner.HasCultisys<Magic>(),"实际城市工人只有修仙资源，没有魔法职业或法杖");var clean=Def("clean");ConstructedAbilityService.Register(clean);ConstructedAbilityService.Learn(owner,clean.Id);Dirty(72);var point=new Vector3(64.5f,72.5f,0);float before=owner.GetComponent<Xian>().wakan;var expected=Preview(clean,point);Check(expected["land.cleanse"].Count>=3&&Enumerable.Range(63,7).All(x=>World.world.GetTileSimple(x,72).burned_stages>0)&&starts.Count==0&&contacts.Count==0&&owner.GetComponent<Xian>().wakan==before,"预估只读真实形状，不改地块、不支付、不发布开始或世界结果");Check(ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,clean.Id),new ActiveAbilityTarget(null,point),ActiveAbilityUseOrigin.Script),"普通构造正式入口支付并受理");Check(Math.Abs(owner.GetComponent<Xian>().wakan-(before-3))<.001,"实际城市候选使用原有真元费用");await Advance(.8f);var actual=new HashSet<int>(contacts.Where(e=>e.AbilityId==clean.Id).Select(e=>World.world.GetTileSimple(e.X,e.Y).tile_id));Check(actual.SetEquals(expected["land.cleanse"]),"预估与正式运行的薄刃地块足迹一致");Check(ends.Count==1&&ends[0].WorldChanges==actual.Count,"实际结束事实包含真实提交而非圆形估算");
var high=Def("high");var highPreview=Preview(high,new Vector3(64.5f,74.5f,5));Check(highPreview.Count==0,"高空薄刃不会按包围圆冒充地面覆盖");var miss=Def("offset");miss.Root.Offset=new[]{0f,5f,0f};Dirty(74);Check(Preview(miss,new Vector3(64.5f,74.5f,0)).Count==0,"偏移后的实际刃面不会凭目标圆获得收益");
var quota=Def("quota");quota.Impact.WorldEffects[0].Contact=new ConstructionContactPolicy{MaximumTotal=2};Dirty(76);Check(Preview(quota,new Vector3(64.5f,76.5f,0))["land.cleanse"].Count==2,"预估遵守全次地块次数，不把未获额度的地块算作收益");
await Advance(.4f);foreach(var d in new[]{clean,quota}){ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(owner,d.Id);}var optionsType=typeof(List<>).MakeGenericType(asm.GetType("Cultiway.Content.CollectiveProjects.MagicUtilitySpellOption"));var options=(IList)Activator.CreateInstance(optionsType);resolver.GetMethod("CollectCityOptions",F).Invoke(null,new object[]{city,SkillSemantics.Effect.Cleanse,true,options});Check(options.Count==2,"同一修士的两个不同构造不会按人物实体编号错误合并");
var mixed=Def("clean-mature");mixed.Impact.WorldEffects=new[]{new ConstructionWorldEffect{Action="land.cleanse"},new ConstructionWorldEffect{Action="crop.mature"}};ConstructedAbilityService.Register(mixed);ConstructedAbilityService.Learn(owner,mixed.Id);bool Option(AbilityDefinition d,Cultiway.Core.Semantics.SemanticAsset semantic){var args=new object[]{owner,new ActiveAbilityHandle("content.constructed",owner.E,d.Id),semantic,null};return (bool)optionMethod.Invoke(null,args);}Check(Option(mixed,SkillSemantics.Effect.Cleanse)&&Option(mixed,SkillSemantics.Effect.Fertilize),"复合净化与催熟按各自实际原理进入相应城市需求");var unsafeAbility=Def("fill");unsafeAbility.Impact.WorldEffects=new[]{new ConstructionWorldEffect{Action="land.cleanse"},new ConstructionWorldEffect{Action="water.fill"}};ConstructedAbilityService.Register(unsafeAbility);ConstructedAbilityService.Learn(owner,unsafeAbility.Id);Check(!Option(unsafeAbility,SkillSemantics.Effect.Cleanse),"附带未评价注水的构造不因有净化作用便投入城市工作");
void Rejected(string name,Action<AbilityDefinition> change){var d=Def(name);change(d);ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(owner,d.Id);Check(!Option(d,SkillSemantics.Effect.Cleanse),"城市拒绝未评价的副作用："+name);}
Rejected("attack",d=>d.Power=10);Rejected("force",d=>d.Impact.Force=5);Rejected("barrier",d=>d.Root.ContactRole=ConstructionContactRole.Barrier);Rejected("residue",d=>d.Root.Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Leave,At=.1f,Residue=new ConstructionResidue{Lifetime=10}}});
// 三种既有日常需求仍使用同一候选和评价入口，不按视觉包围圆计收益。
float Utility(AbilityDefinition d,string goal,SemanticAsset semantic,int row){ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(owner,d.Id);var args=new object[]{owner,new ActiveAbilityHandle("content.constructed",owner.E,d.Id),semantic,null};Check((bool)optionMethod.Invoke(null,args),"世界原理进入城市候选："+d.Id);var type=asm.GetType("Cultiway.Content.CollectiveProjects.CityMagicUtilityProjectPayload");var payload=Activator.CreateInstance(type);type.GetField("Goal").SetValue(payload,Enum.Parse(type.GetField("Goal").FieldType,goal));type.GetField("EffectSemantic").SetValue(payload,semantic);object allowed=rules.GetMethod("CollectAllowedTileIds",F).Invoke(null,new object[]{city});var evaluateArgs=new[]{args[3],World.world.GetTileSimple(64,row),payload,allowed,null};return (float)resolver.GetMethod("EvaluateOption",F).Invoke(null,evaluateArgs);}
var cropTile=World.world.GetTileSimple(65,84);cropTile.setTileTypes(TileLibrary.soil_low,TopTileLibrary.field);var crop=World.world.buildings.addBuilding("wheat",cropTile);crop.data.grow_time=-1000;var mature=Def("mature");mature.Impact.WorldEffects[0].Action="crop.mature";Check(Utility(mature,"CropFertilization",SkillSemantics.Effect.Fertilize,84)==1&&!crop.component_wheat.isMaxLevel(),"城市催熟评价只读实际未熟麦田，不把预估当作成熟");var grow=Def("grow");grow.Root.Scale=2;grow.Impact.WorldEffects[0].Action="nature.grow";Check(Utility(grow,"NatureGrowth",SkillSemantics.Effect.Growth,86)>=8,"植被工作按实际生成候选足迹评价");var lower=Def("lower");lower.Root.Scale=2;lower.Impact.WorldEffects[0].Action="terrain.lower";var terrainInput=new[]{TileLibrary.mountains,TileLibrary.hills,TileLibrary.soil_high,TileLibrary.soil_low}.First(t=>!t.can_build_on&&t.decrease_to?.can_build_on==true);for(int y=87;y<=89;y++)for(int x=63;x<=73;x++)World.world.GetTileSimple(x,y).setTileTypes(terrainInput,null);Check(Utility(lower,"HousingTerrain",SkillSemantics.Effect.LowerTerrain,88)>=6,"地形工作按实际刃面的一步变化评价可建设增益");lower.Id+=".repeat";lower.Impact.WorldEffects[0].Contact=new ConstructionContactPolicy{Mode=ConstructionContactMode.Interval,Interval=.1f};ConstructedAbilityService.Register(lower);ConstructedAbilityService.Learn(owner,lower.Id);Check(!Option(lower,SkillSemantics.Effect.LowerTerrain),"重复地形作用没有逐步预测时不以一步收益投入城市");
// 只保留真实已学清理术，之后不调用发布、认领或施放接口。
clean.TargetRange=3;ConstructedAbilityService.Register(clean);owner.AddComponent(new ConstructedKnowledge{Ids=new[]{clean.Id}});for(int y=55;y<=100;y++)for(int x=45;x<=110;x++){var t=World.world.GetTileSimple(x,y);t.burned_stages=0;t.heat=0;}Dirty(78);int startCount=starts.Count;bool moved=false;CombatStatusEffects.RemoveStatus(actor,hold);actor.setStatsDirty();actor.updateStats();for(int i=0;i<30;i++){await Advance(1);moved|=(actor.current_position-new Vector2(60.5f,72.5f)).sqrMagnitude>1;var data=Projects();states.Add(new{second=i+1,position=new{x=actor.current_position.x,y=actor.current_position.y},projects=data["Projects"],history=data["History"].Count()});if(data["History"].Any(h=>(long)h["OwnerId"]==city.id&&(string)h["Tag"]=="clean.emergency"))break;}
var autos=starts.Skip(startCount).Where(s=>s.Origin==ActiveAbilityUseOrigin.Autonomous).ToArray();File.WriteAllText(Path.Combine(folder,"autonomy.json"),JsonConvert.SerializeObject(new{states,autos,ends,contacts},Formatting.Indented));Check(autos.Length>0&&autos.All(s=>s.AbilityId==clean.Id&&s.CorrelationId>0),"修士自主认领城市真实净化工程，并以执行令牌施放原术");Check(Projects()["History"].Any(h=>(long)h["OwnerId"]==city.id&&(string)h["Tag"]=="clean.emergency"),"实际地块危害下降，原城市工程验收并写入完成历史");Check(moved,"原版行为完成真实寻位移动，脚本没有传送执行者");
CombatStatusEffects.ApplyStatus(actor,hold,10000,actor);actor.setStatsDirty();actor.updateStats();for(int y=55;y<=100;y++)for(int x=45;x<=110;x++){var t=World.world.GetTileSimple(x,y);t.burned_stages=0;t.heat=0;}await Advance(2);int idle=starts.Count;CombatStatusEffects.RemoveStatus(actor,hold);actor.setStatsDirty();actor.updateStats();await Advance(3);Check(starts.Count==idle,"需求消失后不继续空放或重复支付");CombatStatusEffects.ApplyStatus(actor,hold,10000,actor);actor.setStatsDirty();actor.updateStats();clean.Root.Scale=3;ConstructedAbilityService.Register(clean);for(int x=63;x<=77;x++){var t=World.world.GetTileSimple(x,80);if(t.building!=null)t.building.removeBuildingFinal();t.setTileTypes(TileLibrary.soil_low,TopTileLibrary.wasteland_low);}await Advance(2);var planned=Projects()["Projects"].FirstOrDefault(p=>(long)p["OwnerId"]==city.id&&(int)p["State"]==(int)CollectiveProjectState.Planned);Check(planned!=null&&planned["Payload"]["PlannedActionTileIds"].Any(),"再次发生需求时自主发布含实际足迹的待执行工程");var payload=(JObject)planned["Payload"];var restore=saveType.GetMethod("Restore",F);var restored=Payload(restore.Invoke(null,new object[]{payload}));Check(JToken.DeepEquals(payload["PlannedActionTileIds"],restored["PlannedActionTileIds"]),"新足迹资料可按现有正式区段恢复");var oldPayload=(JObject)payload.DeepClone();oldPayload.Remove("PlannedActionTileIds");oldPayload.Remove("PlannedFootprintTileIds");Check(!Payload(restore.Invoke(null,new object[]{oldPayload}))["PlannedActionTileIds"].Any(),"正式旧工程缺省新字段时保留旧圆形路径");var bad=(JObject)payload.DeepClone();bad["PlannedActionTileIds"]=new JArray(-1);bool rejected=false;try{restore.Invoke(null,new object[]{bad});}catch(TargetInvocationException e)when(e.InnerException is InvalidDataException){rejected=true;}Check(rejected,"损坏的足迹在读取边界拒绝，不进入地图索引");var save=SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));Check(save.actors_data.Any(a=>a.id==actor.id),"正式原版存档包含城市工人");var saves=Cultiway.ModClass.I.WorldSaves;File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,actor=actor.id,city=city.id,ability=clean.Id,project=(long)planned["Id"],world=saves.World.Capture(World.world,"city-constructions"),person=saves.Actors.Capture(owner,"city-constructions")},Formatting.Indented));var result=new{passed=true,checks,previewTimes,states,starts,ends,contacts,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{ConstructedAbilityService.CastStarted-=Started;ConstructedAbilityService.CastEnded-=Ended;ConstructedAbilityService.WorldContactConfirmed-=Contact;DebugConfig.setOption(DebugOption.SystemBuildTick,originalBuild);Config.paused=true;File.WriteAllText(Path.Combine(folder,"partial.json"),JsonConvert.SerializeObject(new{checks,states,starts,ends,contacts},Formatting.Indented));}
