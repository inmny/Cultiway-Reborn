// 读取实际发布资源；无网格只登记用途，不以空画面证明质量。
var records = new List<object>();
var failures = new List<string>();
string[] ids = JsonConvert.DeserializeObject<string[]>(File.ReadAllText(Path.Combine(folder, "ids.json")));
var disk = new HashSet<string>(ids, StringComparer.Ordinal);
var expected = new HashSet<string>(disk, StringComparer.Ordinal) { "fire_body" };
var missing = expected.Except(FormResources.Ids).ToArray();
if (missing.Length != 0) failures.Add("当前版本缺少发布形体：" + string.Join(",", missing));
foreach (string id in FormResources.Ids)
{
    var resource = FormResources.Load(id);
    var description = resource.Description;
    bool publishedFile = disk.Contains(id);
    if (description.Id != id || !publishedFile && string.IsNullOrEmpty(description.Structure.Generation?.Entry))
        failures.Add(id + " 缺少与实际编号一致的制作来源");
    var visual = new FormVisualInstance(resource, Matrix4x4.identity);
    if (resource.Meshes.Length != description.Parts.Length)
        failures.Add(id + " 的实际网格数与声明部件数不符");
    var parts = new List<object>();
    for (int index = 0; index < Math.Min(resource.Meshes.Length, description.Parts.Length); index++)
    {
        var part = description.Parts[index];
        string surface = visual.SurfaceFor(index);
        bool valid = surface == part.Surface && resource.Surface(surface, true) != null && resource.Surface(surface, false) != null;
        if (!valid || resource.Meshes[index].vertexCount < 3) failures.Add(id + "/" + part.Id + " 无有效表面或主体");
        Vector3 size = resource.Meshes[index].bounds.size;
        parts.Add(new { part.Id, part.Roles, surface, part.UseMatterSurface,
            size = new[] { size.x, size.y, size.z }, part.Skin, part.HasBuildData, part.DetailMeshes.Length });
    }
    records.Add(new { id, from = publishedFile ? "文件" : "运行时生成", kind = description.Structure.Kind, controls = description.Controls.Length,
        clips = description.Motions.Select(m => m.Id).ToArray(), contacts = description.Contacts.Length,
        ground = description.ConformToGround, changes = description.Structure.Changes,
        declaredParts = description.Parts.Length, parts });
}
File.WriteAllText(Path.Combine(folder, "catalog.json"), JsonConvert.SerializeObject(records, Formatting.Indented));
return new { passed = failures.Count == 0, version = FormResources.Version, count = records.Count, failures };
