// 同一片场地逐个核对正式法术，写档与冷读沿用同一对练。
var catalog = new[]
{
    (Asset: SkillEntities.WaterArrow, Form: "water_arrow", Count: 4),
    (Asset: SkillEntities.WaterOrb, Form: "water_orb", Count: 5),
    (Asset: SkillEntities.WaterBlade, Form: "water_blade", Count: 4),
    (Asset: SkillEntities.FlyingSword, Form: "flying_sword", Count: 2),
    (Asset: SkillEntities.SwordQi, Form: "sword_qi", Count: 2),
    (Asset: SkillEntities.GoldenNeedle, Form: "golden_needle", Count: 1),
    (Asset: SkillEntities.WindBullet, Form: "wind_bullet", Count: 2),
    (Asset: SkillEntities.WindBlade, Form: "wind_blade", Count: 2),
    (Asset: SkillEntities.ThunderOrb, Form: "thunder_orb", Count: 4),
    (Asset: SkillEntities.LightningSpear, Form: "lightning_spear", Count: 1),
    (Asset: SkillEntities.LightningStrike, Form: "lightning_strike", Count: 11),
    (Asset: SkillEntities.IceShard, Form: "ice_shard", Count: 1),
    (Asset: SkillEntities.IceLance, Form: "ice_lance", Count: 1),
    (Asset: SkillEntities.Icefall, Form: "icefall_rain", Count: 1)
}.Where(entry => chosenAssets.Contains(entry.Asset.id)).ToArray();

bool CanTestTracking(SkillEntityAsset asset) => asset == SkillEntities.WaterOrb || asset == SkillEntities.WindBullet || asset == SkillEntities.ThunderOrb;
bool cold = caseName == "cold", archive = caseName == "archive";
int process = System.Diagnostics.Process.GetCurrentProcess().Id;
var expected = cold ? JObject.Parse(File.ReadAllText(Path.Combine(archivePath, "expected.json"))) : null;
var source = cold ? World.world.units.get((long)expected["source"]) : Make(64);
var target = cold ? World.world.units.get((long)expected["target"]) : Make(70);
var second = cold ? World.world.units.get((long)expected["second"]) : Make(73);
var outside = cold ? World.world.units.get((long)expected["outside"]) : Make(71);
Check(source != null && target != null && second != null && outside != null, "同一对练人物就绪");
var enemyKingdom = World.world.kingdoms_wild.get(AssetManager.actor_library.get("wolf").kingdom_id_wild);
foreach (var actor in new[] { target, second, outside }) actor.setKingdom(enemyKingdom);
var owner = source.GetExtend();
if (!cold)
{
    owner.NewCultisys(Cultisyses.Xian);
    owner.GetCultisys<Xian>().level = 0;
    owner.MarkCultiwayStatsDirty();
    source.setStatsDirty();
    source.updateStats();
    await Advance(.20f);
}

Entity[] Learned() => ((IReadOnlyList<Entity>)typeof(ActorExtend).GetMethod("GetLearnedSkillsInOrder", F).Invoke(owner, null))
    .Where(entity => chosenAssets.Contains(entity.GetComponent<SkillContainer>().Asset.id)).ToArray();

Entity Learn(SkillEntityAsset asset, int index, bool tracking, float duration = 0f, bool fast = false)
{
    var builder = new SkillContainerBuilder(asset).UseAnimation(index);
    if (tracking) builder.AddModifier(new Trajectory { ID = SkillTrajectories.TowardsTarget.id });
    if (fast) builder.AddModifier(new HasteModifier { SpeedMultiplier = .6f });
    var made = builder.Build(SkillContainerBuildMode.RuleOnly);
    if (duration > 0f) made.AddComponent(new SkillSettings
        { Duration = duration, AreaMultiplier = 1, PowerMultiplier = 1, ContactEnabled = true });
    string signature = SkillContainerSignature.Build(made);
    owner.LearnSkillV3(made);
    return Learned().Single(value => SkillContainerSignature.Build(value) == signature);
}

string[] Signatures() => Learned().Select(SkillContainerSignature.Build).OrderBy(value => value, StringComparer.Ordinal).ToArray();
if (archive)
{
    foreach (var entry in catalog)
        for (int index = 0; index < entry.Count; index++)
            Learn(entry.Asset, index, CanTestTracking(entry.Asset) && index == 1);
    string[] signatures = Signatures();
    int total = catalog.Sum(entry => entry.Count);
    Check(signatures.Length == total && signatures.Distinct().Count() == total &&
          World.world.units.get(source.id) == source, "正式写档前全部原学习资料已入世界", total);
    string world = Path.Combine(folder, "archive");
    Directory.CreateDirectory(world);
    SaveManager.saveWorldToDirectory(world);
    Check(File.Exists(Path.Combine(world, "map.wbox")), "完整学习资料随原版世界保存");
    File.WriteAllText(Path.Combine(folder, "expected.json"),
        JsonConvert.SerializeObject(new { process, source = source.id, target = target.id, second = second.id,
            outside = outside.id, signatures }, Formatting.Indented));
    ConstructedAbilityService.CastEnded -= Ended;
    ConstructedAbilityService.ContactConfirmed -= Hit;
    return new { passed = true, process, world, skills = signatures.Length };
}
if (cold)
{
    Check(process != (int)expected["process"], "由另一个进程读取正式档");
    Check(Signatures().SequenceEqual(expected["signatures"].ToObject<string[]>()), "全部旧索引及保存的追踪资料完整读回");
}

var casts = new Dictionary<long, AbilityCast>();
var recordings = new List<object>();
var scatterCenters = new List<Vector2>();
int oldExecutions = 0;

void Started(ConstructedCastStarted fact)
{
    if (fact.SourceId != source.id || !chosenAssets.Contains(fact.AbilityId)) return;
    var running = ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>()
        .Single(value => (long)Field(value, "Id") == fact.CastId);
    casts.Add(fact.CastId, (AbilityCast)Field(running, "Cast"));
}

void LegacyExecution(Entity entity)
{
    if (chosenAssets.Contains(entity.GetComponent<SkillEntity>().Asset.id)) oldExecutions++;
}

FormVisualInstance[] Views(AbilityCast cast)
{
    var output = new List<FormVisualInstance>();
    cast.AppendVisuals(output);
    return output.ToArray();
}

int ShapeCount(AbilityCast cast)
{
    var shapes = new List<AbilityCapsule>();
    cast.AppendContacts(shapes);
    return shapes.Count;
}

float Seconds(SkillEntityAnimationClip clip, float inherited) =>
    clip == null ? 0f : clip.Frames.Length * clip.Settings.ResolveFrameInterval(inherited);

async Task Stage(AbilityCast cast, float until)
{
    if (cast.Age < until && !cast.Finished) await Advance(until - cast.Age);
}

async Task Play(SkillEntityAsset asset, string form, int index)
{
    bool icefall = asset == SkillEntities.Icefall, lightning = asset == SkillEntities.LightningStrike;
    bool sky = lightning || icefall;
    bool orb = asset == SkillEntities.WaterOrb, blast = asset == SkillEntities.ThunderOrb || sky;
    bool landing = caseName == "landing", cancelled = caseName == "cancel";
    bool fast = sky && landing && index == 0;
    bool blade = asset == SkillEntities.WaterBlade || asset == SkillEntities.SwordQi || asset == SkillEntities.WindBlade;
    bool continues = asset.ImpactProfile.ContinueAfterHit;
    bool tracking = CanTestTracking(asset) && (caseName == "tracking" || cold), miss = caseName == "miss";
    float timeout = blast && miss ? (icefall ? .012f : sky ? .15f : .115f) : 0f;
    var skill = cold ? Learned().Single(entity =>
    {
        var value = entity.GetComponent<SkillContainer>();
        return value.Asset == asset && value.AnimationIndex == index;
    }) : Learn(asset, index, tracking, timeout, fast);
    var container = skill.GetComponent<SkillContainer>();
    var animation = asset.GetAnimation(index);
    float interval = container.MotionProfile.FrameInterval;
    float rise = Seconds(animation.Appearance, interval), fade = Seconds(animation.Dissipation, interval);
    float runtime = timeout > 0f ? timeout : asset.ImpactProfile.Lifetime * asset.ImpactTuning.LifetimeMultiplier;
    string model = index == 0 && !lightning ? form : form + "_" + index;
    Check(container.AnimationIndex == index && (!tracking || SkillBlueprintTrajectory.ResolveEffectiveId(skill) == SkillTrajectories.TowardsTarget.id),
        "原已学关系保留指定索引和轨迹", new { model, tracking });

    Ready(source);
    Place(source, 64);
    Place(target, tracking ? 74f : continues ? 69f : orb || blast ? 71f : 72f,
        miss ? 77f : landing ? 71f : 72f);
    Place(second, blast ? 71.4f : orb && index == 4 && !tracking ? 71.04f : continues ? 73f : 75f,
        miss || tracking ? 78f : blast ? 73.1f : orb && index == 4 ? 72.48f : blade ? 72.78f : 72f);
    Place(outside, 70f, 78f);
    owner.GetCultisys<Xian>().wakan = source.stats[BaseStatses.MaxWakan.id] * .8f;
    foreach (var actor in new[] { source, target, second, outside }) ConstructedAbilityService.NotifyActorChanged(actor);
    float before = owner.GetCultisys<Xian>().wakan;
    int hp = target.data.health, hp2 = second.data.health, hpOutside = outside.data.health;
    double price = SkillCastResources.Wakan.Quote(owner,
        SkillCastCost.CalculateStepDemand(skill) * Mathf.Sqrt(SkillEffectRadius.ResolveCasterGrowth(owner, skill)));
    int previous = casts.Count;
    bool usePoint = miss || landing || sky;
    var point = usePoint
        ? new Vector3(sky && landing ? 71.35f : 71f, sky && landing ? 72.3f : 72f, source.GetSimPos().z)
        : target.GetSimPos();
    var aim = new ActiveAbilityTarget(usePoint ? null : target, point,
        selectionArea: new SkillTargetSelectionArea(!usePoint, point, .1f));
    Check(ActiveAbilityService.TryUse(owner, new ActiveAbilityHandle("core.learned_skill", skill),
        aim, ActiveAbilityUseOrigin.Player), "原已学入口受理", model);
    source.attack_timer = 999;
    CombatStatusEffects.ApplyStatus(source, hold, 10000, source);
    source.updateStats();
    await Advance(sky ? .026f : .08f);

    Check(casts.Count == previous + 1 && oldExecutions == 0, "只进入共同执行一次", model);
    var live = casts.Last();
    var cast = live.Value;
    if (sky) await Stage(cast, .04f);
    var initial = Views(cast).Single(view => view.Resource.Description.Id == model);
    Vector3 first = initial.Transform.GetColumn(3);
    bool water = form.StartsWith("water_", StringComparison.Ordinal);
    Check(initial.Resource.Description.Id == model && (!water || initial.Resource.Description.Parts.All(p => p.HasSurfaceData)) &&
          Math.Abs(cast.Plan.Lifetime - rise - runtime - fade) < .001f,
        "实际主体与原阶段时长对应", new { model, rise, runtime, fade });
    if (rise > 0f)
        Check(cast.Age < rise && (sky || Mathf.Abs(first.x - 64f) < .05f) && ShapeCount(cast) == 0 &&
              contacts.All(hit => hit.CastId != live.Key), "成形阶段没有人物作用面", model);
    if (sky)
    {
        await Stage(cast, fast ? .169f : (timeout > 0f ? .092f : .125f));
        var moving = Views(cast).Single(view => view.Resource.Description.Id == model);
        Vector3 flown = moving.Transform.GetColumn(3);
        float offset = Vector2.Distance(flown, point);
        Check((icefall ? offset <= 1.401f && Vector2.Distance(first, flown) < .03f : offset < .03f) &&
              first.z - flown.z > .2f &&
              (rise == 0f ? ShapeCount(cast) > 0 : ShapeCount(cast) == 0 && hp == target.data.health && cast.NodeAge(1) < 0f),
              "真实下落保留指定点，成形期间没有伤害", new { model, age = cast.Age, first = first.ToString(),
                  current = flown.ToString(), shapes = ShapeCount(cast) });
        if (icefall && !miss)
        {
            Place(target, flown.x - 1.05f, flown.y);
            Place(second, flown.x + 1.05f, flown.y + .55f);
            ConstructedAbilityService.NotifyActorChanged(target);
            ConstructedAbilityService.NotifyActorChanged(second);
        }
        if (fast)
        {
            object root = ((Array)Field(cast, "nodes")).GetValue(0);
            Check((bool)Field(root, "GroundEndPending") && Mathf.Abs(cast.Velocity(0).z) < .001f && cast.Age < rise,
                "加速后先真实着地，保持落点等待作用开始", new { model, age = cast.Age, point = flown.ToString() });
        }
    }
    else
    {
        await Stage(cast, rise + (timeout > 0f ? .038f : .082f));
        var moving = Views(cast).Single(view => view.Resource.Description.Id == model);
        Vector3 flown = moving.Transform.GetColumn(3);
        Check(flown.x > 64.08f && ShapeCount(cast) > 0 &&
              (!(orb || blast) || tracking || flown.z > source.GetSimPos().z + .45f),
            "飞行时有实际位移和作用面，球形弹体沿原弧线抬升",
            new { model, start = first.ToString(), position = flown.ToString(), shapes = ShapeCount(cast) });
    }
    if (cancelled)
    {
        cast.Cancel();
        await Advance(.24f);
        Check(cast.Finished && cast.NodeAge(1) < 0f && Views(cast).Length == 0 &&
              contacts.All(hit => hit.CastId != live.Key) && hp == target.data.health && hp2 == second.data.health,
              "空中取消后无爆发、接触和残留显示", model);
        recordings.Add(new { asset = asset.id, index, form = model, cancelled = true });
        return;
    }
    if (tracking)
    {
        Place(target, 74, 75.4f);
        ConstructedAbilityService.NotifyActorChanged(target);
    }

    Vector3? impact = null, rest = null, firstIcePiece = null;
    float? impactAt = null;
    if (blast && !miss)
    {
        Config.paused = false;
        await Game.WaitUntil(() => cast.NodeAge(1) >= 0f || cast.Finished, 1800);
        Config.paused = true;
        await Game.WaitUntil(Boundary, 1800);
        string impactForm = lightning ? "lightning_strike_impact" : icefall ? "icefall_impact" : "thunder_orb_impact";
        var pulse = Views(cast).Single(view => view.Resource.Description.Id == impactForm);
        impact = pulse.Transform.GetColumn(3);
        impactAt = cast.Age - cast.NodeAge(1);
        float expectedRadius = asset.ImpactProfile.EffectRadius * asset.ImpactTuning.EffectRadiusMultiplier *
            SkillEffectRadius.ResolveCasterGrowth(owner, skill);
        Check(cast.NodeAge(1) < .15f && Mathf.Abs(cast.RemainingForce(1) - 100f) < .001f &&
              Mathf.Abs(.9f * pulse.Transform.lossyScale.x - expectedRadius) < .001f,
            "真实爆发保留本体余力和原作用半径", new { model, actual = impact.ToString(), expectedRadius });
        if (icefall)
        {
            Check(Vector2.Distance(impact.Value, first) < .04f && Vector2.Distance(impact.Value, point) <= 1.401f &&
                  impactAt >= rise, "冰雨沿实际散落位置垂直下落并在成形完毕后结算", new
                  { model, initial = first.ToString(), centre = impact.ToString(), impactAt });
            scatterCenters.Add(impact.Value);
            firstIcePiece = pulse.PartTransform(1).GetColumn(3);
        }
        else if (landing || sky)
            Check(Vector2.Distance(impact.Value, point) < .04f && impactAt >= rise,
                "指定地点与实际爆发中心一致，生效时点在成形后", new { model, impact = impact.ToString(), impactAt });
    }
    if (fade > 0f)
    {
        int fadeNode = blast ? 2 : 1;
        Config.paused = false;
        await Game.WaitUntil(() => cast.NodeAge(fadeNode) >= 0f || cast.Finished, 1800);
        Config.paused = true;
        await Game.WaitUntil(Boundary, 1800);
        float began = cast.Age - cast.NodeAge(fadeNode);
        var after = Views(cast).Single(view => view.Resource.Description.Id == model);
        rest = after.Transform.GetColumn(3);
        if (orb && miss)
            Check(Vector2.Distance(rest.Value, point) < .03f && began <= rise + .53f,
                "抛弧落空时仍在指定点收束", new { model, point = point.ToString(), landed = rest.ToString(), began });
        float alpha = after.Dye?.a ?? 1f;
        await Stage(cast, began + fade * .56f);
        var ending = Views(cast).Single(view => view.Resource.Description.Id == model);
        float remaining = ending.Dye?.a ?? 1f;
        Check(cast.NodeAge(fadeNode) >= fade * .52f && ShapeCount(cast) == 0 && remaining > 0f && remaining < alpha &&
              Vector3.Distance(rest.Value, (Vector3)ending.Transform.GetColumn(3)) < .01f &&
              (!impact.HasValue || Vector3.Distance(rest.Value, impact.Value) < .02f),
            "收势停在真实结束地点连续变淡，作用面已经退出", new { model, rest = rest.ToString(), alpha, remaining });
        if (firstIcePiece.HasValue)
        {
            var shifted = Views(cast).Single(view => view.Resource.Description.Id == "icefall_impact");
            Check(cast.IsShapeHeld(1) && Vector3.Distance(shifted.PartTransform(1).GetColumn(3), firstIcePiece.Value) > .02f &&
                  Vector3.Distance(impact.Value, shifted.Transform.GetColumn(3)) < .02f,
                "冰片绕实际落点翻开，冰的保持形状规则继续有效", model);
        }
        await Advance(fade + .05f);
    }
    else
    {
        Config.paused = false;
        await Game.WaitUntil(() => cast.Finished, 1800);
        Config.paused = true;
        await Game.WaitUntil(Boundary, 1800);
    }
    var actual = contacts.Where(hit => hit.CastId == live.Key).ToArray();
    var damage = actual.Where(hit => hit.Damage.HealthLost > 0).ToArray();
    bool settled = miss ? actual.Length == 0 && hp == target.data.health && hp2 == second.data.health :
        !continues ? actual.Length == 1 && damage.Length == 1 && (orb && index == 4 && !tracking ?
            damage[0].TargetId == target.id || damage[0].TargetId == second.id : damage[0].TargetId == target.id) :
        actual.Length == 2 && damage.Length == 2 && damage.Count(hit => hit.TargetId == target.id) == 1 &&
        damage.Count(hit => hit.TargetId == second.id) == 1;
    if (blast)
    {
        settled = miss ? settled && cast.NodeAge(1) < 0f : impact.HasValue &&
            actual.Count(hit => hit.Node == 0) <= (landing || icefall ? 0 : 1) &&
            actual.Where(hit => hit.Node == 0).All(hit => !hit.DamageAttempted) &&
            damage.All(hit => hit.Node == 1) && damage.Length == (tracking ? 1 : 2) &&
            damage.Count(hit => hit.TargetId == target.id) == 1 &&
            damage.Count(hit => hit.TargetId == second.id) == (tracking ? 0 : 1);
    }
    Check(settled && actual.All(hit => hit.Age >= rise && (blast || hit.Node == 0)) && outside.data.health == hpOutside &&
          (!tracking || (impact?.y ?? damage[0].Position.y) > 74f),
        "保留贯穿、首击或爆发规则，范围外及提前到期无伤",
        new { model, tracking, miss, landing, impact = impact.ToString(), hits = actual.Select(hit => new { hit.TargetId, hit.Age, hit.Node,
            hit.Damage.HealthLost, position = hit.Position.ToString() }).ToArray() });
    Check(cast.Finished && Views(cast).Length == 0 && ShapeCount(cast) == 0 &&
          endings.Any(end => end.Fact.CastId == live.Key && !end.Fact.Cancelled) &&
          Math.Abs(before - owner.GetCultisys<Xian>().wakan - price) < .001f,
        "自然结束并只扣原价", new { model, price, before, after = owner.GetCultisys<Xian>().wakan });
    recordings.Add(new { asset = asset.id, index, form = model, rise, runtime, fade, price, tracking, miss,
        landing, point = rest.ToString(), impact = impact.ToString(), impactAt, triggers = actual.Count(hit => hit.Node == 0),
        hits = damage.Select(hit => hit.TargetId).ToArray() });
}

ConstructedAbilityService.CastStarted += Started;
Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured += LegacyExecution;
try
{
    foreach (var entry in catalog)
    {
        var coldVariants = entry.Asset == SkillEntities.LightningStrike ? new[] { 0, 9 } : new[] { Math.Min(1, entry.Count - 1) };
        var variants = chosenVariants.Length > 0 ? chosenVariants.Distinct() : cold ? coldVariants : Enumerable.Range(0, entry.Count);
        foreach (int index in variants) await Play(entry.Asset, entry.Form, index);
        if (caseName == "scatter")
        {
            await Play(entry.Asset, entry.Form, 0);
            Check(scatterCenters.Count == 2 && Vector2.Distance(scatterCenters[0], scatterCenters[1]) > .02f,
                "同一人物重放的冰雨取得两个不同的实际散落位置", scatterCenters.Select(center => center.ToString()).ToArray());
        }
    }
    return new { passed = true, spells = recordings.Count, process };
}
finally
{
    File.WriteAllText(Path.Combine(folder, "variants.json"), JsonConvert.SerializeObject(recordings, Formatting.Indented));
    Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured -= LegacyExecution;
    ConstructedAbilityService.CastStarted -= Started;
    ConstructedAbilityService.CastEnded -= Ended;
    ConstructedAbilityService.ContactConfirmed -= Hit;
    ControllableUnit.clear(false);
    Config.paused = true;
}
