// 必须真正退出并重启游戏，核对编辑得到的数量、尺寸、速度、历时及修士创作资料。
using System;
using System.IO;
using System.Linq;
using System.Collections.Generic;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core;
using Cultiway.Core.Skills;
using Cultiway.Core.Visuals.Forms;
using Cultiway.Utils.Extension;

string folder=Path.Combine(Cultiway.ModClass.I.GetDeclaration().FolderPath,"artifacts/skill_rebuild/magnitude-editing");
var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));
if((int)expected["process"]==System.Diagnostics.Process.GetCurrentProcess().Id)throw new InvalidOperationException("需要真正退出并重启游戏");
Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;
var actor=World.world.units.get((long)expected["actor"]);var saves=Cultiway.ModClass.I.WorldSaves;var access=ConstructionEditing.Access;var checks=new List<string>();
void Check(bool value,string name){if(!value)throw new InvalidOperationException(name);checks.Add(name);}
JToken Section(string value,string id)=>JObject.Parse(value)["sections"][id]["data"];
Check(actor!=null,"原版保存恢复实际持有者");
Check(JToken.DeepEquals(Section((string)expected["world"],"ability_constructions"),Section(saves.World.Capture(World.world,"magnitude"),"ability_constructions")),"完整尺寸、速度、历时、数量及修士创法资料恢复，没有重新抽取");
Check(JToken.DeepEquals(Section((string)expected["person"],"ability_knowledge"),Section(saves.Actors.Capture(actor.GetExtend(),"magnitude"),"ability_knowledge")),"全部已学关系及顺序恢复");
var definition=access.Read("Cultiway.Demo.ModifiedArc");
Check(definition.Root.Children.Length==3&&definition.Cost==9&&definition.Root.Children[2].AppearAt==.6f,"数量、延时、整次消耗和每份结构恢复");
var input=new AbilityInputs(Vector3.zero,new Vector3(8,0,0),Vector3.right,1);var cast=new AbilityCast(access.Validate(definition),Matrix4x4.identity,inputs:input);cast.Advance(.15f,input.Target);var views=new List<FormVisualInstance>();cast.AppendVisuals(views);Check(views.Count==1,"载入后按保存的窗口依次显现，没有提前绘制后续主体");
Check((saves.LastReport.Skipped.Count==0&&saves.LastReport.BackupError==null),"新增可选窗口不会丢弃正式资料");
var result=new{passed=true,checks,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"restart-result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
