// 旧坠石用原执行入口，同一落点分别在空中结束和确实落地，附近无人受击。
const string rock = "event:/SFX/WEAPONS/WeaponRockLand";
var bank = FMODUnity.RuntimeManager.StudioSystem;
Check(bank.getEvent(rock, out var sound) == FMOD.RESULT.OK, "原版声库有石块落地声");
sound.getID(out var rockId);
var times = new List<double>();
var harmony = new Harmony("cultiway.test.feedback-907-landing-" + Guid.NewGuid().ToString("N"));
var center = new Vector3(69, 72, 0);
CombatFeedbackPlaybackProbe.Played = (id, point, instance) =>
{
    if (id.Equals(rockId) && Vector2.Distance(point, center) < 2f && instance.getPlaybackState(out _) == FMOD.RESULT.OK)
        times.Add(World.world.getCurWorldTime());
};
harmony.Patch(typeof(MusicBox).GetMethod("PlayOneShot", F),
    postfix: new HarmonyMethod(typeof(CombatFeedbackPlaybackProbe), nameof(CombatFeedbackPlaybackProbe.AfterPlay)));
var feedback = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Visuals.SpatialCombatFeedback");
double ShakeTime() => (double)feedback.GetField("lastShake", F).GetValue(null);
Entity cast = default;
var impacts = new List<Vector3>();
void Area(Entity entity, Vector3 point, float radius) { if (entity == cast) impacts.Add(point); }
SkillHitResolver.AreaResolved += Area;
bool originalSound = MusicBox.sounds_on;
try
{
    MusicBox.sounds_on = true;
    PrepareAppearanceBackdrop(61, 75, 69, 75);
    await FrameAppearance("landing-backdrop", 68, 72, 6f);
    enemy.stopForce(); enemy.current_position = new Vector2(86, 72);
    enemy.setCurrentTile(World.world.GetTileSimple(86, 72)); enemy.updatePos();
    int hp = enemy.data.health;
    double before = ShakeTime();
    foreach (float height in part == "ground" ? new[] { 0f } : new[] { 6f, 0f })
    {
        var skill = new SkillContainerBuilder(SkillEntities.FallingRock).UseAnimation(0).Build();
        impacts.Clear(); times.Clear();
        Vector3 target = center + Vector3.forward * height;
        cast = Cultiway.ModClass.I.SkillV3.SpawnSkillAtPosition(skill, owner.Base, owner.Base.GetSimPos(), null,
            target, 45f, owner.GetPowerLevel());
        Check(cast.IsAvailable() && times.Count == 0, "起飞时不提前播落地声");
        for (int i = 0; i < 40 && impacts.Count == 0; i++) await Advance(.03f);
        Check(impacts.Count == 1 && Mathf.Abs(impacts[0].z - height) < .02f && times.Count == (height == 0 ? 1 : 0) &&
            ShakeTime() == before && enemy.data.health == hp,
            height == 0 ? "真落地只放一次石响，无普通范围震动" : "空中结束无落地声也不震屏",
            new { heights = impacts.Select(point => point.z).ToArray(), sounds = times.ToArray(), height, hp });
        await Advance(.55f);
    }
    return new { passed = true, checks };
}
finally
{
    harmony.UnpatchSelf(); CombatFeedbackPlaybackProbe.Played = null;
    SkillHitResolver.AreaResolved -= Area; MusicBox.sounds_on = originalSound; Config.paused = true;
}
