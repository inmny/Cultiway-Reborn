// 在现成世界中核对减少分配后的波面、实际命中和结束清理。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using System.Threading.Tasks;
using UnityEngine;
using Cultiway.Core;
using Cultiway.Content.Combat;
using Cultiway.Core.Skills;
using Cultiway.Core.Visuals.Forms;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Usage;
using Cultiway.Content.Skills;
using Cultiway.Utils.Extension;

string fixture = __ALLOCATION_FIXTURE__;
if (!File.Exists(Path.Combine(fixture, "map.wbox"))) throw new FileNotFoundException(fixture);
var generationField = typeof(ConstructedAbilityService).GetField("worldGeneration", BindingFlags.NonPublic | BindingFlags.Static);
long Generation() => (long)generationField.GetValue(null);
var runnerType = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");
var runner = runnerType.GetProperty("Instance").GetValue(null);
bool Boundary() => (bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner);
void Check(bool value, string name)
{
    if (!value) throw new InvalidOperationException(name);
}
async Task LoadFixture()
{
    Config.paused = true;
    long generation = Generation();
    World.world.save_manager.loadWorld(fixture);
    await Game.NextFrame();
    await Game.WaitUntil(() => !SmoothLoader.isLoading(), 1800);
    Config.paused = true;
    await Game.WaitUntil(Boundary, 1800);
    Check(Generation() != generation, "须完成一次真实世界加载");
}
async Task Advance(float seconds)
{
    Config.paused = false;
    double until = World.world.getCurWorldTime() + seconds;
    await Game.WaitUntil(() => World.world.getCurWorldTime() >= until, 1800);
    Config.paused = true;
    await Game.WaitUntil(Boundary, 1800);
}
void Place(Actor actor, float x, float y)
{
    actor.stopMovement();
    actor.current_position = new Vector2(x, y);
    actor.setCurrentTile(World.world.GetTileSimple((int)x, (int)y));
    actor.updatePos();
}
Game.Resume();
Config.setWorldSpeed("x1", false);
await LoadFixture();
var stats = new BaseStats();
stats.addTag("frozen_ai");
stats.addTag("immovable");
var hold = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.AllocationHold")
    .SetStats(stats).SetDuration(10000).Build();
void Hold(Actor actor, float x, float y)
{
    CombatStatusEffects.ApplyStatus(actor, hold, 10000, actor);
    Place(actor, x, y);
}
foreach (var actor in World.world.units.getSimpleList().ToArray()) Hold(actor, 12, 12);
Actor left = World.world.units.createNewUnit("human", World.world.GetTileSimple(64, 72), pAdultAge: true);
Actor right = World.world.units.createNewUnit("human", World.world.GetTileSimple(72, 72), pAdultAge: true);
var wolf = World.world.units.createNewUnit("wolf", World.world.GetTileSimple(12, 12), pAdultAge: true);
Hold(wolf, 12, 12);
right.setKingdom(wolf.kingdom);
Check(left.kingdom.isEnemy(right.kingdom) && right.kingdom.isEnemy(left.kingdom), "夹具双方须公开敌对");
foreach (var actor in new[] { left, right })
{
    actor.addTrait("super_health");
    Hold(actor, actor == left ? 64 : 72, 72);
    actor.setStatsDirty();
    actor.updateStats();
    actor.data.health = Mathf.CeilToInt(actor.stats["health"]);
    actor.attack_timer = 999;
}
left.addAggro(right);
right.addAggro(left);
await Advance(.15f);
Place(left, 64, 72);
Place(right, 72, 72);
for (int x = 55; x < 78; x++)
for (int y = 65; y < 81; y++)
{
    var tile = World.world.GetTileSimple(x, y);
    if (tile.building != null) tile.building.removeBuildingFinal();
    tile.setTileTypes(TileLibrary.soil_low, TopTileLibrary.grass_low);
}
Place(left, 63.5f, 72.5f);
Place(right, 68.5f, 72.5f);
var definition = new AbilityDefinition
{
    Id = "test.allocation.live-wave", Name = "地波发布与清理", Resource = "none", Cost = 0, Cooldown = 0,
    Lifetime = 2.5f, Power = 100f / left.stats["damage"], TargetRange = 16,
    Use = new ConstructionUse { Channels = ActiveAbilityChannel.World, Target = ActiveAbilityTargetMode.Point },
    Binding = new ConstructionBinding { Anchor = AbilityAnchor.Source },
    Root = new ConstructionNode
    {
        Id = "wave", Form = "fracture_slab", Matter = "ice",
        Operations = new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Propagate,
            Propagation = new ConstructionPropagation { Range = 8f, Speed = 12f, Seconds = .8f, Height = 1.2f,
                Angle = 360f, MaximumCells = 512 } } }
    }
};
var owner = left.GetExtend();
var points = new List<ConstructedContact>();
var endings = new List<ConstructedCastEnded>();
void Hit(ConstructedContact value)
{
    if (value.AbilityId == definition.Id && value.TargetId == right.id) points.Add(value);
}
void End(ConstructedCastEnded value)
{
    if (value.AbilityId == definition.Id) endings.Add(value);
}
ConstructedAbilityService.ContactConfirmed += Hit;
ConstructedAbilityService.CastEnded += End;
try
{
    ConstructedAbilityService.Register(definition);
    ConstructedAbilityService.Learn(owner, definition.Id);
    var request = new ActiveAbilityTarget(null, new Vector3(68.5f, 72.5f, 0));
    var handle = new ActiveAbilityHandle("content.constructed", owner.E, definition.Id);
    int health = right.data.health;
    Check(ActiveAbilityService.TryUse(owner, handle, request, ActiveAbilityUseOrigin.Script), "正式入口未受理地波");
    owner.E.RemoveComponent<ConstructedKnowledge>();
    await Advance(.28f);
    var model = FormResources.Load("fracture_slab");
    FormVisualInstance[] ReadWave() => FormVisualScene.Instances.Where(view => ReferenceEquals(view.Resource, model) && view.Layer != null).ToArray();
    var earlier = ReadWave();
    Check(earlier.Length > 1 && points.Count == 0, "已发布跨区波面，远处尚未到达");
    var centre = earlier.Single(view => view.Layer.Origin.x == 48f && view.Layer.Origin.y == 64f);
    double volume = centre.Layer.Volume;
    const BindingFlags hidden = BindingFlags.NonPublic | BindingFlags.Instance;
    var accessMesh = typeof(FormVisualInstance).GetMethod("MeshFor", hidden);
    Mesh MeshFor(FormVisualInstance view) => (Mesh)accessMesh.Invoke(view, new object[] { 0, 0 });
    var mesh = MeshFor(centre);
    int earlyVertices = mesh.vertexCount;
    Check(earlyVertices > 0, "发布波面生成可绘制几何");
    await Advance(.28f);
    var later = ReadWave();
    var newCentre = later.Single(view => view.Layer.Origin == centre.Layer.Origin);
    Check(ReferenceEquals(MeshFor(newCentre), mesh), "同一地波分区下一轮应复用真实网格");
    Check(newCentre.Layer.Volume != volume && centre.Layer.Volume == volume, "后续波量变化不得覆盖已经完成的波量");
    Check(ReferenceEquals(newCentre.Matter, centre.Matter), "同一未转换的冰质保持现有材料资料");
    await Advance(.35f);
    Check(points.Any(contact => contact.DamageAttempted && contact.TargetHealthAfter < contact.TargetHealthBefore) &&
          right.data.health < health, $"越过地波到达时点后须有实际伤害：目标从 {health} 到 {right.data.health}，"
          + $"来源 {left.current_position}、目标 {right.current_position}，接触 "
          + string.Join("、", points.Select(point => $"{point.Age}:{point.TargetHealthBefore}->{point.TargetHealthAfter}")));
    int healthAfter = right.data.health;
    await Advance(2f);
    Check(endings.Count == 1 && !endings[0].Cancelled && ReadWave().Length == 0, "自然结束后撤下波面");
    await LoadFixture();
    Check(FormVisualScene.Instances.Count == 0 && centre.Layer.Volume == volume, "换世界删除活动发布并保留此前取得的数值");
    return new { passed = true, views = earlier.Length, laterViews = later.Length, earlyVertices, oldVolume = volume,
        newVolume = newCentre.Layer.Volume, health, healthAfter, contactTime = points[0].Age,
        ended = endings.Count, visualsAfterReload = FormVisualScene.Instances.Count };
}
finally
{
    ConstructedAbilityService.ContactConfirmed -= Hit;
    ConstructedAbilityService.CastEnded -= End;
    Config.paused = true;
}
