// C12：独立创作与已有原术的真实交锋规则。
Actor source = Make(64); var owner = source.GetExtend(); owner.NewCultisys(Cultisyses.Xian); owner.GetCultisys<Xian>().level = 2;
owner.MarkCultiwayStatsDirty(); source.setStatsDirty(); source.updateStats(); owner.GetCultisys<Xian>().wakan = 10000;
var inspiration = ConstructedAbilityService.ReadInspiration(owner);
IEnumerable<ConstructionNode> Nodes(ConstructionNode node) { if (node == null) yield break; yield return node; foreach (var child in node.Children) foreach (var nested in Nodes(child)) yield return nested; }
JObject Canon(AbilityDefinition d) { var value = JObject.FromObject(d); value.Remove("Id"); value.Remove("Creator"); return value; }
var capture = service.GetMethod("CaptureCreationResources", F); var attempts = new List<object>();
try
{
    Check(inspiration.Rules == 20, "新受理请求使用第二十版创作规则");
    AbilityDefinition independent = null; int independentSeed = -1;
    for (int seed = 0; seed < 32 && independent == null; seed++)
    {
        var resources = (SynthesisResources)capture.Invoke(null, new object[] { owner, seed, inspiration });
        try
        {
            var generated = ConstructedAbilityService.Generate(owner, seed, inspiration, resources: resources);
            if (Nodes(generated.Root).Any(node => node.ContactRole == ConstructionContactRole.Barrier && (node.Interception == ConstructionInterception.Reflect || node.BlocksGroundActors)))
            {
                independent = generated; independentSeed = seed;
                Check(JToken.DeepEquals(Canon(generated), Canon(ConstructedAbilityService.Generate(owner, seed, inspiration, resources: resources))), "同一冻结输入保持完整交锋规则及费用");
            }
            attempts.Add(new { seed, generated.Id, generated.Cost });
        }
        catch (InvalidDataException error) { attempts.Add(new { seed, rejected = error.Message }); }
        await Game.NextFrame();
    }
    Check(independent != null, "独立自主创作产生实际部位的交锋规则", new { independentSeed });
    File.WriteAllText(Path.Combine(folder, "independent.json"), JsonConvert.SerializeObject(independent, Formatting.Indented));
    var basis = JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root, "artifacts/skill_rebuild/trajectories/clash-creation/ui/saved-definition.json")));
    string original = JsonConvert.SerializeObject(basis); AbilityDefinition derived = null; int derivedSeed = -1;
    for (int seed = 0; seed < 64 && derived == null; seed++)
    {
        var resources = (SynthesisResources)capture.Invoke(null, new object[] { owner, seed, inspiration });
        try
        {
            var generated = ConstructedAbilityService.Generate(owner, seed, inspiration, basis, resources);
            if (generated.Parent.Change == "交锋规则") { derived = generated; derivedSeed = seed; }
        }
        catch (InvalidDataException error) { attempts.Add(new { seed, derivedRejected = error.Message }); }
        await Game.NextFrame();
    }
    Check(derived != null && JsonConvert.SerializeObject(basis) == original, "已学原术可以派生交锋规则，原资料保持", new { derivedSeed });
    Check(JToken.DeepEquals(JToken.FromObject(derived.Root.Operations), JToken.FromObject(basis.Root.Operations)) && JToken.DeepEquals(JToken.FromObject(derived.Binding), JToken.FromObject(basis.Binding)), "交锋规则派生保持原投送、连接及命名步骤");
    Check(Nodes(derived.Root).Any(node => node.ContactRole == ConstructionContactRole.Barrier), "派生成品使用既有真实屏障用途");
    Check(derived.Cost == basis.Cost && AbilityCompiler.Compile(derived, false).Measure.Work == AbilityCompiler.Compile(basis, false).Measure.Work, "相同屏障容量和形体沿既有需求计费");
    File.WriteAllText(Path.Combine(folder, "derived.json"), JsonConvert.SerializeObject(derived, Formatting.Indented));
    File.WriteAllText(Path.Combine(folder, "selected.json"), JsonConvert.SerializeObject(new { seed = derivedSeed }, Formatting.Indented));
    return new { passed = true, closed = "交锋规则独立创作、派生与分版本需求", checks, process = System.Diagnostics.Process.GetCurrentProcess().Id };
}
finally
{
    File.WriteAllText(Path.Combine(folder, "attempts.json"), JsonConvert.SerializeObject(attempts, Formatting.Indented));
    ConstructedAbilityService.ContactConfirmed -= Hit; ConstructedAbilityService.CastEnded -= Ended; Config.paused = true; ControllableUnit.clear(false);
}
