// 首轮新旧正式请求已通过；只补生成成品的退出观察与再次保存，不重新授予。
var expected = JObject.Parse(File.ReadAllText(Path.Combine(root, "artifacts/skill_rebuild/trajectories/placement-references/save/pending-expected.json")));
Actor source = World.world.units.get((long)expected["sourceId"]), enemy = World.world.units.get((long)expected["enemyId"]);
var owner = source.GetExtend(); var access = ConstructionEditing.Access;
var completed = owner.GetComponent<ConstructedCreationState>(); var learned = access.Read(completed.LastAbility);
var active = new List<AbilityCast>();
void Started(ConstructedCastStarted value) { if (value.SourceId == source.id) foreach(object running in (IEnumerable)service.GetField("casts",F).GetValue(null)) if ((long)Field(running,"Id")==value.CastId) active.Add((AbilityCast)Field(running,"Cast")); }
ConstructedAbilityService.CastStarted += Started;
JObject Canon(AbilityDefinition definition) { var value=JObject.FromObject(definition); value.Remove("Id");value.Remove("Creator");return value; }
try
{
    Check(!completed.Pending && completed.LastFailure==null && JToken.DeepEquals(Canon(learned), Canon(expected["predicted"].ToObject<AbilityDefinition>())), "沿用原正式请求完成后的同一成品");
    ConstructedAbilityService.Learn(owner,learned.Id);
    var handle=new ActiveAbilityHandle("content.constructed",owner.E,learned.Id);
    var state=new ConstructedAbilityService().ResolveControlState(owner,handle);
    if(state.BlockReason==ActiveAbilityControlBlockReason.Cooldown) await Advance(state.CooldownRemaining+.05f);
    source.stopForce(); ControllableUnit.setControllableCreature(source); enemy.attack_timer=999;
    float before=owner.GetCultisys<Xian>().wakan;await Fire(learned,source,enemy);float paid=before-owner.GetCultisys<Xian>().wakan;
    owner.E.RemoveComponent<ConstructedKnowledge>();await Advance(.1f);
    Check(active.Single().StepStateOf("spin")==ConstructionStepState.Running, "自主成品的同一命名旋转实际启动");
    await Advance(learned.Lifetime+.2f);
    Check(Math.Abs(paid-learned.Cost)<.001f && active.Single().Finished && endings.Any(e=>e.Fact.AbilityId==learned.Id) && !BodyControlState.IsBusy(source.id), "生成成品实际支付并正常退出", new { paid, state=active.Single().Phase.ToString(),ended=endings.Count });
    ConstructedAbilityService.Learn(owner,learned.Id);string save=Path.Combine(folder,"completed-save"); SaveManager.saveWorldToDirectory(save);
    World.world.save_manager.loadWorld(save);await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Game.WaitUntil(Boundary,1800);
    Check(JToken.DeepEquals(Canon(access.Read(learned.Id)),Canon(learned)) && ConstructedAbilityService.Knows(World.world.units.get((long)expected["sourceId"]).GetExtend(),learned.Id), "完成后的命名步骤及引用和已学关系再次正式保存保持");
    File.WriteAllText(Path.Combine(folder,"created-definition.json"),JsonConvert.SerializeObject(learned,Formatting.Indented));
    return new { passed=true,closed="正式生成成品退出及完成后再次保存",checks,process=System.Diagnostics.Process.GetCurrentProcess().Id };
}
finally { ConstructedAbilityService.CastStarted-=Started;ConstructedAbilityService.ContactConfirmed-=Hit;ConstructedAbilityService.CastEnded-=Ended;Config.paused=true;ControllableUnit.clear(false); }
