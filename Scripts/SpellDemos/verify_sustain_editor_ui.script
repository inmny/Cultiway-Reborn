// 经真实表单编辑连接、环绕与局部运动，保存后重新打开；不写玩家世界。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using UnityEngine;
using UnityEngine.UI;
using Cultiway.Core;
using Cultiway.Core.Skills;
using Cultiway.Content.Skills;
using Cultiway.Content.Components;
using Cultiway.UI;
using Cultiway.UI.Prefab;
using Cultiway.Utils.Extension;

const BindingFlags Flags=BindingFlags.Instance|BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic;
object Field(object value,string key)=>value.GetType().GetField(key,Flags).GetValue(value);
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/sustain/ui");Directory.CreateDirectory(folder);
var checks=new List<string>();void Check(bool value,string name){if(!value)throw new InvalidOperationException(name);checks.Add(name);}
string T(string key)=>LocalizedTextManager.getText("Cultiway.Construction."+key);
async Task Frames(int count=3){for(int i=0;i<count;i++)await Game.NextFrame();await Game.WaitUntil(()=>!ScrollWindow.isAnimationActive(),300);Canvas.ForceUpdateCanvases();}
async Task Shot(string name){World.world.console.Hide();Tooltip.hideTooltipNow();foreach(var loading in Resources.FindObjectsOfTypeAll<LoadingScreen>())loading.gameObject.SetActive(false);await Frames(4);Screen.Capture(Path.Combine(folder,name+".png"));await Frames();}
Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;
var actor=World.world.units.createNewUnit("human",World.world.GetTileSimple(64,72),pAdultAge:true,pSpawnWithItems:false);actor.data.name="独立维持编辑验证";actor.addTrait("super_health");var owner=actor.GetExtend();owner.AddComponent(new Xian{level=2,wakan=10000});
var original=JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/翻卷厚浪.json")));ConstructedAbilityService.Register(original);ConstructedAbilityService.Learn(owner,original.Id);LocalizedTextManager.instance.setLanguage("cz");await Frames();WindowWanfaConstructionEditor.Open(original.Id,actor);await Frames();
var editor=(WindowWanfaConstructionEditor)typeof(WindowWanfaConstructionEditor).GetField("instance",Flags).GetValue(null);
Button B(string name)=>editor.GetComponentsInChildren<Button>(false).First(b=>b.name==name);
void Click(string name){Check(B(name).interactable,"按钮可用："+name);B(name).onClick.Invoke();}
InputField Input(string key)=>editor.GetComponentsInChildren<InputField>(false).First(f=>f.name==key);
void Set(string key,string value){var field=Input(key);field.text=value;field.onEndEdit.Invoke(value);}
ConstructionEditSession Session()=>(ConstructionEditSession)Field(editor,"session");
WanfaEditorRow Row(string key)=>editor.GetComponentsInChildren<WanfaEditorRow>(false).First(r=>((Text)Field(r,"_title")).text==T(key));
void Action(string key)=>((Button)Field(Row(key),"_action")).onClick.Invoke();
void Argument(string key,string text){var input=Row(key).GetComponentsInChildren<InputField>(false).Single();input.text=text;input.onEndEdit.Invoke(text);}
Argument("SustainConstruction","2");Action("SustainConstruction");
Check(Session().Draft.Root.Hold.Seconds==2&&Mathf.Abs(Session().Draft.Lifetime-5.1f)<.0001f&&Session().Draft.Cost==4,"独立维持按钮同时保存形变维持和总寿命，消耗不变");
Check(Session().Draft.Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Fly).Vector[1]==2.8f,"维持按钮保留真实飞行速度");
Set("HoldAt","1.8");Check(Session().Draft.Root.Hold.At==1.8f,"可从普通参数调整实际维持姿态时点");
Set("HoldSeconds","-1");Check(!B("LearnCopy").interactable,"无效维持时长不能保存");Click("Undo");
Check(Session().Draft.Root.Hold.Seconds==2,"撤销恢复完整有效维持资料");
editor.GetComponentsInChildren<ScrollRect>(false).First(r=>r.name=="Parameters").verticalNormalizedPosition=.5f;await Shot("sustain-commands-cz");
Click("Replace");string id=Session().SourceId;var saved=ConstructionEditing.Access.Read(id);
Check(saved.Root.Hold.At==1.8f&&saved.Root.Hold.Seconds==2,"正式替换保存具体姿态及维持秒数");
Click("Close");await Frames();WindowWanfaConstructionEditor.Open(id,actor);await Frames();Check(Session().Draft.Root.Hold.Seconds==2,"再次打开读取保存的维持资料");
LocalizedTextManager.instance.setLanguage("en");Click("Page0");editor.GetComponentsInChildren<ScrollRect>(false).First(r=>r.name=="Parameters").verticalNormalizedPosition=.5f;await Shot("sustain-commands-en");
Check(((Text)Field(Row("SustainConstruction"),"_title")).text=="Additional sustain (sec)","维持命令跟随原版语言切换");
int width=UnityEngine.Screen.width,height=UnityEngine.Screen.height;bool full=UnityEngine.Screen.fullScreen;UnityEngine.Screen.SetResolution(1024,768,false);await Frames(8);await Shot("sustain-commands-en-1024");
var corners=new Vector3[4];((RectTransform)editor.transform.Find("Background")).GetWorldCorners(corners);Check(corners.All(p=>p.x>=0&&p.y>=0&&p.x<=UnityEngine.Screen.width&&p.y<=UnityEngine.Screen.height),"维持参数在1024分辨率保持窗口边界");
Click("Close");await Frames();UnityEngine.Screen.SetResolution(width,height,full);LocalizedTextManager.instance.setLanguage("cz");await Frames(8);
WindowWanfaConstructionEditor.Open(BodyActionCatalog.PalmId,actor);await Frames();Argument("SustainConstruction","0.8");Action("SustainConstruction");Click("Page2");
Check(Input("HoldAt").text=="0.255"&&Input("HoldSeconds").text=="0.8"&&((Text)Field(Row("EffectiveBodyUntil"),"_detail")).text=="1.055","身体页显示原姿态时点、维持秒数及实际发力终点");
Action("ProjectBody");
var formMenu=Field(editor,"menu");var formOptions=(IList)Field(formMenu,"_options");
int hand=Enumerable.Range(0,formOptions.Count).Single(i=>(string)Field(formOptions[i],"Label")==T("Form.hand"));
((Button)((IList)Field(formMenu,"_optionButtons"))[hand]).onClick.Invoke();
Check(Mathf.Abs(Session().Draft.Root.ActiveFrom-1.055f)<.0001f,"从维持身体继续显化读取实际离手时点");
Click("Undo");Click("Undo");Click("Close");await Frames();
var result=new{passed=true,checks,id};File.WriteAllText(Path.Combine(folder,"checks.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
