// 核对原版真实角像素与真正生成的技能位置；不把本项算作三维器官接合。
using System;
using System.IO;
using System.Linq;
using System.Collections.Generic;
using System.Reflection;
using System.Threading.Tasks;
using Newtonsoft.Json;
using UnityEngine;
using Friflo.Engine.ECS;
using Cultiway.Core;
using Cultiway.Core.Components;
using Cultiway.Core.SkillLibV3;
using Cultiway.Core.SkillLibV3.Components;
using Cultiway.Content.Components;
using Cultiway.Content.Combat;
using Cultiway.Content.CreatureCompositions.Components;
using Cultiway.Content.CreatureCompositions.Services;
using Cultiway.Content.CreatureCompositions.Visuals;
using Cultiway.Content.CreatureCompositions.ActiveAbilities;
using Cultiway.Content.YaoBeasts;
using Cultiway.Utils.Extension;

const BindingFlags Flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static | BindingFlags.Instance;
            string root = Cultiway.ModClass.I.GetDeclaration().FolderPath;
            string folder = Path.Combine(root, "artifacts/skill_rebuild/body-anchors/organ-outlets");
            Directory.CreateDirectory(folder);
            var checks = new List<object>();
            var births = new List<object>();
            var pixels = new Dictionary<string, (Color32[] Colors, int Width, int Height)>();
            void Check(bool pass, string name, object evidence = null) => checks.Add(new { pass, name, evidence });
            float[] Point(Vector3 p) => new[] { p.x, p.y, p.z };
            async Task Frames(int count = 4)
            {
                for (int i = 0; i < count; i++) { Config.paused = true; await Game.NextFrame(); }
            }
            async Task Until(Func<bool> condition)
            {
                Config.paused = false;
                await Game.WaitUntil(condition, 1800);
                Config.paused = true;
                await Frames();
            }
            void Place(Actor actor, float x)
            {
                actor.stopMovement(); actor.stopForce(); actor.current_position = new Vector2(x, 64.5f);
                actor.setCurrentTile(World.world.GetTileSimple((int)x, 64)); actor.updatePos();
            }
            Game.Resume(); Config.paused = true; ControllableUnit.clear(false);
            World.world.save_manager.loadWorld(Path.Combine(root, "artifacts/skill_rebuild/performance-baseline/cultiway/worlds/none"));
            await Game.NextFrame(); await Game.WaitUntil(() => !SmoothLoader.isLoading(), 3600); await Frames();
            World.world.console.Hide();
            foreach (var loading in Resources.FindObjectsOfTypeAll<LoadingScreen>()) loading.gameObject.SetActive(false);
            Cultiway.Const.GeneralSettings.SwitchSkillSystems(true); Config.setWorldSpeed("x1", false);
            var external = AppDomain.CurrentDomain.GetAssemblies().Select(a => a.GetType("FirstPerson.WorldBoxMod", false)).First(t => t != null);
            object mod = external.GetProperty("Instance", Flags).GetValue(null);
            external.GetMethod("ViewForTest", Flags).Invoke(mod, new object[] { false });
            external.GetMethod("SetGodView", Flags).Invoke(mod, new object[] { false });
            var stats = new BaseStats(); stats.addTag("frozen_ai"); stats.addTag("immovable");
            var hold = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.Verify.OrganOutlets.Hold")
                .SetStats(stats).SetDuration(10000).Build();
            foreach (Actor other in World.world.units.getSimpleList().ToArray()) CombatStatusEffects.ApplyStatus(other, hold, 10000, other);
            Actor target = World.world.units.createNewUnit("human", World.world.GetTileSimple(70, 64), pAdultAge: true, pSpawnWithItems: false);
            target.addTrait("super_health"); CombatStatusEffects.ApplyStatus(target, hold, 10000, target);
            var library = Cultiway.Content.Libraries.Manager.CreatureVisualLayerLibrary;
            var layer = library.get("yao.layer.horn_thunder");
            var read = typeof(CreatureAppearanceService).GetMethod("ReadPixels", Flags);
            var active = new HashSet<long>();
            var actualPositions = new List<Vector3>();
            var actualSources = new List<long>();
            var actualCarriers = new List<long>();
            var actualOutlets = new List<Vector3>();
            bool watchSourceless = false;
            Action<Entity> onCreated = entity =>
            {
                var context = entity.GetComponent<SkillContext>();
                if (watchSourceless && context.SourceObj == null)
                {
                    Vector3 position = entity.GetComponent<Position>().value;
                    actualPositions.Add(position); actualSources.Add(context.SourceId); actualCarriers.Add(-1); actualOutlets.Add(default);
                    births.Add(new { source = context.SourceId, carrier = -1L, position = Point(position), time = World.world.getCurWorldTime(), entity = entity.Id });
                    return;
                }
                if (!active.Contains(context.SourceId)) return;
                Vector3 born = entity.GetComponent<Position>().value;
                actualPositions.Add(born); actualSources.Add(context.SourceId);
                actualCarriers.Add(context.ResolveSpatialSource().getID());
                bool resolved = SkillCastPlanner.TryResolveSourcePosition(context.SourceObj.a.GetExtend(),
                    entity.GetComponent<SkillEntity>().SkillContainer, out Vector3 outlet);
                actualOutlets.Add(outlet);
                births.Add(new
                {
                    source = context.SourceId,
                    carrier = context.ResolveSpatialSource().getID(),
                    position = Point(born),
                    resolved,
                    outlet = Point(outlet),
                    frame = context.SourceObj.a.calculateMainSprite().name,
                    time = World.world.getCurWorldTime(),
                    entity = entity.Id
                });
            };
            Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured += onCreated;
            try
            {
                foreach (string species in new[] { "wolf", "bear", "turtle", "fox", "crocodile", "rabbit", "rat", "sheep", "snake" })
                {
                    Actor body = World.world.units.createNewUnit(species, World.world.GetTileSimple(65, 64), pAdultAge: true);
                    var owner = body.GetExtend();
                    owner.E.RemoveComponent<Xian>(); owner.E.RemoveComponent<Knight>(); owner.E.RemoveComponent<Magic>();
                    Check(YaoAwakeningService.TryAwakenByRain(owner), species + "实际启灵");
                    var organs = new[] {
    new YaoOrganRecord { SlotId = YaoContent.Slots.Surface, OrganId = "yao.scale.basic", Rank = 1, Origin = YaoOrganOrigin.Innate },
    new YaoOrganRecord { SlotId = YaoContent.Slots.Head, OrganId = "yao.horn.thunder", Rank = 2, Origin = YaoOrganOrigin.GodEdited }
};
                    Check(YaoFormPlanService.TrySetOrgans(owner, YaoFormIds.TrueForm, organs), species + "实际雷角身体");
                    body.setStatsDirty(); body.updateStats(); body.addTrait("super_health");
                    CombatStatusEffects.ApplyStatus(body, hold, 10000, body); Place(body, 65.5f);
                    owner.GetCultisys<Yao>().yao_power = 1000f;
                    CreatureOrganSkillRegistry.EnsureBuilt();
                    if (!CreatureOrganSkillRegistry.TryGetContainer("Cultiway.ChainLightning", out Entity container)) throw new InvalidOperationException("缺少正式雷链容器");
                    var phenotype = owner.E.GetComponent<CreaturePhenotype>();
                    CreaturePhenotypeCompiler.TryGetCompiled(phenotype.CompiledIndex, phenotype.Signature, out var compiled);
                    await Frames();
                    float normalScale = body.actor_scale;
                    foreach (bool flip in new[] { false, true })
                        foreach (float multiplier in new[] { 1f, 1.7f })
                            foreach (float tilt in new[] { 0f, 25f })
                            {
                                body.flip = flip;
                                body.setActorScale(normalScale * multiplier); body.target_scale = body.actor_scale;
                                body.current_rotation.z = tilt;
                                Sprite native = body.calculateMainSprite();
                                var frame = layer.FramesByRig[compiled.Morph.VisualRigId][native.name];
                                if (!pixels.TryGetValue(frame.SpritePath, out var image))
                                {
                                    Sprite sprite = SpriteTextureLoader.getSprite(frame.SpritePath);
                                    image = ((Color32[])read.Invoke(null, new object[] { sprite }), Mathf.RoundToInt(sprite.rect.width), Mathf.RoundToInt(sprite.rect.height));
                                    pixels.Add(frame.SpritePath, image);
                                }
                                bool resolved = SkillCastPlanner.TryResolveSourcePosition(owner, container, out Vector3 source);
                                float nearest = float.MaxValue;
                                for (int y = 0; y < image.Height; y++)
                                    for (int x = 0; x < image.Width; x++)
                                    {
                                        if (image.Colors[y * image.Width + x].a == 0) continue;
                                        Vector2 p = new Vector2((frame.X + x + .5f - native.pivot.x) * body.current_scale.x * (flip ? -1f : 1f),
                                            (frame.Y + y + .5f - native.pivot.y) * body.current_scale.y) / native.pixelsPerUnit;
                                        Vector3 q = Quaternion.Euler(0, 0, tilt) * p;
                                        nearest = Mathf.Min(nearest, Vector3.Distance(source, new Vector3(body.current_position.x + q.x, body.current_position.y, body.position_height + q.y)));
                                    }
                                Check(resolved && nearest < .00001f, species + "真实角像素与出口一致", new { flip, multiplier, tilt, nearest, source = Point(source), frame = native.name });
                                Check(CreatureAppearanceService.TryGetAnchor(compiled, body, layer.id, "mount", out Vector3 mount) && Vector3.Distance(source, mount) > .01f,
                                    species + "安装点与出口可区分");
                            }
                    body.current_rotation = Vector3.zero; body.target_angle = Vector3.zero;
                    body.setActorScale(normalScale); body.target_scale = normalScale; body.flip = false;
                    Place(body, 65.5f); active.Add(body.id);
                    SkillCastPlanner.TryResolveSourcePosition(owner, container, out Vector3 oldSource);
                    var plan = SkillCastPlanner.CreatePlan(owner, container, target, 1);
                    Check(plan.Steps.Count == 1, species + "正式生成计划");
                    plan.Steps.Clear(); plan.Steps.Add(new SkillCastStep(target, .25f)); plan.Steps.Add(new SkillCastStep(target, 2f));
                    double powerBefore = owner.GetCultisys<Yao>().yao_power;
                    int first = actualPositions.Count;
                    Check(Cultiway.ModClass.I.SkillV3.StartSkillSequence(owner, container, plan, 1f), species + "正式付费受理延迟双发");
                    Check(owner.GetCultisys<Yao>().yao_power < powerBefore, species + "实际支付妖力");
                    Place(body, 66.5f);
                    await Until(() => actualPositions.Count >= first + 1);
                    Check(actualPositions.Count == first + 1, species + "首发实际生成");
                    Check(actualPositions.Count > first && Vector3.Distance(actualPositions[first], actualOutlets[first]) < .0001f && Vector3.Distance(actualPositions[first], oldSource) > .8f,
                        species + "计划之后移动不使用旧出生点");
                    Place(body, 67.5f); body.flip = true;
                    body.setActorScale(normalScale * 1.7f); body.target_scale = body.actor_scale;
                    await Until(() => actualPositions.Count >= first + 2);
                    Check(actualPositions.Count == first + 2, species + "第二发实际生成");
                    Check(actualPositions.Count > first + 1 && Vector3.Distance(actualPositions[first + 1], actualOutlets[first + 1]) < .0001f,
                        species + "第二发跟随新位置朝向和尺寸");
                    Check(actualSources.Skip(first).All(id => id == body.id) && actualCarriers.Skip(first).All(id => id == body.id), species + "归属和肉身保持");
                    // 明确指定的固定世界出生点不跟随身体；空间载体不同也不借用本体的角。
                    if (species == "wolf")
                    {
                        var fixedPlan = new SkillCastPlan(); Vector3 fixedPoint = new Vector3(68.2f, 64.5f, .8f);
                        fixedPlan.Steps.Add(SkillCastStep.FromSource(fixedPoint, target, target.GetSimPos(), .1f, true));
                        int index = actualPositions.Count;
                        Check(Cultiway.ModClass.I.SkillV3.StartSkillSequence(owner, container, fixedPlan, 1f), "固定出生点正式受理");
                        Place(body, 66.5f); await Until(() => actualPositions.Count >= index + 1);
                        Check(actualPositions.Count == index + 1 && Vector3.Distance(actualPositions[index], fixedPoint) < .00001f, "明确指定的固定出生点保持不变");
                        var carrierPlan = new SkillCastPlan(); carrierPlan.Steps.Add(new SkillCastStep(new Vector3(72, 64, 0), .1f));
                        index = actualPositions.Count;
                        Check(Cultiway.ModClass.I.SkillV3.StartSkillSequence(owner, container, carrierPlan, 1f, carrier: target.GetExtend()), "不同空间载体正式受理");
                        await Until(() => actualPositions.Count >= index + 1);
                        Check(actualPositions.Count == index + 1 && Vector3.Distance(actualPositions[index], target.GetSimPos()) < .00001f && actualCarriers[index] == target.id && actualSources[index] == body.id,
                            "空间载体位置与技能归属各自保持");
                        watchSourceless = true; index = actualPositions.Count;
                        Entity sourceless = Cultiway.ModClass.I.SkillV3.StartSourcelessSkillSequence(owner, container, fixedPlan, 1f, 1f);
                        Check(!sourceless.IsNull, "无施法者序列正式受理");
                        await Until(() => actualPositions.Count >= index + 1); watchSourceless = false;
                        Check(actualPositions.Count == index + 1 && actualSources[index] == -1 && actualCarriers[index] == -1 && Vector3.Distance(actualPositions[index], fixedPoint) < .00001f,
                            "无施法者序列保留固定位置与空来源");
                    }
                    Check(YaoFormPlanService.TryReplaceOrgan(owner, YaoFormIds.TrueForm, YaoContent.Slots.Head,
                        "yao.spirit.sense", 1, YaoOrganOrigin.GodEdited), species + "实际移除雷角并保留必要头部器官");
                    Check(!SkillCastPlanner.TryResolveSourcePosition(owner, container, out _), species + "移除器官不留旧出口");
                    active.Remove(body.id);
                }
            }
            finally { Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured -= onCreated; Config.paused = true; }
            bool passed = !checks.Any(c => !(bool)c.GetType().GetProperty("pass").GetValue(c));
            File.WriteAllText(Path.Combine(folder, "checks.json"), JsonConvert.SerializeObject(new { passed, checks, births, process = System.Diagnostics.Process.GetCurrentProcess().Id }, Formatting.Indented));
            return new { passed, checks = checks.Count, births = births.Count };
