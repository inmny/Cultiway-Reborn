// 持剑施法选敌、活动水体、零攻击余力、来源死亡及正式存档。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using HarmonyLib;
using Cultiway.Core.Skills;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Usage;
using Cultiway.Core.SkillLibV3.Effects;
using Cultiway.Core.EventSystem.Events;
using Cultiway.Core.EventSystem.Systems;
using Cultiway.Content.Skills;
using Cultiway.Content.Components;
using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/active-water");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}
async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;var t=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=t.GetProperty("Instance").GetValue(null);await Game.WaitUntil(()=>(bool)t.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);}
Config.paused=true;Game.Resume();Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;
for(int y=48;y<100;y++)for(int x=44;x<124;x++)World.world.GetTileSimple(x,y).setTileTypes("sand",null);for(int y=70;y<75;y++)for(int x=60;x<=80;x++)World.world.GetTileSimple(x,y).setTileTypes("shallow_waters",null);
var stats=new BaseStats();stats["mana"]=256;stats["damage"]=40;stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.ActiveWaterHold").SetStats(stats).SetDuration(10000).Build();
Actor NewActor(int x,int y){var p=World.world.units.createNewUnit("human",World.world.GetTileSimple(x,y),pAdultAge:true,pSpawnWithItems:false);p.addTrait("super_health");p.GetExtend().AddComponent(new Xian{level=2,wakan=100});Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(p,hold,10000,p);p.GetExtend().MarkCultiwayStatsDirty();p.setStatsDirty();p.updateStats();p.setMana(128);return p;}
void Place(Actor p,float x,float y){p.stopMovement();p.current_position=new Vector2(x,y);p.setCurrentTile(World.world.GetTileSimple((int)x,(int)y));p.updatePos();}
var source=NewActor(60,72);source.equipment.setItem(World.world.items.generateItem(AssetManager.items.get("sword_iron"),pActor:source),source);source.setStatsDirty();source.updateStats();var target=NewActor(76,72);var middle=NewActor(68,72);var air=NewActor(70,72);var friend=NewActor(68,90);var wolf=World.world.units.createNewUnit("wolf",World.world.GetTileSimple(12,12),pAdultAge:true);Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(wolf,hold,10000,wolf);foreach(var p in new[]{target,middle,air}){p.setKingdom(wolf.kingdom);source.addAggro(p);p.addAggro(source);}await Advance(.1f);
AbilityDefinition Spell(string name)=>JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/"+name+".json")));
void Learn(Actor actor,AbilityDefinition d){ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(actor.GetExtend(),d.Id);}
bool Fire(Actor actor,Actor to,AbilityDefinition d){Learn(actor,d);return ActiveAbilityService.TryUse(actor.GetExtend(),new ActiveAbilityHandle("content.constructed",actor.GetExtend().E,d.Id),new ActiveAbilityTarget(to,to.GetSimPos()),ActiveAbilityUseOrigin.Script);}
AbilityDefinition Attack(string id){var d=Spell("引水行雷");d.Id=id;d.Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Conduct).At=.2f;return d;}
IList Casts()=>(IList)typeof(ConstructedAbilityService).GetField("casts",F).GetValue(null);AbilityCast Running(string id)=>Casts().Cast<object>().Select(r=>(AbilityCast)r.GetType().GetField("Cast",F).GetValue(r)).Single(c=>c.Plan.Id==id&&!c.Finished);
var waves=new List<ConstructedConduction>();var contacts=new List<ConstructedContact>();void Wave(ConstructedConduction e){waves.Add(e);File.WriteAllText(Path.Combine(folder,"waves.json"),JsonConvert.SerializeObject(waves.Select(w=>new{w.AbilityId,w.Spent,w.Targets,w.HealthBefore,w.HealthAfter,w.WaterCasts,route=w.Route.Length}),Formatting.Indented));}void Contact(ConstructedContact e)=>contacts.Add(e);ConstructedAbilityService.ConductionConfirmed+=Wave;ConstructedAbilityService.ContactConfirmed+=Contact;var hook=new Harmony("Cultiway.SpellDemo.ActiveWaterCallback");
try{
 var native=Attack("test.active.native.sword");Learn(source,native);var handle=new ActiveAbilityHandle("content.constructed",source.GetExtend().E,native.Id);Check(!source.canAttackTarget(target)&&SkillTargetRelationResolver.IsHostile(source,target),"原版持剑不能普攻水中人物，但技能敌我关系允许选取");Check(ActiveAbilityService.CanUse(source.GetExtend(),handle,new ActiveAbilityTarget(target,target.GetSimPos())),"普通技能入口不再被所持近战武器阻止");var candidates=new List<ActiveAbilityHandle>();var weights=new List<int>();Check(ActiveAbilityService.CollectAiCandidates(source.GetExtend(),target,candidates,weights)>0&&candidates.Any(h=>h.EntryId==native.Id),"自主能力候选同样包含持剑修士的水域技能");Check(!SkillTargetRelationResolver.IsHostile(source,friend),"没有敌意的同国人物不会因放宽武器限制而变成敌人");
 void Protected(string field,string message){var f=typeof(Actor).GetField(field,F);object old=f.GetValue(target);f.SetValue(target,true);try{Check(!SkillTargetRelationResolver.IsHostile(source,target),message);}finally{f.SetValue(target,old);}}
 Protected("is_inside_building","容器内目标仍受保护");Protected("is_in_magnet","磁铁状态目标仍受保护");
 var actionField=target.ai.GetType().GetField("action",F);object oldAction=actionField.GetValue(target.ai);var action=Activator.CreateInstance(actionField.FieldType);action.GetType().GetField("special_prevent_can_be_attacked",F).SetValue(action,true);actionField.SetValue(target.ai,action);try{Check(!SkillTargetRelationResolver.IsHostile(source,target),"特殊不可受击动作仍受保护");}finally{actionField.SetValue(target.ai,oldAction);}
 var worm=World.world.units.createNewUnit("worm",World.world.GetTileSimple(12,14));source.addAggro(worm);Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(worm,hold,10000,worm);Check(SkillTargetRelationResolver.HasHostileRelation(source,worm)&&!SkillTargetRelationResolver.IsHostile(source,worm),"不可受攻击资产不会被新的选敌规则放行");
 var flying=typeof(Actor).GetField("_flying",F);flying.SetValue(air,true);air.position_height=16;Check(!source.canAttackTarget(air)&&ActiveAbilityService.CanUse(source.GetExtend(),handle,new ActiveAbilityTarget(air,air.GetSimPos())),"飞行目标的技能选取与近战武器分开，实际命中仍检查高度");Check(Fire(source,target,native),"持剑修士通过真实支付向水中敌人施法");Config.paused=false;double end=World.world.getCurWorldTime()+.6;while(World.world.getCurWorldTime()<end){air.position_height=16;flying.SetValue(air,true);await Game.NextFrame();}Config.paused=true;await Advance(.01f);var first=waves.Single(w=>w.AbilityId==native.Id);Check(first.Targets.Contains(target.id)&&first.Targets.Contains(middle.id)&&!first.Targets.Contains(air.id)&&!first.Targets.Contains(friend.id),"原版水面真实作用两人，空中及无敌意人物不受击");flying.SetValue(air,false);Place(air,104,92);
 Place(source,94,72);Place(target,110,72);Place(middle,102,72);var supply=Spell("活动导电验证水流");target.GetExtend().GetCultisys<Xian>().wakan=target.stats[Cultiway.Content.BaseStatses.MaxWakan.id];Check(Fire(target,target,supply),"另一修士正式支付并维持未留存的活动水体");await Advance(1.5f);Place(target,109,72);var water=Running(supply.Id);Check(WorldMaterialService.Count==0&&water.RemainingVolume(0)>255.99,"活动水体没有先转交世界，也没有复制世界材料");long supplyCast=(long)Casts().Cast<object>().Single(r=>ReferenceEquals(r.GetType().GetField("Cast",F).GetValue(r),water)).GetType().GetField("Id",F).GetValue(Casts().Cast<object>().Single(r=>ReferenceEquals(r.GetType().GetField("Cast",F).GetValue(r),water)));double volume=water.RemainingVolume(0),budget=water.RemainingResource(0);var live=Attack("test.active.external");Check(Fire(source,target,live),"另一施放通过同一导电操作进入活动水体");await Advance(.6f);var second=waves.Single(w=>w.AbilityId==live.Id);Check(second.Route.Length>0&&second.Targets.Contains(target.id)&&second.Targets.Contains(middle.id)&&second.Targets.Distinct().Count()==second.Targets.Length,"活动水路实际到达两人且同次只作用一次");Check(first.WaterCasts.Length==0&&second.WaterCasts.SequenceEqual(new[]{supplyCast}),"实际传播记录绑定供水施放编号，原版水面不冒充活动供水");Check(Math.Abs(water.RemainingVolume(0)-volume)<.002&&Math.Abs(water.RemainingResource(0)-budget)<.0001,"电击不耗取供水者的水量及原支付");
 typeof(AbilityCast).GetMethod("ConsumeForce",F).Invoke(water,new object[]{0,100000f});Check(water.RemainingForce(0)==0&&!water.Finished,"供水主体攻击余力归零但实际水层仍存在");var zero=Attack("test.active.zero-force");Check(Fire(source,target,zero),"零攻击余力水层场景正式施放");await Advance(.6f);Check(waves.Single(w=>w.AbilityId==zero.Id).Targets.Contains(target.id),"导电不把攻击余力误当成水体是否存在");
 int deaths=0;ActiveWaterCallback.AfterDamage=e=>{if(e.AttackerID!=source.id)return;ActiveWaterCallback.AfterDamage=null;Cultiway.Content.Combat.CombatStatusEffects.RemoveStatus(target,hold);typeof(Actor).GetMethod("die",F).Invoke(target,new object[]{false,AttackType.Other,true,false});deaths++;};hook.Patch(typeof(GetHitEventSystem).GetMethod("Resolve",F),postfix:new HarmonyMethod(typeof(ActiveWaterCallback).GetMethod("Postfix")));var interrupted=Attack("test.active.source-death");Check(Fire(source,middle,interrupted),"供水者死亡场景正式施放");await Advance(.6f);var cut=waves.Single(w=>w.AbilityId==interrupted.Id);Check(deaths==1&&!target.isAlive()&&water.Finished,"首位受击回调中供水者真实死亡，活动水体随来源终止");Check(cut.Targets.Length==1&&cut.Targets.Contains(middle.id),"供水者死亡后，后续水路不再伤害第二人物");hook.UnpatchSelf();
 var own=Spell("流水载雷");own.Id="test.active.self";Check(Fire(source,middle,own),"水体自身通过普通流散及导电操作正式施放");await Advance(2.1f);var self=waves.Single(w=>w.AbilityId==own.Id);Check(self.Targets.Contains(middle.id)&&self.WaterCasts.SequenceEqual(new[]{self.CastId})&&contacts.All(c=>c.AbilityId!=own.Id),"同一部位的实际流散水格可作为入口和导体，不伪造直接接触");Check(self.HealthBefore.Zip(self.HealthAfter,(a,b)=>a>b).All(v=>v)&&WorldMaterialService.Count==0,"自身活动水体实际扣血，仍无世界材料或新投掷物");
 foreach(var p in World.world.units.dict.Values.ToArray()){Cultiway.Content.Combat.CombatStatusEffects.RemoveStatus(p,hold);p.GetExtend().MarkCultiwayStatsDirty();p.setStatsDirty();p.updateStats();}SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,actor=source.id,target=middle.id,definition=own,world=Cultiway.ModClass.I.WorldSaves.World.Capture(World.world,"active-water")},Formatting.Indented));
 var result=new{passed=true,checks,native=first.Route.Length,active=second.Route.Length,zeroForce=water.RemainingForce(0),self=self.Route.Length};File.WriteAllText(Path.Combine(folder,"runtime.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{ActiveWaterCallback.AfterDamage=null;hook.UnpatchSelf();ConstructedAbilityService.ConductionConfirmed-=Wave;ConstructedAbilityService.ContactConfirmed-=Contact;Config.paused=true;}
public static class ActiveWaterCallback
{
 public static Action<GetHitEvent> AfterDamage;
 public static void Postfix(GetHitEvent __0)=>AfterDamage?.Invoke(__0);
}
