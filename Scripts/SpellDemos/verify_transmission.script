// 实际写书、城市与宗门存放、原版阅读、功法领悟及正式保存。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using System.Threading.Tasks;
using Friflo.Engine.ECS;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using Cultiway.Core;
using Cultiway.Core.Components;
using Cultiway.Core.Skills;
using Cultiway.Core.ControlledTasks;
using Cultiway.Content;
using Cultiway.Content.Components;
using Cultiway.Content.Extensions;
using Cultiway.Content.Libraries;
using Cultiway.Content.Skills;
using Cultiway.Content.Sects;
using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Static|BindingFlags.Instance;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/transmission");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new InvalidOperationException(n);checks.Add(n);Log.Info(n);}
var runnerType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=runnerType.GetProperty("Instance").GetValue(null);async Task Boundary()=>await Game.WaitUntil(()=>(bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;await Boundary();}
Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();for(int y=35;y<110;y++)for(int x=35;x<120;x++)World.world.GetTileSimple(x,y).setTileTypes(TileLibrary.soil_low,TopTileLibrary.grass_low);
Actor Make(string name,int x){var a=World.world.units.createNewUnit("human",World.world.GetTileSimple(x,72),pAdultAge:true,pSpawnWithItems:false);a.data.name=name;a.addTrait("super_health");a.GetExtend().AddComponent(new Xian{level=2,wakan=10000});a.setStatsDirty();a.updateStats();return a;}
Actor author=Make("传法作者",60),reader=Make("阅读传人",62),student=Make("功法领悟者",64);await Advance(.1f);author.joinLanguage(World.world.languages.newLanguage(author,true));author.setCulture(World.world.cultures.newCulture(author,true));var kingdom=World.world.kingdoms.makeNewCivKingdom(author);var city=World.world.cities.buildNewCity(author,author.current_tile.zone);author.joinCity(city);foreach(var a in new[]{reader,student}){a.joinCity(city);a.joinLanguage(author.language);a.setCulture(author.culture);}var add=typeof(BuildingManager).GetMethod("addBuilding",F,null,new[]{typeof(string),typeof(WorldTile),typeof(bool),typeof(bool),typeof(BuildPlacingType)},null);var library=(Building)add.Invoke(World.world.buildings,new object[]{"library_human",author.current_tile.zone.tiles.First(t=>t.building==null),false,false,BuildPlacingType.New});await Advance(.3f);
Check(author.hasCity()&&author.hasLanguage()&&author.hasCulture()&&city.getBuildingWithBookSlot()!=null,"实际城市、语言、文化与原版图书馆就绪");var owner=author.GetExtend();var access=ConstructionEditing.Access;var input=ConstructedAbilityService.ReadInspiration(owner);var original=ConstructedAbilityService.Generate(owner,60,input);original.Id="test.transmission.original";original.Creator=author.id;ConstructedAbilityService.Register(original);ConstructedAbilityService.Learn(owner,original.Id);string originalJson=JsonConvert.SerializeObject(access.Read(original.Id));
Book first=ConstructedAbilityService.WriteBook(author,original.Id);Check(first!=null&&first.GetExtend().GetComponent<ConstructionBook>().AbilityId==original.Id&&first.data.name==original.Name,"写出的原版法术书记录确定版本及正式名称");Check(World.world.books.TryStoreBookInCity(author,first)&&!ConstructedAbilityService.CanStore(city,original.Id),"城市入库沿用原版统计并按版本去重");
var edit=new ConstructionEditSession(access.Read(original.Id));edit.Draft.Name="作者后来改造的版本";edit.Draft.Power*=2;var revised=access.Apply(owner,edit,true);Check(revised.Id!=original.Id&&first.GetExtend().GetComponent<ConstructionBook>().AbilityId==original.Id&&JsonConvert.SerializeObject(access.Read(original.Id))==originalJson,"作者后续改造不改写旧书引用或正式原术");reader.beh_book_target=first;new BehFinishReading().execute(reader);Check(ConstructedAbilityService.Knows(reader.GetExtend(),original.Id)&&!ConstructedAbilityService.Knows(reader.GetExtend(),revised.Id),"原版完成阅读行为真正学会书中旧版本");int count=access.List(reader.GetExtend()).Count;new BehFinishReading().execute(reader);Check(access.List(reader.GetExtend()).Count==count,"重读不重复学习或复制世界定义");
var kindType=typeof(ConstructedAbilityService).Assembly.GetType("Cultiway.Content.ControlledScriptureKind");var configuratorType=typeof(ConstructedAbilityService).Assembly.GetType("Cultiway.Content.ScriptureCommandConfigurator");var configurator=(IControlledTaskCommandConfigurator)Activator.CreateInstance(configuratorType,F,null,new[]{Enum.Parse(kindType,"Skill")},null);var options=configurator.GetOptions(author,"source",ControlledTaskInvocation.Empty);string key="construction:"+revised.Id;Check(options.Any(o=>o.Key==key),"附体写作来源菜单列出实际已学的新版本");var invocation=new ControlledTaskInvocation(ControlledTaskTarget.None,new Dictionary<string,IReadOnlyList<string>>{{"source",new[]{key}},{"destination",new[]{"city:"+city.id}}});Check(configurator.Validate(author,invocation).Enabled,"实际写作命令同时验证能力归属和城市位置");var context=configurator.Prepare(author,invocation);var args=new object[]{author,context,null};bool wrote=(bool)configuratorType.GetMethod("TryWrite",F).Invoke(null,args);Check(wrote&&!ConstructedAbilityService.CanStore(city,revised.Id),"准备好的原版写作命令真正创建并存入新版本书籍");
var sect=Cultiway.WorldboxGame.I.Sects.newObject();sect.Setup(author);sect.JoinSect(reader);sect.JoinSect(student);sect.AddContribution(reader,1000);Check(ConstructedAbilityService.TryPickBook(author,out var destination,out string selected)&&selected==revised.Id,"自主写书选择缺少该版本的宗门位置");int prior=sect.Scriptures.Count;new Cultiway.Content.Behaviours.BehWriteSkillbook().execute(author);Check(sect.Scriptures.Count==prior+1&&sect.Scriptures.ContainsConstruction(revised.Id),"原有自主写书行为真正贡献构造书并更新藏书分类");Check(SectScriptureStudyService.TryStudy(reader),"宗门学习规划可选择尚未学会的构造书并支付贡献");new BehFinishReading().execute(reader);Check(ConstructedAbilityService.Knows(reader.GetExtend(),revised.Id),"宗门书籍经原版阅读路径学会确定修订");
var gong=CultibookRuleComposer.CreateDraft(owner);Check(gong.ConstructionPool.Any(e=>e.AbilityId==revised.Id),"实际编写功法自动纳入作者已学的构造");gong.ConstructionPool=new List<ConstructionInheritance>{new ConstructionInheritance{AbilityId=original.Id,BaseChance=.01f,MasteryThreshold=20,LevelRequirement=2}};Cultiway.Content.Libraries.Manager.CultibookLibrary.AddDynamic(gong);owner.Master(gong,100);Book gongBook=World.world.books.WriteCultibookBook(author,gong,100);student.beh_book_target=gongBook;new BehFinishReading().execute(student);Check(student.GetExtend().GetMainCultibook()==gong&&!student.GetExtend().TryComprehendSkill(),"阅读功法进入原有主修流程，掌握不足时不能跳过领悟条件");var learner=student.GetExtend();var study=learner.GetComponent<ActorCultibookState>();study.MainMastery=100;learner.AddComponent(study);int selectedSeed=1;for(;selectedSeed<10000;selectedSeed++){Randy.resetSeed(selectedSeed);if(Randy.random()>.95f)break;}Randy.resetSeed(selectedSeed);Check(!learner.TryComprehendSkill()&&learner.GetComponent<ActorCultibookState>().ConstructionProgress[original.Id]>0,"未成功的正常领悟保留稳定编号进度");
var improved=CultibookRuleComposer.CreateImprovedDraft(gong,owner);Check(improved.ConstructionPool.Any(e=>e.AbilityId==original.Id)&&!ReferenceEquals(improved.ConstructionPool[0],gong.ConstructionPool[0]),"功法改进保留原版本传承并复制条件，未改写原功法");Cultiway.Content.Libraries.Manager.CultibookLibrary.AddDynamic(improved);owner.Master(improved,100);reader.GetExtend().E.AddRelation(new MasterApprenticeRelation{Master=owner.E,RelationTypeId=Cultiway.Content.MasterApprenticeTypes.Nominal.id});Check(owner.TeachCultibook(reader.GetExtend(),gong)&&reader.GetExtend().GetMainCultibook()==gong&&gong.ConstructionPool.Any(e=>e.AbilityId==original.Id),"已有师徒传功入口保留同一功法及其确定版本传承");Check(World.world.books.TryStoreBookInCity(author,gongBook),"功法书也进入实际城市书库，避免留下未提交书籍");
string person=Cultiway.ModClass.I.WorldSaves.Actors.Capture(learner,"transmission");string world=Cultiway.ModClass.I.WorldSaves.World.Capture(World.world,"transmission");Check(world.Contains("skillbook.construction")&&world.Contains("ConstructionPool")&&world.Contains("Constructions"),"书籍引用、功法传承与稳定进度进入正式世界资料");World.world.books.checkLists();var snapshot=SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));Check(new[]{first.id,gongBook.id}.All(id=>snapshot.books.Any(b=>b.id==id)),"原版书籍保存列表确实包含法术和功法书");Check(new[]{author.id,reader.id,student.id}.All(id=>snapshot.actors_data.Any(a=>a.id==id)),"三名实际原版人物都在世界文件中");File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,author=author.id,reader=reader.id,student=student.id,first=first.id,sect=sect.id,city=city.id,gong=gong.id,improved=improved.id,original=access.Read(original.Id),revised=access.Read(revised.Id),progress=learner.GetComponent<ActorCultibookState>().ConstructionProgress[original.Id]},Formatting.Indented));var result=new{passed=true,checks,original=original.Name,revised=revised.Name,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"runtime.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
