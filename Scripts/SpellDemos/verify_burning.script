// 正式施放验证部分加热、水冷却、分枝传播、有限损耗及燃烧中的世界保存。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Usage;
using Cultiway.Content.Skills;
using Cultiway.Content.Components;
using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/burning");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}
async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;var t=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=t.GetProperty("Instance").GetValue(null);await Game.WaitUntil(()=>(bool)t.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);}
Config.paused=true;Game.Resume();Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;for(int y=40;y<110;y++)for(int x=30;x<124;x++)World.world.GetTileSimple(x,y).setTileTypes("sand",null);
var stats=new BaseStats();stats["mana"]=1024;stats["damage"]=40;stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.BurningHold").SetStats(stats).SetDuration(10000).Build();
Actor NewActor(int x,int y){var p=World.world.units.createNewUnit("human",World.world.GetTileSimple(x,y),pAdultAge:true,pSpawnWithItems:false);p.addTrait("super_health");p.GetExtend().AddComponent(new Xian{level=2,wakan=100});Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(p,hold,10000,p);p.GetExtend().MarkCultiwayStatsDirty();p.setStatsDirty();p.updateStats();p.setMana(512);return p;}void Place(Actor p,float x,float y){p.stopMovement();p.current_position=new Vector2(x,y);p.setCurrentTile(World.world.GetTileSimple((int)x,(int)y));p.updatePos();}
var source=NewActor(50,72);var supply=NewActor(70,72);var target=NewActor(90,72);var wolf=World.world.units.createNewUnit("wolf",World.world.GetTileSimple(12,12),pAdultAge:true);Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(wolf,hold,10000,wolf);target.setKingdom(wolf.kingdom);source.addAggro(target);target.addAggro(source);await Advance(.1f);Place(source,50,72);Place(supply,70,72);Place(target,90,72);
AbilityDefinition Spell(string name)=>JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/"+name+".json")));
bool Fire(Actor from,Actor to,AbilityDefinition d){if(from==supply)Place(supply,70,72);ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(from.GetExtend(),d.Id);bool used=ActiveAbilityService.TryUse(from.GetExtend(),new ActiveAbilityHandle("content.constructed",from.GetExtend().E,d.Id),new ActiveAbilityTarget(to,to.GetSimPos()),ActiveAbilityUseOrigin.Script);if(from==supply)Place(supply,70,96);return used;}
IList Casts()=>(IList)typeof(ConstructedAbilityService).GetField("casts",F).GetValue(null);AbilityCast Running(string id)=>Casts().Cast<object>().Select(r=>(AbilityCast)r.GetType().GetField("Cast",F).GetValue(r)).Single(c=>c.Plan.Id==id&&!c.Finished);void Cancel(){foreach(object r in Casts())((AbilityCast)r.GetType().GetField("Cast",F).GetValue(r)).Cancel();}
AbilityDefinition Wood(string id,bool children=false){var d=Spell("可燃分枝");d.Id=id;d.Root.Scale=1;d.Root.Volume=4;d.Root.Offset=new float[3];d.Lifetime=8;if(!children)d.Root.Children=Array.Empty<ConstructionNode>();else{d.Root.Children[0].Scale=1;d.Root.Children[0].Volume=1;d.Root.Children[0].Children[0].Scale=1;d.Root.Children[0].Children[0].Volume=1;}return d;}
AbilityDefinition Flame(string id,float power){var d=Spell("点木流火");d.Id=id;d.Power=power;d.Root.Scale=.5f;return d;}
var events=new List<ConstructedBurning>();void Burn(ConstructedBurning e)=>events.Add(e);ConstructedAbilityService.BurningConfirmed+=Burn;
try{
var wood=Wood("test.burning.partial");Check(Fire(supply,supply,wood),"友方可燃木体正式学习支付并生成");var body=Running(wood.Id);double volume=body.RemainingVolume(0);var weak=Flame("test.burning.weak",.001f);Check(Fire(source,target,weak),"弱火从正式力量预算接触木体");await Advance(2f);Check(body.Burning(0).Heat>0&&!body.Burning(0).Lit&&body.RemainingVolume(0)==volume,"不足点火量只留下真实热量，木料保持完整");Check(events.Any(e=>e.Kind=="heat"&&!e.Lit&&e.Source==source.id),"实际弱火加热保留原来源，不伪造已点燃事件");var water=Spell("蓄水御炎");water.Id="test.burning.cooling-water";water.Root.Volume=32;water.Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Flow).Flow.Size=8;Check(Fire(supply,supply,water),"普通水体正式施放后冷却木体");await Advance(.3f);Check(body.Burning(0).Heat==0&&!body.Burning(0).Lit&&body.RemainingVolume(0)==volume,"水真实吸热，未点燃木料不凭空烧损");Check(events.Any(e=>e.Kind=="cool"&&e.Transferred>0),"冷却有实际数量和结果，不依赖蒸汽画面");
Cancel();await Advance(.1f);events.Clear();var tree=Wood("test.burning.tree",true);Check(Fire(supply,supply,tree),"多部位分枝通过普通构造生成");var cast=Running(tree.Id);var flame=Flame("test.burning.ignition",.02f);Check(Fire(source,target,flame),"低矮火体点燃主干，不直接覆盖高处分枝");await Advance(1.5f);Check(cast.Burning(0).Lit&&cast.Burning(0).Burned>0,"主干从真实接触后持续消耗有限燃料");await Advance(1f);Check(cast.Burning(1).Lit&&cast.Burning(2).Lit,"火沿实际相接的主干与分枝传播");Check(events.Where(e=>e.Kind=="heat"&&e.CastId>0).Select(e=>e.Node).Distinct().Count()==3,"分枝分别接收热量，各部位独立记录");Check(events.Where(e=>e.Kind=="heat").All(e=>e.Source==source.id),"燃料传火仍保留原点火者，木体控制者不冒领来源");await Advance(3.5f);Check(Enumerable.Range(0,3).All(n=>cast.RemainingVolume(n)==0),"主干及分枝最终按各自有限燃料烧尽");Check(Enumerable.Range(0,3).All(n=>cast.RemainingResource(n)==0),"烧尽材料无法返还原支付");Check(events.Where(e=>e.Kind=="burn").Any(e=>e.Volume==0&&e.Burned>0),"结束结果保留真正累计烧损");
Cancel();await Advance(.1f);events.Clear();var left=Wood("test.burning.world");left.Lifetime=2;left.Root.Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Leave,At=0,Residue=new ConstructionResidue{Lifetime=0}}};Check(Fire(supply,supply,left),"固态木体经正式入口转交世界");await Advance(.1f);Check(WorldMaterialService.Count>0,"原施放结束后独立木体仍存在");flame=Flame("test.burning.world-fire",.02f);Check(Fire(source,target,flame),"活动火体接触独立世界木体");await Advance(1.5f);Check(events.Any(e=>e.WorldId>0&&e.Kind=="heat"&&e.Lit),"世界木体真正点燃，不依赖旧施放容器");var before=JObject.Parse(Cultiway.ModClass.I.WorldSaves.World.Capture(World.world,"burning"));var rows=(JArray)before["sections"]["world_materials"]["data"]["Records"];var material=rows.Single()["Material"].ToObject<AbilityMaterialData>();Check((int)before["sections"]["world_materials"]["version"]==3&&material.Burning.Value.Lit&&material.Volume<4,"正式第三版保存真实燃烧、损耗和剩余份额");Cancel();await Advance(.1f);foreach(var p in World.world.units.dict.Values.ToArray()){Cultiway.Content.Combat.CombatStatusEffects.RemoveStatus(p,hold);p.GetExtend().MarkCultiwayStatsDirty();p.setStatsDirty();p.updateStats();}SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,actor=source.id,target=target.id,world=Cultiway.ModClass.I.WorldSaves.World.Capture(World.world,"burning")},Formatting.Indented));Check(File.Exists(Path.Combine(folder,"save/map.wbox")),"燃烧进行中经过真实世界保存，恢复继续剩余过程");
var result=new{passed=true,checks,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"runtime.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{ConstructedAbilityService.BurningConfirmed-=Burn;File.WriteAllText(Path.Combine(folder,"events.json"),JsonConvert.SerializeObject(events.Select(e=>new{e.CastId,e.WorldId,e.Node,e.Source,e.Kind,e.WorldTime,e.Transferred,e.Heat,e.Volume,e.Burned,e.Lit,point=new[]{e.Point.x,e.Point.y,e.Point.z}}),Formatting.Indented));Config.paused=true;}
