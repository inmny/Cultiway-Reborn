// 4.29 C2真实结构采集：四足、原关节、不存在的部位及资源清理后重新采集。
Actor source = Make(64, "wolf");
await Game.NextFrame();
Type type = service.Assembly.GetType("Cultiway.Content.Skills.BodySurfaceBinding");
/// <summary>从同一原身体重新采集，查询不取得身体控制。</summary>
async Task<object> CaptureStructure()
{
    object binding = type.GetMethod("Create", F).Invoke(null, new object[] { source });
    float until = Time.realtimeSinceStartup + 5f;
    while (binding == null && Time.realtimeSinceStartup < until)
    {
        await Game.NextFrame();
        binding = type.GetMethod("Create", F).Invoke(null, new object[] { source });
    }
    Check(binding != null, "已有真实身体接入就绪");
    type.GetMethod("Capture", F).Invoke(binding, new object[] { (Vector3)service.Assembly.GetType("Cultiway.Content.Combat.SpatialActorPose").GetMethod("Foot", F).Invoke(null, new object[] { source }),
        (float)service.Assembly.GetType("Cultiway.Content.Combat.SpatialActorPose").GetMethod("Height", F).Invoke(null, new object[] { source }),
        World.world.getCurWorldTime() });
    object surface = Field(binding, "To");
    return binding.GetType().GetMethod("Structure", F).Invoke(binding, new[] { surface });
}
object structure = await CaptureStructure();
Check(structure != null, "实际狼形提供同轮结构");
var bones = (IDictionary)Field(structure, "Bones");
var supports = ((IEnumerable)Field(structure, "Supports")).Cast<object>().ToArray();
Check(new[] { "fl", "fr", "bl", "br" }.All(side => bones.Contains("part:leg_" + side)) && supports.Length == 4,
    "四条实际兽腿和自己的四处足底，不套用人形双足");
Check(!bones.Contains("hand.right") && !bones.Contains("part:missing") && !bones.Contains("knee.left"),
    "不存在的手掌、部位或膝关节不给出替代");
var facts = supports.Select(patch => new { part = (string)Field(patch, "Part"),
    points = ((Vector3[])Field(patch, "Points")).Select(point => new[] { point.x, point.y, point.z }).ToArray() }).ToArray();
Check(facts.All(patch => patch.points.Length > 0 && patch.points.All(point => point.All(value => !float.IsNaN(value) && !float.IsInfinity(value)))) &&
      facts.Select(patch => string.Join(",", patch.points[0])).Distinct().Count() == 4,
    "实际足底来自各自不同的有限表面", facts);
foreach (string key in new[] { "part:leg_fl", "part:leg_fr", "part:leg_bl", "part:leg_br" })
{
    object bone = bones[key];
    string parent = (string)Field(bone, "Parent");
    Check(parent == (spatial ? "part:body" : "torso"), key + "沿原身体父部位承接");
}
service.Assembly.GetType("Cultiway.Content.CreatureCompositions.Visuals.NativeCreatureRegions").GetMethod("Clear", F).Invoke(null, null);
Check(await CaptureStructure() != null && !BodyControlState.IsBusy(source.id), "清理后由原资源重新采集，没有留下临时控制");
File.WriteAllText(Path.Combine(folder, "supports.json"), JsonConvert.SerializeObject(facts, Formatting.Indented));
var joints = bones.Keys.Cast<string>().Select(key =>
{
    object bone = bones[key]; Vector3 point = (Vector3)Field(bone, "Pivot");
    Quaternion axes = (Quaternion)Field(bone, "Axes");
    return new { part = key, parent = (string)Field(bone, "Parent"),
        pivot = new[] { point.x, point.y, point.z }, axes = new[] { axes.x, axes.y, axes.z, axes.w } };
});
File.WriteAllText(Path.Combine(folder, "joints.json"), JsonConvert.SerializeObject(joints, Formatting.Indented));
return new { passed = true, closed = "真实部位、原关节和非人支撑资料采集；爪击和支撑动作尚未关闭" };
