// 静水平衡、守恒、分流、材料保持、共同薄层、回退及正式保存。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using Newtonsoft.Json;
using UnityEngine;
using Cultiway.Core;
using Cultiway.Core.Skills;
using Cultiway.Core.Visuals.Forms;
using Cultiway.Content.Skills;
using Cultiway.Content.Components;
using Cultiway.Utils.Extension;
const BindingFlags Flags=BindingFlags.Instance|BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/flow");Directory.CreateDirectory(folder);
var checks=new List<string>();void Check(bool v,string n){if(!v)throw new InvalidOperationException(n);checks.Add(n);}
AbilityHeightField Field(Func<float,float,float> f){var values=new float[128*128];for(int y=0;y<128;y++)for(int x=0;x<128;x++)values[y*128+x]=f(x+.5f,y+.5f);return new AbilityHeightField(128,128,new Vector2(128,128),values);}
AbilityDefinition Basic()=>new AbilityDefinition{Id="test.flow",Resource="none",Cost=0,Lifetime=6,Binding=new ConstructionBinding{Anchor=AbilityAnchor.Source},Root=new ConstructionNode{Id="water",Form="water_flow",Matter="water",Volume=12,Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Flow,Flow=new ConstructionFlow{Cells=32,Size=24,Drag=0,Evaporation=0,OpenBoundary=false}}}}};
AbilityCast Cast(AbilityDefinition d,AbilityHeightField field=null)=>new(AbilityCompiler.Compile(d),Matrix4x4.identity,inputs:new AbilityInputs(new Vector3(64,72),new Vector3(76,72),Vector3.right,1),force:20,terrain:field);
FormVisualInstance View(AbilityCast c){var list=new List<FormVisualInstance>();c.AppendVisuals(list);return list.Single();}
List<AbilityCapsule> Shapes(AbilityCast c){var list=new List<AbilityCapsule>();c.AppendContacts(list);return list;}
object Flow(AbilityCast c)=>((Array)typeof(AbilityCast).GetField("flows",Flags).GetValue(c)).GetValue(0);
var flat=Field((x,y)=>0);var d=Basic();var c=Cast(d,flat);Check(Math.Abs(c.RemainingVolume(0)-12)<.00001,"实际体积从输入进入流散，不由作用胶囊数复制");var initial=View(c).Layer;Check(initial!=null&&initial.Cells==32,"正式显示实例包含共同数值曲面");var oldDepth=Enumerable.Range(0,32).SelectMany(y=>Enumerable.Range(0,32).Select(x=>initial.Depth(x,y))).ToArray();c.Advance(2,Vector3.zero);var later=View(c).Layer;Check(Math.Abs(c.RemainingVolume(0)-12)<.0001,"闭合平地流散保持十二立方格体积");Check(Enumerable.Range(0,32).SelectMany(y=>Enumerable.Range(0,32).Select(x=>initial.Depth(x,y))).SequenceEqual(oldDepth),"推进不会修改已经发布的水深数组");Check(!Enumerable.Range(0,32).SelectMany(y=>Enumerable.Range(0,32).Select(x=>later.Depth(x,y))).SequenceEqual(oldDepth),"曲面由真实水深演化而非整片平移");
var lakeTerrain=Field((x,y)=>.04f*x+.02f*y);c=Cast(Basic(),lakeTerrain);var flow=Flow(c);var flowType=flow.GetType();var water=(Vector3[])flowType.GetField("Water",Flags).GetValue(flow);var ground=(float[])flowType.GetField("Ground",Flags).GetValue(flow);float level=ground.Max()+.5f;for(int i=0;i<water.Length;i++)water[i]=new Vector3(level-ground[i],0,0);c.Advance(1,Vector3.zero);float lakeSpeed=water.Max(u=>new Vector2(u.y,u.z).magnitude/Mathf.Max(.000001f,u.x));Check(lakeSpeed<.0001f,"不同地面上的静水平衡不会自己产生水流");
var moving=Basic();moving.Root.Operations=moving.Root.Operations.Prepend(new ConstructionOperation{Kind=ConstructionOperationKind.Fly,Vector=new[]{4f,0f,0f},WorldVelocity=true,InheritVelocity=false}).ToArray();var obstacle=Field((x,y)=>x>=68&&x<=70&&Mathf.Abs(y-74)<1.5f?4f:0f);c=Cast(moving,obstacle);c.Advance(2.4f,Vector3.zero);var split=View(c).Layer;double north=0,south=0,blocked=0;for(int y=0;y<split.Cells;y++)for(int x=0;x<split.Cells;x++){float wx=split.Origin.x+(x+.5f)*split.Cell,wy=split.Origin.y+(y+.5f)*split.Cell;double v=split.Depth(x,y)*split.Cell*split.Cell;if(wx>70){if(wy>75.5f)north+=v;if(wy<72.5f)south+=v;}if(obstacle.Sample(wx,wy)>3)blocked+=v;}Check(north>.001&&south>.001&&blocked<.0001,"真实水量绕过高处形成两侧分流，高障碍保持干燥");
var decay=Basic();decay.Root.Operations[0].Flow.OpenBoundary=true;decay.Root.Operations[0].Flow.Size=12;decay.Root.Operations[0].Flow.Evaporation=.4f;decay.Root.Operations=decay.Root.Operations.Prepend(new ConstructionOperation{Kind=ConstructionOperationKind.Fly,Vector=new[]{6f,0f,0f},WorldVelocity=true,InheritVelocity=false}).ToArray();c=Cast(decay,flat);c.Advance(2.5f,Vector3.zero);var amount=View(c).Layer;double accountingError=Math.Abs(amount.Volume+amount.Escaped+amount.Evaporated-12);Check(amount.Escaped>0&&amount.Evaporated>0&&accountingError<.0001,"剩余、外流及蒸散共同守恒，去向不会重复分配");
var save=typeof(AbilityCast).GetMethod("SaveStep",Flags);var restore=typeof(AbilityCast).GetMethod("RestoreStep",Flags);c=Cast(moving,obstacle);c.Advance(.3f,Vector3.zero);save.Invoke(c,null);c.Advance(.4f,Vector3.zero);var expected=View(c).Layer;restore.Invoke(c,null);c.Advance(.4f,Vector3.zero);var repeated=View(c).Layer;Check(Enumerable.Range(0,32).SelectMany(y=>Enumerable.Range(0,32).Select(x=>expected.Depth(x,y))).SequenceEqual(Enumerable.Range(0,32).SelectMany(y=>Enumerable.Range(0,32).Select(x=>repeated.Depth(x,y))))&&expected.Volume==repeated.Volume,"预测回退恢复全部水深、动量及体积，重放完全相同");
var frozen=Basic();frozen.Root.Operations=frozen.Root.Operations.Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.ConvertMatter,Matter="ice",At=.3f},new ConstructionOperation{Kind=ConstructionOperationKind.ConvertMatter,Matter="water",At=.8f}}).ToArray();c=Cast(frozen,flat);c.Advance(.4f,Vector3.zero);var ice=View(c).Layer;c.Advance(.2f,Vector3.zero);var held=View(c).Layer;Check(Enumerable.Range(0,32).All(y=>Enumerable.Range(0,32).All(x=>ice.Depth(x,y)==held.Depth(x,y))),"冻结保留当时实际流散形状");c.Advance(.4f,Vector3.zero);var melted=View(c).Layer;Check(!c.IsShapeHeld(0)&&Enumerable.Range(0,32).Any(y=>Enumerable.Range(0,32).Any(x=>ice.Depth(x,y)!=melted.Depth(x,y))),"解冻继续真实流动");
var handoff=Basic();handoff.Root.Scale=.5f;handoff.Root.Volume=16;handoff.Root.Operations=Array.Empty<ConstructionOperation>();handoff.Root.DisappearAt=.5f;handoff.Root.Children=new[]{new ConstructionNode{Id="after",Form="water_flow",Matter="water",Scale=2,Volume=999,Activation=new ConstructionActivation{Trigger=ConstructionChangeTrigger.End,InheritRemainder=true},Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Flow,Flow=new ConstructionFlow{Cells=16,Evaporation=0,OpenBoundary=false}}}}};c=Cast(handoff,flat);c.Advance(.6f,Vector3.zero);Check(c.RemainingVolume(0)==0&&Math.Abs(c.RemainingVolume(1)-2)<.00001,"结束交接保留已缩放的真实体积，后段不能以999补满");
c=Cast(Basic(),flat);var shapes=Shapes(c);Check(shapes.Count>0&&shapes.All(s=>s.IsBox&&s.Radius==0&&s.HalfExtents.z>0),"实际作用采用有限厚度的薄层箱体");var sample=shapes.OrderByDescending(s=>s.HalfExtents.z).First();Check(sample.Intersects(sample.A,0)&&!sample.Intersects(sample.A+Vector3.forward*(sample.HalfExtents.z+.2f),0),"水面上方的空气不因水平宽度获得伤害");
var meshType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Visuals.Forms.FormLayerMeshes");var mesh=(Mesh)meshType.GetMethod("Get",Flags).Invoke(null,new object[]{View(c).Layer});Check(mesh.vertexCount>0&&mesh.vertices.All(v=>Vector3.Distance(v,mesh.bounds.ClosestPoint(v))<.00002f),"真正上传的动态水面有几何且位于共同边界内");
var triangles=mesh.triangles;var vertices=mesh.vertices;Check(Enumerable.Range(0,triangles.Length/3).All(i=>Vector3.Cross(vertices[triangles[i*3+1]]-vertices[triangles[i*3]],vertices[triangles[i*3+2]]-vertices[triangles[i*3]]).z<=.000001f)&&mesh.normals.All(n=>n.z>0),"动态水面遵守模型正面顺序，水面法向朝上");
var conditional=Basic();conditional.Root.OnContact=ConstructionContactResponse.Stop;conditional.Root.Operations[0].When=new ConstructionCondition{Trigger=ConstructionChangeTrigger.ActorContact,Source="."};var changed=Cast(conditional,flat);changed.Advance(.2f,Vector3.zero);var beforeConversion=Shapes(changed).First();changed.ConfirmContact(0,.5f);Check(!changed.IsCurrent(beforeConversion),"转换曲面使旧模型作用形状立即失效");var stopped=View(changed).Layer;changed.Advance(.2f,Vector3.zero);var continued=View(changed).Layer;Check(stopped!=null&&Enumerable.Range(0,32).Any(y=>Enumerable.Range(0,32).Any(x=>stopped.Depth(x,y)!=continued.Depth(x,y))),"接触停止后由真实条件转入流散，不被旧运动停止状态卡住");
var dense=Basic();dense.Root.Volume=1000000;dense.Root.Operations[0].Flow.Size=.1f;var packed=Cast(dense,flat);var coarse=View(packed).Layer;packed.Advance(.02f,Vector3.zero);Check(coarse.Cell>.1f/32&&Math.Abs(packed.RemainingVolume(0)-1000000)<1,"高压输入扩大数值格宽，保持体积并正常推进");
var drying=Basic();drying.Root.Operations[0].Flow.Gravity=0;drying.Root.Operations[0].Flow.Evaporation=10;var transient=Cast(drying,flat);var wet=View(transient).Layer;float highest=Enumerable.Range(0,32).SelectMany(y=>Enumerable.Range(0,32).Select(x=>wet.Depth(x,y))).Max();transient.Advance(Mathf.Log(highest/(wet.DryDepth*1.5f))/10,Vector3.zero);save.Invoke(transient,null);transient.Advance(.1f,Vector3.zero);var tail=new List<AbilityCapsule>();transient.AppendContacts(tail,true);Check(tail.Any(s=>s.Until>0&&s.Until<1)&&Shapes(transient).Count==0,"消退格保留真正湿润的最后路径，干燥之后不继续命中");
var harmless=Cast(Basic(),flat);typeof(AbilityCast).GetMethod("ConsumeForce",Flags).Invoke(harmless,new object[]{0,20f});harmless.Advance(.2f,Vector3.zero);Check(!harmless.Finished&&Math.Abs(harmless.RemainingVolume(0)-12)<.0001&&View(harmless).Layer!=null&&Shapes(harmless).Count==0,"攻击力量耗尽不消灭已经存在的水量，残留继续流动且不再伤人");
int meshVertices=mesh.vertexCount;
var bad=Basic();bad.Root.Operations[0].Flow.Cells=4096;try{AbilityCompiler.Compile(bad);throw new Exception("未拒绝无界网格");}catch(InvalidDataException){checks.Add("无界网格在资料边界拒绝");}
Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;var actor=World.world.units.createNewUnit("human",World.world.GetTileSimple(64,72),pAdultAge:true,pSpawnWithItems:false);actor.data.name="守恒流散保存验证";var owner=actor.GetExtend();owner.AddComponent(new Xian{level=2,wakan=10000});foreach(string name in new[]{"鲸散守恒后流","缓坡守恒流"}){var definition=JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/"+name+".json")));ConstructedAbilityService.Register(definition);ConstructedAbilityService.Learn(owner,definition.Id);}Config.paused=false;await Game.WaitUntil(()=>World.world.units.getSimpleList().Any(a=>a.id==actor.id),1800);Config.paused=true;SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));var saves=Cultiway.ModClass.I.WorldSaves;File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,actor=actor.id,world=saves.World.Capture(World.world,"flow"),person=saves.Actors.Capture(owner,"flow")},Formatting.Indented));var result=new{passed=true,checks,lakeSpeed,accountingError,north,south,blocked,meshVertices};File.WriteAllText(Path.Combine(folder,"checks.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
