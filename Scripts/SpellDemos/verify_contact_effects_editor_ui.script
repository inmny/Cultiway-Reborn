// 经真实表单编辑目标关系和接触作用，保存后重新打开；不写玩家世界。

using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using UnityEngine;
using UnityEngine.UI;
using Cultiway.Core;
using Cultiway.Core.Skills;
using Cultiway.Content.Skills;
using Cultiway.Content.Components;
using Cultiway.UI;
using Cultiway.UI.Prefab;
using Cultiway.Utils.Extension;
const BindingFlags Flags = BindingFlags.Instance | BindingFlags.Static | BindingFlags.Public |
                           BindingFlags.NonPublic;
object Field(object value, string key) => value.GetType().GetField(key, Flags).GetValue(value);
string root = Cultiway.ModClass.I.GetDeclaration().FolderPath,
    folder = Path.Combine(root, "artifacts/skill_rebuild/contact-effects/ui");
Directory.CreateDirectory(folder);
var checks = new List<string>();

void Check(bool value, string name)
{
    if (!value) throw new InvalidOperationException(name);
    checks.Add(name);
}

string T(string key) => LocalizedTextManager.getText("Cultiway.Construction." + key);

async Task Frames(int count = 3)
{
    for (int i = 0; i < count; i++) await Game.NextFrame();
    await Game.WaitUntil(() => !ScrollWindow.isAnimationActive(), 300);
    Canvas.ForceUpdateCanvases();
}

async Task Shot(string name)
{
    World.world.console.Hide();
    Tooltip.hideTooltipNow();
    foreach (var loading in Resources.FindObjectsOfTypeAll<LoadingScreen>())
        loading.gameObject.SetActive(false);
    await Frames(4);
    Screen.Capture(Path.Combine(folder, name + ".png"));
    await Frames();
}

Config.paused = true;
Game.Resume();
World.world.save_manager.loadWorld(Path.Combine(root, "Scripts/WorldSaveTests/Fixtures/world-format-1"));
await Game.WaitUntil(() => !SmoothLoader.isLoading(), 1800);
Config.paused = true;
var actor = World.world.units.createNewUnit("human", World.world.GetTileSimple(64, 72), pAdultAge: true,
    pSpawnWithItems: false);
actor.data.name = "接触作用编辑验证";
actor.addTrait("super_health");
var owner = actor.GetExtend();
owner.AddComponent(new Xian { level = 2, wakan = 10000 });
var original =
    JsonConvert.DeserializeObject<AbilityDefinition>(
        File.ReadAllText(Path.Combine(root, "Doc/技能系统全面重构/构造输入/翻卷厚浪.json")));
ConstructedAbilityService.Register(original);
ConstructedAbilityService.Learn(owner, original.Id);
LocalizedTextManager.instance.setLanguage("cz");
await Frames();
WindowWanfaConstructionEditor.Open(original.Id, actor);
await Frames();
var editor =
    (WindowWanfaConstructionEditor)typeof(WindowWanfaConstructionEditor).GetField("instance", Flags)
        .GetValue(null);
Button B(string name) => editor.GetComponentsInChildren<Button>(false).First(b => b.name == name);

void Click(string name)
{
    Check(B(name).interactable, "按钮可用：" + name);
    B(name).onClick.Invoke();
}

InputField Input(string key) => editor.GetComponentsInChildren<InputField>(false).First(f => f.name == key);

void Set(string key, string value)
{
    var field = Input(key);
    field.text = value;
    field.onEndEdit.Invoke(value);
}

ConstructionEditSession Session() => (ConstructionEditSession)Field(editor, "session");

WanfaEditorRow Row(string key) => editor.GetComponentsInChildren<WanfaEditorRow>(false)
    .First(r => ((Text)Field(r, "_title")).text == T(key));

void Action(string key) => ((Button)Field(Row(key), "_action")).onClick.Invoke();

void Argument(string key, string text)
{
    var input = Row(key).GetComponentsInChildren<InputField>(false).Single();
    input.text = text;
    input.onEndEdit.Invoke(text);
}

Click("Page4");

void ToggleValue(string key, bool value) =>
    Row(key).GetComponentsInChildren<Toggle>(false).Single().isOn = value;

void Choose(string key, string text)
{
    Action(key);
    var button = editor.GetComponentsInChildren<Button>(false).Single(b =>
        b.name.StartsWith("Option") && b.GetComponentInChildren<Text>().text == text);
    button.onClick.Invoke();
}

Check(Session().Draft.Impact == null, "打开接触页不会自行修改缺省资料");
ToggleValue("CustomImpact", true);
Choose("Targets", T("Relation.Friendly"));
Set("DamageScale", "0");
Set("Force", "-8");
Set("Lift", "0.4");
Set("StaggerSeconds", "0.3");
Set("BindSeconds", "0.7");
Check(
    Session().Draft.Impact.Targets == Cultiway.Core.SkillLibV3.Usage.SkillUseTargetRelation.Friendly &&
    Session().Draft.Impact.DamageScale == 0 && Session().Draft.Impact.Force == -8, "真实表单设置友方纯牵引");
ToggleValue("NodeImpact", true);
Choose("NodeTargets", T("Relation.Hostile"));
Set("NodeForce", "9");
Choose("NodeForceOrigin", T("ForceOrigin.Shape"));
Check(
    Session().Draft.Root.Impact.Targets == Cultiway.Core.SkillLibV3.Usage.SkillUseTargetRelation.Hostile &&
    Session().Draft.Root.Impact.Origin == ConstructionForceOrigin.Shape &&
    Session().Draft.Root.Impact.Lift == .4f, "部位覆盖从整招独立复制并可选择自己的关系和中心");
Set("NodeLift", "0");
Check(!B("LearnCopy").interactable, "无法产生位移的零离地推拉阻止保存");
Click("Undo");
Check(Session().Draft.Root.Impact.Lift == .4f, "撤销恢复有效的完整部位作用");
Set("NodeSlideSeconds", "0.25");
Set("NodeStaggerSeconds", "0.4");
Set("NodeBindSeconds", "0.2");
Check(
    Session().Draft.Impact.StaggerSeconds == .3f && Session().Draft.Impact.BindSeconds == .7f &&
    Session().Draft.Root.Impact.SlideSeconds == .25f && Session().Draft.Root.Impact.StaggerSeconds == .4f &&
    Session().Draft.Root.Impact.BindSeconds == .2f, "真实表单分别设置整招与部位的停顿、束缚和贴地历时");
Check(!editor.GetComponentsInChildren<InputField>(false).Any(f => f.name == "NodeLift"), "沿地推拉不显示无效的离地设置");

async Task ShotRow(string key, string name)
{
    await Frames();
    RectTransform row = (RectTransform)Row(key).transform;
    ScrollRect scroll = row.GetComponentInParent<ScrollRect>();
    Vector3 local = scroll.content.InverseTransformPoint(row.TransformPoint(row.rect.center));
    float offset = scroll.content.rect.yMax - local.y - scroll.viewport.rect.height * .5f;
    scroll.verticalNormalizedPosition = 1f -
                                        Mathf.Clamp01(offset / Mathf.Max(1f,
                                            scroll.content.rect.height - scroll.viewport.rect.height));
    await Shot(name);
}

await ShotRow("StaggerSeconds", "reaction-fields-cz");
await ShotRow("NodeStaggerSeconds", "reaction-part-fields-cz");
await Shot("impact-cz");
Click("Replace");
string id = Session().SourceId;
var saved = ConstructionEditing.Access.Read(id);
Check(
    saved.Impact.Force == -8 && saved.Root.Impact.Force == 9 &&
    saved.Root.Impact.Origin == ConstructionForceOrigin.Shape, "正式替换保存整招与部位不同的实际作用");
Click("Close");
await Frames();
WindowWanfaConstructionEditor.Open(id, actor);
await Frames();
Click("Page4");
Check(
    Session().Draft.Impact.Targets == Cultiway.Core.SkillLibV3.Usage.SkillUseTargetRelation.Friendly &&
    Session().Draft.Root.Impact.Force == 9, "重新打开恢复筛选、推拉和部位覆盖");
Check(
    Session().Draft.Impact.StaggerSeconds == .3f && Session().Draft.Root.Impact.BindSeconds == .2f &&
    Session().Draft.Root.Impact.SlideSeconds == .25f, "正式替换和重开保留新增作用字段");
LocalizedTextManager.instance.setLanguage("en");
Click("Page4");
await ShotRow("StaggerSeconds", "reaction-fields-en");
await ShotRow("NodeStaggerSeconds", "reaction-part-fields-en");
await Shot("impact-en");
Check(((Text)Field(Row("Targets"), "_title")).text == "Default target relation", "新增接触表单随原版切换英文");
int width = UnityEngine.Screen.width, height = UnityEngine.Screen.height;
bool full = UnityEngine.Screen.fullScreen;
UnityEngine.Screen.SetResolution(1024, 768, false);
await Frames(8);
await ShotRow("NodeStaggerSeconds", "reaction-part-fields-en-1024");
await Shot("impact-en-1024");
var corners = new Vector3[4];
((RectTransform)editor.transform.Find("Background")).GetWorldCorners(corners);
Check(
    corners.All(p =>
        p.x >= 0 && p.y >= 0 && p.x <= UnityEngine.Screen.width && p.y <= UnityEngine.Screen.height),
    "五页导航及接触表单在1024分辨率保持窗口边界");
ToggleValue("NodeImpact", false);
Check(Session().Draft.Root.Impact == null, "关闭部位覆盖恢复继承，移除额外资料");
Click("Undo");
Click("Close");
await Frames();
UnityEngine.Screen.SetResolution(width, height, full);
LocalizedTextManager.instance.setLanguage("cz");
await Frames(8);
WindowWanfaConstructionEditor.Open(BodyActionCatalog.PalmId, actor);
await Frames();
Click("Page4");
ToggleValue("CustomImpact", true);
Set("DamageScale", "0");
Set("Force", "0");
ToggleValue("Launch", true);
Set("Lift", "2");
Check(Session().Draft.Impact.Launch && Session().Draft.Impact.Lift == 2 && B("LearnCopy").interactable,
    "身体也能在表单中明确选择独立腾起");
Set("Force", "8");
Check(Session().Draft.Root == null && Session().Draft.Impact.Force == 8 && B("LearnCopy").interactable,
    "纯身体也能使用同一接触作用表单，无需添加生成形体");
Click("Undo");
Click("Undo");
Click("Undo");
Click("Close");
await Frames();
var result = new { passed = true, checks, id };
File.WriteAllText(Path.Combine(folder, "checks.json"),
    JsonConvert.SerializeObject(result, Formatting.Indented));
return result;
