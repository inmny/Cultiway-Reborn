Actor source = Make(60); var owner = source.GetExtend();
owner.NewCultisys(Cultisyses.Xian); owner.GetCultisys<Xian>().level = 2;
owner.MarkCultiwayStatsDirty(); source.setStatsDirty(); source.updateStats();
var active = new List<AbilityCast>(); var materials = new List<WorldMaterialChange>();
void Started(ConstructedCastStarted fact)
{
    if (fact.SourceId != source.id) return;
    foreach (object running in (IEnumerable)service.GetField("casts", F).GetValue(null))
        if ((long)Field(running, "Id") == fact.CastId) active.Add((AbilityCast)Field(running, "Cast"));
}
void Changed(WorldMaterialChange fact) { if (fact.Provider == source.id) materials.Add(fact); }
JObject Section() => (JObject)JObject.Parse(Cultiway.ModClass.I.WorldSaves.World.Capture(World.world, "process-time"))["sections"]["world_materials"];
JToken Material(long id) => ((JArray)Section()["data"]["Records"]).Single(value => (long)value["Id"] == id)["Material"];
long Left(AbilityDefinition definition) => materials.Single(value => value.AbilityId == definition.Id && value.Kind == "leave").Id;
bool Close(double a, double b) => Math.Abs(a - b) < .0001;
async Task<AbilityCast> Cast(AbilityDefinition definition)
{
    Input(definition, definition.Id.Split('.').Last());
    Ready(source); await Advance(.15f); Place(source, 60);
    owner.GetCultisys<Xian>().wakan = source.stats[BaseStatses.MaxWakan.id] * .8f;
    float balance = owner.GetCultisys<Xian>().wakan;
    await Fire(definition, source, null, aim: new Vector3(66, 72, 2), aggro: false);
    owner.E.RemoveComponent<ConstructedKnowledge>();
    Check(Close(balance - owner.GetCultisys<Xian>().wakan, definition.Cost), "正式施放各支付一次原价");
    return active.Last();
}
AbilityDefinition Target(string suffix, ConstructionResidue residue)
{
    var definition = RequestDefinition(suffix); definition.Cost = 3; definition.Root.Matter = "wood"; definition.Root.Volume = 8;
    definition.Steps = Array.Empty<ConstructionStep>();
    definition.Root.Operations = new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Leave, At = .05f, Residue = residue } };
    return definition;
}
