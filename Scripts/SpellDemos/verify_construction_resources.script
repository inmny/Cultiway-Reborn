// 独立世界：真实通道、动态报价、旧多资源支付、材料本金和正式保存。
using System;
using System.IO;
using System.Linq;
using System.Collections;
using System.Collections.Generic;
using System.Reflection;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core;
using Cultiway.Core.Skills;
using Cultiway.Core.SkillLibV3;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Utils;
using Cultiway.Core.SkillLibV3.Usage;
using Cultiway.Content;
using Cultiway.Content.Skills;
using Cultiway.Content.Components;
using Cultiway.Content.Combat;
using Cultiway.Content.YaoBeasts;
using Cultiway.Utils.Extension;
using Cultiway.Utils;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/resource-channels");Directory.CreateDirectory(folder);
var checks=new List<string>();void Check(bool ok,string name){if(!ok)throw new InvalidOperationException(name);checks.Add(name);Log.Info(name);}
var rt=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=rt.GetProperty("Instance").GetValue(null);
async Task Boundary()=>await Game.WaitUntil(()=>(bool)rt.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);
async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;await Boundary();}
Config.paused=true;Game.Resume();ControllableUnit.clear(false);Config.setWorldSpeed("x1",false);
World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));while(SmoothLoader.isLoading()){Config.paused=true;await Game.NextFrame();}await Boundary();
World.world.console.Hide();foreach(var screen in Resources.FindObjectsOfTypeAll<LoadingScreen>())screen.gameObject.SetActive(false);
foreach(var old in World.world.units.getSimpleList().ToArray())old.dieAndDestroy(AttackType.Other);
for(int y=65;y<82;y++)for(int x=55;x<83;x++){var tile=World.world.GetTileSimple(x,y);if(tile.building!=null)tile.building.removeBuildingFinal();tile.setTileTypes(TileLibrary.soil_low,TopTileLibrary.grass_low);}
var stats=new BaseStats{["mana"]=1000};stats.addTag("frozen_ai");stats.addTag("immovable");
var hold=Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.ResourceChannelsHold")??Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.ResourceChannelsHold").SetStats(stats).SetDuration(10000).Build();
ActorExtend Make(string type,int x){var a=World.world.units.createNewUnit(type,World.world.GetTileSimple(x,72),pAdultAge:true,pSpawnWithItems:false);a.addTrait("super_health");CombatStatusEffects.ApplyStatus(a,hold,10000,a);return a.GetExtend();}
var owner=Make("human",64);owner.AddComponent(new Xian{level=2,wakan=100});owner.AddComponent(new Magic{level=2,spirit=100});owner.AddComponent(new Knight{level=2,vigor=100});owner.MarkCultiwayStatsDirty();owner.Base.setStatsDirty();owner.Base.updateStats();owner.Base.setMana(500,false);SkillCastResources.Vigor.WriteAmount(owner,100);
var outsider=Make("human",66);if(outsider.HasCultisys<Xian>())outsider.E.RemoveComponent<Xian>();if(outsider.HasCultisys<Knight>())outsider.E.RemoveComponent<Knight>();if(outsider.HasCultisys<Magic>())outsider.E.RemoveComponent<Magic>();if(outsider.HasCultisys<Yao>())outsider.E.RemoveComponent<Yao>();outsider.MarkCultiwayStatsDirty();outsider.Base.setStatsDirty();outsider.Base.updateStats();
var beast=Make("wolf",62);if(beast.HasCultisys<Xian>())beast.E.RemoveComponent<Xian>();if(beast.HasCultisys<Knight>())beast.E.RemoveComponent<Knight>();if(beast.HasCultisys<Magic>())beast.E.RemoveComponent<Magic>();if(beast.HasCultisys<Yao>())beast.E.RemoveComponent<Yao>();Check(YaoAwakeningService.TryAwakenByRain(beast),"真实凡兽通过已有启灵入口获得妖修体系");beast.MarkCultiwayStatsDirty();beast.Base.setStatsDirty();beast.Base.updateStats();SkillCastResources.YaoPower.WriteAmount(beast,40);Check(SkillCastResources.YaoPower.ReadAmount(beast)>=10,"实际妖兽具备可支付妖力");
// 让原版新生初始化结束后设置受控余额，避免首帧补满覆盖测试费用。
await Advance(.2f);owner.Base.setMana(100,false);outsider.Base.data.stamina=50;
float multiplier=2;string customId="test.resource.dynamic";var dynamicResource=Cultiway.ModClass.I.SkillV3.CastResourceLib.get(customId);if(dynamicResource==null){dynamicResource=new SkillCastResourceAsset{id=customId};Cultiway.ModClass.I.SkillV3.CastResourceLib.add(dynamicResource);}dynamicResource.Configure(SkillCastResources.Wakan.IsAvailable,SkillCastResources.Wakan.ReadAmount,SkillCastResources.Wakan.WriteAmount,(caster,demand)=>demand*multiplier).ConfigureRecovery(SkillCastResources.Wakan.MaximumAmount);
AbilityDefinition Def(string suffix,string resource,float demand,bool recover=false,bool leave=false)=>new(){Id="test.resource."+suffix,Name="资源通道验证·"+suffix,Resource=resource,Cost=demand,Cooldown=0,Lifetime=.8f,Power=0,TargetRange=20,Use=new ConstructionUse{Channels=ActiveAbilityChannel.World,Target=ActiveAbilityTargetMode.Point},Impact=new ConstructionImpact{Targets=SkillUseTargetRelation.Friendly,DamageScale=0},Root=new ConstructionNode{Id="matter",Form="sword",Matter="iron",Operations=leave?new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Leave,At=.1f,Residue=new ConstructionResidue{Lifetime=0}}}:recover?new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Recover,At=.1f,Seconds=.4f,Recovery=new ConstructionRecovery{Efficiency=.75f}}}:Array.Empty<ConstructionOperation>()}};
var point=new ActiveAbilityTarget(null,new Vector3(69.5f,72.5f,0));ActiveAbilityHandle Handle(ActorExtend a,string id)=>new("content.constructed",a.E,id);
void Learn(ActorExtend a,AbilityDefinition d){ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(a,d.Id);}bool Use(ActorExtend a,AbilityDefinition d)=>ActiveAbilityService.TryUse(a,Handle(a,d.Id),point,ActiveAbilityUseOrigin.Script);
var wakan=Def("wakan",SkillCastResources.Wakan.id,3);Learn(owner,wakan);Check(Use(owner,wakan)&&Math.Abs(owner.GetComponent<Xian>().wakan-97)<.001,"构造按正式资源编号从真实真元支付一次");
var mana=Def("mana",SkillCastResources.Mana.id,2.25f,true);Learn(owner,mana);int manaBefore=owner.Base.getMana();Check(Use(owner,mana)&&owner.Base.getMana()==manaBefore-3,"法力按原通道向上报价，非整数需求实际支付三点");Learn(outsider,mana);int outsiderMana=outsider.Base.getMana();Check(!Use(outsider,mana)&&outsider.Base.getMana()==outsiderMana&&!outsider.HasCultisys<Magic>(),"没有魔法体系的持有人不会凭空获得法力通道");
var vigor=Def("vigor",SkillCastResources.Vigor.id,4);Learn(owner,vigor);float vigorBefore=owner.GetComponent<Knight>().vigor;Check(Use(owner,vigor)&&Math.Abs(owner.GetComponent<Knight>().vigor-(vigorBefore-4))<.001,"斗气使用已有骑士资源通道");
var stamina=Def("stamina",SkillCastResources.Stamina.id,1.25f,true);Learn(outsider,stamina);int staminaBefore=outsider.Base.data.stamina;Check(Use(outsider,stamina)&&outsider.Base.data.stamina==staminaBefore-2,"没有额外体系的普通人物可按原版体力支付");
var yao=Def("yao",SkillCastResources.YaoPower.id,4,true);Learn(beast,yao);double yaoBefore=SkillCastResources.YaoPower.ReadAmount(beast);Check(Use(beast,yao)&&Math.Abs(SkillCastResources.YaoPower.ReadAmount(beast)-(yaoBefore-4))<.001,"妖兽构造从真实妖力支付，不创建真元");Check(!beast.HasCultisys<Xian>(),"妖力施放没有附加修士体系");
var custom=Def("dynamic",customId,3,true);Learn(owner,custom);float balance=owner.GetComponent<Xian>().wakan;Check(Use(owner,custom)&&Math.Abs(owner.GetComponent<Xian>().wakan-(balance-6))<.001,"自定义通道的真实报价不被需求常数替代");multiplier=3;balance=owner.GetComponent<Xian>().wakan;Check(Use(owner,custom)&&Math.Abs(owner.GetComponent<Xian>().wakan-(balance-9))<.001,"同一已学构造再次施放重新读取当前报价");
var started=new List<ConstructedRecovery>();void Recovery(ConstructedRecovery r)=>started.Add(r);ConstructedAbilityService.RecoveryConfirmed+=Recovery;
int manaChange=SimGlobals.m.mana_change,staminaChange=SimGlobals.m.stamina_change;
try{
SimGlobals.m.mana_change=0;SimGlobals.m.stamina_change=0;
await Advance(1);Check(Math.Abs(started.Where(r=>r.AbilityId==custom.Id).Sum(r=>r.Granted)-11.25)<.001,"两次收束分别按实际支付六点和九点返还，共十一点二五");Check(started.Where(r=>r.AbilityId==mana.Id).Sum(r=>r.Granted)==2,"整数法力按实际支付本金累计取整，不按原需求退费");Check(started.Where(r=>r.AbilityId==stamina.Id).Sum(r=>r.Granted)==1,"原版体力累计回收取整");Check(Math.Abs(started.Where(r=>r.AbilityId==yao.Id).Sum(r=>r.Granted)-3)<.001,"妖力收束回到原妖兽实际通道");
var insufficient=Def("poor",customId,100000);Learn(owner,insufficient);balance=owner.GetComponent<Xian>().wakan;Check(!Use(owner,insufficient)&&owner.GetComponent<Xian>().wakan==balance,"支付不足不启动或扣除部分费用");
var missing=Def("missing","test.resource.absent",1);bool rejected=false;try{ConstructedAbilityService.Register(missing);}catch(InvalidDataException){rejected=true;}Check(rejected,"缺失资源编号在正式登记边界拒绝");
var free=Def("free","none",0);Learn(outsider,free);Check(Use(outsider,free),"明确免费的构造不要求资源体系");
// 旧容器仍通过同一通道报价，保留任选与同时支付语义。
owner.Base.equipment.setItem(World.world.items.generateItem(AssetManager.items.get("white_staff"),pActor:owner.Base),owner.Base);owner.Base.setStatsDirty();owner.Base.updateStats();
var any=new SkillContainerBuilder(SkillEntities.SummonRainCloud).UseCastResources(SkillCastResourceRequirement.AnyOf(SkillCastResources.Wakan,SkillCastResources.Mana)).Build(SkillContainerBuildMode.RuleOnly);var all=new SkillContainerBuilder(SkillEntities.SummonRainCloud).UseCastResources(SkillCastResourceRequirement.AllOf(SkillCastResources.Wakan,SkillCastResources.Mana)).Build(SkillContainerBuildMode.RuleOnly);
owner.GetComponent<Xian>().wakan=0;owner.Base.setMana(500,false);int beforeMana=owner.Base.getMana();Check(SkillCastCost.TryPayStep(owner,any)&&owner.Base.getMana()<beforeMana&&owner.GetComponent<Xian>().wakan==0,"旧任选资源仍跳过不足的首通道并真实支付法力");owner.GetComponent<Xian>().wakan=100;beforeMana=owner.Base.getMana();Check(SkillCastCost.TryPayStep(owner,all)&&owner.GetComponent<Xian>().wakan<100&&owner.Base.getMana()<beforeMana,"旧同时支付仍原子扣除两种真实资源");owner.GetComponent<Xian>().wakan=100;owner.Base.setMana(0,false);Check(!SkillCastCost.TryPayStep(owner,all)&&owner.GetComponent<Xian>().wakan==100,"旧同时支付任一通道不足时不扣除另一通道");
// 保存以实际支付费用形成的材料，并在另一个真实进程恢复。
var leave=Def("leave",customId,3,leave:true);var collect=Def("collect",SkillCastResources.Wakan.id,0);collect.Root.Scale=8;collect.Root.Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Recover,At=.1f,Seconds=.4f,Recovery=new ConstructionRecovery{WorldMaterials=true,Efficiency=.75f}}};Learn(owner,leave);Learn(owner,collect);owner.GetComponent<Xian>().wakan=100;multiplier=2;Check(Use(owner,leave),"正式生成准备保存的自定义资源材料");await Advance(1);
var saves=Cultiway.ModClass.I.WorldSaves;var world=saves.World.Capture(World.world,"resources");var rows=JObject.Parse(world)["sections"]["world_materials"]["data"]["Records"];Check(rows.Count()==1&&(string)rows[0]["Resource"]==customId,"实际世界材料保留原通道的长期编号");Check(Math.Abs((double)rows[0]["Material"]["Resource"]-6)<.001,"保存的材料本金为真实报价六点");
SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,owner=owner.Base.id,beast=beast.Base.id,outsider=outsider.Base.id,world,person=saves.Actors.Capture(owner,"resources"),material=(long)rows[0]["Id"],customId,collect=collect.Id,leave=leave.Id},Formatting.Indented));
var result=new{passed=true,checks,process=System.Diagnostics.Process.GetCurrentProcess().Id,recoveries=started};File.WriteAllText(Path.Combine(folder,"result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{SimGlobals.m.mana_change=manaChange;SimGlobals.m.stamina_change=staminaChange;ConstructedAbilityService.RecoveryConfirmed-=Recovery;Config.paused=true;File.WriteAllText(Path.Combine(folder,"partial.json"),JsonConvert.SerializeObject(new{checks,recoveries=started},Formatting.Indented));}
