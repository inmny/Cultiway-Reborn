// 正式冷启动恢复世界操作、原版收益及未用份额规则，不把旧施放重播为新收入。
using System;using System.IO;using System.Linq;using System.Reflection;using System.Collections;using System.Collections.Generic;using System.Threading.Tasks;using Newtonsoft.Json;using Newtonsoft.Json.Linq;using UnityEngine;using DebugToolbox.Runtime.Scripting;using Cultiway.Core;using Cultiway.Core.Skills;using Cultiway.Core.SkillLibV3.ActiveAbilities;using Cultiway.Content.Skills;using Cultiway.Content.Combat;using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Static|BindingFlags.Instance;string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/world-contacts");var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));string recording=null;Vector3 cameraPoint=default;double recordingOrigin=0;var recordings=new Dictionary<string,List<double>>();var checks=new List<string>();void Check(bool v,string n){if(!v)throw new InvalidOperationException(n);checks.Add(n);Log.Info(n);}JToken Section(string json,string id)=>JObject.Parse(json)["sections"][id];Check(System.Diagnostics.Process.GetCurrentProcess().Id!=(int)expected["process"],"实际使用另一游戏进程恢复");var catalog=(IDictionary)typeof(ConstructionWorldActions).GetField("actions",F).GetValue(null);if(!catalog.Contains("test.world-contact.counter"))ConstructionWorldActions.Register(new ConstructionWorldAction("test.world-contact.counter",tile=>true,tile=>default));var hs=new BaseStats();hs.addTag("frozen_ai");hs.addTag("immovable");var hold=Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.WorldContactHold")??Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.WorldContactHold").SetStats(hs).SetDuration(10000).Build();
var rt=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=rt.GetProperty("Instance").GetValue(null);async Task Boundary()=>await Game.WaitUntil(()=>(bool)rt.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;if(recording==null)await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);else{double next=World.world.getCurWorldTime();while(World.world.getCurWorldTime()<until){await Game.NextFrame();double now=World.world.getCurWorldTime();if(now<next)continue;World.world.camera.transform.position=new Vector3(cameraPoint.x,cameraPoint.y,World.world.camera.transform.position.z);MoveCamera.instance.forceZoom(6);World.world.camera.orthographicSize=6;World.world.setZoomOrthographic(6);var times=recordings[recording];new ScreenFacade().Capture(Path.Combine(folder,recording,"frames",times.Count.ToString("00000")+".png"));times.Add(now-recordingOrigin);next=now+.075;}}Config.paused=true;await Boundary();}
bool originalBuild=DebugConfig.isOn(DebugOption.SystemBuildTick);DebugConfig.setOption(DebugOption.SystemBuildTick,false);Config.paused=true;Game.Resume();ControllableUnit.clear(false);World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();World.world.console.Hide();foreach(var screen in Resources.FindObjectsOfTypeAll<LoadingScreen>())screen.gameObject.SetActive(false);var actor=World.world.units.get((long)expected["actor"]);Check(actor!=null&&actor.isAlive(),"原人物恢复且仍有效");var owner=actor.GetExtend();var saves=Cultiway.ModClass.I.WorldSaves;Check(JToken.DeepEquals(Section((string)expected["world"],"ability_constructions"),Section(saves.World.Capture(World.world,"world-contacts"),"ability_constructions")),"世界操作、频率、上限与实际构造原样恢复");Check(JToken.DeepEquals(Section((string)expected["person"],"ability_knowledge"),Section(saves.Actors.Capture(owner,"world-contacts"),"ability_knowledge")),"实际已学构造及独立冷却原样恢复");Check(saves.LastReport.Skipped.Count==0&&saves.LastReport.BackupError==null,"正式恢复没有资料丢弃或备份错误");var savedCrop=World.world.GetTileSimple((int)expected["cropX"],(int)expected["cropY"]).building;Check(savedCrop?.asset.wheat==true&&savedCrop.data.grow_time>=savedCrop.asset.growth_time*(savedCrop.asset.building_sprites.animation_data.Count-1),"原版保存的实际农田及成熟进度保持");Check(((JArray)expected["grownTiles"]).All(p=>World.world.GetTileSimple((int)p["X"],(int)p["Y"]).hasBuilding()),"原版保存的实际植被收益保持");string id=(string)expected["mature"];var definition=ConstructionEditing.Access.Read(id);var plan=AbilityCompiler.Compile(definition);Check(plan.HasWorldEffects&&plan.Impact.WorldEffects.Single().Action.Id=="crop.mature","恢复后解析相同稳定世界操作，无需重新生成法术");
void Begin(string name,Vector3 center){recording=name;cameraPoint=center;recordingOrigin=World.world.getCurWorldTime();recordings[name]=new List<double>();Directory.CreateDirectory(Path.Combine(folder,name,"frames"));}
var events=new List<ConstructedWorldContact>();void Contact(ConstructedWorldContact e){if(e.SourceId==actor.id)events.Add(e);}ConstructedAbilityService.WorldContactConfirmed+=Contact;try{await Advance(2);Check(savedCrop.component_wheat.isMaxLevel(),"原版组件从持久进度恢复实际可收获成熟状态");Check(events.Count==0,"重启不会重放旧施放或再次消费地块接触");var tile=World.world.GetTileSimple(65,76);if(tile.building!=null)tile.building.removeBuildingFinal();var crop=World.world.buildings.addBuilding("wheat",tile);crop.data.grow_time=-1000;Check(!crop.component_wheat.isMaxLevel(),"新的原版麦田确实尚未成熟");Begin("mature",new Vector3(65.5f,76.5f,0));Check(ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,id),new ActiveAbilityTarget(null,new Vector3(64.5f,76.5f,0)),ActiveAbilityUseOrigin.Script),"恢复后的已学构造通过正式地点入口再次支付和施放");await Advance(1.1f);recording=null;Check(crop.component_wheat.isMaxLevel()&&events.Any(e=>e.AbilityId==id&&e.X==65&&e.Y==76&&e.Result.Changed),"冷启动后相同实际表面仍触发原版农田成熟");var cleanPoint=new Vector3(84.5f,78.5f,0);for(int x=84;x<=87;x++){var t=World.world.GetTileSimple(x,78);if(t.building!=null)t.building.removeBuildingFinal();t.setTileTypes(TileLibrary.soil_low,TopTileLibrary.grass_low);t.burned_stages=2;t.heat=100;}string clean=(string)expected["clean"];Begin("clean",new Vector3(86,78.5f,0));Check(ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,clean),new ActiveAbilityTarget(null,cleanPoint),ActiveAbilityUseOrigin.Script),"恢复后的净化构造仍通过正式入口使用");await Advance(1.1f);recording=null;Check(events.Any(e=>e.AbilityId==clean&&e.Result.Changed)&&World.world.GetTileSimple(85,78).burned_stages==0,"冷启动后净化的实际地块结果保持");
for(int y=84;y<=89;y++)for(int x=83;x<=90;x++){var t=World.world.GetTileSimple(x,y);if(t.building!=null)t.building.removeBuildingFinal();t.setTileTypes(TileLibrary.soil_low,TopTileLibrary.grass_low);}string grow=(string)expected["grow"];Begin("grow",new Vector3(86,86.5f,0));Check(ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,grow),new ActiveAbilityTarget(null,new Vector3(84.5f,86.5f,0)),ActiveAbilityUseOrigin.Script),"恢复后的植被构造仍通过正式入口使用");await Advance(2.3f);recording=null;Check(events.Any(e=>e.AbilityId==grow&&e.Result.Changed),"冷启动后由原版再次生成实际植被");
var result=new{passed=true,checks,process=System.Diagnostics.Process.GetCurrentProcess().Id,contacts=events.Count,recordings};File.WriteAllText(Path.Combine(folder,"restart-result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;}finally{ConstructedAbilityService.WorldContactConfirmed-=Contact;DebugConfig.setOption(DebugOption.SystemBuildTick,originalBuild);Config.paused=true;}
