// 4.23：实际出招身体及替换的肢体和持物，按同一步采集与查询。
var selectedActing = Array.Empty<string>();
var surfaceReports = new List<object>();
// 同一检查逐一读取真实器官与等级，不以六尾或雷角代替其他资源。
var organSamples = new Dictionary<string, (string Species, string Organ, int Rank, string Slot, string Layer)>
{
    ["organ"] = ("wolf", "yao.horn.thunder", 2, YaoContent.Slots.Head, "yao.layer.horn_thunder"),
    ["organ-mirror"] = ("wolf", "yao.horn.thunder", 2, YaoContent.Slots.Head, "yao.layer.horn_thunder"),
    ["horn-evilspotter"] = ("wolf", "yao.horn.evilspotter", 2, YaoContent.Slots.Head, "yao.layer.horn_evilspotter"),
    ["wing-fupeng"] = ("penguin", "yao.wing.fupeng", 2, YaoContent.Slots.Limbs, "yao.layer.wing_fupeng"),
    ["wing-fierce"] = ("penguin", "yao.wing.fierce", 2, YaoContent.Slots.Limbs, "yao.layer.wing_fierce"),
    ["shell"] = ("turtle", "yao.shell.black", 2, YaoContent.Slots.Surface, "yao.layer.shell"),
    ["tail1"] = ("fox", "yao.crown.tails", 1, YaoContent.Slots.Tail, "yao.layer.tails1"),
    ["tail3"] = ("fox", "yao.crown.tails", 3, YaoContent.Slots.Tail, "yao.layer.tails3"),
    ["tail"] = ("fox", "yao.crown.tails", 6, YaoContent.Slots.Tail, "yao.layer.tails6"),
    ["tail-mirror"] = ("fox", "yao.crown.tails", 6, YaoContent.Slots.Tail, "yao.layer.tails6")
};
// 顶点本身运动、矩阵不变：连续接触、插值与面内固定点必须都读取变形后的几何。
{
    var surfaceType = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Skills.BodySurfacePose");
    var partType = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Skills.BodySurfacePart");
    Vector3[] points = { new(2, -1, -1), new(2, 1, -1), new(2, 0, 1) };
    var parts = Array.CreateInstance(partType, 1);
    parts.SetValue(partType.GetConstructors(F).Single().Invoke(new object[]
        { "surface", points, new[] { 0, 1, 2 }, null, -1, null, null, null, null }), 0);
    object before = surfaceType.GetConstructors(F).Single().Invoke(new object[]
        { parts, new[] { Matrix4x4.identity }, Vector3.zero, 1f, 0f });
    object after = surfaceType.GetMethod("Deformed", F).Invoke(before,
        new object[] { new[] { points.Select(p => p - Vector3.right * 4f).ToArray() } });
    object deformProbe = Sphere(Vector3.zero, Vector3.zero, .25f);
    object[] contact = { before, after, deformProbe, deformProbe, "surface", 0f, null, Vector3.zero };
    bool touched = (bool)surfaceType.GetMethod("Find", F).Invoke(null, contact);
    Check(touched && Mathf.Abs((float)contact[5] - .4375f) < .0002f,
        "非刚性表面连续接触读取真实前后顶点，没有沿用原资源网格");
    object at = surfaceType.GetMethod("Lerp", F)
        .Invoke(null, new object[] { before, after, (float)contact[5] });
    Vector3 pin = (Vector3)contact[6].GetType().GetMethod("Point", F).Invoke(contact[6], new[] { at });
    Vector3 nearest = (Vector3)surfaceType.GetMethod("Nearest", F).Invoke(at,
        new object[] { "surface", Vector3.zero });
    Check(Vector3.Distance(pin, nearest) < .0001f && Mathf.Abs(nearest.x - .25f) < .0001f,
        "变形后的适配位置和三角面固定点一致，不退回未变形表面");
}
// 背景部件的真实可见区域、边界固定点及遮挡运动；不依赖妖兽造型恰好站在某处。
{
    Type poseType = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Skills.BodySurfacePose"),
        pieceType = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Skills.BodySurfacePart"),
        coverType = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Skills.BodySurfaceOcclusion");

    object OcclusionQuad(float left, float right, float bottom, float top, float leftDepth = 0, float rightDepth = 0)
    {
        var pieces = Array.CreateInstance(pieceType, 1);
        pieces.SetValue(pieceType.GetConstructors(F).Single().Invoke(new object[]
        {
            "organ:coverage", new[]
            {
                new Vector3(left, leftDepth, bottom - leftDepth), new Vector3(right, rightDepth, bottom - rightDepth),
                new Vector3(right, rightDepth, top - rightDepth), new Vector3(left, leftDepth, top - leftDepth)
            },
            new[] { 0, 1, 2, 0, 2, 3 }, null, -1, null, null, null, null
        }), 0);
        return poseType.GetConstructors(F).Single().Invoke(new object[]
            { pieces, new[] { Matrix4x4.identity }, Vector3.zero, 2f, 0f });
    }

    object receiver = OcclusionQuad(0, 2, 0, 1), foreground = OcclusionQuad(-1, 1, -1, 2);
    object cover = coverType.GetMethod("Create", F).Invoke(null, new[] { foreground });
    object shown = poseType.GetMethod("WithOcclusion", F).Invoke(receiver, new[] { cover });

    bool OcclusionSweep(object before, object after, Vector3 a, Vector3 b, float radius, out float time)
    {
        object left = Sphere(a, a, radius), right = Sphere(b, b, radius);
        object[] args = { before, after, left, right, "organ:coverage", 0f, null, Vector3.zero };
        bool found = (bool)poseType.GetMethod("Find", F).Invoke(null, args);
        time = (float)args[5];
        return found;
    }

    Check(!OcclusionSweep(shown, shown, new Vector3(.5f, 1, .5f), new Vector3(.5f, -1, .5f), .01f, out _),
        "真实前景盖住的后台表面不能接触");
    Check(OcclusionSweep(shown, shown, new Vector3(1.5f, 1, .5f), new Vector3(1.5f, -1, .5f), .01f, out _),
        "同一后台表面露出的部分仍可连续接触");
    foreach (var depthCase in new[] { (-.5f, -.5f, false, false), (.5f, .5f, true, true), (-.5f, .5f, false, true) })
    {
        object model = OcclusionQuad(0, 2, 0, 1, depthCase.Item1, depthCase.Item2);
        object depthMask = coverType.GetMethod("CreateBefore", F).Invoke(null, new[] { model, (object)0f });
        object depthSurface = poseType.GetMethod("WithOcclusion", F).Invoke(receiver, new[] { depthMask });
        Check(OcclusionSweep(depthSurface, depthSurface, new Vector3(.5f, 1, .5f),
                  new Vector3(.5f, -1, .5f), .01f, out _) == depthCase.Item3 &&
              OcclusionSweep(depthSurface, depthSurface, new Vector3(1.5f, 1, .5f),
                  new Vector3(1.5f, -1, .5f), .01f, out _) == depthCase.Item4,
            "出招模型按实际深度遮挡持物，位于后方的部分不会倒过来遮住前景", new { left = depthCase.Item1, right = depthCase.Item2 });
    }
    Vector3 near = (Vector3)poseType.GetMethod("Nearest", F).Invoke(shown,
        new object[] { "organ:coverage", new Vector3(.2f, 0, .5f) });
    Vector3 aim = (Vector3)poseType.GetMethod("Aim", F).Invoke(shown, new object[] { "organ:coverage" });
    Check(near.x >= .99999f && Mathf.Abs(aim.x - 1.5f) < .00001f,
        "瞄准与最近接触位置只取实际露出的半面");
    object totalMask = coverType.GetMethod("Create", F).Invoke(null,
        new[] { OcclusionQuad(-1, 3, -1, 2) });
    object hidden = poseType.GetMethod("WithOcclusion", F).Invoke(receiver, new[] { totalMask });
    Check(!(bool)poseType.GetMethod("Supports", F).Invoke(hidden, new object[] { "organ:coverage" }) &&
          (float)poseType.GetMethod("Radius", F).Invoke(hidden, new object[] { "organ:coverage" }) == 0f,
        "完全遮住的部位没有可选表面或虚假外伸");
    Check(OcclusionSweep(shown, shown, new Vector3(0, .1f, .5f), new Vector3(2, .1f, .5f), .1f,
              out float revealAt) &&
          Mathf.Abs(revealAt - .5f) < .005f,
        "起点已碰到隐藏原面时仍继续寻找后来露出部分的首次接触", new { revealAt });
    object movedMask = coverType.GetMethod("Create", F).Invoke(null,
        new[] { OcclusionQuad(-5, -1, -1, 2) });
    object revealed = poseType.GetMethod("WithOcclusion", F).Invoke(receiver, new[] { movedMask });
    var timer = System.Diagnostics.Stopwatch.StartNew();
    Check(OcclusionSweep(hidden, revealed, new Vector3(1, .1f, .5f), new Vector3(1, .1f, .5f), .1f,
            out float movedRevealAt) && Mathf.Abs(movedRevealAt - .5f) < .005f,
        "前景移动露出静止部件时在同一步内建立真实接触", new { movedRevealAt });
    object flatCover = coverType.GetMethod("Create", F).Invoke(null,
        new[] { OcclusionQuad(-1, -1, -1, 2) });
    object flattening = poseType.GetMethod("WithOcclusion", F).Invoke(receiver, new[] { flatCover });
    Check(OcclusionSweep(shown, flattening, new Vector3(.5f, .1f, .5f), new Vector3(.5f, .1f, .5f), .1f,
            out float foldedRevealAt) && Mathf.Abs(foldedRevealAt - .25f) < .005f,
        "前景面收拢至投影线时保留同一步运动对应，不因面数改变失去接触", new { foldedRevealAt });
    object farReceiver = OcclusionQuad(1000, 1002, 1000, 1001);
    object farMask = coverType.GetMethod("Create", F).Invoke(null,
        new[] { OcclusionQuad(999, 1001, 999, 1002) });
    object farShown = poseType.GetMethod("WithOcclusion", F).Invoke(farReceiver, new[] { farMask });
    Check(!OcclusionSweep(farShown, farShown, new Vector3(1000.5f, 1, 1000.5f),
              new Vector3(1000.5f, -1, 1000.5f), .01f, out _) &&
          OcclusionSweep(farShown, farShown, new Vector3(1001.5f, 1, 1000.5f),
              new Vector3(1001.5f, -1, 1000.5f), .01f, out _),
        "大世界坐标仍保留真实遮挡，不用全局坐标相乘丢掉小面面积");
    timer.Stop();
    Check(timer.Elapsed.TotalSeconds < 3d, "遮挡边界查询在实际运行中收敛",
        new { milliseconds = timer.Elapsed.TotalMilliseconds });
}
foreach (string sample in new[]
             {
                 "right", "left", "sword", "walk", "head", "pair", "organ", "organ-mirror", "tail",
                 "tail-mirror", "horn-evilspotter", "wing-fupeng", "wing-fierce", "shell", "tail1", "tail3"
             }
             .Where(s => selectedActing.Length == 0 || selectedActing.Contains(s)))
{
    if (sample == "pair")
    {
        Park();
        Actor caster = New(66), first = New(64), second = New(66), observer = New(62);
        Place(second, 66, 74);
        await Advance(.3f);

        AbilityDefinition Local(string side)
        {
            var d = Action("parallel." + side);
            d.Cooldown = 10f;
            d.TargetRange = 10f;
            d.Body.Occupancy = side == "left" ? BodyOccupancy.LeftArm : BodyOccupancy.RightArm;
            d.Body.Construction.Parts.Single(p => p.Subject == BodyPartSubject.Source).Part = "hand." + side;
            d.Body.Construction.Relations.Single().Kind = BodyRelationKind.Touch;
            foreach (BodyMotionKey key in d.Body.Keys)
            {
                key.Torso = new float[3];
                key.Turn = key.Heading = 0f;
                key.Support = null;
            }

            if (side == "left")
            {
                d.Lifetime = 3f;
                d.Body.Keys.Last().At = 3f;
            }

            return d;
        }

        var rightDefinition = Local("right");
        var leftDefinition = Local("left");
        Check(AbilityCompiler.Compile(rightDefinition, false).Body.Occupancy == BodyOccupancy.RightArm &&
              AbilityCompiler.Compile(leftDefinition, false).Body.Occupancy == BodyOccupancy.LeftArm,
            "双手并行样本只占各自肢体，未夹带整身发力");
        CombatStatusEffects.RemoveStatus(caster, quiet);
        caster.updateStats();
        caster.addAggro(first);
        caster.addAggro(second);
        await Fire(rightDefinition, caster, first, aggro: false);
        await Advance(.2f);
        await Fire(leftDefinition, caster, second, aggro: false);
        var watch = Action("parallel.query");
        watch.Cooldown = 10f;
        watch.TargetRange = 10f;
        watch.Body.MatchDistance = false;
        CombatStatusEffects.RemoveStatus(observer, quiet);
        observer.updateStats();
        observer.addAggro(caster);
        await Fire(watch, observer, caster, aggro: false);
        await Advance(.12f);
        Check(ConstructedAbilityService.TryGetBodyPose(caster.id, BodyOccupancy.RightArm, out BodyPose right) &&
              ConstructedAbilityService.TryGetBodyPose(caster.id, BodyOccupancy.LeftArm, out BodyPose left) &&
              right.Foot == left.Foot && right.Forward == left.Forward && right.Torso == Vector3.zero &&
              left.Torso == Vector3.zero && !BodyControlState.HasControl(caster.id, BodyOccupancy.Stance),
            "两个正式局部动作共用身体根点和朝向，保留独立出手");
        Check(FormVisualScene.Instances.Count(v =>
                  v.GroundActorId == caster.id && v.BodySegment == BodyVisualSegment.RightHand) == 1 &&
              FormVisualScene.Instances.Count(v =>
                  v.GroundActorId == caster.id && v.BodySegment == BodyVisualSegment.LeftHand) == 1,
            "完整快照同时包含两只实际手掌，没有后一招覆盖前一招");
        object[] snapshot = { caster.id, null, null };
        Check((bool)service.GetMethod("TryGetBodySurface", F).Invoke(null, snapshot), "双手动作已发布同一完整表面");
        object pose = snapshot[2];
        var pieces = (Array)Field(pose, "Parts");
        var transforms = (Matrix4x4[])Field(pose, "Matrices");
        float shapeError = 0f;
        int compared = 0;
        foreach (var visual in FormVisualScene.Instances.Where(v => v.GroundActorId == caster.id &&
                                                                    v.BodySegment is BodyVisualSegment.RightHand
                                                                        or BodyVisualSegment.LeftHand))
        {
            string role = visual.BodySegment == BodyVisualSegment.RightHand ? "hand.right" : "hand.left";
            var chosen = Enumerable.Range(0, pieces.Length)
                .Where(i => (string)Field(pieces.GetValue(i), "Id") == role).ToArray();
            Check(chosen.Length == visual.Resource.Meshes.Length, role + "表面保留本手完整指节");
            for (int i = 0; i < chosen.Length; i++)
            {
                object part = pieces.GetValue(chosen[i]);
                int transform = (int)Field(part, "TransformIndex");
                Vector3[] handVertices = (Vector3[])pose.GetType().GetMethod("Vertices", F)
                    .Invoke(pose, new object[] { chosen[i] });
                foreach (Vector3 point in handVertices)
                {
                    shapeError = Mathf.Max(shapeError, Vector3.Distance(
                        transforms[transform].MultiplyPoint3x4(point),
                        visual.PartTransform(i).MultiplyPoint3x4(point)));
                    compared++;
                }
            }
        }

        Check(compared > 0 && shapeError < .0001f, "双手同帧的模型和实际表面逐顶点一致", new { compared, shapeError });
        var full = Action("parallel.full");
        full.Cooldown = 10f;
        full.TargetRange = 10f;
        ConstructedAbilityService.Register(full);
        ConstructedAbilityService.Learn(caster.GetExtend(), full.Id);
        caster.attack_timer = 0;
        Check(!ActiveAbilityService.TryUse(caster.GetExtend(),
                  new ActiveAbilityHandle("content.constructed", caster.GetExtend().E, full.Id),
                  new ActiveAbilityTarget(first, first.GetSimPos()), ActiveAbilityUseOrigin.Script) &&
              BodyControlState.HasControl(caster.id, BodyOccupancy.RightArm) &&
              BodyControlState.HasControl(caster.id, BodyOccupancy.LeftArm),
            "整身动作仍按原互斥规则拒绝，不能夺走正在出招的左右臂");
        caster.attack_timer = 999;
        if (worldfall != null) await Pair(caster, "acting-pair", 0, true);
        await Advance(2f);
        Check(!ConstructedAbilityService.TryGetBodyPose(caster.id, BodyOccupancy.RightArm, out _) &&
              ConstructedAbilityService.TryGetBodyPose(caster.id, BodyOccupancy.LeftArm,
                  out BodyPose remaining) &&
              remaining.Forward == right.Forward &&
              !BodyControlState.HasControl(caster.id, BodyOccupancy.RightArm) &&
              BodyControlState.HasControl(caster.id, BodyOccupancy.LeftArm),
            "右臂结束后独立归还，左臂继续同一朝向，不被右臂结束覆盖");
        await Advance(1.2f);
        Check(
            !BodyControlState.IsBusy(caster.id) && !ConstructedAbilityService.TryGetBodyPose(caster.id, out _),
            "另一臂最终结束，身体和两份显示均归还");
        surfaceReports.Add(new { sample, compared, shapeError });
        continue;
    }

    Park();
    bool isOrgan = organSamples.TryGetValue(sample, out var organSample);
    bool isBackground = isOrgan && Cultiway.Content.Libraries.Manager.CreatureVisualLayerLibrary.get(organSample.Layer).Depth ==
        Cultiway.Content.CreatureCompositions.Libraries.CreatureLayerDepth.BehindBody;
    string organSelection = isOrgan ? "organ:" + organSample.Organ : null;
    Actor source = New(sample.EndsWith("mirror", StringComparison.Ordinal) ? 68 : 64),
        target = isOrgan ? Make(66, organSample.Species) : New(66);
    if (isOrgan)
    {
        made.Add(target);
        Quiet(target);
        var organOwner = target.GetExtend();
        Check(YaoAwakeningService.TryAwakenByRain(organOwner), "出招妖兽实际启灵");
        var declaredOrgans = new List<YaoOrganRecord>();
        if (organSample.Slot != YaoContent.Slots.Surface)
            declaredOrgans.Add(new YaoOrganRecord
            {
                SlotId = YaoContent.Slots.Surface, OrganId = "yao.scale.basic", Rank = 1,
                Origin = YaoOrganOrigin.Innate
            });
        if (organSample.Slot != YaoContent.Slots.Head)
            declaredOrgans.Add(new YaoOrganRecord
            {
                SlotId = YaoContent.Slots.Head, OrganId = "yao.spirit.sense", Rank = 1,
                Origin = YaoOrganOrigin.Innate
            });
        if (organSample.Slot != YaoContent.Slots.Tail && organSample.Species == "wolf")
            declaredOrgans.Add(new YaoOrganRecord
            {
                SlotId = YaoContent.Slots.Tail, OrganId = "yao.crown.tails", Rank = 1,
                Origin = YaoOrganOrigin.GodEdited
            });
        declaredOrgans.Add(new YaoOrganRecord
        {
            SlotId = organSample.Slot, OrganId = organSample.Organ, Rank = organSample.Rank,
            Origin = YaoOrganOrigin.GodEdited
        });
        Check(YaoFormPlanService.TrySetOrgans(organOwner, YaoFormIds.TrueForm, declaredOrgans.ToArray()),
            "出招妖兽表达符合当前身体容量的实际器官");
        target.setStatsDirty();
        target.updateStats();
        target.finishScale();
    }

    Item item = null;
    if (sample == "sword")
    {
        item = World.world.items.generateItem(AssetManager.items.get("sword_iron"), pActor: target);
        target.equipment.setItem(item, target);
        foreach (string armour in new[] { "helmet_iron", "armor_steel", "boots_adamantine" })
            target.equipment.setItem(
                World.world.items.generateItem(AssetManager.items.get(armour), pActor: target), target);
        target.setStatsDirty();
        target.updateStats();
    }

    await Advance(.3f);
    var moving = sample == "walk"
        ? Moving("acting.walk", Vector3.right, walk: true)
        : Action("acting." + sample);
    moving.Cooldown = 10f;
    moving.TargetRange = 10f;
    moving.Body.Impact = new ConstructionImpact { DamageScale = 0f };
    if (sample is "right" or "left")
    {
        moving.Body.Keys.Single(k => k.At == 1.5f).Hand = new[] { .3f, .3f, .5f };
        moving.Body.Occupancy = BodyOccupancy.Stance |
                                (sample == "left" ? BodyOccupancy.LeftArm : BodyOccupancy.RightArm);
        moving.Body.Construction.Parts.Single(p => p.Subject == BodyPartSubject.Source).Part = "hand." + sample;
    }

    if (sample is "sword" or "head")
    {
        moving.Body = BodyActionGenerator.Create(new BodyActionRequest
        {
            Effector = sample == "head" ? "head" : "hand.right", Kind = BodyActionKind.Thrust,
            Seconds = 2f, WeaponForm = sample == "sword" ? "sword" : null, Grip = "grip"
        });
        moving.Body.Impact = new ConstructionImpact { DamageScale = 0f };
    }

    if (isOrgan)
    {
        moving.Body.Construction.Parts.Single(p => p.Subject == BodyPartSubject.Source).Part =
            organSelection;
        moving.Body.Construction.Relations.Single().FromAnchor = "organ";
        foreach (var key in moving.Body.Keys)
        {
            key.Hand = new float[3];
            key.Torso = new float[3];
            key.Rotation = new float[3];
            key.Turn = key.Heading = 0f;
            key.Support = null;
            key.PartRotation = new[] { key.At * 20f, 0f, 0f };
        }
    }

    foreach (var relation in moving.Body.Construction?.Relations ?? Array.Empty<BodyRelationDefinition>())
        if (relation.Kind is BodyRelationKind.Grab or BodyRelationKind.Brace)
            relation.Kind = BodyRelationKind.Touch;
    CombatStatusEffects.RemoveStatus(target, quiet);
    target.updateStats();
    target.addAggro(source);
    await Fire(moving, target, source, aggro: false);
    await Advance(.2f);
    var querying = Action("query." + sample);
    querying.Cooldown = 10f;
    querying.TargetRange = 10f;
    querying.Body.MatchDistance = false;
    querying.Body.Construction.Parts.Single(p => p.Subject == BodyPartSubject.Target).Part =
        sample == "left" ? "arm.left.lower" :
        sample == "right" ? "arm.right.upper" :
        sample == "sword" ? "item" :
        isOrgan ? organSelection : "surface";
    source.addAggro(target);
    CombatStatusEffects.RemoveStatus(source, quiet);
    source.updateStats();
    await Fire(querying, source, target, aggro: false);
    await Advance(.12f);
    object simulation = service.GetField("simulation", F).GetValue(null);
    var currentMethod = service.GetMethod("BodySurfaceAt", F);
    var contactMethod = service.GetMethod("BodyContactSurfaceAt", F);
    object owner = ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>()
        .Single(c => (long)Field(c, "SourceId") == target.id);
    if (isOrgan)
    {
        object action = Field(owner, "Body");
        object organ = action.GetType().GetProperty("Organ", F).GetValue(action);
        Check((string)Field(Field(organ, "Layer"), "id") == organSample.Layer,
            sample + "本次出招绑定所选器官的实际等级图层");
    }
    double now = (double)service.GetProperty("ConfirmedWorldTime", F).GetValue(null);
    object actual = currentMethod.Invoke(null, new object[] { target.id, now });
    var parts = (Array)Field(actual, "Parts");
    var matrices = (Matrix4x4[])Field(actual, "Matrices");
    var surfaceType = actual.GetType();

    Vector3[] Points(object pose, int part) =>
        (Vector3[])surfaceType.GetMethod("Vertices", F).Invoke(pose, new object[] { part });

    object earlier = currentMethod.Invoke(null,
        new object[] { target.id, (double)Field(owner, "StartedAt") - .001d });
    Check(!ReferenceEquals(parts, Field(earlier, "Parts")), sample + "动作开始前不使用未来的身体构造");
    var seen = new HashSet<int>();
    int vertices = 0, limbs = 0;
    float error = 0f;
    foreach (FormVisualInstance visual in FormVisualScene.Instances.Where(v => v.GroundActorId == target.id))
    {
        string role = isOrgan
            ? organSelection
            : visual.BodySegment switch
            {
                BodyVisualSegment.UpperRightArm => "arm.right.upper",
                BodyVisualSegment.LowerRightArm => "arm.right.lower",
                BodyVisualSegment.UpperLeftArm => "arm.left.upper",
                BodyVisualSegment.LowerLeftArm => "arm.left.lower",
                BodyVisualSegment.RightHand => "hand.right", BodyVisualSegment.LeftHand => "hand.left",
                _ => null
            };
        for (int mesh = 0; mesh < visual.Resource.Meshes.Length; mesh++)
        {
            int chosen = Enumerable.Range(0, parts.Length).First(i => !seen.Contains(i) &&
                                                                      (role == null
                                                                          ? (string)Field(parts.GetValue(i),
                                                                              "Attachment") == "item"
                                                                          : (string)Field(parts.GetValue(i),
                                                                              "Id") == role) &&
                                                                      Points(actual, i).Length ==
                                                                      visual.Resource.Meshes[mesh].vertexCount);
            seen.Add(chosen);
            object selected = parts.GetValue(chosen);
            int transform = (int)Field(selected, "TransformIndex");
            Vector3[] points = Points(actual, chosen), drawn = visual.Resource.Meshes[mesh].vertices;
            for (int point = 0; point < points.Length; point++)
            {
                error = Mathf.Max(error, Vector3.Distance(matrices[transform].MultiplyPoint3x4(points[point]),
                    visual.PartTransform(mesh).MultiplyPoint3x4(drawn[point])));
                vertices++;
            }

            if (role?.StartsWith("arm.") == true) limbs++;
        }
    }

    if (isOrgan && worldfall == null)
    {
        World.world.camera.transform.position = new Vector3(target.current_position.x,
            target.current_position.y + .5f, 0f);
        MoveCamera.instance.forceZoom(1.5f);
        World.world.console.Hide();
        Tooltip.hideTooltipNow();
        for (int frameIndex = 0; frameIndex < 10; frameIndex++) await Game.NextFrame();
        object actingBinding = Field(owner, "Body"),
            nativeOrgan = actingBinding.GetType().GetProperty("Organ", F).GetValue(actingBinding);
        Sprite organSprite = (Sprite)Field(nativeOrgan, "Sprite");
        var organPictures = ((IEnumerable)service.Assembly
            .GetType("Cultiway.Content.Skills.BodyOrganNativeDisplay")
            .GetField("pictures", F).GetValue(null)).Cast<SpriteRenderer>().Where(r => r.enabled).ToArray();
        Check(organPictures.Length == 1 && organPictures[0].sprite == organSprite,
            "原版出招器官只发布一份真实图片");
        SpriteRenderer drawnOrgan = organPictures[0];
        Vector2 drawOffset = target.move_jump_offset + target.shake_offset;
        object[] rootArgs = { target.id, null, null };
        Check((bool)service.GetMethod("TryGetBodyRoot", F).Invoke(null, rootArgs),
            "原版主动器官已发布共同身体根点");
        BodyPose drawnPose = (BodyPose)rootArgs[1];
        Vector3 drawnFoot = (Vector3)rootArgs[2];
        float groundShift = drawnPose.Foot.z - drawnFoot.z;
        for (int partIndex = 0; partIndex < parts.Length; partIndex++)
        {
            object selected = parts.GetValue(partIndex);
            if ((string)Field(selected, "Id") != organSelection) continue;
            int transform = (int)Field(selected, "TransformIndex");
            seen.Add(partIndex);
            foreach (Vector3 local in Points(actual, partIndex))
            {
                Vector3 numeric = matrices[transform].MultiplyPoint3x4(local);
                Vector3 drawn =
                    drawnOrgan.transform.TransformPoint(new Vector3(local.x, local.y + local.z, 0f));
                error = Mathf.Max(error, Vector2.Distance(
                    new Vector2(numeric.x, numeric.y + numeric.z - groundShift) +
                    drawOffset, drawn));
                vertices++;
            }
        }

        Check(vertices > 0 && seen.Count == 1 && parts.Cast<object>().Count(p =>
                (bool)p.GetType().GetMethod("Matches", F)
                    .Invoke(p, new object[] { organSelection })) == 1,
            "原版出招器官的实际不透明轮廓加入目标表面，旧合成图未残留第二份器官");
        var bodyDeformations =
            (IDictionary)typeof(FormNativeSpriteDeformation).GetField("poses", F).GetValue(null);
        SpriteRenderer bodyPicture = bodyDeformations.Keys.Cast<SpriteRenderer>().Single(picture =>
            Field(bodyDeformations[picture], "Body") is BodyPose activeBody && activeBody.Organ.HasValue);
        object bodyDrawing = bodyDeformations[bodyPicture];
        Check(drawnOrgan.sortingLayerID == bodyPicture.sortingLayerID &&
              drawnOrgan.sortingOrder == bodyPicture.sortingOrder + (isBackground ? -1 : 1) &&
              drawnOrgan.color == bodyPicture.color && drawnOrgan.sharedMaterial == bodyPicture.sharedMaterial,
            sample + "独立器官沿用实际身体层级、颜色和材质");
        Matrix4x4 actualBodyMatrix = (Matrix4x4)Field(bodyDrawing, "Matrix");
        Color32[] bodyPicturePixels = (Color32[])typeof(CreatureAppearanceService).GetMethod("ReadPixels", F)
            .Invoke(null, new object[] { bodyPicture.sprite });
        int bodyPictureWidth = Mathf.RoundToInt(bodyPicture.sprite.rect.width),
            bodyPictureHeight = Mathf.RoundToInt(bodyPicture.sprite.rect.height);

        bool ShownPixel(Vector2 center)
        {
            if (!isBackground || bodyPicture.color.a < 1f) return true;
            Vector3 local = new((center.x - organSprite.pivot.x) / organSprite.pixelsPerUnit,
                (center.y - organSprite.pivot.y) / organSprite.pixelsPerUnit, 0f);
            Vector3 drawing = drawnOrgan.transform.TransformPoint(local);
            Vector3 inBody = actualBodyMatrix.inverse.MultiplyPoint3x4(drawing);
            Vector2 pixel = (Vector2)inBody * bodyPicture.sprite.pixelsPerUnit + bodyPicture.sprite.pivot;
            int x = Mathf.FloorToInt(pixel.x), y = Mathf.FloorToInt(pixel.y);
            return x < 0 || x >= bodyPictureWidth || y < 0 || y >= bodyPictureHeight ||
                   bodyPicturePixels[y * bodyPictureWidth + x].a != 255;
        }

        // 从实际图片的一处不透明像素沿投影不变方向扫入，独立核对真实接触和面内固定点。
        Color32[] organPixels = (Color32[])typeof(CreatureAppearanceService).GetMethod("ReadPixels", F)
            .Invoke(null, new object[] { organSprite });
        int organWidth = Mathf.RoundToInt(organSprite.rect.width);
        int paintedPixel = Enumerable.Range(0, organPixels.Length).Last(i => organPixels[i].a != 0 &&
            ShownPixel(new Vector2(i % organWidth + .5f, i / organWidth + .5f)));
        Vector2 paintedCenter = new(paintedPixel % organWidth + .5f, paintedPixel / organWidth + .5f);
        Vector2 organMount = (Vector2)Field(nativeOrgan, "Mount");
        Vector3 paintedWorld = drawnPose.Organ.Value.Point(paintedCenter - organMount);
        Vector3 ray = new(0f, -2f, 2f);
        object rayStart = Sphere(paintedWorld + ray, paintedWorld + ray, .0001f),
            rayEnd = Sphere(paintedWorld - ray, paintedWorld - ray, .0001f);
        object[] pixelContact =
            { actual, actual, rayStart, rayEnd, organSelection, 0f, null, Vector3.zero };
        Check((bool)surfaceType.GetMethod("Find", F).Invoke(null, pixelContact),
            sample + "真实可见器官像素可被连续接触查询碰到");
        Vector3 fixedPoint = (Vector3)pixelContact[6].GetType().GetMethod("Point", F)
            .Invoke(pixelContact[6], new[] { actual });
        Vector3 fixedImage = drawnOrgan.transform.InverseTransformPoint(new Vector3(
            fixedPoint.x + drawOffset.x, fixedPoint.y + fixedPoint.z - groundShift + drawOffset.y,
            drawnOrgan.transform.position.z));
        Vector2 fixedPixel = (Vector2)fixedImage * organSprite.pixelsPerUnit + organSprite.pivot;
        // 有半径的探针接触点不等于球心；应落在真正被扫描的不透明像素内。
        Check(Mathf.FloorToInt(fixedPixel.x) == paintedPixel % organWidth &&
              Mathf.FloorToInt(fixedPixel.y) == paintedPixel / organWidth,
            sample + "接触固定点仍落在实际绘制像素，没有换成旧角位置",
            new { paintedPixel, fixedPixelX = fixedPixel.x, fixedPixelY = fixedPixel.y });
        Vector3 emptyWorld = drawnPose.Organ.Value.Point(new Vector2(-2f, -2f) - organMount);
        rayStart = Sphere(emptyWorld + ray, emptyWorld + ray, .0001f);
        rayEnd = Sphere(emptyWorld - ray, emptyWorld - ray, .0001f);
        pixelContact = new object[]
            { actual, actual, rayStart, rayEnd, organSelection, 0f, null, Vector3.zero };
        Check(!(bool)surfaceType.GetMethod("Find", F).Invoke(null, pixelContact),
            sample + "旋转后的图片空白处仍然落空，未用整体器官包络冒充像素");
        if (isBackground)
        {
            int coveredPixel = Enumerable.Range(0, organPixels.Length).First(i => organPixels[i].a != 0 &&
                !ShownPixel(new Vector2(i % organWidth + .5f, i / organWidth + .5f)));
            Vector3 coveredWorld = drawnPose.Organ.Value.Point(new Vector2(coveredPixel % organWidth + .5f,
                coveredPixel / organWidth + .5f) - organMount);
            object[] hiddenContact =
            {
                actual, actual, Sphere(coveredWorld + ray, coveredWorld + ray, .0001f),
                Sphere(coveredWorld - ray, coveredWorld - ray, .0001f), organSelection, 0f, null, Vector3.zero
            };
            Check(!(bool)surfaceType.GetMethod("Find", F).Invoke(null, hiddenContact),
                sample + "实际身体图片盖住的器官像素不能接触", new { coveredPixel });
        }

        Matrix4x4 bodyDrawMatrix = (Matrix4x4)Field(bodyDrawing, "Matrix");
        Vector4 bodyFlip = ((MaterialPropertyBlock)Field(bodyDrawing, "Properties")).GetVector("_Flip");
        Check(bodyFlip.x == 1f && bodyFlip.y == 1f,
            sample + "身体图片已由共同轴锁定翻转，未再叠加图片池的即时翻转");
        float nativeBodyError = 0f;
        int bodyPoints = 0;
        for (int partIndex = 0; partIndex < parts.Length; partIndex++)
        {
            if (seen.Contains(partIndex)) continue;
            object selected = parts.GetValue(partIndex);
            int transform = (int)Field(selected, "TransformIndex");
            foreach (Vector3 local in Points(actual, partIndex))
            {
                Vector3 numeric = matrices[transform].MultiplyPoint3x4(local);
                Vector3 drawn = bodyDrawMatrix.MultiplyPoint3x4(new Vector3(local.x, local.y + local.z, 0f));
                nativeBodyError = Mathf.Max(nativeBodyError, Vector2.Distance(
                    new Vector2(numeric.x, numeric.y + numeric.z - groundShift) + drawOffset, drawn));
                bodyPoints++;
            }
        }

        Check(bodyPoints > 0 && nativeBodyError < .0001f,
            sample + "剩余身体及其余器官沿实际身体矩阵显示，未随出招器官一起转动",
            new { bodyPoints, nativeBodyError });
        string imageFolder = Path.Combine(folder, "movies", "acting-" + sample, "native");
        Directory.CreateDirectory(imageFolder);
        Screen.Capture(Path.Combine(imageFolder, "00000.png"));
        for (int frameIndex = 0; frameIndex < 4; frameIndex++) await Game.NextFrame();
    }

    Check((sample == "head" || vertices > 0 && (isOrgan || limbs == 2)) && error < .0001f,
        sample + "完整动作网格与接触逐顶点一致，不保留另一套旧手臂", new { vertices, limbs, error });
    var cache = (IDictionary)Field(simulation, "actingSurfaces");
    object interval = cache[target.id];
    object before = Field(interval, "Item1"), after = Field(interval, "Item2");
    double fromTime = (double)Field(simulation, "actingSurfacesFrom"),
        toTime = (double)Field(simulation, "actingSurfacesTo");
    object middle = contactMethod.Invoke(null, new object[] { target.id, (fromTime + toTime) * .5d });
    var a = (Matrix4x4[])Field(before, "Matrices");
    var b = (Matrix4x4[])Field(after, "Matrices");
    var m = (Matrix4x4[])Field(middle, "Matrices");
    float motion = 0f, middleError = 0f, vertexMotion = 0f;
    for (int i = 0; i < m.Length; i++)
    for (int entry = 0; entry < 16; entry++)
    {
        motion = Mathf.Max(motion, Mathf.Abs(a[i][entry] - b[i][entry]));
        middleError = Mathf.Max(middleError, Mathf.Abs(m[i][entry] - (a[i][entry] + b[i][entry]) * .5f));
    }

    for (int part = 0; part < parts.Length; part++)
    {
        Vector3[] va = Points(before, part), vb = Points(after, part), vm = Points(middle, part);
        for (int i = 0; i < vm.Length; i++)
        {
            vertexMotion = Mathf.Max(vertexMotion, Vector3.Distance(va[i], vb[i]));
            middleError = Mathf.Max(middleError, Vector3.Distance(vm[i], (va[i] + vb[i]) * .5f));
        }
    }

    Check(toTime > fromTime && motion + vertexMotion > .000001f && middleError < .00001f,
        sample + "运动与非刚性变形沿同一计算步取样", new { fromTime, toTime, motion, vertexMotion, middleError });
    float bodyError = 0f;
    int armourVertices = 0;
    if (worldfall != null)
    {
        await Pair(target, "acting-" + sample, 0, true);
        var renderer =
            service.Assembly.GetType("Cultiway.Content.Compatibility.Worldfall.BodyWorldfallRenderer");
        var figures = isOrgan
            ? (IDictionary)worldfall.Assembly.GetType("FirstPerson.Creatures").GetField("States", F)
                .GetValue(null)
            : (IDictionary)((FieldInfo)renderer.GetField("figures", F).GetValue(null)).GetValue(null);
        object figure = figures[target];
        object mesh = isOrgan
            ? Field(figure, "Mesh")
            : ((FieldInfo)renderer.GetField("bodyMesh", F).GetValue(null)).GetValue(figure);
        object[] args = { target.id, null, null };
        service.GetMethod("TryGetBodySurface", F).Invoke(null, args);
        var native = (Array)Field(args[1], isOrgan ? "native" : "nativeParts");
        for (int part = 0; part < native.Length; part++)
        {
            Matrix4x4 drawn = (Matrix4x4)renderer.GetMethod("WorldMatrix", F)
                .Invoke(null, new object[] { mesh, part });
            for (int row = 0; row < 16; row++)
                bodyError = Mathf.Max(bodyError, Mathf.Abs(drawn[row] - matrices[part][row]));
        }

        if (isOrgan)
        {
            var attached = ((IEnumerable)Field(args[1], "organs")).Cast<object>().ToArray();
            var prepared = ((IEnumerable)service.Assembly
                    .GetType("Cultiway.Content.Compatibility.Worldfall.BodyOrganWorldfall")
                    .GetField("Prepared", F).GetValue(null)).Cast<object>()
                .Where(o => (long)Field(o, "Item1") == target.id).ToArray();
            Check(parts.Cast<object>().Count(p => (string)Field(p, "Id") == organSelection) ==
                  seen.Count &&
                  !prepared.Any(o =>
                      (string)Field(o, "Item2") == organSample.Layer),
                "实际出招器官只保留动作模型，未重复正常挂件");
            foreach (object extra in attached.Where(o => (string)Field(o, "Id") != organSelection))
            {
                Matrix4x4 drawn = (Matrix4x4)Field(prepared.Single(o => (string)Field(o, "Item2") ==
                    (string)Field(extra, "Layer")), "Item4");
                int index = (int)Field(extra, "Transform");
                for (int row = 0; row < 16; row++)
                    bodyError = Mathf.Max(bodyError, Mathf.Abs(drawn[row] - matrices[index][row]));
            }

            Check(prepared.Length == attached.Count(o => (string)Field(o, "Id") != organSelection),
                "未出招的其余器官仍沿本次真实身体安装位置显示");
        }

        if (sample == "sword")
        {
            var armour = (Array)Field(figure, "Armor");
            int count = (int)Field(figure, "ArmorShown");
            for (int part = 0; part < parts.Length; part++)
            {
                object selected = parts.GetValue(part);
                if (((string)Field(selected, "Attachment"))?.StartsWith("armor.", StringComparison.Ordinal) !=
                    true ||
                    ((int[])Field(selected, "Triangles")).Length == 0) continue;
                int transform = (int)Field(selected, "TransformIndex");
                object worn = armour.Cast<object>().Take(count).First(a => a != null &&
                    ((ulong)Field(a, "Hidden") & (1UL << transform)) == 0);
                foreach (Vector3 point in Points(actual, part))
                {
                    Vector3 drawn = (Vector3)renderer.GetMethod("TransformPoint", F)
                        .Invoke(null, new object[] { worn, transform, point });
                    bodyError = Mathf.Max(bodyError,
                        Vector3.Distance(drawn, matrices[transform].MultiplyPoint3x4(point)));
                    armourVertices++;
                }
            }

            Check(armourVertices > 0, "持剑出招包含实际头盔、胸甲和靴甲网格", new { armourVertices });
        }

        Check(bodyError < .0001f, sample + "实际三维身体和衣甲使用同一骨架变换", new { bodyError });
    }
    else
    {
        Check((bool)surfaceType.GetProperty("HasDeformation", F).GetValue(actual),
            sample + "原版完整表面沿同一图片变形，不沿用静止像素体");
        if (ConstructedAbilityService.TryGetBodyPose(target.id, out _, out BodyOccupancy controlled) &&
            (controlled & (BodyOccupancy.LeftArm | BodyOccupancy.RightArm)) != 0)
        {
            bool Taken(string id) =>
                (controlled & BodyOccupancy.RightArm) != 0 && (id.StartsWith("arm.right.") || id == "hand.right") ||
                (controlled & BodyOccupancy.LeftArm) != 0 && (id.StartsWith("arm.left.") || id == "hand.left");
            object[] state = { target.id, null, null };
            Check((bool)service.GetMethod("TryGetBodySurface", F).Invoke(null, state),
                sample + "接管臂链的原版自然表面仍有实际来源");
            object basePose = service.Assembly.GetType("Cultiway.Content.Skills.BodySurfaceBinding")
                .GetField("To", F).GetValue(state[1]);
            int baseTransforms = ((Matrix4x4[])Field(basePose, "Matrices")).Length;
            Check(!parts.Cast<object>().Any(piece => (int)Field(piece, "TransformIndex") < baseTransforms &&
                      Taken((string)Field(piece, "Id"))),
                sample + "共同接触面不残留被接管的旧自然臂链或其甲片");
            Sprite baseline = (Sprite)Field(state[1], "sprite"), nativeFrame = (Sprite)Field(state[1], "nativeFrame");
            object[] bodyRoot = { target.id, null, Vector3.zero };
            service.GetMethod("TryGetBodyRoot", F).Invoke(null, bodyRoot);
            Vector3 nativeFoot = (Vector3)bodyRoot[2];
            Vector2 jitter = target.move_jump_offset + target.shake_offset;
            Vector3 expectedRoot = new(nativeFoot.x + jitter.x, nativeFoot.y + nativeFoot.z + jitter.y, nativeFoot.z);
            for (int frame = 0; frame < 3; frame++) await Game.NextFrame();
            var drawings = (IDictionary)typeof(FormNativeSpriteDeformation).GetField("poses", F).GetValue(null);
            SpriteRenderer picture = drawings.Keys.Cast<SpriteRenderer>().Single(p =>
                Vector3.Distance((Vector3)Field(drawings[p], "Root"), expectedRoot) < .0001f);
            var readPixels = typeof(CreatureAppearanceService).GetMethod("ReadPixels", F);
            Color32[] beforePixels = (Color32[])readPixels.Invoke(null, new object[] { baseline }),
                drawnPixels = (Color32[])readPixels.Invoke(null, new object[] { picture.sprite });
            var map = JObject.Parse(File.ReadAllText(Path.Combine(root, "Content/BodyVisuals/humanoid-regions.json")));
            string profile = (string)map["Variants"][target.asset.id + "/" + nativeFrame.texture.name]?[nativeFrame.name] ?? nativeFrame.name;
            Check(map["Frames"][profile] != null, sample + "接触快照有实际部位制作帧",
                new { frame = nativeFrame.name, displayed = picture.sprite.name, baseline = baseline.name });
            string[] rows = map["Frames"][profile].ToObject<string[]>();
            int width = (int)baseline.rect.width, nativeWidth = (int)nativeFrame.rect.width,
                nativeHeight = (int)nativeFrame.rect.height,
                dx = Mathf.RoundToInt(baseline.pivot.x - nativeFrame.pivot.x),
                dy = Mathf.RoundToInt(baseline.pivot.y - nativeFrame.pivot.y), removed = 0, kept = 0, wrong = 0;
            var pixelDifferences = new List<object>();
            for (int y = 0; y < nativeHeight; y++)
            for (int x = 0; x < nativeWidth; x++)
            {
                int pixel = (y + dy) * width + x + dx;
                if (beforePixels[pixel].a == 0) continue;
                string role = (string)map["Roles"][rows[nativeHeight - 1 - y][x].ToString()];
                if (Taken(role))
                {
                    removed++;
                    if (drawnPixels[pixel].a != 0) wrong++;
                }
                else
                {
                    kept++;
                    if (!drawnPixels[pixel].Equals(beforePixels[pixel]))
                    {
                        wrong++;
                        if (pixelDifferences.Count < 3)
                            pixelDifferences.Add(new { x, y,
                                before = new[] { (int)beforePixels[pixel].r, beforePixels[pixel].g, beforePixels[pixel].b, beforePixels[pixel].a },
                                after = new[] { (int)drawnPixels[pixel].r, drawnPixels[pixel].g, drawnPixels[pixel].b, drawnPixels[pixel].a } });
                    }
                }
            }
            Check(removed > 0 && kept > 0 && wrong == 0,
                sample + "实际绘制同步移除旧臂链，未接管的身体保持原像素", new
                { removed, kept, wrong, baseline = baseline.name, displayed = picture.sprite.name,
                    frame = nativeFrame.name, colorSpace = QualitySettings.activeColorSpace.ToString(),
                    baseReadable = baseline.texture.isReadable, displayedReadable = picture.sprite.texture.isReadable, pixelDifferences });
        }
    }

    Check(
        BodyControlState.IsBusy(target.id) &&
        !ConstructedAbilityService.GetBodyConnections().Any(c => c.TargetId == target.id),
        sample + "原出招继续占用身体，没有被查询提前抓住");
    if (item != null) Check(ReferenceEquals(target.getWeapon(), item), "动作表面不改变实际兵器归属");
    surfaceReports.Add(new
        { sample, vertices, limbs, error, motion, vertexMotion, middleError, bodyError, armourVertices });
    if (sample == "tail" && worldfall == null)
    {
        Color originalColor = target.color;

        async Task CheckBodyOpacity(float alpha, bool hidden)
        {
            Color color = originalColor;
            color.a = alpha;
            target.color = color;
            await Advance(.06f);
            var drawingTable =
                (IDictionary)typeof(FormNativeSpriteDeformation).GetField("poses", F).GetValue(null);
            SpriteRenderer picture = drawingTable.Keys.Cast<SpriteRenderer>().Single(p =>
                Field(drawingTable[p], "Body") is BodyPose activeBody && activeBody.Organ.HasValue);
            Matrix4x4 bodyMatrix = (Matrix4x4)Field(drawingTable[picture], "Matrix");
            Color32[] frontPixels = (Color32[])typeof(CreatureAppearanceService).GetMethod("ReadPixels", F)
                .Invoke(null, new object[] { picture.sprite });
            object organ = Field(owner, "Body").GetType().GetProperty("Organ", F)
                .GetValue(Field(owner, "Body"));
            Sprite image = (Sprite)Field(organ, "Sprite");
            Vector2 mount = (Vector2)Field(organ, "Mount");
            Color32[] backPixels = (Color32[])typeof(CreatureAppearanceService).GetMethod("ReadPixels", F)
                .Invoke(null, new object[] { image });
            Check(ConstructedAbilityService.TryGetBodyPose(target.id, out BodyPose currentPose),
                "切换透明度时原尾部动作仍在正式运行");
            int width = Mathf.RoundToInt(image.rect.width),
                frontWidth = Mathf.RoundToInt(picture.sprite.rect.width),
                frontHeight = Mathf.RoundToInt(picture.sprite.rect.height);
            SpriteRenderer backPicture = ((IEnumerable)service.Assembly
                    .GetType("Cultiway.Content.Skills.BodyOrganNativeDisplay").GetField("pictures", F)
                    .GetValue(null))
                .Cast<SpriteRenderer>().Single(p => p.enabled);
            Vector3 painted = default;
            int selectedPixel = -1;
            for (int pixel = 0; pixel < backPixels.Length; pixel++)
            {
                if (backPixels[pixel].a == 0) continue;
                Vector2 center = new(pixel % width + .5f, pixel / width + .5f);
                Vector3 drawn = backPicture.transform.TransformPoint(new Vector3(
                    (center.x - image.pivot.x) / image.pixelsPerUnit,
                    (center.y - image.pivot.y) / image.pixelsPerUnit, 0f));
                Vector3 local = bodyMatrix.inverse.MultiplyPoint3x4(drawn);
                Vector2 front = (Vector2)local * picture.sprite.pixelsPerUnit + picture.sprite.pivot;
                int x = Mathf.FloorToInt(front.x), y = Mathf.FloorToInt(front.y);
                if (x < 0 || x >= frontWidth || y < 0 || y >= frontHeight ||
                    frontPixels[y * frontWidth + x].a != 255)
                    continue;
                selectedPixel = pixel;
                painted = currentPose.Organ.Value.Point(center - mount);
                break;
            }

            Check(selectedPixel >= 0 && (hidden ? picture.color.a == 1f : picture.color.a < 1f),
                "透明度验证使用实际身体图片仍覆盖的尾部像素", new { alpha, actualAlpha = picture.color.a, selectedPixel });
            double currentTime = (double)service.GetProperty("ConfirmedWorldTime", F).GetValue(null);
            object surface = currentMethod.Invoke(null, new object[] { target.id, currentTime });
            Vector3 ray = new(0f, -2f, 2f);
            object[] query =
            {
                surface, surface, Sphere(painted + ray, painted + ray, .0001f),
                Sphere(painted - ray, painted - ray, .0001f), organSelection, 0f, null, Vector3.zero
            };
            bool found = (bool)surfaceType.GetMethod("Find", F).Invoke(null, query);
            Check(found != hidden, hidden ? "恢复不透明后真实身体重新遮住尾部" : "半透明身体透出的真实尾部仍可接触");
        }

        try
        {
            await CheckBodyOpacity(.5f, false);
            await CheckBodyOpacity(1f, true);
        }
        finally
        {
            target.color = originalColor;
        }
    }

    await Advance(2.2f);
    Check(!BodyControlState.IsBusy(source.id) && !BodyControlState.IsBusy(target.id) &&
          !ConstructedAbilityService.TryGetBodyPose(target.id, out _), sample + "动作结束归还控制及显示");
    if (isOrgan && worldfall == null)
    {
        for (int frameIndex = 0; frameIndex < 4; frameIndex++) await Game.NextFrame();
        var organPictures = ((IEnumerable)service.Assembly
            .GetType("Cultiway.Content.Skills.BodyOrganNativeDisplay").GetField("pictures", F)
            .GetValue(null)).Cast<SpriteRenderer>().ToArray();
        Check(!organPictures.Any(picture => picture.enabled),
            sample + "正式动作自然结束后独立器官图片池全部关闭");
        object[] restRoot = { target, null, null };
        service.GetMethod("StartingPose", F).Invoke(null, restRoot);
        var nativeSurfaceType = service.Assembly.GetType("Cultiway.Content.Skills.BodySurfaceBinding");
        object restBinding = nativeSurfaceType.GetMethod("Create", F).Invoke(null, new object[] { target });
        double restTime = (double)service.GetProperty("ConfirmedWorldTime", F).GetValue(null);
        nativeSurfaceType.GetMethod("Capture", F)
            .Invoke(restBinding, new[] { restRoot[1], restRoot[2], (object)restTime });
        object restSurface =
            nativeSurfaceType.GetMethod("At", F).Invoke(restBinding, new object[] { restTime });
        ActorManager visibleManager = World.world.units;
        int targetIndex = Enumerable.Range(0, visibleManager.visible_units.count)
            .Single(i => visibleManager.visible_units.array[i] == target);
        Check((bool)restSurface.GetType().GetMethod("Supports", F)
                  .Invoke(restSurface, new object[] { organSelection }) &&
              visibleManager.render_data.main_sprite_colored[targetIndex] ==
              (Sprite)Field(restBinding, "sprite"),
            sample + "结束后实际显示和静态接触一起恢复完整器官合成帧");
    }
}

File.WriteAllText(Path.Combine(folder, "surfaces.json"),
    JsonConvert.SerializeObject(surfaceReports, Formatting.Indented));
return new { passed = true, checks = checks.Count };
