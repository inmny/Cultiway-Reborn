Actor source = Make(64), target = Make(80, "wolf"), other = Make(90, "wolf");
var owner = source.GetExtend();
owner.NewCultisys(Cultisyses.Xian);
owner.GetCultisys<Xian>().level = 2;
owner.MarkCultiwayStatsDirty(); source.setStatsDirty(); source.updateStats();
var facts = new List<ConstructedCorrespondenceDamage>();
var clashes = new List<ConstructedClash>();
/// <summary>记录这一场景实际完成的映像传伤。</summary>
/// <param name="fact">正式结果。</param>
void Mapped(ConstructedCorrespondenceDamage fact) => facts.Add(fact);
/// <summary>保留普通形体交锋，和映像传伤分别核对。</summary>
/// <param name="fact">实际交锋。</param>
void Clashed(ConstructedClash fact) => clashes.Add(fact);
ConstructedAbilityService.CorrespondenceDamageConfirmed += Mapped;
ConstructedAbilityService.ClashConfirmed += Clashed;

/// <summary>导出纯数值事件，坐标不直接交给通用对象序列化。</summary>
object[] Snapshots() => facts.Select(fact => (object)new
{
    fact.AttackCastId, fact.ImageCastId, fact.OwnerId, fact.TargetId,
    fact.AttackNode, fact.ImageNode, fact.Relation, fact.WorldTime,
    fact.ConsumedForce, fact.Fraction, fact.Damage, fact.HealthBefore, fact.HealthAfter,
    position = new[] { fact.Position.x, fact.Position.y, fact.Position.z }
}).ToArray();
var image = ImageDefinition();
var attack = AttackDefinition();

/// <summary>复用现成场地，稳定一次后按原入口学习并支付两次施放。</summary>
/// <param name="input">本次映像声明。</param>
async Task Pair(AbilityDefinition input)
{
    Ready(source); await Advance(.15f);
    Place(source, 64); Place(target, 80); Place(other, 90);
    owner.GetCultisys<Xian>().wakan = source.stats[BaseStatses.MaxWakan.id] * .9f;
    float before = owner.GetCultisys<Xian>().wakan;
    await Fire(input, source, target); owner.E.RemoveComponent<ConstructedKnowledge>();
    await Fire(attack, source, target); owner.E.RemoveComponent<ConstructedKnowledge>();
    Check(Math.Abs(before - owner.GetCultisys<Xian>().wakan - input.Cost - attack.Cost) < .001f,
        "映像和攻击各自按普通入口支付");
    await Advance(1.2f);
}
try
{
    Input(image, "image-definition"); Input(attack, "attack-definition");
    int untouched = other.data.health;
    await Pair(image);
    Check(facts.Count == 1 && facts[0].TargetId == target.id && facts[0].OwnerId == source.id &&
        facts[0].Fraction == .5f && Math.Abs(facts[0].Damage - facts[0].ConsumedForce * .5f) < .001f &&
        facts[0].HealthAfter < facts[0].HealthBefore && other.data.health == untouched,
        "同阵营映像受到真实交锋，原敌方人物按实际消耗受伤且无旁人损伤", Snapshots());
    Check(endings.Any(item => item.Fact.AbilityId == image.Id) && !BodyControlState.IsBusy(source.id),
        "映像破碎后完成最后一次确认且控制恢复");
    int previous = facts.Count;
    await Pair(image);
    Check(facts.Count == previous + 1, "结束后再次施放重新建立实际对应");

    var duplicate = ImageDefinition(); duplicate.Id += ".two";
    duplicate.Root.Children = new[] { new ConstructionNode
    {
        Id = "independent", Form = "fireball", Matter = "physical", Scale = .75f,
        ContactRole = ConstructionContactRole.Barrier,
        Correspondence = new ConstructionCorrespondence { Id = "same_original", DamageFraction = .5f },
        Operations = new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Detach } }
    } };
    previous = facts.Count;
    int clashBefore = clashes.Count;
    Input(duplicate, "two-images-definition"); await Pair(duplicate);
    Check(clashes.Count >= clashBefore + 2 && facts.Count == previous + 1,
        "同一攻击真实击中两个独立映像，对同一原人物共用一次接触机会", new { clashes = clashes.Count - clashBefore, mapped = facts.Count - previous });

    var friendly = ImageDefinition(); friendly.Id += ".friendly";
    friendly.Root.Correspondence.Target = ConstructionCorrespondenceTarget.Source;
    previous = facts.Count;
    await Pair(friendly);
    Check(facts.Count == previous, "原攻击没有对自身的作用资格，不借映像绕过敌我规则");

    Ready(source); await Advance(.15f); Place(source, 64); Place(other, 80);
    owner.GetCultisys<Xian>().wakan = source.stats[BaseStatses.MaxWakan.id] * .9f;
    var lost = ImageDefinition(); lost.Id += ".lost";
    await Fire(lost, source, other); owner.E.RemoveComponent<ConstructedKnowledge>();
    other.dieAndDestroy(AttackType.None);
    await Advance(.1f);
    var pointAttack = AttackDefinition(); pointAttack.Id += ".point";
    pointAttack.Use = new ConstructionUse { Channels = ActiveAbilityChannel.World, Target = ActiveAbilityTargetMode.Point };
    previous = facts.Count;
    await Fire(pointAttack, source, target, aim: new Vector3(70, 72, 0), aggro: false);
    owner.E.RemoveComponent<ConstructedKnowledge>(); await Advance(1.2f);
    Check(facts.Count == previous, "原人物真实死亡后联系终止，不向后来对象传伤");

    var missing = ImageDefinition(); missing.Id += ".missing";
    missing.Use = new ConstructionUse { Channels = ActiveAbilityChannel.World, Target = ActiveAbilityTargetMode.Point };
    ConstructedAbilityService.Register(missing); ConstructedAbilityService.Learn(owner, missing.Id);
    source.attack_timer = 0;
    float balance = owner.GetCultisys<Xian>().wakan;
    bool accepted = ActiveAbilityService.TryUse(owner, new ActiveAbilityHandle("content.constructed", owner.E, missing.Id),
        new ActiveAbilityTarget(null, new Vector3(66, 72, 0)), ActiveAbilityUseOrigin.Script);
    owner.E.RemoveComponent<ConstructedKnowledge>();
    Check(!accepted && owner.GetCultisys<Xian>().wakan == balance, "缺少真实原人物时拒绝且不收费");

    ConstructedAbilityService.Learn(owner, image.Id);
    var expected = new { source = source.id, target = target.id, health = target.data.health,
        definition = (AbilityDefinition)((IDictionary)service.GetField("definitions", F).GetValue(null))[image.Id] };
    File.WriteAllText(Path.Combine(folder, "expected.json"), JsonConvert.SerializeObject(expected, Formatting.Indented));
    SaveManager.saveWorldToDirectory(Path.Combine(folder, "completed-save"));
    owner.E.RemoveComponent<ConstructedKnowledge>();
    return new { passed = true, closed = "真实对应传伤、消耗及归属、次数、资格失败、死亡、结束再用及普通支付", process = System.Diagnostics.Process.GetCurrentProcess().Id };
}
finally
{
    ConstructedAbilityService.CorrespondenceDamageConfirmed -= Mapped;
    ConstructedAbilityService.ClashConfirmed -= Clashed;
    ConstructedAbilityService.ContactConfirmed -= Hit;
    ConstructedAbilityService.CastEnded -= Ended;
    File.WriteAllText(Path.Combine(folder, "events.json"), JsonConvert.SerializeObject(Snapshots(), Formatting.Indented));
    Config.paused = true; ControllableUnit.clear(false);
}
