// 必须真正退出并重启游戏，核对编辑得到的阈值条件及修士创作资料。
using System;
using System.IO;
using System.Linq;
using System.Collections.Generic;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core;
using Cultiway.Core.Skills;
using Cultiway.Core.Visuals.Forms;
using Cultiway.Utils.Extension;

string folder=Path.Combine(Cultiway.ModClass.I.GetDeclaration().FolderPath,"artifacts/skill_rebuild/thresholds");
var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));
if((int)expected["process"]==System.Diagnostics.Process.GetCurrentProcess().Id)throw new InvalidOperationException("需要真正退出并重启游戏");
Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;
var actor=World.world.units.get((long)expected["actor"]);var saves=Cultiway.ModClass.I.WorldSaves;var access=ConstructionEditing.Access;var checks=new List<string>();
void Check(bool value,string name){if(!value)throw new InvalidOperationException(name);checks.Add(name);}
JToken Section(string value,string id)=>JObject.Parse(value)["sections"][id]["data"];
Check(actor!=null,"原版保存恢复实际持有者");
Check(JToken.DeepEquals(Section((string)expected["world"],"ability_constructions"),Section(saves.World.Capture(World.world,"thresholds"),"ability_constructions")),"完整阈值条件及修士创法资料恢复，没有重新抽取");
Check(JToken.DeepEquals(Section((string)expected["person"],"ability_knowledge"),Section(saves.Actors.Capture(actor.GetExtend(),"thresholds"),"ability_knowledge")),"全部已学关系及顺序恢复");
var release=access.Read("Cultiway.Demo.SizeRelease");var seed=access.Read("Cultiway.Demo.ForceSeed");var ward=access.Read("Cultiway.Demo.ThresholdWard");Check(release.Root.Operations.Last().When.Trigger==ConstructionChangeTrigger.SizeAbove&&release.Root.Operations.Last().When.Threshold==1.5f&&seed.Root.Children[0].Activation.Threshold==.5f,"成长与损耗的事件种类、边界及来源完整恢复");
var rival=World.world.units.get((long)expected["rival"]);Check(rival!=null&&JToken.DeepEquals(Section((string)expected["opponent"],"ability_knowledge"),Section(saves.Actors.Capture(rival.GetExtend(),"threshold"),"ability_knowledge")),"实际迎击者的正式已学关系完整恢复");
var input=new AbilityInputs(Vector3.zero,Vector3.right*8,Vector3.right,1);var cast=new AbilityCast(access.Validate(release),Matrix4x4.identity,inputs:input);cast.Advance(.5f,input.Target);cast.ConfirmContact(0,1);cast.Advance(.55f,input.Target);Check(cast.Velocity(0).x==3,"恢复后重新编译仍在真实成长边界改变运动");
cast=new AbilityCast(access.Validate(seed),Matrix4x4.identity,inputs:input,force:20);cast.Advance(.2f,input.Target);typeof(AbilityCast).GetMethod("ConsumeForce",System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.NonPublic).Invoke(cast,new object[]{0,20f});cast.Advance(.46f,input.Target);Check(!cast.Finished&&cast.NodeAge(1)>=0,"恢复后实际完全损耗仍能留下独立后段");Check((saves.LastReport.Skipped.Count==0&&saves.LastReport.BackupError==null),"正式阈值资料恢复未丢弃其他世界进度");
var ui=JObject.Parse(File.ReadAllText(Path.Combine(folder,"ui/restart-expected.json")));Check((int)ui["process"]!=System.Diagnostics.Process.GetCurrentProcess().Id,"真实表单修改也来自退出前的另一进程");World.world.save_manager.loadWorld(Path.Combine(folder,"ui/save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;var uiActor=World.world.units.get((long)ui["actor"]);Check(JToken.DeepEquals(Section((string)ui["world"],"ability_constructions"),Section(saves.World.Capture(World.world,"threshold-ui"),"ability_constructions")),"两份实际编辑构造的完整列表恢复");Check(uiActor!=null&&JToken.DeepEquals(Section((string)ui["person"],"ability_knowledge"),Section(saves.Actors.Capture(uiActor.GetExtend(),"threshold-ui"),"ability_knowledge")),"实际编辑者的学习及修改关系恢复");Check(access.Read((string)ui["seedId"]).Root.Children[0].Activation.Threshold==.35f&&access.Read((string)ui["releaseId"]).Root.Operations.Last().When.Threshold==1.75f,"真实表单修改的损耗和成长边界没有退回默认值");Check((saves.LastReport.Skipped.Count==0&&saves.LastReport.BackupError==null),"编辑后存档完整恢复，无局部丢弃");
var result=new{passed=true,checks,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"restart-result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
