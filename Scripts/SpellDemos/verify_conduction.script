// 正式留水、越区、两位修士交汇、局部归属与跨分区整数回收。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using System.Collections;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Usage;
using Cultiway.Content.Skills;
using Cultiway.Content.Components;
using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/conduction");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}var saves=Cultiway.ModClass.I.WorldSaves;
JObject Archive()=>JObject.Parse(saves.World.Capture(World.world,"conduction"))["sections"]["world_materials"]["data"] as JObject;JArray Rows()=>(JArray)Archive()["Records"];
async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;var type=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=type.GetProperty("Instance").GetValue(null);await Game.WaitUntil(()=>(bool)type.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);}
Config.paused=true;Game.Resume();Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;
var stats=new BaseStats();stats["mana"]=256;stats["damage"]=40;stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.ConductionHold").SetStats(stats).SetDuration(10000).Build();
Actor Actor(int x){var p=World.world.units.createNewUnit("human",World.world.GetTileSimple(x,72),pAdultAge:true,pSpawnWithItems:false);p.addTrait("super_health");p.GetExtend().AddComponent(new Xian{level=2,wakan=100});Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(p,hold,10000,p);p.GetExtend().MarkCultiwayStatsDirty();p.setStatsDirty();p.updateStats();p.GetExtend().GetCultisys<Xian>().wakan=Mathf.Min(100,p.stats[Cultiway.Content.BaseStatses.MaxWakan.id]*.5f);p.setMana(128);return p;}
var actor=Actor(64);var other=Actor(80);await Advance(.1f);
bool Fire(Actor actor,AbilityDefinition d){ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(actor.GetExtend(),d.Id);return ActiveAbilityService.TryUse(actor.GetExtend(),new ActiveAbilityHandle("content.constructed",actor.GetExtend().E,d.Id),new ActiveAbilityTarget(actor,actor.GetSimPos()),ActiveAbilityUseOrigin.Script);}
var events=new List<WorldMaterialChange>();var initial=new Dictionary<long,JToken>();void Event(WorldMaterialChange e){events.Add(e);if(e.Kind=="leave")initial[e.Provider]=Rows().Single(r=>(long)r["Id"]==e.Id).DeepClone();}WorldMaterialService.Changed+=Event;
var waves=new List<ConstructedConduction>();var contacts=new List<ConstructedContact>();var recovered=new List<ConstructedRecovery>();void Wave(ConstructedConduction e)=>waves.Add(e);void Contact(ConstructedContact e)=>contacts.Add(e);void Recovery(ConstructedRecovery e)=>recovered.Add(e);ConstructedAbilityService.ConductionConfirmed+=Wave;ConstructedAbilityService.ContactConfirmed+=Contact;ConstructedAbilityService.RecoveryConfirmed+=Recovery;
try{
 void Place(Actor p,float x,float y){p.stopMovement();p.current_position=new Vector2(x,y);p.setCurrentTile(World.world.GetTileSimple((int)x,(int)y));p.updatePos();}
 Place(actor,60,72);Place(other,76,72);var middle=Actor(68);Place(middle,68,72);var dry=Actor(68);Place(dry,68,90);var airborne=Actor(70);Place(airborne,70,72);var wolf=World.world.units.createNewUnit("wolf",World.world.GetTileSimple(12,12),pAdultAge:true);Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(wolf,hold,10000,wolf);foreach(var p in new[]{other,middle,dry,airborne}){p.setKingdom(wolf.kingdom);actor.addAggro(p);p.addAggro(actor);}
 var water=JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/导电验证水流.json")));water.Impact.Targets=SkillUseTargetRelation.Self;Check(Fire(other,water),"另一修士独立支付并真实留水");await Advance(.8f);double volume=Rows().Sum(r=>(double)r["Material"]["Volume"]),budget=Rows().Sum(r=>(double)r["Material"]["Resource"]);
 AbilityDefinition Spell(string name)=>JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/"+name+".json")));
 bool Attack(AbilityDefinition d){ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(actor.GetExtend(),d.Id);return ActiveAbilityService.TryUse(actor.GetExtend(),new ActiveAbilityHandle("content.constructed",actor.GetExtend().E,d.Id),new ActiveAbilityTarget(other,other.GetSimPos()),ActiveAbilityUseOrigin.Script);}
 var ability=Spell("引水行雷");ability.Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Conduct).At=.2f;ability.Root.Operations=ability.Root.Operations.Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Recover,At=1,Seconds=.6f,Recovery=new ConstructionRecovery{Efficiency=.75f}}}).ToArray();Check(Attack(ability),"通过正式学习、支付和敌方目标入口开始导电");double until=World.world.getCurWorldTime()+.55;Config.paused=false;while(World.world.getCurWorldTime()<until){airborne.position_height=8;await Game.NextFrame();}Config.paused=true;var runnerType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=runnerType.GetProperty("Instance").GetValue(null);await Game.WaitUntil(()=>(bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);
 var first=waves.Single(w=>w.AbilityId==ability.Id);Check(first.Route.Length>1&&first.Targets.Contains(middle.id)&&first.Targets.Contains(other.id),"水路实际到达主体以外的两位人物");Check(first.Targets.Distinct().Count()==first.Targets.Length,"跨多个接触水格的人物只受一次电击");Check(first.HealthBefore.Zip(first.HealthAfter,(a,b)=>a>b).All(v=>v),"实际进入已有雷电抗性及伤害入口并扣血");Check(!first.Targets.Contains(dry.id)&&!first.Targets.Contains(airborne.id),"干地和水面上空的人物没有被平面范围误伤");Check(contacts.All(c=>c.AbilityId!=ability.Id),"间接电击没有伪造主体直接命中事件");Check(first.OriginalSourceId==actor.id&&first.OwnerId==actor.id&&first.Spent>0&&first.Remaining>0,"传播保留真实来源、控制者及有限余力");Check(Math.Abs(Rows().Sum(r=>(double)r["Material"]["Volume"])-volume)<.004&&Math.Abs(Rows().Sum(r=>(double)r["Material"]["Resource"])-budget)<.0002,"电击没有复制、消耗或夺走他人的水量及材料支付份额");
 double expected=Math.Floor(8*first.Remaining/(first.Remaining+first.Spent)*.75+1e-8);await Advance(1.3f);Check(recovered.Where(r=>r.AbilityId==ability.Id).Sum(r=>r.Granted)==expected&&expected<6,"后续收束只返还真实未耗份额，导电消耗不能再次退款");Check(waves.Count(w=>w.AbilityId==ability.Id)==1,"施放继续推进没有重复传播或重复扣血");
 // 全部冻结后再释放相同的电击，冰不被当成液态水网络。
 var freeze=Spell("范围凝水");freeze.Root.Operations[0].WorldMatter.MaximumVolume=1000;Check(Fire(other,freeze),"真实普通转换冻结已经存在的水层");await Advance(.5f);Check(Rows().Where(r=>(string)r["Material"]["Matter"]=="water").All(r=>(string)r["Material"]["State"]=="solid"||(double)r["Material"]["Volume"]<.0001),"本次水量实际成为保持态而非只改色");var blocked=Spell("引水行雷");blocked.Id="test.conduction.frozen";blocked.Root.Operations[1].At=.2f;Check(Attack(blocked),"冰层场景仍正常通过施放入口");await Advance(.6f);Check(!waves.Any(w=>w.AbilityId==blocked.Id),"冻结材料真实阻断导电，没有到达或伤害记录");
 // 第二种形体在读档后使用，构造保存后不重新抽取参数。
 var branch=Spell("枝引雷流");branch.Root.Operations[1].At=.2f;ConstructedAbilityService.Register(branch);ConstructedAbilityService.Learn(actor.GetExtend(),branch.Id);int made=0;for(int seed=0;seed<5000&&made<3;seed++){var random=new System.Random(seed);if(random.Next(6)!=0||random.Next(2)!=1)continue;random.NextDouble();random.NextDouble();random.Next(3);if(random.Next(4)!=0)continue;string id=ConstructedAbilityService.Create(actor.GetExtend(),seed);var defs=(System.Collections.IDictionary)typeof(ConstructedAbilityService).GetField("definitions",F).GetValue(null);Check(((AbilityDefinition)defs[id]).Root.Operations.Any(o=>o.Kind==ConstructionOperationKind.Conduct),"修士通过普通创作产生导电："+seed);made++;}Check(made==3,"三份自创导电来自普通生成资料");
 foreach(var p in World.world.units.dict.Values.ToArray()){Cultiway.Content.Combat.CombatStatusEffects.RemoveStatus(p,hold);p.GetExtend().MarkCultiwayStatsDirty();p.setStatsDirty();p.updateStats();}actor.setMana(actor.getMaxMana()/2);SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,actor=actor.id,other=other.id,middle=middle.id,world=saves.World.Capture(World.world,"conduction")},Formatting.Indented));
 var result=new{passed=true,checks,spent=first.Spent,remaining=first.Remaining,refunded=expected,targets=first.Targets,route=first.Route.Length};File.WriteAllText(Path.Combine(folder,"runtime.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{WorldMaterialService.Changed-=Event;ConstructedAbilityService.ConductionConfirmed-=Wave;ConstructedAbilityService.ContactConfirmed-=Contact;ConstructedAbilityService.RecoveryConfirmed-=Recovery;Config.paused=true;}
