// 用正式金钟验证实际钟面拦截、破盾余伤和普通受击。
const float originX = 64f, protectedX = 70.3f, centerY = 72f;
PrepareArtifactArena(59, 78, 65, 80);
Actor defender = Make(protectedX), attacker = Make(originX);
var owner = defender.GetExtend();
var attackerExtend = attacker.GetExtend();
owner.AddComponent(new Xian { level = 4, wakan = 9000f });
attackerExtend.AddComponent(new Xian { level = 4, wakan = 9000f });
owner.SetPowerLevel(4f);
attackerExtend.SetPowerLevel(4f);
await Setup(defender, attacker);
ControllableUnit.clear(false);
MoveCamera.clearFocusUnitOnly();
await Advance(.10f);
CombatStatusEffects.ApplyStatus(defender, hold, 10000f, defender);
defender.updateStats();
Place(defender, protectedX, centerY);
Place(attacker, originX, centerY);
defender.position_height = attacker.position_height = 0f;
ConstructedAbilityService.NotifyActorChanged(defender);
ConstructedAbilityService.NotifyActorChanged(attacker);
defender.attack_timer = attacker.attack_timer = 999f;

var asset = ArtifactAbilities.GoldenBellBarrier;
var blueprint = ArtifactBlueprintCodec.FromComposeResult(ArtifactComposer.ComposeDesign(new ArtifactDesignRequest
{
    Shape = ItemShapes.Bell, Atoms = new[] { ArtifactAtoms.PurifyingBell, ArtifactAtoms.Iron },
    Level = new ItemLevel { Stage = 2, Level = 4 }, Name = "吸收实测金钟"
}));
Check(blueprint.AbilitySet.abilities.Any(value => value.ability_id == asset.id), "正式配方取得金钟护界");
Entity bell = ArtifactBlueprintCodec.Materialize(blueprint, defender.getName());
owner.AddSpecialItem(bell);
Check(owner.EquipArtifact(bell, locked: true, mode: ArtifactEquipMode.ForcedOperating, priority: 100),
    "装备原组合钟");
ArtifactLoadoutPlanner.Refresh(owner, false, 0);
lifecycle.Invoke(null, new object[] { bell });
await Game.NextFrame();
await Game.NextFrame();

var ability = Definition(bell, asset.id);
var handle = ArtifactHandle(bell, asset.id);
var control = owner.E.GetRelation<EquippedArtifactRelation, Entity>(bell).state;
var execution = new ArtifactAbilityExecutionContext(owner.E, bell, control);
float cost = asset.lifecycle.ResolveActivationCost(execution, ability);
if (control == ArtifactControlState.Overloaded) cost *= asset.lifecycle.overload_resource_multiplier;
float Capacity() => Entry(bell, asset.id).GetNumber("shield_current");

var impacts = (IEnumerable)service.Assembly.GetType("Cultiway.Content.Visuals.GoldenBellSpatialVisualCue")
    .GetField("entries", F).GetValue(null);
var meshes = (IEnumerable)service.Assembly.GetType("Cultiway.Content.Combat.CombatSpatialVisualSystem")
    .GetField("Meshes", F).GetValue(null);
object Impact() => impacts.Cast<object>().SingleOrDefault(item => (bool)Field(item, "Impact") &&
    ((ArtifactAbilityVisualContext)Field(item, "Context")).artifact == bell);
Vector3? ImpactPoint(object item) => (Vector3?)Field(Field(item, "Context"), "contact_point");
bool AtImpact(Vector3 point) => meshes.Cast<object>().Any(item =>
    (string)Field(Field(item, "Model"), "Name") == "spatial_spark" &&
    Vector3.Distance((Vector3)Field(item, "Position"), point) < .005f);
object Ward() => meshes.Cast<object>().FirstOrDefault(item =>
    ((string)Field(Field(item, "Model"), "Name")).EndsWith("_ward", StringComparison.Ordinal) &&
    (Actor)Field(item, "GroundActor") == defender);
float DistanceToWard(Vector3 point, object pose)
{
    object model = Field(pose, "Model");
    var points = (Vector3[])Field(model, "Vertices");
    var triangles = (int[])Field(model, "Triangles");
    Vector3 scale = (Vector3)Field(pose, "Scale"), origin = (Vector3)Field(pose, "Position");
    Quaternion rotation = (Quaternion)Field(pose, "Rotation");
    Vector3 At(int index) => origin + rotation * Vector3.Scale(points[triangles[index]], scale);
    var distance = service.Assembly.GetType("Cultiway.Core.Skills.AbilityTriangleSweep").GetMethod("Segment", F);
    float closest = float.PositiveInfinity;
    for (int i = 0; i < triangles.Length; i += 3)
        closest = Mathf.Min(closest, (float)distance.Invoke(null, new object[] { point, point, At(i), At(i + 1), At(i + 2), null, null }));
    return closest;
}

var facts = new List<ConstructedContact>();
var fees = new List<float>();
var payment = typeof(WakanResourceService).GetField("mutationCommitted", F);
object oldPayments = payment.GetValue(null);
void Paid(ActorExtend payer, in WakanMutation change)
{
    if (payer == owner && change.Kind == WakanMutationKind.Spend) fees.Add(-change.Delta);
}
void Confirmed(ConstructedContact fact)
{
    if (fact.SourceId == attacker.id && fact.TargetId == defender.id && fact.AbilityId.StartsWith("test.bell-absorption."))
        facts.Add(fact);
}
int BodyHits(string key) => facts.Count(value => value.AbilityId == "test.bell-absorption." + key);
async Task Strike(string key, float damageScale, Func<bool> complete = null)
{
    var spell = new AbilityDefinition
    {
        Id = "test.bell-absorption." + key, Name = "实测剑气", Lifetime = .28f,
        TargetRange = 12f, Resource = "wakan", Cost = 1.25f, Power = 2f,
        Binding = new ConstructionBinding { Anchor = AbilityAnchor.Source, FaceTarget = false, Height = .28f },
        Impact = new ConstructionImpact { DamageScale = damageScale },
        Root = new ConstructionNode
        {
            Id = "blade", Form = "sword_qi", Matter = "iron", Rotation = [-90f, 0f, 0f],
            OnContact = ConstructionContactResponse.Continue,
            Operations = [new ConstructionOperation { Kind = ConstructionOperationKind.Fly,
                WorldVelocity = true, InheritVelocity = false, Vector = [55f, 0f, 0f] }]
        }
    };
    attackerExtend.GetCultisys<Xian>().wakan = 9000f;
    await Fire(spell, attacker, defender);
    attackerExtend.E.RemoveComponent<ConstructedKnowledge>();
    if (complete == null) await Advance(.32f);
    else await WaitFor(complete, .35f);
    await Game.NextFrame();
}

WakanResourceService.RegisterMutationCommitted(Paid);
ConstructedAbilityService.ContactConfirmed += Confirmed;
try
{
    World.world.console.Hide();
    WorldTip.hideNow();
    Tooltip.hideTooltipNow();
    owner.GetCultisys<Xian>().wakan = 9000f;
    Check(Use(owner, handle, defender) && fees.Count == 1 && Mathf.Abs(fees[0] - cost) < .003f &&
          Mathf.Abs(Capacity() - ability.GetNumber("shield_capacity") * execution.effect_scale) < .003f,
        "原主动入口只付一次，取得原容量", new { cost, paid = fees.LastOrDefault(), capacity = Capacity() });
    await Advance(.27f);
    var initialWard = Ward();
    Place(defender, protectedX + .7f, centerY);
    ConstructedAbilityService.NotifyActorChanged(defender);
    await Advance(.09f);
    await Game.NextFrame();
    var shiftedWard = Ward();
    Check(initialWard != null && shiftedWard != null &&
        Vector3.Distance((Vector3)Field(initialWard, "Position"), (Vector3)Field(shiftedWard, "Position")) > .5f &&
        Vector2.Distance((Vector2)Field(shiftedWard, "GroundAnchor"), defender.current_position) < .005f,
        "人物移位后真实钟罩跟随到新位置");

    var before = Capacity();
    var hp = defender.data.health;
    Place(attacker, originX, centerY + 2.5f);
    ConstructedAbilityService.NotifyActorChanged(attacker);
    await Strike("miss", .65f);
    Check(Mathf.Abs(Capacity() - before) < .003f && hp == defender.data.health && Impact() == null && BodyHits("miss") == 0,
        "外侧擦过不消耗容量，也不触发人物伤害", new { before, after = Capacity() });
    Place(attacker, originX, centerY);
    ConstructedAbilityService.NotifyActorChanged(attacker);

    await Strike("hold", .65f, () => Impact() != null);
    Check(hp == defender.data.health && Capacity() > 0f && before - Capacity() > 0f && BodyHits("hold") == 0,
        "小击在钟面全额拦住，未发生人物结算",
        new { before, current = Capacity(), absorbed = before - Capacity() });
    var visual = Impact();
    Vector3? firstPoint = visual == null ? null : ImpactPoint(visual);
    float firstDistance = firstPoint.HasValue ? DistanceToWard(firstPoint.Value, Ward()) : -1f;
    Check(visual != null && !(bool)Field(visual, "Broken") && firstPoint.HasValue && firstDistance < .005f &&
          firstPoint.Value.x < defender.current_position.x && AtImpact(firstPoint.Value),
        "拦截点与双视角共用钟面重合",
        new { point = firstPoint?.ToString(), surfaceDistance = firstDistance, center = defender.current_position.ToString() });
    if (shots)
        await CaptureArtifactViews("absorption", defender.current_position, 1.8f,
            () => firstPoint.HasValue && AtImpact(firstPoint.Value) && Capacity() > 0f, nativeZoom: 2.8f, closeSubject: defender);

    await Advance(.40f);
    before = Capacity();
    hp = defender.data.health;
    var fullWard = Ward();
    await Strike("break", 15f, () => BodyHits("break") > 0);
    visual = Impact();
    var second = facts.Single(value => value.AbilityId == "test.bell-absorption.break");
    Vector3? breakPoint = visual == null ? null : ImpactPoint(visual);
    Check(second.Damage.SettledCount == 1 && second.Damage.ShieldAbsorbed == 0f && Capacity() == 0f &&
          second.Damage.HealthLost > 0 && hp - defender.data.health == second.Damage.HealthLost &&
          visual != null && (bool)Field(visual, "Broken") && breakPoint.HasValue &&
          DistanceToWard(breakPoint.Value, fullWard) < .005f && breakPoint.Value.x < second.Position.x && AtImpact(breakPoint.Value),
        "钟面先耗尽剩余容量，余力飞到人物才扣血",
        new { before, after = Capacity(), lifeLost = second.Damage.HealthLost, surface = breakPoint?.ToString(),
            body = second.Position.ToString(), fees = fees.Count });
    if (shots)
        await CaptureArtifactViews("broken", defender.current_position, 1.8f,
            () => Impact() is { } stamp && (bool)Field(stamp, "Broken") && Capacity() == 0f,
            nativeZoom: 2.8f, closeSubject: defender);

    await Advance(.45f);
    hp = defender.data.health;
    CombatDamageEffects.DealDamage(attacker, defender, 40f, ElementComposition.Static.Iron,
        ignoreDamageReduction: true, attackerPowerLevel: 4f);
    await WaitFor(() => defender.data.health < hp, .40f);
    Check(hp - defender.data.health == 40 && Capacity() == 0f && Impact() == null && Ward() == null && fees.Count == 1,
        "耗尽后普通受击照常扣血，不再发出吸收反馈");

    var now = World.world.getCurWorldTime();
    var state = Entry(bell, asset.id);
    float wait = Mathf.Max((float)(state.cooldown_until - now), (float)(state.activity_until - now));
    await Advance(Mathf.Max(.06f, wait + .05f));
    owner.GetCultisys<Xian>().wakan = 9000f;
    Check(Use(owner, handle, defender) && fees.Count == 2 && Capacity() > 40f &&
          owner.GetEquippedArtifacts().Contains(bell), "同一原钟冷却后可再次开启");
    hp = defender.data.health;
    before = Capacity();
    CombatDamageEffects.DealDamage(attacker, defender, 40f, ElementComposition.Static.Iron,
        ignoreDamageReduction: true, attackerPowerLevel: 4f);
    await WaitFor(() => Capacity() < before, .40f);
    await Game.NextFrame();
    visual = Impact();
    Check(hp == defender.data.health && Mathf.Abs(before - Capacity() - 40f) < .003f &&
          visual != null && ImpactPoint(visual) == null && !(bool)Field(visual, "Broken"),
        "普通受击复用同一容量，没有借用上一击的空间撞点",
        new { before, current = Capacity() });
    return new { passed = true, process = System.Diagnostics.Process.GetCurrentProcess().Id };
}
finally
{
    payment.SetValue(null, oldPayments);
    ConstructedAbilityService.ContactConfirmed -= Confirmed;
}
