// 真实地块接触；计数操作只用于几何和频率，玩法收益另用原版净化、生长与成熟验证。
using System;using System.IO;using System.Linq;using System.Reflection;using System.Collections;using System.Collections.Generic;using System.Threading.Tasks;using Newtonsoft.Json;using Newtonsoft.Json.Linq;using UnityEngine;using Cultiway.Core;using Cultiway.Core.Skills;using Cultiway.Core.SkillLibV3.ActiveAbilities;using Cultiway.Core.SkillLibV3.Usage;using Cultiway.Core.SkillLibV3.Effects;using Cultiway.Content.Skills;using Cultiway.Content.Components;using Cultiway.Content.Combat;using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Static|BindingFlags.Instance;string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/world-contacts");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new InvalidOperationException(n);checks.Add(n);Log.Info(n);}var catalog=(IDictionary)typeof(ConstructionWorldActions).GetField("actions",F).GetValue(null);if(!catalog.Contains("test.world-contact.counter"))ConstructionWorldActions.Register(new ConstructionWorldAction("test.world-contact.counter",tile=>true,tile=>default));
var rt=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=rt.GetProperty("Instance").GetValue(null);async Task Boundary()=>await Game.WaitUntil(()=>(bool)rt.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,7200);Config.paused=true;await Boundary();}
bool originalBuild=DebugConfig.isOn(DebugOption.SystemBuildTick);DebugConfig.setOption(DebugOption.SystemBuildTick,false);Config.paused=true;Game.Resume();ControllableUnit.clear(false);Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();World.world.console.Hide();foreach(var screen in Resources.FindObjectsOfTypeAll<LoadingScreen>())screen.gameObject.SetActive(false);foreach(var old in World.world.units.getSimpleList().ToArray())old.dieAndDestroy(AttackType.Other);for(int y=50;y<100;y++)for(int x=40;x<110;x++){var t=World.world.GetTileSimple(x,y);if(t.building!=null)t.building.removeBuildingFinal();t.setTileTypes(TileLibrary.soil_low,TopTileLibrary.grass_low);}
var hs=new BaseStats();hs.addTag("frozen_ai");hs.addTag("immovable");var hold=Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.WorldContactHold")??Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.WorldContactHold").SetStats(hs).SetDuration(10000).Build();var actor=World.world.units.createNewUnit("human",World.world.GetTileSimple(60,72),pAdultAge:true,pSpawnWithItems:false);actor.addTrait("super_health");var owner=actor.GetExtend();owner.AddComponent(new Xian{level=2,wakan=200});CombatStatusEffects.ApplyStatus(actor,hold,10000,actor);owner.MarkCultiwayStatsDirty();actor.setStatsDirty();actor.updateStats();
await Advance(.1f);actor.joinLanguage(World.world.languages.newLanguage(actor,true));actor.setCulture(World.world.cultures.newCulture(actor,true));World.world.kingdoms.makeNewCivKingdom(actor);var city=World.world.cities.buildNewCity(actor,actor.current_tile.zone);actor.joinCity(city);for(int y=70;y<=84;y+=2)for(int x=60;x<=78;x+=2)city.addZone(World.world.GetTileSimple(x,y).zone);var windmill=World.world.buildings.addBuilding("windmill_human_0",World.world.GetTileSimple(72,75));await Advance(.2f);CityBehCheckFarms.check(city);Check(city.getBuildingOfType("type_windmill")!=null,"原版城市和风车为农田提供正常维护归属");
AbilityDefinition Def(string name,string action,ConstructionContactMode mode=ConstructionContactMode.Once,float lifetime=.8f)=>new(){Id="test.world-contact."+name,Name="地块接触验证·"+name,Cost=0,Resource="none",Cooldown=0,Lifetime=lifetime,TargetRange=100,Use=new ConstructionUse{Channels=ActiveAbilityChannel.World,Target=ActiveAbilityTargetMode.Point},Power=0,Impact=new ConstructionImpact{Targets=SkillUseTargetRelation.Friendly,DamageScale=0,WorldEffects=new[]{new ConstructionWorldEffect{Action=action,Contact=new ConstructionContactPolicy{Mode=mode,Interval=.2f}}}},Root=new ConstructionNode{Id="surface",Form="sword",Matter="iron",Rotation=new[]{0f,90f,0f},ActiveFrom=.1f,ActiveUntil=lifetime-.01f}};
AbilityDefinition Copy(AbilityDefinition d)=>JsonConvert.DeserializeObject<AbilityDefinition>(JsonConvert.SerializeObject(d));bool Cast(AbilityDefinition d,Vector3 p){ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(owner,d.Id);return ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,d.Id),new ActiveAbilityTarget(null,p),ActiveAbilityUseOrigin.Script);}Building Crop(int x,int y,bool field=true){var t=World.world.GetTileSimple(x,y);if(t.building!=null)t.building.removeBuildingFinal();if(field)t.setTileTypes(TileLibrary.soil_low,TopTileLibrary.field);var b=World.world.buildings.addBuilding("wheat",t);b.data.grow_time=-1000;CityBehCheckFarms.check(city);return b;}
var basic=Def("basic","test.world-contact.counter");var plan=AbilityCompiler.Compile(basic);Check(plan.HasWorldEffects&&plan.Impact.WorldEffects.Count==1,"编译明确识别世界接触，不从图形或材料猜测作用");basic.Impact.WorldEffects[0].Action="land.cleanse";Check(plan.Impact.WorldEffects[0].Action.Id=="test.world-contact.counter","运行计划固定操作及频率，外部资料修改不改已有施放");bool readonlyEffects=false;try{((IList<CompiledConstructionWorldEffect>)plan.Impact.WorldEffects)[0]=plan.Impact.WorldEffects[0];}catch(NotSupportedException){readonlyEffects=true;}Check(readonlyEffects,"共享运行计划不暴露可替换的世界操作数组");foreach(var bad in new[]{Def("unknown","unregistered.world.rule"),Def("bad-limit","land.cleanse"),Def("bad-contact","land.cleanse")}){if(bad.Id.EndsWith("bad-limit"))bad.Impact.WorldEffects[0].MaximumTiles=0;if(bad.Id.EndsWith("bad-contact"))bad.Impact.WorldEffects[0].Contact.Interval=0;if(bad.Id.EndsWith("bad-contact"))bad.Impact.WorldEffects[0].Contact.Mode=ConstructionContactMode.Interval;bool rejected=false;try{AbilityCompiler.Compile(bad);}catch(InvalidDataException){rejected=true;}Check(rejected,"未知操作或错误世界接触参数拒绝："+bad.Id);}var alias=Def("alias","land.cleanse");var explicitOnce=Copy(alias);explicitOnce.Id+=".explicit";alias.Impact.WorldEffects[0].Contact=null;Check(ConstructionSimilarity.Describe(alias).Near(ConstructionSimilarity.Describe(explicitOnce)),"缺省与明确一次接触规则归一");var cropRule=Copy(alias);cropRule.Id+=".crop";cropRule.Impact.WorldEffects[0].Action="crop.mature";Check(!ConstructionSimilarity.Describe(alias).Near(ConstructionSimilarity.Describe(cropRule)),"不同世界作用不会被内容比较抹掉");
string stage="counter";var events=new List<ConstructedWorldContact>();var recoveries=new List<ConstructedRecovery>();void Contact(ConstructedWorldContact e){if(e.SourceId==actor.id)events.Add(e);}void Recovery(ConstructedRecovery e){if(e.ProviderId==actor.id)recoveries.Add(e);}ConstructedAbilityService.WorldContactConfirmed+=Contact;ConstructedAbilityService.RecoveryConfirmed+=Recovery;
try{
var once=Def("once","test.world-contact.counter");Check(Cast(once,new Vector3(64.5f,72.5f,0)),"无敌人的正式入口接受世界接触构造");await Advance(1);var first=events.Where(e=>e.AbilityId==once.Id).ToArray();Check(first.Length>0&&first.All(e=>e.Age>=.099f),"零攻击力量的功能构造仍按实际有效阶段接触地块");Check(first.GroupBy(e=>(e.X,e.Y)).All(g=>g.Count()==1),"多个形状和重复模拟不使一次接触重复作用");Check(first.All(e=>e.Y==72&&e.X>=64&&e.X<=67),"选择沿真实水平刃面而非额外圆形范围");Check(first.All(e=>!e.Result.Changed),"几何计数失败尝试没有被当作实际世界收益");
var high=Def("high","test.world-contact.counter");Check(Cast(high,new Vector3(64.5f,72.5f,5)),"接受明确高空地点");await Advance(1);Check(!events.Any(e=>e.AbilityId==high.Id),"高空投影不伪造下方地面接触");var deco=Def("decoration","test.world-contact.counter");deco.Root.ContactRole=ConstructionContactRole.Decoration;Check(Cast(deco,new Vector3(64.5f,72.5f,0)),"显示部位可保留资料用于后续改造");await Advance(1);Check(!events.Any(e=>e.AbilityId==deco.Id),"装饰部位不进入实际世界接触");
var interval=Def("interval","test.world-contact.counter",ConstructionContactMode.Interval,1.1f);Check(Cast(interval,new Vector3(64.5f,72.5f,0)),"接受世界秒间隔操作");await Advance(1.3f);var pulses=events.Where(e=>e.AbilityId==interval.Id).GroupBy(e=>(e.X,e.Y)).ToArray();Check(pulses.Length>0&&pulses.All(g=>g.Count()>=4&&g.OrderBy(e=>e.Age).Zip(g.OrderBy(e=>e.Age).Skip(1),(a,b)=>b.Age-a.Age).All(v=>v>=.199f)),"重复尝试按共同世界时间间隔，不按画面帧率");
var limited=Def("limited","test.world-contact.counter",ConstructionContactMode.Interval,1);limited.Impact.WorldEffects[0].MaximumTiles=1;limited.Impact.WorldEffects[0].Contact.MaximumTotal=2;Check(Cast(limited,new Vector3(64.5f,72.5f,0)),"接受明确世界目标及总次数上限");await Advance(1.2f);var cap=events.Where(e=>e.AbilityId==limited.Id).ToArray();Check(cap.Length==2&&cap.Select(e=>(e.X,e.Y)).Distinct().Count()==1,"不同地块及总尝试次数均遵守实际声明上限");
var reentry=Def("reentry","test.world-contact.counter",ConstructionContactMode.Reentry,2.4f);reentry.Root.Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Spin,Vector=new[]{0f,360f,0f}}};Check(Cast(reentry,new Vector3(64.5f,72.5f,0)),"接受旋转离开并返回地面的普通构造");await Advance(2.6f);var returns=events.Where(e=>e.AbilityId==reentry.Id&&e.X==66&&e.Y==72).OrderBy(e=>e.Age).ToArray();Check(returns.Length>=2&&returns.Zip(returns.Skip(1),(a,b)=>b.Age-a.Age).All(v=>v>.5f),"真实离开后才能再次作用，同段分件区间按共同方法合并");
var moving=Def("moving","test.world-contact.counter",ConstructionContactMode.Once,1);moving.Root.Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Fly,Vector=new[]{60f,0f,0f},WorldVelocity=true}};Check(Cast(moving,new Vector3(44.5f,68.5f,0)),"接受高速地面运动构造");await Advance(1.2f);var trail=events.Where(e=>e.AbilityId==moving.Id).ToArray();Check(trail.Select(e=>e.X).Distinct().Count()>30&&trail.All(e=>e.Y==68),"高速实际扫掠保留经过的地块，未扩大为宽圆形");Check(trail.All(e=>e.X<=44.5f+e.Age*60+3.1f),"世界变化不会提前到达尚未经过的位置");
stage="native";var crops=Enumerable.Range(64,6).Select(x=>Crop(x,76)).ToArray();var mature=Def("native-mature","crop.mature");mature.Cost=4;mature.Resource="wakan";float before=owner.GetComponent<Xian>().wakan;Check(Cast(mature,new Vector3(64.5f,76.5f,0))&&Math.Abs(owner.GetComponent<Xian>().wakan-(before-4))<.001f,"实际农田操作由正式入口支付一次费用");await Advance(1);Check(crops.Take(4).All(c=>c.component_wheat.isMaxLevel())&&crops.Skip(4).All(c=>!c.component_wheat.isMaxLevel()),"实际触及的原版麦田成熟，作用面以外的对照麦田未成熟");Check(events.Any(e=>e.AbilityId==mature.Id&&e.Result.Changed&&(e.Result.Flags&SkillEffectOutcomeFlags.CropFertilized)!=0),"世界结果来自原版成熟状态而非图形或计数探针");
var dirty=World.world.GetTileSimple(65,78);dirty.burned_stages=2;dirty.heat=100;var far=World.world.GetTileSimple(65,80);far.burned_stages=2;far.heat=100;var clean=Def("native-clean","land.cleanse");Check(Cast(clean,new Vector3(64.5f,78.5f,0)),"接受原版净土规则的普通接触构造");await Advance(1);Check(dirty.burned_stages==0&&dirty.heat==0&&far.burned_stages>0,"实际接触移除灼烧与热量，远处污染不被额外圆形范围清除");far.heat=0;far.removeBurn();
var bothCrop=Crop(65,82,false);bothCrop.current_tile.burned_stages=2;bothCrop.current_tile.heat=100;var both=Def("shared-surface","land.cleanse");both.Impact.WorldEffects=both.Impact.WorldEffects.Concat(Def("unused","crop.mature").Impact.WorldEffects).ToArray();Check(Cast(both,new Vector3(64.5f,82.5f,0)),"同一普通作用面声明两种世界原理，无需整招专用类");await Advance(1);Check(bothCrop.component_wheat.isMaxLevel()&&bothCrop.current_tile.burned_stages==0&&events.Where(e=>e.AbilityId==both.Id&&e.Result.Changed).Select(e=>e.Action).Distinct().Count()==2,"同一真实表面完成净化与成熟，操作独立记忆和确认");
var grow=Def("native-growth","nature.grow",ConstructionContactMode.Interval,2);grow.Root.Form="branch";grow.Root.Matter="wood";grow.Root.Scale=2;Check(World.world.GetTileSimple(74,86).getBiome()!=null,"植被场景具有真实原版生物群系");Check(Cast(grow,new Vector3(74.5f,86.5f,0)),"接受原版植被规则的活木构造");await Advance(2.3f);var grown=events.Where(e=>e.AbilityId==grow.Id&&e.Result.Changed).ToArray();Check(grown.Length>0&&grown.All(e=>World.world.GetTileSimple(e.X,e.Y).hasBuilding()),"原版实际植被已出现，不把随机失败的尝试算作收益");
stage="resource";var spentCrop=Crop(74,80);var spent=Def("spent","crop.mature",ConstructionContactMode.Once,1);spent.Cost=10;spent.Resource="wakan";spent.Root.Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Recover,At=.6f,Seconds=.2f,Recovery=new ConstructionRecovery{Efficiency=.75f}}};Check(Cast(spent,new Vector3(74.5f,80.5f,0)),"接受产生真实收益后再收束的普通过程");await Advance(1.2f);Check(spentCrop.component_wheat.isMaxLevel()&&recoveries.Any(e=>e.AbilityId==spent.Id&&e.ConvertedVolume>0)&&recoveries.Where(e=>e.AbilityId==spent.Id).Sum(e=>e.Granted)==0,"实际世界收益消耗该部位支付份额，后续收束不重复返还费用");var unspent=Copy(spent);unspent.Id="test.world-contact.unspent";unspent.Impact.WorldEffects[0].Action="test.world-contact.counter";Check(Cast(unspent,new Vector3(74.5f,80.5f,0)),"接受没有世界收益的失败尝试后收束");await Advance(1.2f);Check(recoveries.Where(e=>e.AbilityId==unspent.Id).Sum(e=>e.Granted)>7.49,"未产生世界收益的份额仍可按原规则回收");
Check(crops[0].isAlive()&&crops[0].component_wheat.isMaxLevel()&&crops[0].current_tile.Type.farm_field,"保存前成熟麦田仍属于实际有效农田");var saves=Cultiway.ModClass.I.WorldSaves;var save=SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));Check(save.actors_data.Any(a=>a.id==actor.id),"正式原版保存包含实际施法者");File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,actor=actor.id,world=saves.World.Capture(World.world,"world-contacts"),person=saves.Actors.Capture(owner,"world-contacts"),mature=mature.Id,clean=clean.Id,grow=grow.Id,cropX=64,cropY=76,grownTiles=grown.Select(e=>new{e.X,e.Y}).ToArray()},Formatting.Indented));var result=new{passed=true,checks,events,recoveries,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{File.WriteAllText(Path.Combine(folder,"partial.json"),JsonConvert.SerializeObject(new{stage,checks,events,recoveries},Formatting.Indented));ConstructedAbilityService.WorldContactConfirmed-=Contact;ConstructedAbilityService.RecoveryConfirmed-=Recovery;DebugConfig.setOption(DebugOption.SystemBuildTick,originalBuild);Config.paused=true;}
