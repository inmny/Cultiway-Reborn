/// <summary>同一已经通过的抓投资料，保存与连续录像复用，不重建动作路径。</summary>
/// <param name="sample">本次指定场景。</param>
AbilityDefinition ReleasedBodyAction(string sample)
{
    var definition = CarryAction("rotate");
    definition.Body.Construction.Relations.Single().CollisionDamageScale = sample == "impact-zero" ? 0f : 1f;
    definition.Lifetime = 6f;
    definition.Body.Keys.Last().At = 6f;
    foreach (var key in definition.Body.Keys)
        key.Rotation[0] = key.At <= .9f ? 0f : key.At >= 1.1f ? 37.5f : (key.At - .9f) * 187.5f;
    definition.Id = "test.body-footwork.connections.carry-" + sample;
    var release = JsonConvert.DeserializeObject<BodyMotionKey>(JsonConvert.SerializeObject(definition.Body.Keys.Single(key => key.Id == "carry-raised")));
    release.At = 1f; release.Id = "throw-release";
    release.Hand = new[] { .465f, .12f, .9f }; release.Rotation = new[] { 30f, 47.5f, 0f };
    release.Support.Rise = .25f;
    definition.Body.Keys = definition.Body.Keys.Concat(new[] { release }).OrderBy(key => key.At).ToArray();
    definition.Body.Construction.Relations.Single().UntilMarker = release.Id;
    if (sample == "throw-item")
        foreach (BodyMotionKey key in definition.Body.Keys.Where(key => key.At > .3f && key.At <= 1f))
            key.Support.Rise = key.At <= .9f ? .5f * (key.At - .3f) / .6f : .5f;
    return definition;
}

/// <summary>只读取受力记录中的真实离手身体，不把普通下落冒充仍在旋转的身体。</summary>
/// <param name="id">实际目标。</param>
bool HasReleasedBody(long id)
{
    Type impulse = service.Assembly.GetType("Cultiway.Content.Skills.ConstructedActorImpulse");
    object[] query = { id, null };
    return (bool)impulse.GetMethod("TryBody", F).Invoke(null, query);
}

/// <summary>同一对人物在真实转动中松手；分别核对正常飞行和外部接管。</summary>
/// <param name="sample">本轮指定的一个场景。</param>
async Task VerifyReleasedBody(string sample)
{
    var facts = new List<ConstructedBodyFlight>();
    var impacts = new List<ConstructedBodyImpact>();
    bool impactCase = sample.StartsWith("impact");
    long sourceId = carrySource.id, targetId = carryTarget.id;
    float hp = 0f;
    object flight = null, owner = null;
    int damageCalls = 0;
    bool reaction = false, correctAttacker = false;
    float rawDamage = 0f;
    Type impulseType = service.Assembly.GetType("Cultiway.Content.Skills.ConstructedActorImpulse");
    var beforeField = typeof(ActorExtend).GetField("action_before_be_attacked", F);
    ActorExtend.ActionBeforeBeAttacked before = (ActorExtend self, BaseSimObject attacker,
        ref ElementComposition composition, ref AttackType type, ref float damage, ref bool ignore) =>
    {
        if (self.Base.id != targetId || type != AttackType.Gravity) return;
        damageCalls++; rawDamage = damage;
        reaction = CombatDamageEffects.IsResolvingReaction;
        correctAttacker = attacker?.getData()?.id == sourceId && !ignore;
        if (sample == "impact-external")
            impulseType.GetMethod("BeginDirected", F).Invoke(null, new object[] { carryTarget,
                new Vector3(3f, 0f, 0f), .5f, Field(Field(flight, "Motion"), "Terrain") });
    };
    object releasedSurface = null;
    Vector3 center = default, originalCenter = default, originalRoot = default;
    float gravity = 0f;
    void Changed(ConstructedBodyFlight fact)
    {
        if (fact.TargetId != targetId) return;
        facts.Add(fact);
        File.WriteAllText(Path.Combine(folder, "released-motion.json"), JsonConvert.SerializeObject(facts.Select(value => new { value.CastId, value.SourceId, value.TargetId,
            value.State, value.WorldTime, value.Reason, value.EnvironmentOwner, root = P(value.Root),
            velocity = P(value.Velocity), angular = P(value.AngularVelocity),
            rotation = new[] { value.Rotation.x, value.Rotation.y, value.Rotation.z, value.Rotation.w },
            environment = value.EnvironmentPoint.HasValue ? P(value.EnvironmentPoint.Value) : null }), Formatting.Indented));
        if (fact.State == ConstructedBodyFlightState.Contact && sample == "throw")
        {
            object post = service.GetMethod("BodyContactSurfaceAt", F).Invoke(null, new object[] { carryTarget.id, fact.WorldTime });
            Vector3 root = (Vector3)service.GetMethod("PhysicsFoot", F).Invoke(null, new object[] { carryTarget });
            Check(post != null && Vector3.Distance((Vector3)Field(post, "Foot"), root) < .0001f &&
                  !((AbilityCast)Field(owner, "Cast")).Finished,
                "原施放仍在运行时，环境交接同一步的表面查询已使用真实新根点", new {
                    pose = post != null ? P((Vector3)Field(post, "Foot")) : null, root = P(root),
                    finished = ((AbilityCast)Field(owner, "Cast")).Finished, bodyControlled = Field(owner, "BodyControlled"),
                    bindingChanged = Field(flight, "Binding").GetType().GetProperty("ChangedReason", F).GetValue(Field(flight, "Binding")) });
        }
        if (fact.State != ConstructedBodyFlightState.Released) return;
        Type impulse = service.Assembly.GetType("Cultiway.Content.Skills.ConstructedActorImpulse");
        object[] query = { carryTarget.id, null };
        Check((bool)impulse.GetMethod("TryBody", F).Invoke(null, query), "正式离手事件发布时实际身体运动已经取得控制");
        flight = query[1];
        owner = ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>()
            .Single(value => (long)Field(value, "Id") == fact.CastId);
        object connection = Field(owner, "Connection");
        releasedSurface = Field(connection, "Surface");
        var heldTransform = Field(connection, "Motion");
        Check(Vector3.Distance((Vector3)Field(releasedSurface, "Foot"), fact.Root) < .0001f &&
              Quaternion.Angle((Quaternion)Field(heldTransform, "Rotation"), fact.Rotation) < .001f &&
              Vector3.Distance((Vector3)Field(connection, "LinearVelocity"), fact.Velocity) < .0001f &&
              Vector3.Distance((Vector3)Field(connection, "AngularVelocity"), fact.AngularVelocity) < .0001f &&
              ReferenceEquals(Field(flight, "Lease"), Field(connection, "TargetLease")),
            "松手连续交接确认姿态、线速度、角速度及原控制，没有重置或重新抢占");
        object geometry = Field(flight, "Geometry"), path = Field(flight, "Flight");
        originalCenter = (Vector3)Field(geometry, "Center");
        originalRoot = (Vector3)Field(Field(flight, "Basis"), "Foot");
        object arc = Field(path, "Arc");
        center = (Vector3)Field(arc, "Origin");
        gravity = (float)Field(arc, "Gravity");
    }
    void Impact(ConstructedBodyImpact fact)
    {
        if (fact.TargetId != targetId) return;
        impacts.Add(fact);
        object path = Field(flight, "Flight"), arc = Field(path, "Arc");
        double age = fact.WorldTime - (double)Field(Field(flight, "Motion"), "StartedAt");
        Vector3 actualCenter = (Vector3)arc.GetType().GetMethod("Position", F).Invoke(arc, new object[] { age });
        Vector3 linear = (Vector3)arc.GetType().GetMethod("Speed", F).Invoke(arc, new object[] { age });
        Vector3 expected = linear + Vector3.Cross((Vector3)Field(path, "AngularVelocity"), fact.BodyPoint - actualCenter);
        float closing = Mathf.Max(0f, -Vector3.Dot(expected, fact.Normal.normalized));
        float mass = (float)Field(Field(flight, "ImpactSource"), "Mass");
        float scale = sample == "impact-zero" ? 0f : 1f;
        Check(Vector3.Distance(expected, fact.Velocity) < .0001f && Mathf.Abs(closing - fact.ClosingSpeed) < .0001f &&
              Mathf.Abs(.5f * mass * closing * closing * scale - fact.Damage) < .0001f &&
              fact.CastId == facts[0].CastId && fact.SourceId == sourceId && fact.SourcePowerLevel == 0f,
            "撞伤来自实际身体接触处的平移和转动，原施放结束后仍保留冻结归属", new {
                fact.WorldTime, fact.Damage, fact.ClosingSpeed, velocity = P(fact.Velocity), body = P(fact.BodyPoint),
                environment = P(fact.EnvironmentPoint), fact.SourceId, fact.SourcePowerLevel });
        // 用同一真实候选重入原接触入口；旧运动已消费，不能再次伤害或覆盖新受力。
        Type hitType = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Skills.BodySurfaceHit");
        object hit = Activator.CreateInstance(hitType, F, null, new object[] { 0f, fact.EnvironmentPoint,
            fact.Normal, "Duplicate", fact.EnvironmentOwner, (Vector3?)fact.BodyPoint }, null);
        impulseType.GetMethod("ContactBody", F).Invoke(null, new object[] { flight, hit, fact.WorldTime });
        File.WriteAllText(Path.Combine(folder, "body-impacts.json"), JsonConvert.SerializeObject(impacts.Select(value => new {
            value.CastId, value.SourceId, value.TargetId, value.WorldTime, value.EnvironmentOwner, value.SourcePowerLevel,
            body = P(value.BodyPoint), environment = P(value.EnvironmentPoint), normal = P(value.Normal),
            velocity = P(value.Velocity), value.ClosingSpeed, value.Damage }), Formatting.Indented));
    }
    if (impactCase)
    {
        ActorExtend.RegisterActionBeforeBeAttacked(before);
        ConstructedAbilityService.BodyImpactConfirmed += Impact;
    }
    ConstructedAbilityService.BodyFlightChanged += Changed;
    try
    {
        if (sample == "impact")
        {
            Type type = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Skills.BodyImpactKinetics");
            object Kinetic(Vector3 linear, Vector3 angular, float scale) => Activator.CreateInstance(type, F, null,
                new object[] { Vector3.zero, linear, angular, Vector3.right, Vector3.forward, 2f, scale }, null);
            object rotating = Kinetic(new Vector3(0, 0, -2), Vector3.up, 1f);
            Check((Vector3)Field(rotating, "Velocity") == new Vector3(0, 0, -3) &&
                  (float)Field(rotating, "Damage") == 9f &&
                  (float)Field(Kinetic(Vector3.right, Vector3.zero, 1f), "Damage") == 0f &&
                  (float)Field(Kinetic(Vector3.forward, Vector3.zero, 1f), "Damage") == 0f &&
                  (float)Field(Kinetic(-Vector3.forward, Vector3.zero, 0f), "Damage") == 0f,
                "纯数值：转动接触贡献实际撞伤，擦过、离开及零倍率均无撞伤");
        }
        Place(carrySource, 64, 72); Place(carryTarget, 64.25f, 72);
        carrySource.position_height = carryTarget.position_height = 0f;
        Quiet(carrySource); Quiet(carryTarget);
        if (sample == "throw-item")
        {
            Item sword = World.world.items.generateItem(AssetManager.items.get("sword_iron"), pActor: carryTarget);
            carryTarget.equipment.setItem(sword, carryTarget);
            carryTarget.setStatsDirty(); carryTarget.updateStats();
            // 沿已有持物专项先准备实际战斗持姿，再按其真实表面选站位。
            carryTarget.addAggro(carrySource);
        }
        carryTarget.setKingdom(World.world.units.getSimpleList().First(a => a.kingdom != carrySource.kingdom).kingdom);
        await Advance(.2f);
        var definition = ReleasedBodyAction(sample);
        // CARRY_FILM_PREPARE
        await PlaceConnection(carrySource, carryTarget, definition, latestContactAge: .75f);
        CombatStatusEffects.RemoveStatus(carrySource, quiet); carrySource.updateStats(); carrySource.cancelAllBeh();
        World.world.camera.transform.position = new Vector3(64, 72.5f, 0);
        MoveCamera.instance.forceZoom(2.2f);
        hp = carryTarget.data.health;
        int relationStart = relations.Count;
        await Fire(definition, carrySource, carryTarget);
        Config.paused = false;
        await Game.WaitUntil(() => facts.Any(fact => fact.State == ConstructedBodyFlightState.Released) ||
            relations.Skip(relationStart).Any(fact => fact.State == ConstructedBodyConnectionState.Released && fact.EnvironmentPoint.HasValue), 1200);
        Config.paused = true; await Game.WaitUntil(Boundary, 1200);
        Check(facts.Any(fact => fact.State == ConstructedBodyFlightState.Released),
            "完整抓投在被环境提前截停之前真实离手", relations.Skip(relationStart).Select(value => value.Reason).ToArray());
        var start = facts.Single(fact => fact.State == ConstructedBodyFlightState.Released);
        Check(start.Velocity.magnitude > .01f && start.AngularVelocity.magnitude > .1f && HasReleasedBody(carryTarget.id) &&
              BodyControlState.IsBusy(carryTarget.id) &&
              Vector3.Angle(start.Rotation * Vector3.forward, Vector3.forward) > 10f, "真实转动途中离手仍有线速度和转动，后续运动持有身体", new {
                  linear = P(start.Velocity), angular = P(start.AngularVelocity), start.WorldTime });
        if (sample == "impact-death")
        {
            carryTarget.dieSimpleNone();
            await Advance(.03f);
            Check(!HasReleasedBody(targetId) && !BodyControlState.IsBusy(targetId) && impacts.Count == 0 && damageCalls == 0 &&
                  facts.Count(value => value.State == ConstructedBodyFlightState.Cancelled) == 1,
                "飞行身体实际死亡后旧运动和控制归还，不再补结算撞伤");
            ((AbilityCast)Field(owner, "Cast")).Cancel();
            await Advance(.02f);
            return;
        }
        if (sample == "impact-world")
        {
            Check(BodyControlState.IsBusy(targetId), "换世界前真实离手身体仍持有原控制");
            World.world.save_manager.loadWorld(fixture);
            await Game.WaitUntil(() => !SmoothLoader.isLoading(), 1800);
            Config.paused = true; await Game.WaitUntil(Boundary, 1200);
            Check(!HasReleasedBody(targetId) && !BodyControlState.IsBusy(sourceId) && !BodyControlState.IsBusy(targetId) &&
                  facts.Count(value => value.State == ConstructedBodyFlightState.Cancelled && value.Reason == "WorldChanged") == 1 &&
                  impacts.Count == 0 && damageCalls == 0,
                "实际换世界先清空旧飞行及控制，只报告一次取消，不在新世界补结算撞伤");
            return;
        }
        if (sample == "throw-external")
        {
            carryTarget.velocity = new Vector3(3, 0, 0);
            await Advance(.02f);
            Check(!HasReleasedBody(carryTarget.id) && !BodyControlState.IsBusy(carryTarget.id) &&
                  carryTarget.under_forces && carryTarget.velocity.x > 1f &&
                facts.Count(fact => fact.State == ConstructedBodyFlightState.Cancelled) == 1,
                "外部重新施力后旧飞行归还控制，没有清掉外部速度", new { velocity = P(carryTarget.velocity) });
            carryTarget.stopForce();
            ((AbilityCast)Field(owner, "Cast")).Cancel();
            await Advance(.02f);
            Check(!BodyControlState.IsBusy(carrySource.id) && !BodyControlState.IsBusy(carryTarget.id),
                "外部接管场景结束后双方旧控制都已归还");
            return;
        }
        await Advance(.04f);
        Check(HasReleasedBody(carryTarget.id), "松手后继续实际飞行，没有一松手便恢复直立");
        object motion = Field(flight, "Motion");
        double time = (double)Field(motion, "SampledAt"), age = time - start.WorldTime;
        Quaternion expectedRotation = Quaternion.AngleAxis((float)(start.AngularVelocity.magnitude * age * Mathf.Rad2Deg),
            start.AngularVelocity.normalized) * start.Rotation;
        Vector3 expectedCenter = center + start.Velocity * (float)age - Vector3.forward * (.5f * gravity * (float)(age * age));
        Vector3 expectedRoot = expectedCenter + expectedRotation * (originalRoot - originalCenter);
        var surface = Field(flight, "Surface");
        Vector3 actualRoot = (Vector3)Field(surface, "Foot");
        object actualTransform = surface.GetType().GetProperty("RigidTransform", F).GetValue(surface);
        Quaternion actualRotation = (Quaternion)Field(actualTransform, "Rotation");
        Check(Vector3.Distance(expectedRoot, actualRoot) < .0001f &&
              Quaternion.Angle(expectedRotation, actualRotation) < .001f &&
              Quaternion.Angle(start.Rotation, actualRotation) > .1f,
            "根点、实际身体和转动按独立重力公式继续，不是直立投掷物", new {
                age, rootError = Vector3.Distance(expectedRoot, actualRoot),
                rotation = Quaternion.Angle(start.Rotation, actualRotation) });
        if (sample == "throw-detached" || impactCase)
        {
            ((AbilityCast)Field(owner, "Cast")).Cancel();
            await Advance(.02f);
            Check(endings.Any(ending => ending.Fact.AbilityId == definition.Id) && HasReleasedBody(carryTarget.id),
                "原施放结束后，离手身体仍独立沿同一轨迹运行");
        }
        if (impactCase)
        {
            carrySource.GetExtend().SetPowerLevel(9f);
            double pausedAt = World.world.getCurWorldTime();
            for (int frame = 0; frame < 8; frame++) await Game.NextFrame();
            Check(World.world.getCurWorldTime() == pausedAt && impacts.Count == 0 && carryTarget.data.health == hp,
                "暂停绘制不推进撞击时间、不提前扣血");
            Config.setWorldSpeed("x2", false);
        }
        if (!impactCase && !recordCarrying)
        {
        World.world.console.Hide();
        for (int frame = 0; frame < 8; frame++) await Game.NextFrame();
        if (worldfall != null) await Pair(carryTarget, "released", 0, true);
        var camera = World.world.camera;
        Vector3 oldPosition = camera.transform.position;
        float oldZoom = camera.orthographicSize;
        RenderTexture oldTarget = camera.targetTexture, oldActive = RenderTexture.active;
        var output = new RenderTexture(960, 540, 24, RenderTextureFormat.ARGB32);
        var picture = new Texture2D(960, 540, TextureFormat.RGBA32, false);
        output.Create();
        try
        {
            var bounds = (Bounds)surface.GetType().GetMethod("Bounds", F).Invoke(Field(flight, "Surface"), null);
            camera.transform.position = new Vector3(bounds.center.x, bounds.center.y + bounds.center.z, oldPosition.z);
            camera.orthographicSize = Mathf.Max(1.1f, (bounds.size.y + bounds.size.z) * .7f);
            camera.targetTexture = output; camera.Render(); RenderTexture.active = output;
            picture.ReadPixels(new Rect(0, 0, 960, 540), 0, 0); picture.Apply();
            File.WriteAllBytes(Path.Combine(folder, "released-body.png"), picture.EncodeToPNG());
        }
        finally
        {
            camera.targetTexture = oldTarget; camera.transform.position = oldPosition; camera.orthographicSize = oldZoom;
            RenderTexture.active = oldActive; output.Release();
            UnityEngine.Object.Destroy(output); UnityEngine.Object.Destroy(picture);
        }
        }
        Config.paused = false;
        await Game.WaitUntil(() => facts.Any(fact => fact.State == ConstructedBodyFlightState.Returned) && Boundary(), 1800);
        Config.paused = true;
        Check(facts.Count(fact => fact.State == ConstructedBodyFlightState.Contact) == 1 &&
              facts.Count(fact => fact.State == ConstructedBodyFlightState.Returned) == 1 &&
              !HasReleasedBody(carryTarget.id) && !BodyControlState.IsBusy(carryTarget.id),
            "真实身体首次到达环境后只确认一次接触并归还原控制");
        if (impactCase)
        {
            Check(impacts.Count == 1 && (sample == "impact-zero" ? damageCalls == 0 && carryTarget.data.health == hp :
                    damageCalls == 1 && reaction && correctAttacker && rawDamage > 0f && carryTarget.data.health < hp),
                "倍速和接触回调重入仍只结算一次；零倍率不伤害，正撞伤经过标准受击", new {
                    damageCalls, reaction, correctAttacker, rawDamage, hp, now = carryTarget.data.health });
            if (sample == "impact-external")
                Check(carryTarget.under_forces && carryTarget.velocity.x > 1f,
                    "伤害回调施加的新运动保留，旧接触归还没有清掉外部速度", new { velocity = P(carryTarget.velocity) });
            Config.setWorldSpeed("x1", false);
        }
        Config.paused = false;
        await Game.WaitUntil(() => !carryTarget.under_forces && Boundary(), 1800);
        Config.paused = true;
        Check(!BodyControlState.IsBusy(carryTarget.id) && !HasReleasedBody(carryTarget.id),
            "实际下落完成后目标恢复普通控制，不遗留离手运动");
        if (!((AbilityCast)Field(owner, "Cast")).Finished)
        {
            if (recordCarrying)
            {
                Config.paused = false;
                await Game.WaitUntil(() => endings.Any(ending => ending.Fact.AbilityId == definition.Id) && Boundary(), 1800);
                Config.paused = true;
                await Advance(.35f);
            }
            else
            {
                ((AbilityCast)Field(owner, "Cast")).Cancel();
                await Advance(.02f);
            }
        }
    }
    finally
    {
        Config.setWorldSpeed("x1", false);
        if (carrySource.data?.id == sourceId) carrySource.GetExtend().SetPowerLevel(0f);
        ConstructedAbilityService.BodyFlightChanged -= Changed;
        if (impactCase)
        {
            ConstructedAbilityService.BodyImpactConfirmed -= Impact;
            beforeField.SetValue(null, Delegate.Remove((Delegate)beforeField.GetValue(null), before));
        }
    }
}
