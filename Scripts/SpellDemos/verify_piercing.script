// B26：七种贯穿来源只核对自身资料、两人真实命中和一次支付，共用改轨迹、失败及恢复。
const bool commonOnly=false;
var manager=Cultiway.ModClass.I.SkillV3;var original=Cultiway.Core.SkillLibV3.Manager.ConstructionEmission;
var starts=new List<ConstructedCastStarted>();var accepted=new List<AbilityCast>();var activeCasts=new List<AbilityCast>();
var emissions=new List<object>();var damageEvents=new List<GetHitEvent>();var forceAfterHit=new List<float>();
SkillEntityAsset currentAsset=SkillEntities.GoldenNeedle;bool invalidate=false,scopeValid=true,moveOnEmission=false;
SkillEmissionResult? lastResult=null;int oldExecutions=0;
Actor source=Make(64),target=Make(70),other=Make(74),outside=Make(71),wolf=Make(12,"wolf");
foreach(var actor in new[]{target,other,outside})actor.setKingdom(wolf.kingdom);
// 使用初阶修士：原规则普通单发，显式连发词条提供第二发；不修改游戏的发射预算。
var owner=source.GetExtend();owner.NewCultisys(Cultisyses.Xian);owner.GetCultisys<Xian>().level=0;
owner.MarkCultiwayStatsDirty();source.setStatsDirty();source.updateStats();await Advance(.2f);
/// <summary>读取原学习关系中的真实容器。</summary>
IReadOnlyList<Entity> Learned()=>(IReadOnlyList<Entity>)typeof(ActorExtend).GetMethod("GetLearnedSkillsInOrder",F).Invoke(owner,null);
/// <summary>用原学习入口保留来源、词条和可选追踪改造。</summary><param name="boost">强化、范围、加速及两次逐发。</param><param name="extra">未映射附加作用。</param><param name="homing">改为普通目标追踪。</param>
Entity Build(bool boost=false,bool extra=false,bool homing=false)
{
    var builder=new SkillContainerBuilder(currentAsset).UseAnimation(0);
    if(boost)
    {
        builder.AddModifier(new HugeModifier{Value=1.4f});builder.AddModifier(new EmpowerModifier{SetupBonus=.3f});
        builder.AddModifier(new HasteModifier{SpeedMultiplier=.5f});builder.AddModifier(new ProficiencyModifier{CostReduction=.2f});
        builder.AddModifier(new SalvoCount{Value=2});builder.AddModifier(new ComboModifier{DamageMultiplier=.8f});
        builder.AddModifier(new VolleyModifier{DamageMultiplier=.9f});
    }
    if(extra)builder.AddModifier(new BurnModifier{Duration=1,DamageRatio=.1f});
    if(homing)builder.AddModifier(new Trajectory{ID=SkillTrajectories.TowardsTarget.id});
    Entity made=builder.Build(SkillContainerBuildMode.RuleOnly);string signature=SkillContainerSignature.Build(made);
    owner.LearnSkillV3(made);return Learned().First(s=>SkillContainerSignature.Build(s)==signature);
}
var converter=service.Assembly.GetType("Cultiway.Content.Skills.ProjectileConstructionMigration").GetMethod("Convert",F);
/// <summary>读取实际发射将转换的自足资料。</summary><param name="skill">原已学来源。</param><param name="damage">原本体力量及境界。</param>
AbilityDefinition Convert(Entity skill,out GetHitEvent damage)
{
    object[] args={new SkillEmission{Source=source,SpatialSource=source,SkillContainer=skill,Target=target,
        SourcePos=new Vector3(64,72,.3f),TargetPos=new Vector3(70,72,.3f),Strength=40,PowerLevel=1.25f},default(GetHitEvent),Vector3.zero};
    var result=(AbilityDefinition)converter.Invoke(null,args);damage=(GetHitEvent)args[1];return result;
}
/// <summary>记录本批真正开始的来源。</summary><param name="fact">正式受理事实。</param>
void Started(ConstructedCastStarted fact){if(fact.AbilityId==currentAsset.id)starts.Add(fact);}
/// <summary>任何旧执行体都表示本批双执行缺陷。</summary><param name="entity">原实例。</param>
void Old(Entity entity){if(entity.GetComponent<SkillEntity>().Asset==currentAsset)oldExecutions++;}
/// <summary>在真实接触之后记录仍可用于防御的本体量。</summary><param name="contact">已经结算的真实接触。</param>
void AfterContact(ConstructedContact contact){if(contact.AbilityId==currentAsset.id)forceAfterHit.Add(accepted.Last().RemainingForce(0));}
/// <summary>复用原人物、位置和资源准备，不放宽实际来源规则。</summary>
void ResetPeople()
{
    Ready(source);Place(source,64);Place(target,70);Place(other,74);Place(outside,71,76);
    owner.GetCultisys<Xian>().wakan=source.stats[BaseStatses.MaxWakan.id]*.8f;
    foreach(var actor in new[]{source,target,other,outside})ConstructedAbilityService.NotifyActorChanged(actor);
}
/// <summary>原已学施放入口。</summary><param name="skill">真实容器。</param><param name="scope">可选实际世界边界。</param>
bool Use(Entity skill,ConstructionWorldScope scope=null)
{
    bool used=ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("core.learned_skill",skill),
        new ActiveAbilityTarget(target,target.GetSimPos(),selectionArea:new SkillTargetSelectionArea(true,target.GetSimPos(),.1f),worldScope:scope),ActiveAbilityUseOrigin.Script);
    source.attack_timer=999;CombatStatusEffects.ApplyStatus(source,hold,10000,source);source.updateStats();return used;
}
/// <summary>读取同一实际显示。</summary><param name="cast">真实施放。</param>
List<FormVisualInstance> Views(AbilityCast cast){var views=new List<FormVisualInstance>();cast.AppendVisuals(views);return views;}
/// <summary>读取同一实际接触。</summary><param name="cast">真实施放。</param>
List<AbilityCapsule> Shapes(AbilityCast cast){var shapes=new List<AbilityCapsule>();cast.AppendContacts(shapes);return shapes;}
ConstructedAbilityService.CastStarted+=Started;ConstructedAbilityService.ContactConfirmed+=AfterContact;
Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured+=Old;
var hook=new HarmonyLib.Harmony("Cultiway.Verify.Piercing");
PiercingDamage.AfterDamage=e=>{if(e.AttackerID==source.id)damageEvents.Add(e);};
hook.Patch(typeof(Cultiway.Core.EventSystem.Systems.GetHitEventSystem).GetMethod("Resolve",F),
    postfix:new HarmonyLib.HarmonyMethod(typeof(PiercingDamage).GetMethod("Postfix")));
try
{
    Cultiway.Core.SkillLibV3.Manager.ConstructionEmission=request=>
    {
        if(request.Source!=source||request.SkillContainer.GetComponent<SkillContainer>().Asset!=currentAsset)return original(request);
        if(invalidate)scopeValid=false;var result=original(request);lastResult=result;
        if(result==SkillEmissionResult.Accepted)
        {
            var running=((IEnumerable)service.GetField("casts",F).GetValue(null)).Cast<object>().Single(r=>(long)Field(r,"Id")==starts.Last().CastId);
            var cast=(AbilityCast)Field(running,"Cast");accepted.Add(cast);activeCasts.Add(cast);
            if(moveOnEmission){Place(target,74,76);ConstructedAbilityService.NotifyActorChanged(target);}
        }
        emissions.Add(new{asset=currentAsset.id,result=result.ToString(),request.Strength,request.PowerLevel,request.InitialAngleOffsetDegrees,skill=request.SkillContainer.Id});return result;
    };
    if(!commonOnly)foreach(var entry in new[]{(Asset:SkillEntities.GoldenNeedle,Form:"golden_needle",Matter:"gold",State:"solid"),
        (Asset:SkillEntities.PoisonNeedle,Form:"poison_needle",Matter:"poison",State:"liquid"),
        (Asset:SkillEntities.StoneCone,Form:"stone_cone",Matter:"earth",State:"solid"),
        (Asset:SkillEntities.IceLance,Form:"ice_lance",Matter:"ice",State:"solid"),
        (Asset:SkillEntities.LightningSpear,Form:"lightning_spear",Matter:"lightning",State:"energy"),
        (Asset:SkillEntities.WaterArrow,Form:"water_arrow",Matter:"water",State:"liquid"),
        (Asset:SkillEntities.WoodSpear,Form:"wood_spear",Matter:"wood",State:"solid")})
    {
        currentAsset=entry.Asset;starts.Clear();accepted.Clear();contacts.Clear();damageEvents.Clear();forceAfterHit.Clear();oldExecutions=0;
        var normal=Build();var boosted=Build(true);
        float duration=.9f;
        if(entry.Asset==SkillEntities.WaterArrow||entry.Asset==SkillEntities.GoldenNeedle||entry.Asset==SkillEntities.LightningSpear||entry.Asset==SkillEntities.IceLance)
        {
            var animation=entry.Asset.GetAnimation(0);
            float interval=normal.GetComponent<SkillContainer>().MotionProfile.FrameInterval;
            duration+=animation.Appearance.Frames.Length*animation.Appearance.Settings.ResolveFrameInterval(interval)+
                animation.Dissipation.Frames.Length*animation.Dissipation.Settings.ResolveFrameInterval(interval);
        }
        foreach(var skill in new[]{normal,boosted})
        {
            var d=Convert(skill,out GetHitEvent damage);bool boost=skill.HasComponent<HugeModifier>();
            var restored=JsonConvert.DeserializeObject<AbilityDefinition>(JsonConvert.SerializeObject(d));var plan=AbilityCompiler.Compile(restored,cache:false);
            Check(d.Root.Form==entry.Form&&d.Root.Matter==entry.Matter&&d.Root.State==entry.State&&
                d.Root.OnContact==ConstructionContactResponse.Continue&&d.Root.Contact.Mode==ConstructionContactMode.Once&&
                d.Root.Contact.MaximumPerTarget==1&&Math.Abs(d.Root.Impact.DamageScale-.85f)<.0001f&&Math.Abs(d.Lifetime-duration)<.0001f&&
                Math.Abs(damage.Damage-(boost?37.44f:40f))<.001f&&damage.AttackerPowerLevel==1.25f&&damage.Element.Equals(entry.Asset.Element),
                entry.Form+"独立主体、实际材料、原强度与贯穿规则可保存编译",new{damage.Damage,d.Root.Scale,d.Lifetime});
            File.WriteAllText(Path.Combine(folder,entry.Form+(boost?"-enhanced.json":".json")),JsonConvert.SerializeObject(d,Formatting.Indented));
        }
        Check(Convert(Build(extra:true),out _)!=null,entry.Form+"燃烧附加作用由共同构造接管");
        ResetPeople();float balance=owner.GetCultisys<Xian>().wakan;int hp=target.data.health,hp2=other.data.health;
        Check(Use(normal),entry.Form+"原已学入口受理");await Advance(.12f);
        var live=accepted.Single();Check(oldExecutions==0&&starts.Count==1&&Views(live).Single().Resource.Description.Id==entry.Form,
            entry.Form+"只运行自身新主体且无旧执行");await Shot(entry.Form);
        await Advance(duration+.1f);
        double cost=SkillCastResources.Wakan.Quote(owner,SkillCastCost.CalculateStepDemand(normal)*Mathf.Sqrt(SkillEffectRadius.ResolveCasterGrowth(owner,normal)));
        Check(Math.Abs(balance-owner.GetCultisys<Xian>().wakan-cost)<.001f,entry.Form+"只支付一次",new{cost,balance,after=owner.GetCultisys<Xian>().wakan});
        Check(contacts.Count(c=>c.AbilityId==entry.Asset.id&&c.TargetId==target.id)==1&&
            contacts.Count(c=>c.AbilityId==entry.Asset.id&&c.TargetId==other.id)==1&&
            contacts.All(c=>c.TargetId!=outside.id)&&target.data.health<hp&&other.data.health<hp2&&
            damageEvents.Count==2&&damageEvents.All(e=>Math.Abs(e.Damage-85f)<.01f&&e.Element.Equals(entry.Asset.Element))&&
            forceAfterHit.Count==2&&forceAfterHit.All(f=>Math.Abs(f-100f)<.01f),
            entry.Form+"贯穿两人且每人一次，后续伤害和本体量不凭空衰减",new{hits=damageEvents.Select(e=>new{e.TargetID,e.Damage}).ToArray(),force=forceAfterHit.ToArray(),hp,after=target.data.health,hp2,after2=other.data.health});
        Check(live.Finished&&Views(live).Count==0&&Shapes(live).Count==0&&!BodyControlState.IsBusy(source.id),entry.Form+"原寿命结束后显示接触与控制恢复");
    }
    // 加速、范围和强化后两次逐发只验证共用路径；同时覆盖合击与齐射的单发衰减。
    currentAsset=SkillEntities.GoldenNeedle;starts.Clear();accepted.Clear();contacts.Clear();damageEvents.Clear();forceAfterHit.Clear();oldExecutions=0;
    // 连发按原境界预算计算；使用原第一阶段预算，普通发射为1，带连发词条的实际计划为2。
    owner.GetCultisys<Xian>().level=1;owner.MarkCultiwayStatsDirty();source.setStatsDirty();source.updateStats();
    ResetPeople();var enhanced=Build(true);float enhancedBalance=owner.GetCultisys<Xian>().wakan;
    var emissionPlan=SkillCastPlanner.CreatePlan(owner,enhanced,target,SkillCastCost.GetAffordableStepLimit(owner,enhanced),explicitTargetsOnly:true);
    Check(emissionPlan.Steps.Count==2,"原境界预算与连发词条形成两发计划",new{steps=emissionPlan.Steps.Count});
    Check(Use(enhanced),"强化贯穿的两次逐发受理");await Advance(1.8f);
    double stepCost=SkillCastResources.Wakan.Quote(owner,SkillCastCost.CalculateStepDemand(enhanced)*Mathf.Sqrt(SkillEffectRadius.ResolveCasterGrowth(owner,enhanced)));
    Check(starts.Count==2&&oldExecutions==0&&accepted.All(c=>c.Finished)&&
        Math.Abs(enhancedBalance-owner.GetCultisys<Xian>().wakan-stepCost*2)<.001f&&
        damageEvents.Count==4&&damageEvents.All(e=>Math.Abs(e.Damage-79.56f)<.01f),
        "强化、合击和齐射倍率保留，两发分别收费和贯穿",new{casts=starts.Count,stepCost,damages=damageEvents.Select(e=>e.Damage).ToArray()});
    // 实际发射后移动真实目标，共用追踪读取新位置，不只验证保存字段。
    owner.GetCultisys<Xian>().level=0;owner.MarkCultiwayStatsDirty();source.setStatsDirty();source.updateStats();
    starts.Clear();accepted.Clear();contacts.Clear();damageEvents.Clear();forceAfterHit.Clear();ResetPeople();Place(target,74);Place(other,12);moveOnEmission=true;
    var homing=Build(homing:true);var tracking=Convert(homing,out _);Check(tracking.Root.Operations.Any(operation=>operation.Goal?.Follow==true),"贯穿金针可改为普通目标追踪");
    Check(Use(homing),"改轨迹的原已学入口受理");await Advance(tracking.Lifetime+.15f);moveOnEmission=false;
    Check(contacts.Count(c=>c.AbilityId==currentAsset.id&&c.TargetId==target.id)==1&&
        contacts.Where(c=>c.AbilityId==currentAsset.id).All(c=>c.Position.y>74f)&&accepted.All(c=>c.Finished),
        "实际出手后目标由74,72移至74,76，金针转向并命中新位置");
    // 一次真正受理失败、原值退款和恢复。
    ResetPeople();var failed=Build();int count=starts.Count;float before=owner.GetCultisys<Xian>().wakan;invalidate=true;
    Check(Use(failed,new ConstructionWorldScope(()=>scopeValid,(_,_)=>true)),"安排贯穿投射实际受理失败");await Advance(.25f);invalidate=false;
    Check(lastResult==SkillEmissionResult.Rejected&&starts.Count==count&&Math.Abs(owner.GetCultisys<Xian>().wakan-before)<.001f&&oldExecutions==0,
        "实际受理失败原值退款且无新旧残留");scopeValid=true;ResetPeople();Check(Use(failed),"失败后同一来源恢复施放");await Advance(tracking.Lifetime+.15f);
    Check(accepted.All(c=>c.Finished),"恢复后正常结束");
    // 原飞剑仅核对受本次共用转换调整影响的正常路径，不重跑全部旧轨迹。
    currentAsset=SkillEntities.FlyingSword;starts.Clear();accepted.Clear();contacts.Clear();damageEvents.Clear();forceAfterHit.Clear();oldExecutions=0;ResetPeople();
    var sword=Build();Check(Use(sword),"原飞剑共同转换对照受理");await Advance(1.2f);
    Check(starts.Count==1&&oldExecutions==0&&accepted.Single().Finished&&damageEvents.Count==1&&
        damageEvents[0].TargetID==target.id&&Math.Abs(damageEvents[0].Damage-100f)<.01f,
        "原飞剑仍在一次真实命中后结束，强度和原规则未改变");
    return new{passed=true,process=System.Diagnostics.Process.GetCurrentProcess().Id};
}
finally
{
    File.WriteAllText(Path.Combine(folder,"emissions.json"),JsonConvert.SerializeObject(emissions,Formatting.Indented));
    foreach(var cast in activeCasts)cast.Cancel();PiercingDamage.AfterDamage=null;hook.UnpatchSelf();
    Cultiway.Core.SkillLibV3.Manager.ConstructionEmission=original;Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured-=Old;
    ConstructedAbilityService.CastStarted-=Started;ConstructedAbilityService.ContactConfirmed-=AfterContact;
    ConstructedAbilityService.ContactConfirmed-=Hit;ConstructedAbilityService.CastEnded-=Ended;ControllableUnit.clear(false);Config.paused=true;
}
public static class PiercingDamage
{
    /// <summary>只记录实际经过标准伤害结算的输入。</summary>
    public static Action<GetHitEvent> AfterDamage;
    /// <summary>不替换伤害结算。</summary><param name="__0">已经结算的实际输入。</param>
    public static void Postfix(GetHitEvent __0)=>AfterDamage?.Invoke(__0);
}
