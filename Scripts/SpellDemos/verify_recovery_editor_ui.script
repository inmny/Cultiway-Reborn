// 经真实表单编辑结束余量交接，保存后重新打开；不写玩家世界。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using UnityEngine;
using UnityEngine.UI;
using Cultiway.Core;
using Cultiway.Core.Skills;
using Cultiway.Content.Skills;
using Cultiway.Content.Components;
using Cultiway.UI;
using Cultiway.UI.Prefab;
using Cultiway.Utils.Extension;

const BindingFlags Flags=BindingFlags.Instance|BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic;
object Field(object value,string key)=>value.GetType().GetField(key,Flags).GetValue(value);
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/recovery/ui");Directory.CreateDirectory(folder);
var checks=new List<string>();void Check(bool value,string name){if(!value)throw new InvalidOperationException(name);checks.Add(name);}
string T(string key)=>LocalizedTextManager.getText("Cultiway.Construction."+key);
async Task Frames(int count=3){for(int i=0;i<count;i++)await Game.NextFrame();await Game.WaitUntil(()=>!ScrollWindow.isAnimationActive(),300);Canvas.ForceUpdateCanvases();}
async Task Shot(string name){var scroll=Resources.FindObjectsOfTypeAll<ScrollRect>().First(r=>r.name=="Parameters"&&r.gameObject.activeInHierarchy);var target=((WindowWanfaConstructionEditor)typeof(WindowWanfaConstructionEditor).GetField("instance",Flags).GetValue(null)).GetComponentsInChildren<InputField>(false).Single(f=>f.name=="RecoverySeconds");Canvas.ForceUpdateCanvases();var location=RectTransformUtility.CalculateRelativeRectTransformBounds(scroll.viewport,target.transform);scroll.verticalNormalizedPosition=Mathf.Clamp01(scroll.verticalNormalizedPosition+(location.center.y-scroll.viewport.rect.center.y)/Mathf.Max(1,scroll.content.rect.height-scroll.viewport.rect.height));World.world.console.Hide();Tooltip.hideTooltipNow();foreach(var loading in Resources.FindObjectsOfTypeAll<LoadingScreen>())loading.gameObject.SetActive(false);await Frames(4);Screen.Capture(Path.Combine(folder,name+".png"));await Frames();}
Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;
var actor=World.world.units.createNewUnit("human",World.world.GetTileSimple(64,72),pAdultAge:true,pSpawnWithItems:false);actor.data.name="收束回能表单验证";actor.addTrait("super_health");var owner=actor.GetExtend();owner.AddComponent(new Xian{level=2,wakan=10000});
var original=JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/水层收束回能.json")));ConstructedAbilityService.Register(original);ConstructedAbilityService.Learn(owner,original.Id);LocalizedTextManager.instance.setLanguage("cz");await Frames();WindowWanfaConstructionEditor.Open(original.Id,actor);await Frames();
var editor=(WindowWanfaConstructionEditor)typeof(WindowWanfaConstructionEditor).GetField("instance",Flags).GetValue(null);
Button B(string name)=>editor.GetComponentsInChildren<Button>(false).First(b=>b.name==name);
void Click(string name){Check(B(name).interactable,"按钮可用："+name);B(name).onClick.Invoke();}
InputField Input(string key)=>editor.GetComponentsInChildren<InputField>(false).First(f=>f.name==key);
void Set(string key,string value){var field=Input(key);field.text=value;field.onEndEdit.Invoke(value);}
ConstructionEditSession Session()=>(ConstructionEditSession)Field(editor,"session");
WanfaEditorRow Row(string key)=>editor.GetComponentsInChildren<WanfaEditorRow>(false).First(r=>((Text)Field(r,"_title")).text==T(key));
void Action(string key)=>((Button)Field(Row(key),"_action")).onClick.Invoke();


Click("Page0");Check(Input("RecoveryEfficiency").text=="0.75","普通属性页读取真实回能效率");Action("RemoveRecovery");Check(!Session().Draft.Root.Operations.Any(o=>o.Kind==ConstructionOperationKind.Recover),"普通表单可移除收束");Action("AddRecovery");Set("RecoverAt","2.2");Set("RecoverySeconds","0.8");Set("RecoveryEfficiency","0.5");Set("RecoveryEfficiency","1.1");Check(!B("LearnCopy").interactable,"超过支付份额的效率在正式保存前报告");Click("Undo");Check(Session().Draft.Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Recover).Recovery.Efficiency==.5f,"撤销恢复有效回能比例");await Shot("recovery-cz");Click("Replace");string id=Session().SourceId;Click("Close");await Frames();WindowWanfaConstructionEditor.Open(id,actor);await Frames();Click("Page0");Check(Input("RecoverySeconds").text=="0.8"&&Input("RecoveryEfficiency").text=="0.5","保存关闭重开恢复真正历时与效率");LocalizedTextManager.instance.setLanguage("en");Click("Page0");await Shot("recovery-en");int width=UnityEngine.Screen.width,height=UnityEngine.Screen.height;bool full=UnityEngine.Screen.fullScreen;UnityEngine.Screen.SetResolution(1024,768,false);await Frames(8);await Shot("recovery-en-1024");var corners=new Vector3[4];((RectTransform)editor.transform.Find("Background")).GetWorldCorners(corners);Check(corners.All(p=>p.x>=0&&p.y>=0&&p.x<=UnityEngine.Screen.width&&p.y<=UnityEngine.Screen.height),"回能表单在小分辨率内完整显示");Click("Close");await Frames();UnityEngine.Screen.SetResolution(width,height,full);LocalizedTextManager.instance.setLanguage("cz");Config.paused=false;await Game.WaitUntil(()=>World.world.units.getSimpleList().Any(a=>a.id==actor.id),1800);Config.paused=true;SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));var saves=Cultiway.ModClass.I.WorldSaves;File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,actor=actor.id,id,world=saves.World.Capture(World.world,"recovery-ui"),person=saves.Actors.Capture(owner,"recovery-ui")},Formatting.Indented));var result=new{passed=true,checks,id};File.WriteAllText(Path.Combine(folder,"checks.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
