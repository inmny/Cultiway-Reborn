// 4.01：同一构造的任选、全部支付，以及按原资源独立收束和保存。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core;
using Cultiway.Core.Skills;
using Cultiway.Core.SkillLibV3;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Content;
using Cultiway.Content.Components;
using Cultiway.Content.Skills;
using Cultiway.Content.Combat;
using Cultiway.Utils.Extension;
string root = Cultiway.ModClass.I.GetDeclaration().FolderPath, folder = Path.Combine(root, "artifacts/skill_rebuild/multiresource"); Directory.CreateDirectory(folder);
var checks = new List<object>(); void Check(bool pass, string name, object evidence = null) { checks.Add(new { pass, name, evidence }); if (!pass) throw new InvalidOperationException(name); }
bool Near(double a, double b) => Math.Abs(a - b) < .001;
var rt = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner"); object runner = rt.GetProperty("Instance").GetValue(null); async Task Boundary() => await Game.WaitUntil(() => (bool)rt.GetProperty("IsAtCycleBoundary").GetValue(runner), 3600); async Task Advance(float seconds) { Config.paused = false; double until = World.world.getCurWorldTime() + seconds; await Game.WaitUntil(() => World.world.getCurWorldTime() >= until, 3600); Config.paused = true; await Boundary(); }
Game.Resume(); Config.paused = true; ControllableUnit.clear(false); Config.setWorldSpeed("x1", false); World.world.save_manager.loadWorld(Path.Combine(root, "Scripts/WorldSaveTests/Fixtures/world-format-1")); while (SmoothLoader.isLoading()) { Config.paused = true; await Game.NextFrame(); }
await Boundary();
var stats = new BaseStats { ["mana"] = 1000, [BaseStatses.MaxWakan.id] = 1000, [BaseStatses.MaxVigor.id] = 1000 }; stats.addTag("frozen_ai"); stats.addTag("immovable"); var hold = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("test.multiresource.hold").SetStats(stats).SetDuration(10000).Build(); foreach (var unit in World.world.units.getSimpleList().ToArray()) { CombatStatusEffects.ApplyStatus(unit, hold, 10000, unit); unit.current_position = new Vector2(12, 12); unit.updatePos(); }
var actor = World.world.units.createNewUnit("human", World.world.GetTileSimple(64, 72), pAdultAge: true, pSpawnWithItems: false); actor.addTrait("super_health"); CombatStatusEffects.ApplyStatus(actor, hold, 10000, actor); var owner = actor.GetExtend(); owner.AddComponent(new Xian { level = 2, wakan = 100 }); owner.AddComponent(new Knight { level = 2, vigor = 100 }); owner.AddComponent(new Magic { level = 2, spirit = 100 }); owner.MarkCultiwayStatsDirty(); actor.setStatsDirty(); actor.updateStats(); await Advance(.15f);
var manaChange = SimGlobals.m.mana_change; var staminaChange = SimGlobals.m.stamina_change; SimGlobals.m.mana_change = 0; SimGlobals.m.stamina_change = 0;
var recoveries = new List<ConstructedRecovery>(); void Recovery(ConstructedRecovery r) { if (r.AbilityId.StartsWith("test.multiresource.")) recoveries.Add(r); }
ConstructedAbilityService.RecoveryConfirmed += Recovery;
var changes = new List<WorldMaterialChange>(); void Changed(WorldMaterialChange c) => changes.Add(c); WorldMaterialService.Changed += Changed;
AbilityDefinition D(string suffix, string resource, string[] extra, SkillCastResourceRequirementMode mode, bool leave = false) => new() { Id = "test.multiresource." + suffix, Name = "多资源验证", Resource = resource, AdditionalResources = extra, ResourceMode = mode, Cost = 2.25f, Cooldown = 0, Lifetime = 1.2f, Power = 0, Binding = new ConstructionBinding { Anchor = AbilityAnchor.Source }, Impact = new ConstructionImpact { Targets = Cultiway.Core.SkillLibV3.Usage.SkillUseTargetRelation.Self, DamageScale = 0 }, Root = new ConstructionNode { Id = "matter", Form = "sword", Matter = "iron", ContactRole = ConstructionContactRole.Decoration, Operations = leave ? new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Leave, At = .1f, Residue = new ConstructionResidue { Lifetime = 30 } } } : new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Recover, At = .1f, Seconds = .4f, Recovery = new ConstructionRecovery { Efficiency = .75f } } } } };
bool Fire(AbilityDefinition d) { ConstructedAbilityService.Register(d); ConstructedAbilityService.Learn(owner, d.Id); return ActiveAbilityService.TryUse(owner, new ActiveAbilityHandle("content.constructed", owner.E, d.Id), new ActiveAbilityTarget(actor, actor.GetSimPos()), ActiveAbilityUseOrigin.Script); }
var saves = Cultiway.ModClass.I.WorldSaves; JObject WorldData() => JObject.Parse(saves.World.Capture(World.world, "multiresource")); JArray Rows() => (JArray)WorldData()["sections"]["world_materials"]["data"]["Records"];
try
{
    owner.GetCultisys<Xian>().wakan = 100; actor.setMana(100, false); var both = D("all", "wakan", new[] { "mana" }, SkillCastResourceRequirementMode.AllOf); Check(Fire(both) && Near(owner.GetCultisys<Xian>().wakan, 97.75) && actor.getMana() == 97, "同一实际需求分别报价，真元扣2.25、法力扣3"); await Advance(.8f); var credits = recoveries.Where(r => r.AbilityId == both.Id).ToArray(); Check(Near(credits.Where(r => r.Resource == SkillCastResources.Wakan.id).Sum(r => r.Granted), 1.6875) && credits.Where(r => r.Resource == SkillCastResources.NativeMana.id).Sum(r => r.Granted) == 2, "收束分别返还原本金的75%，法力按自身累计取整"); Check(credits.All(r => r.ProviderId == actor.id) && credits.Sum(r => r.ConvertedVolume) > 0, "原支付者与实际转化体积保持，逐资源事件不重复材料体积"); await Advance(.6f);
    owner.GetCultisys<Xian>().wakan = 100; actor.setMana(0, false); var insufficient = D("insufficient", "wakan", new[] { "mana" }, SkillCastResourceRequirementMode.AllOf); Check(!Fire(insufficient) && Near(owner.GetCultisys<Xian>().wakan, 100) && actor.getMana() == 0, "全部支付缺少第二种资源时拒绝，第一种余额保持");
    var any = D("any", "mana", new[] { "wakan" }, SkillCastResourceRequirementMode.AnyOf); Check(Fire(any) && Near(owner.GetCultisys<Xian>().wakan, 97.75) && actor.getMana() == 0, "任选按声明顺序跳过不足通道，只支付实际选中的真元"); await Advance(.8f); Check(recoveries.Where(r => r.AbilityId == any.Id).All(r => r.Resource == SkillCastResources.Wakan.id) && Near(recoveries.Where(r => r.AbilityId == any.Id).Sum(r => r.Granted), 1.6875), "任选只回收实际支付的资源，不生成未支付的法力"); await Advance(.6f);
    actor.setMana(100, false); var alias = D("alias", "mana", new[] { SkillCastResources.Mana.id }, SkillCastResourceRequirementMode.AllOf); Check(Fire(alias) && actor.getMana() == 94, "原版和魔法法力共用余额，两个需求合计扣6"); await Advance(.8f); Check(recoveries.Where(r => r.AbilityId == alias.Id).Sum(r => r.Granted) == 4, "共享余额只生成一份实际本金与回收累计"); await Advance(.6f);
    owner.GetCultisys<Xian>().wakan = 100; actor.setMana(100, false); both = D("capacity", "wakan", new[] { "mana" }, SkillCastResourceRequirementMode.AllOf); Check(Fire(both), "各资源容量隔离场景实际受理"); actor.setMana(actor.getMaxMana(), false); await Advance(.8f); credits = recoveries.Where(r => r.AbilityId == both.Id).ToArray(); Check(credits.Where(r => r.Resource == SkillCastResources.NativeMana.id).Sum(r => r.Granted) == 0 && Near(credits.Where(r => r.Resource == SkillCastResources.Wakan.id).Sum(r => r.Granted), 1.6875), "法力已满只损失法力回能，不能增加真元返还"); await Advance(.6f);
    foreach (var bad in new[] { D("bad-single", "wakan", new[] { "mana" }, SkillCastResourceRequirementMode.Single), D("bad-duplicate", "wakan", new[] { "wakan" }, SkillCastResourceRequirementMode.AllOf), D("bad-none", "wakan", new[] { "none" }, SkillCastResourceRequirementMode.AnyOf) }) { bool rejected = false; try { ConstructedAbilityService.Register(bad); } catch (InvalidDataException) { rejected = true; } Check(rejected, "明确拒绝无效支付声明：" + bad.Id); }
    var text = D("text", "wakan", new[] { "mana" }, SkillCastResourceRequirementMode.AllOf); LocalizedTextManager.instance.setLanguage("cz"); Check(ConstructionPresentation.Explain(text, AbilityCompiler.Compile(text)).Contains("真元及法力"), "中文说明列出同时支付的实际通道"); LocalizedTextManager.instance.setLanguage("en"); text.ResourceMode = SkillCastResourceRequirementMode.AnyOf; Check(ConstructionPresentation.Explain(text, AbilityCompiler.Compile(text)).Contains(" or "), "英文说明明确显示任选关系"); LocalizedTextManager.instance.setLanguage("cz");
    owner.GetCultisys<Xian>().wakan = 100; actor.setMana(100, false); var leave = D("leave", "wakan", new[] { "mana" }, SkillCastResourceRequirementMode.AllOf, true); Check(Fire(leave), "多资源材料通过真实留置交给世界"); await Advance(1.4f); var row = (JObject)Rows().Single(); var funding = row["Funding"]["Entries"]; Check(funding.Count() == 2 && Near((double)funding[0]["Rate"], .75) && Near((double)funding[1]["Rate"], 1) && Near((double)row["Material"]["Resource"], 3), "世界材料以共同份额3保留真元2.25和法力3，没有异种金额相加");
    var recall = D("recall", "none", Array.Empty<string>(), SkillCastResourceRequirementMode.Single); recall.Cost = 0; recall.Lifetime = 5; recall.Root.Scale = 8; recall.Root.Operations = new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Recover, At = .1f, Seconds = 4, Recovery = new ConstructionRecovery { WorldMaterials = true, Efficiency = .75f } } }; Check(Fire(recall), "独立普通构造开始收束多资源世界材料"); await Advance(1.1f); row = (JObject)Rows().Single(); Check((bool)row["Recovering"] && (float)row["Progress"] > 0 && (float)row["Progress"] < 1 && row["Credits"]["Entries"].Count() == 2, "部分收束后各原资源累计分别进入正式保存");
    SaveManager.saveWorldToDirectory(Path.Combine(folder, "save")); File.WriteAllText(Path.Combine(folder, "restart-expected.json"), JsonConvert.SerializeObject(new { process = System.Diagnostics.Process.GetCurrentProcess().Id, actor = actor.id, world = WorldData(), row, credited = changes.Where(c => c.Kind == "credit").GroupBy(c => c.Resource).ToDictionary(g => g.Key, g => g.Sum(c => c.Granted)), knowledge = saves.Actors.Capture(owner, "multiresource") }, Formatting.Indented));
    var result = new { passed = true, checks, process = System.Diagnostics.Process.GetCurrentProcess().Id }; File.WriteAllText(Path.Combine(folder, "checks.json"), JsonConvert.SerializeObject(result, Formatting.Indented)); return new { result.passed, checks = checks.Count };
}
finally { SimGlobals.m.mana_change = manaChange; SimGlobals.m.stamina_change = staminaChange; ConstructedAbilityService.RecoveryConfirmed -= Recovery; WorldMaterialService.Changed -= Changed; Config.paused = true; File.WriteAllText(Path.Combine(folder, "partial.json"), JsonConvert.SerializeObject(new { checks, recoveries, changes }, Formatting.Indented)); }
