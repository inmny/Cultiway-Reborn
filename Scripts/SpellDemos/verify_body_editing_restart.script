// 必须真正退出并重启游戏，核对编辑得到的身体、显化、距离及修士创作资料。
using System;
using System.IO;
using System.Linq;
using System.Collections.Generic;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core;
using Cultiway.Core.Skills;
using Cultiway.Core.Visuals.Forms;
using Cultiway.Utils.Extension;

string folder=Path.Combine(Cultiway.ModClass.I.GetDeclaration().FolderPath,"artifacts/skill_rebuild/body-editing");
var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));
if((int)expected["process"]==System.Diagnostics.Process.GetCurrentProcess().Id)throw new InvalidOperationException("需要真正退出并重启游戏");
Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;
var actor=World.world.units.get((long)expected["actor"]);var other=World.world.units.get((long)expected["other"]);
var saves=Cultiway.ModClass.I.WorldSaves;var access=ConstructionEditing.Access;var checks=new List<string>();
void Check(bool value,string name){if(!value)throw new InvalidOperationException(name);checks.Add(name);}
JToken Section(string value,string id)=>JObject.Parse(value)["sections"][id]["data"];
Check(actor!=null&&other!=null,"原版保存恢复两位实际持有者");
Check(JToken.DeepEquals(Section((string)expected["world"],"ability_constructions"),Section(saves.World.Capture(World.world,"body"),"ability_constructions")),"完整身体及修士创法资料恢复，没有重新抽取");
Check(JToken.DeepEquals(Section((string)expected["person"],"ability_knowledge"),Section(saves.Actors.Capture(actor.GetExtend(),"body"),"ability_knowledge")),"改造及创法掌握顺序完整恢复");
var definition=access.Read((string)expected["id"]);
Check(definition.Body!=null&&definition.Root.Form=="hand"&&definition.Root.Matter=="ice"&&definition.TargetRange==16&&definition.Cost==4&&definition.Binding.Anchor==AbilityAnchor.Hand,"显化主体、身体、腕点、明确支付和目标距离重新载入");
var input=new AbilityInputs(Vector3.zero,new Vector3(10,0,0),Vector3.right,2);var frame=new BodyFrame(Vector3.zero,Vector3.right,2,new Vector3(0,.16f,.62f),.48f,.54f,1);
var cast=new AbilityCast(access.Validate(definition),Matrix4x4.identity,frame,input);cast.Advance(.7f,input.Target);var views=new List<FormVisualInstance>();cast.AppendVisuals(views);
Check(!cast.ControlsBody&&views.Count==1&&views[0].Transform.m03>2&&cast.Matter(0).Id=="ice","载入后重新编译的冰掌真实离手继续运动");
Check(access.List(other.GetExtend()).Count==1&&access.Read(access.List(other.GetExtend())[0].Id).Root==null,"另一持有者仍保留原始近身动作");
var npc=World.world.units.get((long)expected["npc"]);Check(npc!=null&&access.List(npc.GetExtend()).Any(e=>e.Id==(string)expected["npcId"]),"真正创法并自主出手的修士恢复自己的掌握关系");
Check(!saves.LastReport.RequiresBackup,"当前正式可选字段恢复没有局部丢弃");
var result=new{passed=true,checks,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"restart-result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
