// 4.01：验证节点攻击、锚点连接及有身和无身迁移的实际支付与会话。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using UnityEngine;
using Friflo.Engine.ECS;
using Cultiway;
using Cultiway.Core;
using Cultiway.Core.Components;
using Cultiway.Core.Semantics;
using Cultiway.Core.SkillLibV3;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Content;
using Cultiway.Content.Components;
using Cultiway.Content.Combat;
using Cultiway.Content.Libraries;
using Cultiway.Utils.Extension;
const BindingFlags F = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance |
                       BindingFlags.Static;
string root = Cultiway.ModClass.I.GetDeclaration().FolderPath,
    folder = Path.Combine(root, "artifacts/skill_rebuild/yuanshen-branches");
Directory.CreateDirectory(folder);
var checks = new List<object>();

void Check(bool pass, string name, object data = null)
{
    checks.Add(new { pass, name, data });
    if (!pass) throw new InvalidOperationException(name);
}

bool Near(double a, double b) => Math.Abs(a - b) < Math.Max(.01, Math.Abs(b) * .000001);
var rt = typeof(ActorExtend).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");
object runner = rt.GetProperty("Instance").GetValue(null);

async Task Boundary() =>
    await Game.WaitUntil(() => (bool)rt.GetProperty("IsAtCycleBoundary").GetValue(runner), 3600);

Game.Resume();
Config.paused = true;
ControllableUnit.clear(false);
Config.setWorldSpeed("x1", false);
World.world.save_manager.loadWorld(Path.Combine(root, "Scripts/WorldSaveTests/Fixtures/world-format-1"));
while (SmoothLoader.isLoading())
{
    Config.paused = true;
    await Game.NextFrame();
}

await Boundary();
var stats = new BaseStats
    { [BaseStatses.MaxWakan.id] = 10000, [nameof(WorldboxGame.BaseStats.DivineSense)] = 10000 };
stats.addTag("frozen_ai");
stats.addTag("immovable");
var boost = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("test.yuanshen-branches.boost")
    .SetStats(stats).SetDuration(10000).Build();
var frozenStats = new BaseStats();
frozenStats.addTag("frozen_ai");
frozenStats.addTag("immovable");
var hold = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("test.yuanshen-branches.hold")
    .SetStats(frozenStats)
    .SetDuration(10000).Build();
foreach (var a in World.world.units.getSimpleList().ToArray())
    CombatStatusEffects.ApplyStatus(a, hold, 10000, a);

CoreFormationSnapshot Formation() => new()
{
    version = CoreFormationSnapshot.CurrentVersion, signature = "test.yuanshen.admission",
    canonical_name = "受理验证元神", finalized = true, realm = CoreFormationRealm.Yuanshen, strength = 4,
    refinement = 9, quality = new ItemLevel { Stage = 2, Level = 3 }, quality_score = .6f,
    atoms = new[]
    {
        new CoreFormationAtomState
            { atom_id = CoreFormationAtoms.ManifestSpiritPlatform.id, weight = 1, awakening_stage = 0 }
    },
    stats = Array.Empty<CoreFormationStatValue>(), semantics = Array.Empty<SemanticContribution>(),
    composition = ElementComposition.Static.Fire
};

ActorExtend Make(string asset, int x)
{
    var a = World.world.units.createNewUnit(asset, World.world.GetTileSimple(x, 72), pAdultAge: true,
        pSpawnWithItems: false);
    a.addTrait("super_health");
    CombatStatusEffects.ApplyStatus(a, boost, 10000, a);
    var ae = a.GetExtend();
    ae.AddComponent(new Xian { level = 4, wakan = 10000 });
    ae.AddComponent(new Yuanshen
        { formation = Formation(), original_body = new PhysicalBodySnapshot { actor_asset_id = "human" } });
    ae.MarkCultiwayStatsDirty();
    a.setStatsDirty();
    a.updateStats();
    return ae;
}

var owner = Make("human", 64);
var actor = owner.Base;
Config.paused = false;
await Game.NextFrame();
Config.paused = true;
await Boundary();
float Maximum() => actor.stats[BaseStatses.MaxWakan.id];
void Fill() => owner.GetCultisys<Xian>().wakan = Maximum() * .9f;
float Balance() => owner.GetCultisys<Xian>().wakan;

bool Use(string provider, string id, Vector3 point, Actor target = null, ActorExtend requested = null) =>
    ActiveAbilityService.TryUse(requested ?? owner, new ActiveAbilityHandle(provider, owner.E, id),
        new ActiveAbilityTarget(target, point), ActiveAbilityUseOrigin.Script);

void Place(Vector2 p)
{
    actor.stopMovement();
    actor.current_position = p;
    actor.setCurrentTile(World.world.GetTileSimple((int)p.x, (int)p.y));
    actor.updatePos();
}

async Task Advance(float seconds)
{
    Config.paused = false;
    double until = World.world.getCurWorldTime() + seconds;
    await Game.WaitUntil(() => World.world.getCurWorldTime() >= until, 1800);
    Config.paused = true;
    await Boundary();
}

try
{
    // 正式节点攻击必须改变节点本身，并与伤者心神总账保持一致。
    var defender = Make("human", 66);
    Check(YuanshenThoughtService.TryCreateThought(defender, new Vector2(66, 72)), "真实对手建立分念节点");
    var victimHandle = defender.GetComponent<YuanshenRuntimeState>().thought_nodes.Single();
    Check(
        YuanshenNodeLockService.TryResolve(victimHandle, out Entity victim) &&
        YuanshenNodeLockService.GrantLock(actor, victimHandle), "通过正式神魂接触取得实际目标节点锁定");
    var initial = victim.GetComponent<YuanshenNodeState>();
    Fill();
    float before = Balance();
    Check(
        YuanshenNodeCombatService.TryBasicStrike(owner, victimHandle) &&
        Near(Balance(), before - Maximum() * .02f), "真实节点攻击受理后只支付一次真元");
    var damaged = victim.GetComponent<YuanshenNodeState>();
    Check(
        damaged.integrity_current < initial.integrity_current && damaged.locked_share > initial.locked_share &&
        damaged.mind_share < initial.mind_share && damaged.tether_interference_seconds > 0,
        "完整度、锁伤份额和牵引干扰实际写回受击节点",
        new { initial.integrity_current, after = damaged.integrity_current, damaged.locked_share });
    Check(Near(defender.GetComponent<YuanshenRuntimeState>().injury_locked_share, damaged.locked_share),
        "受击节点锁伤与所属人物的真实心神总账一致");
    before = Balance();
    Check(!YuanshenNodeCombatService.TryBasicStrike(owner, victimHandle) && Near(Balance(), before),
        "节点攻击冷却中拒绝重复收费");
    owner.GetComponent<YuanshenRuntimeState>().soul_strike_ready_at = 0;
    var mutationField = typeof(WakanResourceService).GetField("mutationCommitted", F);
    var oldMutation = mutationField.GetValue(null);

    void Withdraw(ActorExtend payer, in WakanMutation mutation)
    {
        if (payer == owner && mutation.Kind == WakanMutationKind.Spend)
            YuanshenAdvancedNodeService.Disperse(defender, victim, 0);
    }

    WakanResourceService.RegisterMutationCommitted(Withdraw);
    before = Balance();
    try
    {
        Check(
            !YuanshenNodeCombatService.TryBasicStrike(owner, victimHandle) && Near(Balance(), before) &&
            YuanshenNodeCombatService.GetSoulStrikeCooldownRemaining(owner) == 0 &&
            !SkillCastPayment.IsPending(owner), "实际支付通知撤回目标节点时不收费或占用冷却");
    }
    finally
    {
        mutationField.SetValue(null, oldMutation);
    }

    // 通过原版建国、建城和建筑入口建立两处真实城市神庙。
    World.world.kingdoms.makeNewCivKingdom(actor);
    var city = World.world.cities.buildFirstCivilizationCity(actor);
    var templeAsset =
        AssetManager.buildings.list.First(b => b.id.IndexOf("temple", StringComparison.OrdinalIgnoreCase) >= 0);

    Building Temple(int x)
    {
        var tile = World.world.GetTileSimple(x, 72);
        if (tile.zone.city != city) city.addZone(tile.zone);
        if (tile.building != null) tile.building.removeBuildingFinal();
        var b = World.world.buildings.addBuilding(templeAsset.id, tile);
        b.completeConstruction();
        return b;
    }

    var first = Temple(64);
    var second = Temple(84);
    Place(first.current_position);
    Fill();
    Check(Use("content.yuanshen_advanced", "consecrate_altar", first.current_position), "正式能力入口建立第一处城市香火锚点");
    Check(
        YuanshenAnchorNetworkService.TryGetAuthorizedAtPoint(owner, first.current_position, out var firstHandle,
            out Entity firstAnchor), "第一处锚点以真实建筑身份解析");
    Place(second.current_position);
    Fill();
    Check(Use("content.yuanshen_advanced", "consecrate_altar", second.current_position), "正式能力入口建立第二处城市香火锚点");
    Check(
        YuanshenAnchorNetworkService.TryGetAuthorizedAtPoint(owner, second.current_position,
            out var secondHandle, out Entity secondAnchor), "第二处锚点以真实建筑身份解析");
    Place(first.current_position);
    Check(Use("content.yuanshen_advanced", "select_anchor", first.current_position), "人在场时正式选定连接起点");
    Place(second.current_position);
    owner.GetCultisys<Xian>().wakan = 0;
    Check(
        !Use("content.yuanshen_advanced", "connect_anchor", second.current_position) &&
        !firstAnchor.GetComponent<YuanshenAnchorState>().link_handles.Contains(secondHandle), "连接支付不足时不留下单侧连接");
    Fill();
    before = Balance();
    Check(
        Use("content.yuanshen_advanced", "connect_anchor", second.current_position) &&
        Near(Balance(), before - Maximum() * .05f), "双向连接正式建立时只支付一次实际费用");
    Check(
        firstAnchor.GetComponent<YuanshenAnchorState>().link_handles.Contains(secondHandle) &&
        secondAnchor.GetComponent<YuanshenAnchorState>().link_handles.Contains(firstHandle), "真实网络两端均保留同一稳定连接");
    before = Balance();
    Check(
        !Use("content.yuanshen_advanced", "connect_anchor", second.current_position) && Near(Balance(), before),
        "相同连接重复提交不会再次收费");

    // 原人物与分念分处两端，必须经实际连接迁移；不手动调用迁移完成函数。
    Place(first.current_position);
    Check(YuanshenThoughtService.TryCreateThought(owner, first.current_position), "在真实起点建立待迁移分念");
    var nodeHandle = owner.GetComponent<YuanshenRuntimeState>().thought_nodes.Single();
    Check(
        YuanshenNodeLockService.TryResolve(nodeHandle, out Entity node) &&
        YuanshenThoughtService.TryFocus(owner, nodeHandle), "待迁移节点使用真实稳定身份和正式聚焦");
    Place(second.current_position);
    Fill();
    before = Balance();
    Check(
        Use("content.yuanshen_advanced", "transit", second.current_position) && Balance() < before &&
        node.HasComponent<YuanshenAnchorTransitState>(), "正式节点迁移受理后建立会话并提交启动费用");
    float paid = Balance();
    Check(!Use("content.yuanshen_advanced", "transit", second.current_position) && Near(Balance(), paid),
        "正在迁移的同一节点拒绝重复收费");
    await Advance(1.4f);
    Check(
        !node.HasComponent<YuanshenAnchorTransitState>() && node.HasComponent<YuanshenAnchorResidence>() &&
        node.GetComponent<YuanshenAnchorResidence>().anchor == secondHandle &&
        Vector2.Distance(node.GetComponent<Position>().v2, second.current_position) < .1f,
        "真实系统到期完成迁移，节点到达并占用终点负载");
    Check(secondAnchor.GetComponent<YuanshenAnchorState>().current_load > 0, "实际迁移完成才占用终点份额");
    YuanshenAdvancedNodeService.Disperse(owner, node, 0);
    Check(
        !YuanshenNodeLockService.TryResolve(nodeHandle, out _) &&
        Near(secondAnchor.GetComponent<YuanshenAnchorState>().current_load, 0), "节点结束归还终点负载及控制引用");

    // 同城无身人物使用已有授权连接，完成后仍是原人物；中断沿原规则回到起点。
    var bodiless = Make(Actors.BodilessYuanshen.id, 64);
    bodiless.AddComponent(new BodylessYuanshenState());
    bodiless.Base.joinCity(city);
    bodiless.GetCultisys<Xian>().wakan = bodiless.Base.stats[BaseStatses.MaxWakan.id] * .9f;
    float bodyBefore = bodiless.GetCultisys<Xian>().wakan;
    Check(
        YuanshenAdvancedNodeService.TryStartBodilessTransit(bodiless, second.current_position) &&
        bodiless.GetCultisys<Xian>().wakan < bodyBefore, "授权的真实无身人物开始迁移并提交一次启动支付");
    bodyBefore = bodiless.GetCultisys<Xian>().wakan;
    Check(
        !YuanshenAdvancedNodeService.TryStartBodilessTransit(bodiless, second.current_position) &&
        Near(bodiless.GetCultisys<Xian>().wakan, bodyBefore), "无身迁移活动中拒绝重复启动费用");
    await Advance(1.4f);
    Check(
        !bodiless.HasComponent<YuanshenBodilessTransitState>() &&
        bodiless.Base.current_tile == second.current_tile,
        "真实迁移系统把原无身人物送到终点并解除会话");
    Check(YuanshenAdvancedNodeService.TryStartBodilessTransit(bodiless, first.current_position),
        "正式启动反向迁移用于检查中断");
    bodyBefore = bodiless.GetCultisys<Xian>().wakan;
    var interrupted = bodiless.GetComponent<YuanshenBodilessTransitState>();
    YuanshenAdvancedNodeService.InterruptBodilessTransit(bodiless, interrupted);
    Check(
        !bodiless.HasComponent<YuanshenBodilessTransitState>() &&
        Near(bodiless.GetCultisys<Xian>().wakan, bodyBefore) &&
        bodiless.Base.current_tile == second.current_tile,
        "已受理无身迁移中断保留启动消耗并回到真实起点");

    var result = new { passed = true, checks, process = System.Diagnostics.Process.GetCurrentProcess().Id };
    File.WriteAllText(Path.Combine(folder, "checks.json"),
        JsonConvert.SerializeObject(result, Formatting.Indented));
    return new { result.passed, checks = checks.Count };
}
finally
{
    Config.paused = true;
    File.WriteAllText(Path.Combine(folder, "partial.json"),
        JsonConvert.SerializeObject(new { checks }, Formatting.Indented));
}
