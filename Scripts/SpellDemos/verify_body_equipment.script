// 4.23：接触真正穿戴的甲片及持物，装备变化不保留旧关系。
var selectedItems = Array.Empty<string>();
var armourOnly = false;
Actor source = New(64), target = New(64.18f);
Place(target, 64.18f, 71.87f);
target.setKingdom(World.world.units.getSimpleList().First(a => a.kingdom != source.kingdom).kingdom);
await Advance(.3f);

Item Equip(string id)
{
    EquipmentAsset asset = AssetManager.items.get(id);
    Check(asset != null, "原版装备资源存在：" + id);
    Item item = World.world.items.generateItem(asset, pActor: target);
    target.equipment.setItem(item, target);
    target.setStatsDirty();
    target.updateStats();
    return item;
}

void Reset()
{
    source.finishAngryStatus();
    target.finishAngryStatus();
    source.clearAttackTarget();
    target.clearAttackTarget();
    Quiet(source);
    Quiet(target);
    Place(source, 64, 72);
    Place(target, 64.18f, 71.87f);
    CombatStatusEffects.RemoveStatus(source, quiet);
    source.updateStats();
    source.cancelAllBeh();
}

async Task<ConstructedBodyConnection> Hold(string name, string part = "surface")
{
    Reset();
    AbilityDefinition d = Action("equipment." + name);
    d.Body.Construction.Parts.Single(p => p.Subject == BodyPartSubject.Target).Part = part;
    if (part == "armor.boots")
    {
        BodyConstructionDefinition relation = d.Body.Construction;
        relation.Parts.Single(p => p.Subject == BodyPartSubject.Source).Part = "foot.right";
        d.Body = BodyActionGenerator.Create(new BodyActionRequest
            { Effector = "foot.right", Kind = BodyActionKind.Thrust, Seconds = 2f });
        d.Body.Effector = "palm";
        d.Body.Construction = relation;
    }

    d.Body.MatchDistance = true;
    if (name == "tool")
    {
        target.setKingdom(source.kingdom);
        d.Body.Impact.Targets = SkillUseTargetRelation.Friendly;
        d.Impact = new ConstructionImpact { DamageScale = 0f, Targets = SkillUseTargetRelation.Friendly };
    }
    else target.setKingdom(World.world.units.getSimpleList().First(a => a.kingdom != source.kingdom).kingdom);

    await PlaceConnection(source, target, d);
    int start = relations.Count;
    await Fire(d, source, target, aggro: name != "tool");
    Config.paused = false;
    await Game.WaitUntil(() => relations.Count > start, 900);
    Config.paused = true;
    await Game.WaitUntil(Boundary, 600);
    ConstructedBodyConnection actual = ConstructedAbilityService.GetBodyConnections()
        .Single(c => c.CastId == relations[start].CastId);
    Check(actual.State == ConstructedBodyConnectionState.Active, name + "通过正式施放取得真实关系");
    object current = ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>()
        .Single(c => (long)Field(c, "Id") == actual.CastId);
    object link = Field(current, "Connection"), surface = Field(link, "Surface");
    int selected = (int)Field(Field(link, "Anchor"), "Part");
    string attachment = (string)Field(((Array)Field(surface, "Parts")).GetValue(selected), "Attachment");
    Check(part == "surface" || attachment == part, name + "实际连接点属于明确选择的装备", attachment);
    Vector2 sourceRoot = source.current_position, targetRoot = target.current_position;
    await Advance(.05f);
    ConstructedBodyConnection maintained = ConstructedAbilityService.GetBodyConnections()
        .Single(c => c.CastId == actual.CastId);
    Check(Vector3.Distance(maintained.SourcePoint, maintained.TargetPoint) < .0001f &&
          maintained.Remaining < actual.Remaining && source.current_position == sourceRoot &&
          target.current_position == targetRoot, name + "实际维持两端一致、消耗预算且不挪动人物");
    return actual;
}

object Published(out object binding)
{
    object[] args = { target.id, null, null };
    Check((bool)service.GetMethod("TryGetBodySurface", F).Invoke(null, args), "目标共同表面已发布");
    binding = args[1];
    return args[2];
}

/// <summary>读取当前共同地表中的实际脚下，核对先发生的地表解除。</summary>
/// <param name="person">实际人物。</param>
Vector3 PhysicalFoot(Actor person) =>
    (Vector3)service.GetMethod("PhysicsFoot", F).Invoke(null, new object[] { person });

void ProbeAttachment(object pose, string selection)
{
    var parts = (Array)Field(pose, "Parts");
    var matrices = (Matrix4x4[])Field(pose, "Matrices");
    object part = parts.Cast<object>().First(p =>
        (string)Field(p, "Attachment") == selection && ((int[])Field(p, "Triangles")).Length > 0);
    Vector3[] vertices = (Vector3[])Field(part, "Vertices");
    int[] indices = (int[])Field(part, "Triangles");
    int transformIndex = (int)Field(part, "TransformIndex");
    if (transformIndex < 0) transformIndex = Array.IndexOf(parts.Cast<object>().ToArray(), part);
    Vector3 a = matrices[transformIndex].MultiplyPoint3x4(vertices[indices[0]]),
        b = matrices[transformIndex].MultiplyPoint3x4(vertices[indices[1]]),
        c = matrices[transformIndex].MultiplyPoint3x4(vertices[indices[2]]),
        centre = (a + b + c) / 3f,
        normal = Vector3.Cross(b - a, c - a).normalized;
    object from = Sphere(centre - normal * .02f, centre - normal * .02f, .001f),
        to = Sphere(centre + normal * .02f, centre + normal * .02f, .001f);
    object[] args = { pose, pose, from, to, selection, 0f, null, Vector3.zero };
    Check((bool)pose.GetType().GetMethod("Find", F).Invoke(null, args), "实际装备三角面可被明确选择：" + selection);
}

void TaskTool(string suffix, string tool)
{
    string id = "Cultiway.Verify.NativeHeld." + suffix;
    if (AssetManager.tasks_actor.get(id) == null)
        AssetManager.tasks_actor.add(new ai.behaviours.BehaviourTaskActor
        {
            id = id, force_hand_tool = tool,
            cached_hand_tool_asset =
                string.IsNullOrEmpty(tool) ? null : AssetManager.unit_hand_tools.get(tool)
        });
    target.setTask(id, pClean: true, pCleanJob: false, pForceAction: false);
}

Equip("helmet_iron");
Equip("armor_steel");
Equip("boots_adamantine");
var armoured = await Hold("armour", "armor.chest");
if (worldfall != null) await Pair(source, "armour", 0, true);
source.attack_timer = 999;
CheckSurface(target, armoured, "armour");
object armourPose = Published(out _);
foreach (string part in new[] { "armor.helmet", "armor.chest", "armor.boots" })
    ProbeAttachment(armourPose, part);

// 只换装备，不移动人物，旧关系必须按实际物件失效。
Vector2 unchangedRoot = target.current_position;
Equip("armor_iron");
await Advance(.06f);
Check(!ConstructedAbilityService.GetBodyConnections().Any(c => c.CastId == armoured.CastId) &&
      relations.Any(c =>
          c.CastId == armoured.CastId && c.State == ConstructedBodyConnectionState.Released &&
          c.Reason == "EquipmentChanged") &&
      target.current_position == unchangedRoot, "替换胸甲解除旧关系，不搬动或继续抓住旧甲片");
await Advance(2.1f);

Item worn = target.equipment.armor.getItem();
var damaged = await Hold("durability", "armor.chest");
long wornId = worn.data.id;
worn.data.durability = 0;
Check(worn.isBroken() && target.equipment.armor.getItem() == worn && worn.data.id == wornId,
    "原物品保持身份，实际耐久归零");
await Advance(.06f);
Check(relations.Any(c => c.CastId == damaged.CastId && c.State == ConstructedBodyConnectionState.Released &&
                         c.Reason == "EquipmentChanged"), "同一件装备损坏也解除旧关系");
await Advance(2.1f);

worn.data.durability = worn.getDurabilityMax();
var changedAsset = await Hold("resource", "armor.chest");
worn.newItem(AssetManager.items.get("armor_copper"));
target.setStatsDirty();
target.updateStats();
Check(target.equipment.armor.getItem() == worn && worn.data.id == wornId, "更换原物品资源时保持实际物品身份");
await Advance(.06f);
Check(relations.Any(c => c.CastId == changedAsset.CastId &&
                         c.State == ConstructedBodyConnectionState.Released &&
                         c.Reason == "EquipmentChanged"), "同一物品改变装备资源后不沿用旧模型表面");
await Advance(2.1f);

var changedMaterial = await Hold("material", "armor.chest");
string oldMaterial = worn.data.material;
worn.data.material = oldMaterial == "gold" ? "silver" : "gold";
await Advance(.06f);
Check(relations.Any(c => c.CastId == changedMaterial.CastId &&
                         c.State == ConstructedBodyConnectionState.Released &&
                         c.Reason == "EquipmentChanged") && !BodyControlState.IsBusy(target.id),
    "同一物品换材后解除旧表面，不继续抓住换材前的装备");
await Advance(2.1f);

foreach (var sample in new[] { ("helmet", "armor.helmet"), ("boots", "armor.boots") })
{
    var outer = await Hold(sample.Item1, sample.Item2);
    if (worldfall != null) await Pair(source, sample.Item1, 0, true);
    source.attack_timer = 999;
    CheckSurface(target, outer, sample.Item1);
    Item heldArmour = sample.Item1 == "helmet"
        ? target.equipment.helmet.getItem()
        : target.equipment.boots.getItem();
    long heldArmourId = heldArmour.data.id;
    if (sample.Item1 == "helmet") target.equipment.helmet.takeAwayItem();
    else target.equipment.boots.takeAwayItem();
    target.setStatsDirty();
    target.updateStats();
    await Advance(.06f);
    Check(relations.Any(c => c.CastId == outer.CastId && c.State == ConstructedBodyConnectionState.Released &&
                             c.Reason == "EquipmentChanged") && !BodyControlState.IsBusy(target.id),
        sample.Item1 + "卸下实际所抓装备后归还目标控制", heldArmourId);
    await Advance(2.1f);
}

target.equipment.helmet.takeAwayItem();
target.equipment.armor.takeAwayItem();
target.equipment.boots.takeAwayItem();
target.setStatsDirty();
target.updateStats();

if (armourOnly)
    return new { passed = true, checks = checks.Count, scope = worldfall == null ? "native-armour" : "worldfall-armour" };

if (worldfall == null)
{
    var nativeReports = new List<object>();

    // 清除上一场景的敌意，让本招自然收尾；不冻结人物或强行取消动作。
    async Task NativeRest()
    {
        source.finishAngryStatus();
        target.finishAngryStatus();
        source.clearAttackTarget();
        target.clearAttackTarget();
        source.cancelAllBeh();
        source.attack_timer = 999;
        await Advance(2.1f);
        Check(!BodyControlState.IsBusy(source.id) && !BodyControlState.IsBusy(target.id),
            "本次持物接触自然结束，双方控制归还后再开始下一场景");
    }

    async Task NativePicture(ConstructedBodyConnection held, string name)
    {
        World.world.camera.transform.position = new Vector3(target.current_position.x,
            target.current_position.y + .5f, 0f);
        MoveCamera.instance.forceZoom(1.5f);
        World.world.console.Hide();
        Tooltip.hideTooltipNow();
        for (int frame = 0; frame < 10; frame++) await Game.NextFrame();
        ActorManager manager = World.world.units;
        int visible = Enumerable.Range(0, manager.visible_units.count)
            .Single(i => manager.visible_units.array[i] == target);
        Check(manager.render_data.has_item[visible], name + "原版实际图片池仍绘制持物");
        int rank = Enumerable.Range(0, visible).Count(i => manager.render_data.has_item[i]);
        int count = Enumerable.Range(0, manager.visible_units.count)
            .Count(i => manager.render_data.has_item[i]);
        SpriteRenderer renderer = AssetManager.quantum_sprites.get("unit_items").group_system
            .getFastActiveList(count)[rank].sprite_renderer;
        object pose = Published(out object binding);
        Sprite image = (Sprite)Field(binding, "heldSprite");
        Check(
            renderer.enabled && renderer.sprite == image && manager.render_data.item_sprites[visible] == image,
            name + "接触读取的就是原版实际绘制持物图，不使用图标或另一把模型");
        var pieces = (Array)Field(pose, "Parts");
        var matrices = (Matrix4x4[])Field(pose, "Matrices");
        Vector2 jitter = target.move_jump_offset + target.shake_offset;
        int vertices = 0;
        float error = 0f;
        foreach (object piece in pieces)
        {
            if ((string)Field(piece, "Attachment") != "item") continue;
            int transform = (int)Field(piece, "TransformIndex");
            foreach (Vector3 local in (Vector3[])Field(piece, "Vertices"))
            {
                Vector3 numeric = matrices[transform].MultiplyPoint3x4(local);
                Vector3 drawn = renderer.transform.TransformPoint(new Vector3(local.x, local.y + local.z, 0f));
                error = Mathf.Max(error,
                    Vector2.Distance(new Vector2(numeric.x, numeric.y + numeric.z) + jitter, drawn));
                vertices++;
            }
        }

        Check(vertices > 0 && error < .0001f, name + "真实持物逐顶点投影与实际绘制一致", new { vertices, error });
        Vector3 fixedImage = renderer.transform.InverseTransformPoint(new Vector3(
            held.TargetPoint.x + jitter.x, held.TargetPoint.y + held.TargetPoint.z + jitter.y,
            renderer.transform.position.z));
        Vector2 fixedPixel = (Vector2)fixedImage * image.pixelsPerUnit + image.pivot;
        int pixelX = Mathf.FloorToInt(fixedPixel.x),
            pixelY = Mathf.FloorToInt(fixedPixel.y),
            imageWidth = Mathf.RoundToInt(image.rect.width),
            imageHeight = Mathf.RoundToInt(image.rect.height);
        Color32[] pixels = (Color32[])typeof(CreatureAppearanceService).GetMethod("ReadPixels", F)
            .Invoke(null, new object[] { image });
        Check(pixelX >= 0 && pixelX < imageWidth && pixelY >= 0 && pixelY < imageHeight &&
              pixels[pixelY * imageWidth + pixelX].a != 0,
            name + "真实固定点落在实际绘制持物的非透明像素内", new { fixedPixelX = fixedPixel.x, fixedPixelY = fixedPixel.y });
        Check(target.getHandRendererAsset() == target.getCachedHandRendererAsset(),
            name + "实际持物资源与原版已绘制资源一致");
        string movie = Path.Combine(folder, "movies", name, "native");
        Directory.CreateDirectory(movie);
        Screen.Capture(Path.Combine(movie, "00000.png"));
        for (int frame = 0; frame < 4; frame++) await Game.NextFrame();
        nativeReports.Add(new { name, vertices, error, image = image.name });
    }

    foreach (string group in new[] { "sword", "spear", "hammer", "axe", "bow", "stick", "staff" }
                 .Where(group => selectedItems.Length == 0 || selectedItems.Contains(group)))
    {
        EquipmentAsset asset = group == "stick" ? AssetManager.items.get("stick_wood") :
            group == "staff" ? AssetManager.items.get("evil_staff") : AssetManager.items.list.First(a =>
                a.group_id == group && !a.id.StartsWith("$", StringComparison.Ordinal));
        Item item = Equip(asset.id);
        var held = await Hold(group, "item");
        Check(target.getWeapon() == item && item.getActor() == target,
            group + "真实持物仍归原人物所有");
        await NativePicture(held, group);
        target.equipment.weapon.takeAwayItem();
        target.setStatsDirty();
        target.updateStats();
        await Advance(.06f);
        Check(relations.Any(r => r.CastId == held.CastId &&
                                 r.State == ConstructedBodyConnectionState.Released &&
                                 r.Reason == "EquipmentChanged") && !BodyControlState.IsBusy(target.id),
            group + "卸下真实持物后解除旧接触并归还控制");
        await NativeRest();
    }

    TaskTool("empty", string.Empty);
    var none = await Hold("emptyTask");
    TaskTool("null", null);
    await Advance(.06f);
    Check(ConstructedAbilityService.GetBodyConnections().Any(c => c.CastId == none.CastId),
        "原版空字符串和空值任务都没有持物，不误解除身体关系");
    await NativeRest();
    TaskTool("hoe", "hoe");
    var toolHeld = await Hold("tool", "item");
    await NativePicture(toolHeld, "hoe");
    TaskTool("axe", "axe");
    await Advance(.06f);
    Check(relations.Any(r => r.CastId == toolHeld.CastId &&
                             r.State == ConstructedBodyConnectionState.Released &&
                             r.Reason == "HeldChanged") && !BodyControlState.IsBusy(target.id),
        "正式任务切换工具后旧图片接触解除，不留下已放下的锄头");
    await NativeRest();
    File.WriteAllText(Path.Combine(folder, "equipment.json"), JsonConvert.SerializeObject(new
    {
        scope = "native-held-items", samples = nativeReports,
        pending = Array.Empty<string>()
    }, Formatting.Indented));
    return new
    {
        passed = true, checks = checks.Count, scope = "native-held-items", samples = nativeReports.Count
    };
}

var weaponReports = new List<object>();
foreach (string group in new[] { "sword", "spear", "hammer", "axe", "bow", "stick", "staff" }
             .Where(group => selectedItems.Length == 0 || selectedItems.Contains(group)))
{
    EquipmentAsset asset = group == "stick" ? AssetManager.items.get("stick_wood") :
        group == "staff" ? AssetManager.items.get("evil_staff") : AssetManager.items.list.First(a =>
            a.group_id == group && !a.id.StartsWith("$", StringComparison.Ordinal));
    Item item = Equip(asset.id);
    var connection = await Hold(group, "item");
    Check(target.getWeapon() == item && item.getActor() == target, group + "维持时仍由原人物持有同一物品");
    await Pair(source, group, 0, true);
    source.attack_timer = 999;
    CheckSurface(target, connection, group);
    object pose = Published(out object binding);
    ProbeAttachment(pose, "item");
    int pieces = ((IEnumerable)Field(binding, "held")).Cast<object>().Count();
    weaponReports.Add(new { group, asset = asset.id, item = item.data.id, pieces });
    Vector3 sourceFloor = PhysicalFoot(source), targetFloor = PhysicalFoot(target);
    target.equipment.weapon.takeAwayItem();
    target.setStatsDirty();
    target.updateStats();
    Check((string)binding.GetType().GetProperty("ChangedReason", F).GetValue(binding) == "EquipmentChanged",
        group + "卸下实际物品立即使原装备表面失效");
    await Advance(.06f);
    var released = relations.Where(c => c.CastId == connection.CastId &&
                                        c.State == ConstructedBodyConnectionState.Released).ToArray();
    float floorChange = Mathf.Max(Mathf.Abs(PhysicalFoot(source).z - sourceFloor.z),
        Mathf.Abs(PhysicalFoot(target).z - targetFloor.z));
    Check(released.Length == 1 && (released[0].Reason == "EquipmentChanged" ||
                                   released[0].Reason == "TerrainChanged" && floorChange > .0001f) &&
          !BodyControlState.HasControl(target.id, BodyOccupancy.Stance), group + "失去实际持物后归还目标控制",
        new { reasons = released.Select(c => c.Reason), floorChange });
    await Advance(2.1f);
}

Park();
source = New(64);
target = New(64.18f);
TaskTool("empty", string.Empty);
await Advance(.15f);
var noTool = await Hold("emptyTask");
TaskTool("null", null);
await Advance(.06f);
Check(ConstructedAbilityService.GetBodyConnections().Any(c => c.CastId == noTool.CastId),
    "空字符串和空值都表示没有工具，普通任务切换不会误松手");
await Advance(2.1f);
Park();
source = New(64);
target = New(64.18f);
TaskTool("hoe", "hoe");
await Advance(.15f);
Check(!target.has_attack_target && target.ai.task.force_hand_tool == "hoe", "实际原版任务要求携带锄头");
var worker = await Hold("tool", "item");
await Pair(source, "tool", 0, true);
source.attack_timer = 999;
CheckSurface(target, worker, "tool");
object toolPose = Published(out _);
ProbeAttachment(toolPose, "item");
TaskTool("axe", "axe");
await Advance(.06f);
Check(relations.Any(c => c.CastId == worker.CastId && c.State == ConstructedBodyConnectionState.Released &&
                         c.Reason == "HeldChanged"), "实际任务切换持物后归还旧工具的关系");
await Advance(2.1f);

File.WriteAllText(Path.Combine(folder, "equipment.json"),
    JsonConvert.SerializeObject(weaponReports, Formatting.Indented));
File.WriteAllText(Path.Combine(folder, "observed.json"),
    JsonConvert.SerializeObject(observed, Formatting.Indented));
return new { passed = true, checks = checks.Count, weapons = weaponReports.Count };
