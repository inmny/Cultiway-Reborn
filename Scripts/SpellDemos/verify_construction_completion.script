// 3.06：按实际身体、材料和操作需求补全，并验证共同数值执行与正式入口。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Core.Visuals.Forms;
using Cultiway.Core.Persistence;
using Cultiway.Content.Skills;
using Cultiway.Content.Components;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Utils.Extension;

const BindingFlags Flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static | BindingFlags.Instance;
string root = Cultiway.ModClass.I.GetDeclaration().FolderPath, folder = Path.Combine(root, "artifacts/skill_rebuild/construction-completion"); Directory.CreateDirectory(folder);
var checks = new List<object>(); void Check(bool pass, string name, object evidence = null) => checks.Add(new { pass, name, evidence });
JObject Read(string name) => JObject.Parse(File.ReadAllText(Path.Combine(root, "Doc/技能系统全面重构/补全输入", name + ".json")));
bool Reject(Action action) { try { action(); return false; } catch (InvalidDataException) { return true; } }
var access = ConstructionEditing.Access; var palm = access.Read(BodyActionCatalog.PalmId); var body = new JObject { ["Body"] = JObject.FromObject(palm.Body) }; var request = Read("追踪离体掌"); string before = request.ToString();
var projected = ConstructionDefinitionLayers.Resolve(body, player: request); var plan = access.Validate(projected);
Check(projected.Root.Form == "hand" && projected.Binding.Anchor == AbilityAnchor.Hand && projected.Binding.Follow && projected.Binding.ScaleByBody, "只选追踪操作即从真实身体补齐掌形与腕部连接");
var flight = projected.Root.Operations.Single(); Check(flight.Kind == ConstructionOperationKind.Fly && flight.At == plan.Body.ActiveUntil && !flight.InheritVelocity && projected.Root.ContactGroup == "body", "释放取真实动作有效结束，飞行解除连接并沿用接触去重");
var velocity = Quaternion.Euler(0, 25, 0) * new Vector3(flight.Vector[0], flight.Vector[1], flight.Vector[2]); Check(Vector3.Distance(velocity, Vector3.forward * 8) < .0001f && Mathf.Abs(projected.TargetRange.Value - 16) < .001f, "缺省运动沿出手方向，实际转角不把飞掌甩偏，选取距离由运动时长确定");
Check(projected.Root.ActiveFrom == flight.At && projected.Root.DisappearAt == projected.Lifetime && projected.Root.OnContact == ConstructionContactResponse.End, "有效区跟随释放阶段，接触及最长存在有真实结束规则");
Check(request.ToString() == before, "补全不反写输入或重抽已定选择");
var frame = new BodyFrame(Vector3.zero, Vector3.right, 2, new Vector3(0, .16f, .62f), .48f, .54f, 1); var input = new AbilityInputs(Vector3.zero, new Vector3(12, 0, 0), Vector3.right, 2); var cast = new AbilityCast(plan, Matrix4x4.identity, frame, input); cast.Advance(.2f, input.Target); var views = new List<FormVisualInstance>(); cast.AppendVisuals(views); Check(Vector3.Distance(views.Single().Transform.GetColumn(3), cast.BodyPose.Value.Hand) < .0001f, "补全主体在释放前实际附着共同腕点"); cast.Advance(.4f, input.Target); Check(!cast.ControlsBody && !cast.Finished && cast.Velocity(0).x > 0, "真实收势结束后独立运动继续，不拖住身体"); cast.Advance(3f, input.Target); views.Clear(); cast.AppendVisuals(views); Check(cast.Finished && views.Count == 0, "补全寿命真正结束显示及作用");
var weapon = access.Read("Cultiway.Body.SwordThrust"); var armed = ConstructionDefinitionLayers.Resolve(new JObject { ["Body"] = JObject.FromObject(weapon.Body) }, player: request); Check(armed.Root.Form == weapon.Body.WeaponForm && armed.Body.Grip == weapon.Body.Grip, "同一规则从真实借用器物选择显化形体，不限定掌击编号");
var molten = ConstructionDefinitionLayers.Resolve(Read("液态金属流路")); var moltenPlan = access.Validate(molten); Check(molten.Root.State == "liquid" && molten.Root.Operations.Single().Flow != null && molten.Root.Surface == null, "金属选择流化后补液态与流散资料，表面继续绑定实际材料"); var wet = new AbilityCast(moltenPlan, Matrix4x4.identity); wet.Advance(.1f, Vector3.zero); views.Clear(); wet.AppendVisuals(views); Check(views.Count > 0 && views[0].Matter.Id == "iron" && views[0].Matter.State == "liquid" && views[0].Matter.Surface == "molten_iron" && wet.RemainingVolume(0) > 0, "补全液态金属实际产生共同水格、材料表面及守恒体积"); wet.Advance(2f, Vector3.zero); wet.Advance(.01f, Vector3.zero); Check(wet.Finished, "液态过程按整次寿命退出，不偷偷永久留置");
var sparse = Read("液态金属流路"); sparse["Root"]["Matter"] = "water"; ((JObject)sparse["Root"]).Remove("Operations"); var natural = ConstructionDefinitionLayers.Resolve(sparse); Check(natural.Root.Operations.Single().Kind == ConstructionOperationKind.Flow, "液态主体未指定操作时按物态补实际流散"); sparse["Root"]["Operations"] = new JArray(); var held = ConstructionDefinitionLayers.Resolve(sparse); Check(held.Root.Operations.Length == 0 && held.Root.State == "liquid", "明确空操作保持凝聚形体，默认不能重新添加流散");
var explicitValues = (JObject)request.DeepClone(); explicitValues["Root"]["Form"] = "sword"; explicitValues["Root"]["ActiveFrom"] = 0; explicitValues["Root"]["OnContact"] = 0; explicitValues["Root"]["Operations"][0]["Vector"] = new JArray(0, 0, 0); var chosen = ConstructionDefinitionLayers.Resolve(body, player: explicitValues); Check(chosen.Root.Form == "sword" && chosen.Root.ActiveFrom == 0 && chosen.Root.OnContact == ConstructionContactResponse.Continue && chosen.Root.Operations.Single().Vector.All(x => x == 0), "明确形体、时点、接触行为及零速度均不被需求默认覆盖");
var missing = (JObject)request.DeepClone(); missing["Root"]["Form"] = JValue.CreateNull(); Check(Reject(() => access.Validate(ConstructionDefinitionLayers.Resolve(body, player: missing))), "明确清空必要形体时报告缺项，不伪造替代形体"); missing = Read("液态金属流路"); missing["Root"]["Operations"][0]["Flow"] = JValue.CreateNull(); Check(Reject(() => access.Validate(ConstructionDefinitionLayers.Resolve(missing))), "明确空的必要流散资料由正式检查拒绝");
var shard = ConstructionDefinitionLayers.Resolve(Read("有限裂片")); var shards = new AbilityCast(access.Validate(shard), Matrix4x4.identity); shards.Advance(.3f, Vector3.zero); views.Clear(); shards.AppendVisuals(views); Check(views.Count == 8 && shard.Root.Operations.Single().Fracture.Seconds <= shard.Lifetime - .2f + .000001f, "碎解需求读取真实八片结构并限制后续存在时长"); shards.Advance(1f, Vector3.zero); shards.Advance(.01f, Vector3.zero); Check(shards.Finished, "碎片在补全的结束窗口内回收");
var leave = Read("液态金属流路"); leave["Root"]["Operations"] = new JArray(new JObject { ["Kind"] = "Leave", ["At"] = .2 }); var left = ConstructionDefinitionLayers.Resolve(leave); Check(left.Root.Operations.Single().Residue.Lifetime == 10, "明确选择留置才补有限世界存在规则"); leave["Root"]["Operations"][0]["Residue"] = new JObject { ["Lifetime"] = 0 }; Check(ConstructionDefinitionLayers.Resolve(leave).Root.Operations.Single().Residue.Lifetime == 0, "明确永久留置不被有限默认改写");
var named = Read("液态金属流路"); named["Root"]["Operations"] = new JArray(); named["Steps"] = new JArray(new JObject { ["Id"] = "spread", ["Operation"] = new JObject { ["Kind"] = "Flow" }, ["Inputs"] = new JObject { ["part"] = new JObject { ["Node"] = "root" } } }); var namedResult = ConstructionDefinitionLayers.Resolve(named); Check(namedResult.Root.State == "liquid" && namedResult.Steps.Single().Operation.Flow != null && access.Validate(namedResult).FormCount == 1, "命名步骤使用同一操作资料补全，不另建执行路径");

Game.Resume(); Config.paused = true; World.world.save_manager.loadWorld(Path.Combine(root, "Scripts/WorldSaveTests/Fixtures/world-format-1")); await Game.NextFrame(); await Game.WaitUntil(() => !SmoothLoader.isLoading(), 3600); Config.paused = true; var runnerType = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner"); object runner = runnerType.GetProperty("Instance").GetValue(null); await Game.WaitUntil(() => (bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner), 3600);
var actor = World.world.units.createNewUnit("human", World.world.GetTileSimple(64, 72), pAdultAge: true, pSpawnWithItems: false); var owner = actor.GetExtend(); owner.AddComponent(new Xian { level = 2, wakan = 100 }); owner.MarkCultiwayStatsDirty(); actor.setStatsDirty(); actor.updateStats(); ConstructedAbilityService.Register(molten); ConstructedAbilityService.Learn(owner, molten.Id); float balance = owner.GetCultisys<Xian>().wakan; Check(ActiveAbilityService.TryUse(owner, new ActiveAbilityHandle("content.constructed", owner.E, molten.Id), new ActiveAbilityTarget(actor, actor.GetSimPos()), ActiveAbilityUseOrigin.Script) && balance - owner.GetCultisys<Xian>().wakan == molten.Cost, "补全构造实际登记、学习并从正式入口准确支付");
var saves = Cultiway.ModClass.I.WorldSaves; var sections = (System.Collections.IDictionary)saves.World.GetType().GetField("sections", Flags).GetValue(saves.World); object section = sections["ability_constructions"]; var captured = (JObject)section.GetType().GetMethod("Capture", Flags).Invoke(section, new object[] { World.world }); var altered = access.Read(molten.Id); altered.Root.State = "solid"; ConstructedAbilityService.Register(altered); var envelope = new JObject { ["formatVersion"] = 1, ["sections"] = new JObject { ["ability_constructions"] = new JObject { ["version"] = (int)section.GetType().GetProperty("Version").GetValue(section), ["data"] = captured } } }; saves.World.Restore(World.world, envelope.ToString(), new SaveLoadReport(), "construction-completion", item => item.Id == "ability_constructions"); var restored = access.Read(molten.Id); Check(restored.Root.State == "liquid" && restored.Root.Operations.Single().Flow != null, "正式保存恢复已补齐结果，不在读档时重新推断规则");
bool Pass(object value) => (bool)value.GetType().GetProperty("pass").GetValue(value); var report = new { passed = checks.All(Pass), checks, process = System.Diagnostics.Process.GetCurrentProcess().Id }; File.WriteAllText(Path.Combine(folder, "checks.json"), JsonConvert.SerializeObject(report, Formatting.Indented)); return new { report.passed, checks = checks.Count };
