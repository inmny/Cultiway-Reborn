Actor source = Make(64f), target = Make(68f);
target.setKingdom(source.kingdom);
Ready(source);
await Advance(.16f);
Place(source, 64f);
Place(target, 68f);
var receipts = new List<ConstructedSignalReceipt>();
void Received(ConstructedSignalReceipt fact)
{
    if (fact.SenderId == source.id) receipts.Add(fact);
}

var rally = new AbilityDefinition
{
    Id = "test.body-footwork.rally", Name = "集结讯号验证", Resource = "none",
    Power = 1f, Cost = 0f, Lifetime = .42f, TargetRange = 30f,
    Impact = new ConstructionImpact
    {
        Targets = SkillUseTargetRelation.Friendly, DamageScale = 0, SelectedTargetOnly = true,
        Signal = new ConstructionSignal { Kind = ConstructionSignalKind.Rally, Duration = 1f }
    },
    Binding = new ConstructionBinding { Anchor = AbilityAnchor.Target, Height = .6f },
    Root = new ConstructionNode { Id = "contact", Form = "fireball", Matter = "physical", Scale = .75f }
};
ConstructedAbilityService.SignalReceived += Received;
try
{
    await Fire(rally, source, target, aggro: false);
    source.GetExtend().E.RemoveComponent<ConstructedKnowledge>();
    await Advance(.60f);
    Check(receipts.Count == 1 && receipts[0].Kind == ConstructionSignalKind.Rally &&
          receipts[0].RecipientId == target.id &&
          CombatStatusEffects.HasStatus(target, StatusEffects.SignalRally, source) &&
          !CombatStatusEffects.HasStatus(target, StatusEffects.SignalWarning, source),
        "实际接触只向指定友方交付一条集结讯号");
    await Advance(.70f);
    Check(receipts.Count == 1 && !CombatStatusEffects.HasStatus(target, StatusEffects.SignalRally, source),
        "原集结讯号到期，未重发收件");
    return new { passed = true, section, process = System.Diagnostics.Process.GetCurrentProcess().Id, checks };
}
finally
{
    ConstructedAbilityService.SignalReceived -= Received;
    ControllableUnit.clear(false);
}
