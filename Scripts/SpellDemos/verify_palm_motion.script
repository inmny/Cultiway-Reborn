// 9.03 C：用正式徒手入口对照同一对手的真实触掌、挥空和收势。
const bool missOnly = false;
const string palm = "Cultiway.PalmStrike";
Actor source = Make(66), target = Make(67), wolf = Make(12, "wolf");
target.setKingdom(wolf.kingdom);
var owner = source.GetExtend();
var spatial = service.Assembly.GetType("Cultiway.Content.Combat.SpatialActorPose");
float height = (float)spatial.GetMethod("Height", F).Invoke(null, new object[] { source });
var running = service.GetField("casts", F);
var settlements = new List<ConstructedQueuedDamage>();
var timeline = new List<object>();
ConstructedCastStarted? started = null;
AbilityCast live = null;
BodyPose? touchPose = null;

void Started(ConstructedCastStarted fact) { if (fact.SourceId == source.id && fact.AbilityId == palm) started = fact; }
void Touched(ConstructedContact fact) { if (fact.CastId == started?.CastId && fact.Node < 0) touchPose = live?.BodyPose; }
void Settled(ConstructedQueuedDamage fact) { if (fact.CastId == started?.CastId) settlements.Add(fact); }
float ElbowExtension(BodyPose p) => Vector3.Dot((p.Elbow - p.Shoulder).normalized, (p.Hand - p.Elbow).normalized);
float[] Point(Vector3 v) => new[] { v.x, v.y, v.z };
void Record(string run, string phase, BodyPose? pose, ConstructedContact? touch = null)
{
    object Sample(BodyPose value) => new { value.WorldAge, value.ActionAge, hip = Point(value.CenterOfMass),
        left = Point(value.LeftFoot), right = Point(value.RightFoot), shoulder = Point(value.Shoulder),
        elbow = Point(value.Elbow), palm = Point(value.Hand), value.Turn };
    timeline.Add(new { run, phase, age = live.Age, pose = pose.HasValue ? Sample(pose.Value) : null,
        contact = touch.HasValue ? Point(touch.Value.Position) : null, result = live.BodyResult?.ToString() });
    File.WriteAllText(Path.Combine(folder, "timeline.json"), JsonConvert.SerializeObject(timeline, Formatting.Indented));
}
async Task ToAge(float age)
{
    if (live.Age >= age) return;
    Config.paused = false;
    await Game.WaitUntil(() => live.Finished || live.Age >= age, 900);
    Config.paused = true;
    await Game.WaitUntil(Boundary, 900);
}

var clock = Config.time_scale_asset;
float worldSpeed = clock.multiplier;
ConstructedAbilityService.CastStarted += Started;
ConstructedAbilityService.ContactConfirmed += Touched;
ConstructedAbilityService.QueuedDamageConfirmed += Settled;
try
{
    PrepareAppearanceBackdrop(63, 74, 69, 76);
    Ready(source);
    source.attack_timer = 999;
    await Advance(.15f);
    // 独立取阶段图时让绘制帧跟上世界时钟；实际招式的时间窗口不变。
    clock.multiplier = worldSpeed * .18f;
    var entry = new ActiveAbilityHandle("content.palm_strike", owner.E);
    Check(ConstructionEditing.Access.Read(palm).Revision == 4, "原可学习掌击仍读取完整旧动作");
    foreach (bool miss in missOnly ? new[] { true } : new[] { false, true })
    {
        string run = miss ? "miss" : "hit";
        Place(source, 66f); Place(target, 66f + height * .4f);
        source.addAggro(target); target.addAggro(source);
        source.attack_timer = 0;
        int before = target.data.health;
        started = null; touchPose = null; contacts.Clear(); settlements.Clear();
        Check(ActiveAbilityService.TryUse(owner, entry, new ActiveAbilityTarget(target, target.GetSimPos()),
                ActiveAbilityUseOrigin.Script) && started.HasValue, run + "：正式徒手入口受理",
            new { position = Point(source.GetSimPos()), enemy = Point(target.GetSimPos()), height,
                control = ActiveAbilityService.ResolveControlState(owner, entry).BlockReason.ToString(),
                armed = source.hasWeapon(), hostile = SkillTargetRelationResolver.IsHostile(source, target) });
        source.attack_timer = 999;
        live = ((IEnumerable)running.GetValue(null)).Cast<object>()
            .Where(item => (long)Field(item, "Id") == started.Value.CastId)
            .Select(item => (AbilityCast)Field(item, "Cast")).Single();
        Check(live.Plan.Revision == 5 && live.BodyPose.HasValue &&
              BodyControlState.IsBusy(source.id, BodyOccupancy.RightArm | BodyOccupancy.Stance),
            run + "：新版实际接管手臂与支撑");
        if (miss) Place(target, 71f);
        BodyPose start = live.BodyPose.Value;
        Record(run, "ready", start);
        await ToAge(.088f);
        BodyPose loaded = live.BodyPose.Value;
        Record(run, "loaded", loaded);
        float fore = Vector3.Dot(loaded.CenterOfMass - start.CenterOfMass, start.Forward);
        float sink = start.CenterOfMass.z - loaded.CenterOfMass.z;
        bool feet = Vector3.Distance(start.LeftFoot, loaded.LeftFoot) < .02f &&
                    Vector3.Distance(start.RightFoot, loaded.RightFoot) < .02f;
        Check(contacts.Count == 0 && fore < -.012f * height && sink > .006f * height && feet,
            run + "：先沉重心和收肩，双足留在原位，未提前接触", new { fore, sink, feet });
        if (!miss) await FrameAppearance("01-load", 66.28f, 72.45f, 2.3f);

        if (miss)
        {
            await ToAge(.207f);
            BodyPose extension = live.BodyPose.Value;
            Record(run, "extension", extension);
            float forward = Vector3.Dot(extension.Hand - start.Hand, start.Forward);
            float shoulder = Vector3.Dot(extension.Shoulder - loaded.Shoulder, start.Forward);
            float opening = ElbowExtension(extension) - ElbowExtension(loaded);
            Check(forward > .035f * height && opening > .04f && shoulder > .025f * height && extension.Turn > loaded.Turn + 8 &&
                  Vector3.Distance(extension.Elbow, loaded.Elbow) > .025f * height &&
                  Vector3.Distance(extension.LeftFoot, start.LeftFoot) < .02f &&
                  Vector3.Distance(extension.RightFoot, start.RightFoot) < .02f,
                "落空仍由肩肘送掌，支撑没有滑动", new { forward, shoulder, opening, extension.Turn });
            await FrameAppearance("03-miss-extension", 66.28f, 72.45f, 2.3f);
            await ToAge(.405f);
            BodyPose recover = live.BodyPose.Value;
            Record(run, "return", recover);
            Check(Vector3.Dot(extension.Hand - recover.Hand, start.Forward) > .035f * height && live.BodyResult == null,
                "落空从送掌连续收回，没有命中反馈");
        }
        else
        {
            Config.paused = false;
            await Game.WaitUntil(() => contacts.Any(c => c.CastId == started.Value.CastId) || live.Age > .26f, 900);
            Config.paused = true; await Game.WaitUntil(Boundary, 900);
            var hits = contacts.Where(c => c.CastId == started.Value.CastId).ToArray();
            float palmDistance = hits.Length == 1 && touchPose.HasValue
                ? Vector3.Distance(touchPose.Value.Hand, hits[0].Position) : -1f;
            Record(run, "contact", touchPose, hits.Length == 1 ? hits[0] : (ConstructedContact?)null);
            Check(hits.Length == 1 && hits[0].TargetId == target.id && hits[0].Node == -1 &&
                  hits[0].Age >= .1499f && hits[0].Age <= .2551f && hits[0].BodyResult == BodyActionResult.Contact &&
                  palmDistance >= 0f && palmDistance <= height * .32f,
                "真实掌面在原作用窗口中只触掌一次，再进入卸力", new { palmDistance, height, hits = hits.Select(h => new { h.Age, h.Node, h.TargetId, result = h.BodyResult?.ToString(), touch = Point(h.Position) }).ToArray() });
            await FrameAppearance("02-hit-contact", 66.28f, 72.45f, 2.3f);
            await ToAge(hits[0].Age + .063f);
            BodyPose released = live.BodyPose.Value;
            Record(run, "release", released);
            await ToAge(hits[0].Age + .133f);
            BodyPose recover = live.BodyPose.Value;
            Record(run, "unload", recover);
            Check(live.BodyResult == BodyActionResult.Contact && released.ActionAge >= .32f &&
                  released.ActionAge - released.WorldAge > .05f &&
                  Vector3.Dot(released.Hand - recover.Hand, start.Forward) > .025f * height,
                "触掌后进入对应卸力段，经过余势后手臂实际收回", new { release = Point(released.Hand), after = Point(recover.Hand), released.ActionAge, released.WorldAge });
        }

        await Advance(.5f);
        int after = target.data.health;
        Record(run, "clear", live.BodyPose);
        Check(live.Finished && !BodyControlState.IsBusy(source.id) &&
              !ConstructedAbilityService.TryGetBodyPose(source.id, out _) &&
              endings.Any(e => e.Fact.CastId == started.Value.CastId && !e.Fact.Cancelled),
            run + "：自然结束，归还身体并撤除动作姿态");
        Check(miss ? contacts.Count == 0 && settlements.Count == 0 && before == after :
                contacts.Count == 1 && settlements.Count == 1 && settlements[0].Damage.SettledCount == 1 &&
                settlements[0].Damage.HealthLost > 0 && settlements[0].Damage.HealthLost == before - after,
            run + "：命中只扣血一次，落空不扣血", new { before, after, contacts = contacts.Count, settled = settlements.Count });
    }
    return new { passed = true, process = System.Diagnostics.Process.GetCurrentProcess().Id };
}
finally
{
    if (live != null && !live.Finished) live.Cancel();
    ConstructedAbilityService.CastStarted -= Started;
    ConstructedAbilityService.ContactConfirmed -= Touched;
    ConstructedAbilityService.QueuedDamageConfirmed -= Settled;
    ConstructedAbilityService.ContactConfirmed -= Hit;
    ConstructedAbilityService.CastEnded -= Ended;
    clock.multiplier = worldSpeed;
    ControllableUnit.clear(false);
    Config.paused = true;
}
