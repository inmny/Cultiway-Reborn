// 4.32B2：复用城市或完整平坦世界，实际推进同一地表过程。
bool cityCase = "GROUND_SCALE_CASE" == "city";
bool firstPersonFilm = "GROUND_SCALE_FIRSTPERSON" == "yes";
bool useWorldCatalog = "GROUND_SCALE_CATALOG" == "yes";
if (!cityCase)
    for (int y = 0; y < MapBox.height; y++)
    {
        for (int x = 0; x < MapBox.width; x++)
        {
            var tile = World.world.GetTileSimple(x, y);
            if (tile.building != null) tile.building.removeBuildingFinal();
            tile.setTileTypes(TileLibrary.soil_low, TopTileLibrary.grass_low); tile.Height = 100;
        }
        if (y % 16 == 0) await Game.NextFrame();
    }
City city = null;
bool originalBuild = DebugConfig.isOn(DebugOption.SystemBuildTick);
DebugConfig.setOption(DebugOption.SystemBuildTick, false);
if (cityCase)
{
    Actor settler = Make(60);
    settler.joinLanguage(World.world.languages.newLanguage(settler, true));
    settler.setCulture(World.world.cultures.newCulture(settler, true));
    World.world.kingdoms.makeNewCivKingdom(settler);
    city = World.world.cities.buildNewCity(settler, settler.current_tile.zone); settler.joinCity(city);
    for (int y = 64; y <= 88; y += 8)
    for (int x = 56; x <= 88; x += 8) city.addZone(World.world.GetTileSimple(x, y).zone);
    city.recalculateNeighbourZones();
    World.world.buildings.addBuilding("windmill_human_0", World.world.GetTileSimple(72, 75));
}
Check(!cityCase || city != null, "复用平坦世界并通过原版入口建立单个实际城市");
var cityTiles = new HashSet<int>();
int landCount = 0;
for (int y = 0; y < MapBox.height; y++)
for (int x = 0; x < MapBox.width; x++)
{
    var tile = World.world.GetTileSimple(x, y);
    if (!tile.Type.liquid) landCount++;
    if (cityCase && tile.zone.city == city) cityTiles.Add(x + y * MapBox.width);
}
Actor source = Make(64), foe = Make(12, "wolf");
if (!cityCase) Place(source, MapBox.width * .5f, MapBox.height * .5f);
var quietTile = source.current_tile;
quietTile.burned_stages = 2;
var targets = new List<Actor>();
Vector2[] positions = cityCase ? new[] { new Vector2(75, 72), new Vector2(95, 88), new Vector2(64, 94), new Vector2(48, 72) } :
    new[] { new Vector2(source.current_position.x + 11f, source.current_position.y), new Vector2(16, 16),
        new Vector2(MapBox.width - 16, 16), new Vector2(MapBox.width - 16, MapBox.height - 16), new Vector2(16, MapBox.height - 16) };
foreach (Vector2 point in positions)
{
    Actor actor = Make(point.x); Place(actor, point.x, point.y); actor.setKingdom(foe.kingdom); targets.Add(actor);
    var tile = World.world.GetTileSimple((int)point.x, (int)point.y); tile.burned_stages = 2;
}
var owner = source.GetExtend();
float wakanMaximum = 0f;
AbilityDefinition definition;
if (useWorldCatalog)
{
    var rootElements = new float[Cultiway.Const.ElementIndex.Count];
    rootElements[Cultiway.Const.ElementIndex.Earth] = 2f;
    owner.GetOrAddComponent<Cultiway.Core.Components.ElementRoot>() =
        new Cultiway.Core.Components.ElementRoot(rootElements);
    owner.MarkCultiwayStatsDirty();
    var xian = Cultisyses.Xian;
    int highest = xian.GetHighestGrantableRealm(xian.DefaultComponent.CurrLevel);
    xian.GrantToRealm(owner, highest);
    Check(owner.HasCultisys<Xian>() && owner.GetCultisys<Xian>().CurrLevel == highest && highest >= 4,
        "实际进阶规则授予当前最高可达境界", new { highest, name = xian.GetLevelName(highest) });
    source.setStatsDirty();
    source.updateStats();
    wakanMaximum = source.stats[BaseStatses.MaxWakan.id];
    var access = ConstructionEditing.Access;
    string id = cityCase ? "Cultiway.GroundPulse.City" : "Cultiway.GroundPulse.World";
    Check(access.List().Any(row => row.Id == id) && !ConstructedAbilityService.Knows(owner, id),
        "从当前世界目录能取得正式底稿，未自动授予知识", id);
    var original = access.Read(id);
    definition = access.Apply(owner, new ConstructionEditSession(original), false);
    Check(original.Cost == (cityCase ? 100f : 500f) && wakanMaximum >= original.Cost &&
        definition.Parent.Id == id && ConstructedAbilityService.Knows(owner, definition.Id),
        "正式另创后学会独立成品，原真元上限可支付", new { basis = id, definition.Id, definition.Cost, wakanMaximum });
}
else
{
    owner.AddComponent(new Xian { level = 4, wakan = 100000f });
    definition = LegacyDefinition();
}

AbilityDefinition LegacyDefinition()
{
    var definition = BodyActionCatalog.Create("test.ground-scale.GROUND_SCALE_CASE", cityCase ? "城域地脉传力" : "全域地脉传力",
        new BodyActionRequest { Kind = BodyActionKind.Guard, Effector = "foot.right", Seconds = 1.2f });
    definition.Use = new ConstructionUse { Channels = ActiveAbilityChannel.World, Target = ActiveAbilityTargetMode.Point };
    definition.Resource = "wakan"; definition.Cost = cityCase ? 100f : 500f; definition.Cooldown = 0; definition.Power = 100f; definition.Lifetime = 12f;
    definition.Body.Impact = new ConstructionImpact { DamageScale = 0f };
    definition.Body.ActiveFrom = .45f; definition.Body.ActiveUntil = .65f; definition.Body.MatchDistance = false;
    foreach (var key in definition.Body.Keys) { key.Foot = new[] { .1f, key.Foot[1], 0f }; key.Torso = new[] { 0f, 0f, -.12f }; }
    definition.Impact = new ConstructionImpact { DamageScale = .005f, WorldEffects = new[]
        { new ConstructionWorldEffect { Action = "land.cleanse", TileCentreOnly = true, MaximumTiles = MapBox.width * MapBox.height } } };
    definition.Root = new ConstructionNode
    {
        Id = "front", Form = "fracture_slab", Matter = "physical", Surface = "stone",
        Activation = new ConstructionActivation { Source = "body", Trigger = ConstructionChangeTrigger.WorldContact, Placement = ConstructionEventPlacement.Event },
        Operations = new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Propagate,
            Propagation = new ConstructionPropagation { Range = cityCase ? 48f : Mathf.Max(MapBox.width, MapBox.height) * 2f,
                Speed = cityCase ? 16f : 70f, Seconds = cityCase ? .8f : .2f, InnerRadius = 2f,
                Height = cityCase ? 2f : 5f, Angle = 360f, Attenuation = .004f, MaximumCells = 65536 } } }
    };
    return definition;
}
var actions = new List<ConstructedActionEvent>();
var worlds = new List<ConstructedWorldContact>();
var finishes = new List<ConstructedCastEnded>();
var samples = new List<object>();
var watch = System.Diagnostics.Stopwatch.StartNew();
double started = -1d;
int[] health = null;
int[] healthAtGroundContact = null;
int? farHealthAtNearHit = null;
object catalogWave = null;
int deferred = cityCase ? 1 : targets.Count - 1;
/// <summary>记录正式受理的共同开始时间。</summary><param name="fact">实际受理。</param>
void Started(ConstructedCastStarted fact) { if (fact.AbilityId == definition.Id) started = fact.WorldTime; }
/// <summary>记录实际动作，未确认预测不计入。</summary><param name="fact">已确认动作。</param>
void ActionFact(ConstructedActionEvent fact)
{
    if (fact.AbilityId != definition.Id) return;
    actions.Add(fact);
    if (useWorldCatalog && fact.Fact.Node < 0 && fact.Fact.ContactKind == AbilityActionContactKind.World)
        healthAtGroundContact ??= targets.Select(target => target.data.health).ToArray();
}
void ObserveCatalogContact(ConstructedContact fact)
{
    if (!useWorldCatalog || fact.AbilityId != definition.Id || fact.Node < 0) return;
    var running = Live();
    if (running != null) catalogWave ??= ((Array)Field(running, "propagations")).GetValue(0);
    if (fact.TargetId != targets[deferred].id)
        farHealthAtNearHit ??= targets[deferred].data.health;
}
/// <summary>保留实际地块操作。</summary><param name="fact">世界结果。</param>
void WorldFact(ConstructedWorldContact fact) { if (fact.AbilityId == definition.Id) worlds.Add(fact); }
/// <summary>保留真实结束。</summary><param name="fact">结束事实。</param>
void Finished(ConstructedCastEnded fact) { if (fact.AbilityId == definition.Id) finishes.Add(fact); }
/// <summary>读取正式运行，不另建离线施放。</summary>
AbilityCast Live() => ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>().Select(c => (AbilityCast)Field(c, "Cast"))
    .FirstOrDefault(c => c.Plan.Id == definition.Id);
/// <summary>只有身体已经真实归还，才停止附体输入和场景内后续自主行为。</summary>
void QuietBody()
{
    if (BodyControlState.IsBusy(source.id)) return;
    ControllableUnit.remove(source); source.finishStatusEffect("possessed"); source.setPossessedMovement(false);
    CombatStatusEffects.ApplyStatus(source, hold, 10000, source); source.updateStats();
}
Type external = AppDomain.CurrentDomain.GetAssemblies().Select(a => a.GetType("FirstPerson.WorldBoxMod", false)).FirstOrDefault(t => t != null);
object mod = external?.GetProperty("Instance", F).GetValue(null);
if (firstPersonFilm && mod == null) throw new InvalidOperationException("第一人称录像需要 Worldfall");
string actualView = firstPersonFilm ? "firstperson" : mod == null ? "native" : "worldfall";
bool? oldMouseLook = null;
object FirstPersonView(string name) => external.GetProperty(name, F).GetValue(mod);
bool InSourceView() => (bool)FirstPersonView("IsFirstPerson") && (bool)FirstPersonView("DiveDone") &&
    !(bool)FirstPersonView("GodShown") && ReferenceEquals(FirstPersonView("Host"), source);

float? originalGodZoom = null, originalFogRange = null, originalLens = null;
Camera camera = World.world.camera;
RenderTexture nativeTarget = null;
Texture2D read = null;
/// <summary>只改变取景，使用原版真实相机或Worldfall最终纹理。</summary>
/// <param name="name">画面名称。</param><param name="close">是否为来源动作近景。</param>
async Task Shot(string name, bool close = false)
{
    Config.paused = true; await Game.WaitUntil(Boundary, 1800);
    bool middleView = name == "view-mid";
    World.world.console.Hide(); Tooltip.hideTooltipNow();
    foreach (var loading in Resources.FindObjectsOfTypeAll<LoadingScreen>()) loading.gameObject.SetActive(false);
    if (firstPersonFilm)
    {
        if (name == "before") return;
        if (!oldMouseLook.HasValue)
        {
            external.GetMethod("SetGodView", F).Invoke(mod, new object[] { false });
            external.GetMethod("ViewForTest", F).Invoke(mod, new object[] { true });
            var mouse = external.GetField("MouseLookOff", F);
            oldMouseLook = (bool)mouse.GetValue(mod);
            mouse.SetValue(mod, true);
            external.GetMethod("SetYaw", F).Invoke(mod, new object[] { 0f });
            external.GetMethod("SetPitchDegrees", F).Invoke(mod, new object[] { -19f });
        }
        await Game.WaitUntil(InSourceView, 1800);
        for (int i = 0; i < 3; i++) await Game.NextFrame();
        Screen.Capture(Path.Combine(folder, name + ".png"));
        return;
    }
    RenderTexture target = nativeTarget;
    var previous = RenderTexture.active;
    if (mod != null)
    {
        void Set(string field, object value) => mod.GetType().GetField(field, F).SetValue(mod, value);
        object settings = Field(mod, "Settings");
        var zoomField = settings.GetType().GetField("GodViewZoom", F);
        originalGodZoom ??= (float)zoomField.GetValue(settings);
        zoomField.SetValue(settings, Mathf.Max(originalGodZoom.Value, MapBox.height));
        /// <summary>同时更新原版取景目标和外部远近视点，避免视角切换后旧目标覆盖新取景。</summary>
        void FrameView()
        {
            MoveCamera.clearFocusUnitOnly();
            camera.transform.position = new Vector3(source.current_position.x, source.current_position.y, camera.transform.position.z);
            typeof(MoveCamera).GetMethod("forceZoom", F).Invoke(Field(World.world, "<move_camera>k__BackingField"),
                new object[] { close ? 10f : middleView ? 25f : cityCase ? 55f : MapBox.height * .65f });
            Set("_godCamWas", camera.transform.position); Set("_godCamSet", true);
            Set("_godLock", close ? source : null); Set("_godFollow", source.current_position); Set("_godFollowVel", Vector2.zero);
            float distance = close ? 2f : middleView ? 5.8f : 10f;
            Set("_godClose", distance); Set("_godCloseTarget", distance);
            Set("_godPull", close ? 1f : middleView ? .43f : 0f); Set("_godTurn", -.25f); Set("_godTurnRate", 0f); Set("_godTip", close ? .2f : cityCase ? .35f : 0f); Set("_godTipRate", 0f);
            Set("_godHoming", false);
        }
        bool worldFlight = useWorldCatalog && !cityCase &&
            (name == "view-world" || name == "ended" && originalFogRange.HasValue);
        if (worldFlight)
        {
            if (!originalFogRange.HasValue)
            {
                // 正常远景的远端雾线会遮住前沿，改用 Worldfall 自带自由飞行的宽角机位。
                var range = settings.GetType().GetField("DrawDistance", F);
                var lens = settings.GetType().GetField("FieldOfView", F);
                originalFogRange = (float)range.GetValue(settings);
                originalLens = (float)lens.GetValue(settings);
                range.SetValue(settings, (float)settings.GetType().GetField("WholeMap", F).GetRawConstantValue());
                lens.SetValue(settings, 110f);
                external.GetMethod("StartFlyForTest", F).Invoke(mod, null);
                var overview = new Vector3(MapBox.width * .5f, -8f, MapBox.height * (145f / 256f));
                external.GetMethod("PlaceFlyForTest", F).Invoke(mod, new object[] { overview, Mathf.PI * .5f, -54f });
            }
        }
        else
        {
            mod.GetType().GetMethod("ViewForTest", F).Invoke(mod, new object[] { false });
            mod.GetType().GetMethod("SetGodView", F).Invoke(mod, new object[] { true });
            FrameView();
            await Game.WaitUntil(() => (bool)external.GetProperty("GodShown", F).GetValue(mod) &&
                (float)external.GetProperty("GodAlpha", F).GetValue(mod) >= .999f, 1800);
            FrameView();
            for (int i = 0; i < 12; i++) await Game.NextFrame();
        }
        int prior = (int)Field(mod, "_godGpuApplied");
        await Game.WaitUntil(() => (int)Field(mod, "_godGpuApplied") >= prior + (worldFlight ? 5 : 3) &&
            (!close || (float)Field(Field(mod, "_godShown"), "Z") < 20f) &&
            (!worldFlight || (bool)Field(mod, "_fly")), 1800);
        object gpu = mod.GetType().GetProperty("GpuRendererForTest", F).GetValue(mod);
        target = (RenderTexture)Field(gpu, "Output");
    }
    else
    {
        // 直接改变取景不会更新原版可见区域；把场景修改留在远处的原生重绘队列也提交到实际背景。
        typeof(WorldTilemap).GetMethod("redrawTiles", F).Invoke(World.world.tilemap, new object[] { true });
        World.world.redrawMiniMap(true);
        var position = camera.transform.position; float zoom = camera.orthographicSize; var oldTarget = camera.targetTexture;
        try
        {
            camera.transform.position = close || middleView ? new Vector3(source.current_position.x, source.current_position.y + .5f, 0f) :
                cityCase ? new Vector3(64, 64, 0f) : new Vector3(MapBox.width * .5f, MapBox.height * .5f, 0f);
            camera.orthographicSize = close ? 4f : middleView ? 22f : cityCase ? 50f : MapBox.height * .61f;
            camera.targetTexture = target; camera.Render();
        }
        finally { camera.transform.position = position; camera.orthographicSize = zoom; camera.targetTexture = oldTarget; }
    }
    if (read == null || read.width != target.width || read.height != target.height)
    {
        if (read != null) UnityEngine.Object.Destroy(read);
        read = new Texture2D(target.width, target.height, TextureFormat.RGBA32, false);
    }
    try { RenderTexture.active = target; read.ReadPixels(new Rect(0, 0, target.width, target.height), 0, 0); read.Apply();
        File.WriteAllBytes(Path.Combine(folder, name + ".png"), read.EncodeToPNG()); }
    finally { RenderTexture.active = previous; }
    var cast = Live();
    var shapes = new List<AbilityCapsule>(); var visuals = new List<FormVisualInstance>();
    cast?.AppendContacts(shapes); cast?.AppendVisuals(visuals);
    if (name == "middle")
    {
        var cells = shapes.Where(s => s.Node >= 0 && s.HalfExtents.z > .000001f).ToArray();
        var ground = (PropagationGround)Field(cast, "propagationGround");
        var terrain = (AbilityHeightField)Field(ground, "Terrain");
        Check(cells.Length > 0 && cells.All(s => visuals.Any(v => v.Layer != null &&
            s.A.x >= v.Layer.Origin.x && s.A.y >= v.Layer.Origin.y &&
            s.A.x < v.Layer.Origin.x + v.Layer.Cells && s.A.y < v.Layer.Origin.y + v.Layer.Cells &&
            Math.Abs(v.Layer.Depth((int)(s.A.x - v.Layer.Origin.x), (int)(s.A.y - v.Layer.Origin.y)) - s.HalfExtents.z * 2f) < .00001f) &&
            Math.Abs(s.A.z - s.HalfExtents.z - (terrain?.Sample(s.A.x, s.A.y) ?? 0f)) < .00001f),
            "实际宏观波厚、发布显示和当前地表位置一致");
    }
    samples.Add(new { name, worldTime = World.world.getCurWorldTime(), age = cast?.Age, wallMs = watch.ElapsedMilliseconds,
        cameraZoom = camera.orthographicSize, cameraPosition = new[] { camera.transform.position.x, camera.transform.position.y, camera.transform.position.z },
        godClose = mod == null ? (float?)null : (float)Field(mod, "_godClose"),
        shownPosition = mod == null ? null : new[] { (float)Field(Field(mod, "_godShown"), "X"),
            (float)Field(Field(mod, "_godShown"), "Y"), (float)Field(Field(mod, "_godShown"), "Z") },
        shapes = shapes.Count, regions = visuals.Count(v => v.Layer != null), bodyBusy = BodyControlState.IsBusy(source.id),
        targetHealth = targets.Select(t => new { t.id, t.data.health }).ToArray() });
    File.WriteAllText(Path.Combine(folder, "samples.json"), JsonConvert.SerializeObject(samples, Formatting.Indented));
}
/// <summary>按真正开始时间推进，不把取景等待算入世界时间。</summary><param name="age">目标年龄。</param>
async Task To(float age)
{
    float remaining = age - (float)(World.world.getCurWorldTime() - started);
    if (remaining > 0f) await Advance(remaining);
    QuietBody();
}
ConstructedAbilityService.CastStarted += Started; ConstructedAbilityService.ActionConfirmed += ActionFact;
ConstructedAbilityService.WorldContactConfirmed += WorldFact; ConstructedAbilityService.CastEnded += Finished;
if (useWorldCatalog) ConstructedAbilityService.ContactConfirmed += ObserveCatalogContact;
float oldTargetFps = Cultiway.Const.PerformanceSettings.TargetRenderFps;
float oldFrameBudget = Cultiway.Const.PerformanceSettings.MaxSimulationMillisecondsPerFrame;
try
{
    nativeTarget = new RenderTexture(1280, 720, 24, RenderTextureFormat.ARGB32); nativeTarget.Create();
    if (mod != null)
    {
        // 整图准备会改变外部地貌分类；沿已有入口同步重建，不能在旧地貌尚未更新时出手。
        object sampler = Field(mod, "_sampler");
        sampler.GetType().GetMethod("Invalidate", F).Invoke(sampler, null);
        sampler.GetType().GetMethod("EnsureWorld", F).Invoke(sampler, null);
        var ground = (Func<Rect, AbilityHeightField>)service.GetField("GroundProvider", F).GetValue(null);
        ground(new Rect(0, 0, MapBox.width, MapBox.height));
    }
    if (useWorldCatalog)
    {
        // 调度规则和世界步长保留。软件渲染下多给模拟留一些时间，退出后复原。
        Cultiway.Const.PerformanceSettings.SetTargetRenderFps(15f);
        Cultiway.Const.PerformanceSettings.SetMaxSimulationMillisecondsPerFrame(60f);
        var initialization = service.Assembly.GetType("Cultiway.Patch.PatchFramePriorityScheduler")
            .GetMethod("IsWorldInitializationPending", F);
        await Game.WaitUntil(() => !(bool)initialization.Invoke(null, null), 3600);
        Config.setWorldSpeed("x1", false);
    }
    await Advance(.15f); await Shot("before");
    health = targets.Select(a => a.data.health).ToArray();
    var aim = new Vector3(source.current_position.x + 1f, source.current_position.y, 0f);
    Ready(source);
    if (useWorldCatalog)
    {
        if (mod != null && !cityCase)
        {
            await Game.NextFrame();
            await Game.WaitUntil(Boundary, 1800);
        }
        var handle = new ActiveAbilityHandle("content.constructed", owner.E, definition.Id);
        var choice = new ActiveAbilityTarget(null, aim);
        if (!cityCase)
        {
            WakanResourceService.Set(owner, ref owner.GetCultisys<Xian>(), definition.Cost - 1f);
            Check(!ActiveAbilityService.TryUse(owner, handle, choice, ActiveAbilityUseOrigin.Player) &&
                started < 0d && Live() == null && owner.GetCultisys<Xian>().wakan == definition.Cost - 1f,
                "真元不足拒绝世界术，原存量和动作均未改变");
        }
        WakanResourceService.Set(owner, ref owner.GetCultisys<Xian>(), wakanMaximum);
        float balance = owner.GetCultisys<Xian>().wakan;
        Check(ActiveAbilityService.TryUse(owner, handle, choice, ActiveAbilityUseOrigin.Player) &&
            balance - owner.GetCultisys<Xian>().wakan == definition.Cost,
            "玩家正常入口受理，同一修士只支付一次", new { source = source.id, balance, after = owner.GetCultisys<Xian>().wakan });
        source.attack_timer = 999;
    }
    else
    {
        float balance = owner.GetCultisys<Xian>().wakan;
        await Fire(definition, source, targets[0], aim: aim, aggro: false);
        owner.E.RemoveComponent<ConstructedKnowledge>();
        Check(balance - owner.GetCultisys<Xian>().wakan == definition.Cost, "整次宏观施放支付一次");
    }
    object wave;
    if (useWorldCatalog)
    {
        await Shot("source", true);
        Config.paused = false;
        await Game.WaitUntil(() => finishes.Count > 0, 3600);
        Config.paused = true;
        await Game.WaitUntil(Boundary, 1800);
        Check(healthAtGroundContact != null && healthAtGroundContact.SequenceEqual(health),
            "实际脚下触地时，所有对手保持原生命", healthAtGroundContact);
        Check(farHealthAtNearHit == health[deferred],
            "传播已命中近处，远处仍保持原生命", new { before = health[deferred], observed = farHealthAtNearHit });
        wave = catalogWave;
    }
    else
    {
        await To(.25f); await Shot("source", true);
        await To(.5f);
        var live = Live(); Check(live != null, "实际触地之后普通传播仍在运行");
        wave = ((Array)Field(live, "propagations")).GetValue(0);
    }
    Check(wave != null, "真实身体接触已经建立地面过程");
    var route = ((IEnumerable)Field(wave, "Route")).Cast<object>().Select(c => new
        { x = (int)Field(c, "X"), y = (int)Field(c, "Y"), distance = (float)Field(c, "Distance"), at = (float)Field(c, "At") }).ToArray();
    var reached = new HashSet<int>(route.Select(c => c.x + c.y * MapBox.width));
    float speed = cityCase ? 16f : 70f;
    Check(route.All(c => c.at >= c.distance / speed - .000001f &&
        c.at - c.distance / speed <= Math.Min(1d / 240d, 1d / (16d * speed)) + .000001f),
        "真实路程到达只向后合并，时间和路程精度均满足明确上限");
    File.WriteAllText(Path.Combine(folder, "route.json"), JsonConvert.SerializeObject(new
        { width = MapBox.width, height = MapBox.height, landCount, city = city?.id, cityTiles = cityTiles.Count, route }, Formatting.Indented));
    Check(cityCase ? cityTiles.Count > 0 && cityTiles.All(id => World.world.GetTileSimple(id % MapBox.width, id / MapBox.width).Type.liquid || reached.Contains(id)) :
        reached.Count == landCount && reached.Any(id => id % MapBox.width == 0) && reached.Any(id => id / MapBox.width == MapBox.height - 1),
        cityCase ? "真实路径覆盖已有城市及周围地面" : "同一过程覆盖整个平坦世界，包含地图边缘");
    if (useWorldCatalog) await Shot("ended");
    else
    {
        Check(!contacts.Any(c => c.AbilityId == definition.Id), "宏观范围没有变成出手瞬间全域伤害");
        await To(1.8f); await Shot("middle");
        Check(targets[deferred].data.health == health[deferred], "尚未到达的远处目标没有提前损失生命");
        await To(3f); await Shot("front");
        await To(6f); await Shot("ended");
    }
    Check(finishes.Count == 1 && !finishes[0].Cancelled && !BodyControlState.IsBusy(source.id), "宏观过程自然结束并归还控制");
    Check(targets.All(t => contacts.Count(c => c.AbilityId == definition.Id && c.TargetId == t.id) == 1) &&
        targets.Select((t, i) => t.data.health < health[i]).All(v => v), "各处实际到达后才受击一次");
    Check(targets.All(t => World.world.GetTileSimple(t.current_tile.pos.x, t.current_tile.pos.y).burned_stages == 0) &&
        worlds.Any(w => w.Result.Changed), "两种尺度均产生真实地块结果");
    Check(quietTile.burned_stages == 2, "来源安静区既不显示波面，也不产生隐藏地块作用");
    if (!useWorldCatalog && cityCase && mod == null)
    {
        // 本轮改动了离开检查的启用条件，仅复用一个已有旋转形体核对重新进入。
        if (!((IDictionary)typeof(ConstructionWorldActions).GetField("actions", F).GetValue(null)).Contains("test.ground-scale.reentry"))
            ConstructionWorldActions.Register(new ConstructionWorldAction("test.ground-scale.reentry", tile => true, context => default));
        var reentry = new AbilityDefinition
        {
            Id = "test.ground-scale.reentry", Name = "地块重新进入核对", Lifetime = 2.4f, Resource = "none", Cost = 0,
            Cooldown = 0, Power = 0, TargetRange = 100, Use = definition.Use,
            Impact = new ConstructionImpact { DamageScale = 0f, WorldEffects = new[] { new ConstructionWorldEffect
                { Action = "test.ground-scale.reentry", Contact = new ConstructionContactPolicy { Mode = ConstructionContactMode.Reentry } } } },
            Root = new ConstructionNode { Id = "surface", Form = "sword", Matter = "iron", Rotation = new[] { 0f, 90f, 0f },
                ActiveFrom = .1f, ActiveUntil = 2.39f, Operations = new[] { new ConstructionOperation
                    { Kind = ConstructionOperationKind.Spin, Vector = new[] { 0f, 360f, 0f } } } }
        };
        Check(!AbilityCompiler.Compile(definition).HasWorldReentry && AbilityCompiler.Compile(reentry).HasWorldReentry,
            "一次地块作用跳过历史离开查询，重新进入型仍启用");
        var returns = new List<ConstructedWorldContact>();
        void Returned(ConstructedWorldContact fact) { if (fact.AbilityId == reentry.Id) returns.Add(fact); }
        ConstructedAbilityService.WorldContactConfirmed += Returned;
        try
        {
            Ready(source); await Fire(reentry, source, targets[0], aim: new Vector3(64.5f, 72.5f, 0f), aggro: false);
            owner.E.RemoveComponent<ConstructedKnowledge>(); await Advance(2.6f); QuietBody();
            var hits = returns.Where(e => e.X == 66 && e.Y == 72).OrderBy(e => e.Age).ToArray();
            Check(hits.Length >= 2 && hits.Zip(hits.Skip(1), (a, b) => b.Age - a.Age).All(gap => gap > .5f),
                "真实离开并旋转返回仍能再次作用，持续接触不重复计入");
            File.WriteAllText(Path.Combine(folder, "reentry.json"), JsonConvert.SerializeObject(returns, Formatting.Indented));
        }
        finally { ConstructedAbilityService.WorldContactConfirmed -= Returned; }
        // 相同部位跳过自碰撞后，多施放仍须进入原交锋路径；复用已有来源和敌方人物。
        Place(source, 64, 72); Place(foe, 72, 72);
        AbilityDefinition Projectile(string suffix, Actor caster, float force, float speed) => new()
        {
            Id = "test.ground-scale.clash." + suffix, Name = "共同交锋核对", Resource = "none", Cost = 0,
            Cooldown = 0, Lifetime = .12f, Power = force / caster.stats["damage"],
            Binding = new ConstructionBinding { Anchor = AbilityAnchor.Source },
            Root = new ConstructionNode { Id = "body", Form = "sword", OnContact = ConstructionContactResponse.End,
                Operations = new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Fly, Vector = new[] { speed, 0f, 0f } } } }
        };
        var clashes = new List<ConstructedClash>();
        void Clashed(ConstructedClash fact) { if (fact.LeftSource == source.id || fact.RightSource == source.id) clashes.Add(fact); }
        ConstructedAbilityService.ClashConfirmed += Clashed;
        try
        {
            await Fire(Projectile("left", source, 100f, 600f), source, foe);
            await Fire(Projectile("right", foe, 40f, -600f), foe, source);
            owner.E.RemoveComponent<ConstructedKnowledge>(); foe.GetExtend().E.RemoveComponent<ConstructedKnowledge>();
            await Advance(.2f);
            Check(clashes.Count == 1 && clashes[0].Absorbed > 0f, "不同施放仍真实相撞并扣除作用量，没有跳过敌方交锋");
            File.WriteAllText(Path.Combine(folder, "clashes.json"), JsonConvert.SerializeObject(clashes.Select(c => new
                { c.LeftSource, c.RightSource, c.LeftAge, c.RightAge, c.Absorbed, c.LeftRemaining, c.RightRemaining,
                    point = new[] { c.Position.x, c.Position.y, c.Position.z } }), Formatting.Indented));
        }
        finally { ConstructedAbilityService.ClashConfirmed -= Clashed; }
    }
    File.WriteAllText(Path.Combine(folder, "definition.json"), JsonConvert.SerializeObject(definition, Formatting.Indented));
    var result = new { passed = true, view = actualView, scale = "GROUND_SCALE_CASE", cells = route.Length,
        catalog = useWorldCatalog, damage = targets.Select((actor, i) => health[i] - actor.data.health).ToArray(),
        process = System.Diagnostics.Process.GetCurrentProcess().Id, wallMs = watch.ElapsedMilliseconds };
    File.WriteAllText(Path.Combine(folder, "result.json"), JsonConvert.SerializeObject(result, Formatting.Indented));
    return result;
}
finally
{
    ConstructedAbilityService.CastStarted -= Started; ConstructedAbilityService.ActionConfirmed -= ActionFact;
    ConstructedAbilityService.WorldContactConfirmed -= WorldFact; ConstructedAbilityService.CastEnded -= Finished;
    if (useWorldCatalog)
    {
        ConstructedAbilityService.ContactConfirmed -= ObserveCatalogContact;
        Cultiway.Const.PerformanceSettings.SetTargetRenderFps(oldTargetFps);
        Cultiway.Const.PerformanceSettings.SetMaxSimulationMillisecondsPerFrame(oldFrameBudget);
        File.WriteAllText(Path.Combine(folder, "health-at-contact.json"), JsonConvert.SerializeObject(new
        {
            before = health, ground = healthAtGroundContact, deferred = targets[deferred].id, farHealthAtNearHit
        }, Formatting.Indented));
    }
    ConstructedAbilityService.ContactConfirmed -= Hit; ConstructedAbilityService.CastEnded -= Ended; Config.paused = true;
    DebugConfig.setOption(DebugOption.SystemBuildTick, originalBuild);
    if (oldMouseLook.HasValue)
    {
        external.GetField("MouseLookOff", F).SetValue(mod, oldMouseLook.Value);
        external.GetMethod("ViewForTest", F).Invoke(mod, new object[] { false });
        ControllableUnit.clear(false);
    }
    if (originalGodZoom.HasValue)
    {
        object settings = Field(mod, "Settings");
        settings.GetType().GetField("GodViewZoom", F).SetValue(settings, originalGodZoom.Value);
        if (originalFogRange.HasValue)
        {
            external.GetMethod("EndFly", F).Invoke(mod, null);
            settings.GetType().GetField("DrawDistance", F).SetValue(settings, originalFogRange.Value);
            settings.GetType().GetField("FieldOfView", F).SetValue(settings, originalLens.Value);
        }
    }
    if (nativeTarget != null) { nativeTarget.Release(); UnityEngine.Object.Destroy(nativeTarget); }
    if (read != null) UnityEngine.Object.Destroy(read);
    File.WriteAllText(Path.Combine(folder, "contacts.json"), JsonConvert.SerializeObject(contacts.Select(c => new { c.AbilityId, c.TargetId, c.Node, c.Age, position = new[] { c.Position.x, c.Position.y, c.Position.z } }), Formatting.Indented));
    File.WriteAllText(Path.Combine(folder, "world.json"), JsonConvert.SerializeObject(worlds, Formatting.Indented));
    File.WriteAllText(Path.Combine(folder, "ended.json"), JsonConvert.SerializeObject(finishes, Formatting.Indented));
    File.WriteAllText(Path.Combine(folder, "actions.json"), JsonConvert.SerializeObject(actions.Select(a => new
        { a.AbilityId, a.SourceId, a.WorldTime, a.Fact.Node, kind = a.Fact.Kind.ToString(), a.Fact.Age,
            contact = a.Fact.ContactKind.ToString(), point = new[] { a.Fact.Point.x, a.Fact.Point.y, a.Fact.Point.z } }), Formatting.Indented));
}
