// 部件聚合的完整姿态、实际作用、条件、回退及正式施放；独立保存冷启动依据。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using UnityEngine;
using Cultiway.Core;
using Cultiway.Core.Skills;
using Cultiway.Core.Visuals.Forms;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Content.Skills;
using Cultiway.Content.Combat;
using Cultiway.Content.Components;
using Cultiway.Utils.Extension;
const BindingFlags Flags=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Static|BindingFlags.Instance;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/gather");Directory.CreateDirectory(folder);
var checks=new List<string>();void Check(bool value,string name){if(!value)throw new InvalidOperationException(name);checks.Add(name);}
void Reject(AbilityDefinition d,string name){try{AbilityCompiler.Compile(d);}catch(InvalidDataException){checks.Add(name);return;}throw new InvalidOperationException(name);}
AbilityDefinition Read(string name)=>JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/"+name+".json")));
var inputs=new AbilityInputs(Vector3.zero,Vector3.right*16,Vector3.right,1);
AbilityCast Cast(AbilityDefinition d)=>new(AbilityCompiler.Compile(d),Matrix4x4.identity,inputs:inputs,force:20);
List<FormVisualInstance> Views(AbilityCast c){var list=new List<FormVisualInstance>();c.AppendVisuals(list);return list;}
FormVisualInstance Sword(AbilityCast c)=>Views(c).Single(v=>v.Resource.Description.Id=="sword");
var basis=new AbilityDefinition{Id="test.gather.base",Lifetime=4,Resource="none",Cost=0,Root=new ConstructionNode{Id="layout",Form="pivot",ContactRole=ConstructionContactRole.Decoration,Offset=new[]{3f,4f,0f},Children=new[]{new ConstructionNode{Id="piece",Form="sword",Matter="iron",Scale=.7f,Offset=new[]{0f,0f,1f},Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Gather,At=.2f,Seconds=1f,Vector=new[]{4f,0f,1f},GatherRotation=new[]{0f,90f,0f}}}}}}};
var c=Cast(basis);Check(c.ContactOrigin(1)==new Vector3(3,4,1),"聚合前保留节点实际散布位置");c.Advance(.2f,inputs.Target);Check(c.ContactOrigin(1)==new Vector3(3,4,1),"开始边界不产生瞬移");c.Advance(.5f,inputs.Target);Check(Vector3.Distance(c.ContactOrigin(1),new Vector3(5,4,1))<.0001f,"聚合中点沿真实位置连续汇入");Check(Quaternion.Angle(Sword(c).Transform.rotation,Quaternion.Euler(0,45,0))<.001f,"部件朝向与平移在同一进度连续变化");Check(Mathf.Abs(Sword(c).Transform.lossyScale.x-.7f)<.0001f,"聚合保持真实尺寸，不缩成替代粒子");
var shapes=new List<AbilityCapsule>();c.AppendContacts(shapes);var local=FormResources.Load("sword").Description.Contacts[0];Check(shapes.Count==1&&Vector3.Distance(shapes[0].B,Sword(c).Transform.MultiplyPoint3x4(new Vector3(local.B[0],local.B[1],local.B[2])))<.0001f,"实际作用端点读取与模型相同的聚合姿态");c.Advance(.5f,inputs.Target);Check(Vector3.Distance(c.ContactOrigin(1),new Vector3(7,4,1))<.0001f,"完整汇入后精确停在目标布局");var settled=c.ContactOrigin(1);c.Advance(.2f,inputs.Target);Check(c.ContactOrigin(1)==settled&&c.Matter(1).Id=="iron"&&c.RemainingForce(1)==20,"完成聚合保留部件身份、实际材料及余力");
var moving=ConstructionEditing.Copy(basis);moving.Root.Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Fly,Vector=new[]{2f,0f,0f},WorldVelocity=true},new ConstructionOperation{Kind=ConstructionOperationKind.Spin,Vector=new[]{0f,0f,90f}}};c=Cast(moving);c.Advance(1.3f,inputs.Target);var parent=Matrix4x4.TRS(new Vector3(5.6f,4,0),Quaternion.Euler(0,0,117),Vector3.one);Check(Vector3.Distance(c.ContactOrigin(1),parent.MultiplyPoint3x4(new Vector3(4,0,1)))<.0002f,"汇入目标持续跟随移动旋转的父结构");
var condition=ConstructionEditing.Copy(basis);condition.Root.Children[0].Operations[0].When=new ConstructionCondition();condition.Root.Children[0].Operations[0].At=0;c=Cast(condition);c.Advance(.4f,inputs.Target);var before=c.ContactOrigin(1);c.ConfirmContact(1,1);Check(c.ContactOrigin(1)==before,"事件聚合从当时布局开始而不退回起姿");c.Advance(.5f,inputs.Target);Check(Vector3.Distance(c.ContactOrigin(1),new Vector3(5,4,1))<.0001f,"真实接触通知同一聚合过程");c.ConfirmContact(1,1);c.Advance(.5f,inputs.Target);Check(Vector3.Distance(c.ContactOrigin(1),new Vector3(7,4,1))<.0001f,"重复通知不会重新开始已接受的聚合");
var redirect=ConstructionEditing.Copy(basis);redirect.Root.Children[0].Operations=redirect.Root.Children[0].Operations.Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Gather,Seconds=.8f,Vector=new[]{-2f,1f,1f},When=new ConstructionCondition{Trigger=ConstructionChangeTrigger.Clash}}}).ToArray();c=Cast(redirect);c.Advance(.7f,inputs.Target);before=c.ContactOrigin(1);typeof(AbilityCast).GetMethod("ConfirmClash",Flags).Invoke(c,new object[]{1,before,3f});typeof(AbilityCast).GetMethod("ConsumeForce",Flags).Invoke(c,new object[]{1,3f});Check(c.ContactOrigin(1)==before,"交锋重新指定布局时从实际中途姿态继续");c.Advance(.8f,inputs.Target);Check(Vector3.Distance(c.ContactOrigin(1),new Vector3(1,5,1))<.0001f&&c.RemainingForce(1)==17,"后续聚合覆盖目标但不重置真实损耗");
var freed=ConstructionEditing.Copy(moving);freed.Root.Children[0].Operations=freed.Root.Children[0].Operations.Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Detach,At=1.4f}}).ToArray();c=Cast(freed);c.Advance(1.4f,inputs.Target);before=c.ContactOrigin(1);var velocity=c.Velocity(1);c.Advance(.2f,inputs.Target);Check(velocity.magnitude>1&&Vector3.Distance(c.ContactOrigin(1),before+velocity*.2f)<.0002f,"汇齐后的部件脱落继承整体移动和挂点转动的实际速度");
var stopped=ConstructionEditing.Copy(condition);stopped.Root.Children[0].OnContact=ConstructionContactResponse.Stop;c=Cast(stopped);c.Advance(.4f,inputs.Target);c.ConfirmContact(1,1);before=c.ContactOrigin(1);c.Advance(1.2f,inputs.Target);Check(c.ContactOrigin(1)==before,"真实停止解除连接后不会继续汇入或暗中重新接管");
var held=ConstructionEditing.Copy(basis);held.Root.Children[0].Form="water_wave";held.Root.Children[0].Matter="water";held.Root.Children[0].Hold=new ConstructionHold{At=1.1f,Seconds=.4f};held.Root.Children[0].Operations=held.Root.Children[0].Operations.Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Animate,Clip="break"}}).ToArray();c=Cast(held);c.Advance(1.2f,inputs.Target);Check(Vector3.Distance(c.ContactOrigin(1),new Vector3(7,4,1))<.0001f&&Mathf.Abs(c.ShapeAge(1)-1.1f)<.0001f,"内部姿态维持不拖慢完整部件的布局汇入");
var replay=Cast(redirect);replay.Advance(.5f,inputs.Target);typeof(AbilityCast).GetMethod("SaveStep",Flags).Invoke(replay,null);typeof(AbilityCast).GetMethod("ConfirmClash",Flags).Invoke(replay,new object[]{1,replay.ContactOrigin(1),3f});replay.Advance(.4f,inputs.Target);var replayPose=Sword(replay).Transform;typeof(AbilityCast).GetMethod("RestoreStep",Flags).Invoke(replay,null);typeof(AbilityCast).GetMethod("ConfirmClash",Flags).Invoke(replay,new object[]{1,replay.ContactOrigin(1),3f});replay.Advance(.4f,inputs.Target);Check(Sword(replay).Transform==replayPose,"共同预测回退恢复聚合局部布局及开始时点");
var faster=ConstructionMagnitudeEdits.Haste(basis,2);c=Cast(faster);c.Advance(.7f,inputs.Target);Check(Vector3.Distance(c.ContactOrigin(1),new Vector3(7,4,1))<.0001f,"急速改造改变聚合速度，目标布局保持不变");var longer=ConstructionMagnitudeEdits.Duration(basis,2);c=Cast(longer);c.Advance(1.4f,inputs.Target);Check(Vector3.Distance(c.ContactOrigin(1),new Vector3(5,4,1))<.0001f,"完整历时改造保持同阶段布局及转向");
var plain=ConstructionEditing.Copy(basis);plain.Root.Children[0].Operations=Array.Empty<ConstructionOperation>();Check(typeof(AbilityCast).GetField("gathers",Flags).GetValue(Cast(plain))==null,"普通施放不额外分配聚合状态");
var bad=ConstructionEditing.Copy(basis);bad.Root.Operations=bad.Root.Children[0].Operations;Reject(bad,"没有父结构的根部不能假装汇入");bad=ConstructionEditing.Copy(basis);bad.Root.Children[0].Operations[0].Seconds=0;Reject(bad,"零历时聚合在共同入口拒绝");bad=ConstructionEditing.Copy(basis);bad.Root.Children[0].Operations[0].GatherRotation=new[]{0f,float.NaN,0f};Reject(bad,"无效目标朝向在共同入口拒绝");bad=ConstructionEditing.Copy(basis);bad.Root.Children[0].Operations[0].Vector[0]=10001;Reject(bad,"过远布局在创建边界拒绝");bad=ConstructionEditing.Copy(basis);bad.Root.Children[0].Operations=bad.Root.Children[0].Operations.Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Detach,At=.5f}}).ToArray();Reject(bad,"计划脱落早于初始汇齐时明确拒绝");
var edges=Read("散刃汇轮");var wood=Read("散枝合木");Check(AbilityCompiler.Compile(edges).FormCount==33&&AbilityCompiler.Compile(wood).FormCount==4,"两种不同形体共用有限聚合操作及真实布局");
Config.paused=true;Game.Resume();Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;
var runnerType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=runnerType.GetProperty("Instance").GetValue(null);bool Boundary()=>(bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner);await Game.WaitUntil(Boundary,1800);
var stats=new BaseStats();stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.MotionHold").SetStats(stats).SetDuration(10000).Build();
void Place(Actor a,float x,float y){a.stopMovement();a.current_position=new Vector2(x,y);a.setCurrentTile(World.world.GetTileSimple((int)x,(int)y));a.updatePos();}
foreach(var a in World.world.units.getSimpleList().ToArray()){CombatStatusEffects.ApplyStatus(a,hold,10000,a);a.setStatsDirty();a.updateStats();Place(a,12,12);}
Actor Make(string name,int x,int y){var a=World.world.units.createNewUnit("human",World.world.GetTileSimple(x,y),pAdultAge:true,pSpawnWithItems:false);a.data.name=name;a.addTrait("super_health");CombatStatusEffects.ApplyStatus(a,hold,10000,a);a.setStatsDirty();a.updateStats();a.attack_timer=999;Place(a,x,y);return a;}
var actor=Make("阈值过程创造者",64,72);var first=Make("第一接触目标",72,72);var wolf=World.world.units.createNewUnit("wolf",World.world.GetTileSimple(12,12),pAdultAge:true);CombatStatusEffects.ApplyStatus(wolf,hold,10000,wolf);
foreach(var enemy in new[]{first}){enemy.setKingdom(wolf.kingdom);actor.addAggro(enemy);enemy.addAggro(actor);}var owner=actor.GetExtend();owner.AddComponent(new Xian{level=2,wakan=10000});

async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,1800);Config.paused=true;await Game.WaitUntil(Boundary,1800);}
var contacts=new List<ConstructedContact>();void Hit(ConstructedContact contact){if(contact.SourceId==actor.id)contacts.Add(contact);}ConstructedAbilityService.ContactConfirmed+=Hit;
try{foreach(var d in new[]{edges,wood}){ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(owner,d.Id);float balance=owner.GetCultisys<Xian>().wakan;Check(ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,d.Id),new ActiveAbilityTarget(first,first.GetSimPos()),ActiveAbilityUseOrigin.Script),d.Name+"通过正式已学入口施放");await Advance(d.Lifetime+.2f);Check(balance-owner.GetCultisys<Xian>().wakan==d.Cost,d.Name+"整体聚合及脱落只实际支付一次");Check(contacts.Any(h=>h.AbilityId==d.Id&&h.TargetId==first.id),d.Name+"由真实部件或主体实际接触目标");}}
finally{ConstructedAbilityService.ContactConfirmed-=Hit;Config.paused=true;}
var created=new List<AbilityDefinition>();for(int seed=0;seed<20;seed++)created.Add(ConstructionEditing.Access.Read(ConstructedAbilityService.Create(owner,seed)));bool HasGather(ConstructionNode n)=>n!=null&&(n.Operations.Any(o=>o.Kind==ConstructionOperationKind.Gather)||n.Children.Any(HasGather));Check(created.Any(d=>HasGather(d.Root)),"修士创作能够生成分散部件汇入布局的结构");
foreach(var unit in World.world.units.getSimpleList())foreach(var state in unit.GetExtend().GetStatuses().ToArray())if(state.GetComponent<Cultiway.Core.Components.StatusComponent>().Type.id==hold.id)unit.GetExtend().RemoveSharedStatus(state);
SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));var saves=Cultiway.ModClass.I.WorldSaves;File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,actor=actor.id,world=saves.World.Capture(World.world,"gather"),person=saves.Actors.Capture(owner,"gather")},Formatting.Indented));
var result=new{passed=true,checks,created=created.Count,gathered=created.Count(d=>HasGather(d.Root)),contacts=contacts.Select(h=>new{h.AbilityId,h.CastId,h.Node,h.TargetId,h.Age}).ToArray()};File.WriteAllText(Path.Combine(folder,"checks.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
