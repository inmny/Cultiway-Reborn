// 4.25 A：真实兵器接触架挡，错开落空，正常及换器后的控制归还。
var relations = new List<ConstructedBodyConnection>();
var actualContacts = new Dictionary<long, bool>();
var relationPoses = new List<object>();
/// <summary>保存真实关系事实，不序列化游戏对象。</summary>
/// <param name="fact">已经确认的状态变化。</param>
void Related(ConstructedBodyConnection fact)
{
    relations.Add(fact);
    object sourceRun = ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>()
        .FirstOrDefault(c => (long)Field(c, "Id") == fact.CastId);
    if (sourceRun != null && ((AbilityCast)Field(sourceRun, "Cast")).BodyPose is BodyPose sourcePose)
    {
        var sourceCast = (AbilityCast)Field(sourceRun, "Cast");
        var sourceFrame = (BodyFrame)Field(sourceCast, "bodyFrame");
        relationPoses.Add(new
        {
            fact.State, fact.Reason, sourceCast.Age, sourcePose.ActionAge, sourceFrame.PoseConstraint,
            sourceCast.Plan.Body.HasSupportMotion,
            underForces = ((Actor)Field(sourceRun, "Source")).under_forces,
            foot = new[] { sourcePose.Foot.x, sourcePose.Foot.y, sourcePose.Foot.z },
            shoulder = new[] { sourcePose.Shoulder.x, sourcePose.Shoulder.y, sourcePose.Shoulder.z },
            hand = new[] { sourcePose.Hand.x, sourcePose.Hand.y, sourcePose.Hand.z }
        });
        File.WriteAllText(Path.Combine(folder, "relation-poses.json"), JsonConvert.SerializeObject(relationPoses, Formatting.Indented));
    }
    if (fact.State == ConstructedBodyConnectionState.Active)
    {
        object running = ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>()
            .Single(c => (long)Field(c, "Id") == fact.CastId);
        var cast = (AbilityCast)Field(running, "Cast");
        var shapes = new List<AbilityCapsule>();
        bindingType.GetMethod("AppendContacts", F).Invoke(Field(running, "Body"), new object[] { cast.BodyPose.Value, shapes });
        object surface = service.GetMethod("BodySurfaceAt", F).Invoke(null, new object[] { fact.TargetId, fact.WorldTime });
        var find = surface.GetType().GetMethod("Find", F);
        actualContacts[fact.CastId] = shapes.Any(shape => (bool)find.Invoke(null,
            new object[] { surface, surface, shape, shape, "item", 0f, null, Vector3.zero }));
    }
    File.WriteAllText(Path.Combine(folder, "relations.json"), JsonConvert.SerializeObject(relations.Select(r => new
    {
        r.CastId, r.SourceId, r.TargetId, r.State, r.Reason, r.WorldTime, r.Until, r.Remaining,
        source = new[] { r.SourcePoint.x, r.SourcePoint.y, r.SourcePoint.z },
        target = new[] { r.TargetPoint.x, r.TargetPoint.y, r.TargetPoint.z }
    }), Formatting.Indented));
}
ConstructedAbilityService.BodyConnectionChanged += Related;
var quietStats = new BaseStats();
quietStats.addTag("frozen_ai");
var quiet = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.Verify.WeaponConnections.Quiet")
    .SetStats(quietStats).SetDuration(10000).Build();
var actors = new List<Actor>();
var observations = new List<object>();

/// <summary>本次施放结束后停止测试人物自行再出招，恢复检查只读取本次取得的控制。</summary>
/// <param name="fact">实际结束的施放。</param>
void Quieten(ConstructedCastEnded fact)
{
    if (!fact.AbilityId.StartsWith("test.body-footwork.weapon-connection.")) return;
    Actor actor = actors.FirstOrDefault(a => a.id == fact.SourceId);
    if (actor == null) return;
    CombatStatusEffects.ApplyStatus(actor, quiet, 10000, actor);
    actor.updateStats();
    actor.cancelAllBeh();
}
ConstructedAbilityService.CastEnded += Quieten;

/// <summary>仅准备一个现有持剑人，冻结自主行动但保留真实抗性和身体控制。</summary>
/// <param name="x">世界横向位置。</param>
Actor Swordsman(float x)
{
    Actor actor = Make(x);
    CombatStatusEffects.RemoveStatus(actor, hold);
    CombatStatusEffects.ApplyStatus(actor, quiet, 10000, actor);
    Item sword = World.world.items.generateItem(AssetManager.items.get("sword_iron"), pActor: actor);
    actor.equipment.setItem(sword, actor);
    actor.setStatsDirty();
    actor.updateStats();
    actors.Add(actor);
    return actor;
}

/// <summary>复用共用动作构造，架挡引用目标真实item而不是整个人物。</summary>
/// <param name="name">本轮稳定名称。</param><param name="guard">是否声明真实抵住。</param>
/// <param name="motion">本方实际制作手路。</param>
AbilityDefinition Definition(string name, bool guard, BodyActionKind motion = BodyActionKind.Guard)
{
    var definition = JsonConvert.DeserializeObject<AbilityDefinition>(
        File.ReadAllText(Path.Combine(root, "Content/Skills/Body/palm-strike.json")));
    definition.Id = "test.body-footwork.weapon-connection." + name;
    definition.Name = name;
    definition.Lifetime = 4f;
    definition.Cooldown = 0f;
    definition.Body = BodyActionGenerator.Create(new BodyActionRequest
    {
        Kind = guard ? motion : BodyActionKind.Thrust,
        Seconds = 4f, WeaponForm = "sword", Contact = guard ? "edge" : "tip"
    });
    definition.Body.Impact = new ConstructionImpact { DamageScale = guard ? 0f : .05f };
    definition.Body.MatchDistance = false;
    if (motion == BodyActionKind.Deflect)
    {
        // 手路略向身前收拢，让两把剑真实相遇，不扩大接触形状。
        definition.Body.Keys[1].Hand[1] -= .04f;
        definition.Body.Keys[2].Hand[1] -= .08f;
        definition.Body.Keys[3].Hand[1] -= .08f;
    }
    if (guard)
    {
        BodyPartInput target = definition.Body.Construction.Parts.Single(p => p.Subject == BodyPartSubject.Target);
        target.Part = "item";
        definition.Body.Construction.Relations.Single(r => r.Kind == BodyRelationKind.Touch).Kind = BodyRelationKind.Brace;
    }
    return definition;
}

/// <summary>按真实持物表面选择一个近身站位，不改变有效范围、抗性或正式动作。</summary>
/// <param name="source">架挡者。</param><param name="target">进攻者。</param>
/// <param name="guard">架挡构造。</param><param name="attack">进攻构造。</param>
void Position(Actor source, Actor target, AbilityDefinition guard, AbilityDefinition attack)
{
    CompiledAbility first = AbilityCompiler.Compile(guard, false), second = AbilityCompiler.Compile(attack, false);
    var surfaceType = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Skills.BodySurfacePose");
    var find = surfaceType.GetMethod("Find", F);
    for (int x = 23; x >= 0; x--)
    for (int y = -10; y <= 10; y++)
    {
        Place(target, 64.4f + x * .04f, 72f + y * .04f);
        Vector3 delta = (Vector3)(target.current_position - source.current_position);
        /// <summary>沿实际目标方向冻结正式动作使用的身体和真实器物。</summary>
        /// <param name="actor">实际身体。</param><param name="plan">已编译构造。</param>
        /// <param name="direction">实际平面方向。</param><param name="aim">正式目标。</param>
        object Bind(Actor actor, CompiledAbility plan, Vector3 direction, Actor aim) =>
            bindingType.GetMethod("TryCreate", F).Invoke(null,
                new object[] { actor, plan.Body, direction, aim.GetSimPos(),
                    service.Assembly.GetType("Cultiway.Content.Combat.SpatialActorPose").GetMethod("Height", F)
                        .Invoke(null, new object[] { aim }) });
        object left = Bind(source, first, delta.normalized, target),
            right = Bind(target, second, -delta.normalized, source);
        if (left == null || right == null) continue;
        BodyFrame from = Frame(left, source), to = Frame(right, target);
        for (int time = 0; time < 12; time++)
        {
            float age = first.Body.ActiveFrom + (first.Body.ActiveUntil - first.Body.ActiveFrom) * time / 12f;
            BodyPose a = first.Body.Sample(age, from), b = second.Body.Sample(Mathf.Max(0f, age - .5f), to);
            object surface = bindingType.GetMethod("ActionSurface", F).Invoke(right, new object[] { b });
            var shapes = new List<AbilityCapsule>();
            bindingType.GetMethod("AppendContacts", F).Invoke(left, new object[] { a, shapes });
            if (shapes.Any(shape => (bool)find.Invoke(null, new object[] { surface, surface, shape, shape, "item", 0f, null, Vector3.zero })))
            {
                Check(true, "从同一实际兵器表面取得可接触站位", new
                { position = new[] { target.current_position.x, target.current_position.y }, age });
                return;
            }
        }
    }
    Check(false, "现有双人场景中没有找到真实剑身接触站位");
}

try
{
    foreach (string sample in new[] { "normal", "miss", "replace" })
    {
        Actor source = Swordsman(64), target = Swordsman(65);
        await Advance(.2f);
        bool pressure = sample.StartsWith("deflect");
        var guard = Definition(sample + ".guard", true, sample == "deflect-withdraw" ? BodyActionKind.Deflect : BodyActionKind.Guard);
        var attack = Definition(sample + ".attack", false);
        if (pressure)
        {
            guard.Body.Construction.Relations.Single(r => r.Kind == BodyRelationKind.Brace).Kind = BodyRelationKind.Deflect;
            // 两种实际臂链的可达方向不同；三维沿可达方向上拨，不放宽接触或骨长。
            if (sample != "deflect-withdraw") guard.Body.Keys[3].Hand[2] += worldfall != null ? .12f : -.12f;
            var copied = JsonConvert.DeserializeObject<AbilityDefinition>(JsonConvert.SerializeObject(guard));
            var copiedPlan = AbilityCompiler.Compile(copied, false);
            Check(copiedPlan.Body.Construction.Relations.Any(r => r.Kind == BodyRelationKind.Deflect && r.ControlStrength > 0f),
                "拨压定义经过正式资料复制后仍保留真实控制关系");
            copied.Body.Construction.Relations.Single(r => r.Kind == BodyRelationKind.Deflect).Kind = BodyRelationKind.Brace;
            Check(copiedPlan.Measure.Work > AbilityCompiler.Compile(copied, false).Measure.Work,
                "带动兵器的拨压维持费用高于同条件静态架挡");
        }
        Position(source, target, guard, attack);
        Vector2 sourceStart = source.current_position;
        Vector2 targetStart = target.current_position;
        float initialHealth = source.data.health;
        CombatStatusEffects.RemoveStatus(source, quiet);
        source.updateStats();
        source.cancelAllBeh();
        await Fire(guard, source, target);
        await Advance(.5f);
        CombatStatusEffects.RemoveStatus(target, quiet);
        target.updateStats();
        target.cancelAllBeh();
        await Fire(attack, target, source);
        if (sample == "deflect-reach")
        {
            // 调换双方排列，约束仍须读取本步来源姿态，而不是依赖先遍历施力者。
            var list = (IList)service.GetField("casts", F).GetValue(null);
            object attacker = list.Cast<object>().Single(c => (long)Field(c, "SourceId") == target.id);
            list.Remove(attacker);
            list.Insert(0, attacker);
        }
        if (sample == "miss") Place(target, targetStart.x, targetStart.y + 3f);
        var running = ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>()
            .Where(c => (long)Field(c, "SourceId") == source.id || (long)Field(c, "SourceId") == target.id).ToArray();
        var first = (AbilityCast)Field(running.Single(c => (long)Field(c, "SourceId") == source.id), "Cast");
        var second = (AbilityCast)Field(running.Single(c => (long)Field(c, "SourceId") == target.id), "Cast");
        int begin = relations.Count;
        Config.paused = false;
        await Game.WaitUntil(() => relations.Count > begin || first.Finished || first.Age > first.Plan.Body.ActiveUntil, 900);
        Config.paused = true;
        await Game.WaitUntil(Boundary, 600);
        if (sample == "miss")
            Check(relations.Count == begin, "双方剑身错开时没有架挡关系");
        else
        {
            Check(relations.Count > begin && relations[begin].State == ConstructedBodyConnectionState.Active,
                sample + "正式施放在真实剑身接触时建立架挡", relations.Skip(begin).Select(r => new { r.State, r.Reason }).ToArray());
            var began = relations[begin];
            Check(actualContacts[began.CastId], sample + "确认时重新取样的真实剑身仍然接触");
            if (sample == "deflect-withdraw")
            {
                await Advance(.08f);
                Check(!ConstructedAbilityService.GetBodyConnections().Any(r => r.CastId == began.CastId) &&
                      relations.Any(r => r.CastId == began.CastId && r.State == ConstructedBodyConnectionState.Released && r.Reason == "Withdrawn"),
                    "横拨后收回时解除，不把拨压变成抓住拖拉");
            }
            else
            {
            Item sourceWeapon = source.getWeapon(), targetWeapon = target.getWeapon();
            BodyPose before = second.BodyPose.Value;
            float sourceAge = first.Age, targetAge = second.Age;
            float health = source.data.health;
            await Advance(Mathf.Max(.12f, second.Plan.Body.ActiveFrom - second.Age + .12f));
            var state = ConstructedAbilityService.GetBodyConnections().Single(r => r.CastId == began.CastId);
            Check(first.Age > sourceAge && second.Age >= second.Plan.Body.ActiveFrom && second.Age > targetAge && state.Remaining < began.Remaining &&
                  (pressure ? Vector3.Distance(before.Hand, second.BodyPose.Value.Hand) > .0005f :
                      Vector3.Distance(before.Hand, second.BodyPose.Value.Hand) < .0001f) &&
                  Vector3.Distance(state.SourcePoint, state.TargetPoint) < .0001f,
                sample + (pressure ? "双方时钟与预算推进，兵器及握持臂沿同一实际接触点移动" :
                    "双方时钟与预算推进，兵器及握持臂停在同一接触点"), new
                {
                    first.Age, targetAge = second.Age, firstBudget = began.Remaining, state.Remaining,
                    moved = Vector3.Distance(before.Hand, second.BodyPose.Value.Hand),
                    pointGap = Vector3.Distance(state.SourcePoint, state.TargetPoint)
                });
            if (pressure)
                Check(source.current_position == sourceStart && target.current_position == targetStart,
                    "拨压改变握持臂及兵器，不搬动双方脚下");
            Check(source.getWeapon() == sourceWeapon && target.getWeapon() == targetWeapon &&
                  sourceWeapon.getActor() == source && targetWeapon.getActor() == target &&
                  BodyControlState.IsBusy(source.id) && BodyControlState.IsBusy(target.id) && source.data.health == initialHealth &&
                  !contacts.Any(c => c.AbilityId == attack.Id && c.TargetId == source.id),
                sample + "原持有和原动作控制保留，来招没有穿过剑身补伤害");
            if (sample == "replace")
            {
                target.equipment.weapon.takeAwayItem();
                Item replacement = World.world.items.generateItem(AssetManager.items.get("sword_iron"), pActor: target);
                target.equipment.setItem(replacement, target);
                target.setStatsDirty();
                target.updateStats();
                await Advance(.08f);
                Check(!ConstructedAbilityService.GetBodyConnections().Any(r => r.CastId == began.CastId),
                    "目标换器立即解除旧兵器关系");
            }
            if (sample == "deflect-reach")
            {
                Place(target, targetStart.x + 3f, targetStart.y);
                await Advance(.04f);
                Check(!ConstructedAbilityService.GetBodyConnections().Any(r => r.CastId == began.CastId) &&
                      relations.Any(r => r.CastId == began.CastId && r.State == ConstructedBodyConnectionState.Released && r.Reason == "OutOfReach"),
                    "对方移出真实臂长后解除拨压，不拉长手臂或拖回人物");
            }
            observations.Add(new { sample, began.CastId, sourceAge, targetAge, health });
            }
        }
        await Advance(4.2f);
        Check(!BodyControlState.IsBusy(source.id) && !BodyControlState.IsBusy(target.id), sample + "结束后双方控制已归还");
        Place(source, 64f, 72f);
        Place(target, targetStart.x, targetStart.y);
        source.cancelAllBeh();
        target.cancelAllBeh();
        attack.Id += ".again";
        CombatStatusEffects.RemoveStatus(target, quiet);
        target.updateStats();
        await Fire(attack, target, source);
        Check(BodyControlState.IsBusy(target.id), sample + "原持有者能够重新取得真实兵器动作");
        await Advance(4.2f);
        foreach (Actor actor in new[] { source, target })
        {
            CombatStatusEffects.ApplyStatus(actor, hold, 10000, actor);
            Place(actor, 12, 12);
        }
    }
    File.WriteAllText(Path.Combine(folder, "observed.json"), JsonConvert.SerializeObject(observations, Formatting.Indented));
    return new { passed = true, closed = "指定兵器接触场景及结束后的真实控制恢复" };
}
finally
{
    ConstructedAbilityService.BodyConnectionChanged -= Related;
    ConstructedAbilityService.ContactConfirmed -= Hit;
    ConstructedAbilityService.CastEnded -= Ended;
    ConstructedAbilityService.CastEnded -= Quieten;
    Config.paused = true;
    ControllableUnit.clear(false);
}
