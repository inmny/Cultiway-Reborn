// 同一正式档，按旧时点核对实际对象、状态和资源。
owner.NewCultisys(Cultisyses.Magic);
source.equipment.setItem(World.world.items.generateItem(AssetManager.items.get("white_staff"), pActor: source), source);
owner.MarkCultiwayStatsDirty();
source.setStatsDirty();
source.updateStats();
var enemy = Make(70, "wolf");
enemy.setKingdom(enemyKingdom);
foreach (var ally in new[] { target, second, outside }) ally.setKingdom(source.kingdom);
foreach (var actor in new[] { source, target, second, outside, enemy })
{
    CombatStatusEffects.ApplyStatus(actor, hold, 10000, actor);
    actor.updateStats();
}
await Advance(.2f);

float[] Stats(Actor actor) => new[] { actor.stats["multiplier_damage"], actor.stats["armor"],
    actor.stats["multiplier_speed"], actor.stats["multiplier_attack_speed"] };
var actors = new[] { target, second, outside, enemy };
ConstructedAbilityService.CastStarted += Started;
try
{
    if (section != "area")
    {
        Ready(source);
        Place(source, 64);
        Place(enemy, 70);
        source.setMana(source.getMaxMana());
        int balance = source.getMana();
        Entity healingSkill = Learned().Single(item => item.GetComponent<SkillContainer>().Asset == SkillEntities.HealingLight);
        bool accepted = ActiveAbilityService.TryUse(owner, new ActiveAbilityHandle("core.learned_skill", healingSkill),
            new ActiveAbilityTarget(enemy, enemy.GetSimPos()), ActiveAbilityUseOrigin.Player);
        await Advance(.10f);
        Check(!accepted && source.getMana() == balance && casts.Count == 0,
            "拒绝用治愈之光指向敌人，原法力不扣除");
    }
    foreach (var entry in catalog)
    {
        var asset = entry.Asset;
        bool healing = asset == SkillEntities.HealingLight, bloom = asset == SkillEntities.RejuvenationField;
        bool cleanse = asset == SkillEntities.PurificationWave, area = bloom || cleanse;
        if (section == "area" && !area || section == "single" && area) continue;
        var status = bloom ? StatusEffects.Rejuvenating : asset == SkillEntities.BattleBlessing ? StatusEffects.BattleBlessing :
            asset == SkillEntities.GuardBlessing ? StatusEffects.GuardBlessing : StatusEffects.HasteBlessing;
        Entity skill = Learned().Single(item => item.GetComponent<SkillContainer>().Asset == asset);
        var animation = asset.GetAnimation(0);
        float frame = skill.GetComponent<SkillContainer>().MotionProfile.FrameInterval;
        float rise = Seconds(animation.Appearance, frame), fall = Seconds(animation.Dissipation, frame);
        float lifetime = bloom ? skill.GetComponent<RejuvenationModifier>().Duration : asset.ImpactProfile.Lifetime;
        float radius = area ? SkillEffectRadius.ResolveForCaster(owner, skill,
            asset.ImpactProfile.EffectRadius * asset.ImpactTuning.EffectRadiusMultiplier) : 0f;
        Vector3 point = new(70.5f, 72.5f, 0f);
        Ready(source);
        Place(source, 64, point.y);
        Place(target, point.x, point.y);
        Place(second, area ? point.x + radius - .035f : 67.5f, point.y);
        Place(outside, area ? point.x + radius + .035f : 71.5f, point.y);
        Place(enemy, point.x, point.y + .25f);
        foreach (Actor actor in actors.Append(source))
        {
            actor.data.health = actor.getMaxHealth() - 400;
            if (cleanse)
            {
                CombatStatusEffects.ApplyStatus(actor, StatusEffects.Freeze, 20f, source);
                actor.addStatusEffect(Cultiway.WorldboxGame.StatusEffects.SpellSilence, 20f);
            }
            ConstructedAbilityService.NotifyActorChanged(actor);
        }
        if (cleanse) Check(actors.All(actor => CombatStatusEffects.HasStatus(actor, StatusEffects.Freeze)),
            "净化对练的冰冻确实已施加");
        var health = actors.ToDictionary(actor => actor.id, actor => actor.data.health);
        target.updateStats();
        var attributes = Stats(target);
        source.setMana(source.getMaxMana());
        int mana = source.getMana(), count = casts.Count;
        double price = SkillCastResources.Mana.Quote(owner, SkillCastCost.CalculateStepDemand(skill) *
            Mathf.Sqrt(SkillEffectRadius.ResolveCasterGrowth(owner, skill)));
        Vector3 aim = area ? point : target.GetSimPos();
        var converter = service.Assembly.GetType("Cultiway.Content.Skills.SupportConstructionMigration").GetMethod("Convert", F);
        var definition = (AbilityDefinition)converter.Invoke(null, new object[] { new SkillEmission
        {
            SkillContainer = skill, Source = source, SpatialSource = source, Target = area ? null : target,
            SourcePos = source.GetSimPos(), TargetPos = aim, Strength = 100f
        } });
        var plan = AbilityCompiler.Compile(definition, cache: false);
        if (area)
        {
            // 两种范围术的旧成形只有一帧，用实际构造时间检查该帧，避免实机刷新越过它。
            var forming = new AbilityCast(plan, Matrix4x4.identity,
                inputs: new AbilityInputs(source.GetSimPos(), aim, Vector3.right, .8f));
            forming.Advance(rise * .5f, aim);
            Check(Views(forming).Any(view => view.Resource.Description.Id == entry.Form) &&
                ShapeCount(forming) == 0, "旧单帧成形可见，作用面尚未启用", asset.id);
        }
        Check(ActiveAbilityService.TryUse(owner, new ActiveAbilityHandle("core.learned_skill", skill),
            new ActiveAbilityTarget(target, aim, selectionArea: new SkillTargetSelectionArea(area, aim, .1f)),
            ActiveAbilityUseOrigin.Player), "旧学习资料正式受理", asset.id);
        source.attack_timer = 999;
        CombatStatusEffects.ApplyStatus(source, hold, 10000, source);
        source.updateStats();
        await Advance(.12f);
        int paid = mana - source.getMana();
        Check(paid == price, "只实际支付原法力", new { asset.id, paid, price });
        Check(casts.Count == count + 1,
            "只执行本次对应的一个载体", asset.id);
        var cast = casts.Last().Value;
        bool Changed(Actor actor) => healing ? actor.data.health > health[actor.id] :
            cleanse ? !CombatStatusEffects.HasStatus(actor, StatusEffects.Freeze) :
            CombatStatusEffects.HasStatus(actor, status);
        bool[] early = actors.Select(Changed).ToArray();
        Check(cleanse || early.All(changed => !changed),
            "成形期间的状态取样", new { asset.id, rise, early });
        if (!area)
        {
            Check(Views(cast).Any(view => view.Resource.Description.Id == entry.Form) && ShapeCount(cast) == 0,
                "从旧帧长取得可见成形，作用面尚未启用", asset.id);
        }
        if (bloom)
        {
            await Stage(cast, rise + .84f);
            Check(actors.All(actor => !Changed(actor)), "回春尚未到有效段的第一个整秒", asset.id);
            await Stage(cast, rise + 1.14f);
        }
        else if (cleanse)
        {
            await Stage(cast, rise + fall * .52f);
        }
        else
        {
            Place(target, 71.2f, 72.7f);
            ConstructedAbilityService.NotifyActorChanged(target);
            await Advance(1f);
        }

        bool[] changed = actors.Select(Changed).ToArray();
        target.updateStats();
        float[] deltas = Stats(target).Zip(attributes, (after, before) => after - before).ToArray();
        int restored = target.data.health - health[target.id];
        bool correctEffect = healing ? restored == skill.GetComponent<HealingModifier>().Amount :
            bloom || cleanse ? true :
            asset == SkillEntities.BattleBlessing ? Math.Abs(deltas[0] - skill.GetComponent<BattleBlessingModifier>().DamageBonus) < .0001f :
            asset == SkillEntities.GuardBlessing ? Math.Abs(deltas[1] - skill.GetComponent<GuardBlessingModifier>().ArmorBonus) < .0001f :
                Math.Abs(deltas[2] - skill.GetComponent<HasteBlessingModifier>().MoveSpeedBonus) < .0001f &&
                Math.Abs(deltas[3] - skill.GetComponent<HasteBlessingModifier>().AttackSpeedBonus) < .0001f;
        Check(changed.SequenceEqual(new[] { true, area, false, false }) && correctEffect &&
              (!cleanse || target.hasStatus(Cultiway.WorldboxGame.StatusEffects.SpellSilence.id)) &&
              actors.All(actor => actor.data.health >= health[actor.id]),
            "只改变正确的友方，属性或优先净化保持原值", new { asset.id, radius, changed, restored, deltas });
        long castId = casts.Last().Key;
        var hits = contacts.Where(hit => hit.CastId == castId).ToArray();
        float expectedHit = bloom ? rise + 1f : rise;
        Check(hits.Length == (area ? 2 : 1) && hits.All(hit => hit.Age >= rise - .001f && !hit.DamageAttempted) &&
              (!area || hits.All(hit => Math.Abs(hit.Age - expectedHit) < .002f)),
            "真实作用次数和时点，友方术不扣血",
            new { asset.id, expectedHit, hits = hits.Select(hit => new { hit.TargetId, hit.Age }).ToArray() });
        if (bloom)
        {
            int priorHealth = target.data.health;
            await Stage(cast, rise + 2.31f);
            Check(target.data.health > priorHealth && outside.data.health == health[outside.id] &&
                enemy.data.health == health[enemy.id], "回春确实恢复生命，场外和敌人不受益", asset.id);
            // 移开边内友军，保持同场最强状态的独立剩余时间，检查场到期后无续刷。
            Place(second, point.x + radius + .5f, point.y);
            ConstructedAbilityService.NotifyActorChanged(second);
        }
        await Stage(cast, cast.Plan.Lifetime + .12f);
        var ended = endings.Single(end => end.Fact.CastId == casts.Last().Key).Fact;
        var ticks = contacts.Where(hit => hit.CastId == ended.CastId && hit.TargetId == target.id).ToArray();
        bool timing = bloom ? ticks.Length == Mathf.CeilToInt(lifetime) - 1 :
            cleanse || ticks.Length == 1 && Math.Abs(ended.Age - ticks[0].Age - fall) < .07f;
        Check(cast.Finished && Views(cast).Length == 0 && ShapeCount(cast) == 0 && !ended.Cancelled && timing,
            "收势后自然清理显示和作用", asset.id);
        if (!healing && !cleanse)
            foreach (var actor in actors) CombatStatusEffects.RemoveStatus(actor, status);
        if (cleanse)
        {
            foreach (var actor in actors.Append(source))
            {
                CombatStatusEffects.RemoveStatus(actor, StatusEffects.Freeze);
                actor.finishStatusEffect(Cultiway.WorldboxGame.StatusEffects.SpellSilence.id);
            }
        }
        recordings.Add(new { asset = asset.id, entry.Form, rise, fall, radius, lifetime, paid, early, changed, restored, deltas });
    }
    return new { passed = true, process, spells = recordings.Count };
}
finally
{
    File.WriteAllText(Path.Combine(folder, "variants.json"), JsonConvert.SerializeObject(recordings, Formatting.Indented));
    ConstructedAbilityService.CastStarted -= Started;
    ConstructedAbilityService.ContactConfirmed -= Hit;
    ConstructedAbilityService.CastEnded -= Ended;
    ControllableUnit.clear(false);
    Config.paused = true;
}
