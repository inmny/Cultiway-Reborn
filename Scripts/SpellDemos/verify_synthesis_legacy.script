// 原样读取本批改动前保留的正式第二、三版请求；旧规则完成旧输入，不重抽当前规则。
using System;using System.IO;using System.Linq;using System.Collections.Generic;using System.Threading.Tasks;using Newtonsoft.Json;using Newtonsoft.Json.Linq;using Cultiway.Const;using Cultiway.Core;using Cultiway.Core.Skills;using Cultiway.Content.Skills;using Cultiway.Utils.Extension;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/synthesis");var checks=new List<string>();void Check(bool v,string n){if(!v)throw new InvalidOperationException(n);checks.Add(n);Log.Info(n);}JObject Canon(AbilityDefinition d){var j=JObject.Parse(JsonConvert.SerializeObject(d));j.Remove("Id");return j;}var runnerType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=runnerType.GetProperty("Instance").GetValue(null);async Task Boundary()=>await Game.WaitUntil(()=>(bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);async Task Advance(){Config.paused=false;double until=World.world.getCurWorldTime()+.15f;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;await Boundary();}bool enabled=GeneralSettings.EnableSkillSystems;
try{
if(Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.CreationRequestHold")==null){var stats=new BaseStats();stats.addTag("frozen_ai");stats.addTag("immovable");Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.CreationRequestHold").SetStats(stats).SetDuration(10000).Build();}
// 这些历史验证世界使用的测试功法本来由旧脚本临时注册，不属于发布内容。
if(Cultiway.Content.Libraries.Manager.CultibookLibrary.get("test.inspiration.water")==null)Cultiway.Content.Libraries.Manager.CultibookLibrary.add(new Cultiway.Content.Libraries.CultibookAsset{id="test.inspiration.water",Name="水法倾向检查",FinalStats=new BaseStats(),Semantics=Cultiway.Core.Semantics.SemanticDescriptor.Of(Cultiway.Core.Semantics.SkillSemantics.Element.Water)});
foreach(string fixture in new[]{"legacy-v2","legacy-derivation-v3"}){
var e=JObject.Parse(File.ReadAllText(Path.Combine(folder,fixture+"-expected.json")));GeneralSettings.SwitchSkillSystems(false);Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(folder,fixture));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();var owner=World.world.units.get((long)(e["actor"]??e["owner"])).GetExtend();var state=owner.GetComponent<ConstructedCreationState>();var access=ConstructionEditing.Access;var report=Cultiway.ModClass.I.WorldSaves.LastReport;int known=access.List(owner).Count;
Check(state.Pending&&state.Inspiration.Rules==1,fixture+"真正旧请求迁移为原有生成规则");Log.Info("旧档恢复报告："+JsonConvert.SerializeObject(new{report.Upgraded,skipped=report.Skipped.Count,examples=report.Skipped.Take(3),report.BackupError}));Check(report.Upgraded>0&&report.Skipped.Count==0&&report.BackupDirectory!=null&&report.BackupError==null,fixture+"逐版本升级保留原档且没有丢弃其他资料");if(e["source"]!=null)Check(JToken.DeepEquals(JObject.Parse(JsonConvert.SerializeObject(state.Source)),e["source"]),"旧衍生请求的完整原术快照保持");else Check(state.Source==null,"旧独立请求不临时补选当前已学原术");bool Same(AbilityDefinition d){var actual=Canon(d);var expected=(JObject)e["expected"].DeepClone();if(fixture=="legacy-v2"){actual.Remove("Name");expected.Remove("Name");if(d.Name!=ConstructionPresentation.Name(d,AbilityCompiler.Compile(d,false)))return false;}return JToken.DeepEquals(actual,expected);}var predicted=ConstructedAbilityService.Generate(owner,state.Seed,state.Inspiration,state.Source);Check(Same(predicted),fixture+"旧固定输入生成完整原定结果，名称和结构参数保持");GeneralSettings.SwitchSkillSystems(true);await Advance();state=owner.GetComponent<ConstructedCreationState>();Check(!state.Pending&&state.LastFailure==null&&state.Source==null&&access.List(owner).Count==known+1&&Same(access.Read(state.LastAbility)),fixture+"实际逻辑边界仅授予一次旧结果并释放临时快照");string completed=state.LastAbility;await Advance();Check(owner.GetComponent<ConstructedCreationState>().LastAbility==completed&&access.List(owner).Count==known+1,fixture+"后续更新不重放旧创法");
}
var result=new{passed=true,checks,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"legacy-result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{GeneralSettings.SwitchSkillSystems(enabled);}
