const BindingFlags F=BindingFlags.Instance|BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic;string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/world-scope");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new InvalidOperationException(n);checks.Add(n);Log.Info(n);}var rt=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=rt.GetProperty("Instance").GetValue(null);async Task Boundary()=>await Game.WaitUntil(()=>(bool)rt.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);bool clearing=false;async Task Advance(float sec){Config.paused=false;double end=World.world.getCurWorldTime()+sec;await Game.WaitUntil(()=>clearing||World.world.getCurWorldTime()>=end,3600);Config.paused=true;if(!clearing)await Boundary();}
Config.paused=true;Game.Resume();ControllableUnit.clear(false);Config.setWorldSpeed("x1",false);string fixture=Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1");World.world.save_manager.loadWorld(fixture);await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();World.world.console.Hide();foreach(var screen in Resources.FindObjectsOfTypeAll<LoadingScreen>())screen.gameObject.SetActive(false);foreach(var old in World.world.units.getSimpleList().ToArray())old.dieAndDestroy(AttackType.Other);for(int y=60;y<=100;y++)for(int x=40;x<=110;x++){var t=World.world.GetTileSimple(x,y);if(t.building!=null)t.building.removeBuildingFinal();t.setTileTypes(TileLibrary.soil_low,TopTileLibrary.grass_low);}
var hs=new BaseStats();hs.addTag("frozen_ai");hs.addTag("immovable");var hold=Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.WorldScopeHold")??Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.WorldScopeHold").SetStats(hs).SetDuration(10000).Build();Actor Make(int x,int y){var a=World.world.units.createNewUnit("human",World.world.GetTileSimple(x,y),pAdultAge:true,pSpawnWithItems:false);a.addTrait("super_health");CombatStatusEffects.ApplyStatus(a,hold,10000,a);a.setStatsDirty();a.updateStats();return a;}var actor=Make(60,72);var rival=Make(90,90);var owner=actor.GetExtend();owner.AddComponent(new Xian{level=2,wakan=200});owner.MarkCultiwayStatsDirty();await Advance(.1f);City CityFor(Actor a){a.joinLanguage(World.world.languages.newLanguage(a,true));a.setCulture(World.world.cultures.newCulture(a,true));World.world.kingdoms.makeNewCivKingdom(a);var city=World.world.cities.buildNewCity(a,a.current_tile.zone);a.joinCity(city);return city;}bool originalBuild=DebugConfig.isOn(DebugOption.SystemBuildTick);DebugConfig.setOption(DebugOption.SystemBuildTick,false);var city=CityFor(actor);var other=CityFor(rival);for(int y=70;y<=86;y+=2)for(int x=60;x<=78;x+=2)city.addZone(World.world.GetTileSimple(x,y).zone);city.recalculateNeighbourZones();var cityFactory=typeof(ConstructedAbilityService).Assembly.GetType("Cultiway.Content.CollectiveProjects.CityConstructionWorldScope").GetMethod("Create",F);ConstructionWorldScope CityScope(Func<bool> valid)=>(ConstructionWorldScope)cityFactory.Invoke(null,new object[]{city.id,valid});
AbilityDefinition Def(string name,float lifetime=.8f)=>new(){Id="test.world-scope."+name,Name="任务边界·"+name,Resource="wakan",Cost=3,Cooldown=0,Lifetime=lifetime,TargetRange=100,Power=0,Use=new ConstructionUse{Channels=ActiveAbilityChannel.World,Target=ActiveAbilityTargetMode.Point},Impact=new ConstructionImpact{DamageScale=0,WorldEffects=new[]{new ConstructionWorldEffect{Action="land.cleanse"}}},Root=new ConstructionNode{Id="surface",Form="sword",Matter="iron",Rotation=new[]{0f,90f,0f},ActiveFrom=.1f}};
void Dirty(int row){for(int x=63;x<=69;x++){var t=World.world.GetTileSimple(x,row);if(t.building!=null)t.building.removeBuildingFinal();t.setTileTypes(TileLibrary.soil_low,TopTileLibrary.grass_low);t.burned_stages=2;}}
bool Cast(AbilityDefinition d,int row,ConstructionWorldScope scope,long correlation=0,float height=0){ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(owner,d.Id);return ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,d.Id),new ActiveAbilityTarget(null,new Vector3(64.5f,row+.5f,height),runtimeData:new SkillCastRuntimeData{CorrelationId=correlation},worldScope:scope),ActiveAbilityUseOrigin.Script);}
var starts=new List<ConstructedCastStarted>();var ends=new List<ConstructedCastEnded>();var contacts=new List<ConstructedWorldContact>();bool valid=true,transfer=false,chain=false;AbilityDefinition follow=null;void Started(ConstructedCastStarted e){if(e.SourceId==actor.id)starts.Add(e);}void Contact(ConstructedWorldContact e){if(e.SourceId!=actor.id)return;contacts.Add(e);if(e.AbilityId.EndsWith(".cancel")&&e.Result.Changed)valid=false;if(transfer&&e.AbilityId.EndsWith(".city")&&e.Result.Changed){transfer=false;other.addZone(World.world.GetTileSimple(e.X,e.Y).zone);}}void Ended(ConstructedCastEnded e){if(e.SourceId!=actor.id)return;ends.Add(e);Check(!((IEnumerable)typeof(ConstructedAbilityService).GetField("casts",F).GetValue(null)).Cast<object>().Any(r=>(long)r.GetType().GetField("Id",F).GetValue(r)==e.CastId),"结束事实发布前实际施放已移除："+e.CorrelationId);if(chain&&e.AbilityId.EndsWith(".chain")){chain=false;Check(Cast(follow,86,null,106),"结束回调可正式启动另一独立施放");}if(e.AbilityId.EndsWith(".clear")){clearing=true;World.world.clearWorld();}}
ConstructedAbilityService.CastStarted+=Started;ConstructedAbilityService.CastEnded+=Ended;ConstructedAbilityService.WorldContactConfirmed+=Contact;try{
var scoped=Def("scoped");scoped.Impact.WorldEffects=scoped.Impact.WorldEffects.Concat(new[]{new ConstructionWorldEffect{Action="nature.grow"}}).ToArray();Dirty(72);var only=new ConstructionWorldScope(()=>true,(action,t)=>action=="land.cleanse"&&(t.pos.x==64||t.pos.x==66));Check(Cast(scoped,72,only,101),"正式入口接受只属于本次行动的边界");await Advance(1);var sc=contacts.Where(e=>e.AbilityId==scoped.Id).ToArray();Check(sc.Length==2&&sc.All(e=>e.Result.Changed&&e.Action=="land.cleanse"&&(e.X==64||e.X==66)),"真实形状与任务条件共同决定地块和原理，不能扩大或夹带另一世界作用");Check(World.world.GetTileSimple(65,72).burned_stages>0&&World.world.GetTileSimple(67,72).burned_stages>0,"被排除的实际地块保持污染");var end=ends.Single(e=>e.AbilityId==scoped.Id);Check(!end.Cancelled&&end.WorldChanges==2&&end.CorrelationId==101&&starts.Single(e=>e.AbilityId==scoped.Id).CorrelationId==101,"开始和实际结束对应同一任务，变化数来自真实提交");await Advance(.3f);Check(ends.Count(e=>e.AbilityId==scoped.Id)==1,"后续帧不重复发出结束事实");
var denied=Def("denied");float before=owner.GetComponent<Xian>().wakan;Check(!Cast(denied,74,new ConstructionWorldScope(()=>false,(a,t)=>true),102),"受理前失效的任务直接拒绝");Check(owner.GetComponent<Xian>().wakan==before&&!starts.Any(e=>e.AbilityId==denied.Id)&&!ends.Any(e=>e.AbilityId==denied.Id),"拒绝不支付，也不伪造开始或完成");
Dirty(74);var cancel=Def("cancel",2);valid=true;Check(Cast(cancel,74,new ConstructionWorldScope(()=>valid,(a,t)=>true),103),"受理仍有效的可取消世界行动");await Advance(.5f);var cancelled=ends.Single(e=>e.AbilityId==cancel.Id);Check(cancelled.Cancelled&&cancelled.Age<.2f&&cancelled.WorldChanges==1&&contacts.Count(e=>e.AbilityId==cancel.Id)==1,"接触回调使任务失效后同一轮停止后续作用并报告真实取消");Check(Enumerable.Range(64,4).Count(x=>World.world.GetTileSimple(x,74).burned_stages==0)==1,"取消保留已经确认的一个永久结果，其他地块未继续清理");
Dirty(74);var material=Def("material.cancel",1);material.Root.Children=new[]{new ConstructionNode{Id="pending-metal",Form="sword",Matter="iron",Offset=new[]{0f,2f,0f},Impact=new ConstructionImpact{DamageScale=0,WorldEffects=Array.Empty<ConstructionWorldEffect>()},Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Leave,At=.1f,Residue=new ConstructionResidue{Lifetime=10}}}}};valid=true;int materialBefore=WorldMaterialService.Count;Check(Cast(material,74,new ConstructionWorldScope(()=>valid,(a,t)=>true),111),"受理同一时点带有待转交材料的世界行动");await Advance(.5f);Check(ends.Single(e=>e.AbilityId==material.Id).Cancelled&&ends.Single(e=>e.AbilityId==material.Id).WorldChanges==1,"材料转交前的真实接触可以使本次行动取消");Check(WorldMaterialService.Count==materialBefore,"取消后不继续提交同一时点尚未确认的世界材料");
Dirty(76);var simultaneous=Def("parallel");Check(Cast(simultaneous,76,new ConstructionWorldScope(()=>true,(a,t)=>t.pos.x==64),104)&&Cast(simultaneous,76,new ConstructionWorldScope(()=>true,(a,t)=>t.pos.x==67),105),"同一人物同一构造允许两个不同任务同时存在");await Advance(1);Check(ends.Where(e=>e.AbilityId==simultaneous.Id).Select(e=>e.CorrelationId).OrderBy(x=>x).SequenceEqual(new long[]{104,105})&&ends.Where(e=>e.AbilityId==simultaneous.Id).All(e=>e.WorldChanges==1),"并行施放边界及完成事实不串到另一任务");
Dirty(78);var nativeCity=Def("city");city.addZone(World.world.GetTileSimple(65,78).zone);city.recalculateNeighbourZones();transfer=true;Check(Cast(nativeCity,78,CityScope(()=>true),107),"原版城市的动态归属约束进入相同正式施放");await Advance(1);Check(contacts.Count(e=>e.AbilityId==nativeCity.Id&&e.Result.Changed)==1&&World.world.GetTileSimple(65,78).zone.city==other,"施放中领地转给另一城市后剩余地块不再作用");city.addZone(World.world.GetTileSimple(65,78).zone);city.recalculateNeighbourZones();
for(int y=80;y<=84;y++)for(int x=63;x<=74;x++){var t=World.world.GetTileSimple(x,y);if(t.building!=null)t.building.removeBuildingFinal();t.setTileTypes(TileLibrary.soil_low,TopTileLibrary.grass_low);}var grow=Def("grow",1.2f);grow.Root.ActiveFrom=.4f;grow.Impact.WorldEffects=new[]{new ConstructionWorldEffect{Action="nature.grow",Contact=new ConstructionContactPolicy{Mode=ConstructionContactMode.Interval,Interval=.1f}}};Check(Cast(grow,82,CityScope(()=>true),108),"受理时允许普通构造进入城市植被工作");await Advance(.1f);var mill=World.world.buildings.addBuilding("windmill_human_0",World.world.GetTileSimple(72,80));await Advance(.1f);CityBehCheckFarms.check(city);Check(city.calculated_place_for_farms.Contains(World.world.GetTileSimple(65,82)),"原版风车在施放期间实际规划出预留农田");await Advance(1.2f);Check(!contacts.Any(e=>e.AbilityId==grow.Id)&&!World.world.GetTileSimple(65,82).hasBuilding(),"接触使用最新原版农田保护，不能占用新规划农田");var ordinary=Def("ordinary",1.2f);ordinary.Impact.WorldEffects=grow.Impact.WorldEffects;Check(Cast(ordinary,82,null,109),"同一普通原理没有任务约束时保持正常使用");await Advance(1.4f);Check(contacts.Any(e=>e.AbilityId==ordinary.Id&&e.Result.Changed),"无约束施放仍能真正生成原版植被，不是世界操作整体失效");
follow=Def("follow",.2f);follow.Resource="none";follow.Cost=0;var first=Def("chain",.2f);chain=true;Check(Cast(first,86,null,110),"受理用于检查结束回调的普通施放");await Advance(.8f);Check(ends.Any(e=>e.AbilityId==follow.Id&&e.CorrelationId==106),"结束回调新建的施放继续正常推进和结束");
var pending=Def("pending",10);Check(Cast(pending,84,new ConstructionWorldScope(()=>true,(a,t)=>false),500,5),"保存时存在仍未结束的旧任务施放");await Advance(.1f);var save=SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));Check(save.actors_data.Any(a=>a.id==actor.id),"正式保存包含实际来源和已学构造");var saves=Cultiway.ModClass.I.WorldSaves;File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,actor=actor.id,city=city.id,world=saves.World.Capture(World.world,"world-scope"),person=saves.Actors.Capture(owner,"world-scope"),ability=pending.Id},Formatting.Indented));
var clear=Def("clear",.2f);Check(Cast(clear,86,null,501),"结束回调允许触发真实世界清理");await Advance(1);Check(clearing&&!ends.Any(e=>e.AbilityId==pending.Id),"真正换世界不为未完成旧任务补发结束或完成");World.world.save_manager.loadWorld(fixture);await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();var result=new{passed=true,checks,starts,ends,contacts,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{File.WriteAllText(Path.Combine(folder,"partial.json"),JsonConvert.SerializeObject(new{checks,starts,ends,contacts},Formatting.Indented));ConstructedAbilityService.CastStarted-=Started;ConstructedAbilityService.CastEnded-=Ended;ConstructedAbilityService.WorldContactConfirmed-=Contact;DebugConfig.setOption(DebugOption.SystemBuildTick,originalBuild);Config.paused=true;}
