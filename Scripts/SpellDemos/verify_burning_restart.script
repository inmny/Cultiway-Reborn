// 真正冷启动保留燃烧中的世界材料，旧二版材料迁移后保持冷态。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using Cultiway.Core.Skills;
using Cultiway.Content.Skills;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Static|BindingFlags.Instance;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/burning");var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}Check((int)expected["process"]!=System.Diagnostics.Process.GetCurrentProcess().Id,"保存与恢复来自两个真实游戏进程");async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;var t=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=t.GetProperty("Instance").GetValue(null);await Game.WaitUntil(()=>(bool)t.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);}
Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;var saves=Cultiway.ModClass.I.WorldSaves;JObject Archive()=>JObject.Parse(saves.World.Capture(World.world,"burning"));JArray Rows()=> (JArray)Archive()["sections"]["world_materials"]["data"]["Records"];var old=JObject.Parse((string)expected["world"]);var before=Rows();Check(saves.LastReport.Skipped.Count==0&&saves.LastReport.BackupError==null,"燃烧保存恢复无资料丢弃或备份失败");Check((int)Archive()["sections"]["world_materials"]["version"]==4&&JToken.DeepEquals(before,old["sections"]["world_materials"]["data"]["Records"]),"燃料、热量、原来源、剩余支付和真实形状完整恢复");Check(((IList)typeof(ConstructedAbilityService).GetField("casts",F).GetValue(null)).Count==0,"不重建已结束火施放或重新支付");Check(before.Single()["Material"]["Burning"].Value<bool>("Lit"),"保存时已燃烧的木体保持原燃烧过程");
var stats=new BaseStats();stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.BurningRestartHold").SetStats(stats).SetDuration(10000).Build();foreach(var p in World.world.units.dict.Values.ToArray())Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(p,hold,10000,p);var events=new List<ConstructedBurning>();void Burn(ConstructedBurning e)=>events.Add(e);ConstructedAbilityService.BurningConfirmed+=Burn;
try{await Advance(.3f);var current=Rows().Single()["Material"];Check((double)current["Volume"]<(double)before.Single()["Material"]["Volume"]&&(double)current["Burning"]["Burned"]>(double)before.Single()["Material"]["Burning"]["Burned"],"恢复后继续消耗剩余燃料而非重新补满");Check(events.Count>0&&events.All(e=>e.Kind=="burn"&&e.WorldId>0),"恢复后只有实际新烧损，没有重放旧点火或伪造施放");Check(events.All(e=>e.Source==(long)expected["actor"]),"继续燃烧仍保留原点火来源");await Advance(4f);Check(WorldMaterialService.Count==0,"剩余燃料烧尽后独立主体实际结束，不无限燃烧");Check(events.Any(e=>e.Kind=="burn"&&e.Volume==0&&e.Burned>0),"最后一次烧尽保留真实损耗结果");
var legacy=Path.Combine(root,"artifacts/skill_rebuild/quenching/native-save/save");World.world.save_manager.loadWorld(legacy);await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;var migrated=Archive();Check((int)migrated["sections"]["world_materials"]["version"]==4&&saves.LastReport.Upgraded==1&&saves.LastReport.Skipped.Count==0&&saves.LastReport.BackupError==null&&Directory.Exists(saves.LastReport.BackupDirectory),"正式第二版水体经转换进入第四版，原档已自动备份且没有资料丢弃");Check(Rows().All(r=>r["Material"]["Burning"]==null||r["Material"]["Burning"].Type==JTokenType.Null),"旧材料没有被凭空赋予热量或火焰");var result=new{passed=true,checks,savedProcess=(int)expected["process"],process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"restart.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{ConstructedAbilityService.BurningConfirmed-=Burn;Config.paused=true;}
