// 凝固清除实际内部动量，连续固态换材、预测、留存及串并行保持一致。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using Newtonsoft.Json;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Core.Visuals.Forms;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/solidification");Directory.CreateDirectory(folder);
var checks=new List<string>();void Check(bool value,string name){if(!value)throw new Exception(name);checks.Add(name);}
object Call(object obj,string name,params object[] args)=>obj.GetType().GetMethod(name,F).Invoke(obj,args);
ConstructionOperation Convert(float at,string matter,string state)=>new(){Kind=ConstructionOperationKind.ConvertMatter,At=at,Matter=matter,State=state};
AbilityDefinition Definition()=>new(){Id="test.solidification",Resource="none",Cost=0,Lifetime=3,Root=new ConstructionNode{Id="body",Form="water_flow",Matter="water",Volume=12,Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Flow,Flow=new ConstructionFlow{Cells=16,Size=24,Gravity=0,Drag=0,Evaporation=0,OpenBoundary=false}},Convert(.2f,"water","solid"),Convert(.4f,"iron","solid"),Convert(.6f,"wood","solid"),Convert(.8f,"water","liquid")}}};
AbilityCast Cast(AbilityDefinition d)=>new(AbilityCompiler.Compile(d),Matrix4x4.identity,inputs:new AbilityInputs(new Vector3(64,72),new Vector3(72,72),Vector3.right,1),force:20,paidResource:8);
object Flow(AbilityCast cast)=>((Array)typeof(AbilityCast).GetField("flows",F).GetValue(cast)).GetValue(0);
Vector3[] Water(object flow)=>(Vector3[])flow.GetType().GetField("Water",F).GetValue(flow);
Vector3 Velocity(object flow)=>(Vector3)flow.GetType().GetField("Velocity",F).GetValue(flow);
AbilityMaterialData Material(AbilityCast cast)=>(AbilityMaterialData)Call(Call(cast,"CaptureMaterial",0),"Capture");
FormVisualInstance View(AbilityCast cast){var list=new List<FormVisualInstance>();cast.AppendVisuals(list);return list.Single();}
var cast=Cast(Definition());var flow=Flow(cast);Call(flow,"SetVelocity",new Vector3(4,-2,0));cast.Advance(.15f,Vector3.zero);var before=Water(flow).ToArray();double volume=cast.RemainingVolume(0),resource=cast.RemainingResource(0);Check(before.Any(v=>v.y!=0||v.z!=0),"凝固前存在真实各格动量");
Call(cast,"SaveStep");cast.Advance(.05f,Vector3.zero);Check(cast.IsShapeHeld(0)&&cast.Matter(0).State=="solid","准确在定时时点凝固");Check(Water(flow).All(v=>v.y==0&&v.z==0)&&Velocity(flow)==Vector3.zero,"凝固清除各格和主体平均动量，不只暂停");Check(Math.Abs(cast.RemainingVolume(0)-volume)<.0001&&cast.RemainingResource(0)==resource&&cast.RemainingForce(0)==20,"凝固不改变体积、支付份额或攻击余力");var frozen=Material(cast);Check(frozen.Flow.Bed!=null&&frozen.Flow.Water.Where((_,i)=>i%3!=0).All(v=>v==0),"凝固后的留存输入保存真实基底和零动量");
var expected=Water(flow).ToArray();Call(cast,"RestoreStep");Check(!cast.IsShapeHeld(0)&&Water(flow).SequenceEqual(before),"预测回退恢复冻结前所有水格和动量");cast.Advance(.05f,Vector3.zero);Check(Water(flow).SequenceEqual(expected),"回退后同一凝固重放完全一致");
cast.Advance(.25f,Vector3.zero);Check(cast.Matter(0).Id=="iron"&&cast.IsShapeHeld(0)&&Water(flow).SequenceEqual(expected),"凝固后改成金属仍保持原形和零动量");cast.Advance(.2f,Vector3.zero);Check(cast.Matter(0).Id=="wood"&&cast.IsShapeHeld(0)&&Water(flow).SequenceEqual(expected),"后续再换固态木质不会无故恢复流动");cast.Advance(.3f,Vector3.zero);Check(cast.Matter(0).State=="liquid"&&!cast.IsShapeHeld(0)&&Water(flow).All(v=>v.y==0&&v.z==0),"解冻从当前零动量继续，不找回旧冲势");Check(cast.RemainingResource(0)==resource&&Math.Abs(cast.RemainingVolume(0)-volume)<.0001,"连续换材不复制或退还材料支付");
var born=Definition();born.Root.Matter="ice";born.Root.Operations=born.Root.Operations.Take(1).ToArray();born.Root.Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Fly,Vector=new[]{4f,0f,0f},WorldVelocity=true,InheritVelocity=false},born.Root.Operations[0]};var initialIce=Cast(born);Check(initialIce.IsShapeHeld(0)&&Water(Flow(initialIce)).All(v=>v.y==0&&v.z==0)&&Velocity(Flow(initialIce))==Vector3.zero,"已经定形的材料进入流散也不会保留初始内部速度");
var body=Definition();body.Root.Form="water_wave";body.Root.Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Animate,Clip="break"},Convert(.2f,"water","solid"),Convert(.4f,"iron","solid"),Convert(.6f,"wood","solid"),Convert(.8f,"water","liquid")};var rigid=Cast(body);rigid.Advance(.2f,Vector3.zero);float shapeAge=rigid.ShapeAge(0);var skin=View(rigid).Skin;rigid.Advance(.5f,Vector3.zero);Check(rigid.IsShapeHeld(0)&&rigid.ShapeAge(0)==shapeAge&&View(rigid).Skin.Zip(skin,(a,b)=>a==b).All(v=>v),"非流散形体的连续固态转换也保持真实姿态");rigid.Advance(.3f,Vector3.zero);Check(!rigid.IsShapeHeld(0)&&rigid.ShapeAge(0)>shapeAge,"变回液态后内部动画从原进度继续");
var articulated=Definition();articulated.Root.Form="water_wave";articulated.Root.Matter="iron";articulated.Root.Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Animate,Clip="break"},Convert(.2f,"wood","solid")};var joints=Cast(articulated);joints.Advance(.5f,Vector3.zero);Check(!joints.IsShapeHeld(0)&&joints.ShapeAge(0)>.49f,"原本可动的固态关节不因普通固态换材而锁死");
var worldCast=Cast(Definition());worldCast.Advance(.2f,Vector3.zero);var material=Call(worldCast,"CaptureMaterial",0);var data=(AbilityMaterialData)Call(material,"Capture");var restore=typeof(AbilityMaterial).GetMethod("Restore",F);var restored=(AbilityMaterial)restore.Invoke(null,new object[]{data});Call(restored,"Advance",.3f,null);var saved=(AbilityMaterialData)Call(restored,"Capture");Check(JsonConvert.SerializeObject(data)==JsonConvert.SerializeObject(saved),"凝固材料独立保存恢复后仍保持全部水格、基底及支付");var thawed=(AbilityMaterial)Call(restored,"ConvertTo",AbilityMatters.Resolve("water","liquid","test"),null);Check(((AbilityMaterialData)Call(thawed,"Capture")).Flow.Water.Where((_,i)=>i%3!=0).All(v=>v==0),"独立材料解冻同样从零内部动量开始");
var poolType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.SimulationWorkerPool");var pool=poolType.GetProperty("Instance",F).GetValue(null);var run=poolType.GetMethod("RunIndexed",F);var reports=new List<object>();
foreach(int count in new[]{32,128}){var plan=AbilityCompiler.Compile(Definition());AbilityCast Make(){var value=new AbilityCast(plan,Matrix4x4.identity);Call(Flow(value),"SetVelocity",new Vector3(4,-2,0));return value;}var serial=Enumerable.Range(0,count).Select(_=>Make()).ToArray();var parallel=Enumerable.Range(0,count).Select(_=>Make()).ToArray();foreach(float time in new[]{.15f,.05f,.25f,.2f,.3f}){foreach(var value in serial)value.Advance(time,Vector3.zero);Action<int> step=i=>parallel[i].Advance(time,Vector3.zero);run.Invoke(pool,new object[]{0,count,step});}Check(serial.Select(value=>JsonConvert.SerializeObject(Material(value))).SequenceEqual(parallel.Select(value=>JsonConvert.SerializeObject(Material(value)))),"凝固、固态换材及复流在实际工作池与串行一致："+count);reports.Add(new{count,error=0});await Game.NextFrame();}
var result=new{passed=true,checks,reports,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"math.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
