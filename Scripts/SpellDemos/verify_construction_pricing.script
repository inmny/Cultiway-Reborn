// 3.09：真实结构统计、计算默认值、改造需求、正式支付与保存规则。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Core;
using Cultiway.Content;
using Cultiway.Core.Persistence;
using Cultiway.Core.SkillLibV3;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Usage;
using Cultiway.Core.Visuals.Forms;
using Cultiway.Content.Components;
using Cultiway.Content.Skills;
using Cultiway.Utils.Extension;

const BindingFlags Flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static | BindingFlags.Instance;
string root = Cultiway.ModClass.I.GetDeclaration().FolderPath, folder = Path.Combine(root, "artifacts/skill_rebuild/construction-pricing"); Directory.CreateDirectory(folder);
var checks = new List<object>(); void Check(bool pass, string name, object evidence = null) => checks.Add(new { pass, name, evidence });
bool Near(double a, double b) => Math.Abs(a - b) < .0001 * Math.Max(1, Math.Abs(b));
AbilityDefinition Basic() => new() { Id = "test.pricing.base", Lifetime = 2, Cost = 2, Cooldown = 1, Resource = "wakan", Root = new ConstructionNode { Id = "blade", Form = "sword", ContactGroup = "blade" } };
ConstructionMeasure Measure(AbilityDefinition d) => AbilityCompiler.Compile(d, false).Measure;
var source = Basic(); string unchanged = JsonConvert.SerializeObject(source); var basis = Measure(source); Check(basis.Materials == 1 && basis.Volume == 1 && basis.VolumeSeconds == 2 && basis.ContactGroups == 1, "同一编译计划统计真实材料、存在秒数和独立接触组");
var large = ConstructionMagnitudeEdits.Resize(source, 2); var big = Measure(large); Check(big.Volume == 8 && large.Cost > source.Cost && Near(large.Cost / source.Cost, big.Work / basis.Work), "放大按实际体积及作用预算增加需求，不再免费扩大"); Check(large.Cooldown > source.Cooldown && Near(large.Cooldown / source.Cooldown, Math.Sqrt(big.Work / basis.Work)), "改造恢复时间随规模计算，实际身体收势仍独立执行");
var repeated = ConstructionMagnitudeEdits.Repeat(source, 3, 1, .4f); var copies = Measure(repeated); Check(copies.Materials == 3 && copies.Volume == 3 && copies.VolumeSeconds == 6 && copies.ContactGroups == 3 && Near(repeated.Cost, 6), "三份完整主体按各自存在窗口计量，组织支点不额外收费"); Check(repeated.Lifetime == 2.8f && Near(repeated.Cooldown, Math.Sqrt(3)), "错时显现保留整次寿命与单次恢复预算");
var longer = ConstructionMagnitudeEdits.Duration(source, 2); var sustained = ConstructionMagnitudeEdits.Sustain(source, 1); Check(longer.Cost > source.Cost && sustained.Cost > source.Cost && Measure(longer).VolumeSeconds == 4 && Measure(sustained).VolumeSeconds == 3, "伸缩和维持都计算实际材料持续，不只增加容器时间");
var moving = Basic(); moving.Root.Operations = new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Fly, Vector = new[] { 2f, 0, 0 }, InheritVelocity = false } }; var faster = ConstructionMagnitudeEdits.Haste(moving, 2); Check(faster.Cost > moving.Cost && Measure(faster).Work > Measure(moving).Work, "更快运动计算控制预算");
var curve = Basic(); curve.Root.Operations = new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Fly, Path = new ConstructionPath { Keys = new[] { new ConstructionPathKey(), new ConstructionPathKey { At = 4, Point = new[] { 8f, 0, 0 } } } } } }; var split = ConstructionEditing.Copy(curve); split.Root.Operations[0].Path.Keys = new[] { new ConstructionPathKey(), new ConstructionPathKey { At = 2, Point = new[] { 4f, 0, 0 }, In = new[] { -2f, 0, 0 }, Out = new[] { 2f, 0, 0 } }, new ConstructionPathKey { At = 4, Point = new[] { 8f, 0, 0 } } }; Check(Near(Measure(curve).Work, Measure(split).Work), "同一条真实曲线拆成更多曲段不额外收费"); var fastCurve = ConstructionMagnitudeEdits.Haste(curve, 2); Check(fastCurve.Cost > curve.Cost && Measure(fastCurve).Work > Measure(curve).Work, "纯曲线投送按寿命内实际可走路程计预算，急速走得更远时增加需求"); var loop = ConstructionEditing.Copy(curve); loop.Root.Operations[0].Path.Loop = true; loop.Root.Operations[0].Path.Keys = new[] { new ConstructionPathKey(), new ConstructionPathKey { At = 1, Point = new[] { 2f, 0, 0 } }, new ConstructionPathKey { At = 2 } }; var loopLong = ConstructionEditing.Copy(loop); loopLong.Lifetime = 4; var still = Basic(); var stillLong = Basic(); stillLong.Lifetime = 4; Check(Near(Measure(loopLong).Work - Measure(stillLong).Work, 2 * (Measure(loop).Work - Measure(still).Work)), "循环曲线按真实可能运行的圈数计运动预算");
var interval = Basic(); interval.Root.Contact = new ConstructionContactPolicy { Mode = ConstructionContactMode.Interval, Interval = .25f }; var held = ConstructionMagnitudeEdits.Sustain(interval, 2); Check(Measure(held).ContactWork > Measure(interval).ContactWork && held.Cost > interval.Cost, "延长连续作用会增加重复作用预算"); interval.Root.Contact.MaximumPerTarget = 2; Check(Measure(ConstructionMagnitudeEdits.Sustain(interval, 2)).ContactWork == Measure(interval).ContactWork, "明确每人次数上限继续约束预算，不因延长解除");
var nested = Basic(); nested.Root.Form = "branch"; nested.Root.Scale = 2; nested.Root.Children = new[] { new ConstructionNode { Id = "edge", Form = "sword", Scale = .5f } }; Check(Near(Measure(nested).Volume, 9), "材料体积按真实父子缩放计算，子体不会漏掉父倍率");
var fractured = Basic(); fractured.Root.Form = "fracture_slab"; fractured.Root.Operations = new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Fracture, At = .2f, Fracture = new ConstructionFracture { Seconds = 1 } } }; Check(Measure(fractured).Materials == 1 && Measure(fractured).Volume == 1 && AbilityCompiler.Compile(fractured, false).FormCount == 9, "八片碎解不重复产生八份材料需求，后续运动仍有控制预算");
var region = Basic(); region.Root.Form = "world_domain"; region.Impact = new ConstructionImpact { DamageScale = 0 }; var regionWide = ConstructionMagnitudeEdits.Resize(region, 2); Check(Measure(region).Materials == 0 && Measure(region).Volume == 0 && Near(Measure(regionWide).Area / Measure(region).Area, 4) && regionWide.Cost > region.Cost, "没有网格的功能区域按真实作用投影扩大计预算，不冒充免费材料或空支点");
var named = ConstructionEditing.Copy(moving); named.Root.Operations[0].Id = "launch"; Check(Near(Measure(named).Work, Measure(moving).Work), "仅给原操作命名不增加费用，不重复计观察步骤");
var body = ConstructionEditing.Access.Read(BodyActionCatalog.PalmId); var projection = BodyConstructionEdits.Project(body, new BodyProjection { Scale = 1, Cost = 4 }); var projections = ConstructionMagnitudeEdits.Repeat(projection, 3, 1, .2f); Check(Measure(projections).Materials == 3 && projections.Cost > projection.Cost && projections.Cost < projection.Cost * 3, "复制显化时身体只发力一次，费用不重复包含三次身体动作");
var wave = Basic(); wave.Root.Operations = new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Conduct, Conduction = new ConstructionConduction { Range = 4, MaximumTargets = 2, Pulses = 1 } } }; var waves = ConstructionEditing.Copy(wave); waves.Root.Operations[0].Conduction.Pulses = 3; Check(Measure(waves).Work > Measure(wave).Work, "多波传播按真实波数和声明范围计预算");
var ranged = ConstructionEditing.Copy(source); ranged.TargetRange = 120; ConstructionPricing.Reprice(source, ranged); Check(ranged.Cost > source.Cost, "更远的明确选取范围增加控制需求，不扩大实际接触形状");
var auto = ConstructionDefinitionLayers.Resolve(new JObject { ["Id"] = "test.pricing.partial", ["Lifetime"] = 2, ["Root"] = new JObject { ["Id"] = "blade", ["Form"] = "sword" } }); Check(Near(auto.Cost, Measure(auto).Work) && auto.Cooldown == Measure(auto).DefaultCooldown, "缺省费用和恢复时间从同一实际计划补齐"); var explicitChoice = ConstructionDefinitionLayers.Resolve(new JObject { ["Id"] = "test.pricing.explicit", ["Cost"] = 0, ["Cooldown"] = 0, ["Root"] = new JObject { ["Id"] = "blade", ["Form"] = "sword", ["Scale"] = 2 } }); Check(explicitChoice.Cost == 0 && explicitChoice.Cooldown == 0, "明确免费与零冷却不被计算默认覆盖"); var free = ConstructionMagnitudeEdits.Resize(explicitChoice, 2); Check(free.Cost == 0 && free.Cooldown == 0, "免费原术的明确改造仍保持零值");
var tiny = Basic(); tiny.Cost = 1e-8f; Check(ConstructionMagnitudeEdits.Resize(tiny, 2).Cost > 0, "微小正费用不会被比例计算抹成免费"); var integer = Basic(); integer.Resource = "mana"; var integerLarge = ConstructionMagnitudeEdits.Resize(integer, 1.1f); Check(integerLarge.Cost == Math.Ceiling(integerLarge.Cost) && integerLarge.Cost >= integer.Cost, "整数资源在自动需求计算边界向上取整"); var twice = ConstructionMagnitudeEdits.Resize(ConstructionMagnitudeEdits.Resize(integer, 1.1f), 1.1f); var once = ConstructionMagnitudeEdits.Resize(integer, 1.21f); Check(twice.Cost == once.Cost, "连续整数改造保留未取整基准，不因多点一次按钮重复加价"); var reverted = ConstructionMagnitudeEdits.Resize(twice, 1f / 1.21f); Check(reverted.Cost == integer.Cost, "整数改造恢复原尺寸后可恢复原费用"); integer.Resource = SkillCastResources.NativeMana.id; Check(ConstructionMagnitudeEdits.Resize(integer, 1.1f).Cost % 1 == 0, "长期资源编号使用已登记的真实整数规则");
var legacy = ConstructionMagnitudeEdits.Resize(source, 2, reprice: false); Check(legacy.Cost == source.Cost && legacy.Cooldown == source.Cooldown, "旧正式请求可保持当时明确费用与恢复规则"); Check(JsonConvert.SerializeObject(ConstructionMagnitudeEdits.Repeat(source, 1, 0, 0)) == unchanged && JsonConvert.SerializeObject(source) == unchanged, "不改变数量时完整保留原值，所有计算不改写原构造");

Game.Resume(); Config.paused = true; World.world.save_manager.loadWorld(Path.Combine(root, "Scripts/WorldSaveTests/Fixtures/world-format-1")); await Game.NextFrame(); await Game.WaitUntil(() => !SmoothLoader.isLoading(), 3600); Config.paused = true; var runnerType = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner"); object runner = runnerType.GetProperty("Instance").GetValue(null); await Game.WaitUntil(() => (bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner), 3600);
var actor = World.world.units.createNewUnit("human", World.world.GetTileSimple(64, 72), pAdultAge: true, pSpawnWithItems: false); var owner = actor.GetExtend(); owner.AddComponent(new Xian { level = 2, wakan = 1000 }); owner.MarkCultiwayStatsDirty(); actor.setStatsDirty(); actor.updateStats();
var elements = default(ElementComposition); var oldInput = new ConstructionInspiration(elements, .2f, .4f, false, rules: 2); var newInput = new ConstructionInspiration(elements, .2f, .4f, false, rules: 3); var oldCreation = ConstructedAbilityService.Generate(owner, 7, oldInput); var newCreation = ConstructedAbilityService.Generate(owner, 7, newInput); JObject Canon(AbilityDefinition d) { var json = JObject.FromObject(d); foreach (string key in new[] { "Id", "Cost", "Cooldown", "Calculation" }) json.Remove(key); return json; }
Check(JToken.DeepEquals(Canon(oldCreation), Canon(newCreation)), "第三版只改变计算规则，不重抽固定输入的结构、动作或名称"); Check(Near(newCreation.Cost, Measure(newCreation).Work) && newCreation.Cooldown == Measure(newCreation).DefaultCooldown && ConstructedAbilityService.ReadInspiration(owner).Rules == 3, "当前自然创法使用第三版实际规模计算，第二版请求仍按原规则生成");
var live = ConstructionMagnitudeEdits.Resize(Basic(), 2); live.Id = "test.pricing.formal"; live.Use = new ConstructionUse { Target = ActiveAbilityTargetMode.Self }; live.Impact = new ConstructionImpact { Targets = SkillUseTargetRelation.Self, DamageScale = 0 }; ConstructionPricing.Price(live); ConstructedAbilityService.Register(live); ConstructedAbilityService.Learn(owner, live.Id); float balance = owner.GetCultisys<Xian>().wakan; var handle = new ActiveAbilityHandle("content.constructed", owner.E, live.Id); Check(ActiveAbilityService.TryUse(owner, handle, new ActiveAbilityTarget(actor, actor.GetSimPos()), ActiveAbilityUseOrigin.Script) && Near(balance - owner.GetCultisys<Xian>().wakan, live.Cost), "正式入口支付计算后的真实需求"); balance = owner.GetCultisys<Xian>().wakan; Check(!ActiveAbilityService.TryUse(owner, handle, new ActiveAbilityTarget(actor, actor.GetSimPos()), ActiveAbilityUseOrigin.Script) && owner.GetCultisys<Xian>().wakan == balance, "计算后的恢复时间实际阻止再次受理及支付");
var saved = Cultiway.ModClass.I.WorldSaves; var sections = (System.Collections.IDictionary)saved.World.GetType().GetField("sections", Flags).GetValue(saved.World); object section = sections["ability_constructions"]; var captured = (JObject)section.GetType().GetMethod("Capture", Flags).Invoke(section, new object[] { World.world }); var altered = ConstructionEditing.Access.Read(live.Id); altered.Cost = 0; altered.Cooldown = 0; ConstructedAbilityService.Register(altered); Check(ConstructionEditing.Access.Read(live.Id).Cost == 0, "正式登记不重算作者明确改写的免费值"); var envelope = new JObject { ["formatVersion"] = 1, ["sections"] = new JObject { ["ability_constructions"] = new JObject { ["version"] = (int)section.GetType().GetProperty("Version").GetValue(section), ["data"] = captured } } }; saved.World.Restore(World.world, envelope.ToString(), new SaveLoadReport(), "construction-pricing", part => part.Id == "ability_constructions"); var restored = ConstructionEditing.Access.Read(live.Id); Check(restored.Cost == live.Cost && restored.Cooldown == live.Cooldown && restored.Calculation.Demand == live.Calculation.Demand, "正式恢复保留已确定数值，不因再次编译叠加费用或重抽");
bool Pass(object value) => (bool)value.GetType().GetProperty("pass").GetValue(value); var report = new { passed = checks.All(Pass), checks, process = System.Diagnostics.Process.GetCurrentProcess().Id, baseWork = basis.Work, largeCost = large.Cost, copyCost = repeated.Cost }; File.WriteAllText(Path.Combine(folder, "checks.json"), JsonConvert.SerializeObject(report, Formatting.Indented)); return new { report.passed, checks = checks.Count };
