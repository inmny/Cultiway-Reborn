// 有限波数、条件启动、真实时间边界、回退、改造及旧资料默认行为。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using Newtonsoft.Json;
using UnityEngine;
using Cultiway.Core.Skills;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/conduction-pulses");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}object Call(object o,string name,params object[] args)=>o.GetType().GetMethod(name,F).Invoke(o,args);object Field(object o,string name)=>o.GetType().GetField(name,F).GetValue(o);
AbilityDefinition Definition(){var d=JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/循水连雷.json")));d.Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Conduct).At=.2f;return d;}ConstructionOperation Operation(AbilityDefinition d)=>d.Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Conduct);
AbilityCast Cast(AbilityDefinition d)=>new AbilityCast(AbilityCompiler.Compile(d),Matrix4x4.identity,inputs:new AbilityInputs(Vector3.zero,Vector3.right,Vector3.right,1),force:100,paidResource:8);
IList Take(AbilityCast c){var t=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Skills.AbilityWorldMatterRequest");var list=(IList)Activator.CreateInstance(typeof(List<>).MakeGenericType(t));Call(c,"TakeWorldMatterRequests",list);return list;}int[] Waves(IList list)=>list.Cast<object>().Where(v=>Field(v,"Conduction")!=null).Select(v=>(int)Field(v,"Pulse")).ToArray();
var d=Definition();var cast=Cast(d);cast.Advance(.19f,Vector3.right);Check(Take(cast).Count==0,"首波时点前没有导电请求");cast.Advance(.02f,Vector3.right);Check(Waves(Take(cast)).SequenceEqual(new[]{1})&&Take(cast).Count==0,"首波只领取一次，波序号从一开始");cast.Advance(.4f,Vector3.right);Check(Waves(Take(cast)).SequenceEqual(new[]{2}),"第二波使用实际间隔且不复制首波");Call(cast,"SaveStep");cast.Advance(.4f,Vector3.right);Check(Waves(Take(cast)).SequenceEqual(new[]{3}),"第三波按同一轮继续");Call(cast,"RestoreStep");Check(Take(cast).Count==0,"预测回退不遗留已经预测的请求");cast.Advance(.4f,Vector3.right);Check(Waves(Take(cast)).SequenceEqual(new[]{3}),"重新推进恢复同一波序号");cast.Advance(.4f,Vector3.right);Check(Waves(Take(cast)).SequenceEqual(new[]{4}),"末波属于原有有限轮次");cast.Advance(.7f,Vector3.right);Check(Take(cast).Count==0,"超过总波数不自行续轮");
var bulk=Cast(Definition());bulk.Advance(1.5f,Vector3.right);Check(Waves(Take(bulk)).SequenceEqual(new[]{1,2,3,4}),"大数值步也不把多波折叠成一个布尔请求");
var exact=Cast(Definition());var due=new List<float>();for(int i=0;i<300&&!exact.Finished;i++){float step=exact.NextStep(.3f);exact.Advance(step,Vector3.right);if(Take(exact).Count>0)due.Add(exact.Age);}Check(due.Count==4&&due.Zip(new[]{.2f,.6f,1f,1.4f},(a,b)=>Math.Abs(a-b)<.00001).All(v=>v),"共同调度在每个准确时点确认，不靠渲染帧计时");
var conditional=Definition();var op=Operation(conditional);op.At=0;op.When=new ConstructionCondition{Trigger=ConstructionChangeTrigger.ActorContact,Delay=.15f};conditional.Root.ContactRole=ConstructionContactRole.Attack;var eventCast=Cast(conditional);eventCast.Advance(.1f,Vector3.right);eventCast.ConfirmContact(0,1);eventCast.ConfirmContact(0,1);eventCast.Advance(.16f,Vector3.right);Check(Waves(Take(eventCast)).SequenceEqual(new[]{1}),"真实事件及延迟只启动一次首波");eventCast.ConfirmContact(0,1);eventCast.Advance(1.3f,Vector3.right);Check(Waves(Take(eventCast)).SequenceEqual(new[]{2,3,4}),"重复接触不重启或叠加无限轮次");
var ended=Cast(Definition());ended.Advance(.25f,Vector3.right);Call(ended,"EndNode",0);Check(Take(ended).Count==0,"部位结束时尚未确认的旧请求作废");var cancelled=Cast(Definition());cancelled.Advance(.25f,Vector3.right);cancelled.Cancel();Check(Take(cancelled).Count==0,"整次取消不留下旧放电请求");
var recovery=Definition();recovery.Root.Operations=recovery.Root.Operations.Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Recover,At=.5f,Seconds=.5f,Recovery=new ConstructionRecovery{Efficiency=.75f}}}).ToArray();var recovering=Cast(recovery);recovering.Advance(.3f,Vector3.right);Take(recovering);recovering.Advance(.5f,Vector3.right);Check(Take(recovering).Count==0,"进入收束后停止后续放电");
var duration=ConstructionMagnitudeEdits.Duration(d,2);Check(Operation(duration).At==.4f&&Operation(duration).Conduction.Interval==.8f&&Operation(duration).Conduction.Pulses==4&&Operation(d).Conduction.Interval==.4f,"历时改造同步伸缩间隔，波数和原资料不变");var size=ConstructionMagnitudeEdits.Resize(d,2);Check(Operation(size).Conduction.Interval==.4f&&Operation(size).Conduction.Pulses==4,"尺寸改造不暗中提高放电频率");var copy=JsonConvert.DeserializeObject<AbilityDefinition>(JsonConvert.SerializeObject(d));Check(Operation(copy).Conduction.Pulses==4&&Operation(copy).Conduction.Interval==.4f,"普通复制保存完整有限时序");
var legacy=JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/引水行雷.json")));var single=Cast(legacy);single.Advance(2,Vector3.right);Check(Operation(legacy).Conduction.Pulses==1&&Waves(Take(single)).SequenceEqual(new[]{1}),"正式旧资料缺少新字段时保持一次行为");Check(!JsonConvert.SerializeObject(legacy).Contains("\"Pulses\"")&&!JsonConvert.SerializeObject(legacy).Contains("\"Interval\""),"默认参数不向原正式资料写入多余字段");
foreach(int n in new[]{0,257}){var invalid=Definition();Operation(invalid).Conduction.Pulses=n;try{AbilityCompiler.Compile(invalid);throw new Exception("非法波数被接受");}catch(InvalidDataException){}}checks.Add("资料入口拒绝超范围波数");foreach(float interval in new[]{0f,-1f,.001f,float.NaN,float.PositiveInfinity,3601f}){var invalid=Definition();Operation(invalid).Conduction.Interval=interval;try{AbilityCompiler.Compile(invalid);throw new Exception("非法间隔被接受");}catch(InvalidDataException){}}checks.Add("资料入口拒绝无效和过密放电间隔");var overflow=Definition();Operation(overflow).Conduction.Pulses=20;try{AbilityCompiler.Compile(overflow);throw new Exception("越过寿命的末波被接受");}catch(InvalidDataException){}checks.Add("定时末波不能越过部位寿命");
var poolType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.SimulationWorkerPool");var pool=poolType.GetProperty("Instance",F).GetValue(null);var run=poolType.GetMethod("RunIndexed",F);var plan=AbilityCompiler.Compile(Definition());foreach(int count in new[]{32,128}){var serial=new string[count];var parallel=new string[count];var left=Enumerable.Range(0,count).Select(i=>new AbilityCast(plan,Matrix4x4.identity,inputs:new AbilityInputs(Vector3.zero,Vector3.right,Vector3.right,1),force:100,paidResource:8)).ToArray();var right=Enumerable.Range(0,count).Select(i=>new AbilityCast(plan,Matrix4x4.identity,inputs:new AbilityInputs(Vector3.zero,Vector3.right,Vector3.right,1),force:100,paidResource:8)).ToArray();for(int i=0;i<count;i++){left[i].Advance(1.5f,Vector3.right);serial[i]=string.Join(",",Waves(Take(left[i])));}Action<int> work=i=>{right[i].Advance(1.5f,Vector3.right);parallel[i]=string.Join(",",Waves(Take(right[i])));};run.Invoke(pool,new object[]{0,count,work});Check(serial.SequenceEqual(parallel),"有限放电时序在串行及实际工作池一致："+count);await Game.NextFrame();}
var result=new{passed=true,checks,times=due};File.WriteAllText(Path.Combine(folder,"math.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
