// 5.05收尾，直接读取C15真实正式存档，不重造历史预期。
const string section="pending";
string previous=Path.Combine(root,"artifacts/skill_rebuild/trajectories/placement-starts/save");
string delivery=Path.Combine(root,"artifacts/skill_rebuild/trajectories/trajectory-delivery");
var access=ConstructionEditing.Access;
var expected=JObject.Parse(File.ReadAllText(Path.Combine(previous,"pending-expected.json")));
var metadata=JObject.Parse(File.ReadAllText(Path.Combine(previous,"metadata.json")));
int process=System.Diagnostics.Process.GetCurrentProcess().Id;
JObject Canon(AbilityDefinition definition){var json=JObject.FromObject(definition);json.Remove("Id");json.Remove("Creator");return json;}
async Task Load(string path)
{
    Game.Resume();Config.paused=true;Config.setWorldSpeed("x1",false);ControllableUnit.clear(false);
    World.world.save_manager.loadWorld(path);await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);
    Config.paused=true;await Game.WaitUntil(Boundary,1800);
}
var active=new List<AbilityCast>();
long sourceId=(long)expected["sourceId"];
void Started(ConstructedCastStarted fact)
{
    if(fact.SourceId!=sourceId)return;
    foreach(object running in (IEnumerable)service.GetField("casts",F).GetValue(null))
        if((long)Field(running,"Id")==fact.CastId)active.Add((AbilityCast)Field(running,"Cast"));
}
ConstructedAbilityService.CastStarted+=Started;
try
{
    if(section=="pending")
    {
        Check(process!=(int)metadata["connection"]["pid"],"使用不同游戏进程读取真实正式等待世界");
        await Load(Path.Combine(previous,"pending-save"));
        Actor source=World.world.units.get(sourceId),legacy=World.world.units.get((long)expected["legacyId"]),enemy=World.world.units.get((long)expected["enemyId"]);
        var owner=source.GetExtend();var oldOwner=legacy.GetExtend();
        var pending=owner.GetComponent<ConstructedCreationState>();var oldPending=oldOwner.GetComponent<ConstructedCreationState>();
        var predicted=expected["predicted"].ToObject<AbilityDefinition>();
        var expectedOld=expected["expectedOld"].ToObject<AbilityDefinition>();
        bool wasPending=pending.Pending,oldWasPending=oldPending.Pending;
        Check(pending.Inspiration.Rules==22 && oldPending.Inspiration.Rules==21 &&
            (wasPending ? JToken.DeepEquals(JObject.FromObject(pending),JObject.FromObject(expected["pending"].ToObject<ConstructedCreationState>())) &&
                JToken.DeepEquals(Canon(ConstructedAbilityService.Generate(owner,pending.Seed,pending.Inspiration,pending.Source,pending.Resources)),Canon(predicted)) :
                pending.LastFailure==null && pending.LastAbility!=null && JToken.DeepEquals(Canon(access.Read(pending.LastAbility)),Canon(predicted))) &&
            (oldWasPending ? JToken.DeepEquals(Canon(ConstructedAbilityService.Generate(oldOwner,oldPending.Seed,oldPending.Inspiration,oldPending.Source,oldPending.Resources)),Canon(expectedOld)) :
                oldPending.LastFailure==null && oldPending.LastAbility!=null && JToken.DeepEquals(Canon(access.Read(oldPending.LastAbility)),Canon(expectedOld))),
            "新进程保留等待输入或加载期间完成的原成品，完整结果及费用保持",new{wasPending,oldWasPending});
        int known=access.List(owner).Count+(wasPending?1:0),oldKnown=access.List(oldOwner).Count+(oldWasPending?1:0);
        await Advance(.2f);
        var completed=owner.GetComponent<ConstructedCreationState>();var oldCompleted=oldOwner.GetComponent<ConstructedCreationState>();
        var learned=access.Read(completed.LastAbility);var oldLearned=access.Read(oldCompleted.LastAbility);
        Check(!completed.Pending && completed.LastFailure==null && !oldCompleted.Pending && oldCompleted.LastFailure==null &&
            JToken.DeepEquals(Canon(learned),Canon(predicted)) && JToken.DeepEquals(Canon(oldLearned),Canon(expectedOld)) &&
            access.List(owner).Count==known && access.List(oldOwner).Count==oldKnown,
            "真实逻辑边界分别授予一次原完整成品");
        await Advance(.2f);Check(access.List(owner).Count==known && access.List(oldOwner).Count==oldKnown,"完成请求不重复授予");
        Ready(source);Place(source,64);Place(enemy,64.2f);
        owner.GetCultisys<Xian>().wakan=source.stats[BaseStatses.MaxWakan.id]*.9f;
        float balance=owner.GetCultisys<Xian>().wakan;int hp=enemy.data.health;
        await Fire(learned,source,enemy);float paid=balance-owner.GetCultisys<Xian>().wakan;owner.E.RemoveComponent<ConstructedKnowledge>();
        await Advance(.8f);var cast=active.Last();
        Check(Math.Abs(paid-learned.Cost)<.001f && enemy.data.health<hp && contacts.Any(c=>c.AbilityId==learned.Id && c.TargetId==enemy.id) &&
            cast.StepStateOf("outward")==ConstructionStepState.Completed && cast.StepStateOf("spin")==ConstructionStepState.Running,
            "冷启动成品实际支付、接触并执行真实就绪后的旋转",new{paid,learned.Cost,hp,after=enemy.data.health});
        await Advance(learned.Lifetime+.25f);
        Check(cast.Finished && endings.Any(e=>e.Fact.AbilityId==learned.Id && !e.Fact.Cancelled) && !BodyControlState.IsBusy(sourceId),"冷启动成品自然结束并归还控制");
        ConstructedAbilityService.Learn(owner,learned.Id);
        CombatStatusEffects.ApplyStatus(source,hold,10000,source);Place(source,64);
        string save=Path.Combine(delivery,"completed-save");SaveManager.saveWorldToDirectory(save);
        File.WriteAllText(Path.Combine(delivery,"completed-expected.json"),JsonConvert.SerializeObject(new{process,sourceId,legacyId=legacy.id,definition=learned,oldDefinition=oldLearned,
            completed,oldCompleted,known=access.List(owner).Count,oldKnown=access.List(oldOwner).Count},Formatting.Indented));
    }
    else
    {
        var saved=JObject.Parse(File.ReadAllText(Path.Combine(delivery,"completed-expected.json")));
        Check(process!=(int)saved["process"],"确认再次退出并使用新进程恢复完成世界");
        await Load(Path.Combine(delivery,"completed-save"));
        var owner=World.world.units.get((long)saved["sourceId"]).GetExtend();var oldOwner=World.world.units.get((long)saved["legacyId"]).GetExtend();
        var definition=saved["definition"].ToObject<AbilityDefinition>();var oldDefinition=saved["oldDefinition"].ToObject<AbilityDefinition>();
        Check(JToken.DeepEquals(JObject.FromObject(access.Read(definition.Id)),JObject.FromObject(definition)) &&
            JToken.DeepEquals(JObject.FromObject(access.Read(oldDefinition.Id)),JObject.FromObject(oldDefinition)) &&
            ConstructedAbilityService.Knows(owner,definition.Id) && ConstructedAbilityService.Knows(oldOwner,oldDefinition.Id),
            "完成成品的完整定义、原费用、命名引用及已学关系在新进程保持");
        var sections=JObject.Parse(File.ReadAllText(Path.Combine(delivery,"completed-sections.json")));
        JToken Persisted(ActorExtend actor)=>JObject.Parse(Cultiway.ModClass.I.WorldSaves.Actors.Capture(actor,"trajectory-cold"))["sections"]["ability_creation"]["data"];
        Check(JToken.DeepEquals(Persisted(owner),sections["source"]) && JToken.DeepEquals(Persisted(oldOwner),sections["legacy"]),
            "新旧请求完成状态和剩余机会时间按正式存储保持");
        await Advance(.2f);
        Check(access.List(owner).Count==(int)saved["known"] && access.List(oldOwner).Count==(int)saved["oldKnown"] &&
            Cultiway.ModClass.I.WorldSaves.LastReport.Skipped.Count==0,"再次冷启动后没有重复授予或局部丢弃");
    }
    return new{passed=true,section,checks,process};
}
finally
{
    ConstructedAbilityService.CastStarted-=Started;ConstructedAbilityService.ContactConfirmed-=Hit;ConstructedAbilityService.CastEnded-=Ended;
    Config.paused=true;ControllableUnit.clear(false);
}
