// 正式重启不恢复旧任务回调、不重放完成；已学原术仍可进入新的真实城市任务。
using System;using System.IO;using System.Linq;using System.Reflection;using System.Collections.Generic;using System.Threading.Tasks;using Newtonsoft.Json;using Newtonsoft.Json.Linq;using UnityEngine;using DebugToolbox.Runtime.Scripting;using Cultiway.Core;using Cultiway.Core.Skills;using Cultiway.Core.SkillLibV3.ActiveAbilities;using Cultiway.Core.SkillLibV3.Components;using Cultiway.Content.Skills;using Cultiway.Content.Combat;using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/world-scope");var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));long sourceId=(long)expected["actor"];var checks=new List<string>();void Check(bool v,string n){if(!v)throw new InvalidOperationException(n);checks.Add(n);Log.Info(n);}Check(System.Diagnostics.Process.GetCurrentProcess().Id!=(int)expected["process"],"实际使用另一游戏进程恢复");var hs=new BaseStats();hs.addTag("frozen_ai");hs.addTag("immovable");var hold=Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.WorldScopeHold")??Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.WorldScopeHold").SetStats(hs).SetDuration(10000).Build();var rt=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=rt.GetProperty("Instance").GetValue(null);async Task Boundary()=>await Game.WaitUntil(()=>(bool)rt.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);async Task Advance(float sec){Config.paused=false;double end=World.world.getCurWorldTime()+sec;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=end,3600);Config.paused=true;await Boundary();}
Config.paused=true;Game.Resume();ControllableUnit.clear(false);bool originalBuild=DebugConfig.isOn(DebugOption.SystemBuildTick);DebugConfig.setOption(DebugOption.SystemBuildTick,false);World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();World.world.console.Hide();foreach(var screen in Resources.FindObjectsOfTypeAll<LoadingScreen>())screen.gameObject.SetActive(false);var actor=World.world.units.get(sourceId);Check(actor!=null&&actor.isAlive(),"原来源恢复且仍有效");var owner=actor.GetExtend();JToken Section(string s,string key)=>JObject.Parse(s)["sections"][key];var saves=Cultiway.ModClass.I.WorldSaves;Check(JToken.DeepEquals(Section((string)expected["world"],"ability_constructions"),Section(saves.World.Capture(World.world,"scope"),"ability_constructions")),"原构造完整恢复，没有把任务条件写进共享定义");Check(JToken.DeepEquals(Section((string)expected["person"],"ability_knowledge"),Section(saves.Actors.Capture(owner,"scope"),"ability_knowledge")),"已学关系和原有冷却原样恢复");Check(saves.LastReport.Skipped.Count==0&&saves.LastReport.BackupError==null,"正式恢复无局部丢弃或备份错误");string id=(string)expected["ability"];Check(!((string)expected["world"]).Contains("ConstructionWorldScope"),"正式存档没有保存运行回调或城市对象");
var starts=new List<ConstructedCastStarted>();var ends=new List<ConstructedCastEnded>();var contacts=new List<ConstructedWorldContact>();bool valid=true;void Started(ConstructedCastStarted e){if(e.SourceId==sourceId)starts.Add(e);}void Ended(ConstructedCastEnded e){if(e.SourceId==sourceId)ends.Add(e);}void Contact(ConstructedWorldContact e){if(e.SourceId==sourceId){contacts.Add(e);if(e.AbilityId==id&&e.Result.Changed)valid=false;}}ConstructedAbilityService.CastStarted+=Started;ConstructedAbilityService.CastEnded+=Ended;ConstructedAbilityService.WorldContactConfirmed+=Contact;var times=new List<double>();try{await Advance(.8f);Check(starts.Count==0&&ends.Count==0&&contacts.Count==0,"保存时未结束的旧任务不恢复施放、不产生旧完成或重复收益");for(int x=63;x<=69;x++){var t=World.world.GetTileSimple(x,78);if(t.building!=null)t.building.removeBuildingFinal();t.setTileTypes(TileLibrary.soil_low,TopTileLibrary.grass_low);t.setBurnedStage(15);World.world.burned_layer.setTileDirty(t);}var city=World.world.cities.get((long)expected["city"]);city.addZone(World.world.GetTileSimple(65,78).zone);city.recalculateNeighbourZones();var factory=typeof(ConstructedAbilityService).Assembly.GetType("Cultiway.Content.CollectiveProjects.CityConstructionWorldScope").GetMethod("Create",F);var scope=(ConstructionWorldScope)factory.Invoke(null,new object[]{city.id,(Func<bool>)(()=>valid)});string frames=Path.Combine(folder,"frames");if(Directory.Exists(frames))Directory.Delete(frames,true);Directory.CreateDirectory(frames);World.world.camera.transform.position=new Vector3(65.5f,78.5f,World.world.camera.transform.position.z);MoveCamera.instance.forceZoom(6);World.world.camera.orthographicSize=6;World.world.setZoomOrthographic(6);await Game.NextFrame();double start=World.world.getCurWorldTime();Check(ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,id),new ActiveAbilityTarget(null,new Vector3(64.5f,78.5f,0),runtimeData:new SkillCastRuntimeData{CorrelationId=600},worldScope:scope),ActiveAbilityUseOrigin.Script),"恢复的已学原术可正式支付并进入新的城市行动");Config.paused=false;double next=start;while(World.world.getCurWorldTime()<start+2){await Game.NextFrame();double now=World.world.getCurWorldTime();if(now<next)continue;World.world.camera.transform.position=new Vector3(65.5f,78.5f,World.world.camera.transform.position.z);MoveCamera.instance.forceZoom(6);World.world.camera.orthographicSize=6;World.world.setZoomOrthographic(6);new ScreenFacade().Capture(Path.Combine(frames,times.Count.ToString("00000")+".png"));times.Add(now-start);next=now+.075;}Config.paused=true;await Boundary();Check(starts.Count==1&&starts[0].CorrelationId==600&&ends.Count==1&&ends[0].CorrelationId==600,"新的开始和结束只对应当前行动，不混入旧关联编号");Check(ends[0].Cancelled&&ends[0].WorldChanges==1&&contacts.Count==1&&contacts[0].Result.Changed,"新的需求完成后立即停止，报告实际取消和一个已确认永久结果");Check(Enumerable.Range(64,4).Count(x=>World.world.GetTileSimple(x,78).burned_stages==0)==1,"画面中实际清理一块，其他地块没有继续受到作用");var again=SaveManager.saveWorldToDirectory(Path.Combine(folder,"resave"));Check(again.actors_data.Any(a=>a.id==sourceId),"新行动结束后的实际来源仍可正式保存");int startsBefore=starts.Count,endsBefore=ends.Count;World.world.save_manager.loadWorld(Path.Combine(folder,"resave"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();await Advance(.8f);Check(starts.Count==startsBefore&&ends.Count==endsBefore,"后续存读档不重放已完成或已取消的行动");Check(World.world.GetTileSimple(64,78).burned_stages==0,"已经确认的永久清理结果继续保持");var result=new{passed=true,checks,starts,ends,contacts,times,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"restart-result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;}finally{ConstructedAbilityService.CastStarted-=Started;ConstructedAbilityService.CastEnded-=Ended;ConstructedAbilityService.WorldContactConfirmed-=Contact;DebugConfig.setOption(DebugOption.SystemBuildTick,originalBuild);Config.paused=true;}
