using System;
using System.IO;
using System.Linq;
using System.Threading.Tasks;
using Cultiway.Content.Skills;
using Cultiway.Core.Skills;
using Cultiway.Utils.Extension;
using Newtonsoft.Json.Linq;

void Check(bool condition, string reason)
{
    if (!condition) throw new InvalidOperationException(reason);
}

const string scenario = "$CASE";
const string output = "$OUTPUT";
var expected = JObject.Parse(File.ReadAllText(Path.Combine(output, "expected.json")));
var runnerType = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");
var runner = runnerType.GetProperty("Instance").GetValue(null);
async Task LoadStable(string directory)
{
    Config.paused = true;
    World.world.save_manager.loadWorld(Path.Combine(output, directory));
    while (SmoothLoader.isLoading())
    {
        Config.paused = true;
        await Game.NextFrame();
    }
    Config.paused = true;
    await Game.NextFrame();
    await Game.WaitUntil(() => (bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner), 1800);
}
Game.Resume();
ControllableUnit.clear(false);
await LoadStable("input-world");
var report = Cultiway.ModClass.I.WorldSaves.LastReport;
var access = ConstructionEditing.Access;

if (scenario == "current")
{
    Check(!report.RequiresBackup, "当前世界需要意外升级或报告恢复问题");
    foreach (var entry in expected["definitions"])
    {
        var definition = access.Read(entry.Value<string>("Id"));
        Check(definition != null && JToken.DeepEquals(entry, JObject.FromObject(new
            { definition.Id, definition.Version, definition.Revision, definition.Creator, definition.Parent })),
            "未恢复原构造编号、修订或来源：" + entry.Value<string>("Id"));
    }
    foreach (var entry in ((JObject)expected["ownership"]).Properties())
    {
        var actor = World.world.units.get(long.Parse(entry.Name)).GetExtend();
        Check(access.List(actor).Select(ability => ability.Id).OrderBy(id => id)
                .SequenceEqual(entry.Value.Values<string>().OrderBy(id => id)),
            "未恢复人物原来掌握的版本：" + entry.Name);
    }
    var completed = World.world.units.get(57).GetExtend().GetComponent<ConstructedCreationState>();
    Check(!completed.Pending && completed.LastAbility == expected["completed"].Value<string>("LastAbility") &&
        completed.Source == null && completed.Resources == null, "派生结果应保持已完成");
}
else
{
    Check(report.BackupError == null && Directory.Exists(report.BackupDirectory), "需要保留本次读入的原档");
    if (scenario == "legacy")
        Check(report.Upgraded > 0 && report.Skipped.SequenceEqual(expected["skips"].Values<string>()),
            "历史世界只有旧器灵显化按报告退出，其余资料应完整转换");
    else
    {
        Check(report.Skipped.OrderBy(issue => issue).SequenceEqual(expected["skips"].Values<string>().OrderBy(issue => issue)),
            "局部失败应给出原对象及学习关系两处说明");
        var actor = World.world.units.get(1).GetExtend();
        Check(access.List(actor).Any(entry => entry.Id == expected.Value<string>("ability")), "坏记录影响了有效改造");
    }
}

SaveManager.saveWorldToDirectory(Path.Combine(output, "archive"));
if (scenario == "legacy")
{
    await LoadStable("archive");
    Check(!Cultiway.ModClass.I.WorldSaves.LastReport.RequiresBackup, "升级后的世界应能直接读取");
    SaveManager.saveWorldToDirectory(Path.Combine(output, "second"));
}
return new { passed = true, scenario, process = System.Diagnostics.Process.GetCurrentProcess().Id,
    report.Upgraded, report.Skipped, backup = report.BackupDirectory };
