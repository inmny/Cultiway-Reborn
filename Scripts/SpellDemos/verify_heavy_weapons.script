// 用相同两人和实际铁锤验证压落。空挥时同一目标在蓄势途中侧移。
const string abilityId = "Cultiway.Body.HeavyHammerDrop";
var form = FormResources.Load("warhammer");
var clock = Config.time_scale_asset;
float speed = clock.multiplier;
long castId = 0;
AbilityCast live = null;
object binding = null;
void Started(ConstructedCastStarted fact)
{
    if (fact.SourceId != source.id || fact.AbilityId != abilityId) return;
    castId = fact.CastId;
    var state = ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>()
        .Single(entry => (long)Field(entry, "Id") == castId);
    live = (AbilityCast)Field(state, "Cast");
    binding = Field(state, "Body");
}
ConstructedAbilityService.CastStarted += Started;
try
{
    owner.E.RemoveComponent<ConstructedKnowledge>();
    Ready(source);
    source.attack_timer = target.attack_timer = 999;
    await Advance(.18f);
    clock.multiplier = speed * .32f;
    Item hammer = Equip(source, "hammer_iron");
    Place(source, 64.35f);
    Place(target, 64.98f);
    int health = target.data.health;
    var definition = ConstructionEditing.Access.Read(abilityId);
    source.data.stamina = 100;
    await Fire(definition, source, target);
    owner.E.RemoveComponent<ConstructedKnowledge>();
    Check(live != null && ReferenceEquals(hammer, Field(binding, "Weapon")) &&
          Mathf.Abs(100 - source.data.stamina - definition.Cost) < .001f,
        "正式伏腰落锤借用原版铁锤并支付一次");

    bool moved = false;
    var samples = new List<(BodyPose Pose, Vector3 Face, float GripError, float Recoil, string[] Shapes)>();
    var selectedFace = form.Anchors.Single(anchor => anchor.Id == "face/right");
    var visual = binding.GetType().GetMethod("AppendVisuals", F);
    var shape = binding.GetType().GetMethod("AppendContacts", F);
    while (!live.Finished)
    {
        await Advance(.034f);
        if (live.BodyPose is not BodyPose pose || live.Finished) continue;
        if (selection == "miss" && !moved && pose.WorldAge >= .35f)
        {
            Place(target, 64.98f, 73.1f);
            moved = true;
        }
        var visuals = new List<FormVisualInstance>();
        visual.Invoke(binding, new object[] { source, pose, visuals, null });
        var held = visuals.Single(instance => instance.Resource == form);
        Vector3 face = (held.Transform * selectedFace.Transform).GetColumn(3);
        var shapes = new List<AbilityCapsule>();
        shape.Invoke(binding, new object[] { pose, shapes });
        var frame = (BodyFrame)Field(live, "bodyFrame");
        BodyPose unrecoiled = live.Plan.Body.Sample(pose.WorldAge, in frame);
        float recoil = Vector3.Distance(unrecoiled.Shoulder, unrecoiled.Hand) - Vector3.Distance(pose.Shoulder, pose.Hand);
        samples.Add((pose, face, Mathf.Max(GripError("grip", BodyVisualSegment.RightHand),
            GripError("short", BodyVisualSegment.LeftHand)), recoil,
            shapes.Select(capsule => form.Description.Contacts[capsule.Shape].Id).ToArray()));

        float GripError(string grip, BodyVisualSegment segment)
        {
            var hand = visuals.Single(instance => instance.BodySegment == segment);
            Vector3 socket = (hand.Transform * hand.Resource.Anchors.Single(anchor => anchor.Id == "grip").Transform).GetColumn(3);
            return Vector3.Distance(socket, (held.Transform * form.Grip(grip).Frame()).GetColumn(3));
        }
    }
    var touches = contacts.Where(hit => hit.CastId == castId && hit.TargetId == target.id).ToArray();
    float contactAt = (float)Field(live, "bodyContactAt");
    var trajectory = samples.Select(sample => new
    {
        age = sample.Pose.WorldAge, face = (sample.Face - sample.Pose.Foot).ToString("F5"),
        center = (sample.Pose.CenterOfMass - sample.Pose.Foot).ToString("F5"),
        leftFoot = sample.Pose.LeftFoot.ToString("F5"), rightFoot = sample.Pose.RightFoot.ToString("F5"),
        sample.GripError, sample.Recoil, sample.Shapes
    }).ToArray();
    File.WriteAllText(Path.Combine(folder, "pose-trajectory.json"), JsonConvert.SerializeObject(new
    {
        selection, contactAt, health, after = target.data.health,
        touches = touches.Select(hit => new { hit.Age, hit.ForceApplied, hit.Result, hit.BodyResult,
            velocity = hit.VelocityChange.ToString("F5"), point = hit.Position.ToString("F5") }).ToArray(),
        trajectory
    }, Formatting.Indented));
    var initial = samples.First();
    var poised = samples.First(sample => sample.Pose.WorldAge >= .54f);
    var falling = samples.First(sample => sample.Pose.WorldAge >= .70f);
    var lowered = samples.First(sample => sample.Pose.WorldAge >= .94f);
    Check(samples.All(sample => sample.GripError < .0001f &&
          Vector3.Distance(sample.Pose.LeftFoot, initial.Pose.LeftFoot) < .0001f &&
          Vector3.Distance(sample.Pose.RightFoot, initial.Pose.RightFoot) < .0001f) &&
          poised.Pose.CenterOfMass.x < poised.Pose.Foot.x - .015f &&
          lowered.Pose.CenterOfMass.x > lowered.Pose.Foot.x + .06f &&
          poised.Face.z - initial.Face.z > .5f && poised.Face.z - falling.Face.z > .45f &&
          falling.Shapes.Length > 0 && falling.Shapes.All(name => name.StartsWith("face/right/")),
        "双脚承托下两手始终贴合原锤，重心前移时实际锤面加速下落");
    if (selection == "drop")
    {
        Check(touches.Length == 1 && touches[0].Node == -1 && touches[0].ForceApplied &&
              touches[0].VelocityChange.x > 0f && touches[0].VelocityChange.z < 0f &&
              target.data.health < health && contactAt >= definition.Body.ActiveFrom - .0001f &&
              samples.Any(sample => sample.Pose.WorldAge > contactAt &&
                  sample.Pose.WorldAge < contactAt + definition.Body.RecoilSeconds && sample.Recoil > .004f),
            "铁锤下落实际命中一次，向前向下施力并因接触回弹");
    }
    else Check(moved && touches.Length == 0 && contactAt < 0f && target.data.health == health,
        "蓄势途中侧移到锤面之外，空挥落完且未发生伤害或接触回弹");
    Check(endings.Any(end => end.Fact.CastId == castId && !end.Fact.Cancelled) &&
          !BodyControlState.IsBusy(source.id) && ReferenceEquals(hammer, source.getWeapon()),
        "动作收完后归还双手控制和原铁锤");
    return new { passed = true, selection, checks };
}
finally
{
    ConstructedAbilityService.CastStarted -= Started;
    ConstructedAbilityService.ContactConfirmed -= Hit;
    ConstructedAbilityService.CastEnded -= Ended;
    Config.paused = true;
    clock.multiplier = speed;
    ControllableUnit.clear(false);
}
