// 真正退出后的另一个进程：共同水流、逐格份额和跨区整数累计继续；另核对版本1转换。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using Cultiway.Core.Skills;
using Cultiway.Content.Skills;
using Cultiway.Utils.Extension;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/world-water");var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));Check((int)expected["process"]!=System.Diagnostics.Process.GetCurrentProcess().Id,"保存来自真正退出前的另一进程");var saves=Cultiway.ModClass.I.WorldSaves;JObject Section(string json)=>(JObject)JObject.Parse(json)["sections"]["world_materials"];JObject Archive()=>Section(saves.World.Capture(World.world,"world-water"))["data"] as JObject;
var changes=new List<WorldMaterialChange>();void Event(WorldMaterialChange e)=>changes.Add(e);WorldMaterialService.Changed+=Event;
try{
 Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;var before=Section((string)expected["world"]);var after=Archive();Check((int)before["version"]==2,"本批实际保存世界材料版本2");Check(JToken.DeepEquals(before["data"]["RecoveryGroups"],after["RecoveryGroups"]),"跨区域的原资源累计账本完整恢复");var previous=(JArray)before["data"]["Records"];var current=(JArray)after["Records"];Check(previous.Count==current.Count&&(long)before["data"]["Next"]==(long)after["Next"],"区域、来源及稳定编号集合恢复");Check(previous.All(row=>{var r=current.Single(v=>(long)v["Id"]==(long)row["Id"]);return JToken.DeepEquals(JObject.FromObject(row["Material"].ToObject<AbilityMaterialData>()),JObject.FromObject(r["Material"].ToObject<AbilityMaterialData>()))&&new[]{"Lineage","WorldGrid","Provider","Controller","Resource","Recovering","RecoveryGroup","Progress","Confirmed"}.All(k=>JToken.DeepEquals(row[k],r[k]));}),"共同水深、动量、逐格支付份额、来源链和收束进度原样恢复");Check(changes.Count==0&&!saves.LastReport.RequiresBackup,"暂停读档不重放转交或入账，有效资料没有丢弃");Check(Cultiway.Core.Visuals.Forms.FormVisualScene.Instances.Any(v=>v.Layer!=null&&v.Layer.Sources>0),"共同水面暂停时立即恢复");
 var actor=World.world.units.get((long)expected["actor"]);var other=World.world.units.get((long)expected["other"]);Check(actor!=null&&other!=null,"双方原支付者身份恢复");var stats=new BaseStats();stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.WaterWorldColdHold").SetStats(stats).SetDuration(10000).Build();foreach(var p in new[]{actor,other}){Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(p,hold,10000,p);p.setStatsDirty();p.updateStats();}
 double until=World.world.getCurWorldTime()+5;Config.paused=false;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;var type=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=type.GetProperty("Instance").GetValue(null);await Game.WaitUntil(()=>(bool)type.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);double granted=changes.Where(e=>e.Provider==actor.id&&e.Kind=="credit").Sum(e=>e.Granted)+(double)expected["granted"];Check(granted==6,"跨多个内部区域的八点法力按一次收束返还六点，不逐区舍掉整数，也不重发旧累计");Check(!((JArray)Archive()["Records"]).Any(r=>(long)r["Provider"]==actor.id&&(bool)r["Recovering"]),"独立收束结束后各区域都退出");Check(((JArray)Archive()["Records"]).Any(r=>(long)r["Provider"]==other.id&&(bool)r["WorldGrid"]),"他人的水继续独立流动，没有被收束结束删除");
 // 先前提交保留下来的真实版本1世界，不能用新格式重存后冒充兼容。
 string legacy=Path.Combine(root,"artifacts/skill_rebuild/world-materials");var old=JObject.Parse(File.ReadAllText(Path.Combine(legacy,"restart-expected.json")));Check((int)Section((string)old["world"])["version"]==1,"升级依据确为此前正式版本1区段");World.world.save_manager.loadWorld(Path.Combine(legacy,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;var converted=Archive();var originals=(JArray)Section((string)old["world"])["data"]["Records"];Check(originals.All(row=>((JArray)converted["Records"]).Any(r=>(long)r["Id"]==(long)row["Id"]&&JToken.DeepEquals(JObject.FromObject(row["Material"].ToObject<AbilityMaterialData>()),JObject.FromObject(r["Material"].ToObject<AbilityMaterialData>()))))&&saves.LastReport.Upgraded>0,"版本1的材料、水量及旧回收事实通过连续转换保留");
 var result=new{passed=true,checks,granted,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"restart.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{WorldMaterialService.Changed-=Event;Config.paused=true;}
