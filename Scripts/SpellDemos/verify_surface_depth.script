// 在游戏实际图形设备上检查双目标实体资料、遮挡和透明深度；独立缓冲不修改世界。
using System;
using System.IO;
using System.Linq;
using System.Collections;
using System.Collections.Generic;
using System.Reflection;
using System.Runtime.Serialization;
using Newtonsoft.Json;
using UnityEngine;
using UnityEngine.Rendering;
using Cultiway.Core.Visuals.Forms;

const BindingFlags Flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.Static;
var checks = new List<string>();
void Check(bool value, string name) { if (!value) throw new InvalidOperationException(name); checks.Add(name); }
string folder = Environment.GetEnvironmentVariable("CULTIWAY_SURFACE_DEPTH_OUTPUT") ?? Path.Combine(Cultiway.ModClass.I.GetDeclaration().FolderPath, "artifacts/skill_rebuild/surface-depth"); Directory.CreateDirectory(folder);
var resource = FormResources.Load("sword"); var native = resource.Surface("metal", true); var metal = resource.Surface("metal", false);
Check(metal.passCount == 5 && metal.FindPass("WorldfallSolid") == 2, "实际平台资源包含双目标实体通道");
Check(!native.GetShaderPassEnabled("CultiwayWorldfall") && !native.GetShaderPassEnabled("CultiwayWorldfallSolid"), "原版显示不叠加两个三维通道");
var mesh = new Mesh { name = "Cultiway_SurfaceDepthProbe" };
mesh.vertices = new[] { new Vector3(-1, -1, 0), new Vector3(1, -1, 0), new Vector3(1, 1, 0), new Vector3(-1, 1, 0) };
mesh.normals = Enumerable.Repeat(Vector3.back, 4).ToArray(); mesh.uv = new[] { Vector2.zero, Vector2.right, Vector2.one, Vector2.up }; mesh.triangles = new[] { 0, 2, 1, 0, 3, 2 }; mesh.RecalculateBounds();
var go = new GameObject("Cultiway_SurfaceDepthCamera"); var camera = go.AddComponent<Camera>(); camera.enabled = false; camera.orthographic = true; camera.orthographicSize = 2; camera.aspect = 1; camera.nearClipPlane = .1f; camera.farClipPlane = 100; camera.transform.position = new Vector3(0, 0, -10);
var color = new RenderTexture(32, 32, 24, RenderTextureFormat.ARGBFloat); var data = new RenderTexture(32, 32, 0, RenderTextureFormat.ARGBFloat); color.Create(); data.Create();
var read = new Texture2D(32, 32, TextureFormat.RGBAFloat, false, true); var cmd = new CommandBuffer { name = "Cultiway_SurfaceDepthProbe" };
var previous = RenderTexture.active; var globals = new Dictionary<string, Vector4>(); foreach (string key in new[] { "_FP_Eye", "_FP_LightDir", "_FP_View", "_FP_Cam", "_FP_CamF", "_FP_LightCol", "_FP_AmbCol" }) globals[key] = Shader.GetGlobalVector(key); var previousMatrix = Shader.GetGlobalMatrix("_FP_VP");
Color Pixel(RenderTexture target) { RenderTexture.active = target; read.ReadPixels(new Rect(0, 0, 32, 32), 0, 0); read.Apply(); return read.GetPixel(16, 16); }
void Begin() { cmd.Clear(); cmd.SetGlobalMatrix("_FP_VP", GL.GetGPUProjectionMatrix(camera.projectionMatrix, true) * camera.worldToCameraMatrix); cmd.SetGlobalVector("_FP_Eye", new Vector4(0, 0, -10, 0)); cmd.SetGlobalVector("_FP_LightDir", new Vector4(0, 0, -1, 0)); cmd.SetGlobalVector("_FP_LightCol", new Vector4(.55f, .55f, .55f, 0)); cmd.SetGlobalVector("_FP_AmbCol", new Vector4(.34f, .34f, .34f, 0)); cmd.SetGlobalVector("_FP_View", new Vector4(0, 1, 0, 0)); cmd.SetGlobalVector("_FP_Cam", new Vector4(0, 0, 1, 0)); cmd.SetGlobalVector("_FP_CamF", new Vector4(0, 0, 1, 0)); cmd.SetRenderTarget(new RenderTargetIdentifier[] { color, data }, color.depthBuffer); cmd.ClearRenderTarget(true, true, Color.clear); }
void Draw(float z, Color tint, int pass) { var p = new MaterialPropertyBlock(); p.SetColor("_Color", tint); p.SetColor("_Dye", Color.white); p.SetFloat("_UseSkinning", 0); cmd.DrawMesh(mesh, Matrix4x4.Translate(new Vector3(0, 0, z)), metal, 0, pass, p); }
Color solidPixel, metadata, occluded, transparentPixel;
try
{
    Begin(); Draw(0, Color.red, 2); Graphics.ExecuteCommandBuffer(cmd); solidPixel = Pixel(color); metadata = Pixel(data);
    Check(solidPixel.r > solidPixel.g + .1f && solidPixel.a > .99f, "实体通道真正写入颜色");
    Check(Mathf.Abs(metadata.r - 10) < .02f && metadata.g == 0 && Mathf.Abs(metadata.b - 3) < .001f && metadata.a == 0, "实体资料为真实观察深度、无人物编号和普通模型类别");
    Draw(2, Color.green, 2); Graphics.ExecuteCommandBuffer(cmd); occluded = Pixel(color);
    Check(Mathf.Abs(occluded.r - solidPixel.r) < .001f && Mathf.Abs(occluded.g - solidPixel.g) < .001f, "后画的远方实体仍被近处实体挡住");
    Begin(); Draw(0, Color.red, 2); cmd.SetRenderTarget(color, color.depthBuffer); Draw(2, new Color(0, 1, 0, .5f), 1); Graphics.ExecuteCommandBuffer(cmd); occluded = Pixel(color);
    Check(Mathf.Abs(occluded.r - solidPixel.r) < .001f && Mathf.Abs(occluded.g - solidPixel.g) < .001f, "前景透明通道读取共用实体深度，不能穿过实体");
    Begin(); cmd.SetRenderTarget(color, color.depthBuffer); Draw(0, new Color(1, 0, 0, .5f), 1); Draw(2, new Color(0, 1, 0, .5f), 1); Graphics.ExecuteCommandBuffer(cmd); transparentPixel = Pixel(color);
    Check(Mathf.Abs(transparentPixel.a - .75f) < .01f && transparentPixel.g > transparentPixel.r, "透明通道不写深度，后提交的远处半透明体仍能叠加");
    // 水冰的厚薄、斜视光程和冻结后的表面稳定性直接读取实际着色结果。
    Color Surface(string id, float thickness, float angle, float time)
    {
        mesh.SetUVs(3, Enumerable.Repeat(new Vector2(thickness, 0), 4).ToList()); Begin(); cmd.SetRenderTarget(color, color.depthBuffer);
        var p = new MaterialPropertyBlock(); p.SetFloat("_WorldTime", time); p.SetColor("_Dye", Color.white); p.SetFloat("_UseSkinning", 0);
        cmd.DrawMesh(mesh, Matrix4x4.Rotate(Quaternion.Euler(0, angle, 0)), resource.Surface(id, false), 0, 1, p); Graphics.ExecuteCommandBuffer(cmd); return Pixel(color);
    }
    var thinIce = Surface("ice", .1f, 0, 0); var thickIce = Surface("ice", 2, 0, 0); var angledIce = Surface("ice", .1f, 65, 0); var laterIce = Surface("ice", .1f, 0, 50);
    Check(thinIce.a > .25f, "薄冰仍保留可读的霜面与反光，不能近乎隐形");
    Check(thickIce.a > thinIce.a + .2f, "厚冰比薄冰具有更深的真实材料吸收");
    Check(angledIce.a > thinIce.a, "斜视冰层增加穿透光程与表面反射");
    Check(Mathf.Abs(laterIce.r - thinIce.r) + Mathf.Abs(laterIce.g - thinIce.g) + Mathf.Abs(laterIce.b - thinIce.b) < .0001f, "冰面固定在材料坐标，不随世界时间自行流动");
    var thinWater = Surface("water", .1f, 0, 0); var angledWater = Surface("water", .1f, 65, 0);
    Check(angledWater.a > thinWater.a + .05f, "斜视水面不再因错误厚度公式变得更薄");
    Check(Mathf.Abs(thinWater.r - thinIce.r) + Mathf.Abs(thinWater.g - thinIce.g) + Mathf.Abs(thinWater.b - thinIce.b) > .1f, "同样真实厚度的水冰呈现不同表面质感");
    // 用实际像素检查昼夜、光色、方向和自发光，不依赖场景截图主观猜测。
    Color Lit(string id, Vector3 ambient, Vector3 direct, Vector3 direction, bool nativeView = false, Texture texture = null)
    {
        Begin(); cmd.SetGlobalVector("_FP_AmbCol", ambient); cmd.SetGlobalVector("_FP_LightCol", direct); cmd.SetGlobalVector("_FP_LightDir", direction);
        var p = new MaterialPropertyBlock(); p.SetColor("_Dye", Color.white); p.SetFloat("_UseSkinning", 0); p.SetFloat("_WorldTime", 0);
        if (texture != null) p.SetTexture("_MainTex", texture);
        p.SetMatrix("_FormMatrix", Matrix4x4.identity); p.SetMatrix("_FormNormalMatrix", Matrix4x4.identity); p.SetFloat("_TerrainEnabled", 0);
        cmd.SetViewProjectionMatrices(camera.worldToCameraMatrix, GL.GetGPUProjectionMatrix(camera.projectionMatrix, true));
        bool opaque = resource.Surface(id, nativeView).GetFloat("_ZWrite") > .5f;
        if (nativeView || !opaque) cmd.SetRenderTarget(color, color.depthBuffer);
        cmd.DrawMesh(mesh, Matrix4x4.identity, resource.Surface(id, nativeView), 0, nativeView ? 0 : opaque ? 2 : 1, p); Graphics.ExecuteCommandBuffer(cmd); return Pixel(color);
    }
    float Luminance(Color c) => c.r * .2126f + c.g * .7152f + c.b * .0722f;
    foreach (string id in new[] { "metal", "wood", "skin", "water", "ice", "foam" })
    {
        var day = Lit(id, Vector3.one * .34f, Vector3.one * .55f, Vector3.back); var night = Lit(id, Vector3.one * .017f, Vector3.one * .0275f, Vector3.back); var dark = Lit(id, Vector3.zero, Vector3.zero, Vector3.back);
        Check(Luminance(day) > Luminance(night) * 10 && Luminance(dark) < .0001f && Mathf.Abs(day.a - night.a) < .0001f, "昼夜和完全无光改变表面亮度，不改变透明度：" + id);
    }
    var warm = Lit("metal", Vector3.zero, new Vector3(.6f, .05f, .02f), Vector3.back); var cool = Lit("metal", Vector3.zero, new Vector3(.02f, .05f, .6f), Vector3.back);
    Check(warm.r > warm.b * 5 && cool.b > cool.r * 5, "反光采用实际主光颜色");
    var toward = Lit("wood", Vector3.one * .1f, Vector3.one * .55f, Vector3.back); var away = Lit("wood", Vector3.one * .1f, Vector3.one * .55f, Vector3.forward);
    Check(Luminance(toward) > Luminance(away) * 2, "实际主光方向改变木体受光");
    foreach (string id in new[] { "molten_iron", "flame" })
    {
        var dark = Lit(id, Vector3.zero, Vector3.zero, Vector3.back); var glow = Pixel(data);
        Check(Luminance(dark) > .05f && glow.a > .99f, "无外部光仍发亮并提交真实发光资料：" + id);
    }
    var nativeDay = Lit("metal", Vector3.one, Vector3.one, Vector3.back, true); var nativeNight = Lit("metal", Vector3.zero, Vector3.zero, Vector3.back, true);
    Check(Luminance(nativeDay) > .05f && Mathf.Abs(Luminance(nativeDay) - Luminance(nativeNight)) < .0001f, "三维光照资料不污染原版投影通道");
    // 确认实际着色通道仍采样纹理、执行骨架变换，未退回单纯面色。
    var textured = Lit("metal", Vector3.one * .34f, Vector3.zero, Vector3.back, false, Texture2D.whiteTexture); var plain = Lit("metal", Vector3.one * .34f, Vector3.zero, Vector3.back, false, Texture2D.blackTexture);
    Check(metal.GetTexture("_MainTex").width == 128 && Luminance(textured) > Luminance(plain) + .04f, "发布表面细节纹理存在且实际参与三维着色");
    mesh.SetUVs(1, Enumerable.Repeat(Vector4.zero, 4).ToList()); mesh.SetUVs(2, Enumerable.Repeat(new Vector4(1, 0, 0, 0), 4).ToList());
    Begin(); var bones = Enumerable.Repeat(Matrix4x4.identity, 32).ToArray(); bones[0] = Matrix4x4.Translate(Vector3.right * 1.5f); var skin = new MaterialPropertyBlock(); skin.SetFloat("_UseSkinning", 1); skin.SetMatrixArray("_FormBones", bones); skin.SetColor("_Dye", Color.white); cmd.DrawMesh(mesh, Matrix4x4.identity, metal, 0, 2, skin); Graphics.ExecuteCommandBuffer(cmd); Pixel(color);
    Check(read.GetPixel(10, 16).a < .001f && read.GetPixel(26, 16).a > .99f, "真实三维通道按发布骨架和顶点权重移动几何");
    // 验证真实合成入口：颠倒发布顺序和实例透明度都参与共同提交。
    var type = typeof(FormVisualScene).Assembly.GetType("Cultiway.Content.Compatibility.Worldfall.FormWorldfallRenderer");
    var prepare = type.GetMethod("Prepare", Flags); var drawTransparent = type.GetMethod("DrawTransparent", Flags); var clear = type.GetMethod("Clear", Flags);
    var external = AppDomain.CurrentDomain.GetAssemblies().Select(a => a.GetType("FirstPerson.Gpu.GpuRenderer")).FirstOrDefault(t => t != null);
    Check(external != null, "实际加载Worldfall，执行共用透明入口");
    object renderer = FormatterServices.GetUninitializedObject(external);
    external.GetField("_sceneCol", Flags).SetValue(renderer, color); external.GetField("_front", Flags).SetValue(renderer, color);
    string source = "surface-depth-verification";
    object[] Rows(string key) => ((IEnumerable)type.GetField(key, Flags).GetValue(null)).Cast<object>().Where(v => ReferenceEquals(v.GetType().GetField("Resource", Flags).GetValue(v), resource)).ToArray();
    void Prepare() { prepare.Invoke(null, new object[] { (Func<float, float, float>)((x, y) => 0), (Func<long, Vector3>)(id => Vector3.zero) }); }
    try
    {
        FormVisualScene.Publish(source, new[] { new FormVisualInstance(resource, Matrix4x4.Translate(new Vector3(0, 0, 1)), surface: "metal", tint: new Color(1, 0, 0, .4f)), new FormVisualInstance(resource, Matrix4x4.Translate(new Vector3(0, 0, 5)), surface: "metal", tint: new Color(0, 0, 1, .4f)), new FormVisualInstance(resource, Matrix4x4.identity, surface: "metal") });
        Prepare(); Check(Rows("solids").Length == resource.Meshes.Length && Rows("transparent").Length == resource.Meshes.Length * 2, "实体和实例半透明色正确分层");
        Begin(); drawTransparent.Invoke(null, new[] { renderer, (object)cmd }); Graphics.ExecuteCommandBuffer(cmd); var first = Pixel(color);
        FormVisualScene.Publish(source, new[] { new FormVisualInstance(resource, Matrix4x4.Translate(new Vector3(0, 0, 5)), surface: "metal", tint: new Color(0, 0, 1, .4f)), new FormVisualInstance(resource, Matrix4x4.Translate(new Vector3(0, 0, 1)), surface: "metal", tint: new Color(1, 0, 0, .4f)) });
        Prepare(); Begin(); drawTransparent.Invoke(null, new[] { renderer, (object)cmd }); Graphics.ExecuteCommandBuffer(cmd); var reversed = Pixel(color);
        Check(Mathf.Abs(first.r - reversed.r) + Mathf.Abs(first.g - reversed.g) + Mathf.Abs(first.b - reversed.b) < .01f, "实际三维入口反转发布顺序保持透明合成");
        FormVisualScene.Publish(source, Array.Empty<FormVisualInstance>()); clear.Invoke(null, null);
        Check(!((IEnumerable)type.GetField("solids", Flags).GetValue(null)).Cast<object>().Any() && !((IEnumerable)type.GetField("transparent", Flags).GetValue(null)).Cast<object>().Any(), "清理世界释放两类绘制引用");
    }
    finally { FormVisualScene.Publish(source, Array.Empty<FormVisualInstance>()); clear.Invoke(null, null); }
}
finally
{
    RenderTexture.active = previous; cmd.Release(); color.Release(); data.Release(); UnityEngine.Object.Destroy(color); UnityEngine.Object.Destroy(data); UnityEngine.Object.Destroy(read); UnityEngine.Object.Destroy(mesh); UnityEngine.Object.Destroy(go);
    foreach (var v in globals) Shader.SetGlobalVector(v.Key, v.Value); Shader.SetGlobalMatrix("_FP_VP", previousMatrix);
}
float[] Channels(Color c) => new[] { c.r, c.g, c.b, c.a };
var result = new { checks, solidPixel = Channels(solidPixel), metadata = Channels(metadata), occluded = Channels(occluded), transparentPixel = Channels(transparentPixel), device = SystemInfo.graphicsDeviceName, graphics = SystemInfo.graphicsDeviceType.ToString() }; File.WriteAllText(Path.Combine(folder, "checks.json"), JsonConvert.SerializeObject(result, Formatting.Indented)); return result;
