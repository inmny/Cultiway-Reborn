Actor source = Make(64), enemy = Make(72, "wolf"); var owner = source.GetExtend();
owner.NewCultisys(Cultisyses.Xian); owner.GetCultisys<Xian>().level = 2;
owner.MarkCultiwayStatsDirty(); source.setStatsDirty(); source.updateStats();
var active = new List<AbilityCast>(); var credits = new List<ConstructedRecovery>(); var materials = new List<WorldMaterialChange>();
void Started(ConstructedCastStarted fact)
{
    if (fact.SourceId != source.id) return;
    foreach (object running in (IEnumerable)service.GetField("casts", F).GetValue(null))
        if ((long)Field(running, "Id") == fact.CastId) active.Add((AbilityCast)Field(running, "Cast"));
}
void Credit(ConstructedRecovery fact) { if (fact.ProviderId == source.id) credits.Add(fact); }
void Material(WorldMaterialChange fact) { if (fact.Provider == source.id) materials.Add(fact); }
ConstructedAbilityService.CastStarted += Started; ConstructedAbilityService.RecoveryConfirmed += Credit; WorldMaterialService.Changed += Material;
try
{
    for (int index = 0; index < 4; index++)
    {
        var definition = JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(folder, "input-creation", "derived-" + index + ".json")));
        Ready(source); await Advance(.2f); Place(source, 64); Place(enemy, 72);
        owner.GetCultisys<Xian>().wakan = source.stats[BaseStatses.MaxWakan.id] * .8f;
        float balance = owner.GetCultisys<Xian>().wakan;
        Check(definition.Cost > 0 && definition.Cost <= balance, "成品处于当前真实资源容量 " + index, new { definition.Cost, balance });
        await Fire(definition, source, enemy); float paid = balance - owner.GetCultisys<Xian>().wakan;
        owner.E.RemoveComponent<ConstructedKnowledge>(); var live = active.Last(); double initialVolume = live.RemainingVolume(0);
        Check(Math.Abs(paid - definition.Cost) < .001f, "结束去向成品按原报价实际支付 " + index);
        if (index == 0)
        {
            float before = live.RemainingForce(0); double principal = live.RemainingResource(0);
            await Advance(definition.Root.DisappearAt.Value + .1f);
            int count = definition.Root.Children.Length;
            Check(live.RemainingForce(0) == 0 && live.RemainingVolume(0) == 0 && live.RemainingResource(0) == 0 &&
                Math.Abs(Enumerable.Range(1, count).Sum(live.RemainingForce) - before) < .001f &&
                Math.Abs(Enumerable.Range(1, count).Sum(live.RemainingVolume) - initialVolume) < .0001 &&
                Math.Abs(Enumerable.Range(1, count).Sum(live.RemainingResource) - principal) < .0001,
                "来源正常结束才守恒交出力量、体积与原支付，后段没有额外本金");
            var shape = Shapes(live).Where(value => value.Node > 0).OrderBy(value => Mathf.Min(value.A.z, value.B.z) - value.Radius).First();
            Vector3 point = (shape.A + shape.B) * .5f; Place(enemy, point.x, point.y); int hp = enemy.data.health;
            await Advance(.2f);
            Check(contacts.Any(contact => contact.AbilityId == definition.Id && contact.Node > 0 && contact.TargetId == enemy.id) && enemy.data.health < hp,
                "实际后段通过共同接触命中并扣血", new { hp, after = enemy.data.health });
        }
        if (index == 1)
        {
            var operation = definition.Root.Operations.Single(operation => operation.Kind == ConstructionOperationKind.Flow);
            await Advance(operation.At + .2f); var shapes = Shapes(live);
            Check(typeof(AbilityCast).GetMethod("FlowBounds", F).Invoke(live, new object[] { 0 }) != null &&
                shapes.Count > 0 && shapes.All(shape => shape.IsBox && shape.Material.Id == "water" && shape.Material.State == "liquid") &&
                live.RemainingVolume(0) > 0 && live.RemainingVolume(0) <= initialVolume + .0001,
                "真实液态进入水层，实际薄层作用区及有限体积一致", new { shapes = shapes.Count, volume = live.RemainingVolume(0) });
        }
        if (index == 2)
        {
            var operation = definition.Root.Operations.Single(operation => operation.Kind == ConstructionOperationKind.Recover);
            await Advance(operation.At + operation.Seconds + .1f);
            double granted = credits.Where(fact => fact.AbilityId == definition.Id).Sum(fact => fact.Granted);
            Check(granted > 0 && Math.Abs(granted - paid * operation.Recovery.Efficiency) < .001 &&
                live.RemainingResource(0) == 0 && live.RemainingVolume(0) == 0,
                "实际原支付按声明比例入账，材料与可退本金同时退出", new { paid, granted, operation.Recovery.Efficiency });
        }
        await Advance(Math.Max(.1f, definition.Lifetime - live.Age + .2f));
        Check(live.Finished && !BodyControlState.IsBusy(source.id), "成品自然结束且控制恢复 " + index);
        if (index == 3)
        {
            var accepted = materials.Where(fact => fact.AbilityId == definition.Id && fact.Kind == "leave").ToArray();
            var rows = (JArray)JObject.Parse(Cultiway.ModClass.I.WorldSaves.World.Capture(World.world, "ending-materials"))["sections"]["world_materials"]["data"]["Records"];
            Check(accepted.Length == 1 && accepted[0].Volume > 0 && rows.Any(row => (long)row["Id"] == accepted[0].Id) &&
                live.RemainingResource(0) == 0 && live.RemainingVolume(0) == 0,
                "原施放结束后真实留置仍独立存在，来源份额清零且只转交一次");
        }
    }
    var again = JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(folder, "input-creation", "derived-0.json")));
    ConstructedAbilityService.Learn(owner, again.Id); owner.GetCultisys<Xian>().wakan = 0;
    int beforeCount = active.Count;
    bool failed = ActiveAbilityService.TryUse(owner, new ActiveAbilityHandle("content.constructed", owner.E, again.Id),
        new ActiveAbilityTarget(enemy, enemy.GetSimPos()), ActiveAbilityUseOrigin.Script);
    Check(!failed && active.Count == beforeCount && owner.GetCultisys<Xian>().wakan == 0 && !BodyControlState.IsBusy(source.id),
        "余额不足不产生施放、材料或控制占用");
    owner.GetCultisys<Xian>().wakan = source.stats[BaseStatses.MaxWakan.id] * .8f;
    Ready(source); Place(source, 64); Place(enemy, 72); await Fire(again, source, enemy); owner.E.RemoveComponent<ConstructedKnowledge>();
    await Advance(again.Lifetime + .2f);
    Check(active.Count == beforeCount + 1 && active.Last().Finished, "失败后同一成品能够正常再次施放及结束");
    return new { passed = true, closed = "四类创作成品的真实交接、流散、回能、留置与恢复", process = System.Diagnostics.Process.GetCurrentProcess().Id };
}
finally
{
    ConstructedAbilityService.CastStarted -= Started; ConstructedAbilityService.RecoveryConfirmed -= Credit; WorldMaterialService.Changed -= Material;
    ConstructedAbilityService.ContactConfirmed -= Hit; ConstructedAbilityService.CastEnded -= Ended;
    File.WriteAllText(Path.Combine(folder, "events.json"), JsonConvert.SerializeObject(new { contacts = contacts.Select(contact => new { contact.AbilityId, contact.CastId, contact.SourceId, contact.TargetId, contact.Node, contact.Age, contact.DamageAttempted, position = new[] { contact.Position.x, contact.Position.y, contact.Position.z } }).ToArray(), credits, materials }, Formatting.Indented));
    Config.paused = true; ControllableUnit.clear(false);
}
