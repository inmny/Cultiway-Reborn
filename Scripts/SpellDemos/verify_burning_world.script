// 世界间、活动与世界之间传热和灭火，所有主体经正式学习、支付和施放建立。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Usage;
using Cultiway.Content.Skills;
using Cultiway.Content.Components;
using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/burning");var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;var t=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=t.GetProperty("Instance").GetValue(null);await Game.WaitUntil(()=>(bool)t.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);}
Config.paused=true;Game.Resume();Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;for(int y=40;y<110;y++)for(int x=30;x<124;x++)World.world.GetTileSimple(x,y).setTileTypes("sand",null);var stats=new BaseStats();stats["mana"]=2048;stats["damage"]=40;stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.BurningWorldHold").SetStats(stats).SetDuration(10000).Build();Actor Actor(int x){var a=World.world.units.createNewUnit("human",World.world.GetTileSimple(x,72),pAdultAge:true,pSpawnWithItems:false);a.addTrait("super_health");a.GetExtend().AddComponent(new Xian{level=2,wakan=100});Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(a,hold,10000,a);a.GetExtend().MarkCultiwayStatsDirty();a.setStatsDirty();a.updateStats();a.setMana(1024);return a;}var source=Actor(50);var supply=Actor(70);var target=Actor(90);var wolf=World.world.units.createNewUnit("wolf",World.world.GetTileSimple(12,12),pAdultAge:true);Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(wolf,hold,10000,wolf);target.setKingdom(wolf.kingdom);source.addAggro(target);target.addAggro(source);await Advance(.1f);
void Align(Actor actor,float x,float y){actor.stopMovement();actor.current_position=new Vector2(x,y);actor.setCurrentTile(World.world.GetTileSimple((int)x,(int)y));actor.updatePos();}Align(source,50,72);Align(target,90,72);
void PlaceSupply(int y){supply.stopMovement();supply.current_position=new Vector2(70,y);supply.setCurrentTile(World.world.GetTileSimple(70,y));supply.updatePos();}
AbilityDefinition Spell(string name)=>JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/"+name+".json")));bool Fire(Actor from,Actor to,AbilityDefinition d){if(from==supply)PlaceSupply(72);ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(from.GetExtend(),d.Id);bool used=ActiveAbilityService.TryUse(from.GetExtend(),new ActiveAbilityHandle("content.constructed",from.GetExtend().E,d.Id),new ActiveAbilityTarget(to,to.GetSimPos()),ActiveAbilityUseOrigin.Script);if(from==supply)PlaceSupply(96);return used;}IList Casts()=>(IList)typeof(ConstructedAbilityService).GetField("casts",F).GetValue(null);AbilityCast Running(string id)=>Casts().Cast<object>().Select(r=>(AbilityCast)r.GetType().GetField("Cast",F).GetValue(r)).Single(c=>c.Plan.Id==id&&!c.Finished);void Cancel(){foreach(object r in Casts())((AbilityCast)r.GetType().GetField("Cast",F).GetValue(r)).Cancel();}JArray Rows()=>(JArray)JObject.Parse(Cultiway.ModClass.I.WorldSaves.World.Capture(World.world,"burning-world"))["sections"]["world_materials"]["data"]["Records"];
AbilityDefinition Wood(string id,bool world,float volume=1){var d=Spell("可燃分枝");d.Id=id;d.Root.Scale=1;d.Root.Volume=volume;d.Root.Offset=new float[3];d.Root.Children=Array.Empty<ConstructionNode>();d.Lifetime=8;d.Root.Operations=world?new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Leave,At=0,Residue=new ConstructionResidue{Lifetime=0}}}:Array.Empty<ConstructionOperation>();return d;}AbilityDefinition Water(string id,bool world){var d=Spell("蓄水御炎");d.Id=id;d.Root.Volume=32;d.Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Flow).Flow.Size=8;if(world)d.Root.Operations=d.Root.Operations.Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Leave,At=0,Residue=new ConstructionResidue{Lifetime=0}}}).ToArray();return d;}
var events=new List<ConstructedBurning>();void Burn(ConstructedBurning e)=>events.Add(e);ConstructedAbilityService.BurningConfirmed+=Burn;
try{
var first=Wood("test.burning.world.source",true,4);Check(Fire(supply,supply,first),"第一个世界木体正式支付并留置");await Advance(.1f);long firstId=(long)Rows().Single()["Id"];var flame=Spell("点木流火");flame.Id="test.burning.world.setup-fire";flame.Power=.02f;flame.Root.Scale=.5f;Check(Fire(source,target,flame),"正式火体点燃世界热源");await Advance(1.6f);Cancel();await Advance(.1f);Check(Rows().Single()["Material"].ToObject<AbilityMaterialData>().Burning?.Lit==true,"初始火体结束后世界木体仍依靠有限燃料燃烧");var active=Wood("test.burning.world.to-active",false);Check(Fire(supply,supply,active),"后续活动木体在原火施放结束后才生成");var receiver=Running(active.Id);await Advance(.4f);Check(receiver.Burning(0).Lit&&events.Any(e=>e.Kind=="heat"&&e.SourceWorldId==firstId&&e.CastId>0),"世界木体经实际接触点燃活动木体，保留真实世界热源编号");var second=Wood("test.burning.world.second",true);Check(Fire(supply,supply,second),"第二个世界木体在点火术结束后才留置");await Advance(.4f);Check(Rows().Count==2&&Rows().All(r=>r["Material"].ToObject<AbilityMaterialData>().Burning?.Lit==true),"世界木体之间真实传火，不依赖任何活动火术");Check(events.Any(e=>e.Kind=="heat"&&e.WorldId>0&&e.SourceWorldId==firstId),"世界传播分别记录接收者与实际世界来源");
var cooling=Water("test.burning.world.active-water",false);Check(Fire(supply,supply,cooling),"活动水体经正式入口进入燃烧区域");await Advance(.3f);Check(Rows().All(r=>r["Material"].ToObject<AbilityMaterialData>().Burning?.Lit!=true)&&!receiver.Burning(0).Lit,"活动水同时熄灭世界热源和活动热源");Check(events.Any(e=>e.Kind=="cool"&&e.WorldId==firstId)&&events.Any(e=>e.Kind=="cool"&&e.CastId>0),"双方灭火均有真实热量扣除结果");double preserved=Rows().Sum(r=>(double)r["Material"]["Volume"]);await Advance(.3f);Check(Math.Abs(Rows().Sum(r=>(double)r["Material"]["Volume"])-preserved)<.0001,"熄灭后剩余木料保持实际数量，不继续烧损或补满");
// 在另一处重新建立活动热源，验证它能冷却于已经留置的独立水体。
Cancel();await Advance(.1f);var away=Wood("test.burning.active.source",false,4);away.Root.Offset=new[]{0f,12f,0f};Check(Fire(supply,supply,away),"另一处活动木体独立生成");var hot=Running(away.Id);var ignite=Spell("点木流火");ignite.Id="test.burning.active.setup-fire";ignite.Power=.02f;ignite.Root.Scale=.5f;ignite.Root.Offset=new[]{20f,12f,0f};ignite.Root.Operations=Array.Empty<ConstructionOperation>();Check(Fire(source,target,ignite),"定点火体通过普通构造正式点火");await Advance(.2f);Check(hot.Burning(0).Lit,"新位置的活动木体真实点燃");Running(ignite.Id).Cancel();await Advance(.1f);long hotId=events.Last(e=>e.Kind=="heat"&&e.CastId>0&&e.Lit).CastId;var received=Wood("test.burning.active.to-world",true,.5f);received.Root.Offset=new[]{0f,12f,0f};Check(Fire(supply,supply,received),"原点火术结束后再建立独立接收木体");await Advance(.3f);Check(events.Any(e=>e.Kind=="heat"&&e.WorldId>0&&e.SourceCastId==hotId),"活动燃烧木体真实向世界木体转移热量，不借用旧点火术");var independent=Water("test.burning.world.water",true);independent.Root.Offset=new[]{0f,12f,0f};Check(Fire(supply,supply,independent),"独立世界水体正式留置在活动热源处");await Advance(.3f);Check(!hot.Burning(0).Lit&&hot.Burning(0).Heat==0,"活动燃烧木体被世界水体真实熄灭");
var result=new{passed=true,checks};File.WriteAllText(Path.Combine(folder,"world.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{ConstructedAbilityService.BurningConfirmed-=Burn;Config.paused=true;}
