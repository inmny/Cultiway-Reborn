// 真正退出后的另一进程：构造、知识及人物资源只恢复一次。
using System;
using System.IO;
using System.Linq;
using System.Collections.Generic;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Content.Skills;
using Cultiway.Utils.Extension;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/recovery");var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}JToken Section(string s,string id)=>JObject.Parse(s)["sections"][id]["data"];var saves=Cultiway.ModClass.I.WorldSaves;
foreach(string suffix in new[]{"","/ui","/resources"}){string path=folder+suffix;var expected=JObject.Parse(File.ReadAllText(Path.Combine(path,"restart-expected.json")));Check((int)expected["process"]!=System.Diagnostics.Process.GetCurrentProcess().Id,"另一进程建立的保存依据："+suffix);Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(path,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;var actor=World.world.units.get((long)expected["actor"]);Check(actor!=null,"恢复真实原人物："+suffix);Check(JToken.DeepEquals(Section((string)expected["world"],"ability_constructions"),Section(saves.World.Capture(World.world,"recovery"),"ability_constructions")),"构造和真实收束参数原样恢复："+suffix);Check(JToken.DeepEquals(Section((string)expected["person"],"ability_knowledge"),Section(saves.Actors.Capture(actor.GetExtend(),"recovery"),"ability_knowledge")),"已学与冷却原样恢复："+suffix);Check(!saves.LastReport.RequiresBackup,"本批新增资料未造成局部丢弃："+suffix);string id=suffix==""?"Cultiway.Demo.WaterRecovery":(string)expected["id"];var d=ConstructionEditing.Access.Read(id);var o=d.Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Recover);Check(AbilityCompiler.Compile(d).HasRecovery&&o.Seconds==(suffix==""?1:suffix=="/ui"?.8f:.6f)&&o.Recovery.Efficiency==(suffix=="/ui"?.5f:.75f),"真实历时与效率恢复："+suffix);if(suffix=="/resources"){Check(Math.Abs(actor.GetExtend().GetCultisys<Cultiway.Content.Components.Xian>().wakan-(float)expected["wakan"])<.0001,"已真实返还的真元恢复为人物事实");int replay=0;void Count(ConstructedRecovery r){replay++;}ConstructedAbilityService.RecoveryConfirmed+=Count;try{double start=World.world.getCurWorldTime();Config.paused=false;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=start+1,1800);Config.paused=true;Check(replay==0,"读档不重放旧施放或再次发放回能");}finally{ConstructedAbilityService.RecoveryConfirmed-=Count;Config.paused=true;}}}
var result=new{passed=true,checks,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"restart-result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
