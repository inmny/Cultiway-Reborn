// 正式支付及施放：强水灭火、弱水余火、友方水、世界水、真实蒸散与保存。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Usage;
using Cultiway.Content.Skills;
using Cultiway.Content.Components;
using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/quenching");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool value,string name){if(!value)throw new Exception(name);checks.Add(name);}
async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;var t=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=t.GetProperty("Instance").GetValue(null);await Game.WaitUntil(()=>(bool)t.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);}
Config.paused=true;Game.Resume();Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;for(int y=40;y<110;y++)for(int x=30;x<124;x++)World.world.GetTileSimple(x,y).setTileTypes("sand",null);
var stats=new BaseStats();stats["mana"]=1024;stats["damage"]=40;stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.QuenchingHold").SetStats(stats).SetDuration(10000).Build();
Actor NewActor(int x,int y){var p=World.world.units.createNewUnit("human",World.world.GetTileSimple(x,y),pAdultAge:true,pSpawnWithItems:false);p.addTrait("super_health");p.GetExtend().AddComponent(new Xian{level=2,wakan=100});Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(p,hold,10000,p);p.GetExtend().MarkCultiwayStatsDirty();p.setStatsDirty();p.updateStats();p.setMana(512);return p;}
void Place(Actor p,float x,float y){p.stopMovement();p.current_position=new Vector2(x,y);p.setCurrentTile(World.world.GetTileSimple((int)x,(int)y));p.updatePos();}
var source=NewActor(50,72);var supply=NewActor(70,72);var target=NewActor(90,72);var wolf=World.world.units.createNewUnit("wolf",World.world.GetTileSimple(12,12),pAdultAge:true);Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(wolf,hold,10000,wolf);target.setKingdom(wolf.kingdom);source.addAggro(target);target.addAggro(source);await Advance(.1f);Place(source,50,72);Place(supply,70,72);Place(target,90,72);
AbilityDefinition Spell(string name)=>JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/"+name+".json")));
void Learn(Actor p,AbilityDefinition d){ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(p.GetExtend(),d.Id);}
bool Fire(Actor p,Actor to,AbilityDefinition d){Learn(p,d);return ActiveAbilityService.TryUse(p.GetExtend(),new ActiveAbilityHandle("content.constructed",p.GetExtend().E,d.Id),new ActiveAbilityTarget(to,to.GetSimPos()),ActiveAbilityUseOrigin.Script);}
IList Casts()=>(IList)typeof(ConstructedAbilityService).GetField("casts",F).GetValue(null);AbilityCast Running(string id)=>Casts().Cast<object>().Select(r=>(AbilityCast)r.GetType().GetField("Cast",F).GetValue(r)).Single(c=>c.Plan.Id==id&&!c.Finished);void Cancel(){foreach(object r in Casts())((AbilityCast)r.GetType().GetField("Cast",F).GetValue(r)).Cancel();}
var reactions=new List<ConstructedQuenching>();var contacts=new List<ConstructedContact>();void Reaction(ConstructedQuenching e)=>reactions.Add(e);void Contact(ConstructedContact e)=>contacts.Add(e);ConstructedAbilityService.QuenchingConfirmed+=Reaction;ConstructedAbilityService.ContactConfirmed+=Contact;
try{
var water=Spell("蓄水御炎");water.Id="test.quenching.strong";Check(Fire(supply,supply,water),"友方供水正式学习支付并施放");await Advance(.2f);var wet=Running(water.Id);double waterBefore=wet.RemainingVolume(0),budgetBefore=wet.RemainingResource(0);var fire=Spell("离体炎流");fire.Id="test.quenching.extinguished";fire.Power=1;float hp=target.data.health;Check(Fire(source,target,fire),"真实火体正式支付并离体运动");var flame=Running(fire.Id);float force=flame.RemainingForce(0);await Advance(3.1f);Check(reactions.Count>0&&reactions.All(e=>e.WaterCast>0&&e.WorldWater.Length==0),"活动水体与友方火体发生真实反应");double evaporated=reactions.Sum(e=>e.Evaporated);Check(Math.Abs(force-reactions.Sum(e=>e.Spent))<.001&&flame.RemainingForce(0)==0,"水足够时有限火作用量全部耗尽");Check(Math.Abs(wet.RemainingVolume(0)+evaporated-waterBefore)<.002&&wet.RemainingVolume(0)>0,"活动水体保留未蒸散的真实剩余量");Check(Math.Abs(wet.RemainingResource(0)-budgetBefore*(1-evaporated/waterBefore))<.001,"失水支付不会重复返还");Check(target.data.health>=hp&&contacts.Count==0,"先灭火再处理人物受击，完整旧伤害没有穿过水域");Check(reactions.All(e=>Math.Abs(e.Spent-e.Evaporated*4)<.001),"逐次反应量符合明确的水火比例");
Cancel();await Advance(.1f);reactions.Clear();contacts.Clear();var weak=Spell("蓄水御炎");weak.Id="test.quenching.weak";weak.Root.Form="hand";weak.Root.Volume=1;weak.Root.Operations=Array.Empty<ConstructionOperation>();Check(Fire(supply,supply,weak),"有限刚性水体同样走正式构造");var weakCast=Running(weak.Id);fire=Spell("离体炎流");fire.Id="test.quenching.remaining";hp=target.data.health;Check(Fire(source,target,fire),"强火进入少量生成水体");flame=Running(fire.Id);force=flame.RemainingForce(0);await Advance(3.1f);Check(Math.Abs(reactions.Sum(e=>e.Evaporated)-1)<.0001&&weakCast.RemainingVolume(0)==0,"水少时只蒸散原有一份水");Check(Math.Abs(reactions.Sum(e=>e.Spent)-4)<.0001&&reactions.Last().Remaining>0,"强火保留剩余作用量而非被任意水滴全部抵消");Check(contacts.Count>0&&target.data.health<hp,"剩余火体继续沿原路径造成真实人物伤害");
Cancel();await Advance(.1f);reactions.Clear();contacts.Clear();var high=Spell("蓄水御炎");high.Id="test.quenching.high";high.Root.Form="hand";high.Root.Volume=8;high.Root.Offset=new[]{0f,0f,20f};high.Root.Operations=Array.Empty<ConstructionOperation>();Check(Fire(supply,supply,high),"高处水体正式存在");fire=Spell("离体炎流");fire.Id="test.quenching.height";Check(Fire(source,target,fire),"低处火体继续运行");await Advance(3.1f);Check(reactions.Count==0&&contacts.Count>0,"平面投影重合但实际高度分离时不凭空蒸散");
Cancel();await Advance(.1f);reactions.Clear();contacts.Clear();var tinyWater=Spell("蓄水御炎");tinyWater.Id="test.quenching.tiny-water";Check(Fire(supply,supply,tinyWater),"微小火力验证使用真实活动水体");await Advance(.2f);var tiny=Spell("离体炎流");tiny.Id="test.quenching.tiny-fire";tiny.Power=1e-12f;Check(Fire(source,target,tiny),"微小作用量仍走正式施放入口");await Advance(1f);Check(reactions.Count==1&&reactions[0].Evaporated==0&&reactions[0].Spent>0&&reactions[0].Remaining==0,"低于水量分辨率的余火被有限吸收，不虚报蒸散或无限重试");Check(Cultiway.Core.Visuals.Forms.FormVisualScene.Instances.All(v=>v.Resource.Description.Id!="reaction_steam"),"没有实际减水时不播放蒸散曲面");await Advance(2.1f);
Cancel();await Advance(.1f);reactions.Clear();contacts.Clear();var left=Spell("蓄水御炎");left.Id="test.quenching.world";left.Root.Operations=left.Root.Operations.Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Leave,At=0,Residue=new ConstructionResidue{Lifetime=60}}}).ToArray();Check(Fire(supply,supply,left),"水体正式转交世界");await Advance(.2f);Check(WorldMaterialService.Count>0,"独立世界材料已存在");fire=Spell("离体炎流");fire.Id="test.quenching.world-fire";fire.Power=1;hp=target.data.health;Check(Fire(source,target,fire),"火体进入已经结束施放的世界水体");await Advance(3.1f);Check(reactions.Count>0&&reactions.All(e=>e.WaterCast==0&&e.WorldWater.Length>0),"世界水体参与实际相消并保留真实材料来源");Check(reactions.Last().Remaining==0&&contacts.Count==0,"独立水域在人物受击之前真正灭火");
var saved=Spell("离体炎流");saved.Id="test.quenching.restored";saved.Power=1;Learn(source,saved);foreach(var p in World.world.units.dict.Values.ToArray()){Cultiway.Content.Combat.CombatStatusEffects.RemoveStatus(p,hold);p.GetExtend().MarkCultiwayStatsDirty();p.setStatsDirty();p.updateStats();}SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,actor=source.id,target=target.id,definition=saved,world=Cultiway.ModClass.I.WorldSaves.World.Capture(World.world,"quenching")},Formatting.Indented));Check(File.Exists(Path.Combine(folder,"save/map.wbox")),"真实减水后的世界和已学火术通过正式保存");
var result=new{passed=true,checks,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"runtime.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{File.WriteAllText(Path.Combine(folder,"reactions.json"),JsonConvert.SerializeObject(reactions.Select(r=>new{r.FireCast,r.WaterCast,r.FireNode,r.WaterNode,r.WorldWater,point=new[]{r.Point.x,r.Point.y,r.Point.z},r.WorldTime,r.Evaporated,r.Spent,r.Remaining}),Formatting.Indented));ConstructedAbilityService.QuenchingConfirmed-=Reaction;ConstructedAbilityService.ContactConfirmed-=Contact;Config.paused=true;}
