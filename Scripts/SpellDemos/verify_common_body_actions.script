// 4.17共用动作：实际部位、距离、方向、速度、尺度、正式接触与恢复。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core;
using Cultiway.Core.Skills;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Usage;
using Cultiway.Core.Visuals.Forms;
using Cultiway.Content;
using Cultiway.Core.SkillLibV3.Effects;
using Cultiway.Content.Combat;
using Cultiway.Content.Components;
using Cultiway.Content.Skills;
using Cultiway.Utils.Extension;
using Cultiway.Content.YaoBeasts;
using Cultiway.Content.CreatureCompositions.Components;
using Cultiway.Content.CreatureCompositions.Services;
using Cultiway.Content.CreatureCompositions.Visuals;
const BindingFlags F = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static |
                       BindingFlags.Instance;
string root = Cultiway.ModClass.I.GetDeclaration().FolderPath;
string folder = Path.Combine(root, "artifacts/skill_rebuild/common-body-actions");
Directory.CreateDirectory(folder);
var checks = new List<object>();
var contacts = new List<ConstructedContact>();

void Check(bool ok, string name, object data = null)
{
    checks.Add(new { pass = ok, name, data });
    File.WriteAllText(Path.Combine(folder, "checks.json"),
        JsonConvert.SerializeObject(new { checks }, Formatting.Indented));
    if (!ok) throw new InvalidOperationException(name);
}

var service = typeof(ConstructedAbilityService);
object Field(object value, string name) => value.GetType().GetField(name, F).GetValue(value);
IEnumerable<object> Running() => ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>();
var runnerType = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");
var runner = runnerType.GetProperty("Instance").GetValue(null);
bool Boundary() => (bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner);

async Task Advance(float seconds)
{
    Config.paused = false;
    double until = World.world.getCurWorldTime() + seconds;
    await Game.WaitUntil(() => World.world.getCurWorldTime() >= until &&
                               (double)service.GetProperty("ConfirmedWorldTime", F).GetValue(null) >= until,
        1800);
    Config.paused = true;
    await Game.WaitUntil(Boundary, 1800);
}

Game.Resume();
Config.paused = true;
Config.setWorldSpeed("x1", false);
ControllableUnit.clear(false);
string fixture = Path.Combine(root, "Scripts/WorldSaveTests/Fixtures/world-format-1");
World.world.save_manager.loadWorld(fixture);
await Game.WaitUntil(() => !SmoothLoader.isLoading(), 1800);
Config.paused = true;
await Game.WaitUntil(Boundary, 1800);
for (int x = 60; x <= 75; x++)
for (int y = 67; y <= 78; y++)
    World.world.GetTileSimple(x, y).setTileTypes(TileLibrary.soil_low, TopTileLibrary.grass_low);
var holdStats = new BaseStats();
holdStats.addTag("frozen_ai");
holdStats.addTag("immovable");
var hold = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.Verify.SourceLoss.Hold")
    .SetStats(holdStats).SetDuration(10000).Build();

void Place(Actor a, float x, float y = 72)
{
    a.stopMovement();
    a.stopForce();
    a.current_position = new Vector2(x, y);
    a.setCurrentTile(World.world.GetTileSimple((int)x, (int)y));
    a.updatePos();
}

foreach (Actor a in World.world.units.getSimpleList().ToArray())
{
    CombatStatusEffects.ApplyStatus(a, hold, 10000, a);
    Place(a, 12, 12);
}

Actor Make(float x, string species = "human")
{
    Actor a = World.world.units.createNewUnit(species, World.world.GetTileSimple((int)x, 72),
        pAdultAge: true, pSpawnWithItems: false);
    a.addTrait("super_health");
    CombatStatusEffects.ApplyStatus(a, hold, 10000, a);
    var e = a.GetExtend();
    e.E.RemoveComponent<Xian>();
    e.E.RemoveComponent<Knight>();
    e.E.RemoveComponent<Magic>();
    e.SetPowerLevel(0);
    a.setMana(0);
    a.setStatsDirty();
    a.updateStats();
    a.finishScale();
    a.attack_timer = 999;
    Place(a, x);
    return a;
}

async Task Fire(AbilityDefinition d, Actor a, Actor target, ConstructionWorldScope scope = null,
    Vector3? aim = null)
{
    a.addAggro(target);
    target.addAggro(a);
    ConstructedAbilityService.Register(d);
    ConstructedAbilityService.Learn(a.GetExtend(), d.Id);
    var handle = new ActiveAbilityHandle("content.constructed", a.GetExtend().E, d.Id);
    var choice = aim.HasValue
        ? new ActiveAbilityTarget(null, aim.Value)
        : new ActiveAbilityTarget(target, d.Use?.Target == ActiveAbilityTargetMode.Point
            ? new Vector3(target.current_position.x, target.current_position.y, 0)
            : target.GetSimPos(), worldScope: scope);
    bool used = false;
    for (int attempt = 0; attempt < 30 && !used; attempt++)
    {
        a.attack_timer = 0;
        used = ActiveAbilityService.TryUse(a.GetExtend(), handle, choice, ActiveAbilityUseOrigin.Script);
        if (!used) await Game.NextFrame();
    }

    Check(used, d.Id + "正式施放受理", new
    {
        a.id, flying = a.isFlying(), weapon = a.hasWeapon(),
        frozen = a.stats.hasTag("frozen_ai"), immovable = a.stats.hasTag("immovable"),
        busy = BodyControlState.IsBusy(a.id)
    });
    a.attack_timer = 999;
}

void Hit(ConstructedContact contact)
{
    if (contact.AbilityId.StartsWith("test.common-actions.")) contacts.Add(contact);
}

ConstructedAbilityService.ContactConfirmed += Hit;

void Ready(Actor source)
{
    CombatStatusEffects.RemoveStatus(source, hold);
    source.updateStats();
    ControllableUnit.setControllableCreatureAndSelected(source);
    typeof(ControllableUnit).GetMethod("addStatus", F).Invoke(null, new object[] { source });
    source.attack_timer = 0;
}

var bindingType = service.Assembly.GetType("Cultiway.Content.Skills.BodyActionBinding");

object Binding(Actor actor, CompiledAbility plan)
{
    var spatial = service.Assembly.GetType("Cultiway.Content.Combat.SpatialActorPose");
    Vector3 foot = (Vector3)spatial.GetMethod("Foot", F).Invoke(null, new object[] { actor });
    float height = (float)spatial.GetMethod("Height", F).Invoke(null, new object[] { actor });
    return bindingType.GetMethod("TryCreate", F).Invoke(null,
        new object[] { actor, plan.Body, Vector3.right, foot + new Vector3(1, 0, height * .62f), 0f });
}

BodyFrame Frame(object binding, Actor actor) => (BodyFrame)bindingType.GetMethod("Frame", F, null,
    new[] { typeof(Actor) }, null).Invoke(binding, new object[] { actor });

AbilityDefinition Create(BodyActionKind kind, string part = "hand.right", float speed = 1f,
    float amplitude = 1f,
    float plane = 0f) => BodyActionCatalog.Create(
    "test.common-actions." + kind + "." + part + "." + speed + "." + amplitude + "." + plane,
    kind.ToString(),
    new BodyActionRequest
        { Kind = kind, Effector = part, Speed = speed, Amplitude = amplitude, Plane = plane });

float[] P(Vector3 value) => new[] { value.x, value.y, value.z };
var bridge = service.Assembly.GetType("Cultiway.Content.Compatibility.Worldfall.WorldfallVisualBridge");
await Game.WaitUntil(() => (bool)bridge.GetProperty("IsInstalled", F).GetValue(null), 1800);
var kinds = Enum.GetValues(typeof(BodyActionKind)).Cast<BodyActionKind>().ToArray();
var parts = new[]
{
    "hand.right", "hand.left", "elbow.right", "elbow.left", "shoulder.right", "shoulder.left",
    "foot.right", "foot.left", "knee.right", "knee.left", "head"
};
Actor source = null;
Actor target = Make(68);
var saved = new List<(long Actor, string Ability)>();
try
{
    foreach (var kind in kinds)
    foreach (string part in parts)
    {
        var definition = Create(kind, part);
        var plan = AbilityCompiler.Compile(definition, false);
        Check(plan.Body.MatchDistance && plan.Body.Part.Id == part && plan.FormCount == 0,
            kind + part + "共用生成实际部位，没有离体执行物");
        float error = 0;
        bool legValid = true;
        foreach (float height in new[] { .5f, 2f })
        foreach (float angle in new[] { 0f, 135f })
        {
            Vector3 forward = Quaternion.AngleAxis(angle, Vector3.forward) * Vector3.right;
            float side = plan.Body.Part.Left ? -1f : 1f;
            var frame = new BodyFrame(new Vector3(5, 7, 1), forward, height, new Vector3(0, side * .16f, .62f),
                height * .24f, height * .27f, side, aimDistance: height * .4f);
            BodyPose? prior = null;
            for (int i = 0; i <= 30; i++)
            {
                var pose = plan.Body.Sample(definition.Lifetime * i / 30f, in frame, previous: prior);
                if (plan.Body.Part.IsArm)
                    error = Mathf.Max(error,
                        Mathf.Abs(Vector3.Distance(pose.Shoulder, pose.Elbow) - frame.UpperLength),
                        Mathf.Abs(Vector3.Distance(pose.Elbow, pose.Hand) - frame.LowerLength));
                if (plan.Body.Part.IsLeg)
                {
                    var leg = (plan.Body.Part.Left ? pose.LeftLeg : pose.RightLeg).Value;
                    legValid &= !float.IsNaN(leg.Foot.x) && leg.Foot.z >= frame.Foot.z - .0001f;
                }

                prior = pose;
            }
        }

        Check(error < .0002f && legValid, kind + part + "调整体型和方向仍保持真实骨长及实际足底", new { error });
    }

    foreach (var kind in kinds)
    {
        var definition = Create(kind);
        var plan = AbilityCompiler.Compile(definition, false);
        var near = new BodyFrame(Vector3.zero, Vector3.right, 1f, new Vector3(0, .16f, .62f), .24f, .27f, 1,
            aimDistance: .15f);
        var far = new BodyFrame(Vector3.zero, Vector3.right, 1f, new Vector3(0, .16f, .62f), .24f, .27f, 1,
            aimDistance: 2f);
        var a = plan.Body.Sample(definition.Lifetime * .46f, in near);
        var b = plan.Body.Sample(definition.Lifetime * .46f, in far);
        Check(Vector3.Distance(a.Hand, b.Hand) > .04f, kind + "近远距离改变实际行程");
        var fast = AbilityCompiler.Compile(Create(kind, speed: 2f), false);
        var fastPose = fast.Body.Sample(definition.Lifetime * .23f, in far);
        Check(Vector3.Distance(fastPose.Hand, b.Hand) < .0001f &&
              Mathf.Abs(fast.Body.ActiveFrom * 2f - plan.Body.ActiveFrom) < .00001f,
            kind + "调速同时改变完整动作及作用时点");
        var changed = AbilityCompiler.Compile(Create(kind, amplitude: .6f, plane: 35f), false);
        Check(Vector3.Distance(changed.Body.Sample(definition.Lifetime * .27f, in far).Hand,
                plan.Body.Sample(definition.Lifetime * .27f, in far).Hand) > .005f,
            kind + "幅度与动作面参与实际姿态");
        Check(definition.TargetRange == null && plan.Reach.Selection() >= plan.Body.ContactReach,
            kind + "候选范围使用真实身体包络，不用零范围覆盖");
    }

    foreach (var kind in kinds)
    {
        var d = Create(kind, "knee.right");
        var plan = AbilityCompiler.Compile(d, false);
        var near = new BodyFrame(Vector3.zero, Vector3.right, 1f, new Vector3(0, .16f, .62f), .24f, .27f, 1,
            aimDistance: .4f);
        var far = new BodyFrame(Vector3.zero, Vector3.right, 1f, new Vector3(0, .16f, .62f), .24f, .27f, 1,
            aimDistance: 2f);
        Check(Vector3.Distance(plan.Body.Sample(d.Lifetime * .46f, in near).RightLeg.Value.Foot,
                plan.Body.Sample(d.Lifetime * .46f, in far).RightLeg.Value.Foot) < .00001f,
            kind + "远处目标不把屈膝动作展开成足部远踢");
    }

    var signatures = kinds.Select(kind =>
    {
        var d = Create(kind);
        var p = AbilityCompiler.Compile(d, false);
        var f = new BodyFrame(Vector3.zero, Vector3.right, 1f, new Vector3(0, .16f, .62f), .24f, .27f, 1,
            aimDistance: .4f);
        return string.Join(";",
            new[] { .27f, .46f, .68f }.Select(t =>
                string.Join(",", P(p.Body.Sample(d.Lifetime * t, in f).Hand).Select(v => Math.Round(v, 3)))));
    }).ToArray();
    Check(signatures.Distinct().Count() == 7, "七种动作有不同实际路径，不仅更换动作名称");
    // 正式入口学习并施放七种手部动作，以及腿部、头部与持剑变体。
    var uses = kinds.Select(k => (Kind: k, Part: "hand.right", Weapon: (string)null)).ToList();
    uses.Add((BodyActionKind.Sweep, "foot.right", null));
    uses.Add((BodyActionKind.Thrust, "head", null));
    uses.Add((BodyActionKind.Cleave, "hand.right", "sword"));
    foreach (var item in uses)
    {
        source = Make(64);
        target.setKingdom(World.world.units.getSimpleList().First(a => a.kingdom != source.kingdom).kingdom);
        var d = Create(item.Kind, item.Part);
        if (item.Weapon != null)
        {
            d.Body.WeaponForm = item.Weapon; /* 实际持物场景在专用脚本接入。 */
            continue;
        }

        d.Id += ".formal";
        d.Cooldown = 10f;
        d.Resource = "none";
        d.Impact = new ConstructionImpact { DamageScale = 0f, StaggerSeconds = .1f };
        d.TargetRange = 20;
        var plan = AbilityCompiler.Compile(d, false);
        object binding = Binding(source, plan);
        for (int frame = 0; binding == null && frame < 30; frame++)
        {
            await Game.NextFrame();
            binding = Binding(source, plan);
        }

        Check(binding != null, d.Id + "实际身体受理条件成立");
        var f = Frame(binding, source);
        var predicted = plan.Body.Sample(d.Lifetime * .46f, in f);
        var shapes = new List<AbilityCapsule>();
        bindingType.GetMethod("AppendContacts", F).Invoke(binding, new object[] { predicted, shapes });
        var shape = shapes[0];
        Vector3 hit = (shape.A + shape.B) * .5f;
        float targetScale = item.Part == "head" ? .4f : .1f;
        target.setActorScale(targetScale);
        target.target_scale = targetScale;
        Place(target, hit.x, hit.y);
        await Advance(.05f);
        Ready(source);
        contacts.Clear();
        d.Use = new ConstructionUse { Target = ActiveAbilityTargetMode.Point };
        await Fire(d, source, target, aim: new Vector3(65, 72, f.Height * .62f));
        await Advance(d.Lifetime * .52f);
        Check(contacts.Count == 1 && contacts[0].Node == -1 && contacts[0].TargetId == target.id,
            d.Id + "正式动作使用同轮实际形状命中且只确认一次", new { count = contacts.Count });
        ControllableUnit.remove(source);
        source.finishStatusEffect("possessed");
        source.setPossessedMovement(false);
        source.updateStats();
        Place(target, 12, 12);
        if (item.Part == "hand.right")
        {
            object mod = AppDomain.CurrentDomain.GetAssemblies()
                .Single(a => a.GetType("FirstPerson.WorldBoxMod", false) != null)
                .GetType("FirstPerson.WorldBoxMod").GetProperty("Instance", F).GetValue(null);

            void Call(string name, object value) =>
                mod.GetType().GetMethod(name, F).Invoke(mod, new[] { value });

            object Prop(string name) => mod.GetType().GetProperty(name, F).GetValue(mod);
            void Set(string name, object value) => mod.GetType().GetField(name, F).SetValue(mod, value);

            async Task Frames(int count)
            {
                for (int i = 0; i < count; i++) await Game.NextFrame();
            }

            Call("ViewForTest", false);
            Call("SetGodView", false);
            await Game.WaitUntil(
                () => (bool)Prop("DiveDone") && !(bool)Prop("IsFirstPerson") && !(bool)Prop("GodShown"), 1800);
            World.world.camera.transform.position = new Vector3(64.2f, 72.8f, 0);
            MoveCamera.instance.forceZoom(2.2f);
            await Frames(10);
            World.world.console.Hide();
            Tooltip.hideTooltipNow();
            Screen.Capture(Path.Combine(folder, item.Kind + ".native.png"));
            await Frames(3);
            Call("SetGodView", true);
            await Game.WaitUntil(() => (float)Prop("GodAlpha") > .999f, 1800);
            Set("_godLock", source);
            Set("_godFollow", source.current_position);
            Set("_godFollowVel", Vector2.zero);
            Set("_godClose", 1.3f);
            Set("_godCloseTarget", 1.3f);
            Set("_godPull", 1f);
            Set("_godTurn", -.25f);
            Set("_godTurnRate", 0f);
            Set("_godTip", .2f);
            Set("_godTipRate", 0f);
            int before = (int)Field(mod, "_godGpuApplied");
            float ready = Time.realtimeSinceStartup + 1f;
            await Game.WaitUntil(
                () => Time.realtimeSinceStartup >= ready && (int)Field(mod, "_godGpuApplied") >= before + 3,
                1800);
            Check(ConstructedAbilityService.TryGetBodyPose(source.id, out BodyPose pose) && pose.ActionAge > 0,
                item.Kind + "双视角使用同一个暂停动作姿态");
            Screen.Capture(Path.Combine(folder, item.Kind + ".worldfall.png"));
            await Frames(3);
            Set("_godLock", null);
            Call("SetGodView", false);
            await Frames(3);
        }

        await Advance(d.Lifetime);
        Check(
            !BodyControlState.IsBusy(source.id) && !Running().Any(r => (long)Field(r, "SourceId") == source.id),
            d.Id + "完整收势后归还身体并回收施放");
        CombatStatusEffects.ApplyStatus(source, hold, 10000, source);
        source.updateStats();
        Place(source, 74, 77);
        saved.Add((source.id, d.Id));
    }

    string save = Path.Combine(folder, "save");
    SaveManager.saveWorldToDirectory(save);
    World.world.save_manager.loadWorld(save);
    await Game.WaitUntil(() => !SmoothLoader.isLoading(), 1800);
    Config.paused = true;
    await Game.WaitUntil(Boundary, 1800);
    foreach (var record in saved)
    {
        var d = ConstructionEditing.Access.Read(record.Ability);
        Check(d.Body.MatchDistance && d.Body.Keys.Length == 5 && World.world.units.get(record.Actor).GetExtend()
                .GetComponent<ConstructedKnowledge>().Ids.Contains(record.Ability),
            record.Ability + "正式恢复动作关键点、距离适配和已学关系");
    }
}
finally
{
    ConstructedAbilityService.ContactConfirmed -= Hit;
    ControllableUnit.clear(false);
    Config.paused = true;
}

return new { passed = true, checks };
