// 独立夹具：正式地点施放、实际日常回收及待恢复世界，不在交战中代替人物选招。
using System;using System.IO;using System.Linq;using System.Reflection;using System.Collections;using System.Collections.Generic;using System.Threading.Tasks;using Newtonsoft.Json;using Newtonsoft.Json.Linq;using UnityEngine;using Cultiway.Core;using Cultiway.Core.Skills;using Cultiway.Core.SkillLibV3.ActiveAbilities;using Cultiway.Core.SkillLibV3.Usage;using Cultiway.Content.Skills;using Cultiway.Content.Components;using Cultiway.Content.Combat;using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/world-use");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new InvalidOperationException(n);checks.Add(n);Log.Info(n);}AbilityDefinition Copy(AbilityDefinition d)=>JsonConvert.DeserializeObject<AbilityDefinition>(JsonConvert.SerializeObject(d));
var runnerType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=runnerType.GetProperty("Instance").GetValue(null);async Task Boundary()=>await Game.WaitUntil(()=>(bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;await Boundary();}
Config.paused=true;Game.Resume();Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();World.world.console.Hide();foreach(var screen in Resources.FindObjectsOfTypeAll<LoadingScreen>())screen.gameObject.SetActive(false);foreach(var old in World.world.units.getSimpleList().ToArray())old.dieAndDestroy(AttackType.Other);for(int y=55;y<90;y++)for(int x=50;x<90;x++){var t=World.world.GetTileSimple(x,y);if(t.building!=null)t.building.removeBuildingFinal();t.setTileTypes(TileLibrary.soil_low,TopTileLibrary.grass_low);}
var holdStats=new BaseStats();holdStats.addTag("frozen_ai");holdStats.addTag("immovable");var hold=Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.WorldUseHold")??Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.WorldUseHold").SetStats(holdStats).SetDuration(10000).Build();var quiet=Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.WorldUseQuiet")??Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.WorldUseQuiet").SetStats(new BaseStats{["multiplier_speed"]=-1f}).SetDuration(10000).Build();ActorExtend Make(int x){var a=World.world.units.createNewUnit("human",World.world.GetTileSimple(x,72),pAdultAge:true,pSpawnWithItems:false);a.addTrait("super_health");var e=a.GetExtend();e.AddComponent(new Xian{level=2,wakan=100});CombatStatusEffects.ApplyStatus(a,hold,10000,a);CombatStatusEffects.ApplyStatus(a,quiet,10000,a);e.MarkCultiwayStatsDirty();a.setStatsDirty();a.updateStats();return e;}var owner=Make(64);var other=Make(65);other.Base.setKingdom(owner.Base.kingdom);Check(owner.Base.stats[Cultiway.Content.BaseStatses.MaxWakan.id]>100,"真实人物具备明确的原资源容量");
AbilityDefinition Place(string id,float lifetime)=>new(){Id=id,Name="地点留置验证",Cost=10,Cooldown=0,Lifetime=.5f,TargetRange=12,Use=new ConstructionUse{Channels=ActiveAbilityChannel.World,Target=ActiveAbilityTargetMode.Point},Impact=new ConstructionImpact{Targets=SkillUseTargetRelation.Friendly,DamageScale=0},Root=new ConstructionNode{Id="material",Form="sword",Matter="iron",Scale=1,Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Leave,At=.05f,Residue=new ConstructionResidue{Lifetime=lifetime}}}}};
AbilityDefinition Recover(string id,bool temporary,float cost)=>new(){Id=id,Name="日常回收验证",Cost=cost,Cooldown=.5f,Lifetime=.8f,TargetRange=12,Use=new ConstructionUse{Channels=ActiveAbilityChannel.World,Target=ActiveAbilityTargetMode.Point},Impact=new ConstructionImpact{Targets=SkillUseTargetRelation.Friendly,DamageScale=0},Root=new ConstructionNode{Id="selection",Form="sword",Matter="iron",Scale=8,Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Recover,At=.05f,Seconds=.4f,Recovery=new ConstructionRecovery{WorldMaterials=true,TemporaryOnly=temporary,Efficiency=.75f}}}}};
var temp=Place("test.world-use.temporary",90);var permanent=Place("test.world-use.permanent",0);var safe=Recover("test.world-use.safe",true,1);var unsafeRecovery=Recover("test.world-use.unsafe",false,0);var expensive=Recover("test.world-use.expensive",true,25);var miss=Recover("test.world-use.miss",true,1);miss.Root.Offset=new[]{100f,0f,0f};var legacy=Copy(temp);legacy.Id="test.world-use.legacy";legacy.Use=null;legacy.Root.Operations=Array.Empty<ConstructionOperation>();var self=Copy(legacy);self.Id="test.world-use.self";self.Impact.Targets=SkillUseTargetRelation.Self;var mixed=Copy(temp);mixed.Id="test.world-use.mixed";mixed.Use.Target=ActiveAbilityTargetMode.ObjectOrPoint;mixed.Impact.Targets=SkillUseTargetRelation.Hostile;mixed.Root.Operations=Array.Empty<ConstructionOperation>();
Check(AbilityCompiler.Compile(legacy).Use.Channels==ActiveAbilityChannel.Combat&&AbilityCompiler.Compile(legacy).Use.Target==ActiveAbilityTargetMode.Object,"旧人物构造保持战斗及人物选取");Check(AbilityCompiler.Compile(self).Use.Target==ActiveAbilityTargetMode.Self,"旧本人作用保持本人选取");var explicitLegacy=Copy(legacy);explicitLegacy.Id+=".explicit";explicitLegacy.Use=new ConstructionUse();Check(ConstructionSimilarity.Describe(legacy).Near(ConstructionSimilarity.Describe(explicitLegacy)),"显式填写旧选择规则不伪造不同新术");var fixedPlan=AbilityCompiler.Compile(temp);var mutable=Copy(temp);mutable.Id+=".snapshot";var snapshot=AbilityCompiler.Compile(mutable);mutable.Use.Target=ActiveAbilityTargetMode.Object;mutable.Use.Channels=ActiveAbilityChannel.Combat;Check(snapshot.Use.Target==ActiveAbilityTargetMode.Point&&snapshot.Use.Channels==ActiveAbilityChannel.World,"运行计划独占已验证选择规则");foreach(var invalid in new[]{new ConstructionUse{Channels=ActiveAbilityChannel.None},new ConstructionUse{Channels=(ActiveAbilityChannel)8},new ConstructionUse{Target=ActiveAbilityTargetMode.Area}}){var bad=Copy(temp);bad.Id="test.world-use.invalid";bad.Use=invalid;bool rejected=false;try{AbilityCompiler.Compile(bad);}catch(InvalidDataException){rejected=true;}Check(rejected,"非法使用规则被正式资料边界拒绝："+invalid.Channels+"/"+invalid.Target);}
foreach(var d in new[]{temp,permanent,safe,unsafeRecovery,expensive,miss,legacy,self,mixed}){ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(owner,d.Id);}ConstructedAbilityService.Learn(other,temp.Id);ActiveAbilityHandle Handle(ActorExtend e,string id)=>new("content.constructed",e.E,id);var point=new Vector3(68.5f,72.5f,0);Check(ActiveAbilityService.GetChannels(owner,Handle(owner,temp.Id))==ActiveAbilityChannel.World&&ActiveAbilityService.Describe(owner,Handle(owner,temp.Id)).TargetMode==ActiveAbilityTargetMode.Point,"统一入口公开实际世界场景与地点目标");Check(!ActiveAbilityService.CanUse(owner,Handle(owner,legacy.Id),new ActiveAbilityTarget(null,point)),"旧人物构造不因传入地点而绕过活体要求");Check(ActiveAbilityService.CanUse(owner,Handle(owner,self.Id),new ActiveAbilityTarget(null,point)),"旧本人构造不需要伪造目标人物");Check(!ActiveAbilityService.CanUse(owner,Handle(owner,mixed.Id),new ActiveAbilityTarget(other.Base,point))&&ActiveAbilityService.CanUse(owner,Handle(owner,mixed.Id),new ActiveAbilityTarget(null,point)),"人物或地点不会把敌我不符的人物悄悄降级为地点");
float unchanged=owner.GetComponent<Xian>().wakan;foreach(Vector3 bad in new[]{new Vector3(float.NaN,72,0),new Vector3(68,float.PositiveInfinity,0),new Vector3(68,72,float.NaN),new Vector3(-1,72,0),new Vector3(2000,72,0),new Vector3(100,100,0)})Check(!ActiveAbilityService.TryUse(owner,Handle(owner,temp.Id),new ActiveAbilityTarget(null,bad),ActiveAbilityUseOrigin.Script),"非法或超距地点不支付："+bad);Check(owner.GetComponent<Xian>().wakan==unchanged,"拒绝外部地点不产生费用");
string stage="manual";var starts=new List<object>();var changes=new List<WorldMaterialChange>();var accepted=new List<WorldMaterialChange>();var auto=new List<ConstructedCastStarted>();long pointCast=0;void Started(ConstructedCastStarted c){if(c.SourceId!=owner.Base.id)return;starts.Add(new{stage,c.AbilityId,c.CastId,c.WorldTime,origin=c.Origin.ToString(),balance=owner.GetComponent<Xian>().wakan});if(c.Origin==ActiveAbilityUseOrigin.Autonomous)auto.Add(c);else pointCast=c.CastId;}void Changed(WorldMaterialChange c){changes.Add(c);if(c.Kind=="leave")accepted.Add(c);}ConstructedAbilityService.CastStarted+=Started;WorldMaterialService.Changed+=Changed;
try{
Check(ActiveAbilityService.TryUse(owner,Handle(owner,temp.Id),new ActiveAbilityTarget(other.Base,point),ActiveAbilityUseOrigin.Script),"正式地点施放无需敌人，鼠标人物不代替明确地点");Check(Math.Abs(owner.GetComponent<Xian>().wakan-(unchanged-10))<.001,"正式地点施放只支付一次真实费用");var running=((IEnumerable)typeof(ConstructedAbilityService).GetField("casts",F).GetValue(null)).Cast<object>().Single(v=>(long)v.GetType().GetField("Id",F).GetValue(v)==pointCast);Check((long)running.GetType().GetField("TargetId",F).GetValue(running)==0&&(Vector3)running.GetType().GetField("LastTargetFoot",F).GetValue(running)==point,"地点运行没有借用另一人物身份且固定真实地点");Check(ActiveAbilityService.TryUse(owner,Handle(owner,permanent.Id),new ActiveAbilityTarget(null,point),ActiveAbilityUseOrigin.Script)&&ActiveAbilityService.TryUse(other,Handle(other,temp.Id),new ActiveAbilityTarget(null,point),ActiveAbilityUseOrigin.Script),"同一位置建立自己永久材料与另一人的临时材料");await Advance(1);Check(accepted.Count==3,"无人物目标的正式构造实际转交三份世界材料");long first=accepted.Single(c=>c.Provider==owner.Base.id&&c.AbilityId==temp.Id).Id,kept=accepted.Single(c=>c.AbilityId==permanent.Id).Id,theirs=accepted.Single(c=>c.Provider==other.Base.id).Id;
void Knowledge(params string[] ids)=>owner.AddComponent(new ConstructedKnowledge{Ids=ids});void Unfreeze(){CombatStatusEffects.RemoveStatus(owner.Base,hold);owner.Base.setStatsDirty();owner.Base.updateStats();}void Freeze(){CombatStatusEffects.ApplyStatus(owner.Base,hold,10000,owner.Base);owner.Base.setStatsDirty();owner.Base.updateStats();}stage="full";owner.GetComponent<Xian>().wakan=owner.Base.stats[Cultiway.Content.BaseStatses.MaxWakan.id]*2;Unfreeze();await Advance(3);Check(auto.Count==0,"没有原资源容量时不自动破坏材料来回能");stage="unsafe";Knowledge(unsafeRecovery.Id);owner.GetComponent<Xian>().wakan=owner.Base.stats[Cultiway.Content.BaseStatses.MaxWakan.id]*.5f;await Advance(3);Check(auto.Count==0,"未声明只选临时材料的回收构造不会被日常需求擅自使用");stage="unprofitable";Knowledge(expensive.Id);Check(ActiveAbilityService.CanUse(owner,Handle(owner,expensive.Id),new ActiveAbilityTarget(null,point)),"无收益检查中的人物实际付得起这项能力");await Advance(3);Check(auto.Count==0,"实际预计回收不足费用时不自主支付");stage="no-selection";Knowledge(miss.Id);Check(ActiveAbilityService.CanUse(owner,Handle(owner,miss.Id),new ActiveAbilityTarget(null,point)),"未选中材料的能力本身具备使用条件");await Advance(3);Check(auto.Count==0,"预估采用实际作用形状，偏离材料的构造不空放");stage="autonomous";Knowledge(safe.Id);Check(owner.Base.attack_target.isRekt()&&other.Base.attack_target.isRekt(),"日常回收开始前没有战斗目标");await Advance(5);Check(auto.Count==1&&auto[0].AbilityId==safe.Id,"无敌人的修士真实自主选择并释放已学普通回收构造");Check(changes.Any(c=>c.Id==first&&c.Kind=="recover")&&changes.Where(c=>c.Id==first&&c.Kind=="credit").Sum(c=>c.Granted)>7.49,"实际世界材料收束并返还原支付份额");Check(!changes.Any(c=>(c.Id==kept||c.Id==theirs)&&c.Kind=="recover"),"同场永久结构和其他支付者的材料实际保留");int completed=auto.Count;await Advance(3);Check(auto.Count==completed,"需求完成后不再重复施放与支付");
stage="pending-save";Freeze();ConstructedAbilityService.Learn(owner,temp.Id);owner.GetComponent<Xian>().wakan=100;Check(ActiveAbilityService.TryUse(owner,Handle(owner,temp.Id),new ActiveAbilityTarget(null,new Vector3(69.5f,72.5f,0)),ActiveAbilityUseOrigin.Script),"保存前正式建立另一份尚未回收的临时材料");await Advance(1);long pending=accepted.Last(c=>c.Provider==owner.Base.id&&c.AbilityId==temp.Id).Id;var saves=Cultiway.ModClass.I.WorldSaves;var save=SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));Check(save.actors_data.Any(a=>a.id==owner.Base.id)&&save.actors_data.Any(a=>a.id==other.Base.id),"原版正式保存实际包含两个支付者");File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,owner=owner.Base.id,other=other.Base.id,pending,completed=first,kept,theirs,safe=safe.Id,world=saves.World.Capture(World.world,"world-use"),person=saves.Actors.Capture(owner,"world-use")},Formatting.Indented));var result=new{passed=true,checks,process=System.Diagnostics.Process.GetCurrentProcess().Id,autonomous=auto.Count,paid=10,credited=changes.Where(c=>c.Id==first&&c.Kind=="credit").Sum(c=>c.Granted),starts};File.WriteAllText(Path.Combine(folder,"result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{ConstructedAbilityService.CastStarted-=Started;WorldMaterialService.Changed-=Changed;Config.paused=true;}
