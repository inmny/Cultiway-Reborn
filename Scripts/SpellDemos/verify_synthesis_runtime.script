// 当前规则经过有限请求、正式掌握、实际施放、玩家改造和正式保存，保留冷启动依据。
using System;using System.IO;using System.Linq;using System.Reflection;using System.Collections;using System.Collections.Generic;using System.Threading.Tasks;using Newtonsoft.Json;using Newtonsoft.Json.Linq;using Cultiway.Const;using Cultiway.Core;using Cultiway.Core.Persistence;using Cultiway.Core.Skills;using Cultiway.Core.SkillLibV3.ActiveAbilities;using Cultiway.Content.Components;using Cultiway.Content.Skills;using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/synthesis");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new InvalidOperationException(n);checks.Add(n);Log.Info(n);}JObject Canon(AbilityDefinition d){var j=JObject.Parse(JsonConvert.SerializeObject(d));j.Remove("Id");return j;}var runnerType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=runnerType.GetProperty("Instance").GetValue(null);async Task Boundary()=>await Game.WaitUntil(()=>(bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;await Boundary();}void Process()=>typeof(ConstructedAbilityService).GetMethod("ProcessCreation",F).Invoke(null,null);
Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();for(int y=40;y<100;y++)for(int x=40;x<110;x++)World.world.GetTileSimple(x,y).setTileTypes(TileLibrary.soil_low,TopTileLibrary.grass_low);
var stats=new BaseStats();stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.SynthesisHold")??Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SynthesisHold").SetStats(stats).SetDuration(10000).Build();ActorExtend Make(string species,int x){var a=World.world.units.createNewUnit(species,World.world.GetTileSimple(x,72),pAdultAge:true,pSpawnWithItems:false);a.addTrait("super_health");var e=a.GetExtend();e.AddComponent(new Xian{level=2,wakan=10000});Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(a,hold,10000,a);a.setStatsDirty();a.updateStats();return e;}var author=Make("human",60);var reader=Make("human",64);var waiting=Make("human",68);var enemy=Make("wolf",65);author.Base.addAggro(enemy.Base);enemy.Base.addAggro(author.Base);await Advance(.1f);var access=ConstructionEditing.Access;var saves=Cultiway.ModClass.I.WorldSaves;
int seed=(int)JObject.Parse(File.ReadAllText(Path.Combine(folder,"nested.json")))["Seed"];Check(ConstructedAbilityService.TryQueueCreation(author,seed),"实际人物受理同一有限创法请求");var request=author.GetComponent<ConstructedCreationState>();Check(request.Pending&&request.Inspiration.Rules==2&&access.List(author).Count==0,"受理固定当前规则及输入，尚未登记或提前学习");var expected=ConstructedAbilityService.Generate(author,request.Seed,request.Inspiration,request.Source,request.Resources);var updatedModels=JObject.Parse(JsonConvert.SerializeObject(request.Resources));foreach(var form in updatedModels["Forms"])form["Size"]=(float)form["Size"]*2;var alternate=ConstructedAbilityService.Generate(author,request.Seed,request.Inspiration,request.Source,updatedModels.ToObject<SynthesisResources>());Check(!JToken.DeepEquals(Canon(expected),Canon(alternate))&&JToken.DeepEquals(Canon(expected),Canon(ConstructedAbilityService.Generate(author,request.Seed,request.Inspiration,request.Source,request.Resources))),"模型尺寸输入变化会改变新草稿，但不会重算已受理请求的旧输入");Process();var state=author.GetComponent<ConstructedCreationState>();Check(!state.Pending&&state.LastFailure==null&&state.Resources==null&&JToken.DeepEquals(Canon(access.Read(state.LastAbility)),Canon(expected)),"共同边界真正生成并授予固定输入的完整结构");var original=access.Read(state.LastAbility);ConstructedAbilityService.Learn(reader,original.Id);string unchanged=JsonConvert.SerializeObject(original);long castId=0;void Start(ConstructedCastStarted c){if(c.SourceId==author.Base.id&&c.AbilityId==original.Id)castId=c.CastId;}ConstructedAbilityService.CastStarted+=Start;AbilityDefinition revised=null;
try{Cultiway.Content.Combat.CombatStatusEffects.RemoveStatus(author.Base,hold);author.Base.setStatsDirty();author.Base.updateStats();float paid=author.GetComponent<Xian>().wakan;Check(ActiveAbilityService.TryUse(author,new ActiveAbilityHandle("content.constructed",author.E,original.Id),new ActiveAbilityTarget(enemy.Base,enemy.Base.GetSimPos()),ActiveAbilityUseOrigin.Autonomous),"自主使用的正式入口受理新生成构造");Check(castId>0&&Math.Abs(author.GetComponent<Xian>().wakan-(paid-original.Cost))<.001f,"完整构造只在正式开始时支付一次实际费用");object run=((IEnumerable)typeof(ConstructedAbilityService).GetField("casts",F).GetValue(null)).Cast<object>().Single(v=>(long)v.GetType().GetField("Id",F).GetValue(v)==castId);var cast=(AbilityCast)run.GetType().GetField("Cast",F).GetValue(run);var plan=cast.Plan;var edit=new ConstructionEditSession(access.Read(original.Id));edit.Draft.Root.Scale*=1.2f;edit.Draft.Name="实际新树的玩家修订";revised=access.Apply(author,edit,true);Check(revised.Id!=original.Id&&revised.Parent.Id==original.Id&&ReferenceEquals(cast.Plan,plan)&&plan.Id==original.Id,"玩家改造仍用共同编译与版本规则，已开始的复杂构造保留旧计划");Check(ConstructedAbilityService.Knows(reader,original.Id)&&!ConstructedAbilityService.Knows(reader,revised.Id)&&JsonConvert.SerializeObject(access.Read(original.Id))==unchanged,"另一读者继续持有原结构和原版本");await Advance(original.Lifetime+.2f);Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(author.Base,hold,10000,author.Base);author.Base.setStatsDirty();author.Base.updateStats();}finally{ConstructedAbilityService.CastStarted-=Start;}
Check(ConstructedAbilityService.TryQueueCreation(waiting,1730),"保存前受理另一人物尚未完成的新规则请求");var pending=waiting.GetComponent<ConstructedCreationState>();Check(!ReferenceEquals(request.Resources.Forms,pending.Resources.Forms)&&!ReferenceEquals(request.Resources.Bodies[0],pending.Resources.Bodies[0]),"不同请求独占模型数组和身体模板，修改一份不改写另一份");var pendingExpected=ConstructedAbilityService.Generate(waiting,pending.Seed,pending.Inspiration,pending.Source,pending.Resources);var person=JObject.Parse(saves.Actors.Capture(waiting,"synthesis"));Check((int)person["sections"]["ability_creation"]["version"]==4&&(int)person["sections"]["ability_creation"]["data"]["Inspiration"]["Rules"]==2,"正式人物第四版保存当前生成规则和完整数值输入");var broken=(JObject)person.DeepClone();broken["sections"]["ability_creation"]["data"]["Inspiration"]["Rules"]=99;var report=new SaveLoadReport();saves.Actors.Restore(reader,broken.ToString(),report,"synthesis-invalid",section=>section.Id=="ability_creation",false);Check(report.Skipped.Count==1&&ConstructedAbilityService.Knows(reader,original.Id),"未知生成规则在读取边界局部报告，保留已学构造");broken["sections"]["ability_creation"]["data"]["Inspiration"]["Rules"]=2;broken["sections"]["ability_creation"]["data"]["Inspiration"]["Aggression"]=2;report=new SaveLoadReport();saves.Actors.Restore(reader,broken.ToString(),report,"synthesis-invalid-profile",section=>section.Id=="ability_creation",false);Check(report.Skipped.Count==1&&ConstructedAbilityService.Knows(reader,original.Id),"原有损坏性格参数也局部报告，不让构造反射异常中断恢复");var snapshot=SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));Check(new[]{author,reader,waiting,enemy}.All(e=>snapshot.actors_data.Any(a=>a.id==e.Base.id)),"原版世界保存列表实际包含全部验证人物");File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,author=author.Base.id,reader=reader.Base.id,waiting=waiting.Base.id,known=access.List(waiting).Count,original,revised,pending=pendingExpected,input=pending.Inspiration,resources=pending.Resources,source=pending.Source},Formatting.Indented));var result=new{passed=true,checks,original=original.Id,revised=revised.Id,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"runtime.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
