// 支付份额、真实消耗、收束、交接、预测与正式保存。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using Newtonsoft.Json;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Core.Visuals.Forms;
using Cultiway.Content.Skills;
using Cultiway.Content.Components;
using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Instance|BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/recovery");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}
ConstructionOperation Recover(float at=1)=>new(){Kind=ConstructionOperationKind.Recover,At=at,Seconds=1,Recovery=new ConstructionRecovery{Efficiency=.75f}};
AbilityDefinition Basic(string form="sword")=>new(){Id="test.recover",Resource="wakan",Cost=8,Lifetime=4,Root=new ConstructionNode{Id="main",Form=form,Matter=form=="sword"?"iron":"water",Volume=16,Operations=new[]{Recover()}}};
AbilityCast Cast(AbilityDefinition d,double paid=8,float force=20)=>new(AbilityCompiler.Compile(d),Matrix4x4.TRS(new Vector3(64,72,0),Quaternion.identity,Vector3.one),force:force,paidResource:paid);
List<FormVisualInstance> Views(AbilityCast c){var list=new List<FormVisualInstance>();c.AppendVisuals(list);return list;}
List<AbilityCapsule> Shapes(AbilityCast c,bool include=false){var list=new List<AbilityCapsule>();c.AppendContacts(list,include);return list;}
void Spend(AbilityCast c,int n,float amount)=>typeof(AbilityCast).GetMethod("ConsumeForce",F).Invoke(c,new object[]{n,amount});
var d=Basic();var c=Cast(d);Check(c.PaidResource==8&&c.RemainingResource(0)==8,"支付预算独立进入生成主体，不采用攻击力量");var strong=Cast(Basic(),8,20000);Check(strong.RemainingResource(0)==8,"伤害倍率不能扩大资源预算");var free=Cast(Basic(),0);free.Advance(3,Vector3.zero);Check(free.RecoveredResource==0,"未支付的数值施放没有可返还资源");
var before=Views(c).Single().Transform.lossyScale;var oldShape=Shapes(c).First();c.Advance(1,Vector3.zero);Check(!c.IsCurrent(oldShape)&&Shapes(c).Count==0,"收束开始即作废旧候选并停止作用");c.Advance(.5f,Vector3.zero);Check(Math.Abs(c.RecoveredResource-3)<.00001&&Math.Abs(c.RemainingResource(0)-4)<.00001&&Math.Abs(c.RemainingVolume(0)-8)<.00001,"一半收束分别减少实际体积与未耗支付，按效率累计回能");float ratio=Views(c).Single().Transform.lossyScale.x/before.x;Check(Math.Abs(ratio*ratio*ratio-.5f)<.0001,"刚性主体尺寸按剩余真实体积缩小");c.Advance(.6f,Vector3.zero);Check(c.Finished&&Views(c).Count==0&&Math.Abs(c.RecoveredResource-6)<.00001&&Math.Abs(c.RecoveredVolume-16)<.00001,"完成后生成主体退出，转化体积与回能各只登记一次");c.Advance(2,Vector3.zero);Check(c.RecoveredResource==6,"结束后重复推进不能补发回能");
c=Cast(Basic());Spend(c,0,5);c.Advance(3,Vector3.zero);Check(Math.Abs(c.RecoveredResource-4.5)<.00001,"交锋消耗按真实损失比例减少可回能预算");c=Cast(Basic());c.ConfirmContact(0,1);c.Advance(3,Vector3.zero);Check(c.RecoveredResource==0&&c.RecoveredVolume==16,"实际人物接触已经使用本体，不能造成效果后全额退款");
var water=Basic("water_flow");water.Root.Operations=water.Root.Operations.Prepend(new ConstructionOperation{Kind=ConstructionOperationKind.Flow,Flow=new ConstructionFlow{Cells=16,Size=24,Evaporation=.2f,OpenBoundary=false}}).ToArray();c=Cast(water);c.Advance(1,Vector3.zero);var start=Views(c).Single().Layer;c.Advance(.5f,Vector3.zero);var half=Views(c).Single().Layer;Check(Math.Abs(half.Volume/start.Volume-.5)<.0001&&Math.Abs(half.Recovered/start.Volume-.5)<.0001,"水层收束真实降低水深，转化与蒸散分别记账");c.Advance(.6f,Vector3.zero);Check(c.RecoveredResource>4&&c.RecoveredResource<6&&Math.Abs(c.RecoveredVolume+start.Evaporated-16)<.0001,"流失体积不再回能，存量与转化、蒸散共同守恒");
var save=typeof(AbilityCast).GetMethod("SaveStep",F);var restore=typeof(AbilityCast).GetMethod("RestoreStep",F);c=Cast(water);c.Advance(1.2f,Vector3.zero);save.Invoke(c,null);c.Advance(.5f,Vector3.zero);double expected=c.RecoveredResource,expectedVolume=c.RecoveredVolume;float[] depths=Enumerable.Range(0,16).SelectMany(y=>Enumerable.Range(0,16).Select(x=>Views(c).Single().Layer.Depth(x,y))).ToArray();restore.Invoke(c,null);c.Advance(.5f,Vector3.zero);Check(c.RecoveredResource==expected&&c.RecoveredVolume==expectedVolume&&depths.SequenceEqual(Enumerable.Range(0,16).SelectMany(y=>Enumerable.Range(0,16).Select(x=>Views(c).Single().Layer.Depth(x,y)))) ,"预测回退恢复资源累计、水量转化与所有水深，重放不重复回能");
var split=Basic();split.Root.Operations=Array.Empty<ConstructionOperation>();split.Root.DisappearAt=.5f;split.Root.Children=new[]{new ConstructionNode{Id="left",Form="sword",Strength=3,Activation=new ConstructionActivation{Trigger=ConstructionChangeTrigger.End,InheritRemainder=true},Operations=new[]{Recover(.2f)}},new ConstructionNode{Id="right",Form="sword",Strength=1,Activation=new ConstructionActivation{Trigger=ConstructionChangeTrigger.End,InheritRemainder=true},Operations=new[]{Recover(.2f)}}};c=Cast(split,16);Check(c.RemainingResource(1)==0&&c.RemainingResource(2)==0,"等待的后段没有提前补满支付份额");c.Advance(.6f,Vector3.zero);Check(c.RemainingResource(0)==0&&c.RemainingResource(1)==12&&c.RemainingResource(2)==4,"分支按三比一守恒交接真实支付份额");c.Advance(2,Vector3.zero);Check(Math.Abs(c.RecoveredResource-12)<.00001,"多后段回收合计不超过原预算乘效率");
var frag=Basic();frag.Root.Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Fracture,At=.5f,Fracture=new ConstructionFracture{ActiveParts=new[]{"blade"},Gravity=0,Speed=0,Spin=0}}};c=Cast(frag);c.Advance(.6f,Vector3.zero);Check(c.RemainingResource(0)==0&&Math.Abs(Enumerable.Range(1,c.Plan.FormCount-1).Sum(c.RemainingResource)-8)<.00001,"真实分件包含装饰份额，原主体与碎片合计不复制支付");
var conditional=Basic();conditional.Root.Operations[0].When=new ConstructionCondition{Trigger=ConstructionChangeTrigger.ActorContact};conditional.Root.Operations[0].At=0;c=Cast(conditional);c.ConfirmContact(0,1);c.Advance(1.2f,Vector3.zero);Check(c.Finished&&c.RecoveredResource==0,"真实接触触发收束也先消费已使用的份额");
c=Cast(Basic());c.Advance(1.25f,Vector3.zero);double partial=c.RecoveredResource;c.Cancel();c.Advance(2,Vector3.zero);Check(c.RecoveredResource==partial&&partial==1.5,"中断不补发尚未完成的部分");
var frozen=Basic("water_flow");frozen.Root.Operations=frozen.Root.Operations.Prepend(new ConstructionOperation{Kind=ConstructionOperationKind.ConvertMatter,At=.1f,Matter="ice"}).ToArray();c=Cast(frozen);c.Advance(3,Vector3.zero);Check(c.Finished&&c.RecoveredResource==6,"保持态不暂停明确的世界时间收束");
c=Cast(Basic());c.Advance(.2f,Vector3.zero);typeof(AbilityCast).GetMethod("Reflect",F).Invoke(c,new object[]{0,Vector3.left,Vector3.zero,Vector3.zero});c.Advance(3,Vector3.zero);Check(c.Reflections(0)==1&&c.RecoveredResource==6,"反射保留原支付份额，不重新补满预算");
var haste=ConstructionMagnitudeEdits.Haste(Basic(),2);var duration=ConstructionMagnitudeEdits.Duration(Basic(),2);Check(haste.Root.Operations.Single().Seconds==.5f&&duration.Root.Operations.Single().Seconds==2&&duration.Root.Operations.Single().At==2,"急速与完整历时修改真实收束过程");
foreach(var bad in new[]{-1f,1.01f,float.NaN,float.PositiveInfinity}){var invalid=Basic();invalid.Root.Operations[0].Recovery.Efficiency=bad;try{AbilityCompiler.Compile(invalid);throw new Exception("未拒绝坏效率");}catch(InvalidDataException){}}checks.Add("负数、超过一、非数与无穷效率在资料入口拒绝");var empty=Basic();empty.Root.Form="pivot";empty.Root.ContactRole=ConstructionContactRole.Decoration;try{AbilityCompiler.Compile(empty);throw new Exception("空节点被当成材料");}catch(InvalidDataException){checks.Add("空连接点和借用身体不能伪造生成材料回能");}
Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;var actor=World.world.units.createNewUnit("human",World.world.GetTileSimple(64,72),pAdultAge:true,pSpawnWithItems:false);actor.data.name="收束回能保存验证";var owner=actor.GetExtend();owner.AddComponent(new Xian{level=2,wakan=100});foreach(string name in new[]{"悬锋收束回能","水层收束回能"}){var definition=JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/"+name+".json")));ConstructedAbilityService.Register(definition);ConstructedAbilityService.Learn(owner,definition.Id);}int created=0;for(int seed=0;seed<96;seed++){var id=ConstructedAbilityService.Create(owner,seed);if(AbilityCompiler.Compile(ConstructionEditing.Access.Read(id)).HasRecovery)created++;}Check(created>0,"修士实际创作入口可生成带收束的流散结构");Config.paused=false;await Game.WaitUntil(()=>World.world.units.getSimpleList().Any(a=>a.id==actor.id),1800);Config.paused=true;SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));var saves=Cultiway.ModClass.I.WorldSaves;File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,actor=actor.id,world=saves.World.Capture(World.world,"recover"),person=saves.Actors.Capture(owner,"recover")},Formatting.Indented));var result=new{passed=true,checks,created};File.WriteAllText(Path.Combine(folder,"checks.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
