// 通过旧蓝图编译与已学入口，检查落地状态和持续地块的区别。
Actor source = Make(64), enemy = Make(68), outside = Make(72), ally = Make(68), wolf = Make(12, "wolf");
var owner = source.GetExtend();
owner.NewCultisys(Cultisyses.Magic);
owner.GetCultisys<Magic>().level = 1;
source.equipment.setItem(World.world.items.generateItem(AssetManager.items.get("white_staff"), pActor: source), source);
owner.MarkCultiwayStatsDirty();
source.setStatsDirty();
source.updateStats();
enemy.setKingdom(wolf.kingdom);
outside.setKingdom(wolf.kingdom);
ally.setKingdom(source.kingdom);
var armor = Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.Verify.UtilityTarget.Armor") ??
    Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.Verify.UtilityTarget.Armor")
        .SetStats(new BaseStats { [strings.S.armor] = 10, [strings.S.damage] = 7 }).SetDuration(1000).Build();
CombatStatusEffects.ApplyStatus(enemy, armor, 1000, enemy);
enemy.setStatsDirty();
enemy.updateStats();
await Advance(.2f);
Check(source.kingdom.isEnemy(enemy.kingdom) && !source.kingdom.isEnemy(ally.kingdom) && enemy.stats[strings.S.armor] > 0,
    "现成对练人物包含可受破甲的敌人和同阵营对象");

var effects = new[] { StatusEffects.Slow, StatusEffects.Freeze, StatusEffects.Daze,
    StatusEffects.Weaken, StatusEffects.ArmorBreak, StatusEffects.Silence };
var affixes = new[] { SkillModifiers.Slow, SkillModifiers.Freeze, SkillModifiers.Daze,
    SkillModifiers.Weaken, SkillModifiers.ArmorBreak, SkillModifiers.Silence };
var point = new Vector3(68, 72, 0);
var starts = new List<ConstructedCastStarted>();
var results = new List<ConstructedWorldContact>();
var ended = new List<ConstructedCastEnded>();
var legacy = new List<long>();
var payment = new List<object>();
var owned = new List<Entity>();
bool IsTest(long correlation) => correlation >= 101321 && correlation <= 101332;
int Count(Actor actor) => effects.Count(effect => CombatStatusEffects.HasStatus(actor, effect, source));
void Started(ConstructedCastStarted cast)
{
    if (!IsTest(cast.CorrelationId)) return;
    starts.Add(cast);
    Check(Count(enemy) == 0, "开始施放时尚未产生落地状态");
}
void WorldHit(ConstructedWorldContact hit)
{
    if (starts.Any(cast => cast.CastId == hit.CastId)) results.Add(hit);
}
void Finished(ConstructedCastEnded cast)
{
    if (starts.Any(start => start.CastId == cast.CastId)) ended.Add(cast);
}
void Legacy(Entity execution)
{
    long correlation = execution.GetComponent<SkillContext>().RuntimeData.CorrelationId;
    if (IsTest(correlation)) legacy.Add(correlation);
}

Entity Learn(SkillEntityAsset asset, bool field, bool damage = false, Action<SkillBlueprint> configure = null)
{
    var baseSkill = new SkillContainerBuilder(asset).UseAnimation(0).Build(SkillContainerBuildMode.RuleOnly);
    var exported = new SkillBlueprintExporter().Export(baseSkill);
    SkillBlueprintCompiler.Recycle(baseSkill);
    Check(exported.Success, "原容器可从正式入口导出蓝图", new { asset.id });
    SkillBlueprint blueprint = exported.Blueprint;
    if (!field) blueprint.TrajectoryAssetId = SkillTrajectories.GroundEruptAtTarget.id;
    if (configure != null) configure(blueprint);
    else if (damage)
    {
        blueprint.PowerMultiplier = 1.6f;
        Add(blueprint, SkillModifiers.Burn, ("Duration", "4"), ("DamageRatio", "0.24"));
        Add(blueprint, SkillModifiers.Poison, ("Duration", "4"), ("DamageRatio", "0.32"), ("MaxStacks", "2"));
        Add(blueprint, SkillModifiers.EternalCurse, ("Duration", "4"), ("DamageRatio", "0.24"), ("DebuffRatio", "0.2"));
        Add(blueprint, SkillModifiers.Burnout, ("DamageRatio", "0.12"), ("BurnDuration", "4"), ("BurnDamageRatio", "0.36"));
        Add(blueprint, SkillModifiers.Empower, ("SetupBonus", "0.25"));
    }
    else foreach (SkillModifierAsset modifier in affixes) Add(blueprint, modifier, ("Duration", "2"));
    var compiled = new SkillBlueprintCompiler().Compile(blueprint, SkillBlueprintCompileMode.Runtime);
    Check(compiled.Success && SkillOwnershipService.Learn(owner, compiled.Container) == SkillOwnershipResult.Added,
        "本批词条和原兼容轨迹可由正式蓝图编译、学习", compiled.Validation.Issues.Select(issue => issue.Message).ToArray());
    owned.Add(compiled.Container);
    return compiled.Container;
}

void Add(SkillBlueprint blueprint, SkillModifierAsset modifier, params (string key, string value)[] parameters)
{
    SkillModifierSpec spec = modifier.CreateDefaultSpec();
    foreach (var parameter in parameters) spec.Parameters[parameter.key] = parameter.value;
    blueprint.Modifiers.Add(spec);
}

bool Use(Entity skill, long correlation, Actor carrier = null, float effectScale = .75f)
{
    source.setMana(source.getMaxMana(), false);
    var context = new SkillCasterContext(owner, (carrier ?? source).GetExtend());
    using var scope = SkillCasterContextService.Enter(in context);
    return ActiveAbilityService.TryUse(owner, new ActiveAbilityHandle("core.learned_skill", skill),
        new ActiveAbilityTarget(null, point, runtimeData: new SkillCastRuntimeData { CorrelationId = correlation, EffectScale = effectScale }),
        ActiveAbilityUseOrigin.Script);
}

void AllowMovement(Actor target)
{
    var stillStats = new BaseStats();
    stillStats.addTag("frozen_ai");
    var still = Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.Verify.UtilityMotion.Still") ??
        Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.Verify.UtilityMotion.Still")
            .SetStats(stillStats).SetDuration(1000).Build();
    CombatStatusEffects.RemoveStatus(target, hold);
    CombatStatusEffects.ApplyStatus(target, still, 1000, target);
    target.updateStats();
}

var emit = Cultiway.Core.SkillLibV3.Manager.ConstructionEmission;
Cultiway.Core.SkillLibV3.Manager.ConstructionEmission = request =>
{
    if (!IsTest(request.RuntimeData.CorrelationId)) return emit(request);
    int debited = source.getMana();
    var accepted = emit(request);
    payment.Add(new { request.RuntimeData.CorrelationId, accepted = accepted.ToString(), debited, after = source.getMana() });
    Check(accepted == SkillEmissionResult.Accepted && debited < source.getMaxMana() && source.getMana() == debited,
        "原入口按逐发支付，新执行没有再次扣费");
    return accepted;
};
ConstructedAbilityService.CastStarted += Started;
ConstructedAbilityService.WorldContactConfirmed += WorldHit;
ConstructedAbilityService.CastEnded += Finished;
Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured += Legacy;
try
{
    WorldTile tile = World.world.GetTileSimple(68, 72);
    if (section is "landing" or "all")
    {
        Entity spell = Learn(SkillEntities.RaiseTerrain, field: false);
        float radius = SkillEffectRadius.ResolveForCaster(owner, spell, 2f);
        Place(outside, point.x + radius + .05f);
        tile.setTileTypes(TileLibrary.soil_low, TopTileLibrary.grass_low);
        int health = enemy.getHealth();
        Check(Use(spell, 101321), "正式入口允许在真实地块施放带状态的抬地");
        await Advance(.58f);
        var first = starts.Single(cast => cast.CorrelationId == 101321);
        var actual = effects.Select(effect =>
        {
            bool found = CombatStatusEffects.TryGetStatus(enemy, effect, source, out Entity state);
            return new { effect.id, found, duration = found ? state.GetComponent<AliveTimeLimit>().value : 0,
                sourcePower = found ? state.GetComponent<StatusComponent>().SourcePowerLevel : null };
        }).ToArray();
        Check(actual.All(state => state.found && state.duration > 0f && state.sourcePower == owner.GetPowerLevel()),
            "落地后六种实际状态保留来源与境界", actual);
        Check(Count(ally) == 0 && Count(outside) == 0 && enemy.getHealth() == health,
            "同阵营和范围外敌人没有状态，范围内的敌人只受词条状态", new { radius, enemy = enemy.id, outside = outside.id });
        Check(results.Any(hit => hit.CastId == first.CastId && hit.Action == "terrain.raise" && hit.Result.Changed && hit.X == 68 && hit.Y == 72),
            "同一次真实施放仍修改原地块");
        await Advance(2.15f);
        Check(ended.Any(cast => cast.CastId == first.CastId && !cast.Cancelled) && Count(enemy) == 0,
            "落地结束、状态到期后离开人物");

        tile.setTileTypes(TileLibrary.soil_low, TopTileLibrary.grass_low);
        Check(Use(spell, 101322), "冷却后可再次从已学入口施放");
        await Advance(.58f);
        var second = starts.Single(cast => cast.CorrelationId == 101322);
        Check(second.CastId != first.CastId && Count(enemy) == effects.Length &&
            results.Any(hit => hit.CastId == second.CastId && hit.Result.Changed), "再次落地独立施加状态和地块效果");
        if (section == "all") await Advance(2.15f);
    }

    if (section is "field" or "all")
    {
        Entity field = Learn(SkillEntities.CleanLandField, field: true);
        tile.heat = 50;
        tile.burned_stages = 2;
        Check(Use(field, 101323), "同六个词条的净土仍从原入口施放");
        await Advance(1.2f);
        var fieldCast = starts.Single(cast => cast.CorrelationId == 101323);
        Check(results.Any(hit => hit.CastId == fieldCast.CastId && hit.Action == "land.cleanse" && hit.Result.Changed) &&
            Count(enemy) == 0 && Count(ally) == 0, "持续区域保留真实净土周期和原对象状态条件");
    }

    if (section is "damage" or "all")
    {
        Entity spell = Learn(SkillEntities.RaiseTerrain, field: false, damage: true);
        var damageEffects = new[] { StatusEffects.Burn, StatusEffects.Poison, StatusEffects.EternalCurse };
        float radius = SkillEffectRadius.ResolveForCaster(owner, spell, 2f);
        Place(outside, point.x + radius + .05f);
        Building building = World.world.GetTileSimple(68, 73).building;
        Check(building != null && building.isAlive(), "复用世界里的原建筑检查燃尽对象");
        building.setKingdom(enemy.kingdom);
        int buildingHealth = building.getHealth();
        int enemyHealth = enemy.getHealth(), allyHealth = ally.getHealth(), outsideHealth = outside.getHealth();
        await CastDamage(101324);
        var first = starts.Single(cast => cast.CorrelationId == 101324);
        Check(results.Any(hit => hit.CastId == first.CastId && hit.Action == "terrain.raise" && hit.Result.Changed),
            "附加伤害不替代本次真实抬地");
        Check(results.All(hit => hit.CastId != first.CastId || hit.X != 68 || hit.Y != 73),
            "同次燃尽受击不会让原建筑占位的地块补做抬地");
        Check(enemy.getHealth() < enemyHealth && (building.isRekt() || building.getHealth() < buildingHealth),
            "燃尽首发即伤到真实敌人与建筑", new { enemyHealth, current = enemy.getHealth(), buildingHealth, destroyed = building.isRekt() });
        Check(allyHealth == ally.getHealth() && outsideHealth == outside.getHealth() &&
            damageEffects.All(effect => !CombatStatusEffects.HasStatus(ally, effect, source) && !CombatStatusEffects.HasStatus(outside, effect, source)),
            "同阵营和原范围外不受附加伤害或状态");
        float force = SkillContext.DefaultStrength * 1.6f * 1.25f * .75f;
        float burn = Tick(StatusEffects.Burn), poison = Tick(StatusEffects.Poison), curse = Tick(StatusEffects.EternalCurse);
        var types = spell.GetComponentTypes().ToList();
        float burnRatio = types.IndexOf(typeof(BurnModifier)) > types.IndexOf(typeof(BurnoutModifier)) ? .24f : .36f;
        Check(Near(burn, force * burnRatio / 4f) && Near(poison, force * .32f / 4f) && Near(curse, force * .24f / 4f),
            "三种每秒量保留原强度和刷新顺序", new { force, burn, poison, curse, burnRatio });
        int afterDirect = enemy.getHealth();
        await Advance(.75f);
        Check(enemy.getHealth() < afterDirect, "抬地结束后周期伤害实际继续扣血", new { afterDirect, afterTick = enemy.getHealth() });

        await CastDamage(101325);
        int[] layers = States(StatusEffects.Poison).Select(state => state.Id).OrderBy(id => id).ToArray();
        Check(layers.Length == 2, "第二发建立同源第二层中毒");
        await CastDamage(101326);
        Check(layers.SequenceEqual(States(StatusEffects.Poison).Select(state => state.Id).OrderBy(id => id)) &&
            States(StatusEffects.Burn).Length == 1 && States(StatusEffects.EternalCurse).Length == 1,
            "达到上限后刷新原毒层，燃烧及诅咒保持单份");
        await Advance(4.2f);
        Check(damageEffects.All(effect => States(effect).Length == 0), "所有附加伤害状态实际到期");
        await CastDamage(101327);
        var retry = starts.Single(cast => cast.CorrelationId == 101327);
        Check(retry.CastId != first.CastId && damageEffects.All(effect => States(effect).Length == 1) &&
            results.Any(hit => hit.CastId == retry.CastId && hit.Result.Changed), "结束后再次正式施放重新产生地块与状态结果");

        async Task CastDamage(long correlation)
        {
            tile.setTileTypes(TileLibrary.soil_low, TopTileLibrary.grass_low);
            Check(Use(spell, correlation), "带伤害词条的抬地从已学入口受理", correlation);
            await Advance(.58f);
        }

        Entity[] States(Cultiway.Core.Libraries.StatusEffectAsset effect) => enemy.GetExtend().GetStatuses()
            .Where(state => state.GetComponent<StatusComponent>().Type == effect && state.GetComponent<StatusComponent>().Source == source)
            .ToArray();

        float Tick(Cultiway.Core.Libraries.StatusEffectAsset effect) => States(effect).Single().GetComponent<StatusTickState>().Value;
        bool Near(float value, float expected) => Mathf.Abs(value - expected) < .001f;
    }

    if (section is "motion" or "carrier" or "all")
    {
        AllowMovement(enemy);
        Place(outside, 74);
        if (section != "carrier")
        {
            Entity push = Learn(SkillEntities.RaiseTerrain, field: false, configure: blueprint =>
                Add(blueprint, SkillModifiers.Knockback, ("Distance", "2"), ("Height", "0.4")));
            Place(enemy, 69);
            enemy.position_height = 0;
            ResetLand();
            Check(Use(push, 101328, effectScale: 1f), "击退抬地从正式已学入口受理");
            await Advance(.17f);
            Check(enemy.under_forces && enemy.position_height > 0 && enemy.current_position.x > 69 && outside.current_position.x == 74,
                "真实范围内的敌人朝落点外腾起，范围外人物不受影响", new { x = enemy.current_position.x, height = enemy.position_height });
            await WaitForGround();
            Check(!enemy.under_forces && enemy.position_height <= .001f && enemy.current_position.x > 69 && ActualLand(101328),
                "敌人真实落地并归还受力，原抬地也已生效", new { x = enemy.current_position.x, height = enemy.position_height });
        }

        Entity exchange = Learn(SkillEntities.RaiseTerrain, field: false, configure: blueprint =>
        {
            Add(blueprint, SkillModifiers.Swap, ("Chance", "1"));
            Add(blueprint, SkillModifiers.Mercy, ("DamageMultiplier", "0.5"), ("HealRatio", "0.4"));
        });
        for (int y = 70; y <= 74; ++y)
        for (int x = 66; x <= 70; ++x)
            World.world.GetTileSimple(x, y).building?.setKingdom(source.kingdom);
        ResetPair();
        int ownerHealth = source.getHealth(), carrierHealth = ally.getHealth();
        int carrierMana = ally.getMana();
        Check(Use(exchange, 101329, ally, 1f), "同一已学入口允许实际载体代施");
        await Advance(.24f);
        Check(ally.current_tile.pos.x == 68 && enemy.current_tile.pos.x == 65 && source.current_tile.pos.x == 64 &&
            ally.getMana() == carrierMana && ally.getHealth() == carrierHealth + 20 && source.getHealth() == ownerHealth && ActualLand(101329),
            "实际载体交换地块并获得一次二十点恢复，归属人物独立支付", new { carrierTile = ally.current_tile.pos.x,
                enemyTile = enemy.current_tile.pos.x, ownerTile = source.current_tile.pos.x, ownerHealth, ownerAfter = source.getHealth(),
                carrierHealth, carrierAfter = ally.getHealth(), carrierMana, carrierAfterMana = ally.getMana() });

        ResetPair();
        enemy.GetExtend().GetForce(source, 0, 0, 10f);
        await Advance(.1f);
        Check(enemy.under_forces && enemy.position_height > 0f, "同一目标确实进入持续腾起过程", enemy.position_height);
        float heightAtImpact = -1;
        void AtImpact(ConstructedActionEvent action)
        {
            if (action.Fact.Node == 0 && action.Fact.Kind == AbilityActionEventKind.Active &&
                starts.Any(cast => cast.CastId == action.CastId && cast.CorrelationId == 101330))
                heightAtImpact = enemy.position_height;
        }
        ConstructedAbilityService.ActionConfirmed += AtImpact;
        try
        {
            Check(Use(exchange, 101330, ally, 1f), "空中目标所在的地块施放仍受理");
            await Advance(.24f);
            Check(heightAtImpact > 0 && ally.current_tile.pos.x == 65 && enemy.current_tile.pos.x == 68 && ActualLand(101330),
                "落地词条实际结算时空中目标不换位，抬地继续", new { heightAtImpact, carrierTile = ally.current_tile.pos.x });
        }
        finally { ConstructedAbilityService.ActionConfirmed -= AtImpact; }
        await WaitForGround();
        Check(!enemy.under_forces && enemy.position_height <= .001f, "目标从本次腾起正常落回地面");

        ResetPair();
        Check(Use(exchange, 101331, ally, 1f), "恢复地面后可从同一入口再次施放");
        await Advance(.24f);
        Check(ally.current_tile.pos.x == 68 && enemy.current_tile.pos.x == 65 && ActualLand(101331), "回到地面后重新完成换位");

        void ResetPair()
        {
            Place(enemy, 68.3f);
            Place(ally, 65.3f);
            enemy.position_height = 0;
            ally.position_height = 0;
            source.setHealth(source.getMaxHealth() - 200);
            ally.setHealth(ally.getMaxHealth() - 200);
            ally.setMana(ally.getMaxMana(), false);
            ResetLand();
        }

        void ResetLand() => tile.setTileTypes(TileLibrary.soil_low, TopTileLibrary.grass_low);
        bool ActualLand(long correlation) => starts.Any(cast => cast.SourceId == source.id && cast.CorrelationId == correlation &&
            results.Any(hit => hit.CastId == cast.CastId && hit.Action == "terrain.raise" && hit.Result.Changed));
        async Task WaitForGround()
        {
            Config.setWorldSpeed("x5", false);
            try
            {
                for (int i = 0; i < 24 && (enemy.under_forces || enemy.position_height > .001f); ++i) await Advance(.3f);
            }
            finally { Config.setWorldSpeed("x1", false); }
        }
    }

    if (section is "motion" or "combo" or "all")
    {
        Entity both = Learn(SkillEntities.RaiseTerrain, field: false, configure: blueprint =>
        {
            Add(blueprint, SkillModifiers.Knockback, ("Distance", "2"), ("Height", "0.4"));
            Add(blueprint, SkillModifiers.Swap, ("Chance", "1"));
        });
        var types = both.GetComponentTypes().ToList();
        bool swapFirst = types.IndexOf(typeof(SwapModifier)) < types.IndexOf(typeof(KnockbackModifier));
        AllowMovement(enemy);
        Place(ally, 65.3f);
        Place(enemy, 68.6f);
        ally.position_height = enemy.position_height = 0;
        tile.setTileTypes(TileLibrary.soil_low, TopTileLibrary.grass_low);
        Check(Use(both, 101332, ally, 1f), "共同施放接收同时携带的击退和换位");
        await Advance(.17f);
        Check(ally.current_tile.pos.x == 68 && enemy.under_forces == swapFirst &&
            (swapFirst ? enemy.current_position.x < 65 && enemy.position_height > 0 : enemy.current_tile.pos.x == 65),
            "两种位移按原容器顺序提交，归还旧运动后不把目标拉回", new { swapFirst, enemy.under_forces,
                x = enemy.current_position.x, height = enemy.position_height, carrierTile = ally.current_tile.pos.x });
    }

    Check(legacy.Count == 0 && payment.Count == starts.Count, "实际发射全部走共同执行且没有旧实体");
    return new { passed = true, section, checks, starts, ended, results, payment, legacy };
}
finally
{
    Cultiway.Core.SkillLibV3.Manager.ConstructionEmission = emit;
    Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured -= Legacy;
    ConstructedAbilityService.WorldContactConfirmed -= WorldHit;
    ConstructedAbilityService.CastStarted -= Started;
    ConstructedAbilityService.CastEnded -= Finished;
    ConstructedAbilityService.CastEnded -= Ended;
    foreach (Entity skill in owned)
    {
        owner.ForgetSkillV3(skill);
        SkillBlueprintCompiler.Recycle(skill);
    }
}
