// 10.03：同一人和真实铁剑，按实际刃面核对蓄势重击与三段连斩。
var technique = move == "committed" ? KnightTechniques.CommittedStrike : KnightTechniques.LegendaryFlurry;
AbilityDefinition basis = ConstructionEditing.Access.Read(technique.id);
CompiledBodyAction body = ConstructionEditing.Access.Validate(basis).Body;
Check(body.WeaponForm == "sword" && body.StageCount == (move == "committed" ? 1 : 3) &&
      body.Construction.Relations.Any(r => r.FromAnchor == "edge"), "正式构造使用持剑刃面和独立作用段");

owner.AddComponent(new Knight { level = 7, vigor = 800f });
var supply = Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.Verify.DuelistVigor") ??
    Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.Verify.DuelistVigor")
        .SetStats(new BaseStats { [BaseStatses.MaxVigor.id] = 1000f }).SetDuration(10000).Build();
CombatStatusEffects.ApplyStatus(source, supply, 10000, source);
if (move != "committed") CombatStatusEffects.ApplyStatus(target, hold, 10000, target);
Actor ally = move == "committed" ? Make(67) : null;
if (ally != null) ally.setKingdom(target.kingdom);
Ready(source);
source.attack_timer = 999f;
await Advance(.18f);
Item original = Equip(source, "sword_iron");
KnightStyleMasteryService.Master(owner, KnightStyles.Duelist);
KnightTechniqueSkills.LearnStyle(owner, KnightStyles.Duelist);
var handles = new List<ActiveAbilityHandle>();
ActiveAbilityService.Collect(owner, handles);
var handle = handles.Single(h => h.ProviderId == "content.knight_techniques" && h.EntryId == technique.id);
double cost = SkillCastResources.Vigor.Quote(owner, SkillCastCost.CalculateStepDemand(handle.Source) *
    Mathf.Sqrt(SkillEffectRadius.ResolveCasterGrowth(owner, handle.Source)));
float height = (float)service.Assembly.GetType("Cultiway.Content.Combat.SpatialActorPose")
    .GetMethod("Height", F).Invoke(null, new object[] { source });
float targetX = 64.35f + height * 1.17f;

long castId = 0;
AbilityCast live = null;
var damage = new List<ConstructedQueuedDamage>();
void Started(ConstructedCastStarted fact)
{
    if (fact.SourceId != source.id || fact.AbilityId != technique.id) return;
    object running = ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>()
        .Single(value => (long)Field(value, "Id") == fact.CastId);
    castId = fact.CastId;
    live = (AbilityCast)Field(running, "Cast");
    Check(ReferenceEquals(Field(Field(running, "Body"), "Weapon"), original), "动作借用真实装备槽的同一把剑");
}
void Settled(ConstructedQueuedDamage fact) { if (fact.CastId == castId) damage.Add(fact); }
ConstructedAbilityService.CastStarted += Started;
ConstructedAbilityService.QueuedDamageConfirmed += Settled;
try
{
    var cases = move == "committed" ? new[] { "isolated", "supported" } : new[] { move };
    foreach (string scenario in cases)
    {
        Place(source, 64.35f);
        Place(target, targetX);
        target.setHealth(target.getMaxHealth());
        source.addAggro(target);
        target.addAggro(source);
        if (ally != null) Place(ally, targetX, scenario == "isolated" ? 73.1f : 76f);
        int before = target.data.health;
        int? allyHealth = ally?.data.health;
        source.attack_timer = 0f;
        owner.GetCultisys<Knight>().vigor = 800f;
        live = null;
        contacts.Clear();
        damage.Clear();
        var aim = new ActiveAbilityTarget(target, target.GetSimPos());
        Check(ActiveAbilityService.TryUse(owner, handle, aim, ActiveAbilityUseOrigin.Script) && live != null,
            scenario + "：原战技入口受理", new { height, targetX });
        Check(BodyControlState.IsBusy(source.id) && Math.Abs(800f - owner.GetCultisys<Knight>().vigor - cost) < .001 &&
              SkillCooldownService.GetRemaining(owner, handle.Source) == technique.Cooldown,
            scenario + "：只扣一笔原斗气并占用动作", new { cost, technique.Cooldown });
        source.attack_timer = 999;
        Item current = original;
        float[] expected;
        if (move == "committed")
        {
            await Advance(.125f);
            Check(contacts.Count == 0 && target.data.health == before && live.Age < body.ActiveFrom &&
                  live.BodyPose?.Turn < -10f, "真实蓄势期间尚未结算");
            // 受理后交换位置，验证按真实接触时的友方距离处理。
            Place(ally, targetX, scenario == "isolated" ? 76f : 73.1f);
            expected = new[] { scenario == "isolated" ? 1.55f : 1.25f };
        }
        else
        {
            expected = move == "flurry-swap" ? new[] { .55f } : new[] { .55f, .65f, .9f };
            if (move == "flurry-swap")
            {
                await Advance(.177f);
                Check(contacts.Count == 1 && live.Age < body.Stages[1].From && BodyControlState.IsBusy(source.id),
                    "第一段实际命中以后才换掉原剑");
                current = Equip(source, "sword_iron");
            }
        }
        await Advance(.85f);
        var hits = contacts.Where(h => h.CastId == castId).ToArray();
        var multipliers = hits.Select(h => h.BodyDamageMultiplier).ToArray();
        Check(hits.Length == expected.Length && hits.All(h => h.Node == -1 && h.TargetId == target.id) &&
              hits.Select(h => body.StageAt(h.Age)).SequenceEqual(Enumerable.Range(0, expected.Length)) &&
              expected.Zip(multipliers, (a, b) => b.HasValue && Mathf.Abs(a - b.Value) < .001f).All(value => value) &&
              damage.Count == expected.Length && damage.All(f => f.Damage.HealthLost > 0) &&
              damage.Sum(f => f.Damage.HealthLost) == before - target.data.health && allyHealth == ally?.data.health,
            scenario + "：实际接触分别使用原伤害倍率，未伤到其他人",
            new { hitAges = hits.Select(h => h.Age), effect = multipliers,
                  healthLost = damage.Select(f => f.Damage.HealthLost), before, after = target.data.health });
        Check(live.Finished && !BodyControlState.IsBusy(source.id) && ReferenceEquals(source.getWeapon(), current),
            scenario + "：归还身体并保留装备槽的实际物件");
        if (scenario == "isolated") await Advance(1.7f);
    }
    return new { passed = true, move, cases };
}
finally
{
    ConstructedAbilityService.CastStarted -= Started;
    ConstructedAbilityService.QueuedDamageConfirmed -= Settled;
    ConstructedAbilityService.ContactConfirmed -= Hit;
    ConstructedAbilityService.CastEnded -= Ended;
    ControllableUnit.clear(false);
    Config.paused = true;
}
