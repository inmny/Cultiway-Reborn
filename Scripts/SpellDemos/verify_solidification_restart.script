// 真正重启后恢复凝固水层，再从零动量解冻；原支付不重发。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Content.Skills;
const BindingFlags F=BindingFlags.Instance|BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/solidification");var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}int process=System.Diagnostics.Process.GetCurrentProcess().Id;Check(process!=(int)expected["process"],"正式退出后以另一个游戏进程恢复");
Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;var runnerType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=runnerType.GetProperty("Instance").GetValue(null);await Game.WaitUntil(()=>(bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);
var saves=Cultiway.ModClass.I.WorldSaves;Check(saves.LastReport.Skipped.Count==0&&saves.LastReport.BackupError==null,"正式材料无丢弃或备份失败");JObject Section(string archive)=>(JObject)JObject.Parse(archive)["sections"]["world_materials"];var before=Section((string)expected["world"]);var after=Section(saves.World.Capture(World.world,"solidification"));while((int)before["version"]<4){int version=(int)before["version"];var migration=(Cultiway.Core.Persistence.ISaveMigration)Activator.CreateInstance(typeof(AbilityCast).Assembly.GetType("Cultiway.Content.Skills.WorldMaterialsV"+version+"ToV"+(version+1)),true);before["data"]=migration.Apply((JObject)before["data"]);before["version"]=version+1;}Check(JToken.DeepEquals(before,after),"全部凝固水格、基底、材料、来源及支付原样恢复");var rows=(JArray)after["data"]["Records"];var record=rows.Single();var data=record["Material"].ToObject<AbilityMaterialData>();Check(data.State=="solid"&&data.Flow.Bed!=null&&data.Flow.Water.Where((_,i)=>i%3!=0).All(v=>v==0),"冷启动后保持真实零动量凝固层");Check((long)record["Provider"]==(long)expected["actor"]&&data.Resource==8,"原支付者和八点剩余份额保持，不重发支付");
Config.paused=false;double until=World.world.getCurWorldTime()+.4;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;await Game.WaitUntil(()=>(bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);after=Section(saves.World.Capture(World.world,"solidification"));Check(JToken.DeepEquals(record["Material"],((JArray)after["data"]["Records"]).Single()["Material"]),"跨进程继续世界时间不恢复旧冲势");
var actual=((IDictionary)typeof(WorldMaterialService).GetField("rows",F).GetValue(null))[(long)record["Id"]];var material=actual.GetType().GetField("Material",F).GetValue(actual);var thawed=(AbilityMaterial)typeof(AbilityMaterial).GetMethod("ConvertTo",F).Invoke(material,new object[]{AbilityMatters.Resolve("water","liquid","test"),null});var thaw=(AbilityMaterialData)typeof(AbilityMaterial).GetMethod("Capture",F).Invoke(thawed,null);Check(thaw.State=="liquid"&&thaw.Flow.Bed==null&&thaw.Flow.Water.Where((_,i)=>i%3!=0).All(v=>v==0),"读档后的共同材料转换从零内部动量解冻");Check(thaw.Volume==data.Volume&&thaw.Resource==data.Resource,"解冻保持实际体积及原份额");var result=new{passed=true,checks,savedProcess=(int)expected["process"],process};File.WriteAllText(Path.Combine(folder,"restart.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
