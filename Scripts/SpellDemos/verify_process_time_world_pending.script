ConstructedAbilityService.CastStarted += Started; WorldMaterialService.Changed += Changed;
try
{
    var plain = Target("pace-target", new ConstructionResidue()); await Cast(plain); await Advance(.23f);
    long first = Left(plain); var range = RequestDefinition("pace-range", seconds: 2);
    range.Root.Operations[0].Erosion = new ConstructionErosion { Fraction = .75f, TimeWindows = new[]
    {
        new ConstructionProcessWindow { At = .2f, Seconds = 1, Rate = 0 },
        new ConstructionProcessWindow { At = 1.2f, Seconds = 1.4f, Rate = 2 }
    } };
    var live = await Cast(range); await Advance(.5f); var paused = Material(first);
    await Advance(.35f); var still = Material(first);
    Check(live.StepStateOf("after") == ConstructionStepState.Waiting && Close((double)paused["Erosion"]["Progress"], .1) &&
        (double)still["Erosion"]["WorldElapsed"] > (double)paused["Erosion"]["WorldElapsed"] &&
        (double)paused["Volume"] == (double)still["Volume"] && (double)paused["Resource"] == (double)still["Resource"],
        "范围选中木料后暂停无扣耗，下游仍在等待", still["Erosion"]);
    await Advance(1.45f);
    var receipts = new List<ConstructionWorldReceipt>(); live.AppendOperationReceipts("root", "erode", receipts);
    Check(live.StepStateOf("after") == ConstructionStepState.Completed && receipts.Count == 1 &&
        receipts[0].Materials.Contains(first) && Close(receipts[0].ErodedVolume, 6) && Close(receipts[0].ErodedResource, 2.25),
        "加速到真实完成才放行，回执使用实际木料和损耗", receipts);
    var residue = Target("pace-residue", new ConstructionResidue { ErosionSeconds = 4, Erosion = new ConstructionErosion { Fraction = .75f, TimeWindows = new[]
    {
        new ConstructionProcessWindow { At = .35f, Seconds = 2.5f, Rate = 0 },
        new ConstructionProcessWindow { At = 2.85f, Seconds = 2, Rate = 2 }
    } } });
    var leaving = await Cast(residue); await Advance(.8f); long id = Left(residue);
    var before = Material(id); await Advance(.35f); var after = Material(id);
    double elapsed = (double)after["Erosion"]["WorldElapsed"];
    Check(leaving.Finished && elapsed > .75 && elapsed < 1.65 && Close((double)after["Erosion"]["Progress"], .35 / 4) &&
        (double)after["Volume"] == (double)before["Volume"] && (double)after["Resource"] == (double)before["Resource"] &&
        Close((double)after["Volume"] + (double)after["Weathering"]["LostVolume"], 8) &&
        Close((double)after["Resource"] + (double)after["Weathering"]["SpentResource"], 3),
        "留置木料脱离施放后仍保留已耗份额，暂停中正式存档", after["Erosion"]);
    int process = System.Diagnostics.Process.GetCurrentProcess().Id;
    File.WriteAllText(Path.Combine(folder, "expected.json"), JsonConvert.SerializeObject(new { process, id, first, section = Section() }, Formatting.Indented));
    SaveManager.saveWorldToDirectory(Path.Combine(folder, "pending-save"));
    return new { passed = true, closed = "留置与范围侵蚀暂停恢复，保存暂停中的真实世界", process, elapsed };
}
finally
{
    WorldMaterialService.Changed -= Changed; ConstructedAbilityService.CastStarted -= Started;
    ConstructedAbilityService.ContactConfirmed -= Hit; ConstructedAbilityService.CastEnded -= Ended;
    Config.paused = true; ControllableUnit.clear(false);
}
