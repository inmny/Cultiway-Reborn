Actor source = Make(60), enemy = Make(74, "wolf"); var owner = source.GetExtend();
owner.NewCultisys(Cultisyses.Xian); owner.GetCultisys<Xian>().level = 2;
owner.MarkCultiwayStatsDirty(); source.setStatsDirty(); source.updateStats();
var active = new List<AbilityCast>(); var world = new List<ConstructedWorldContact>(); var materials = new List<WorldMaterialChange>();
void Started(ConstructedCastStarted fact)
{
    if (fact.SourceId != source.id) return;
    foreach (object running in (IEnumerable)service.GetField("casts", F).GetValue(null))
        if ((long)Field(running, "Id") == fact.CastId) active.Add((AbilityCast)Field(running, "Cast"));
}
void WorldHit(ConstructedWorldContact fact) { if (fact.SourceId == source.id) world.Add(fact); }
void Material(WorldMaterialChange fact) { if (fact.Provider == source.id) materials.Add(fact); }
ConstructedAbilityService.CastStarted += Started; ConstructedAbilityService.WorldContactConfirmed += WorldHit; WorldMaterialService.Changed += Material;
JArray Records() => (JArray)JObject.Parse(Cultiway.ModClass.I.WorldSaves.World.Capture(World.world, "material-transfer"))["sections"]["world_materials"]["data"]["Records"];
void ResetGround(int row, TileType main)
{
    for (int y = row - 2; y <= row + 2; y++) for (int x = 62; x <= 70; x++)
        World.world.GetTileSimple(x, y).setTileTypes(main, main == TileLibrary.soil_low ? TopTileLibrary.grass_low : null);
}
AbilityDefinition Copy(AbilityDefinition value) => JsonConvert.DeserializeObject<AbilityDefinition>(JsonConvert.SerializeObject(value));
async Task<AbilityCast> Cast(AbilityDefinition value, int row)
{
    Ready(source); await Advance(.15f); Place(source, 60); Place(enemy, 74);
    owner.GetCultisys<Xian>().wakan = source.stats[BaseStatses.MaxWakan.id] * .8f;
    float before = owner.GetCultisys<Xian>().wakan;
    await Fire(value, source, enemy, aim: new Vector3(64.5f, row + .5f, 0), aggro: false);
    owner.E.RemoveComponent<ConstructedKnowledge>();
    Check(Math.Abs(before - owner.GetCultisys<Xian>().wakan - value.Cost) < .001f, "正式使用支付原报价 " + value.Id);
    return active.Last();
}
try
{
    var definition = JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(folder, "saved-definition.json")));
    ResetGround(72, TileLibrary.soil_low);
    var live = await Cast(definition, 72); double initial = live.RemainingVolume(0), principal = live.RemainingResource(0);
    await Advance(.4f);
    var facts = world.Where(fact => fact.AbilityId == definition.Id && fact.Result.Changed).ToArray();
    double used = facts.Sum(fact => fact.MaterialVolume), paidShare = facts.Sum(fact => fact.MaterialResource);
    Check(facts.Length == 2 && Math.Abs(used - 1) < .00001 &&
        Math.Abs(live.RemainingVolume(0) + used - initial) < .00001 &&
        Math.Abs(live.RemainingResource(0) + paidShare - principal) < .00001,
        "真实抬地逐块交出体积及支付份额，剩余材料守恒", new { initial, used, principal, paidShare, remaining = live.RemainingVolume(0) });
    Check(facts.All(fact => World.world.GetTileSimple(fact.X, fact.Y).main_type == TileLibrary.soil_high) &&
        facts.GroupBy(fact => (fact.X, fact.Y)).All(group => group.Count() == 1), "永久原版地形对应成功事件且每块只交出一次");
    var views = new List<FormVisualInstance>(); live.AppendVisuals(views);
    Check(views.Single().Transform.lossyScale.x < 1, "真实实体及作用形状随交出份额缩小");
    await Advance(1); var leave = materials.Single(fact => fact.AbilityId == definition.Id && fact.Kind == "leave");
    Check(live.Finished && Math.Abs(leave.Volume + used - initial) < .00001 && live.RemainingVolume(0) == 0,
        "原施放结束只留置实际余量，已交出份额退出源体");

    var water = Copy(definition); water.Id = "test.material-transfer.water"; water.Name = "有限水填入原版";
    water.Root.Form = "water_wave"; water.Root.Matter = "water"; water.Root.Rotation = new float[3];
    water.Root.Operations = new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Flow,
        Flow = new ConstructionFlow { Cells = 16, Size = 4, Gravity = 0, Drag = 0, Evaporation = 0, OpenBoundary = false } },
        new ConstructionOperation { Kind = ConstructionOperationKind.Leave, At = .6f, Residue = new ConstructionResidue() } };
    water.Impact.WorldEffects[0].Action = "water.fill"; water.Impact.WorldEffects[0].MaterialVolume = .01f;
    ResetGround(76, TileLibrary.pit_shallow_waters);
    live = await Cast(water, 76); await Advance(.05f); initial = live.RemainingVolume(0); principal = live.RemainingResource(0);
    var flow = ((Array)typeof(AbilityCast).GetField("flows", F).GetValue(live)).GetValue(0);
    var beforeWater = ((Vector3[])Field(flow, "Water")).Select(value => value.x).ToArray();
    await Advance(.3f);
    var wet = world.Where(fact => fact.AbilityId == water.Id && fact.Result.Changed).ToArray();
    double transferred = (double)Field(flow, "Transferred"); used = wet.Sum(fact => fact.MaterialVolume);
    Check(wet.Length == 2 && used > 0 && Math.Abs(transferred - used) < .000001 &&
        Math.Abs(live.RemainingVolume(0) + used - initial) < .00001 &&
        Math.Abs(live.RemainingResource(0) + wet.Sum(fact => fact.MaterialResource) - principal) < .00001 &&
        wet.All(fact => World.world.GetTileSimple(fact.X, fact.Y).Type.ocean),
        "局部真实水格交给原版水地块，去向、实际水量和支付份额守恒", new { initial, used, transferred, remaining = live.RemainingVolume(0), cell = Field(flow, "Cell"), origin = new[] { ((Vector2)Field(flow, "Origin")).x, ((Vector2)Field(flow, "Origin")).y }, maximumDepth = beforeWater.Max(), nativeFill = World.world.GetTileSimple(64, 76).Type.can_be_filled_with_ocean });
    var afterWater = (Vector3[])Field(flow, "Water");
    int changedCells = Enumerable.Range(0, afterWater.Length).Count(index => Math.Abs(beforeWater[index] - afterWater[index].x) > .000001f);
    Check(changedCells > 0 && changedCells <= wet.Length, "交出只扣除实际接触水格，其余水格保持", new { changedCells, operations = wet.Length });
    await Advance(1); Check(live.Finished, "水体交出后余量留置及原施放结束");
    var expected = new { sourceId = source.id, process = System.Diagnostics.Process.GetCurrentProcess().Id,
        tiles = facts.Concat(wet).Select(fact => new { fact.X, fact.Y, main = World.world.GetTileSimple(fact.X, fact.Y).main_type.id }).ToArray(),
        records = Records(), definition, water };
    File.WriteAllText(Path.Combine(folder, "saved-expected.json"), JsonConvert.SerializeObject(expected, Formatting.Indented));
    SaveManager.saveWorldToDirectory(Path.Combine(folder, "successful-save"));

    var previewDefinition = Copy(definition); previewDefinition.Id = "test.material-transfer.preview";
    previewDefinition.Root.Operations = previewDefinition.Root.Operations.Where(operation => operation.Kind != ConstructionOperationKind.Leave).ToArray();
    previewDefinition.Impact.WorldEffects[0].MaterialVolume = 5;
    ResetGround(72, TileLibrary.soil_low);
    object[] previewArgs = { owner, AbilityCompiler.Compile(previewDefinition, false), new Vector3(64.5f, 72.5f, 0), null };
    bool previewed = (bool)service.GetMethod("TryPreviewWorld", F).Invoke(null, previewArgs);
    var tileSets = (IDictionary)Field(previewArgs[3], "Tiles");
    var previewTiles = ((IEnumerable)tileSets["terrain.raise"]).Cast<int>().ToArray();
    Check(previewed && previewTiles.Length == 1 && World.world.GetTileSimple(64, 72).main_type == TileLibrary.soil_low,
        "世界用途预估遵守同一有限材料预算且不修改原版地块");

    var insufficient = Copy(definition); insufficient.Id = "test.material-transfer.insufficient";
    insufficient.Impact.WorldEffects[0].MaterialVolume = 9;
    ResetGround(72, TileLibrary.soil_low); live = await Cast(insufficient, 72); initial = live.RemainingVolume(0);
    await Advance(.4f);
    Check(!world.Any(fact => fact.AbilityId == insufficient.Id) && live.RemainingVolume(0) == initial &&
        World.world.GetTileSimple(64, 72).main_type == TileLibrary.soil_low, "实际材料不足阻止原版操作，体积及支付份额保持");
    await Advance(1); Check(live.Finished, "材料不足仍正常结束并归还运行资源");
    ConstructionWorldActions.Register(new ConstructionWorldAction("verify.material.reject", tile => true, tile => default));
    var failed = Copy(definition); failed.Id = "test.material-transfer.failed"; failed.Impact.WorldEffects[0].Action = "verify.material.reject";
    live = await Cast(failed, 72); initial = live.RemainingVolume(0); principal = live.RemainingResource(0);
    await Advance(.4f);
    Check(world.Any(fact => fact.AbilityId == failed.Id) && world.Where(fact => fact.AbilityId == failed.Id).All(fact =>
        !fact.Result.Changed && fact.MaterialVolume == 0 && fact.MaterialResource == 0) &&
        live.RemainingVolume(0) == initial && live.RemainingResource(0) == principal, "原版确认失败不交出材料和原支付份额");
    await Advance(1);
    ResetGround(72, TileLibrary.soil_low); live = await Cast(definition, 72); await Advance(1.5f);
    Check(live.Finished && !BodyControlState.IsBusy(source.id) && world.Count(fact => fact.AbilityId == definition.Id && fact.Result.Changed) == 4,
        "失败后原成品再次使用、成功交出及自然结束");
    return new { passed = true, closed = "永久地形、水层局部交出、失败及余量恢复", process = System.Diagnostics.Process.GetCurrentProcess().Id };
}
finally
{
    ConstructedAbilityService.CastStarted -= Started; ConstructedAbilityService.WorldContactConfirmed -= WorldHit; WorldMaterialService.Changed -= Material;
    ConstructedAbilityService.ContactConfirmed -= Hit; ConstructedAbilityService.CastEnded -= Ended;
    File.WriteAllText(Path.Combine(folder, "events.json"), JsonConvert.SerializeObject(new { world, materials }, Formatting.Indented));
    Config.paused = true; ControllableUnit.clear(false);
}
