// 点火、有限燃料、真实缩形、支撑烧尽、回退、拆分及工作池一致性。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Core.Visuals.Forms;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Static|BindingFlags.Instance;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/burning");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}object Call(object o,string name,params object[] args)=>o.GetType().GetMethod(name,F).Invoke(o,args);
AbilityDefinition Definition(){var d=JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/可燃分枝.json")));d.Root.Scale=1;d.Root.Volume=4;d.Root.Offset=new float[3];d.Lifetime=8;d.Root.Children=Array.Empty<ConstructionNode>();return d;}
AbilityCast Cast(AbilityDefinition d)=>new AbilityCast(AbilityCompiler.Compile(d),Matrix4x4.identity,inputs:new AbilityInputs(Vector3.zero,Vector3.right,Vector3.right,1),force:100,paidResource:8);
double Heat(AbilityCast c,int node,double amount)=>(double)Call(c,"HeatWood",node,amount,123L,Vector3.zero);List<AbilityCapsule> Shapes(AbilityCast c){var result=new List<AbilityCapsule>();c.AppendContacts(result,includeMaterials:true);return result;}
var wood=Cast(Definition());Check(AbilityMatters.Resolve("wood",null,"测试").Combustible&&!AbilityMatters.Resolve("iron",null,"测试").Combustible,"可燃性来自明确材料规则，不由木纹推断");Check(Math.Abs(Heat(wood,0,.25)-.25)<1e-8&&!wood.Burning(0).Lit,"不足点火量只保存实际热量");wood.Advance(.5f,Vector3.right);Check(wood.RemainingVolume(0)==4&&wood.Burning(0).Burned==0,"未点燃时不会按特效外观损耗材料");Heat(wood,0,.25);Check(wood.Burning(0).Lit&&wood.Burning(0).Source==123,"累积真实热量达到阈值才点燃并保留来源");wood.Advance(1,Vector3.right);Check(Math.Abs(wood.RemainingVolume(0)-3)<1e-5&&Math.Abs(wood.Burning(0).Burned-1)<1e-5,"一世界秒只消耗有限起燃燃料的四分之一");Check(Math.Abs(wood.RemainingResource(0)-6)<1e-4&&Math.Abs(wood.RemainingForce(0)-75)<.001,"材料烧损同步降低原攻击力与可返还支付");Check(Math.Abs(wood.Burning(0).Heat-1.5)<1e-5,"燃料产生的有限热量与原攻击力量分别记账");Call(wood,"SaveStep");wood.Advance(.3f,Vector3.right);Call(wood,"RestoreStep");Check(Math.Abs(wood.Burning(0).Burned-1)<1e-5&&Math.Abs(wood.RemainingVolume(0)-3)<1e-5,"预测回退完整恢复燃料和热量");Call(wood,"CoolWood",0,wood.Burning(0).Heat);wood.Advance(.5f,Vector3.right);Check(!wood.Burning(0).Lit&&Math.Abs(wood.RemainingVolume(0)-3)<1e-5,"移除全部热量后停止燃烧，不补回木料");Heat(wood,0,10);Check(wood.Burning(0).Lit&&Math.Abs(wood.Burning(0).Fuel-3)<1e-5,"重新点燃只以当时剩余木料起燃");
var iron=Definition();iron.Root.Matter="iron";iron.Root.Surface="wood";var fake=Cast(iron);Check(Heat(fake,0,100)==0&&!fake.Burning(0).Lit,"金属换成木纹仍不能燃烧");Call(wood,"ChangeMatter",0,AbilityMatters.Resolve("iron",null,"测试"));Check(!wood.Burning(0).Lit&&wood.Burning(0).Heat==0,"变为不可燃材料会解除旧燃烧");
var connected=Definition();connected.Root.Children=new[]{new ConstructionNode{Id="child",Form="branch",Matter="wood",Volume=1,ContactRole=ConstructionContactRole.Decoration,Anchor="tip_0"}};var tree=Cast(connected);float radius=Shapes(tree).First(s=>s.Node==1).Radius;double childVolume=tree.RemainingVolume(1);Heat(tree,0,10);tree.Advance(1,Vector3.right);Check(Math.Abs(Shapes(tree).First(s=>s.Node==1).Radius-radius)<1e-6&&Math.Abs(tree.RemainingVolume(1)-childVolume)<1e-6,"主干缩损不凭空减少完整子枝的尺寸或材料");tree.Advance(3.1f,Vector3.right);Check(tree.RemainingVolume(0)==0&&Shapes(tree).Any(s=>s.Node==1),"主干烧尽后完整子枝脱离而非凭空消失");Check(tree.RemainingResource(0)==0&&Math.Abs(tree.RemainingVolume(1)-childVolume)<1e-6,"烧尽材料不能退款，完整子枝仍保有自己的数量");
var immediate=JsonConvert.DeserializeObject<AbilityDefinition>(JsonConvert.SerializeObject(connected));immediate.Root.Offset=new[]{10f,0f,0f};immediate.Root.Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Leave,At=0,Residue=new ConstructionResidue{Lifetime=0}}};var leaving=Cast(immediate);Check(Shapes(leaving).Any(s=>s.Node==1&&s.A.x>9),"零时刻留置父体先采样真实挂点，子部位不会从世界原点脱离");
var source=Cast(Definition());Heat(source,0,10);source.Advance(.5f,Vector3.right);var material=(AbilityMaterial)Call(source,"CaptureMaterial",0);var data=(AbilityMaterialData)Call(material,"Capture");var restored=(AbilityMaterial)typeof(AbilityMaterial).GetMethod("Restore",F).Invoke(null,new object[]{data});var restoredData=(AbilityMaterialData)Call(restored,"Capture");Check(JToken.DeepEquals(JObject.FromObject(data),JObject.FromObject(restoredData)),"留存材料完整往返保留热量、燃料、来源与真实形状");Call(material,"Advance",.25f,null);Call(restored,"Advance",.25f,null);Check(Math.Abs(material.Volume-restored.Volume)<1e-8&&Math.Abs(material.Resource-restored.Resource)<1e-8,"恢复后继续剩余过程，不重新点火或补满燃料");var invalid=JsonConvert.DeserializeObject<AbilityMaterialData>(JsonConvert.SerializeObject(data));var bad=invalid.Burning.Value;bad.Heat=-1;invalid.Burning=bad;try{typeof(AbilityMaterial).GetMethod("Restore",F).Invoke(null,new object[]{invalid});throw new Exception("接受了负热量");}catch(TargetInvocationException error)when(error.InnerException is InvalidDataException){}checks.Add("正式保存边界拒绝非法燃烧资料");
var migration=typeof(AbilityCast).Assembly.GetType("Cultiway.Content.Skills.WorldMaterialsV2ToV3");var old=JObject.Parse("{\"Records\":[{\"Id\":1,\"Material\":{\"Volume\":4,\"Resource\":8}}],\"RecoveryGroups\":[]}");var converted=(JObject)Call(Activator.CreateInstance(migration,true),"Apply",old);Check(converted["Records"][0]["Material"]["Burning"].Type==JTokenType.Null&&(double)converted["Records"][0]["Material"]["Volume"]==4,"第二版迁移不点火，也不改变旧数量");
var flowing=Definition();flowing.Root.Form="water_flow";flowing.Root.Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Flow,Flow=new ConstructionFlow{Cells=16,Size=8,Evaporation=0,OpenBoundary=false}}};var granules=Cast(flowing);Heat(granules,0,10);granules.Advance(.5f,Vector3.right);var granular=(AbilityMaterial)Call(granules,"CaptureMaterial",0);var gd=(AbilityMaterialData)Call(granular,"Capture");Check(Math.Abs(granules.RemainingVolume(0)-3.5)<.001&&gd.Flow.Recovered==0&&gd.Flow.Evaporated==0,"数值层承载的木料烧损不冒充回能或蒸散");
var poolType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.SimulationWorkerPool");var pool=poolType.GetProperty("Instance",F).GetValue(null);var run=poolType.GetMethod("RunIndexed",F);var plan=AbilityCompiler.Compile(Definition());foreach(int count in new[]{32,128}){AbilityCast New()=>new AbilityCast(plan,Matrix4x4.identity,inputs:new AbilityInputs(Vector3.zero,Vector3.right,Vector3.right,1),force:100,paidResource:8);var left=Enumerable.Range(0,count).Select(i=>New()).ToArray();var right=Enumerable.Range(0,count).Select(i=>New()).ToArray();foreach(var c in left.Concat(right))Heat(c,0,1);string State(AbilityCast c){c.Advance(1.5f,Vector3.right);return JsonConvert.SerializeObject(new{volume=c.RemainingVolume(0),resource=c.RemainingResource(0),force=c.RemainingForce(0),burning=c.Burning(0)});}var serial=left.Select(State).ToArray();var parallel=new string[count];Action<int> work=i=>parallel[i]=State(right[i]);run.Invoke(pool,new object[]{0,count,work});Check(serial.SequenceEqual(parallel),"有限燃烧在串行与真实工作池一致："+count);await Game.NextFrame();}
var result=new{passed=true,checks};File.WriteAllText(Path.Combine(folder,"math.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
