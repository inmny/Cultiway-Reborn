// 正式地点施放实际改变原版地形；同一脚本分别在原版和Worldfall运行。
using System;using System.Collections;using System.IO;using System.Linq;using System.Reflection;using System.Collections.Generic;using System.Threading.Tasks;using Newtonsoft.Json;using Newtonsoft.Json.Linq;using UnityEngine;using Cultiway.Core;using Cultiway.Core.Skills;using Cultiway.Core.Visuals.Forms;using Cultiway.Core.SkillLibV3.ActiveAbilities;using Cultiway.Core.SkillLibV3.Effects;using Cultiway.Core.SkillLibV3.Usage;using Cultiway.Content.Skills;using Cultiway.Content.Components;using Cultiway.Content.Combat;using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Instance|BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic;string root=Cultiway.ModClass.I.GetDeclaration().FolderPath;var ground=(Func<Rect,AbilityHeightField>)typeof(ConstructedAbilityService).GetField("GroundProvider",F).GetValue(null);string mode=ground==null?"native":"worldfall",folder=Path.Combine(root,"artifacts/skill_rebuild/terrain-world",mode);Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new InvalidOperationException(n);checks.Add(n);Log.Info(n);}var rt=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=rt.GetProperty("Instance").GetValue(null);async Task Boundary()=>await Game.WaitUntil(()=>(bool)rt.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);async Task Advance(float sec){Config.paused=false;double end=World.world.getCurWorldTime()+sec;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=end,3600);Config.paused=true;await Boundary();}
Config.paused=true;Game.Resume();ControllableUnit.clear(false);Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();World.world.console.Hide();foreach(var screen in Resources.FindObjectsOfTypeAll<LoadingScreen>())screen.gameObject.SetActive(false);foreach(var old in World.world.units.getSimpleList().ToArray())old.dieAndDestroy(AttackType.Other);for(int y=60;y<100;y++)for(int x=45;x<95;x++){var t=World.world.GetTileSimple(x,y);if(t.building!=null)t.building.removeBuildingFinal();t.setTileTypes(TileLibrary.soil_low,TopTileLibrary.grass_low);}
var hs=new BaseStats();hs.addTag("frozen_ai");hs.addTag("immovable");var hold=Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.TerrainWorldHold")??Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.TerrainWorldHold").SetStats(hs).SetDuration(10000).Build();Actor Make(int x,int y){var a=World.world.units.createNewUnit("human",World.world.GetTileSimple(x,y),pAdultAge:true,pSpawnWithItems:false);a.addTrait("super_health");CombatStatusEffects.ApplyStatus(a,hold,10000,a);a.setStatsDirty();a.updateStats();return a;}var actor=Make(60,72);var owner=actor.GetExtend();owner.AddComponent(new Xian{level=2,wakan=200});owner.MarkCultiwayStatsDirty();var observer=Make(65,72);
AbilityDefinition Def(string name,string action)=>new(){Id="test.terrain-world."+name,Name="地形验证·"+name,Resource="wakan",Cost=3,Cooldown=0,Lifetime=.8f,TargetRange=100,Power=0,Use=new ConstructionUse{Channels=ActiveAbilityChannel.World,Target=ActiveAbilityTargetMode.Point},Impact=new ConstructionImpact{DamageScale=0,WorldEffects=new[]{new ConstructionWorldEffect{Action=action}}},Root=new ConstructionNode{Id="surface",Form="sword",Matter="iron",Rotation=new[]{0f,90f,0f},ActiveFrom=.1f,Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Fly,Vector=new float[3],WorldVelocity=true,InheritVelocity=false,Ground=ConstructionGroundResponse.Follow}}}};
bool Cast(AbilityDefinition d,Vector3 p){ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(owner,d.Id);return ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,d.Id),new ActiveAbilityTarget(null,p),ActiveAbilityUseOrigin.Script);}var events=new List<ConstructedWorldContact>();var actorGroundErrors=new List<float>();void Contact(ConstructedWorldContact e){if(e.SourceId!=actor.id)return;events.Add(e);if(ground!=null&&e.Result.Changed){var sim=typeof(ConstructedAbilityService).GetField("simulation",F).GetValue(null);var field=(AbilityHeightField)sim.GetType().GetField("terrain",F).GetValue(sim);foreach(var m in (IEnumerable)sim.GetType().GetField("actors",F).GetValue(sim))if((long)m.GetType().GetField("Id",F).GetValue(m)==observer.id){var to=(Vector3)m.GetType().GetField("To",F).GetValue(m);var foot=new Vector3(observer.current_position.x,observer.current_position.y,observer.position_height);actorGroundErrors.Add(Math.Abs(to.z-foot.z-field.Sample(foot.x,foot.y)));}}}ConstructedAbilityService.WorldContactConfirmed+=Contact;var records=new List<object>();try{
foreach(var test in new[]{new{name="raise",action="terrain.raise",row=72,input=TileLibrary.soil_low,output=TileLibrary.soil_high,flag=SkillEffectOutcomeFlags.TerrainRaised},new{name="lower",action="terrain.lower",row=76,input=TileLibrary.soil_high,output=TileLibrary.soil_low,flag=SkillEffectOutcomeFlags.TerrainLowered},new{name="fill",action="water.fill",row=80,input=TileLibrary.pit_shallow_waters,output=TileLibrary.shallow_waters,flag=SkillEffectOutcomeFlags.WaterFilled},new{name="drain",action="water.drain",row=84,input=TileLibrary.shallow_waters,output=TileLibrary.pit_shallow_waters,flag=SkillEffectOutcomeFlags.WaterDrained}}){
for(int y=test.row-2;y<=test.row+2;y++)for(int x=61;x<=70;x++)World.world.GetTileSimple(x,y).setTileTypes(test.input,test.input==TileLibrary.soil_low?TopTileLibrary.grass_low:test.input==TileLibrary.soil_high?TopTileLibrary.grass_high:null);if(test.name=="fill"||test.name=="drain"){for(int y=test.row-2;y<=test.row+2;y++)for(int x=61;x<=70;x++)if(y!=test.row||x<64||x>(test.name=="drain"?64:67))World.world.GetTileSimple(x,y).setTileTypes(TileLibrary.soil_low,TopTileLibrary.grass_low);World.world.GetTileSimple(68,test.row+3).setTileTypes(test.input,null);}Vector3 point=new(64.5f,test.row+.5f,0);var before=ground?.Invoke(new Rect(60,test.row-4,14,8));float oldHeight=before?.Sample(point.x,point.y)??0;var d=Def(test.name,test.action);if(test.name=="fill"||test.name=="drain"){d.Root.Scale=.2f;d.Root.Operations=Array.Empty<ConstructionOperation>();}float paidBefore=owner.GetComponent<Xian>().wakan;Check(Cast(d,point),"正式学习与地点入口接受"+test.name);Check(Math.Abs(owner.GetComponent<Xian>().wakan-(paidBefore-3))<.001f,"正式启动只支付一次费用："+test.name);await Advance(.36f);var actual=events.Where(e=>e.AbilityId==d.Id&&e.Result.Changed).ToArray();Check(actual.Length>0&&actual.All(e=>e.Y==test.row&&e.X>=64&&e.X<=67&&(e.Result.Flags&test.flag)!=0),"真实刃面内产生原版地形结果："+test.name);Check(actual.All(e=>World.world.GetTileSimple(e.X,e.Y).main_type==test.output)&&actual.GroupBy(e=>(e.X,e.Y)).All(g=>g.Count()==1),"实际地形只按每块一次改变一层："+test.name);Check(World.world.GetTileSimple(68,test.row).main_type==((test.name=="fill"||test.name=="drain")?TileLibrary.soil_low:test.input)&&World.world.GetTileSimple(65,test.row+1).main_type==((test.name=="fill"||test.name=="drain")?TileLibrary.soil_low:test.input),"作用面外的实际地块保持："+test.name);
var view=FormVisualScene.Instances.First(v=>v.Resource.Description.Id=="sword");if(ground!=null){var after=ground(new Rect(60,test.row-4,14,8));Check(view.Terrain!=null&&Math.Abs(view.Terrain.Sample(point.x,point.y)-after.Sample(point.x,point.y))<.00001f,"发布画面使用改变后的共同地表："+test.name);Check(Math.Abs(before.Sample(point.x,point.y)-oldHeight)<.00001f,"改变世界不改旧发布快照："+test.name);if(test.name=="raise"||test.name=="lower")Check(actual.Any(e=>Math.Abs(after.Sample(e.X+.5f,e.Y+.5f)-before.Sample(e.X+.5f,e.Y+.5f))>.01f),"实际改变地块上的三维承托高度已改变："+test.name);}
records.Add(new{test.name,tiles=actual.Select(e=>new{e.X,e.Y,main=World.world.GetTileSimple(e.X,e.Y).main_type.id}).ToArray(),oldHeight,height=view.Terrain?.Sample(point.x,point.y)??0});await Advance(.65f);}
var road=World.world.GetTileSimple(65,88);road.setTileTypes(TileLibrary.soil_low,TopTileLibrary.road);var bt=World.world.GetTileSimple(66,88);bt.setTileTypes(TileLibrary.soil_low,TopTileLibrary.grass_low);var building=World.world.buildings.addBuilding("windmill_human_0",bt);var protectedDef=Def("protected","terrain.raise");protectedDef.Resource="none";protectedDef.Cost=0;Check(Cast(protectedDef,new Vector3(64.5f,88.5f,0)),"包含道路和建筑的区域可正式施放");await Advance(1);Check(road.Type.road&&road.main_type==TileLibrary.soil_low&&bt.building==building&&building.isAlive()&&bt.main_type==TileLibrary.soil_low,"道路与原版建筑保持，不能被地形用途破坏");Check(!events.Any(e=>e.AbilityId==protectedDef.Id&&(e.X==65||e.X==66)&&e.Y==88),"受保护地块没有伪造成功接触");
var high=Def("high","terrain.raise");high.Resource="none";high.Cost=0;high.Root.Operations=Array.Empty<ConstructionOperation>();Check(Cast(high,new Vector3(64.5f,92.5f,5)),"接受明确离地高度的地点");await Advance(1);Check(!events.Any(e=>e.AbilityId==high.Id),"明确悬空地点不被加地表时压回地面");
if(ground!=null)Check(actorGroundErrors.Count>0&&actorGroundErrors.Max()<.00001f,"地形接触提交时人物受击边界已同步新地面，而非等下一帧");var save=SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));Check(save.actors_data.Any(a=>a.id==actor.id),"原版正式保存包含实际施法者");var saves=Cultiway.ModClass.I.WorldSaves;File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,actor=actor.id,world=saves.World.Capture(World.world,"terrain-world"),person=saves.Actors.Capture(owner,"terrain-world"),records},Formatting.Indented));var result=new{passed=true,checks,mode,process=System.Diagnostics.Process.GetCurrentProcess().Id,events,records,actorGroundErrors};File.WriteAllText(Path.Combine(folder,"result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{File.WriteAllText(Path.Combine(folder,"partial.json"),JsonConvert.SerializeObject(new{checks,events,records,actorGroundErrors},Formatting.Indented));ConstructedAbilityService.WorldContactConfirmed-=Contact;Config.paused=true;}
