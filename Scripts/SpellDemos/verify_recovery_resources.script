// 正式支付与真实回能，不用数值探针冒充人物资源。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Content.Skills;
using Cultiway.Content.Components;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Usage;
using Cultiway.Content.Combat;
using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Static|BindingFlags.Instance;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/recovery");var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}Config.paused=true;Game.Resume();Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;
var holdStats=new BaseStats();holdStats["mana"]=256;holdStats["stamina"]=256;holdStats.addTag("frozen_ai");holdStats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.RecoveryHold").SetStats(holdStats).SetDuration(10000).Build();
var actor=World.world.units.createNewUnit("human",World.world.GetTileSimple(64,72),pAdultAge:true,pSpawnWithItems:false);actor.addTrait("super_health");actor.attack_timer=999;CombatStatusEffects.ApplyStatus(actor,hold,10000,actor);var owner=actor.GetExtend();owner.AddComponent(new Xian{level=2,wakan=100});owner.AddComponent(new Knight{level=2,vigor=100});actor.setStatsDirty();owner.MarkCultiwayStatsDirty();actor.updateStats();
var events=new List<ConstructedRecovery>();void Event(ConstructedRecovery e){if(e.ProviderId==actor.id)events.Add(e);}ConstructedAbilityService.RecoveryConfirmed+=Event;
async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,1800);Config.paused=true;var runnerType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=runnerType.GetProperty("Instance").GetValue(null);await Game.WaitUntil(()=>(bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner),1800);}
AbilityDefinition Definition(string resource)=>new(){Id="test.recovery.real."+resource,Name="真实回能验证",Resource=resource,Cost=8,Cooldown=0,Lifetime=2,Impact=new ConstructionImpact{Targets=SkillUseTargetRelation.Self,DamageScale=0},Binding=new ConstructionBinding{Anchor=AbilityAnchor.Source},Root=new ConstructionNode{Id="generated",Form="sword",Matter="iron",ContactRole=ConstructionContactRole.Decoration,Offset=new[]{3f,0f,1f},Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Recover,At=.25f,Seconds=.6f,Recovery=new ConstructionRecovery{Efficiency=.75f}}}}};
float Balance(string r)=>r switch{"wakan"=>owner.GetCultisys<Xian>().wakan,"vigor"=>owner.GetCultisys<Knight>().vigor,"mana"=>actor.getMana(),"stamina"=>actor.data.stamina,_=>0};
void SetBalance(string r){switch(r){case "wakan":owner.GetCultisys<Xian>().wakan=Mathf.Min(100,actor.stats[Cultiway.Content.BaseStatses.MaxWakan.id]*.5f);break;case "vigor":owner.GetCultisys<Knight>().vigor=Mathf.Min(100,actor.stats[Cultiway.Content.BaseStatses.MaxVigor.id]*.5f);break;case "mana":actor.setMana(actor.getMaxMana()/2);break;case "stamina":actor.data.stamina=actor.getMaxStamina()/2;break;}}
try{foreach(string resource in new[]{"wakan","vigor","mana","stamina"}){SetBalance(resource);float before=Balance(resource);Check(before>=8,"测试人物有真实可支付资源："+resource);var d=Definition(resource);ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(owner,d.Id);int first=events.Count;Check(ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,d.Id),new ActiveAbilityTarget(actor,actor.GetSimPos()),ActiveAbilityUseOrigin.Script),"正式能力入口受理："+resource);Check(Math.Abs(Balance(resource)-(before-8))<.0001,"原资源只支付一次："+resource);await Advance(1.2f);var rows=events.Skip(first).Where(e=>e.AbilityId==d.Id).ToArray();double granted=rows.Sum(e=>e.Granted);Check(rows.Length>0&&Math.Abs(granted-6)<.001,"真实回能入原支付资源且合计六点："+resource);Check(rows.All(e=>e.Resource==resource&&e.ProviderId==actor.id&&e.Granted>=0)&&rows.Sum(e=>e.Requested)<=8.0001&&rows.Sum(e=>e.Granted)<=rows.Sum(e=>e.Requested)+.0000001,"种类、身份、累计预算均保持："+resource);}
// 单精度资源分多步写入仍不能超过百分之百预算。
var full=Definition("wakan");full.Id+=".exact-budget";full.Root.Operations[0].Recovery.Efficiency=1;SetBalance("wakan");ConstructedAbilityService.Register(full);ConstructedAbilityService.Learn(owner,full.Id);int exactFirst=events.Count;Check(ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,full.Id),new ActiveAbilityTarget(actor,actor.GetSimPos()),ActiveAbilityUseOrigin.Script),"全比例回能经过正式支付");await Advance(1.2f);var exact=events.Skip(exactFirst).Where(e=>e.AbilityId==full.Id).ToArray();Check(exact.Sum(e=>e.Granted)<=8&&exact.Sum(e=>e.Granted)>7.99&&exact.Sum(e=>e.Requested)<=8,"多次单精度写入不超过八点预算，小数累计保留");
// 巨量资源中的小费用可能无法表示，不能给未实际扣到的费用退款。
var tiny=Definition("wakan");tiny.Id+=".payment-precision";ConstructedAbilityService.Register(tiny);ConstructedAbilityService.Learn(owner,tiny.Id);owner.GetCultisys<Xian>().wakan=268435456f;int tinyFirst=events.Count;Check(ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,tiny.Id),new ActiveAbilityTarget(actor,actor.GetSimPos()),ActiveAbilityUseOrigin.Script),"巨量存量的小费用经过真实入口");Check(owner.GetCultisys<Xian>().wakan==268435456f,"本次原资源精度确实没有扣到八点");owner.GetCultisys<Xian>().wakan=100;await Advance(1.2f);Check(events.Skip(tinyFirst).Where(e=>e.AbilityId==tiny.Id).All(e=>e.Requested==0&&e.Granted==0),"后来改变余额也不能虚构先前未支付的回能");
// 整数资源扣费也使用整数运算，不能先转单精度再丢掉小费用。
var integral=Definition("mana");integral.Id+=".integer-payment";ConstructedAbilityService.Register(integral);ConstructedAbilityService.Learn(owner,integral.Id);actor.setMana(268435456,false);Check(ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,integral.Id),new ActiveAbilityTarget(actor,actor.GetSimPos()),ActiveAbilityUseOrigin.Script),"巨量法力的小费用经过真实入口");Check(actor.getMana()==268435448,"整数法力存量精确扣除八点，不经单精度中转");await Advance(1.2f);
var edge=Definition("mana");edge.Id+=".integer-edge";edge.Cost=2147483520f;ConstructedAbilityService.Register(edge);ConstructedAbilityService.Learn(owner,edge.Id);actor.setMana(2147483519,false);Check(!ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,edge.Id),new ActiveAbilityTarget(actor,actor.GetSimPos()),ActiveAbilityUseOrigin.Script),"整数资源比费用差一点也不会因浮点比较误通过");var overflow=Definition("mana");overflow.Id+=".overflow";overflow.Cost=2147483648f;try{ConstructedAbilityService.Register(overflow);throw new Exception("未拒绝整数溢出费用");}catch(InvalidDataException){checks.Add("超过原资源整数上限的费用在正式登记前拒绝");}
// 入账时满容量，已失去的份额不会在腾出容量后重放。
var cap=Definition("wakan");cap.Id+=".capacity";SetBalance("wakan");ConstructedAbilityService.Register(cap);ConstructedAbilityService.Learn(owner,cap.Id);int capFirst=events.Count;Check(ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,cap.Id),new ActiveAbilityTarget(actor,actor.GetSimPos()),ActiveAbilityUseOrigin.Script),"容量边界正式施放");owner.GetCultisys<Xian>().wakan=actor.stats[Cultiway.Content.BaseStatses.MaxWakan.id];await Advance(1.2f);Check(events.Skip(capFirst).Where(e=>e.AbilityId==cap.Id).All(e=>e.Granted==0),"满容量的请求当次损失，没有超上限入账");int capCompleted=events.Count;owner.GetCultisys<Xian>().wakan=10;await Advance(.5f);Check(events.Skip(capCompleted).Where(e=>e.AbilityId==cap.Id).All(e=>e.Requested==0&&e.Granted==0),"腾出容量后不重新补发已经确认的旧回能，自然恢复不算退款");
// 旧世界或其他玩法可能已有超上限法力，回收不能顺带扣掉原存量。
var above=Definition("mana");above.Id+=".above-cap";SetBalance("mana");ConstructedAbilityService.Register(above);ConstructedAbilityService.Learn(owner,above.Id);int aboveFirst=events.Count;Check(ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,above.Id),new ActiveAbilityTarget(actor,actor.GetSimPos()),ActiveAbilityUseOrigin.Script),"超容量法力边界正式施放");actor.setMana(actor.getMaxMana()+12,false);await Advance(1.2f);Check(events.Skip(aboveFirst).Where(e=>e.AbilityId==above.Id).All(e=>e.Granted==0),"回收不把已有超容量存量夹掉，也不产生负数入账");
// 运行中替换同编号目录，旧施放的原支付种类仍冻结。
var replaced=Definition("wakan");replaced.Id+=".changed";SetBalance("wakan");ConstructedAbilityService.Register(replaced);ConstructedAbilityService.Learn(owner,replaced.Id);int changedFirst=events.Count;Check(ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,replaced.Id),new ActiveAbilityTarget(actor,actor.GetSimPos()),ActiveAbilityUseOrigin.Script),"目录改写边界正式施放");replaced.Resource="mana";ConstructedAbilityService.Register(replaced);await Advance(1.2f);Check(events.Skip(changedFirst).Where(e=>e.AbilityId==replaced.Id).All(e=>e.Resource=="wakan")&&events.Skip(changedFirst).Sum(e=>e.Granted)>5.9,"已开始施放使用开始时支付种类，不被同编号新目录改写");
}
finally{ConstructedAbilityService.RecoveryConfirmed-=Event;Config.paused=true;}
CombatStatusEffects.RemoveStatus(actor,hold);owner.MarkCultiwayStatsDirty();actor.setStatsDirty();actor.updateStats();string saved=Path.Combine(folder,"resources");Directory.CreateDirectory(saved);SaveManager.saveWorldToDirectory(Path.Combine(saved,"save"));var saves=Cultiway.ModClass.I.WorldSaves;File.WriteAllText(Path.Combine(saved,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,actor=actor.id,id="test.recovery.real.wakan.changed",wakan=owner.GetCultisys<Xian>().wakan,world=saves.World.Capture(World.world,"recovery-paid"),person=saves.Actors.Capture(owner,"recovery-paid")},Formatting.Indented));
var result=new{passed=true,checks,events=events.Select(e=>new{e.CastId,e.AbilityId,e.ProviderId,e.Resource,e.Requested,e.Granted,e.ConvertedVolume}).ToArray()};File.WriteAllText(Path.Combine(folder,"resources.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
