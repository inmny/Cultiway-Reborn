using Cultiway.Core.Skills;
using Cultiway.Content.Skills;
using Cultiway.Content.YaoBeasts;
foreach (var old in Resources.FindObjectsOfTypeAll<MonoBehaviour>()
             .Where(item => item != null && item.GetType().Name == "CultiwaySpellDemoRunner"))
{
    if ((bool)old.GetType().GetField("busy", BindingFlags.Instance | BindingFlags.NonPublic).GetValue(old))
        throw new InvalidOperationException("已有演示正在录制，请先等待完成或结束上一条命令");
    UnityEngine.Object.DestroyImmediate(old.gameObject);
}

var host = new GameObject("Cultiway.SpellDemo.Tool");
UnityEngine.Object.DontDestroyOnLoad(host);
var runner = host.AddComponent<CultiwaySpellDemoRunner>();
runner.Install();
return new { installed = true, catalog = runner.Root + "/catalog.json" };

    /// <summary>单次安装后轮询本地请求，逐招录制；不为每招重复编译调试程序集。</summary>
    public sealed class CultiwaySpellDemoRunner : MonoBehaviour
    {
/// <summary>请求与清单所在目录。</summary>
public string Root;

/// <summary>当前运行请求。</summary>
private JObject request;

/// <summary>已处理的请求编号，安装时忽略磁盘上的旧请求。</summary>
private string handled;

/// <summary>本次运行输出目录。</summary>
private string output;

/// <summary>错误时保留正在处理的稳定编号。</summary>
private string currentCase;

/// <summary>当前构造是否握持真实铁剑。</summary>
private bool heldSwordDemo;

/// <summary>是否正在录制。</summary>
private bool busy;

/// <summary>下次检查请求的实际时间。</summary>
private float nextPoll;

/// <summary>准备和录制过程中出现的真实错误。</summary>
private readonly List<string> errors = new();

/// <summary>演示人物。</summary>
private Actor caster;

/// <summary>受伤友军。</summary>
private Actor friend;

/// <summary>用于弹丸、范围与连锁的敌军。</summary>
private readonly List<Actor> enemies = new();

/// <summary>冻结世界背景人物，避免长时间遍历时走入演示场地。</summary>
private readonly HashSet<long> isolated = new();

/// <summary>来源专属技能的原始容器，保留其真实回调和消耗。</summary>
private readonly Dictionary<string, Entity> granted = new();

/// <summary>本轮演示用临时技能容器。</summary>
private Entity temporarySkill;

/// <summary>等最后一个执行体消散后才释放的临时容器。</summary>
private readonly List<Entity> retiringSkills = new();

/// <summary>当前法术的实际生成次数。</summary>
private int spawned;

/// <summary>每段演示独立的行动边界，上一段不能继续改变下一段场景。</summary>
private long executionCase;

/// <summary>已提交的共同地块结果，区别实际作用与仅有开始事件。</summary>
private readonly List<object> worldContactsLog = new();
private readonly List<ConstructedCastEnded> constructionEndLog = new();

/// <summary>已实际登记给收件人的消息，按施放编号与接触独立归档。</summary>
private readonly List<ConstructedSignalReceipt> signals = new();

/// <summary>实际正式提交的支付，保留付款人与每条真实通道。</summary>
private readonly List<object> committedPayments = new();

/// <summary>当前观察的技能容器。</summary>
private Entity observed;

/// <summary>录制前的界面状态。</summary>
private bool previousHidden;

/// <summary>只在录制期间隐藏画布，结束时恢复原状态。</summary>
private readonly Dictionary<Canvas, bool> canvases = new();

/// <summary>本招正在使用的真实法宝。</summary>
private Entity artifact;

/// <summary>本招真实采用的器形、材质与能力参数。</summary>
private object artifactDetails;

/// <summary>本段所有真实出手、接触和范围结算，独立于装饰模型计数。</summary>
private readonly List<object> executionLog = new();

private readonly List<object> recoveryLog = new();
private readonly List<object> conductionLog = new();

/// <summary>正式确认的水火反应，不以蒸散画面代替数量结算。</summary>
private readonly List<object> quenchingLog = new();

/// <summary>材料的真实加热、冷却和有限烧损。</summary>
private readonly List<object> burningLog = new();

private readonly List<object> contactsLog = new();
private readonly List<object> queuedDamageLog = new();

/// <summary>本段正式掌击的受理编号及自然结束结果。</summary>
private long palmCast;

/// <summary>从实际执行收到的结束事实。</summary>
private ConstructedCastEnded? palmEnd;
private readonly List<object> areasLog = new();

/// <summary>本段实际屏障接触和空间数据，供核对长轴、厚度与半径。</summary>
private readonly List<object> barrierLog = new();

private readonly Dictionary<int, object> footprints = new();

/// <summary>逐帧收集可疑黄色精灵，供定位方块来源，不在录像时隐藏它们。</summary>
private readonly HashSet<string> yellowObjects = new();

private readonly List<(ActorExtend Owner, Entity Skill)> learnedForBattle = new();
private Entity incomingSkill;
private bool probeUsed, breakProbeUsed;
private float barrierBefore, barrierLowest;

/// <summary>本段已经受理的构造屏障，只从真实交锋读取其容量损耗。</summary>
private readonly HashSet<long> observedBarriers = new();
private Type externalView;
private object externalViewInstance;
private bool? previousTerrainMouseLookOff;

/// <summary>本招法宝或战技的正式能力句柄。</summary>
private ActiveAbilityHandle ability;

/// <summary>正在展示的骑士战技。</summary>
private KnightTechniqueAsset technique;

/// <summary>公共及内部成员查询。</summary>
private const BindingFlags Flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static |
                                   BindingFlags.Instance;

/// <summary>导出游戏中当前实际注册的技能与兼容项目。</summary>
public void Install()
{
    Root = Environment.GetEnvironmentVariable("CULTIWAY_DEMO_CONTROL") ??
        Path.Combine(Cultiway.ModClass.I.GetDeclaration().FolderPath, "artifacts/spell_demo");
    Directory.CreateDirectory(Root);
    string selection = Path.Combine(Root, "request.json");
    handled = File.Exists(selection) ? (string)JObject.Parse(File.ReadAllText(selection))["id"] : null;
    var assembly = typeof(Cultiway.ModClass).Assembly;
    var core = assembly.GetType("Cultiway.Content.CoreFormationSkills", true);
    foreach (var property in core.GetProperties(Flags)
                 .Where(property => property.PropertyType == typeof(Entity)))
    {
        Entity entity = (Entity)property.GetValue(null);
        if (entity.IsAvailable() && entity.TryGetComponent(out SkillContainer skill))
            granted[skill.Asset.id] = entity;
    }

    var mod = Cultiway.ModClass.I;
    var modifiers = mod.SkillV3.ModifierLib.list.Where(asset => asset.EditorSelectable && !asset.IsDisabled)
        .ToArray();
    var trajectories = mod.SkillV3.TrajLib.list.Where(asset => asset.EditorSelectable).ToArray();
    var techniques = KnightTechniqueCatalog.All.ToDictionary(value => value.id + ".Execution",
        StringComparer.Ordinal);
    var organSkills = new HashSet<string>(Cultiway.Content.Libraries.Manager.CreatureOrganRankLibrary.list
        .SelectMany(rank => rank.SkillContainerIds), StringComparer.Ordinal);
    var rows = new List<object>();
    foreach (var asset in mod.SkillV3.SkillLib.list.OrderBy(asset => asset.id, StringComparer.Ordinal))
    {
        bool formation = granted.ContainsKey(asset.id), organ = organSkills.Contains(asset.id);
        bool tribulation = asset.id.Contains("BalefulWindTribulation");
        if (asset.id == "Cultiway.raw_anim" || !asset.CanBeLearned && !formation &&
            !tribulation && !organ && !techniques.ContainsKey(asset.id)) continue;
        bool hasScene = asset.CanBeLearned || formation || tribulation || techniques.ContainsKey(asset.id);
        string unavailable = asset.Animations.Count == 0 ? "没有演示所需的原法术动画登记" :
            hasScene ? null : "需要从实际器官来源出手";
        techniques.TryGetValue(asset.id, out var martial);
        var labels = LegacyLabels(asset, martial, formation, tribulation, organ);
        string trajectory = SkillBlueprintTrajectory.ResolveDefaultId(asset);
        var context = unavailable == null ? SkillEditContext.Create(Blueprint(asset, 0, trajectory)) : null;
        bool adjustable = context != null && asset.CanBeLearned && asset.EditorSelectable;
        rows.Add(new
        {
            id = asset.id, name = Name(asset.id), variants = asset.Animations.Count,
            group = formation ? "金丹元婴" : tribulation ? "天劫" : martial != null ? "骑士战技" :
                !hasScene ? "器官能力" : "基础法术",
            adjustable, trajectory, relation = asset.UseProfile.TargetRelation.ToString(),
            labels, unavailable,
            trajectories = trajectories.Where(item => context != null &&
                item.CheckEditorCompatibility(context, false).IsCompatible &&
                SkillTrajectoryCompatibility.IsCompatible(asset, item)).Select(item => item.id).ToArray(),
            modifiers = modifiers.Where(item => context != null &&
                    item.CheckEditorCompatibility(context, item.CreateDefaultSpec()).IsCompatible)
                .Select(item => item.id).ToArray()
        });
    }

    var artifactScenes = new Dictionary<string, string>
    {
        [ArtifactAbilities.DamageDiversion.id] = "redirection",
        [ArtifactAbilities.DingAlchemyAssist.id] = "alchemy",
        [ArtifactAbilities.ArtifactSpiritAwakening.id] = "spirit",
        [ArtifactAbilities.SectGuardianTreasure.id] = "sect"
    };
    foreach (var asset in Cultiway.Content.Libraries.Manager.ArtifactAbilityLibrary.list.OrderBy(asset => asset.id))
    {
        bool active = asset.active_use != null;
        var labels = new CatalogLabels();
        labels.Source.Add(active ? "artifact.active" : "artifact.passive", active ? "法宝主动" : "法宝被动");
        labels.AddSemantics(asset.semantics);
        rows.Add(new
        {
            id = asset.id, name = active ? Name(asset.id) : asset.GetName(), variants = active ? 1 : 0,
            group = active ? "法宝主动" : "法宝被动", adjustable = false,
            trajectory = "专属动作", relation = asset.active_use?.target_mode.ToString(), labels,
            unavailable = active ? null : "需要触发法宝自身的被动来源",
            triggerScene = artifactScenes.TryGetValue(asset.id, out string scene) ? scene : null,
            trajectories = Array.Empty<string>(), modifiers = Array.Empty<string>()
        });
    }
    var abilityType = typeof(ConstructedAbilityService);
    var palm = (CompiledAbility)abilityType.GetProperty("PalmExecution", Flags).GetValue(null);
    var palmLabels = new CatalogLabels();
    palmLabels.Source.Add("martial", "战技");
    palmLabels.School.Add("body", "身体战技");
    palmLabels.AddScale(0f, single: true);
    palmLabels.AddImpacts(palm);
    rows.Add(new
    {
        id = "Cultiway.PalmStrike", name = Name("Cultiway.PalmStrike"), variants = 1, group = "近身掌击",
        adjustable = false,
        trajectory = "身体接触", relation = "Hostile", labels = palmLabels, trajectories = Array.Empty<string>(),
        modifiers = Array.Empty<string>()
    });
    // 世界重载会重建构造目录。把这次选择所需的完整资料留在清单里，特别是世界内已创作的构造。
    var identifiers = new HashSet<string>(rows.Select(row => (string)JObject.FromObject(row)["id"]),
        StringComparer.Ordinal);
    var definitions = (IDictionary)abilityType.GetField("definitions", Flags).GetValue(null);
    var planFor = (Func<string, CompiledAbility>)abilityType.GetMethod("PlanFor", Flags)
        .CreateDelegate(typeof(Func<string, CompiledAbility>));
    var composition = (Func<string, ElementComposition>)abilityType.GetMethod("Composition", Flags)
        .CreateDelegate(typeof(Func<string, ElementComposition>));
    foreach (AbilityDefinition definition in definitions.Values.Cast<AbilityDefinition>()
                 .OrderBy(value => value.Id, StringComparer.Ordinal))
    {
        if (!identifiers.Add(definition.Id)) continue;
        rows.Add(new
        {
            id = definition.Id, name = definition.Name ?? definition.Id, variants = 1,
            group = definition.Body == null ? "万法阁构造" : "万法阁战技", adjustable = false,
            trajectory = "构造资料", trajectories = Array.Empty<string>(), modifiers = Array.Empty<string>(),
            construction = JObject.FromObject(definition), constructionSource = "当前世界登记",
            labels = ConstructionLabels(definition, planFor(definition.Id), composition),
            unavailable = ConstructionSceneProblem(definition)
        });
    }
    Write(Path.Combine(Root, "catalog.json"), new
    {
        generatedAt = DateTime.UtcNow,
        processStarted =
            (System.Diagnostics.Process.GetCurrentProcess().StartTime.ToUniversalTime() -
             new DateTime(1970, 1, 1)).TotalSeconds,
        modPath = mod.GetDeclaration().FolderPath,
        runtime = CultiwayDemoRuntime.Loaded(),
        assembly = typeof(Cultiway.ModClass).Assembly.ManifestModule.ModuleVersionId.ToString(), spells = rows,
        modifiers = modifiers.Select(item => new
            { id = item.id, name = Name(item.id), parameters = item.CreateDefaultSpec().Parameters }).ToArray(),
        trajectories = trajectories.Select(item => new { id = item.id, name = Name(item.id) }).ToArray()
    });
    WriteMigrationInventory(rows);
}

/// <summary>目录标签的稳定编号和当前语言名称。空集合代表正式资料没有这一项依据。</summary>
private sealed class CatalogLabels
{
    [JsonProperty("source")] public readonly Dictionary<string, string> Source = new(StringComparer.Ordinal);
    [JsonProperty("school")] public readonly Dictionary<string, string> School = new(StringComparer.Ordinal);
    [JsonProperty("scale")] public readonly Dictionary<string, string> Scale = new(StringComparer.Ordinal);
    [JsonProperty("effect")] public readonly Dictionary<string, string> Effect = new(StringComparer.Ordinal);
    [JsonProperty("range")] public float? Range;

    /// <summary>读取既有正向语义及其上级。用官方元素名称、作用名称和流派语义。</summary>
    public void AddSemantics(SemanticDescriptor descriptor)
    {
        var semantics = new HashSet<SemanticAsset>();
        descriptor?.CollectExpanded(Cultiway.ModClass.L.SemanticLibrary, semantics);
        var facets = Cultiway.ModClass.L.SemanticFacetLibrary;
        foreach (var semantic in semantics.OrderBy(value => value.id, StringComparer.Ordinal))
        {
            if (semantic.Facet == facets.Element || semantic == SkillSemantics.Form.Sword ||
                semantic == SkillSemantics.Delivery.Melee)
                School[semantic.id] = semantic.GetName();
            if (semantic.Facet == facets.Role || semantic.Facet == facets.Effect)
                Effect[semantic.id] = semantic.GetName();
        }
    }

    /// <summary>读取现有元素数值，原登记可能同时含有几个元素。</summary>
    public void AddElements(ElementComposition composition)
    {
        var ranked = ElementSemanticProfileService.Build(composition).GetRanked(
            SemanticQueryPolicy.Default, Cultiway.ModClass.L.SemanticFacetLibrary.Element);
        foreach (var item in ranked.Where(item => item.semantic != SkillSemantics.Element.Generic))
            School[item.semantic.id] = item.semantic.GetName();
    }

    /// <summary>列出可查的规模依据。数字仅用于分档，真实命中由游戏决定。</summary>
    public void AddScale(float range, bool single = false, bool entireWorld = false)
    {
        if (range > 0f) Range = range;
        if (entireWorld) Scale.Add("world", "世界");
        else if (range >= 24f) Scale.Add("city", "城域");
        else if (single) Scale.Add("personal", "个人");
        else if (range > 0f) Scale.Add("local", "局部战场");
    }

    /// <summary>取当前计划真正可触发的人物作用及编译器确认的用途。</summary>
    public void AddImpacts(CompiledAbility plan)
    {
        if (plan.ContactDamageScale > 0f || plan.ActorImpacts.Any(impact => impact.AdditionalDamage.Count > 0))
            Effect[SkillSemantics.Effect.Damage.id] = SkillSemantics.Effect.Damage.GetName();
        if (plan.ContactControl > 0f) Effect[SkillSemantics.Effect.Control.id] = SkillSemantics.Effect.Control.GetName();
        if (plan.HasBarrier) Effect["barrier"] = "屏障";
        if (plan.HasRecovery) Effect["recover-cost"] = "回收施放资源";
        if (plan.Use.SelfStatus != null || plan.ActorImpacts.Any(impact => impact.Statuses.Count > 0))
            Effect["status"] = "状态";
        if (plan.HasWorldEffects) Effect["world-contact"] = "地块作用";
        if (plan.HasPropagation) Effect["propagation"] = "传播";
        foreach (var operation in plan.Operations.Where(operation => operation.Effects != ConstructionOperationEffect.None))
        {
            var kind = operation.Contract.Kind;
            string nameKey = "Cultiway.Construction.MotionKind." + kind;
            Effect["operation." + kind] = LM.Has(nameKey) ? LM.Get(nameKey) : kind.ToString();
            if (kind is ConstructionOperationKind.MapSpace or ConstructionOperationKind.MapActor or ConstructionOperationKind.MapArtifact)
                Effect["spatial-passage"] = "空间通行";
            if (kind == ConstructionOperationKind.SendSignal) Effect["signal"] = "传讯";
        }
        foreach (var impact in plan.ActorImpacts)
        {
            if (impact.WakanTransfer > 0f) Effect["wakan-transfer"] = "真元转移";
            if (impact.Signal != null) Effect["signal"] = "传讯";
            if (impact.Perception != ConstructionPerception.None) Effect["perception"] = "感知";
            if (impact.Restoration?.HasEffect == true) Effect["restoration"] = "恢复与净化";
            if (impact.HasAgingEffect) Effect["aging"] = "老化";
            if (impact.EquipmentRepair != null) Effect["repair"] = "修复";
        }
    }
}

/// <summary>旧术沿用同一项能力的实际来源、元素、效果及作用范围登记。</summary>
private static CatalogLabels LegacyLabels(SkillEntityAsset asset, KnightTechniqueAsset technique, bool formation,
    bool tribulation, bool organ)
{
    var labels = new CatalogLabels();
    if (asset.CanBeLearned) labels.Source["learnable"] = "可学习法术";
    if (formation) labels.Source["formation"] = "修炼专属";
    if (tribulation) labels.Source["tribulation"] = "天劫";
    if (organ) labels.Source["organ"] = "器官";
    if (technique != null)
    {
        labels.Source["martial"] = "战技";
        labels.School[technique.Style.id] = technique.Style.ResolveName();
    }
    labels.AddSemantics(asset.Semantics);
    labels.AddElements(asset.Element);
    if (asset.DealsBaseDamage) labels.Effect[SkillSemantics.Effect.Damage.id] = SkillSemantics.Effect.Damage.GetName();
    foreach (var effect in asset.Effects) labels.Effect[effect.Id] = effect.Id.Localize();
    if (asset.Effects.Any(effect => effect.IsTileEffect)) labels.Effect["world-contact"] = "地块作用";
    if (asset.ImpactProfile is { } impact)
    {
        if (impact.IsBarrier) labels.Effect["barrier"] = "屏障";
        float range = Mathf.Max(impact.EffectRadius, impact.JumpRadius, impact.BarrierLength * .5f,
            impact.LinearForward, impact.LinearBackward);
        labels.AddScale(range, single: range == 0f && !impact.IsAreaImpact && !impact.IsField &&
            !impact.IsBeam && !impact.IsBarrier);
    }
    return labels;
}

/// <summary>从原资料及同版已编译的能力查范围和规则，保留自创或导入的实际来源。</summary>
private static CatalogLabels ConstructionLabels(AbilityDefinition definition, CompiledAbility plan,
    Func<string, ElementComposition> composition)
{
    var labels = new CatalogLabels();
    labels.Source["construction"] = "构造登记";
    if (definition.ExternalCreator) labels.Source["imported"] = "导入构造";
    else if (definition.Creator != 0) labels.Source["created"] = "自创构造";
    else labels.Source["builtin"] = "内置构造";
    if (plan.Body != null)
    {
        labels.Source["martial"] = "战技";
        labels.School["body"] = "身体战技";
        if (plan.Body.Part.IsOrgan) labels.Source["organ"] = "器官";
        if (plan.Body.WeaponForm is string weapon) labels.School["weapon." + weapon] = weapon;
    }
    var semantics = Cultiway.ModClass.L.SemanticLibrary;
    foreach (string matter in plan.Matters.Where(matter => matter != "physical"))
    {
        if (semantics.TryResolve(matter, out var element) &&
            element.Facet == Cultiway.ModClass.L.SemanticFacetLibrary.Element)
            labels.School[element.id] = element.GetName();
        else labels.AddElements(composition(matter));
    }
    labels.AddImpacts(plan);
    if (definition.SoulPact != null) labels.Effect["soul-pact"] = "魂契";
    if (definition.WorldCondition is { } condition)
    {
        labels.Effect["world-condition"] = "世界条件";
        labels.Effect["condition." + condition.Kind] = condition.Kind == ConstructionWorldConditionKind.PreventIgnition
            ? "防火" : condition.Kind.ToString();
    }

    var nodes = DemoNodes(definition.Root).ToArray();
    if (plan.HasWorldEffects)
    {
        var actions = plan.ActorImpacts.Append(plan.Impact).SelectMany(impact => impact.WorldEffects)
            .Select(effect => effect.Action.Id).Concat(nodes.SelectMany(node =>
                (node.Impact?.WorldEffects ?? Array.Empty<ConstructionWorldEffect>()).Select(effect => effect.Action)));
        foreach (string action in actions)
        {
            string nameKey = "Cultiway.Construction.WorldAction." + action;
            labels.Effect[action] = LM.Has(nameKey) ? LM.Get(nameKey) : action;
        }
    }
    float range = Mathf.Max(definition.WorldCondition?.EntireWorld == false ? definition.WorldCondition.Radius : 0f,
        (float)Math.Sqrt(plan.Measure.Area / Math.PI),
        plan.HasBarrier || plan.ActorImpacts.Count > 0 || plan.HasWorldEffects ? plan.Reach.Extent : 0f);
    var fronts = nodes.SelectMany(node => node.Operations ?? Array.Empty<ConstructionOperation>())
        .Concat((definition.Steps ?? Array.Empty<ConstructionStep>()).Select(step => step.Operation))
        .Select(operation => operation.Propagation).Where(front => front != null);
    bool entireWorld = definition.WorldCondition?.EntireWorld == true;
    foreach (var front in fronts)
    {
        range = Mathf.Max(range, front.Range);
        entireWorld |= MapBox.width > 0 && MapBox.height > 0 && front.Angle >= 360f &&
            front.MaximumCells >= MapBox.width * (long)MapBox.height &&
            front.Range >= new Vector2(MapBox.width, MapBox.height).magnitude;
    }
    labels.AddScale(range, single: !plan.HasWorldEffects && (plan.Use.Target == ActiveAbilityTargetMode.Self ||
        plan.Body != null && plan.FormCount == 0 && range < 3f), entireWorld: entireWorld);
    return labels;
}

/// <summary>遍历同一份已登记构造中的形体和后段，外部操作步骤由调用方合入。</summary>
private static IEnumerable<ConstructionNode> DemoNodes(ConstructionNode node)
{
    if (node == null) yield break;
    yield return node;
    foreach (var child in node.Children ?? Array.Empty<ConstructionNode>())
        foreach (var nested in DemoNodes(child))
            yield return nested;
}

/// <summary>列出当前通用夹具缺少的原始输入，避免把无法正式受理的能力录成空片。</summary>
private static string ConstructionSceneProblem(AbilityDefinition definition, string species = null, bool battle = false)
{
    string part = DemoEffector(definition.Body);
    bool joint = part?.StartsWith("part:", StringComparison.Ordinal) == true;
    if (species != null && !joint) return "仅依赖真实关节的构造可指定施法身体";
    if (joint && (battle || (species ?? DemoJointSpecies(part)) == null))
        return "需要实际拥有对应关节的身体：" + part;
    if (part?.StartsWith("organ:", StringComparison.Ordinal) == true)
    {
        if (DemoOrgan(part).Species == null) return "缺少实际展示该器官的真身：" + part;
        if (definition.Resource is "wakan" or "vigor") return "器官演示真身缺少原式要求的修炼资源";
    }
    if (definition.Inventory?.Length > 0) return "需要准备资料声明的原库存物项";
    if (definition.Resource is not ("none" or "wakan" or "vigor" or "mana" or "stamina"))
        return "需要提供实际资源：" + definition.Resource;
    if (definition.Body?.WeaponForm is string form && DemoWeapon(form) == null)
        return "夹具找不到实际对应的兵器：" + form;
    return null;
}

/// <summary>身体构造可以先用名称引用实际关节或器官。</summary>
private static string DemoEffector(BodyActionDefinition body)
{
    string effector = body?.Effector;
    return body?.Construction?.Parts?.FirstOrDefault(part => part.Id == effector)?.Part ?? effector;
}

/// <summary>已有实机证据的关节身体，其他关节可由录制参数选择实际身体。</summary>
private static string DemoJointSpecies(string part) => part == "part:leg_fl" ? "wolf" : null;

/// <summary>已有取证的真身搭配。同一器官的资料共用场景，正式绑定仍校验具体部件。</summary>
private static (string Species, string Slot, int Rank) DemoOrgan(string part) =>
    part?.Split('/')[0] switch
    {
        "organ:yao.crown.tails" => ("fox", YaoContent.Slots.Tail, 1),
        "organ:yao.horn.thunder" => ("wolf", YaoContent.Slots.Head, 2),
        "organ:yao.wing.fierce" => ("wolf", YaoContent.Slots.Limbs, 2),
        _ => default
    };

private static void PrepareDemoOrgan(Actor actor, string part, string slot, int rank)
{
    var owner = actor.GetExtend();
    owner.E.RemoveComponent<Xian>();
    owner.E.RemoveComponent<Magic>();
    if (!YaoAwakeningService.TryAwakenByRain(owner)) throw new InvalidOperationException("演示妖兽无法启灵");
    var organs = new List<YaoOrganRecord>
    {
        new YaoOrganRecord { SlotId = YaoContent.Slots.Surface, OrganId = "yao.scale.basic", Rank = 1,
            Origin = YaoOrganOrigin.Innate }
    };
    if (slot != YaoContent.Slots.Head)
        organs.Add(new YaoOrganRecord { SlotId = YaoContent.Slots.Head, OrganId = "yao.spirit.sense", Rank = 1,
            Origin = YaoOrganOrigin.Innate });
    organs.Add(new YaoOrganRecord { SlotId = slot, OrganId = part.Substring("organ:".Length).Split('/')[0],
        Rank = rank, Origin = YaoOrganOrigin.GodEdited });
    if (!YaoFormPlanService.TrySetOrgans(owner, YaoFormIds.TrueForm, organs.ToArray()))
        throw new InvalidOperationException("真身无法表达资料要求的器官：" + part);
    actor.setStatsDirty();
    actor.updateStats();
    actor.finishScale();
}

/// <summary>从原版实际装备登记匹配形体的持物规则，原铁剑保持旧录像的缺省选择。</summary>
private static EquipmentAsset DemoWeapon(string form)
{
    var held = FormResources.Load(form).Description.Held;
    var sword = AssetManager.items.get("sword_iron");
    if (sword != null && held.MatchesEquipment(sword.group_id, sword.id)) return sword;
    return AssetManager.items.list.OrderBy(item => item.id, StringComparer.Ordinal)
        .FirstOrDefault(item => held.MatchesEquipment(item.group_id, item.id));
}

/// <summary>导出实际全部登记及引用，不把可录像项目等同于全部能力。</summary>
/// <param name="demoRows">现有演示能直接覆盖的项目。</param>
private void WriteMigrationInventory(List<object> demoRows)
{
    var mod = Cultiway.ModClass.I;
    var demoIds = new HashSet<string>(demoRows.Select(JObject.FromObject)
        .Where(row => (string)row["unavailable"] == null).Select(row => (string)row["id"]));
    var entries = new List<object>();
    var references = new List<object>();
    var convertedUtility = (ISet<string>)typeof(ConstructedAbilityService).Assembly
        .GetType("Cultiway.Content.Skills.UtilityConstructionMigration", true).GetField("templates", Flags)
        .GetValue(null);
    var spatialForms = (IDictionary)typeof(ConstructedAbilityService).Assembly
        .GetType("Cultiway.Content.Visuals.SkillSpatialVisualCatalog", true).GetField("Forms", Flags)
        .GetValue(null);
    foreach (var asset in mod.SkillV3.SkillLib.list.OrderBy(item => item.id, StringComparer.Ordinal))
    {
        entries.Add(new
        {
            key = "skill:" + asset.id, id = asset.id, name = Name(asset.id), kind = "技能资产",
            variants = asset.Animations.Count, learnable = asset.CanBeLearned,
            editable = asset.EditorSelectable, demo = demoIds.Contains(asset.id),
            source = granted.ContainsKey(asset.id) ? "修炼专属" :
                asset.id.StartsWith("Cultiway.KnightTechnique.") ? "骑士战技" :
                asset.id.Contains("Tribulation") ? "天劫" :
                asset.CanBeLearned ? "可学习法术" : "内部或专属",
            execution = convertedUtility.Contains(asset.id)
                ? "原来源收费及发射 → ConstructedAbilityService"
                : "Cultiway.Core.SkillLibV3.Manager",
            persistence = "WorldObjectSaveService",
            trajectory = SkillBlueprintTrajectory.ResolveDefaultId(asset),
            carrier = asset.CarrierRequirement.ToString(),
            entrypoints = new
            {
                castResources = asset.DefaultCastResourceRequirement?.ResourceAssetIds,
                resourceMode = asset.DefaultCastResourceRequirement?.Mode.ToString(),
                baseDemand = asset.BaseCastDemand, dealsBaseDamage = asset.DealsBaseDamage,
                impact = asset.ImpactProfile?.id, useProfile = asset.UseProfile?.id,
                channels = asset.UseProfile?.Channels.ToString(),
                spatialForm = spatialForms.Contains(asset.id) ? spatialForms[asset.id].ToString() : null,
                requiredModifiers = asset.RequiredModifiers.Select(item => item.AssetId).ToArray(),
                effects = asset.Effects.Select(effect => new
                {
                    id = effect.Id, trigger = effect.Trigger.ToString(), interval = effect.Interval,
                    relation = effect.TargetRelation.ToString(), callbacks = InventoryCallbacks(effect)
                }).ToArray()
            },
            callbacks = InventoryCallbacks(asset), migration = convertedUtility.Contains(asset.id)
                ? "默认功能及支持的改造已接入共同执行；其他词条、轨迹和原容器资料转换待完成"
                : "待实施"
        });
    }

    var handlersField = typeof(ArtifactAbilityAsset).GetField("_handlers", Flags);
    foreach (var asset in
             Cultiway.Content.Libraries.Manager.ArtifactAbilityLibrary.list.OrderBy(item => item.id))
    {
        var handlers = (IDictionary)handlersField.GetValue(asset);
        entries.Add(new
        {
            key = "artifact:" + asset.id, id = asset.id, name = asset.GetName(), kind = "法宝能力",
            active = asset.active_use != null, demo = demoIds.Contains(asset.id),
            events = handlers.Keys.Cast<Type>().Select(type => type.FullName).OrderBy(value => value).ToArray(),
            nameKey = asset.name_key,
            callbacks = InventoryCallbacks(asset.active_use).Concat(InventoryCallbacks(asset.lifecycle))
                .Concat(InventoryCallbacks(asset.vehicle_use)).Concat(InventoryCallbacks(asset.sect_use))
                .Concat(InventoryCallbacks(asset.spirit_use))
                .Concat(handlers.Values.Cast<object>().SelectMany(InventoryCallbacks)).Distinct().ToArray(),
            parameters = asset.parameter_schema.Select(item => item.key).ToArray(),
            entrypoints = new
            {
                channels = asset.active_use?.channels.ToString(),
                target = asset.active_use?.target_mode.ToString(),
                activation = asset.active_use?.activation_mode.ToString(),
                activeCallbacks = InventoryCallbacks(asset.active_use),
                lifecycleCallbacks = InventoryCallbacks(asset.lifecycle)
            },
            execution = "ArtifactAbilityDispatcher", persistence = "ArtifactAbilityInstance", migration = "待实施"
        });
    }

    foreach (var technique in KnightTechniqueCatalog.All)
    {
        entries.Add(new
        {
            key = "technique:" + technique.id, id = technique.id, name = technique.ResolveName(), kind = "战技定义",
            style = technique.Style.id, weapons = technique.Style.WeaponGroups,
            callbacks = InventoryCallbacks(technique.ActiveUse), execution = "KnightTechniqueAbilityProvider",
            persistence = "KnightTechniqueSkills.TryRestoreSavedContainer", migration = "待实施"
        });
        references.Add(new
        {
            owner = "technique:" + technique.id, target = "skill:" + technique.id + ".Execution", role = "专用执行"
        });
    }

    foreach (var rank in Cultiway.Content.Libraries.Manager.CreatureOrganRankLibrary.list.OrderBy(item =>
                 item.id))
    {
        entries.Add(new
        {
            key = "organ:" + rank.id, id = rank.id, name = rank.id.Localize(), kind = "器官等级",
            skills = rank.SkillContainerIds,
            effects = rank.EffectRanks.Select(item => new { id = item.EffectFamilyId, rank = item.Rank })
                .ToArray(),
            upkeep = new
            {
                resource = rank.UpkeepDescriptor.ResourceId, amount = rank.UpkeepDescriptor.AmountPerWorldMonth
            },
            execution = "CreaturePhenotypeActiveAbilityProvider", persistence = "CreatureComposition",
            migration = "待实施"
        });
        foreach (string id in rank.SkillContainerIds)
            references.Add(new { owner = "organ:" + rank.id, target = "skill:" + id, role = "器官出手" });
        foreach (var effect in rank.EffectRanks)
            references.Add(new
                { owner = "organ:" + rank.id, target = "effect:" + effect.EffectFamilyId, role = "器官被动" });
    }

    var families = (IDictionary)typeof(Cultiway.Content.CreatureCompositions.Combat.CreatureOrganEffectFamilies)
        .GetField("families", Flags).GetValue(null);
    foreach (DictionaryEntry item in families)
    {
        var family = (Cultiway.Content.CreatureCompositions.Combat.CreatureOrganEffectFamily)item.Value;
        entries.Add(new
        {
            key = "effect:" + family.Id, id = family.Id, name = family.Id.Localize(), kind = "器官被动效果",
            events = family.Events.ToString(),
            execution = family.Handler.Method.DeclaringType.FullName + "." + family.Handler.Method.Name,
            persistence = "CreatureComposition.EffectRanks", migration = "待实施"
        });
    }

    foreach (var asset in Cultiway.ModClass.L.StatusEffectLibrary.list
                 .Where(item => !item.id.StartsWith("Cultiway.SpellDemo.")).OrderBy(item => item.id))
    {
        entries.Add(new
        {
            key = "status:" + asset.id, id = asset.id, name = asset.GetName(), kind = "状态定义",
            callbacks = InventoryCallbacks(asset), execution = "StatusEffectAsset",
            persistence = "原版人物状态及模组状态资料",
            entrypoints = new
            {
                tick = asset.TickSettings.enabled, interval = asset.TickSettings.interval,
                callbacks = InventoryCallbacks(asset.TickSettings),
                spatial = asset.SpatialSettings?.Form.ToString(), particle = asset.ParticleSettings.enabled,
                stats = asset.stats.getList().Select(item => item.id).ToArray()
            },
            migration = "待实施"
        });
    }

    var assembly = typeof(Cultiway.ModClass).Assembly;
    foreach (var atom in Cultiway.Content.Libraries.Manager.CoreFormationAtomLibrary.list.OrderBy(item =>
                 item.id))
    {
        entries.Add(new
        {
            key = "core_atom:" + atom.id, id = atom.id, name = atom.GetName(), nameKey = atom.name_key,
            kind = "修炼形成原子", realms = atom.realms.ToString(), category = atom.category.ToString(),
            execution = "CoreFormationEffectResolver", migration = "待实施"
        });
        foreach (var effect in atom.effects)
        {
            string key = "core_effect:" + atom.id + "/" + effect.family_id + "/" + effect.rank;
            string trigger = InventorySkillId(effect.TriggerSkill);
            string active = effect.active == null ? null : InventorySkillId(effect.active.SkillContainer);
            entries.Add(new
            {
                key, id = effect.family_id, rank = effect.rank, name = effect.GetName(),
                nameKey = effect.name_key,
                kind = "修炼形成效果", owner = "core_atom:" + atom.id, active = effect.active != null,
                events = effect.triggers.ToString(), triggerSkill = trigger, activeSkill = active,
                callbacks = InventoryCallbacks(effect), execution = "CoreFormationEffectResolver",
                migration = "待实施"
            });
            references.Add(new { owner = "core_atom:" + atom.id, target = key, role = "形成效果" });
            if (trigger != null)
                references.Add(new { owner = key, target = "skill:" + trigger, role = "事件派生执行" });
            if (active != null) references.Add(new { owner = key, target = "skill:" + active, role = "主动执行" });
            if (effect.StateStatus != null)
                references.Add(new { owner = key, target = "status:" + effect.StateStatus.id, role = "持续状态" });
        }
    }

    foreach (var pattern in Cultiway.Content.YaoBeasts.YaoCorePatterns.All.OrderBy(item => item.Id))
    {
        entries.Add(new
        {
            key = "yao_core:" + pattern.Id, id = pattern.Id, name = pattern.NameKey.Localize(),
            nameKey = pattern.NameKey,
            kind = "妖丹神通来源", skills = pattern.SkillIds, execution = "YaoCoreActiveAbilityProvider",
            migration = "待实施"
        });
        foreach (string id in pattern.SkillIds)
            references.Add(new { owner = "yao_core:" + pattern.Id, target = "skill:" + id, role = "凝丹授予" });
    }

    foreach (var atom in
             Cultiway.Content.Libraries.Manager.ElixirEffectAtomLibrary.list.OrderBy(item => item.id))
        entries.Add(new
        {
            key = "elixir_atom:" + atom.id, id = atom.id, name = string.Join("/", atom.name_stems) + "（命名词干）",
            kind = "丹药效果原子", effect = atom.effect_key, mode = atom.effect_mode.ToString(),
            execution = "Cultiway.Content.Libraries.ElixirEffectGenerator", migration = "待实施"
        });
    var providers =
        ((IEnumerable<IActiveAbilityProvider>)typeof(ActiveAbilityService).GetField("Providers", Flags)
            .GetValue(null)).ToArray();
    foreach (var provider in providers.Where(item => item.Id.StartsWith("content.yuanshen_")))
    {
        Type type = provider.GetType();
        MethodInfo presentation = type.GetMethod("ResolvePresentation", Flags);
        foreach (var field in type.GetFields(Flags).Where(field =>
                     field.IsLiteral && field.FieldType == typeof(string) && field.Name != "ProviderId"))
        {
            string id = (string)field.GetRawConstantValue();
            string nameKey = "Cultiway.Yuanshen.Ability.Strike";
            if (presentation != null)
            {
                object[] arguments = { id, null, null };
                presentation.Invoke(null, arguments);
                nameKey = (string)arguments[1];
            }

            entries.Add(new
            {
                key = "command:" + provider.Id + "/" + id, id, name = nameKey.Localize(), nameKey,
                kind = "元神功能命令", provider = provider.Id, constant = field.Name,
                execution = type.FullName, migration = "待实施"
            });
        }
    }

    Type goals = assembly.GetType("Cultiway.Content.CollectiveProjects.CityMagicUtilityProjectGoal", true);
    Type ids = assembly.GetType("Cultiway.Content.CollectiveProjects.CityMagicUtilityProjectIds", true);
    foreach (string name in Enum.GetNames(goals))
    {
        string id = (string)ids.GetField(name, Flags).GetValue(null);
        entries.Add(new
        {
            key = "utility:" + id, id, name, kind = "城市功能工程",
            execution = "CityMagicUtilityProjectPlanner / CityMagicUtilityProjectExecutor",
            persistence = "CollectiveProjectWorldSave", migration = "待实施"
        });
    }

    entries.Add(new
    {
        key = "body:Cultiway.PalmStrike", id = "Cultiway.PalmStrike", name = "近身掌击", kind = "身体动作",
        execution = "PalmStrikeCombat → ConstructedAbilityService", persistence = "瞬时动作不恢复；借用身体结束解除控制",
        demo = true,
        migration = "首轮身体构造已接入，动作与美术继续完善"
    });
    var constructions =
        (IDictionary)typeof(ConstructedAbilityService).GetField("definitions", Flags).GetValue(null);
    foreach (AbilityDefinition definition in constructions.Values.Cast<AbilityDefinition>()
                 .OrderBy(value => value.Id))
    {
        entries.Add(new
        {
            key = "construction:" + definition.Id, id = definition.Id, name = definition.Name, kind = "构造资料",
            execution = "ConstructedAbilityService", persistence = "ability_constructions / ability_knowledge",
            demo = demoIds.Contains(definition.Id) && ConstructionSceneProblem(definition) == null,
            migration = definition.Body == null
                ? "已接入共同形体构造；目录可指定原登记编号"
                : "已接入共同身体、持物及作用；目录列出所需场景"
        });
    }

    Write(Path.Combine(Root, "inventory.json"), new
    {
        schema = 2, generatedAt = DateTime.UtcNow,
        assembly = typeof(Cultiway.ModClass).Assembly.ManifestModule.ModuleVersionId,
        environment = new
        {
            game = Application.version, unity = Application.unityVersion,
            system = SystemInfo.operatingSystem, cpu = SystemInfo.processorType,
            graphics = SystemInfo.graphicsDeviceName,
            memoryMb = SystemInfo.systemMemorySize, processors = SystemInfo.processorCount,
            worldfall = AppDomain.CurrentDomain.GetAssemblies()
                .FirstOrDefault(item => item.GetType("FirstPerson.WorldBoxMod", false) != null)?.GetName()
                .Version
                ?.ToString()
        },
        entries, references,
        sourceEntrances = providers
            .Select(provider => new { id = provider.Id, type = provider.GetType().FullName }).ToArray(),
        pending = new[] { "逐项学习、支付、动作、作用、显示、人工与自主使用、保存及旧路径删除入口，属于 TODO 0.03" }
    });
}

/// <summary>从实际来源容器取得技能稳定编号，不保留临时实体编号。</summary>
/// <param name="entity">登记时持有的来源容器。</param>
private static string InventorySkillId(Entity entity) =>
    !entity.IsNull && entity.TryGetComponent(out SkillContainer skill)
        ? skill.SkillEntityAssetID
        : null;

/// <summary>只读取已登记委托的执行入口，不执行回调或递归序列化游戏对象。</summary>
/// <param name="value">含委托字段的资料对象。</param>
private static string[] InventoryCallbacks(object value) => value == null
    ? Array.Empty<string>()
    : value.GetType().GetFields(Flags)
        .Where(field => typeof(Delegate).IsAssignableFrom(field.FieldType))
        .Select(field => (Delegate)field.GetValue(value))
        .Where(callback => callback != null).SelectMany(callback => callback.GetInvocationList())
        .Select(callback => callback.Method.DeclaringType.FullName + "." + callback.Method.Name).Distinct()
        .OrderBy(item => item).ToArray();

/// <summary>接收新的本地运行请求。</summary>
private void Update()
{
    if (busy || Time.realtimeSinceStartup < nextPoll) return;
    nextPoll = Time.realtimeSinceStartup + .3f;
    string path = Path.Combine(Root, "request.json");
    if (!File.Exists(path)) return;
    var selected = JObject.Parse(File.ReadAllText(path));
    if ((string)selected["id"] == handled) return;
    request = selected;
    handled = (string)selected["id"];
    output = (string)selected["output"];
    busy = true;
    previousHidden = Config.ui_main_hidden;
    Application.logMessageReceived += OnLog;
    Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured += OnSpawn;
    SkillHitResolver.ContactResolved += OnContact;
    SkillHitResolver.AreaResolved += OnArea;
    SkillHitResolver.BarrierContactResolved += OnBarrier;
    ConstructedAbilityService.CastStarted += OnConstructedStart;
    ConstructedAbilityService.WorldContactConfirmed += OnWorldContact;
    ConstructedAbilityService.SignalReceived += OnSignal;
    SkillCastPayment.Committed += OnPayment;
    ConstructedAbilityService.RecoveryConfirmed += OnConstructedRecovery;
    ConstructedAbilityService.ConductionConfirmed += OnConduction;
    ConstructedAbilityService.QuenchingConfirmed += OnQuenching;
    ConstructedAbilityService.BurningConfirmed += OnBurning;
    WorldMaterialService.Changed += OnWorldMaterial;
    ConstructedAbilityService.ContactConfirmed += OnConstructedContact;
    ConstructedAbilityService.QueuedDamageConfirmed += OnQueuedDamage;
    ConstructedAbilityService.CastEnded += OnConstructedEnd;
    ConstructedAbilityService.ClashConfirmed += OnConstructedClash;
    if ((string)request["scene"] == "battle")
        ConstructedAbilityService.ReflectionConfirmed += OnConstructedReflection;
    StartCoroutine(Guarded((string)request["action"] == "resources" ? ProbeFormResources() : Run()));
}

/// <summary>在请求边界记录错误，保证暂停、界面和事件订阅有明确收尾。</summary>
/// <param name="steps">当前演示流程。</param>
private IEnumerator Guarded(IEnumerator steps)
{
    string failure = null;
    while (true)
    {
        bool more;
        try
        {
            more = steps.MoveNext();
        }
        catch (Exception error)
        {
            failure = error.ToString();
            break;
        }

        if (!more) break;
        yield return steps.Current;
    }

    Config.paused = true;
    CleanExecutions();
    ReleaseBodyCloseCamera();
    heldSwordDemo = false;
    RestoreTerrainFirstPersonLook();
    ControllableUnit.clear(false);
    bool sceneRestored = false;
    if ((bool?)request["continueOnFailure"] == true || (string)request["action"] == "construction" ||
        (string)request["scene"] == "battle" || request["requiredSource"] != null ||
        ((JArray)request["cases"]).Any(item => item["construction"] is JObject))
    {
        // 每批结束及失败都回到同一个现成夹具，清除临时已学、材料和未结束动作。
        var restoring = LoadFixture();
        while (true)
        {
            bool more;
            try
            {
                more = restoring.MoveNext();
            }
            catch (Exception error)
            {
                failure = failure == null ? error.ToString() : failure + "\n恢复场景失败：" + error;
                break;
            }

            if (!more)
            {
                sceneRestored = true;
                break;
            }
            yield return restoring.Current;
        }
    }
    Config.paused = true;
    Config.ui_main_hidden = previousHidden;
    foreach (var canvas in canvases)
        if (canvas.Key != null)
            canvas.Key.enabled = canvas.Value;
    canvases.Clear();
    Application.logMessageReceived -= OnLog;
    Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured -= OnSpawn;
    SkillHitResolver.ContactResolved -= OnContact;
    SkillHitResolver.AreaResolved -= OnArea;
    SkillHitResolver.BarrierContactResolved -= OnBarrier;
    ConstructedAbilityService.CastStarted -= OnConstructedStart;
    ConstructedAbilityService.WorldContactConfirmed -= OnWorldContact;
    ConstructedAbilityService.SignalReceived -= OnSignal;
    SkillCastPayment.Committed -= OnPayment;
    ConstructedAbilityService.RecoveryConfirmed -= OnConstructedRecovery;
    ConstructedAbilityService.ConductionConfirmed -= OnConduction;
    ConstructedAbilityService.QuenchingConfirmed -= OnQuenching;
    ConstructedAbilityService.BurningConfirmed -= OnBurning;
    WorldMaterialService.Changed -= OnWorldMaterial;
    ConstructedAbilityService.ContactConfirmed -= OnConstructedContact;
    ConstructedAbilityService.CastEnded -= OnConstructedEnd;
    ConstructedAbilityService.QueuedDamageConfirmed -= OnQueuedDamage;
    ConstructedAbilityService.ClashConfirmed -= OnConstructedClash;
    ConstructedAbilityService.ReflectionConfirmed -= OnConstructedReflection;
    FormVisualScene.Clear();
    Write(Path.Combine(output, "status.json"),
        new { done = true, current = currentCase, error = failure, sceneRestored, errors,
            requestId = handled, runtime = CultiwayDemoRuntime.Loaded() });
    busy = false;
}

/// <summary>复用正式资源和两个绘制入口验证模型接入；没有伤害或自主创法验收含义。</summary>
private IEnumerator ProbeFormResources()
{
    var loading = LoadScene();
    while (loading.MoveNext()) yield return loading.Current;
    JObject item = (JObject)((JArray)request["cases"])[0];
    Prepare(item);
    var hold = Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.SpellDemo.Background");
    foreach (Actor actor in World.world.units.getSimpleList())
    {
        CombatStatusEffects.ApplyStatus(actor, hold, 10000, actor);
        actor.clearAttackTarget();
        actor.setStatsDirty();
        actor.updateStats();
        Place(actor, 12, 12);
    }

    Camera();
    if (externalView != null)
    {
        var entering = EnterView();
        while (entering.MoveNext()) yield return entering.Current;
    }

    currentCase = (string)item["id"];
    string folder = Path.Combine(output, (string)item["key"]);
    Directory.CreateDirectory(Path.Combine(folder, "frames"));
    FormResource sword = FormResources.Load("sword"), branch = FormResources.Load("branch");
    var resources = new[] { sword, branch, sword, branch };
    var surfaces = new[] { null, null, "water", "ice" };
    var times = new List<double>();
    double start = World.world.getCurWorldTime(), duration = (double)request["duration"], next = 0;
    Config.paused = false;
    while (World.world.getCurWorldTime() - start < duration)
    {
        double elapsed = World.world.getCurWorldTime() - start;
        var instances = new FormVisualInstance[resources.Length];
        for (int index = 0; index < instances.Length; index++)
        {
            float phase = (float)elapsed;
            Matrix4x4 transform = Matrix4x4.TRS(new Vector3(58 + index * 6, 71, 1.5f),
                Quaternion.Euler(Mathf.Sin(phase + index) * 14f, Mathf.Cos(phase * .8f) * 20f,
                    Mathf.Sin(phase * .6f) * 18f), Vector3.one * 2.5f);
            var parts = new Matrix4x4[resources[index].Meshes.Length];
            for (int part = 0; part < parts.Length; part++)
            {
                float[] p = resources[index].Description.Parts[part].Pivot;
                Vector3 pivot = new(p[0], p[1], p[2]);
                parts[part] = Matrix4x4.Translate(pivot) *
                              Matrix4x4.Rotate(Quaternion.Euler(0,
                                  Mathf.Sin(phase * 1.4f + part) * (index % 2 == 1 ? 7f : 0f), 0)) *
                              Matrix4x4.Translate(-pivot);
            }

            instances[index] = new FormVisualInstance(resources[index], transform, parts, surfaces[index]);
        }

        FormVisualScene.Publish(instances);
        Camera();
        if (elapsed >= next)
        {
            times.Add(elapsed);
            new ScreenFacade().Capture(Path.Combine(folder, "frames",
                (times.Count - 1).ToString("00000") + ".png"));
            next = elapsed + 1d / (int)request["fps"];
            Write(Path.Combine(output, "status.json"),
                new { done = false, current = item["key"], stage = "资源验证", elapsed, frames = times.Count });
        }

        yield return null;
    }

    Config.paused = true;
    Type bridge =
        typeof(Cultiway.ModClass).Assembly.GetType(
            "Cultiway.Content.Compatibility.Worldfall.FormWorldfallRenderer", true);
    int submitted = (int)bridge.GetProperty("LastDrawCount", Flags).GetValue(null);
    WriteResult(Path.Combine(folder, "result.json"), new
    {
        passed = times.Count > 0 && errors.Count == 0 && (externalView == null || submitted > 0),
        scene = "resources", validation = "仅验证资源读取及绘制提交，实际作用和美术需分别验收", item,
        frames = times.Count, times, duration, view = (string)request["view"],
        lighting = (string)request["lighting"] ?? "day", lightingState = LightingState(), submitted,
        resources = new[] { sword, branch }.Select(form => new
        {
            id = form.Description.Id,
            parts = form.Meshes.Select(mesh => new
                { mesh.name, mesh.vertexCount, uv = mesh.uv.Length, normals = mesh.normals.Length }).ToArray(),
            anchors = form.Description.Anchors.Select(anchor => anchor.Id).ToArray(),
            contacts = form.Description.Contacts.Select(contact => contact.Id).ToArray()
        }).ToArray(),
        errors
    });
}

/// <summary>用完整构造资料登记、学习和实际施放，保留形体及作用来自相同状态的录像。</summary>
/// <summary>正式交锋结果，录像不会用显示重叠替代真实损耗。</summary>
private readonly List<object> clashesLog = new();

/// <summary>原来招已实际转向并移交归属的记录。</summary>
private readonly List<object> reflectionsLog = new();

/// <summary>真实世界材料转交、回收及入账，使用稳定材料编号关联。</summary>
private readonly List<object> worldMaterialsLog = new();

/// <summary>记录已经确认的共同交锋、剩余作用量和实际位置。</summary>
/// <param name="clash">正式确认的交锋事实。</param>
private void OnConstructedClash(ConstructedClash clash)
{
    clashesLog.Add(new
    {
        time = clash.WorldTime,
        leftCast = clash.LeftCast, rightCast = clash.RightCast, leftSource = clash.LeftSource,
        rightSource = clash.RightSource,
        leftNode = clash.LeftNode, rightNode = clash.RightNode, leftAge = clash.LeftAge, rightAge = clash.RightAge,
        leftOriginal = clash.LeftOriginalSource, rightOriginal = clash.RightOriginalSource,
        leftSpent = clash.LeftSpent, rightSpent = clash.RightSpent, leftPresent = clash.LeftPresent,
        rightPresent = clash.RightPresent, guardShape = clash.GuardShape,
        leftRole = clash.LeftRole.ToString(), rightRole = clash.RightRole.ToString(),
        absorbed = clash.Absorbed, leftRemaining = clash.LeftRemaining, rightRemaining = clash.RightRemaining,
        point = new[] { clash.Position.x, clash.Position.y, clash.Position.z }
    });
    if (!probeUsed || clash.Absorbed <= 0 ||
        !observedBarriers.Contains(clash.LeftCast) && !observedBarriers.Contains(clash.RightCast)) return;
    float remaining = observedBarriers.Contains(clash.LeftCast) ? clash.LeftRemaining : clash.RightRemaining;
    // 首次真实交锋给出扣除量及余额，不把自然到期的消失当作成功拦截。
    if (barrierBefore == 0) barrierBefore = barrierLowest = remaining + clash.Absorbed;
    barrierLowest = Mathf.Min(barrierLowest, remaining);
}

/// <summary>保留原施放和屏障实际支付，供双方自主交锋核对。</summary>
private void OnConstructedReflection(ConstructedReflection reflection) => reflectionsLog.Add(new
{
    cast = reflection.CastId, barrierCast = reflection.BarrierCast,
    node = reflection.Node, barrierNode = reflection.BarrierNode,
    original = reflection.OriginalSource, previous = reflection.PreviousOwner, owner = reflection.Owner,
    barrierOriginal = reflection.BarrierOriginalSource, barrierOwner = reflection.BarrierOwner,
    time = reflection.WorldTime, count = reflection.Count, force = reflection.Force,
    barrierSpent = reflection.BarrierSpent, barrierPresent = reflection.BarrierPresent,
    barrierRemaining = reflection.BarrierRemaining,
    point = new[] { reflection.Position.x, reflection.Position.y, reflection.Position.z },
    incoming = new[] { reflection.IncomingVelocity.x, reflection.IncomingVelocity.y, reflection.IncomingVelocity.z },
    outgoing = new[] { reflection.OutgoingVelocity.x, reflection.OutgoingVelocity.y, reflection.OutgoingVelocity.z }
});

/// <summary>通过正式学习和施放入口录制当前资料。</summary>
/// <param name="item">当前构造及其录制编号。</param>
private IEnumerator RecordConstruction(JObject item)
{
    AbilityDefinition definition = item["construction"].ToObject<AbilityDefinition>();
    string requestedSpecies = (string)request["casterSpecies"];
    string unavailable = ConstructionSceneProblem(definition, requestedSpecies);
    if (unavailable != null) throw new InvalidOperationException(unavailable);
    CompiledAbility plan = AbilityCompiler.Compile(definition);
    string effector = DemoEffector(definition.Body);
    var organ = DemoOrgan(effector);
    bool organScene = organ.Species != null;
    bool jointScene = effector?.StartsWith("part:", StringComparison.Ordinal) == true;
    string species = requestedSpecies ?? organ.Species ?? DemoJointSpecies(effector) ?? "human";
    if (AssetManager.actor_library.get(species) == null)
        throw new InvalidOperationException("没有登记的施法身体：" + species);
    var loading = LoadScene(species);
    while (loading.MoveNext()) yield return loading.Current;
    currentCase = (string)item["id"];
    Prepare(item);
    if (organScene) PrepareDemoOrgan(caster, effector, organ.Slot, organ.Rank);
    Place(caster, 60, 72);
    // 清场触发的原版倒塌和碎片先完成，避免它们混入待测招式。
    Config.paused = false;
    double settledAt = World.world.getCurWorldTime() + 1d;
    while (World.world.getCurWorldTime() < settledAt) yield return null;
    Config.paused = true;
    heldSwordDemo = definition.Body?.WeaponForm == "sword";
    ConstructedAbilityService.Register(definition);
    var owner = caster.GetExtend();
    ConstructedAbilityService.Learn(owner, definition.Id);
    if (definition.Resource == "vigor")
    {
        owner.E.RemoveComponent<Xian>();
        owner.AddComponent(new Knight { level = 2, vigor = 10000 });
    }

    if (definition.Body != null)
    {
        foreach (Actor actor in enemies) Place(actor, 12, 12);
        Actor original = enemies[0];
        var enemy = World.world.units.createNewUnit("human", World.world.GetTileSimple(67, 72),
            pAdultAge: true);
        enemy.setKingdom(original.kingdom);
        enemy.addTrait("super_health");
        CombatStatusEffects.ApplyStatus(enemy,
            Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.SpellDemo.Hold"), 10000, enemy);
        enemy.setStatsDirty();
        enemy.updateStats();
        enemies[0] = enemy;
        if (enemy.GetExtend().HasComponent<Magic>()) enemy.GetExtend().E.RemoveComponent<Magic>();
        enemy.setMana(0);
        enemy.setStatsDirty();
        enemy.updateStats();
        if (owner.HasComponent<Magic>()) owner.E.RemoveComponent<Magic>();
        if (definition.Body.WeaponForm is string form)
            caster.equipment.setItem(
                World.world.items.generateItem(DemoWeapon(form) ??
                    throw new InvalidOperationException("没有对应的实际演示兵器：" + form), pActor: caster), caster);
        else if (caster.hasWeapon()) caster.equipment.weapon.takeAwayItem();
        Place(caster, 66, 72);
        PositionBodyTarget();
    }

    var handles = new List<ActiveAbilityHandle>();
    ActiveAbilityService.Collect(owner, handles);
    var handle = handles.Single(value =>
        value.ProviderId == "content.constructed" && value.EntryId == definition.Id);
    if (externalView != null)
    {
        var entering = EnterView();
        while (entering.MoveNext()) yield return entering.Current;
        Place(caster, definition.Body == null ? 60 : 66, 72);
    }

    if (definition.Body != null)
    {
        foreach (Entity status in owner.GetStatuses().ToArray())
            if (status.GetComponent<StatusComponent>().Type.id == "Cultiway.SpellDemo.Hold")
                owner.RemoveSharedStatus(status);
        if ((organScene || jointScene) && externalView == null)
        {
            // 场地重载可能撤掉原附体状态。用原版附体阻止脚步干扰独立器官的原地出手。
            ControllableUnit.setControllableCreatureAndSelected(caster);
            typeof(ControllableUnit).GetMethod("addStatus", Flags).Invoke(null, new object[] { caster });
            caster.cancelAllBeh();
            caster.setPossessedMovement(false);
        }
        owner.MarkCultiwayStatsDirty();
        caster.setStatsDirty();
        caster.updateStats();
        caster.attack_timer = 0;
        caster.lookTowardsPosition(enemies[0].current_position);
        caster.flip_angle = caster.flip ? 180f : 0f;
        caster.current_rotation = new Vector3(0, caster.flip_angle, 0);
        caster.target_angle = caster.current_rotation;
        PositionBodyTarget();
        if (organScene && request["targetOffset"] == null)
            PositionOrganTarget(plan, caster, enemies[0]);
        Camera();
    }

    if (definition.Resource == "mana")
    {
        caster.stats["mana"] = 10000;
        caster.setMana(10000);
    }

    if (definition.Resource == "stamina")
    {
        caster.stats["stamina"] = 10000;
        caster.setStamina(10000);
    }

    bool selfTarget = plan.Use.Target == ActiveAbilityTargetMode.Self;
    var aimOffset = request["aimOffset"] as JArray;
    bool pointTarget = plan.Use.Target == ActiveAbilityTargetMode.Point ||
        plan.Use.Target == ActiveAbilityTargetMode.ObjectOrPoint && aimOffset != null;
    if (aimOffset != null && !pointTarget)
        throw new InvalidOperationException("这项构造不选地块，不能指定 --aim-offset");
    Actor target = selfTarget || plan.Impact.Targets == Cultiway.Core.SkillLibV3.Usage.SkillUseTargetRelation.Self ? caster :
        plan.Impact.Targets == Cultiway.Core.SkillLibV3.Usage.SkillUseTargetRelation.Friendly ? friend :
        enemies[0];
    if (target == friend) Place(friend, enemies[0].current_position.x, enemies[0].current_position.y);
    if (plan.ContactControl > 0f)
    {
        var movable = Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.SpellDemo.ForceTarget");
        if (movable == null)
        {
            var stats = new BaseStats();
            stats.addTag("frozen_ai");
            movable = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.ForceTarget")
                .SetStats(stats).SetDuration(10000).Build();
        }

        foreach (Actor actor in enemies.Concat(new[] { friend })
                     .Concat(target == caster ? new[] { caster } : Array.Empty<Actor>()))
        {
            CombatStatusEffects.RemoveStatus(actor,
                Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.SpellDemo.Hold"));
            CombatStatusEffects.ApplyStatus(actor, movable, 10000, actor);
            actor.GetExtend().MarkCultiwayStatsDirty();
            actor.setStatsDirty();
            actor.updateStats();
        }
    }

    if (!selfTarget && request["targetOffset"] is JArray offset)
        Place(target, caster.current_position.x + (float)offset[0],
            caster.current_position.y + (float)offset[1]);
    if (definition.Body != null && target == enemies[0])
    {
        // 进入三维观察时会解除附体，等镜头稳定后再建立正式敌对关系。
        caster.addAggro(target);
        target.addAggro(caster);
    }
    Vector2 casterStart = caster.current_position;
    Vector3 aim = target.GetSimPos();
    if (pointTarget)
    {
        var pointOffset = aimOffset ?? request["targetOffset"] as JArray;
        aim = pointOffset == null
            ? new Vector3(Mathf.Floor(casterStart.x + Mathf.Min(6f, (plan.TargetRange ?? 8f) * .75f)) + .5f,
                Mathf.Floor(casterStart.y) + .5f, 0f)
            : new Vector3(casterStart.x + (float)pointOffset[0], casterStart.y + (float)pointOffset[1], 0f);
        if (TileAt(aim) == null) throw new InvalidOperationException("瞄准地点不在测试地图内");
    }
    var selection = new ActiveAbilityTarget(pointTarget ? null : target, aim);
    float walk = (float?)request["casterWalk"] ?? 0f;
    if (walk != 0f)
    {
        CombatStatusEffects.RemoveStatus(caster,
            Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.SpellDemo.Hold"));
        owner.MarkCultiwayStatsDirty();
        caster.setStatsDirty();
        caster.updateStats();
    }

    if ((bool?)request["isolateTarget"] == true)
    {
        foreach (Actor other in enemies.Concat(new[] { friend }))
            if (other != target && other != caster)
                Place(other, 12, 12);
    }

    Vector2 targetStart = target.current_position;
    bool terrainFirstPerson = (string)request["view"] == "firstperson" &&
        ((float?)request["terrainSlope"] ?? 0f) != 0f;
    if (terrainFirstPerson)
    {
        if (!ControllableUnit.isControllingUnit(caster))
            throw new InvalidOperationException("坡面录像未实际附身到施法者");
        // 从实际施法位置朝向已经对位的目标。录制期间不接收桌面的鼠标转向。
        Vector2 direction = (Vector2)aim - casterStart;
        AimFirstPerson(Mathf.Atan2(direction.y, direction.x), -8f);
        var mouseLookOff = externalView.GetField("MouseLookOff", Flags);
        if (mouseLookOff != null)
        {
            previousTerrainMouseLookOff = (bool)mouseLookOff.GetValue(externalViewInstance);
            mouseLookOff.SetValue(externalViewInstance, true);
        }
    }

    AbilityDefinition opponent = request["opponentConstruction"]?.ToObject<AbilityDefinition>();
    bool opponentUsed = false;
    float opponentPaid = 0f;
    var rival = target.GetExtend();

    float OpponentBalance() => opponent.Resource switch
    {
        "none" => 0f, "wakan" => rival.GetCultisys<Xian>().wakan, "vigor" => rival.GetCultisys<Knight>().vigor,
        "mana" => target.getMana(), "stamina" => target.getStamina(),
        _ => throw new InvalidOperationException("未提供对手资源规则")
    };

    if (opponent != null)
    {
        if (target == caster || target == friend || opponent.Id == definition.Id)
            throw new InvalidOperationException("对手构造需要敌方目标及独立编号");
        ConstructedAbilityService.Register(opponent);
        if (opponent.Resource == "wakan")
        {
            if (!rival.HasCultisys<Xian>()) rival.AddComponent(new Xian { level = 2, wakan = 10000 });
            else rival.GetCultisys<Xian>().wakan = 10000;
        }

        if (opponent.Resource == "vigor")
        {
            rival.E.RemoveComponent<Xian>();
            if (!rival.HasCultisys<Knight>()) rival.AddComponent(new Knight { level = 2, vigor = 10000 });
            else rival.GetCultisys<Knight>().vigor = 10000;
        }

        if (opponent.Resource == "mana")
        {
            target.stats["mana"] = 10000;
            target.setMana(10000);
        }

        if (opponent.Resource == "stamina")
        {
            target.stats["stamina"] = 10000;
            target.setStamina(10000);
        }

        ConstructedAbilityService.Learn(rival, opponent.Id);
        float rivalBefore = OpponentBalance();
        // 对手也按自己的目标关系施放，自身供水及防护不强塞给敌人。
        Actor rivalTarget =
            AbilityCompiler.Compile(opponent).Impact.Targets ==
            Cultiway.Core.SkillLibV3.Usage.SkillUseTargetRelation.Hostile
                ? caster
                : target;
        opponentUsed = ActiveAbilityService.TryUse(rival,
            new ActiveAbilityHandle("content.constructed", rival.E, opponent.Id),
            new ActiveAbilityTarget(rivalTarget, rivalTarget.GetSimPos()), ActiveAbilityUseOrigin.Script);
        opponentPaid = rivalBefore - OpponentBalance();
        if (!opponentUsed) throw new InvalidOperationException("对手构造正式入口拒绝施放");
    }

    if (plan.HasRecovery)
    {
        if (definition.Resource == "wakan")
            owner.GetCultisys<Xian>().wakan = Mathf.Min(owner.GetCultisys<Xian>().wakan,
                caster.stats[Cultiway.Content.BaseStatses.MaxWakan.id] * .5f);
        if (definition.Resource == "vigor")
            owner.GetCultisys<Knight>().vigor = Mathf.Min(owner.GetCultisys<Knight>().vigor,
                caster.stats[Cultiway.Content.BaseStatses.MaxVigor.id] * .5f);
        if (definition.Resource == "mana") caster.setMana(caster.getMaxMana() / 2);
        if (definition.Resource == "stamina") caster.data.stamina = caster.getMaxStamina() / 2;
    }

    // 对照物只放在已经加载的测试世界。净土按真实地块确认，防火走原版点火入口。
    WorldTile cleanPlot = pointTarget && plan.Impact.WorldEffects.Any(effect => effect.Action.Id == "land.cleanse")
        ? TileAt(aim) : null;
    if (cleanPlot != null)
    {
        if (cleanPlot.hasBuilding() || cleanPlot.Type.road || cleanPlot.Type.liquid)
            throw new InvalidOperationException("请选择测试区内干燥且没有道路或建筑的净土地块");
        cleanPlot.setTileTypes(TileLibrary.soil_low, TopTileLibrary.wasteland_low);
        cleanPlot.setBurnedStage(12);
        World.world.burned_layer.setTileDirty(cleanPlot);
    }
    bool dirtyBefore = IsPolluted(cleanPlot);
    WorldTile firePlot = definition.WorldCondition == null ? null : definition.WorldCondition.EntireWorld
        ? World.world.GetTileSimple(MapBox.width - 8, 8)
        : TileAt(aim);
    if (firePlot != null)
    {
        if (firePlot.hasBuilding() || firePlot.Type.road)
            throw new InvalidOperationException("测试点火地块不得覆盖道路或建筑");
        if (firePlot != cleanPlot) firePlot.setTileTypes(TileLibrary.soil_low, TopTileLibrary.grass_low);
        firePlot.stopFire();
    }
    bool fireBefore = TryLight(firePlot);
    var selfStatus = plan.Use.SelfStatus?.Asset;
    bool selfStatusBefore = CombatStatusEffects.HasStatus(caster, selfStatus, caster);

    var viewState = ConfirmViewState();
    float health = Health(target), before = Balance();
    Vector3 bodyDirection = aim - caster.GetSimPos();
    bodyDirection.z = 0f;
    if (jointScene && BindDemoBody(plan, caster, target, bodyDirection.normalized) == null)
        throw new InvalidOperationException("实际身体缺少资料所需的关节或承接动作：" + species + " / " + effector);
    bool used = ActiveAbilityService.TryUse(owner, handle, selection, ActiveAbilityUseOrigin.Script);
    float afterPayment = Balance();
    float paid = before - afterPayment;
    if (!used)
        throw new InvalidOperationException("构造施放入口拒绝：" +
            ActiveAbilityService.ResolveControlState(owner, handle).BlockReason +
            $"，目标检查={ActiveAbilityService.CanUse(owner, handle, selection)}，脚下={caster.GetSimPos()}，瞄准={aim}");
    bool fireBlocked = firePlot != null && !TryLight(firePlot);
    bool selfStatusApplied = !selfStatusBefore && CombatStatusEffects.HasStatus(caster, selfStatus, caster);
    // 手动单招完成后不再让原版自动普攻混入录像，正式准入及动作本身已经正常执行。
    if (definition.Body != null || walk != 0f) caster.attack_timer = 999f;
    Vector2 walkDestination = casterStart + new Vector2(walk, 0f);
    var movePossessed = walk == 0f
        ? null
        : (Func<Actor, float, Vector2, float>)Delegate.CreateDelegate(
            typeof(Func<Actor, float, Vector2, float>),
            typeof(Actor).GetMethod("updatePossessedMovementTowards", Flags));
    long sourceId = caster.id, targetId = target.id;
    string folder = Path.Combine(output, (string)item["key"]);
    Directory.CreateDirectory(Path.Combine(folder, "frames"));
    var times = new List<double>();
    double start = World.world.getCurWorldTime(), next = 0, lastWalk = 0;
    double duration = Math.Max((double)request["duration"], definition.Lifetime + .4);
    int peak = 0;
    int organPoseFrames = 0, jointPoseFrames = 0;
    float jointTravel = 0f;
    float targetPeakHeight = 0f;
    var materialFrames = new List<object>();
    bool worldSurvivedCast = false;
    Config.paused = false;
    while (World.world.getCurWorldTime() - start < duration)
    {
        if (File.Exists(Path.Combine(Root, "cancel"))) throw new OperationCanceledException("已取消演示");
        double elapsed = World.world.getCurWorldTime() - start;
        if (movePossessed != null)
        {
            // 附体人物使用原版输入移动，先让形体成形；速度和阻挡仍由游戏计算。
            bool moving = elapsed > .35 && Vector2.Distance(caster.current_position, walkDestination) > .01f;
            caster.setPossessedMovement(moving);
            if (moving)
            {
                movePossessed(caster, (float)Math.Max(0, elapsed - Math.Max(.35, lastWalk)), walkDestination);
                caster.setCurrentTile(World.world.GetTileSimple((int)caster.current_position.x,
                    (int)caster.current_position.y));
                caster.updatePos();
            }

            lastWalk = elapsed;
        }

        Camera();
        Tooltip.hideTooltipNow();
        if (elapsed > definition.Lifetime + .1 && WorldMaterialService.Count > 0 &&
            FormVisualScene.Instances.Count > 0) worldSurvivedCast = true;
        peak = Math.Max(peak, FormVisualScene.Instances.Count);
        targetPeakHeight = Mathf.Max(targetPeakHeight, target.position_height);
        if (elapsed >= next)
        {
            if ((organScene || jointScene) && ConstructedAbilityService.TryGetBodyPose(sourceId, out var bodyPose))
            {
                if (organScene && bodyPose.Organ.HasValue) organPoseFrames++;
                if (jointScene && bodyPose.Joint != null)
                {
                    jointPoseFrames++;
                    jointTravel = Mathf.Max(jointTravel, Vector2.Distance(casterStart, (Vector2)bodyPose.Foot));
                }
            }
            times.Add(elapsed);
            new ScreenFacade().Capture(Path.Combine(folder, "frames",
                (times.Count - 1).ToString("00000") + ".png"));
            materialFrames.Add(new
            {
                time = elapsed, source = new[] { caster.current_position.x, caster.current_position.y }, forms =
                    FormVisualScene.Instances.Select(form => new
                    {
                        form = form.Resource.Description.Id, matter = form.Matter?.Id,
                        state = form.Matter?.State, surface = form.SurfaceFor(0),
                        position = new[] { form.Transform.m03, form.Transform.m13, form.Transform.m23 },
                        absoluteHeight = form.Terrain != null,
                        groundHeight = form.Terrain?.Sample(form.Transform.m03, form.Transform.m13) ?? 0f,
                        worldSources = form.Layer?.Sources, mixedWaterCells = form.Layer?.MixedCells,
                        volume = form.Layer?.Volume, recoveredVolume = form.Layer?.Recovered,
                        escaped = form.Layer?.Escaped, evaporated = form.Layer?.Evaporated,
                        flowCells = form.Layer?.Cells,
                        dye = form.Dye.HasValue
                            ? new[] { form.Dye.Value.r, form.Dye.Value.g, form.Dye.Value.b }
                            : null
                    }).ToArray()
            });
            next = elapsed + 1d / (int)request["fps"];
            Write(Path.Combine(output, "status.json"),
                new { done = false, current = item["key"], stage = "构造施放", elapsed, frames = times.Count });
        }

        yield return null;
    }

    caster.setPossessedMovement(false);
    Config.paused = true;
    yield return null;
    JObject[] scriptCasts = executionLog.Select(JObject.FromObject).Where(value =>
        (string)value["framework"] == "construction" && (string)value["id"] == definition.Id &&
        (long?)value["source"] == sourceId && (string)value["origin"] == "Script").ToArray();
    JObject[] targetContacts = scriptCasts.Length == 1
        ? contactsLog.Select(JObject.FromObject).Where(value =>
            (string)value["framework"] == "construction" &&
            (long?)value["cast"] == (long?)scriptCasts[0]["cast"] &&
            (long?)value["source"] == sourceId && (long?)value["target"] == targetId).ToArray()
        : Array.Empty<JObject>();
    int actualContacts = targetContacts.Length;
    long ownCast = scriptCasts.Length == 1 ? (long)scriptCasts[0]["cast"] : 0;
    var deliveredSignals = signals.Where(value => ownCast != 0 && value.CastId == ownCast &&
        value.SenderId == sourceId && value.RecipientId == targetId).ToArray();
    bool requiresDelivery = definition.Steps?.Any(step => step?.Operation?.Kind == ConstructionOperationKind.SendSignal) == true;
    JObject[] worldChanges = ownCast == 0 ? Array.Empty<JObject>() :
        worldContactsLog.Select(JObject.FromObject)
            .Where(value => (long)value["cast"] == ownCast && (string)value["id"] == definition.Id &&
                            (bool)value["changed"]).ToArray();
    bool cleanConfirmed = cleanPlot != null && dirtyBefore && !IsPolluted(cleanPlot) &&
        worldChanges.Count(change => (int)change["X"] == cleanPlot.pos.x && (int)change["Y"] == cleanPlot.pos.y &&
                                     (string)change["action"] == "land.cleanse") == 1;
    bool naturalEnd = ownCast > 0 &&
        constructionEndLog.Count(end => end.CastId == ownCast && !end.Cancelled) == 1;
    bool fireAfter = TryLight(firePlot);
    bool fireConditionVerified = firePlot != null && fireBefore && fireBlocked && naturalEnd && fireAfter;
    int actualClashes = scriptCasts.Length == 1
        ? clashesLog.Select(JObject.FromObject).Count(value =>
            (long?)value["leftCast"] == (long?)scriptCasts[0]["cast"] ||
            (long?)value["rightCast"] == (long?)scriptCasts[0]["cast"])
        : 0;
    double recoveredResource = scriptCasts.Length == 1
        ? recoveryLog.Select(JObject.FromObject).Where(value =>
                (long?)value["cast"] == (long?)scriptCasts[0]["cast"] && (long?)value["provider"] == sourceId)
            .Sum(value => (double)value["granted"])
        : 0;
    int opponentTransfers = opponent == null
        ? 0
        : worldMaterialsLog.Select(JObject.FromObject).Count(value =>
            (string)value["kind"] == "leave" && (string)value["ability"] == opponent.Id &&
            (long?)value["provider"] == targetId);
    int mixedWorldCells = materialFrames.Select(JObject.FromObject).SelectMany(value => (JArray)value["forms"])
        .Select(value => (int?)value["mixedWaterCells"] ?? 0).DefaultIfEmpty(0).Max();
    int transferredMaterials = scriptCasts.Length == 1
        ? worldMaterialsLog.Select(JObject.FromObject).Count(value =>
            (string)value["kind"] == "leave" && (long?)value["cast"] == (long?)scriptCasts[0]["cast"] &&
            (string)value["ability"] == definition.Id)
        : 0;
    int convertedMaterials = scriptCasts.Length == 1
        ? worldMaterialsLog.Select(JObject.FromObject).Count(value =>
            (string)value["kind"] == "matter" && (double?)value["convertedVolume"] > 0 &&
            (long?)value["cast"] == (long?)scriptCasts[0]["cast"] &&
            (string)value["ability"] == definition.Id &&
            (opponent == null || (long?)value["provider"] == targetId))
        : 0;
    int conductedHits = scriptCasts.Length == 1
        ? conductionLog.Select(JObject.FromObject).Where(v => (long?)v["cast"] == (long?)scriptCasts[0]["cast"])
            .Sum(v => ((JArray)v["targets"]).Count(t => (long)t == targetId))
        : 0;
    var targetResponses = conductionLog.Select(JObject.FromObject)
        .Where(v => scriptCasts.Length == 1 && (long?)v["cast"] == (long?)scriptCasts[0]["cast"])
        .SelectMany(v => (JArray)v["responses"]).Where(v => (long)v["target"] == targetId)
        .Concat(targetContacts).ToArray();
    bool acceptedBind = targetResponses.Any(v => (float?)v["bindSeconds"] > 0),
        acceptedStagger = targetResponses.Any(v => (float?)v["staggerSeconds"] > 0);
    bool movementVerified =
        (plan.ContactForce == 0f || Vector2.Distance(targetStart, target.current_position) > .05f ||
         acceptedBind) && (plan.ContactLaunch == 0f || targetPeakHeight > .01f || acceptedBind);
    bool controlVerified =
        plan.ContactStagger == 0f && plan.ContactBind == 0f || acceptedBind || acceptedStagger;
    long[] opponentCasts = opponent == null
        ? Array.Empty<long>()
        : executionLog.Select(JObject.FromObject)
            .Where(v => (string)v["id"] == opponent.Id && (long?)v["source"] == targetId &&
                        (string)v["origin"] == "Script").Select(v => (long)v["cast"]).ToArray();
    int activeWaterSources = scriptCasts.Length == 1
        ? conductionLog.Select(JObject.FromObject).Where(v => (long?)v["cast"] == (long?)scriptCasts[0]["cast"])
            .SelectMany(v => (JArray)v["waterCasts"]).Select(v => (long)v).Distinct()
            .Count(id => opponentCasts.Contains(id))
        : 0;
    JObject[] ownQuenching = scriptCasts.Length == 1
        ? quenchingLog.Select(JObject.FromObject)
            .Where(v => (long?)v["fireCast"] == (long?)scriptCasts[0]["cast"]).ToArray()
        : Array.Empty<JObject>();
    double quenchedVolume = ownQuenching.Sum(v => (double)v["evaporated"]);
    int quenchedWaterSources = ownQuenching.Select(v => (long)v["waterCast"]).Distinct()
        .Count(id => opponentCasts.Contains(id));
    bool extinguished = ownQuenching.Length > 0 && (float)ownQuenching.Last()["remaining"] == 0f;
    JObject[] ownHeating = scriptCasts.Length == 1
        ? burningLog.Select(JObject.FromObject).Where(v =>
            (string)v["kind"] == "heat" && (double)v["transferred"] > 0 &&
            (long?)v["sourceCast"] == (long?)scriptCasts[0]["cast"]).ToArray()
        : Array.Empty<JObject>();
    long[] heatedCasts = ownHeating.Select(v => (long)v["cast"]).Where(id => id > 0).Distinct().ToArray();
    long[] heatedWorld = ownHeating.Select(v => (long)v["world"]).Where(id => id > 0).Distinct().ToArray();
    int heatedWoodSources = heatedCasts.Count(id => opponentCasts.Contains(id));
    double burnedVolume = burningLog.Select(JObject.FromObject)
        .Where(v => (string)v["kind"] == "burn" && (long?)v["source"] == sourceId &&
                    (heatedCasts.Contains((long)v["cast"]) || heatedWorld.Contains((long)v["world"])))
        .Sum(v => (double)v["transferred"]);
    var queuedDamage = queuedDamageLog.Select(JObject.FromObject).Where(value => ownCast != 0 &&
        (long)value["cast"] == ownCast && (long)value["source"] == sourceId && (long)value["target"] == targetId).ToArray();
    int lost = targetResponses.Sum(value => (int?)value["lost"] ?? 0) + queuedDamage.Sum(value => (int)value["lost"]);
    double shieldAbsorbed = targetResponses.Sum(value => (double?)value["shieldAbsorbed"] ?? 0) +
        queuedDamage.Sum(value => (double)value["shieldAbsorbed"]);
    bool executed = used && ownCast != 0;
    bool extentConfirmed = deliveredSignals.Length > 0 || actualContacts > 0 || worldChanges.Length > 0 ||
        fireConditionVerified || selfStatusApplied ||
        conductedHits > 0 || convertedMaterials > 0 || quenchedVolume > 0 || ownHeating.Length > 0 ||
        transferredMaterials > 0 && worldSurvivedCast || plan.HasRecovery && recoveredResource > 0 && recoveredResource <= paid + .0001;
    bool opponentConfirmed = opponent == null || opponentUsed && opponentPaid == opponent.Cost &&
        (actualClashes > 0 || activeWaterSources > 0 || quenchedWaterSources > 0 || heatedWoodSources > 0 ||
         opponentTransfers == 1 && (mixedWorldCells > 0 || convertedMaterials > 0 ||
                                    conductedHits > 0 || quenchedVolume > 0 || heatedWorld.Length > 0));
    bool effectConfirmed = extentConfirmed && opponentConfirmed && (!requiresDelivery || deliveredSignals.Length > 0) &&
        (cleanPlot == null || cleanConfirmed) && (definition.WorldCondition == null || fireConditionVerified) &&
        (selfStatus == null || selfStatusApplied) &&
        ((extinguished || ownHeating.Length > 0) && actualContacts == 0 ? Health(target) == health :
            plan.ContactDamageScale > 0f ? lost > 0 :
            Health(target) == health && movementVerified && controlVerified);
    bool presentationReady = (organScene || jointScene
        ? organPoseFrames + jointPoseFrames > 0 && naturalEnd && !BodyControlState.IsBusy(sourceId)
        : peak > 0) && (walk == 0f || Vector2.Distance(casterStart, caster.current_position) > .25f);
    string validationError = !executed ? "未确认一次正式施放" :
        requiresDelivery && deliveredSignals.Length == 0 ? "已实际出手，未确认向所选对象送达" :
        !effectConfirmed ? "已实际出手，未确认本段要求的作用" :
        paid != definition.Cost ? "实扣与构造费用不符" :
        !presentationReady ? "实际作用成立，录制未满足形体或动作要求" : null;
    WriteResult(Path.Combine(folder, "result.json"), new
    {
        passed = executed && effectConfirmed && paid == definition.Cost && presentationReady && errors.Count == 0,
        error = validationError,
        execution = new { accepted = used, started = scriptCasts.Length > 0, starts = scriptCasts.Length,
            cast = ownCast, source = sourceId, naturalEnd,
            payment = new { resource = definition.Resource, paid, before, afterPayment } },
        effect = new { confirmed = executed ? (bool?)effectConfirmed : null, target = pointTarget ? (long?)null : targetId,
            contacts = actualContacts, lost, shieldAbsorbed, changedTiles = worldChanges.Length,
            signalsDelivered = deliveredSignals.Length, recovery = recoveredResource, selfStatusApplied,
            acceptedBind, acceptedStagger },
        deliveredSignals = deliveredSignals.Select(SignalFact).ToArray(),
        isolatedTarget = (bool?)request["isolateTarget"] ?? false,
        heatedWoodSources, heatedCasts, heatedWorld, burnedVolume, burningLog,
        quenchedVolume, quenchedWaterSources, extinguished, quenchingLog,
        opponent, opponentUsed, opponentPaid, opponentCasts, activeWaterSources, actualClashes, clashesLog,
        opponentTransfers, mixedWorldCells, convertedMaterials, conductedHits, conductionLog,
        scene = "construction",
        validation =
            "正式入口、支付、主体及实际结果；有伤害时检查扣血，纯推拉检查位移、独立腾起检查离地，停顿与束缚检查实际受理，束缚成立可阻止同次推力；纯回收检查同次施放向原支付者实际入账且不超支付，留置检查同次正式施放完成转交且原施放结束后材料仍在，世界转换检查同次施放实际转入正体积，导电检查同次传播确实到达目标并按伤害规则扣血，水火检查同次接触真实减水和火势余量，灭火后不冒充人物命中，点木检查同次火术真实传入热量和后续有限烧损；美术与完整交互另行验收",
        item, definition, used, paid, resource = definition.Resource, before, after = Balance(),
        targetMode = pointTarget ? "Point" : selfTarget ? "Self" : "Object", selectedActor = pointTarget ? (long?)null : targetId,
        aimPosition = new[] { aim.x, aim.y, aim.z }, worldChanges, naturalEnd,
        landWitness = cleanPlot == null ? null : new { cleanPlot.pos.x, cleanPlot.pos.y, dirtyBefore, cleanConfirmed },
        fireWitness = firePlot == null ? null : new { firePlot.pos.x, firePlot.pos.y, fireBefore, fireBlocked,
            fireAfter, fireConditionVerified }, selfStatusApplied,
        targetBefore = health, targetAfter = Health(target),
        targetMoved = Vector2.Distance(targetStart, target.current_position), targetPeakHeight, acceptedBind,
        acceptedStagger, movementVerified, controlVerified,
        targetStart = new[] { targetStart.x, targetStart.y },
        targetEnd = new[] { target.current_position.x, target.current_position.y }, peakForms = peak,
        casterWalk = walk, walked = Vector2.Distance(casterStart, caster.current_position),
        times, frames = times.Count, duration, view = (string)request["view"], viewState,
        finalViewState = ConfirmViewState(),
        lighting = (string)request["lighting"] ?? "day", lightingState = LightingState(),
        scriptCasts = scriptCasts.Length, actualContacts, recoveredResource, recoveryLog, transferredMaterials,
        organ = organScene ? new { species = caster.asset.id, part = effector, rank = organ.Rank,
            poseFrames = organPoseFrames, released = !BodyControlState.IsBusy(sourceId) } : null,
        joint = jointScene ? new { species = caster.asset.id, part = effector, poseFrames = jointPoseFrames,
            travel = jointTravel, released = !BodyControlState.IsBusy(sourceId) } : null,
        worldSurvivedCast, worldMaterialsLog, executionLog, committedPayments, contactsLog,
        queuedDamageLog, materialFrames, errors
    });

    float Balance() => definition.Resource switch
    {
        "none" => 0f,
        "wakan" => owner.GetCultisys<Xian>().wakan,
        "vigor" => owner.GetCultisys<Knight>().vigor,
        "mana" => caster.getMana(),
        "stamina" => caster.getStamina(),
        _ => throw new InvalidOperationException("未知演示资源：" + definition.Resource)
    };

    WorldTile TileAt(Vector3 position)
    {
        int x = Mathf.FloorToInt(position.x), y = Mathf.FloorToInt(position.y);
        return x >= 0 && x < MapBox.width && y >= 0 && y < MapBox.height ? World.world.GetTileSimple(x, y) : null;
    }

    bool IsPolluted(WorldTile tile) =>
        tile != null && (tile.top_type?.wasteland == true || tile.burned_stages > 0);

    bool TryLight(WorldTile tile)
    {
        if (tile == null) return false;
        bool lit = tile.startFire(pForce: true) && tile.isOnFire();
        tile.stopFire();
        return lit;
    }

    void PositionBodyTarget()
    {
        float height = (float)typeof(Cultiway.ModClass).Assembly
            .GetType("Cultiway.Content.Combat.SpatialActorPose", true)
            .GetMethod("Height", Flags).Invoke(null, new object[] { caster });
        enemies[0].stopMovement();
        enemies[0].current_position =
            new Vector2(66 + height * (definition.Body.WeaponForm == null ? .65f : 1.35f), 72);
        if (definition.Root?.Operations?.Any(op => op.Kind == ConstructionOperationKind.Fly) == true)
            enemies[0].current_position = new Vector2(74, 72);
        enemies[0].setCurrentTile(
            World.world.GetTileSimple(Mathf.FloorToInt(enemies[0].current_position.x), 72));
        enemies[0].updatePos();
    }
}

/// <summary>用真身姿态确定站立对手的起点，实际接触和结算仍由正式施放产生。</summary>
private static void PositionOrganTarget(CompiledAbility plan, Actor source, Actor target)
{
    var heightMethod = typeof(ConstructedAbilityService).Assembly
        .GetType("Cultiway.Content.Combat.SpatialActorPose", true).GetMethod("Height", Flags);
    float height = (float)heightMethod.Invoke(null, new object[] { target });
    Vector3 aim = target.GetSimPos();
    object binding = BindDemoBody(plan, source, target, Vector3.right);
    if (binding == null) throw new InvalidOperationException("真身缺少资料要求的器官或支撑");
    Type bindingType = binding.GetType();
    var frame = (BodyFrame)bindingType.GetMethod("Frame", Flags, null, new[] { typeof(Actor) }, null)
        .Invoke(binding, new object[] { source });
    var cast = new AbilityCast(plan, Matrix4x4.identity, frame);
    var append = bindingType.GetMethod("AppendContacts", Flags);
    var shapes = new List<AbilityCapsule>();
    var points = new List<Vector3>();
    float age = 0f;
    for (int i = 0; i <= 8; i++)
    {
        float time = Mathf.Lerp(plan.Body.ActiveFrom, plan.Body.ActiveUntil, i / 8f);
        cast.Advance(time - age, aim);
        age = time;
        shapes.Clear();
        append.Invoke(binding, new object[] { cast.BodyPose.Value, shapes });
        points.AddRange(shapes.Select(shape => (shape.A + shape.B) * .5f)
            .Where(point => point.x > frame.Foot.x && point.z >= frame.Foot.z && point.z <= frame.Foot.z + height &&
                Vector2.Distance(point, frame.Foot) <= plan.TargetRange.GetValueOrDefault(8f)));
    }
    if (points.Count == 0) throw new InvalidOperationException("真身作用面内没有合适的站立对练位置");
    Vector3 position = points.OrderBy(point => Mathf.Abs(point.y - frame.Foot.y))
        .ThenByDescending(point => point.x).First();
    Place(target, position.x, position.y);
}

/// <summary>用正式身体绑定核对实际关节和所需支撑。</summary>
private static object BindDemoBody(CompiledAbility plan, Actor source, Actor target, Vector3 direction)
{
    var assembly = typeof(ConstructedAbilityService).Assembly;
    var bindingType = assembly.GetType("Cultiway.Content.Skills.BodyActionBinding", true);
    var heightMethod = assembly.GetType("Cultiway.Content.Combat.SpatialActorPose", true).GetMethod("Height", Flags);
    if (direction.sqrMagnitude < .00001f) direction = Vector3.right;
    return bindingType.GetMethod("TryCreate", Flags).Invoke(null, new[] {
        (object)source, plan.Body, direction, target.GetSimPos(), heightMethod.Invoke(null, new object[] { target })
    });
}

/// <summary>读取独立测试世界，然后依次准备、释放和录制每一招。</summary>
private IEnumerator Run()
{
    int index = 0;
    bool legacyScene = false;
    bool continueOnFailure = (bool?)request["continueOnFailure"] == true;
    foreach (JObject item in (JArray)request["cases"])
    {
        if (File.Exists(Path.Combine(Root, "cancel"))) throw new OperationCanceledException("已取消演示");
        errors.Clear();
        currentCase = (string)item["id"];
        string folder = Path.Combine(output, (string)item["key"]);
        Directory.CreateDirectory(folder);
        Directory.CreateDirectory(Path.Combine(folder, "frames"));
        Write(Path.Combine(output, "status.json"),
            new { done = false, index = ++index, current = item["key"], stage = "准备" });
        var recording = RecordCase(item, folder, legacyScene);
        string result = Path.Combine(folder, "result.json");
        while (true)
        {
            bool more;
            try
            {
                more = recording.MoveNext();
            }
            catch (Exception error) when (continueOnFailure && error is not OperationCanceledException)
            {
                WriteResult(result, new { passed = false, item, error = error.ToString(), errors });
                break;
            }

            if (!more) break;
            yield return recording.Current;
        }

        ReleaseBodyCloseCamera();
        heldSwordDemo = false;
        RestoreTerrainFirstPersonLook();
        legacyScene = item["construction"] is not JObject;
        JObject recorded = continueOnFailure ? JObject.Parse(File.ReadAllText(result)) : null;
        if (recorded != null && (bool?)recorded["passed"] != true && (bool?)recorded["skipped"] != true)
        {
            // 失败点可能已经开始施放。先恢复夹具，再允许后续录像。
            Config.paused = true;
            CleanExecutions();
            var restoring = LoadFixture();
            while (restoring.MoveNext()) yield return restoring.Current;
            legacyScene = false;
        }
    }

    if (!legacyScene) yield break;
    CleanExecutions();
    Config.paused = false;
    double ending = World.world.getCurWorldTime() + 1.5;
    while (World.world.getCurWorldTime() < ending) yield return null;
    Config.paused = true;
    CleanExecutions();
}

private IEnumerator RecordCase(JObject item, string folder, bool legacyScene)
{
    if (item["construction"] is JObject definition)
    {
        string mode = (string)item["mode"] ?? "base";
        if (mode != "base")
        {
            Write(Path.Combine(folder, "source-definition.json"), definition);
            string reason = null;
            try
            {
                definition = ConstructionDefinitionLayers.Snapshot(
                    DemoVariant(definition.ToObject<AbilityDefinition>(), mode, request["editOptions"]));
            }
            catch (Exception error) when (error is InvalidDataException or ArgumentException)
            {
                reason = error.Message;
            }

            if (reason != null)
            {
                WriteResult(Path.Combine(folder, "result.json"), new { passed = false, skipped = true, reason, item });
                yield break;
            }
            item = (JObject)item.DeepClone();
            item["construction"] = definition;
        }
        Write(Path.Combine(folder, "definition.json"), definition);
        var recording = RecordConstruction(item);
        while (recording.MoveNext()) yield return recording.Current;
        yield break;
    }

    if (!legacyScene)
    {
        var load = LoadScene();
        while (load.MoveNext()) yield return load.Current;
    }
    Prepare(item);
    // 法宝需要等待附加状态建立；掌击不提前推进，避免准备阶段先消耗近战冷却。
    if ((string)item["id"] != "Cultiway.PalmStrike")
    {
        Config.paused = false;
        for (int frame = 0; frame < 4; frame++) yield return null;
        Config.paused = true;
    }

    if (externalView != null && (WantsBodyCloseView() ||
        !(bool)externalView.GetProperty("GodShown", Flags).GetValue(externalViewInstance)))
    {
        var enter = EnterView();
        while (enter.MoveNext()) yield return enter.Current;
    }

    var record = (string)request["scene"] == "battle" ? RecordBattle(item, folder) : Record(item, folder);
    while (record.MoveNext()) yield return record.Current;
}

/// <summary>在独立草稿上依次完成所选改造，再用与万法阁相同的校验判断能否实际施放。</summary>
/// <param name="definition">完整原式。</param>
/// <param name="mode">本段选择的改造。</param>
/// <param name="options">实际形体或材料编号。</param>
private static AbilityDefinition DemoVariant(AbilityDefinition definition, string mode, JToken options)
{
    var result = mode is "modifiers" or "combined"
        ? ConstructionMagnitudeEdits.Resize(definition, 1.6f, reprice: false)
        : ConstructionEditing.Copy(definition);
    if (mode is "trajectory" or "combined")
    {
        var flights = result.Root?.Operations?.Where(operation => operation.Kind == ConstructionOperationKind.Fly).ToArray();
        if (flights?.Length != 1) throw new InvalidDataException("波形轨迹需要根部恰好一个实际飞行操作");
        var flight = flights[0];
        if (flight.Goal?.DirectArrival == true)
            throw new InvalidDataException("原飞行声明直达，保留直达时无法增加波形路径");
        Vector3 direction = new Vector3(flight.Vector[0], flight.Vector[1], flight.Vector[2]).normalized;
        Vector3 side = flight.Path?.Space == ConstructionPathSpace.TargetLine ? Vector3.up :
            direction == Vector3.zero ? Vector3.right :
            Vector3.Cross(direction, Mathf.Abs(Vector3.Dot(direction, Vector3.up)) > .9f ? Vector3.right : Vector3.up).normalized;
        var wave = ConstructionPathCurves.Wave(1f, side * .4f);
        if (flight.Path == null)
        {
            wave.Forward = direction == Vector3.zero ? null : new[] { direction.x, direction.y, direction.z };
            flight.Path = wave;
        }
        else
            flight.Path.Additions = (flight.Path.Additions ?? Array.Empty<ConstructionPathTerm>())
                .Append(new ConstructionPathTerm { Keys = wave.Keys, Loop = wave.Loop }).ToArray();
    }
    if (mode == "cross-form")
    {
        string form = (string)options["form"];
        RequireDemoContact(form);
        if (result.Root == null)
            result = BodyConstructionEdits.Project(result, new BodyProjection
                { Form = form, Resource = result.Resource, Cost = result.Cost });
        else
        {
            if (result.Root.Form == form) throw new InvalidDataException("跨形态需要选择与原主体不同的形体");
            result.Root.Form = form;
        }
    }
    if (mode == "material")
    {
        var node = result.Root ?? throw new InvalidDataException("换材需要实际生成主体");
        string choice = (string)options["matter"];
        var parts = choice.Split(new[] { ':' }, 2);
        var matter = AbilityMatters.Resolve(parts[0], parts.Length == 2 ? parts[1] : null, "换材");
        if (AbilityMatters.Resolve(node.Matter, node.State, "原材料") == matter)
            throw new InvalidDataException("换材需要不同的实际材料或物态：" + choice);
        node.Matter = matter.Id;
        node.State = matter.State;
        node.FollowMatter = true;
    }
    if (mode == "structure")
    {
        var node = result.Root ?? throw new InvalidDataException("增加子部位需要实际主体");
        string form = (string)options["child"] ?? node.Form;
        RequireDemoContact(form);
        int suffix = 1;
        while (node.Children.Any(child => child.Id == "demo_part_" + suffix)) suffix++;
        node.Children = node.Children.Append(new ConstructionNode
        {
            Id = "demo_part_" + suffix, Form = form, Matter = node.Matter, State = node.State,
            FollowMatter = node.FollowMatter, Scale = .55f, Offset = new[] { .9f, 0f, 0f },
            ActiveFrom = node.ActiveFrom, ActiveUntil = node.ActiveUntil, ContactRole = node.ContactRole,
            ContactGroup = node.ContactGroup ?? "root", Contact = node.Contact, Impact = node.Impact
        }).ToArray();
    }
    ConstructionEditing.Access.Validate(result);
    return result;
}

/// <summary>采用与实际形体选择相同的要求，明确说明无法参与命中的资源。</summary>
/// <param name="form">用户选中的实际形体。</param>
private static void RequireDemoContact(string form)
{
    if (!FormResources.Ids.Contains(form) || FormResources.Load(form).Contacts.Length == 0)
        throw new InvalidDataException("形体缺少实际接触形状：" + form);
}

/// <summary>仅加载仓库中的测试夹具，不保存或覆盖玩家世界。</summary>
private IEnumerator LoadFixture()
{
    if (SmoothLoader.isLoading()) throw new InvalidOperationException("游戏仍在加载，请稍后运行");
    Config.paused = true;
    Time.timeScale = 1;
    ControllableUnit.clear(false);
    // 已载入 Worldfall 时先恢复普通视角，避免录像标签与实际镜头不符。
    var external = AppDomain.CurrentDomain.GetAssemblies()
        .Select(assembly => assembly.GetType("FirstPerson.WorldBoxMod", false))
        .FirstOrDefault(type => type != null);
    if (external != null)
    {
        object view = external.GetProperty("Instance", Flags).GetValue(null);
        external.GetMethod("SetGodView", Flags).Invoke(view, new object[] { false });
        external.GetMethod("ViewForTest", Flags).Invoke(view, new object[] { false });
    }

    string fixture = (string)request["fixture"];
    if (fixture == null || !File.Exists(Path.Combine(fixture, "map.wbox")))
        throw new InvalidOperationException("缺少演示测试存档：" + fixture);
    World.world.save_manager.loadWorld(fixture);
    yield return null;
    while (SmoothLoader.isLoading()) yield return null;
    Config.paused = true;
    World.world.console.Hide();
}

/// <summary>复用夹具后只准备当前段的演示人物与观察条件。</summary>
private IEnumerator LoadScene(string species = "human")
{
    var loading = LoadFixture();
    while (loading.MoveNext()) yield return loading.Current;
    enemies.Clear();
    isolated.Clear();
    bool battle = (string)request["scene"] == "battle";
    if (battle && (int?)request["battleSeed"] is int seed) Randy.resetSeed(seed);
    var external = AppDomain.CurrentDomain.GetAssemblies()
        .Select(assembly => assembly.GetType("FirstPerson.WorldBoxMod", false))
        .FirstOrDefault(type => type != null);

    float slope = (float?)request["terrainSlope"] ?? 0f;
    if (slope != 0f)
        for (int y = 60; y <= 84; y++)
        for (int x = 54; x <= 90; x++)
            World.world.GetTileSimple(x, y).Height =
                Mathf.Clamp(Mathf.RoundToInt(100f + slope * (x - 60)), 0, 255);
    foreach (var screen in Resources.FindObjectsOfTypeAll<LoadingScreen>()) screen.gameObject.SetActive(false);
    foreach (Actor actor in World.world.units.getSimpleList().ToArray()) Place(actor, 12, 12);
    caster = World.world.units.createNewUnit(species, World.world.GetTileSimple(53, 72), pAdultAge: true);
    caster.data.name = "法术演示·施法者";
    var owner = caster.GetExtend();
    owner.AddComponent(new Xian { level = (int?)request["realm"] ?? 2, wakan = 10000 });
    owner.AddComponent(new Magic { level = 3 });
    owner.SetPowerLevel((float)request["power"]);
    owner.MarkCultiwayStatsDirty();
    friend = World.world.units.createNewUnit("human", World.world.GetTileSimple(70, 72), pAdultAge: true);
    friend.data.name = "法术演示·友军";
    friend.setKingdom(caster.kingdom);
    for (int index = 0; index < 7; index++)
    {
        Actor enemy = World.world.units.createNewUnit("wolf",
            World.world.GetTileSimple(70 + index % 3 * 4, 68 + index / 3 * 4), pAdultAge: true);
        enemy.data.name = "法术演示·敌军";
        enemies.Add(enemy);
    }

    foreach (var actor in new[] { caster, friend }.Concat(enemies)) actor.addTrait("super_health");
    // 控制施法者避免自主追加其他法术；不修改全局战斗设置。
    if (!battle) ControllableUnit.setControllableCreatureAndSelected(caster);
    if (external != null)
    {
        object view = external.GetProperty("Instance", Flags).GetValue(null);
        external.GetMethod("SetGodView", Flags).Invoke(view, new object[] { false });
        external.GetMethod("ViewForTest", Flags).Invoke(view, new object[] { false });
        bool ready = false;
        for (int frame = 0; frame < 300; frame++)
        {
            ready = !(bool)external.GetProperty("IsFirstPerson", Flags).GetValue(view) &&
                    !(bool)external.GetProperty("GodShown", Flags).GetValue(view) &&
                    (bool)external.GetProperty("DiveDone", Flags).GetValue(view);
            if (ready) break;
            yield return null;
        }

        if (!ready) throw new InvalidOperationException("Worldfall 尚未恢复普通观察视角");
    }

    Config.ui_main_hidden = true;
    foreach (var canvas in Resources.FindObjectsOfTypeAll<Canvas>())
    {
        if (!canvases.ContainsKey(canvas)) canvases[canvas] = canvas.enabled;
        canvas.enabled = false;
    }

    PossessionUI.instance.gameObject.SetActive(false);
    Config.setWorldSpeed("x" + ((int?)request["speed"] ?? 1), false);
    if ((string)request["view"] is "worldfall" or "firstperson")
    {
        if (external == null) throw new InvalidOperationException("Worldfall 未加载，不能录为三维演示");
        externalView = external;
        externalViewInstance = external.GetProperty("Instance", Flags).GetValue(null);
    }

    yield return null;
}

/// <summary>记录实际外部昼夜设置及最后绘制的光色，避免只靠录像标签判断受光。</summary>
private object LightingState()
{
    if (externalView == null) return new { mode = -1 };
    object settings = externalView.GetField("Settings", Flags).GetValue(externalViewInstance);
    Vector4 direct = Shader.GetGlobalVector("_FP_LightCol"), ambient = Shader.GetGlobalVector("_FP_AmbCol");
    return new
    {
        mode = (int)settings.GetType().GetField("TimeMode", Flags).GetValue(settings),
        direct = new[] { direct.x, direct.y, direct.z }, ambient = new[] { ambient.x, ambient.y, ambient.z }
    };
}

/// <summary>场地准备完成后再进入三维，避免外部模组提前缓存旧地形。</summary>
private IEnumerator EnterView()
{
    // 原版在运行帧处理建筑移除队列；先结清，再让三维端重建地形及对象缓存。
    Config.paused = false;
    for (int frame = 0; frame < 3; frame++) yield return null;
    Config.paused = true;
    object lighting = externalView.GetField("Settings", Flags).GetValue(externalViewInstance);
    lighting.GetType().GetField("TimeMode", Flags)
        .SetValue(lighting, (string)request["lighting"] == "night" ? 3 : 1);
    object sampler = externalView.GetField("_sampler", Flags).GetValue(externalViewInstance);
    sampler.GetType().GetMethod("Invalidate", Flags).Invoke(sampler, null);
    sampler.GetType().GetMethod("EnsureWorld", Flags).Invoke(sampler, null);
    object scene = externalView.GetProperty("SceneForTest", Flags).GetValue(externalViewInstance);
    scene.GetType().GetMethod("Reset", Flags).Invoke(scene, null);
    if ((string)request["view"] == "firstperson")
    {
        externalView.GetMethod("SetGodView", Flags).Invoke(externalViewInstance, new object[] { false });
        externalView.GetMethod("ViewForTest", Flags).Invoke(externalViewInstance, new object[] { true });
        ControllableUnit.setControllableCreatureAndSelected(caster);
        bool entered = false;
        for (int frame = 0; frame < 300; frame++)
        {
            entered = (bool)externalView.GetProperty("IsFirstPerson", Flags).GetValue(externalViewInstance) &&
                      (bool)externalView.GetProperty("DiveDone", Flags).GetValue(externalViewInstance);
            if (entered) break;
            yield return null;
        }

        if (!entered) throw new InvalidOperationException("实际附身第一人称镜头未就绪");
        float yaw = 0f, pitch = 0f;
        if (currentCase == "Cultiway.PalmStrike")
        {
            // 正对近身目标只看见胸口，向出掌侧稍转并低头，保留掌面和目标边缘。
            yaw = -.34f;
            pitch = -43f;
        }
        else if (heldSwordDemo)
        {
            // 低头偏向持剑手，让柄和刃同时入画。
            Vector2 direction = enemies[0].current_position - caster.current_position;
            yaw = Mathf.Atan2(direction.y, direction.x) - .22f;
            pitch = -40f;
        }
        else if (currentCase is "Cultiway.FlyingSword" or "Cultiway.GroundSpike")
        {
            Vector2 direction = enemies[0].current_position - caster.current_position;
            yaw = Mathf.Atan2(direction.y, direction.x);
            pitch = -4f;
        }
        AimFirstPerson(yaw, pitch);
        for (int frame = 0; frame < 4; frame++) yield return null;
        yield break;
    }

    externalView.GetMethod("SetGodView", Flags).Invoke(externalViewInstance, new object[] { true });
    externalView.GetMethod("ViewForTest", Flags).Invoke(externalViewInstance, new object[] { false });
    ControllableUnit.clear(false);
    bool ready = false;
    for (int frame = 0; frame < 300; frame++)
    {
        ready = (bool)externalView.GetProperty("GodShown", Flags).GetValue(externalViewInstance) &&
                (float)externalView.GetProperty("GodAlpha", Flags).GetValue(externalViewInstance) >= .99f;
        if (ready) break;
        yield return null;
    }

    if (!ready) throw new InvalidOperationException("三维镜头未就绪");
    if (request["construction"] is JObject && request["construction"]["Body"] is not JObject)
    {
        // 使用外部模组自身的倾斜观察，避免俯视时看不出浪唇、腹部等真实厚度。
        externalView.GetField("_godTip", Flags).SetValue(externalViewInstance, .55f);
        externalView.GetField("_godTipRate", Flags).SetValue(externalViewInstance, 0f);
    }

    if (WantsBodyCloseView())
    {
        // 沿用已经验证的相机锁人路径，不等待普通地图相机追上三维相机。
        void Set(string field, object value) => externalView.GetField(field, Flags).SetValue(externalViewInstance, value);
        Set("_godLock", caster);
        Set("_godFollow", caster.current_position);
        Set("_godFollowVel", Vector2.zero);
        Set("_godClose", (float)request["zoom"]);
        Set("_godCloseTarget", (float)request["zoom"]);
        Set("_godPull", 1f);
        Set("_godTurn", -.25f);
        Set("_godTurnRate", 0f);
        Set("_godTip", .2f);
        Set("_godTipRate", 0f);
        object cache = sampler.GetType().GetField("Cache", Flags).GetValue(sampler);
        var sample = cache.GetType().GetMethod("SampleHeight", new[] { typeof(float), typeof(float) });
        Vector2 point = caster.current_position;
        float z = (float)sample.Invoke(cache, new object[] { point.x, point.y });
        Vector4 focus = new Vector4(point.x, point.y, z + .4f, 1f);
        Vector2 screen = Vector2.zero;
        float span = 0f;
        for (int frame = 0; frame < 180; frame++)
        {
            // 实际投影中能看到施法者，并且一格明显占画面宽度，才是确实拉近。
            Matrix4x4 projection = Shader.GetGlobalMatrix("_FP_VP");
            Vector4 centre = projection * focus;
            Vector4 step = projection * (focus + new Vector4(1f, 0f, 0f, 0f));
            if (centre.w > 0f && step.w > 0f)
            {
                screen = new Vector2(centre.x, centre.y) / centre.w;
                span = Vector2.Distance(screen, new Vector2(step.x, step.y) / step.w);
                if (frame >= 8 && Mathf.Abs(screen.x) < .8f && Mathf.Abs(screen.y) < .8f && span > .16f)
                    yield break;
            }
            yield return null;
        }
        throw new InvalidOperationException($"三维近身镜头没有实际绘制到施法者：画面位置{screen}，一格跨度{span:F2}");
    }

    if ((float?)request["zoom"] < 10f && request["construction"]?["Body"] is JObject)
    {
        // 使用Worldfall本身的贴近人物观察，避免把原版近景冒充三维近景。
        Place(caster, 66, 72);
        typeof(Cultiway.ModClass).Assembly.GetType("Cultiway.Core.Performance.PresentationInterpolator", true)
            .GetMethod("Reset", Flags).Invoke(null, null);
        scene.GetType().GetMethod("Reset", Flags).Invoke(scene, null);
        Vector3 mapCamera = World.world.camera.transform.position;
        World.world.camera.transform.position =
            new Vector3(caster.current_position.x, caster.current_position.y, mapCamera.z);
        externalView.GetMethod("GodFollowAfterDive", Flags)
            .Invoke(externalViewInstance, new object[] { caster });
        externalView.GetField("_godClose", Flags).SetValue(externalViewInstance, (float)request["zoom"]);
        externalView.GetField("_godCloseTarget", Flags).SetValue(externalViewInstance, (float)request["zoom"]);
        externalView.GetField("_godPull", Flags).SetValue(externalViewInstance, 1f);
        bool centred = false;
        for (int frame = 0; frame < 180; frame++)
        {
            Vector2 follow = (Vector2)externalView.GetField("_godFollow", Flags).GetValue(externalViewInstance);
            centred = Vector2.Distance(follow, caster.current_position) < .02f &&
                      Vector2.Distance(World.world.camera.transform.position, caster.current_position) < .03f;
            if (centred && frame >= 20) break;
            yield return null;
        }

        if (!centred) throw new InvalidOperationException("三维近景尚未对准实际施法者");
    }
}

/// <summary>清理上一招，并建立对本招有效的敌军、友军或地形条件。</summary>
/// <param name="item">本招设置。</param>
private void Prepare(JObject item)
{
    Config.paused = true;
    CleanExecutions();
    // 攻击和世界效果可能杀死测试对象，下一招重新准备活体，保留本招的真实死亡结果。
    if (Health(friend) == 0) friend = CreateTarget(true, 0);
    for (int index = 0; index < enemies.Count; index++)
        if (Health(enemies[index]) == 0)
            enemies[index] = CreateTarget(false, index);
    friend.setKingdom(caster.kingdom);
    World.world.particles_fire.clear();
    World.world.particles_smoke.clear();
    World.world.projectiles.clear();
    var mod = Cultiway.ModClass.I;
    foreach (var cloud in UnityEngine.Object.FindObjectsOfType<Cloud>())
        if (cloud.active)
            cloud.kill();
    string id = (string)item["id"];
    bool windField = id == "Cultiway.Tornado" && (bool?)request["motionTrace"] == true;
    bool yinGround = id == "Cultiway.YinField" && (bool?)request["motionTrace"] == true;
    // 掌击与动作取证共用等高对靶；后续普通法术继续使用自己的原有对靶。
    bool palm = id == "Cultiway.PalmStrike";
    bool humanoidTarget = palm || (string)request["scene"] == "battle";
    if ((enemies[0].asset.id == "human") != humanoidTarget)
    {
        Actor prior = enemies[0];
        enemies[0] = CreateTarget(false, 0, humanoidTarget);
        enemies[0].setKingdom(prior.kingdom);
    }
    artifactDetails = null;
    executionLog.Clear();
    signals.Clear();
    committedPayments.Clear();
    worldContactsLog.Clear();
    constructionEndLog.Clear();
    worldMaterialsLog.Clear();
    recoveryLog.Clear();
    conductionLog.Clear();
    quenchingLog.Clear();
    burningLog.Clear();
    contactsLog.Clear();
    queuedDamageLog.Clear();
    palmCast = 0;
    palmEnd = null;
    clashesLog.Clear();
    areasLog.Clear();
    yellowObjects.Clear();
    barrierLog.Clear();
    footprints.Clear();
    probeUsed = breakProbeUsed = false;
    barrierBefore = barrierLowest = 0;
    technique = id.StartsWith("Cultiway.KnightTechnique.")
        ? KnightTechniqueCatalog.All.Single(value => value.id + ".Execution" == id)
        : null;
    caster.equipment.weapon.takeAwayItem();
    var spellAsset = mod.SkillV3.SkillLib.get(id);
    if (spellAsset != null &&
        spellAsset.DefaultCastResourceRequirement.ResourceAssetIds.Contains(SkillCastResources.Mana.id))
        caster.equipment.setItem(
            World.world.items.generateItem(AssetManager.items.get("white_staff"), pActor: caster), caster);
    if (caster.GetExtend().HasComponent<Yuanshen>()) caster.GetExtend().E.RemoveComponent<Yuanshen>();
    caster.GetExtend().GetCultisys<Xian>().level =
        id.StartsWith("Cultiway.CoreFormation.Skill.") ? 4 : (int?)request["realm"] ?? 2;
    foreach (Actor actor in new[] { caster, friend }.Concat(enemies))
    {
        actor.finishAllStatusEffects();
        var extend = actor.GetExtend();
        foreach (Entity status in extend.GetStatuses())
        {
            extend.RemoveSharedStatus(status);
            if (status.IsAvailable() && !status.Tags.Has<TagRecycle>()) status.AddTag<TagRecycle>();
        }

        actor.clearAttackTarget();
        actor.attack_timer = 0;
    }

    Vector2 sourcePosition = request["casterPosition"] is JArray start
        ? new Vector2((float)start[0], (float)start[1]) : new Vector2(53, 72);
    if (World.world.GetTile(Mathf.FloorToInt(sourcePosition.x), Mathf.FloorToInt(sourcePosition.y)) == null)
        throw new ArgumentException("施法者位置须在当前演示地图内");
    Place(caster, sourcePosition.x, sourcePosition.y);
    Place(friend, 70, 76);
    for (int index = 0; index < enemies.Count; index++)
    {
        Place(enemies[index], 70 + index % 3 * 4, 68 + index / 3 * 4);
        enemies[index].addAggro(caster);
        caster.addAggro(enemies[index]);
    }

    // 主朝向仍指向原目标，在现有潮行路径上放一位旁靶，便于对照同段真实接触。
    if (id == "Cultiway.TidalWave" && (bool?)request["motionTrace"] == true)
        Place(enemies[1], 62, 70);

    var hold = Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.SpellDemo.Hold");
    if (hold == null)
    {
        var stats = new BaseStats();
        stats.addTag("frozen_ai");
        stats.addTag("immovable");
        hold = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.Hold").SetStats(stats)
            .SetDuration(10000).Build();
    }

    var windTarget = Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.SpellDemo.WindTarget");
    if (windField && windTarget == null)
    {
        var stats = new BaseStats();
        stats.addTag("frozen_ai");
        windTarget = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.WindTarget")
            .SetStats(stats).SetDuration(10000).Build();
    }

    foreach (Actor actor in new[] { caster, friend }.Concat(enemies))
    {
        CombatStatusEffects.ApplyStatus(actor, windField && enemies.Contains(actor) ? windTarget : hold, 10000, actor);
        actor.setStatsDirty();
        actor.updateStats();
        actor.stopMovement();
        actor.data.health = Mathf.CeilToInt(actor.stats["health"]);
    }

    var background = Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.SpellDemo.Background");
    if (background == null)
    {
        var stats = new BaseStats();
        stats.addTag("frozen_ai");
        stats.addTag("immovable");
        stats.addTag(ActorControlTags.Silenced);
        background = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.Background")
            .SetStats(stats).SetDuration(10000).Build();
    }

    foreach (Actor actor in World.world.units.getSimpleList().ToArray())
    {
        if (actor == caster || actor == friend || enemies.Contains(actor) || !isolated.Add(actor.id)) continue;
        CombatStatusEffects.ApplyStatus(actor, background, 10000, actor);
        Place(actor, 12, 12);
        actor.setStatsDirty();
        actor.updateStats();
    }

    // 每次还原同一片地形；世界法术则有明确的可观察前置状态。
    bool drainage = id.EndsWith("DrainWater"), filling = id.EndsWith("FillWater");
    bool exposesSoil = id is "Cultiway.GroundSpike" or "Cultiway.Rift";
    Vector2 effectCenter = request["aimOffset"] is JArray areaAim
        ? sourcePosition + new Vector2((float)areaAim[0], (float)areaAim[1]) : new Vector2(74, 72);
    for (int x = 40; x < 99; x++)
    for (int y = 48; y < 98; y++)
    {
        var tile = World.world.GetTileSimple(x, y);
        if (tile.building != null) tile.building.removeBuildingFinal();
        tile.stopFire();
        tile.removeBurn();
        tile.unfreeze(99);
        tile.heat = 0;
        tile.removeGrass(false);
        bool patch = x >= 67 && x <= 83 && y >= 61 && y <= 80;
        bool wetPatch = false;
        if (drainage || filling)
        {
            Vector2 fromWater = new Vector2(x, y) - effectCenter;
            float shore = 8.1f + .55f * Mathf.Sin(Mathf.Atan2(fromWater.y, fromWater.x) * 3f);
            wetPatch = fromWater.sqrMagnitude <= shore * shore;
        }
        Vector2 fromCaster = new Vector2(x, y) - sourcePosition;
        bool windWater = windField && fromCaster.x >= .5f && fromCaster.x <= 8f &&
                         Mathf.Abs(fromCaster.y) <= (x % 4 == 0 ? 1.1f : .55f);
        bool water = wetPatch && drainage || windWater, basin = wetPatch && filling;
        bool exposed = exposesSoil && (new Vector2(x, y) - effectCenter).sqrMagnitude <= 45f;
        bool darkGround = yinGround && (new Vector2(x, y) - effectCenter).sqrMagnitude <= 20f;
        tile.setTileTypes(water ? TileLibrary.shallow_waters : basin ? TileLibrary.pit_shallow_waters :
                exposed ? TileLibrary.sand : darkGround ? TileLibrary.soil_high : TileLibrary.soil_low,
            water || basin || exposed || darkGround ? null : patch && id.EndsWith("Fertilize") ? TopTileLibrary.field : TopTileLibrary.grass_low);
    }

    if (id.EndsWith("CleanLandField"))
        for (int x = 69; x <= 77; x++)
        for (int y = 69; y <= 75; y++)
        {
            float edge = new Vector2((x - 72.8f) * .8f, y - 71.8f).sqrMagnitude;
            if (edge > 13f + ((x * 3 + y) % 4)) continue;
            var tile = World.world.GetTileSimple(x, y);
            tile.burned_stages = 2;
            tile.heat = 50;
            if ((x + y) % 4 == 0) tile.startFire();
        }
    if (id.EndsWith("Fertilize"))
    {
        // 让演示麦田走原版城市维护，避免无归属植株在施放前被原版回收。
        if (caster.city == null)
        {
            caster.joinLanguage(World.world.languages.newLanguage(caster, true));
            caster.setCulture(World.world.cultures.newCulture(caster, true));
            World.world.kingdoms.makeNewCivKingdom(caster);
            caster.joinCity(World.world.cities.buildNewCity(caster, caster.current_tile.zone));
        }
        var city = caster.city;
        for (int x = 60; x <= 82; x += 2)
        for (int y = 64; y <= 82; y += 2)
            city.addZone(World.world.GetTileSimple(x, y).zone);
        World.world.buildings.addBuilding("windmill_human_0", World.world.GetTileSimple(75, 75));
        for (int x = 69; x <= 78; x += 2)
        for (int y = 66; y <= 78; y += 2)
        {
            var crop = World.world.buildings.addBuilding("wheat", World.world.GetTileSimple(x, y));
            if (crop != null) crop.data.grow_time = -10000;
        }
        CityBehCheckFarms.check(city);
    }
    if (id.EndsWith("PurificationWave"))
        CombatStatusEffects.ApplyStatus(friend, StatusEffects.Burn, 10, enemies[0]);
    friend.data.health = Mathf.Max(1, Mathf.CeilToInt(friend.stats["health"] * .35f));
    caster.GetExtend().GetCultisys<Xian>().wakan = 10000;
    caster.setMana(10000, pClamp: false);
    var owner = caster.GetExtend();
    if (id.StartsWith("Cultiway.CoreFormation.Skill.")) PrepareFormation(owner, id);
    if (technique != null)
    {
        if (!owner.HasCultisys<Knight>()) owner.AddComponent(new Knight { level = 8, vigor = 10000 });
        string weapon = technique.Style == KnightStyles.Lancer ? "spear_iron" :
            technique.Style == KnightStyles.Guardian ? "hammer_iron" : "sword_iron";
        caster.equipment.setItem(World.world.items.generateItem(AssetManager.items.get(weapon), pActor: caster),
            caster);
        KnightStyleMasteryService.Master(owner, technique.Style);
        var known = (IEnumerable)typeof(ActorExtend).GetMethod("GetLearnedSkillsInOrder", Flags)
            .Invoke(owner, null);
        foreach (Entity previous in known.Cast<Entity>().ToArray())
            if (previous.TryGetComponent(out SpecializedActiveAbility specialized) &&
                specialized.ProviderId == "content.knight_techniques")
                SkillOwnershipService.Forget(owner, previous);
        SkillOwnershipService.Learn(owner, KnightTechniqueSkills.GetContainer(technique), true);
        int distance = technique == KnightTechniques.FormationCharge ? 4 :
            technique == KnightTechniques.SkyfallStrike ? 5 : 1;
        Place(caster, 70 - distance, 68);
        var handles = new List<ActiveAbilityHandle>();
        ActiveAbilityService.Collect(owner, handles);
        ability = handles.Single(handle => handle.EntryId == technique.id);
        SkillCooldownService.Clear(owner, ability.Source);
    }

    if (id.StartsWith("Cultiway.ArtifactAbility."))
    {
        Place(caster, 65, 68);
        PrepareArtifact(owner, id);
    }

    if (id == "Cultiway.PalmStrike")
    {
        PositionPalmTarget();
    }

    owner.MarkCultiwayStatsDirty();
    caster.setStatsDirty();
    caster.updateStats();
    Camera();
    mod.CommandBuffer.Playback();
}

/// <summary>将原地掌击放回实际接触距离；动作取证沿用已核对的人形对靶。</summary>
private void PositionPalmTarget()
{
    Place(caster, 69, 68);
    var spatial = typeof(Cultiway.ModClass).Assembly.GetType("Cultiway.Content.Combat.SpatialActorPose", true);
    float height = (float)spatial.GetMethod("Height", Flags).Invoke(null, new object[] { caster });
    Place(enemies[0], 69 + height * .4f, 68);
}

/// <summary>通过正式技能序列实际释放，并按世界时间截图，记录真实生成和受伤。</summary>
/// <param name="item">本招设置。</param>
/// <param name="folder">本段输出目录。</param>
private IEnumerator Record(JObject item, string folder)
{
    var mod = Cultiway.ModClass.I;
    string id = (string)item["id"];
    var asset = mod.SkillV3.SkillLib.get(id);
    if (!artifact.IsNull && (id == ArtifactAbilities.SpiritHostManifestation.id ||
                             id == ArtifactAbilities.FiveEssenceOutpouring.id))
    {
        var instance = artifact.GetComponent<ArtifactAbilitySet>().abilities[0];
        var storage = artifact.GetComponent<ArtifactStorageState>();
        ArtifactStorageOperations.Store(ref storage, id == ArtifactAbilities.SpiritHostManifestation.id
            ? ArtifactStorageOperations.SoulEssence
            : ArtifactStorageOperations.AbsorbedPower, instance.GetNumber("stored_resource_cost"));
        artifact.GetComponent<ArtifactStorageState>() = storage;
    }

    var owner = caster.GetExtend();
    bool formationActive = false;
    if (id.StartsWith("Cultiway.CoreFormation.Skill."))
    {
        var handles = new List<ActiveAbilityHandle>();
        ActiveAbilityService.Collect(owner, handles);
        foreach (var handle in handles)
        {
            if (handle.ProviderId != "content.core_formation" ||
                handle.Source.GetComponent<SkillContainer>().SkillEntityAssetID != id) continue;
            ability = handle;
            formationActive = true;
            break;
        }
    }

    Entity skill = default;
    bool dedicated = !artifact.IsNull || technique != null || id == "Cultiway.PalmStrike" || formationActive;
    string requiredSource = (string)request["requiredSource"];
    if (requiredSource != null && !dedicated)
        throw new InvalidOperationException("当前能力没有来自指定入口的正式授予：" + id + " / " + requiredSource);
    if (dedicated) skill = technique != null || formationActive ? ability.Source : default;
    else if (granted.TryGetValue(asset.id, out Entity original)) skill = original;
    else
    {
        var blueprint = Blueprint(asset, (int)item["variant"], (string)item["trajectory"]);
        foreach (SkillModifierSpec spec in item["modifiers"].ToObject<SkillModifierSpec[]>())
        {
            blueprint.Modifiers.RemoveAll(value => value.AssetId == spec.AssetId);
            blueprint.Modifiers.Add(spec);
        }

        if (asset.CanBeLearned)
        {
            var compiled = new SkillBlueprintCompiler().Compile(blueprint, SkillBlueprintCompileMode.Preview);
            if (!compiled.Success)
                throw new InvalidOperationException("词条或轨迹不兼容：" + string.Join("；",
                    compiled.Validation.Issues.Select(issue => issue.Message)));
            skill = compiled.Container;
        }
        else
            skill = new SkillContainerBuilder(asset).UseAnimation((int)item["variant"])
                .Build(SkillContainerBuildMode.SourceGranted);

        temporarySkill = skill;
    }

    observed = skill;
    spawned = 0;
    var relation = asset == null ? SkillUseTargetRelation.Hostile : asset.UseProfile.TargetRelation;
    BaseSimObject target = relation == SkillUseTargetRelation.Self ? caster :
        relation == SkillUseTargetRelation.Friendly ? friend : enemies[0];
    if (relation == SkillUseTargetRelation.WorldTile) target = enemies[0];
    // 短程法术沿用同一对靶和规则，只在指定距离处观察实际接触。
    if (request["targetOffset"] is JArray offset && target is Actor targetActor && targetActor != caster)
    {
        Place(targetActor, caster.current_position.x + (float)offset[0],
            caster.current_position.y + (float)offset[1]);
        ConstructedAbilityService.NotifyActorChanged(targetActor);
    }
    if (request["casterPosition"] is JArray)
        ConstructedAbilityService.NotifyActorChanged(caster);
    owner.GetCultisys<Xian>().wakan = 10000;
    caster.setMana(10000, pClamp: false);
    if (owner.HasCultisys<Knight>()) owner.GetCultisys<Knight>().vigor = caster.stats[BaseStatses.MaxVigor.id];
    float wakanBefore = owner.GetCultisys<Xian>().wakan, manaBefore = caster.getMana();
    friend.setKingdom(caster.kingdom);
    int[] health = enemies.Select(Health).ToArray();
    float friendBefore = Health(friend);
    string[] FriendStatuses() => friend.GetExtend().GetStatuses()
        .Select(status => status.GetComponent<StatusComponent>().Type.id)
        .Distinct().OrderBy(id => id, StringComparer.Ordinal).ToArray();
    string[] friendStatusesBefore = FriendStatuses();
    if (technique != null || id == "Cultiway.PalmStrike")
    {
        // 准备和换镜头期间冻结，正式入口调用前解除，防止三维观察模式提前自主出手。
        foreach (Entity status in owner.GetStatuses().ToArray())
            if (status.GetComponent<StatusComponent>().Type.id == "Cultiway.SpellDemo.Hold")
                owner.RemoveSharedStatus(status);
        owner.MarkCultiwayStatsDirty();
        caster.setStatsDirty();
        caster.updateStats();
        caster.current_rotation = Vector3.zero;
    }

    if (id == "Cultiway.PalmStrike")
    {
        // 暂停状态先稳定近景，首帧即可同时看到施法者和接触对象。
        PositionPalmTarget();
        Camera();
        yield return null;
        Camera();
        yield return null;
    }

    var viewState = ConfirmViewState();

    bool used;
    if (dedicated)
    {
        if (id == "Cultiway.PalmStrike")
        {
            // 换镜中的避让可能改动实际坐标，等镜头稳定后在正式调用的同一帧放回原位。
            PositionPalmTarget();
            var handles = new List<ActiveAbilityHandle>();
            ActiveAbilityService.Collect(owner, handles);
            ability = handles.Single(handle => handle.ProviderId == "content.palm_strike");
        }

        if (requiredSource != null && ability.ProviderId != requiredSource)
            throw new InvalidOperationException("当前能力没有来自指定入口的正式授予：" + id + " / " + requiredSource);

        var descriptor = ActiveAbilityService.Describe(owner, ability);
        if (descriptor.TargetMode == ActiveAbilityTargetMode.Self) target = caster;
        if (id == "Cultiway.PalmStrike")
        {
            var external = AppDomain.CurrentDomain.GetAssemblies()
                .Select(assembly => assembly.GetType("FirstPerson.WorldBoxMod", false)).FirstOrDefault(type => type != null);
            object view = external?.GetProperty("Instance", Flags).GetValue(null);
            var entry = new
            {
                source = caster.asset.id, opponent = target.a.asset.id, sourceId = caster.id, targetId = target.a.id,
                worldfallLoaded = view != null,
                firstPerson = (bool?)external?.GetProperty("IsFirstPerson", Flags).GetValue(view) ?? false,
                godView = (bool?)external?.GetProperty("GodShown", Flags).GetValue(view) ?? false,
                distance = Vector2.Distance(caster.current_position, target.current_position),
                range = ActiveAbilityService.ResolveRange(owner, ability, target),
                casterHeight = caster.position_height, targetHeight = target.a.position_height,
                hostile = SkillTargetRelationResolver.IsHostile(caster, target),
                alive = target.isAlive(), flying = target.a.isFlying(),
                canAttack = caster.isAttackPossible(), attackTimer = caster.attack_timer,
                control = ActiveAbilityService.ResolveControlState(owner, ability).BlockReason.ToString()
            };
            Write(Path.Combine(folder, "palm-entry.json"), entry);
        }
        used = ActiveAbilityService.TryUse(owner, ability, new ActiveAbilityTarget(target, target.GetSimPos()),
            ActiveAbilityUseOrigin.Script);
    }
    else
    {
        long currentCase = executionCase;
        int steps = SkillCastCost.GetAffordableStepLimit(owner, skill);
        var plan = request["aimOffset"] is JArray aim
            ? SkillCastPlanner.CreatePointPlan(owner, skill,
                caster.GetSimPos() + new Vector3((float)aim[0], (float)aim[1], 0f), steps)
            : SkillCastPlanner.CreatePlan(owner, skill, target, steps);
        used = mod.SkillV3.StartSkillSequence(owner, skill, plan, SkillContext.DefaultStrength,
            runtime_data: new SkillCastRuntimeData
            {
                Origin = ActiveAbilityUseOrigin.Script,
                WorldScope = new ConstructionWorldScope(() => busy && executionCase == currentCase,
                    (_, tile) => true)
            });
    }

    if (!used)
        throw new InvalidOperationException("正式施法入口拒绝：" + id +
                                            (dedicated
                                                ? "；" + ActiveAbilityService.ResolveControlState(owner, ability)
                                                    .BlockReason
                                                : ""));
    mod.CommandBuffer.Playback();
    var formationStatus = formationActive && CoreFormationEffectResolver.TryResolveFamily(owner, ability.EntryId, out var effect)
        ? effect.Definition.StateStatus : null;
    double? formationActiveAt = null;
    var times = new List<double>();
    var meshes = (IList)typeof(Cultiway.ModClass).Assembly
        .GetType("Cultiway.Content.Combat.CombatSpatialVisualSystem", true)
        .GetField("Meshes", Flags).GetValue(null);
    int peakMeshes = 0, previewFrame = 0;
    double start = World.world.getCurWorldTime(),
        duration = Math.Max((double)request["duration"], id.EndsWith(".FivePhase") ? 10.5 : 0),
        nextCapture = 0;
    var motionFrames = (bool?)request["motionTrace"] == true ? new List<object>() : null;
    double interval = 1d / (int)request["fps"];
    float nextStatus = Time.realtimeSinceStartup + 2;
    if ((string)request["scene"] == "shield")
    {
        if (asset?.ImpactProfile.IsBarrier != true && id != ArtifactAbilities.GoldenBellBarrier.id)
            throw new InvalidOperationException("迎击场景只支持真实墙、护盾或金钟护界：" + id);
        if (request["targetOffset"] is JArray approach)
            Place(enemies[0], caster.current_position.x + (float)approach[0],
                caster.current_position.y + (float)approach[1]);
        else Place(enemies[0], 68, 72);
    }

    Config.paused = false;
    // 首帧先留出起手前的场景，往后的帧均读取真实世界时间。
    while (World.world.getCurWorldTime() - start + .00001 < duration)
    {
        if (File.Exists(Path.Combine(Root, "cancel"))) throw new OperationCanceledException("已取消演示");
        Camera();
        Tooltip.hideTooltipNow();
        double elapsed = World.world.getCurWorldTime() - start;
        if (!formationActiveAt.HasValue && formationStatus != null &&
            CombatStatusEffects.TryGetStatus(caster, formationStatus, caster, out _))
            formationActiveAt = World.world.getCurWorldTime();
        if ((string)request["scene"] == "shield") ProbeShield(elapsed);
        if (elapsed + .00001 >= nextCapture)
        {
            if (meshes.Count > peakMeshes)
            {
                peakMeshes = meshes.Count;
                previewFrame = times.Count;
            }

            if ((bool?)request["diagnostics"] == true && times.Count % 5 == 0) InspectYellowSprites();
            InspectFootprints();
            times.Add(elapsed);
            motionFrames?.Add(ReadMotionFrame(id, elapsed));
            new ScreenFacade().Capture(Path.Combine(folder, "frames",
                (times.Count - 1).ToString("00000") + ".png"));
            nextCapture = (Math.Floor((elapsed + .00001) / interval) + 1) * interval;
        }

        if (Time.realtimeSinceStartup >= nextStatus)
        {
            Write(Path.Combine(output, "status.json"),
                new { done = false, current = item["key"], stage = "录制", elapsed, frames = times.Count });
            nextStatus = Time.realtimeSinceStartup + 2;
        }

        yield return null;
        if (errors.Count > 0) throw new InvalidOperationException(string.Join("\n", errors));
    }

    Config.paused = true;
    yield return null; // 截图在帧尾落盘，报告必须晚于最后一次截图。
    double actual = World.world.getCurWorldTime() - start;
    bool palm = id == "Cultiway.PalmStrike";
    var palmHits = palm ? contactsLog.Select(JObject.FromObject).Where(hit => (long?)hit["cast"] == palmCast &&
        (long?)hit["target"] == enemies[0].id && (int?)hit["node"] == -1).ToArray() : Array.Empty<JObject>();
    var palmDamage = palm ? queuedDamageLog.Select(JObject.FromObject).Where(hit => (long?)hit["cast"] == palmCast &&
        (long?)hit["target"] == enemies[0].id).ToArray() : Array.Empty<JObject>();
    bool palmReleased = palm && palmEnd.HasValue && !palmEnd.Value.Cancelled && !BodyControlState.IsBusy(caster.id) &&
        !ConstructedAbilityService.TryGetBodyPose(caster.id, out _);
    bool palmConfirmed = palm && palmCast > 0 && palmHits.Length == 1 && palmDamage.Length == 1 &&
        (int?)palmDamage[0]["count"] == 1 && (int?)palmDamage[0]["lost"] > 0 && palmReleased;
    bool shield = (string)request["scene"] == "shield";
    bool shieldConfirmed = probeUsed && barrierBefore > barrierLowest &&
        ((bool?)request["shieldBreak"] != true || breakProbeUsed && barrierLowest == 0f);
    bool? effectConfirmed = palm ? (bool?)palmConfirmed : shield ? shieldConfirmed :
        formationStatus == null ? null : formationActiveAt.HasValue;
    int recordedContacts = contactsLog.Select(JObject.FromObject).Count(row =>
        (string)row["id"] == id && (long?)row["source"] == caster.id);
    WriteResult(Path.Combine(folder, "result.json"), new
    {
        passed = (spawned > 0 || dedicated && !formationActive && used) && errors.Count == 0 &&
                 (requiredSource == null || formationStatus == null || formationActiveAt.HasValue) &&
                 (!palm || palmConfirmed) &&
                 (!shield || shieldConfirmed),
        execution = new { accepted = used, started = spawned > 0 || palmCast > 0, source = caster.id },
        effect = new { confirmed = effectConfirmed, contacts = recordedContacts,
            lost = palm ? (int?)palmDamage.Sum(hit => (int?)hit["lost"] ?? 0) : null,
            shieldAbsorbed = shield && probeUsed ? (float?)(barrierBefore - barrierLowest) : null,
            formationActiveAt },
        id, item, frames = times.Count, times, start, motionFrames,
        sourceProvider = dedicated ? ability.ProviderId : null,
        sourceEntry = dedicated ? ability.EntryId : null,
        formationActiveAt,
        duration = actual, spawned, peakMeshes, previewFrame, artifactDetails,
        palm = palm ? new { cast = palmCast, contacts = palmHits.Length, settlements = palmDamage.Length,
            lost = palmDamage.Sum(hit => (int?)hit["lost"] ?? 0), released = palmReleased,
            end = palmEnd?.WorldTime, age = palmEnd?.Age } : null,
        view = (string)request["view"], viewState, finalViewState = ConfirmViewState(),
        lighting = (string)request["lighting"] ?? "day",
        lightingState = LightingState(), scene = (string)request["scene"], executionLog, contactsLog,
        worldContactsLog, areasLog, queuedDamageLog, committedPayments,
        barrierLog, clashesLog, footprints = footprints.Values.ToArray(), yellowObjects,
        assembly = typeof(Cultiway.ModClass).Assembly.ManifestModule.ModuleVersionId.ToString(),
        shield = new { probeUsed, breakProbeUsed, barrierBefore, barrierLowest, absorbed = barrierLowest < barrierBefore },
        validation = palm ? "验证正式施放、实际掌面扣血和自然收势；画面另行查看" :
            "仅验证施放和运行错误；美术、范围与防御效果需另外验收",
        wakanBefore, wakanAfter = owner.GetCultisys<Xian>().wakan,
        manaBefore, manaAfter = caster.getMana(), friendBefore, friendAfter = Health(friend),
        friendStatusesBefore, friendStatusesAfter = FriendStatuses(),
        friendDied = Health(friend) == 0,
        damaged = enemies.Where((actor, index) => Health(actor) < health[index]).Count(), errors
    });
}

/// <summary>读同一个正式施放当前发布的姿态，随原帧保留数值，不推进模拟。</summary>
private object ReadMotionFrame(string id, double time)
{
    float[] Point(Vector3 value) => new[] { value.x, value.y, value.z };
    bool inspectPalmView = id == "Cultiway.PalmStrike" && (string)request["view"] == "firstperson";
    Matrix4x4 viewProjection = inspectPalmView ? Shader.GetGlobalMatrix("_FP_VP") : default;
    object Project(Vector3 value)
    {
        Vector4 clip = viewProjection * new Vector4(value.x, value.y, value.z, 1f);
        return new { x = clip.w > 0f ? clip.x / clip.w : 0f, y = clip.w > 0f ? clip.y / clip.w : 0f,
            depth = clip.w };
    }
    var live = (IEnumerable)typeof(ConstructedAbilityService).GetField("casts", Flags).GetValue(null);
    var views = new List<FormVisualInstance>();
    var samples = new List<object>();
    foreach (object running in live)
    {
        Type type = running.GetType();
        if ((long)type.GetField("SourceId", Flags).GetValue(running) != caster.id) continue;
        var cast = (AbilityCast)type.GetField("Cast", Flags).GetValue(running);
        if (cast.Finished || cast.Plan.Id != id) continue;
        views.Clear();
        cast.AppendVisuals(views);
        var pose = cast.BodyPose;
        samples.Add(new
        {
            cast = (long)type.GetField("Id", Flags).GetValue(running), cast.Age,
            velocity = views.Count == 0 ? null : Point(cast.Velocity(0)),
            body = pose.HasValue ? new { pose.Value.ActionAge, hip = Point(pose.Value.CenterOfMass),
                palm = Point(pose.Value.Hand), elbow = Point(pose.Value.Elbow), turn = pose.Value.Turn,
                palmView = inspectPalmView ? Project(pose.Value.Hand) : null } : null,
            forms = views.Select(form =>
            {
                float[] forward = form.Resource.Description.Forward;
                return new
                {
                    id = form.Resource.Description.Id, center = Point(form.Transform.GetColumn(3)),
                    heading = Point(form.Transform.MultiplyVector(new Vector3(forward[0], forward[1], forward[2])).normalized),
                    scale = Point(form.Transform.lossyScale), build = form.BuildProgress, opacity = form.Dye?.a ?? 1f,
                    controls = form.Skin?.Take(form.Resource.Description.Controls.Length)
                        .Select(matrix => Point(matrix.GetColumn(3))).ToArray()
                };
            }).ToArray()
        });
    }
    object barriers = typeof(Cultiway.Core.SkillLibV3.Manager).GetField("Barriers", Flags).GetValue(null);
    bool groundBarrier = barriers != null && (bool)typeof(Cultiway.Core.SkillLibV3.Manager).Assembly
        .GetType("Cultiway.Core.SkillLibV3.ISkillBarrierBridge", true)
        .GetProperty("HasGroundBarriers", Flags).GetValue(barriers);
    return new { time, groundBarrier, bodyBusy = BodyControlState.IsBusy(caster.id),
        source = Point(caster.GetSimPos()), primary = Point(enemies[0].GetSimPos()), samples };
}

/// <summary>读取真实生命；吞噬或死亡后的对象按零记录，避免删去实际作用结果。</summary>
private static int Health(Actor actor) => actor?.data == null || !actor.isAlive() ? 0 : actor.data.health;

/// <summary>只在独立测试世界补充已经失效的目标，下一招不用上一招的尸体。</summary>
private Actor CreateTarget(bool friendly, int index, bool human = false)
{
    var actor = World.world.units.createNewUnit(friendly || human ? "human" : "wolf",
        World.world.GetTileSimple(70 + index % 3 * 4, 68 + index / 3 * 4), pAdultAge: true);
    actor.data.name = friendly ? "法术演示·友军" : "法术演示·敌军";
    actor.addTrait("super_health");
    if (friendly) actor.setKingdom(caster.kingdom);
    return actor;
}

/// <summary>按稳定定义建立单一法术蓝图，不读取或使用组合样板。</summary>
/// <param name="asset">实际法术。</param>
/// <param name="variant">旧变体编号。</param>
/// <param name="trajectory">有效轨迹。</param>
private static SkillBlueprint Blueprint(SkillEntityAsset asset, int variant, string trajectory)
{
    var blueprint = new SkillBlueprint
    {
        EntityAssetId = asset.id, AnimationIndex = variant, TrajectoryAssetId = trajectory,
        CastResourceRequirement = asset.DefaultCastResourceRequirement.DeepClone(),
        AiNamingEnabled = false, NameMode = SkillBlueprintNameMode.Custom, CustomName = Name(asset.id)
    };
    SkillBlueprintModifierRules.EnsureRequiredModifiers(blueprint, asset);
    return blueprint;
}

/// <summary>只移除测试世界中的瞬时执行和显示缓存，不改原始资产。</summary>
private void CleanExecutions()
{
    executionCase++;
    // 原版云独立于瞬时施放；只清理本测试施法者的天气，避免跨演示继续降雨。
    Type weather =
        typeof(ConstructedAbilityService).Assembly.GetType("Cultiway.Content.Skills.ConstructedRainClouds");
    var clouds = (IDictionary)weather.GetField("Clouds", Flags).GetValue(null);
    foreach (Cloud cloud in clouds.Keys.Cast<Cloud>().ToArray())
        if (caster != null && (long)clouds[cloud].GetType().GetField("Source", Flags).GetValue(clouds[cloud]) ==
            caster.id)
            cloud.kill();
    var mod = Cultiway.ModClass.I;
    foreach (var learned in learnedForBattle)
        if (learned.Skill.IsAvailable())
            SkillOwnershipService.Forget(learned.Owner, learned.Skill);
    learnedForBattle.Clear();
    if (incomingSkill.IsAvailable()) retiringSkills.Add(incomingSkill);
    incomingSkill = default;
    if (artifact.IsAvailable() && caster != null)
    {
        caster.GetExtend().UnequipArtifact(artifact, suppressAutoEquip: true);
        if (artifact.HasComponent<Position>()) artifact.GetComponent<Position>().value = new Vector3(12, 12);
    }

    artifact = default;
    typeof(Cultiway.Core.SkillLibV3.Manager).GetMethod("ClearQueuedSkillSequences", Flags)
        .Invoke(mod.SkillV3, null);
    foreach (Entity entity in mod.W.Query<SkillCastSequence>().Entities.ToArray())
        if (!entity.Tags.Has<TagPrefab>() && !entity.Tags.Has<TagRecycle>())
            entity.AddTag<TagRecycle>();
    foreach (Entity entity in mod.W.Query<SkillEntity>().Entities.ToArray())
    {
        if (entity.Tags.Has<TagPrefab>()) continue;
        if (entity.HasComponent<SkillAnimationLifecycleState>())
            entity.GetComponent<SkillAnimationLifecycleState>().Phase = SkillAnimationPhase.RecycleReady;
        if (!entity.Tags.Has<TagRecycle>()) entity.AddTag<TagRecycle>();
    }

    if (!temporarySkill.IsNull) retiringSkills.Add(temporarySkill);
    temporarySkill = default;
    observed = default;
    observedBarriers.Clear();
    var referenced = new HashSet<Entity>(mod.W.Query<SkillEntity>().Entities
        .Where(entity => !entity.Tags.Has<TagPrefab>())
        .Select(entity => entity.GetComponent<SkillEntity>().SkillContainer));
    for (int index = retiringSkills.Count - 1; index >= 0; index--)
    {
        Entity container = retiringSkills[index];
        if (!container.IsNull && referenced.Contains(container)) continue;
        if (!container.IsNull) SkillBlueprintCompiler.Recycle(container);
        retiringSkills.RemoveAt(index);
    }

    typeof(Cultiway.ModClass).Assembly.GetType("Cultiway.Content.Visuals.BattleSpellVisualRuntime", true)
        .GetMethod("Clear", Flags).Invoke(null, null);
}

/// <summary>只统计当前演示容器实际建立的执行体。</summary>
/// <param name="entity">实际执行体。</param>
private void OnSpawn(Entity entity)
{
    var skill = entity.GetComponent<SkillEntity>();
    if (skill.SkillContainer == observed) spawned++;
    if (skill.Asset?.ImpactProfile == null) return;
    var context = entity.GetComponent<SkillContext>();
    executionLog.Add(new
    {
        time = World.world.getCurWorldTime(), id = skill.Asset.id, source = context.SourceObj?.getID(),
        collisionRadius = SkillEffectRadius.Collision(entity), effectRadius = SkillEffectRadius.Effect(entity),
        scale = entity.GetComponent<EffectRadiusScale>().Value
    });
}

/// <summary>记录共用构造实际受理的施放及自主来源，不把脚本播放记成自主交战。</summary>
/// <param name="started">正式受理事件。</param>
private void OnConstructedStart(ConstructedCastStarted started)
{
    if (currentCase == "Cultiway.PalmStrike" && started.AbilityId == currentCase &&
        caster != null && started.SourceId == caster.id && started.Origin == ActiveAbilityUseOrigin.Script)
        palmCast = started.CastId;
    if (!observed.IsNull && observed.HasComponent<SkillContainer>() && caster != null &&
        started.SourceId == caster.id &&
        started.AbilityId == observed.GetComponent<SkillContainer>().SkillEntityAssetID)
    {
        spawned++;
        if (observed.GetComponent<SkillContainer>().Asset.ImpactProfile.IsBarrier)
            observedBarriers.Add(started.CastId);
    }
    executionLog.Add(new
    {
        time = started.WorldTime, id = started.AbilityId, source = started.SourceId,
        cast = started.CastId, origin = started.Origin.ToString(), framework = "construction"
    });
}

/// <summary>保留正式掌击自己的结束事实，录制结束后强行清理不算自然收势。</summary>
/// <param name="ended">实际结束的施放。</param>
private void OnConstructedEnd(ConstructedCastEnded ended)
{
    if (palmCast != 0 && ended.CastId == palmCast) palmEnd = ended;
    if (ended.AbilityId == currentCase && caster != null && ended.SourceId == caster.id)
        constructionEndLog.Add(ended);
}

/// <summary>记录共同模拟真正接受的地块操作，不把施放成功直接算成工作完成。</summary>
/// <param name="contact">实际地块接触结果。</param>
private void OnWorldContact(ConstructedWorldContact contact) => worldContactsLog.Add(new
{
    time = contact.WorldTime, cast = contact.CastId, id = contact.AbilityId, action = contact.Action,
    contact.X, contact.Y, contact.Attempts, changed = contact.Result.Changed,
    flags = contact.Result.Flags.ToString()
});

/// <summary>只记录正式送达的消息，不用选中的目标冒充实际收件人。</summary>
private void OnSignal(ConstructedSignalReceipt received) => signals.Add(received);

/// <summary>记录正式提交的实际数值，不用段落末尾的资源余额冒充支付。</summary>
private void OnPayment(long payer, IReadOnlyList<SkillCastPaymentEntry> entries) => committedPayments.Add(new
{
    payer, time = World.world.getCurWorldTime(),
    entries = entries.Select(entry => new { resource = entry.Resource.id, cost = entry.Cost, spent = entry.Spent }).ToArray()
});

/// <summary>只保留可与实际施放对应的送达内容及冻结方位。</summary>
private static object SignalFact(ConstructedSignalReceipt received) => new
{
    cast = received.CastId, sender = received.SenderId, recipient = received.RecipientId,
    kind = received.Kind.ToString(), time = received.WorldTime,
    observation = received.Observation is { } seen ? new
    {
        subject = seen.SubjectId, point = new[] { seen.Position.x, seen.Position.y },
        observedAt = seen.ObservedAt, expiresAt = seen.ExpiresAt
    } : null
};

/// <summary>记录已确认世界材料，与原施放和独立稳定编号对应。</summary>
