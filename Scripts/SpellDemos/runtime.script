/// <summary>收集本次运行的游戏错误，不把启动前的历史错误算入结果。</summary>
/// <param name="message">日志内容。</param>
/// <param name="stack">调用位置。</param>
/// <param name="type">日志类别。</param>
private void OnLog(string message, string stack, LogType type)
{
    if (type is LogType.Error or LogType.Exception or LogType.Assert) errors.Add(message + "\n" + stack);
}

/// <summary>记录大块黄色精灵的资源与材质，避免猜测后错误删除别的特效。</summary>
private void InspectYellowSprites()
{
    foreach (var system in UnityEngine.Object.FindObjectsOfType<ParticleSystem>())
    {
        if (!system.gameObject.activeInHierarchy || system.particleCount == 0) continue;
        var particles = new ParticleSystem.Particle[system.particleCount];
        system.GetParticles(particles);
        var renderer = system.GetComponent<ParticleSystemRenderer>();
        foreach (var particle in particles)
        {
            Color color = particle.GetCurrentColor(system);
            float size = particle.GetCurrentSize(system);
            if (color.r < .7f || color.g < .5f || color.b > .6f || size < .5f) continue;
            yellowObjects.Add(system.name + " | " + renderer.sharedMaterial?.shader?.name + " | " +
                              renderer.sharedMaterial?.mainTexture?.name + " | size=" + size.ToString("F2") +
                              " | " + particle.position);
        }
    }

    foreach (var renderer in UnityEngine.Object.FindObjectsOfType<SpriteRenderer>())
    {
        if (!renderer.enabled || !renderer.gameObject.activeInHierarchy || renderer.sprite == null) continue;
        Color color = renderer.color;
        if (color.r < .7f || color.g < .5f || color.b > .6f || renderer.bounds.size.x < 1.5f) continue;
        yellowObjects.Add(renderer.name + " | " + renderer.sprite.name + " | " + renderer.sprite.texture.name +
                          " | " + renderer.sharedMaterial?.shader?.name + " | " + renderer.transform.position);
    }
}

/// <summary>读取已初始化的真实执行体，不从贴图尺寸推算作用区域。</summary>
private void InspectFootprints()
{
    foreach (var entity in Cultiway.ModClass.I.W.Query<SkillEntity>().Entities)
    {
        if (entity.Tags.Has<TagPrefab>() || entity.Tags.Has<TagRecycle>() ||
            footprints.ContainsKey(entity.Id)) continue;
        if (footprints.Count >= 512) break;
        var skill = entity.GetComponent<SkillEntity>();
        // 法宝还会建立纯展示动画，它们没有作用配置，不属于范围核对对象。
        if (skill.Asset?.ImpactProfile == null) continue;
        if (entity.TryGetComponent(out SkillPersistentState state) && state.Kind != SkillPersistentKind.Field)
            footprints[entity.Id] = new
            {
                id = skill.Asset.id, kind = state.Kind.ToString(),
                position = entity.GetComponent<Position>().value.ToString(),
                direction = entity.GetComponent<Rotation>().value.ToString(),
                length = state.Length, width = state.Width,
                radius = state.Kind == SkillPersistentKind.Shield ? state.Length * .5f + state.Width : 0,
                durability = state.Durability
            };
        else
            footprints[entity.Id] = new
            {
                id = skill.Asset.id, kind = skill.Asset.ImpactProfile.Kind.ToString(),
                position = entity.GetComponent<Position>().value.ToString(),
                effectRadius = SkillEffectRadius.Effect(entity),
                collisionRadius = SkillEffectRadius.Collision(entity),
                explicitTargetOnly = entity.TryGetComponent(out ColliderConfig config) &&
                                     config.ExplicitTargetOnly,
                start = entity.TryGetComponent(out LinearTrajectoryState line) && line.Initialized
                    ? line.Start.ToString()
                    : null,
                end = entity.TryGetComponent(out LinearTrajectoryState endLine) && endLine.Initialized
                    ? endLine.End.ToString()
                    : null
            };
    }
}

/// <summary>真实拦截位置与吸收量。</summary>
private void OnBarrier(Entity entity, Vector2 point, float damage) => barrierLog.Add(new
{
    time = World.world.getCurWorldTime(), id = entity.GetComponent<SkillEntity>().Asset.id,
    point = point.ToString(), damage
});

/// <summary>记录真实接触对象；不以画面覆盖推测命中。</summary>
private void OnContact(Entity entity, BaseSimObject target)
{
    if (contactsLog.Count >= 512) return;
    contactsLog.Add(new
    {
        time = World.world.getCurWorldTime(), id = entity.GetComponent<SkillEntity>().Asset.id,
        source = entity.GetComponent<SkillContext>().SourceObj?.getID(), framework = "legacy",
        target = target.getID(), position = target.GetSimPos().ToString()
    });
}

/// <summary>记录已经发生的范围结算及其最终半径。</summary>
private void OnArea(Entity entity, Vector3 position, float radius)
{
    if (areasLog.Count >= 512) return;
    areasLog.Add(new
    {
        time = World.world.getCurWorldTime(), id = entity.GetComponent<SkillEntity>().Asset.id,
        position = position.ToString(), radius
    });
}

/// <summary>从外部实际发射石弹，让护盾耐久变化证明拦截；不直接扣护盾。</summary>
private void ProbeShield(double elapsed)
{
    if (observedBarriers.Count == 0)
    {
        var barriers = Cultiway.ModClass.I.W.Query<SkillEntity, SkillPersistentState>().Entities
            .Where(entity => !entity.Tags.Has<TagPrefab>() && !entity.Tags.Has<TagRecycle>() &&
                             entity.GetComponent<SkillEntity>().SkillContainer == observed).ToArray();
        float current = barriers.Length > 0 ? barriers[0].GetComponent<SkillPersistentState>().Durability : 0;
        if (!artifact.IsNull && artifact.TryGetComponent(out ArtifactAbilityRuntime runtime))
            current = runtime.abilities.First(entry => entry.instance_id == ability.EntryId)
                .GetNumber("shield_current");
        if (barrierBefore == 0 && current > 0) barrierBefore = barrierLowest = current;
        if (probeUsed && elapsed < 2.5) barrierLowest = Mathf.Min(barrierLowest, current);
    }
    if (elapsed < .45) return;
    bool requireBreak = (bool?)request["shieldBreak"] == true;
    if (probeUsed)
    {
        if (!requireBreak || breakProbeUsed || elapsed < 1.45 || barrierLowest <= 0f || barrierLowest >= barrierBefore) return;
        var attacker = enemies[0].GetExtend();
        if (incomingSkill.IsAvailable()) retiringSkills.Add(incomingSkill);
        // 临时容器可能已随上一枚石弹回收；重击使用自己的施放资料。
        incomingSkill = new SkillContainerBuilder(SkillEntities.RockProjectile).Build();
        breakProbeUsed = attacker.CastSkillV3(incomingSkill, caster, barrierLowest * 1.35f + 1f);
        if (!breakProbeUsed) throw new InvalidOperationException("打穿用石弹未能正式施放");
        return;
    }
    var enemy = enemies[0].GetExtend();
    if (!enemy.HasCultisys<Xian>()) enemy.AddComponent(new Xian { level = 0, wakan = 10000 });
    enemy.GetCultisys<Xian>().wakan = 10000;
    incomingSkill = new SkillContainerBuilder(SkillEntities.RockProjectile).Build();
    probeUsed = requireBreak ? enemy.CastSkillV3(incomingSkill, caster, 13f) : enemy.CastSkillV3(incomingSkill, caster);
    if (!probeUsed) throw new InvalidOperationException("迎击用石弹未能正式施放");
}

/// <summary>只授予法术、解除控制和建立敌对关系；出手时机完全由游戏自身决定。</summary>
private IEnumerator RecordBattle(JObject item, string folder)
{
    var owner = caster.GetExtend();
    Actor enemy = enemies[0];
    var rival = enemy.GetExtend();
    var sides = (JArray)item["battleSides"];
    var participants = new[] { owner, rival };
    bool constructed = sides.SelectMany(side => side).Any(spell => spell["construction"] is JObject);
    for (int side = 0; side < participants.Length; side++)
        TeachBattleSide(participants[side], (JArray)sides[side]);

    Place(caster, 64, 72);
    Place(enemy, 78, 72);
    foreach (Actor other in enemies.Skip(1).Append(friend)) Place(other, 12, 12);

    string battleArtifact = (string)request["battleArtifact"];
    if (battleArtifact != null)
    {
        PrepareArtifact(owner, battleArtifact);
        Config.paused = false;
        for (int frame = 0; frame < 4; frame++) yield return null;
        Config.paused = true;
    }

    foreach (var participant in participants)
    {
        foreach (Entity status in participant.GetStatuses().ToArray())
        {
            participant.RemoveSharedStatus(status);
            if (status.IsAvailable() && !status.Tags.Has<TagRecycle>()) status.AddTag<TagRecycle>();
        }

        participant.Base.setStatsDirty();
        participant.Base.updateStats();
    }

    caster.addAggro(enemy);
    enemy.addAggro(caster);
    caster.setAttackTarget(enemy);
    enemy.setAttackTarget(caster);
    caster.attack_timer = enemy.attack_timer = 0;
    executionLog.Clear();
    signals.Clear();
    committedPayments.Clear();
    worldContactsLog.Clear();
    worldMaterialsLog.Clear();
    recoveryLog.Clear();
    conductionLog.Clear();
    quenchingLog.Clear();
    burningLog.Clear();
    contactsLog.Clear();
    queuedDamageLog.Clear();
    clashesLog.Clear();
    reflectionsLog.Clear();
    areasLog.Clear();
    barrierLog.Clear();
    footprints.Clear();
    int ownerHealth = Health(caster), rivalHealth = Health(enemy);
    var viewState = ConfirmViewState();
    double start = World.world.getCurWorldTime(), next = 0, interval = 1d / (int)request["fps"];
    var times = new List<double>();
    Config.paused = false;
    while (World.world.getCurWorldTime() - start + .00001 < (double)request["duration"])
    {
        if (File.Exists(Path.Combine(Root, "cancel"))) throw new OperationCanceledException("已取消演示");
        Camera();
        Tooltip.hideTooltipNow();
        double elapsed = World.world.getCurWorldTime() - start;
        if (elapsed + .00001 >= next)
        {
            if ((bool?)request["diagnostics"] == true && times.Count % 5 == 0) InspectYellowSprites();
            InspectFootprints();
            times.Add(elapsed);
            new ScreenFacade().Capture(Path.Combine(folder, "frames",
                (times.Count - 1).ToString("00000") + ".png"));
            next = (Math.Floor((elapsed + .00001) / interval) + 1) * interval;
        }

        yield return null;
        if (errors.Count > 0) throw new InvalidOperationException(string.Join("\n", errors));
    }

    Config.paused = true;
    yield return null;
    var autonomous = JArray.FromObject(executionLog).OfType<JObject>()
        .Where(row => (string)row["framework"] != "construction" ||
            (string)row["origin"] == nameof(ActiveAbilityUseOrigin.Autonomous)).ToArray();
    var casts = autonomous.Where(row => (long?)row["source"] == caster.id).ToArray();
    var rivalCasts = autonomous.Where(row => (long?)row["source"] == enemy.id).ToArray();
    var leftIds = new HashSet<long>(casts.Where(row => row["cast"] != null).Select(row => (long)row["cast"]));
    var rightIds = new HashSet<long>(rivalCasts.Where(row => row["cast"] != null).Select(row => (long)row["cast"]));
    bool Opposing(long first, long second) => leftIds.Contains(first) && rightIds.Contains(second) ||
        rightIds.Contains(first) && leftIds.Contains(second);
    var pairedClashes = clashesLog.Select(JObject.FromObject).Where(row =>
        (float)row["absorbed"] > 0f && Opposing((long)row["leftCast"], (long)row["rightCast"])).ToArray();
    bool GuardedAttack(JObject row, string guard, string attack) =>
        (string)row[guard + "Role"] == nameof(ConstructionContactRole.Barrier) &&
        (string)row[attack + "Role"] == nameof(ConstructionContactRole.Attack) &&
        (float)row[guard + "Spent"] > 0f;
    bool BrokenGuard(JObject row, string guard, string attack) =>
        GuardedAttack(row, guard, attack) && !(bool)row[guard + "Present"] &&
        (float)row[guard + "Remaining"] <= 0f && (bool)row[attack + "Present"] &&
        (float)row[attack + "Remaining"] > 0f;
    var guards = pairedClashes.Where(row => GuardedAttack(row, "left", "right") || GuardedAttack(row, "right", "left")).ToArray();
    var breaks = guards.Where(row => BrokenGuard(row, "left", "right") || BrokenGuard(row, "right", "left")).ToArray();
    var pairedReflections = reflectionsLog.Select(JObject.FromObject).Where(row =>
        Opposing((long)row["cast"], (long)row["barrierCast"]) && (float)row["barrierSpent"] > 0f &&
        (long)row["previous"] != (long)row["owner"] && (long)row["owner"] == (long)row["barrierOwner"]).ToArray();
    var pairedReactions = quenchingLog.Select(JObject.FromObject).Where(row =>
        Opposing((long)row["fireCast"], (long)row["waterCast"]) &&
        (float)row["spent"] > 0f && (double)row["evaporated"] > 0d).ToArray();
    string battleEvent = (string)request["battleEvent"];
    string reason = battleEvent switch
    {
        "clash" when pairedClashes.Length == 0 => "观察时间内未发生双方自主施放的相撞损耗",
        "guard" when guards.Length == 0 => "观察时间内未发生双方自主施放的格挡消耗",
        "break" when breaks.Length == 0 => "观察时间内未发生双方自主施放的破盾结果",
        "reflection" when pairedReflections.Length == 0 => "观察时间内未发生双方自主施放的反射交接",
        "element" when pairedReactions.Length == 0 => "观察时间内未发生双方自主施放的水火相消",
        _ => null
    };
    bool artifactUsed = battleArtifact == null || artifact.GetComponent<ArtifactAbilityRuntime>().abilities
        .Any(entry => entry.instance_id == battleArtifact && entry.last_triggered_at >= start);
    int distinct = casts.Select(row => (string)row["id"]).Distinct().Count();
    int together = casts.GroupBy(row => (double)row["time"])
        .Select(group => group.Select(row => (string)row["id"]).Distinct().Count()).DefaultIfEmpty().Max();
    if (reason == null && (casts.Length == 0 || rivalCasts.Length == 0))
        reason = "观察时间内双方未各自完成自主出手";
    WriteResult(Path.Combine(folder, "result.json"), new
    {
        passed = (constructed ? casts.Length > 0 : distinct >= 2 && together >= 2) &&
            rivalCasts.Length > 0 && artifactUsed && reason == null && errors.Count == 0,
        error = reason,
        execution = new { started = casts.Length > 0 && rivalCasts.Length > 0,
            leftCasts = casts.Length, rightCasts = rivalCasts.Length },
        effect = new { confirmed = battleEvent == null ? (bool?)null : reason == null, required = battleEvent,
            clashes = pairedClashes.Length, clashAbsorbed = pairedClashes.Sum(row => (double)row["absorbed"]),
            guards = guards.Length, guardAbsorbed = guards.Sum(row => (double)row["absorbed"]),
            breaks = breaks.Length, reflections = pairedReflections.Length, reactions = pairedReactions.Length },
        item, frames = times.Count, times,
        duration = World.world.getCurWorldTime() - start, spawned = casts.Length, distinct, together,
        rivalCasts = rivalCasts.Length, artifactUsed, artifactDetails,
        view = (string)request["view"], viewState, finalViewState = ConfirmViewState(),
        lighting = (string)request["lighting"] ?? "day",
        lightingState = LightingState(), scene = "battle", executionLog, committedPayments, contactsLog,
        queuedDamageLog, areasLog, barrierLog,
        deliveredSignals = signals.Where(value => leftIds.Contains(value.CastId) || rightIds.Contains(value.CastId))
            .Select(SignalFact).ToArray(),
        participants = new[] { new { id = caster.id, before = ownerHealth, after = Health(caster) },
            new { id = enemy.id, before = rivalHealth, after = Health(enemy) } },
        clashesLog, pairedClashes, guards, breaks, reflectionsLog, pairedReflections, quenchingLog, pairedReactions,
        footprints = footprints.Values.ToArray(), yellowObjects,
        assembly = typeof(Cultiway.ModClass).Assembly.ManifestModule.ModuleVersionId.ToString(),
        validation = "没有脚本逐帧调用施法、规划或执行；仅观察原版 AI 调度", frozen = caster.hasTag("frozen_ai"),
        rivalFrozen = enemies[0].hasTag("frozen_ai"), errors
    });
}

/// <summary>用同一正式学习入口为一方准备真实能力和所需资源。</summary>
private void TeachBattleSide(ActorExtend participant, JArray choices)
{
    var definitions = choices.Where(spell => spell["construction"] is JObject)
        .Select(spell => spell["construction"].ToObject<AbilityDefinition>()).ToArray();
    bool vigor = definitions.Any(definition => definition.Resource == "vigor");
    if (vigor)
    {
        if (choices.Count != definitions.Length || definitions.Any(definition => definition.Resource == "wakan"))
            throw new InvalidOperationException("斗气与修士法术请分配给不同人物");
        participant.E.RemoveComponent<Xian>();
        participant.AddComponent(new Knight { level = 8, vigor = 10000 });
    }
    else if (!participant.HasCultisys<Xian>()) participant.AddComponent(new Xian());

    if (!vigor) participant.GetCultisys<Xian>().level = (int?)request["realm"] ?? 2;
    participant.SetPowerLevel((float)request["power"]);
    string[] weaponForms = definitions.Select(definition => definition.Body?.WeaponForm)
        .Where(form => form != null).Distinct().ToArray();
    if (weaponForms.Length > 1) throw new InvalidOperationException("一方有多个持物要求，请选择同一兵器的构造");
    if (weaponForms.Length == 1)
    {
        var weapon = DemoWeapon(weaponForms[0]) ?? throw new InvalidOperationException("未找到实际兵器：" + weaponForms[0]);
        participant.Base.equipment.setItem(World.world.items.generateItem(weapon, pActor: participant.Base), participant.Base);
    }

    if (definitions.Length == choices.Count && participant.HasComponent<Magic>())
        participant.E.RemoveComponent<Magic>();
    foreach (var definition in definitions)
    {
        string unavailable = ConstructionSceneProblem(definition, battle: true);
        if (unavailable != null) throw new InvalidOperationException(unavailable);
        ConstructedAbilityService.Register(definition);
        ConstructedAbilityService.Learn(participant, definition.Id);
    }
    foreach (var spell in choices.Where(spell => spell["construction"] == null))
    {
        string id = (string)spell["id"];
        var asset = Cultiway.ModClass.I.SkillV3.SkillLib.get(id);
        var compiled = new SkillBlueprintCompiler().Compile(
            Blueprint(asset, 0, SkillBlueprintTrajectory.ResolveDefaultId(asset)), SkillBlueprintCompileMode.Runtime);
        if (!compiled.Success || SkillOwnershipService.Learn(participant, compiled.Container) != SkillOwnershipResult.Added)
            throw new InvalidOperationException("无法授予交战法术：" + id);
        learnedForBattle.Add((participant, compiled.Container));
    }

    participant.MarkCultiwayStatsDirty();
    participant.Base.setStatsDirty();
    participant.Base.updateStats();
    participant.Base.data.health = Mathf.CeilToInt(participant.Base.stats["health"]);
    if (!vigor) participant.GetCultisys<Xian>().wakan = participant.Base.stats[Cultiway.Content.BaseStatses.MaxWakan.id];
    participant.Base.setMana(participant.Base.getMaxMana());
    participant.Base.setStamina(participant.Base.getMaxStamina());
}

/// <summary>通过外部模组自身的第一人称镜头设定朝向。</summary>
private void AimFirstPerson(float yaw, float pitch)
{
    externalView.GetMethod("SetYaw", Flags).Invoke(externalViewInstance, new object[] { yaw });
    externalView.GetMethod("SetPitchDegrees", Flags).Invoke(externalViewInstance, new object[] { pitch });
}

/// <summary>恢复坡面录像开始前的鼠标转向状态。</summary>
private void RestoreTerrainFirstPersonLook()
{
    if (!previousTerrainMouseLookOff.HasValue) return;
    externalView.GetField("MouseLookOff", Flags).SetValue(externalViewInstance, previousTerrainMouseLookOff.Value);
    previousTerrainMouseLookOff = null;
}

/// <summary>原地掌击和持剑在三维使用外部模组的贴近人物相机。</summary>
private bool WantsBodyCloseView() => (string)request["view"] == "worldfall" &&
    (currentCase == "Cultiway.PalmStrike" || heldSwordDemo) && (float?)request["zoom"] < 10f;

/// <summary>当前段结束或中止时解除脚本设置的锁人，不干预用户自己的观察目标。</summary>
private void ReleaseBodyCloseCamera()
{
    if (externalView == null || !WantsBodyCloseView()) return;
    var locked = externalView.GetField("_godLock", Flags);
    if (caster == null || !ReferenceEquals(locked.GetValue(externalViewInstance), caster)) return;
    locked.SetValue(externalViewInstance, null);
    externalView.GetField("_godPull", Flags).SetValue(externalViewInstance, 0f);
}

/// <summary>按实机镜头和附身状态验收视角，并记录真实地图镜头位置和缩放。</summary>
private object ConfirmViewState()
{
    Type viewType = externalView ?? AppDomain.CurrentDomain.GetAssemblies()
        .Select(assembly => assembly.GetType("FirstPerson.WorldBoxMod", false)).FirstOrDefault(type => type != null);
    object observer = externalViewInstance ?? viewType?.GetProperty("Instance", Flags).GetValue(null);
    bool firstPerson = (bool?)viewType?.GetProperty("IsFirstPerson", Flags).GetValue(observer) ?? false;
    bool attached = ControllableUnit.isControllingUnit(caster);
    bool godView = (bool?)viewType?.GetProperty("GodShown", Flags).GetValue(observer) ?? false;
    float godAlpha = (float?)viewType?.GetProperty("GodAlpha", Flags).GetValue(observer) ?? 0f;
    string view = (string)request["view"];
    bool ready = view switch
    {
        "firstperson" => firstPerson && attached,
        "worldfall" => godView && godAlpha >= .99f && !firstPerson,
        _ => !godView && !firstPerson
    };
    if (!ready) throw new InvalidOperationException("实际镜头与所选视角不一致：" + view);
    var camera = World.world.camera;
    Vector3 position = camera.transform.position;
    return new { firstPerson, attached, godView, godAlpha,
        mapPosition = new[] { position.x, position.y, position.z }, mapZoom = camera.orthographicSize };
}

/// <summary>固定普通观察视角，所有法术使用同一尺度便于比较。</summary>
private void Camera()
{
    if (externalView != null && (string)request["view"] == "firstperson" &&
        (bool)externalView.GetProperty("IsFirstPerson", Flags).GetValue(externalViewInstance)) return;
    bool body = request["construction"]?["Body"] is JObject;
    if (externalView != null && (WantsBodyCloseView() || body && (float?)request["zoom"] < 10f) &&
        (bool)externalView.GetProperty("GodShown", Flags).GetValue(externalViewInstance)) return;
    bool placement = request["construction"] is JObject && request["targetOffset"] is JArray;
    float zoom = (float?)request["zoom"] ?? 22;
    if (currentCase == "Cultiway.PalmStrike")
        World.world.camera.transform.position = new Vector3(caster.current_position.x + .3f,
            caster.current_position.y + .5f, World.world.camera.transform.position.z);
    else if (currentCase == "Cultiway.SummonRainCloud")
    {
        // 原版云层画在地面上方并继续移动，放宽该段镜头，保留施法点和云。
        Vector2 point = request["aimOffset"] is JArray aim
            ? caster.current_position + new Vector2((float)aim[0], (float)aim[1]) : enemies[0].current_position;
        World.world.camera.transform.position = new Vector3(point.x + 4f, point.y + 9f, World.world.camera.transform.position.z);
        zoom = Mathf.Max(zoom, 21f);
    }
    else if (request["casterPosition"] is JArray start)
        World.world.camera.transform.position = new Vector3((float)start[0] + 3f,
            (float)start[1] + 1f, World.world.camera.transform.position.z);
    else
        World.world.camera.transform.position = new Vector3(
            placement ? caster.current_position.x : body ? 66.5f : 67,
            placement ? caster.current_position.y : body ? 72.5f : 73, World.world.camera.transform.position.z);
    MoveCamera.instance.forceZoom(zoom);
    // 原版滚轮最小为10；开发指定的更近取景不改游戏配置，只覆盖当前测试相机。
    if (zoom < 10f)
    {
        World.world.camera.orthographicSize = zoom;
        World.world.setZoomOrthographic(zoom);
    }
}

/// <summary>同步人物坐标与所在格子。</summary>
/// <param name="actor">人物。</param>
/// <param name="x">横坐标。</param>
/// <param name="y">纵坐标。</param>
private static void Place(Actor actor, float x, float y)
{
    actor.stopMovement();
    if (actor.under_forces) actor.stopForce();
    actor.current_position = new Vector2(x, y);
    actor.setCurrentTile(World.world.GetTileSimple((int)x, (int)y));
    actor.updatePos();
}

/// <summary>优先采用中文本地化，内部实体保留可搜索的稳定编号。</summary>
/// <param name="id">稳定编号。</param>
private static string Name(string id)
{
    if (id.StartsWith("Cultiway.CoreFormation.Skill."))
        return id.Substring("Cultiway.CoreFormation.Skill.".Length) switch
        {
            "IronSeverance" => "金煞破锋", "WoodVenomBloom" => "青木毒息", "WoodLifeReturn" => "青木回生",
            "WaterFrostBind" => "寒流叠封", "FireBrand" => "焚烬火印", "FireEmberBurst" => "焚烬爆燃",
            "EarthWard" => "厚土结界", "EarthWardImpact" => "厚土反震", "YinDrain" => "阴气汲灵",
            "MysteriousYinDrain" => "玄阴汲灵", "YangCleanse" => "阳气涤秽", "PureYangCleanse" => "纯阳涤秽",
            "ChaosEcho" => "混沌回响", "ChaosRebirthEcho" => "归墟回响", "BalancedAdaptation" => "混元适应",
            "ReservoirOrb" => "灵渊储备", "CondensedRelease" => "凝元释放", "SpiritEcho" => "灵台回响",
            "SwordChase" => "剑气追击", "SwordEmbryoStrike" => "剑胎追击", "BodyCounter" => "真形反震",
            "PrimalBodyCounter" => "真身反震", "IllusionDecoy" => "幻身替劫", "DragonMight" => "龙威震荡",
            "DragonAspectMight" => "龙相威压", "InfantGuard" => "灵婴护命", "ChaosRebirth" => "归墟再生",
            "FivePhaseStrike" => "五相追击", "SwordEmbryoAura" => "剑胎显锋", "DragonAspectBurst" => "龙相震击",
            "SpiritPlatform" => "灵台显神", "PrimalBody" => "真身镇劫", "FivePhase" => "五相轮转",
            "PureYangDomain" => "纯阳净域", "MysteriousYinDomain" => "玄阴寒域", _ => id
        };
    if (id.EndsWith("BalefulWindTribulationCenter")) return "罡风天劫·风柱";
    if (id.EndsWith("BalefulWindTribulationWave")) return "罡风天劫·风浪";
    return id.Localize();
}

/// <summary>每段记录实际运行的程序集和产生该报告的请求。</summary>
private void WriteResult(string path, object value)
{
    var report = JObject.FromObject(value);
    report["requestId"] = handled;
    report["runtime"] = JObject.FromObject(CultiwayDemoRuntime.Loaded());
    report["processId"] = System.Diagnostics.Process.GetCurrentProcess().Id;
    Write(path, report);
}

/// <summary>完整落盘后替换，避免录制工具读到半份报告。</summary>
private static void Write(string path, object value)
{
    string temporary = path + ".tmp";
    File.WriteAllText(temporary, JsonConvert.SerializeObject(value, Formatting.Indented));
    if (File.Exists(path)) File.Replace(temporary, path, null);
    else File.Move(temporary, path);
}

/// <summary>卸载临时工具时解除订阅。</summary>
private void OnDestroy()
{
    Application.logMessageReceived -= OnLog;
    Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured -= OnSpawn;
    SkillHitResolver.ContactResolved -= OnContact;
    SkillHitResolver.AreaResolved -= OnArea;
    SkillHitResolver.BarrierContactResolved -= OnBarrier;
}

/// <summary>按来源条件建立结婴显化，主动护持读取真实形成状态。</summary>
/// <param name="owner">演示人物。</param>
/// <param name="id">来源技能编号。</param>
private static void PrepareFormation(ActorExtend owner, string id)
{
    var atoms = id.Contains("Sword") ? new[] { CoreFormationAtoms.ManifestSwordEmbryo } :
        id.Contains("Dragon") ? new[] { CoreFormationAtoms.ManifestDragonAspect } :
        id.Contains("Spirit") ? new[] { CoreFormationAtoms.ManifestSpiritPlatform } :
        id.Contains("Body") ? new[] { CoreFormationAtoms.ManifestPrimalBody } :
        id.Contains("FivePhase") ? new[] { CoreFormationAtoms.TransformFivePhase } :
        id.Contains("Yang") ? new[] { CoreFormationAtoms.TransformPureYang } :
        id.Contains("Yin") ? new[] { CoreFormationAtoms.TransformMysteriousYin } :
        Array.Empty<CoreFormationAtomAsset>();
    var formation = new CoreFormationSnapshot
    {
        version = CoreFormationSnapshot.CurrentVersion, signature = "spell-demo." + id, canonical_name = "演示来源",
        finalized = true, realm = CoreFormationRealm.Yuanshen, strength = 4, refinement = 4,
        quality = new ItemLevel { Stage = 2, Level = 3 }, quality_score = .6f,
        atoms = atoms.Select(atom => new CoreFormationAtomState
            { atom_id = atom.id, weight = 1, awakening_stage = 0 }).ToArray(),
        stats = Array.Empty<CoreFormationStatValue>(), semantics = Array.Empty<SemanticContribution>(),
        composition = ElementComposition.Static.Fire
    };
    owner.AddComponent(new Yuanshen
        { formation = formation, original_body = new PhysicalBodySnapshot { actor_asset_id = "human" } });
    CoreFormationEffectResolver.Synchronize(owner);
}

/// <summary>正式物化并装备法宝，能力参数由当前定义计算，不手工调用特效。</summary>
/// <param name="owner">演示人物。</param>
/// <param name="id">法宝能力编号。</param>
private void PrepareArtifact(ActorExtend owner, string id)
{
    var asset = Cultiway.Content.Libraries.Manager.ArtifactAbilityLibrary.get(id);
    var atoms = typeof(ArtifactAtoms).GetProperties(Flags)
        .Where(property => property.PropertyType == typeof(ArtifactAtomAsset))
        .Select(property => new ArtifactAtomSelection((ArtifactAtomAsset)property.GetValue(null), 2f))
        .ToArray();
    var level = new ItemLevel { Stage = 2, Level = 3 };
    var recipe = ArtifactMaterialSemantics.BuildDesign(level, atoms.Length);
    ArtifactMaterialSemantics.ApplyAtoms(recipe, atoms);
    var compose = new ArtifactAbilityComposeContext
    {
        recipe = recipe, atoms = atoms, composition_key = "法术演示", scales = ArtifactAbilityScales.Resolve(recipe)
    };
    var shapes = typeof(ItemShapes).GetProperties(Flags)
        .Where(property => property.PropertyType == typeof(ArtifactShapeAsset))
        .Select(property => (ArtifactShapeAsset)property.GetValue(null)).ToArray();
    // 专用能力使用其真实器形；通用能力才按评分选择，避免相同评分始终选中剑。
    string family = typeof(ArtifactAbilities).GetProperties(Flags)
        .Where(property => property.PropertyType == typeof(ArtifactAbilityAsset))
        .Single(property => property.GetValue(null) == asset).Name;
    string shapeName = family switch
    {
        "SoulShakingChime" or "PurifyingChime" or "GoldenBellBarrier" => "Bell",
        "MountainSealFall" or "SpellBanningEdict" or "MeridianSealing" => "Seal",
        "MyriadSoulBannerArray" or "CommandingBannerField" or "SpiritHostManifestation" => "Banner",
        "SpellReflection" or "TruthRevealingMirror" or "SoulCapturingStasis" => "Mirror",
        "CloudRobeShield" or "HeavenlyConcealment" or "DamageDiversion" => "Robe",
        "TreasureTowerPrison" or "LayeredRealmWard" or "TowerShadowProjection" => "Tower",
        "HeavenSwallowingGourd" or "SpiritGourdReserve" or "FiveEssenceOutpouring" => "Gourd",
        "GaleFanSweep" or "DepartingFireFan" or "CleansingWindFan" => "Fan",
        "DingFireRefinement" or "DevouringReturn" or "HundredRefinementCore" => "Ding",
        "CelestialPearlGuard" or "FivePhasePearlStrike" or "LinkedPearlResonance" => "Pearl",
        _ => null
    };
    var shape = shapeName != null
        ? (ArtifactShapeAsset)typeof(ItemShapes).GetProperty(shapeName, Flags).GetValue(null)
        : shapes.OrderByDescending(value =>
        {
            compose.shape = value;
            return asset.ScoreFor(compose);
        }).First();
    compose.shape = shape;
    var chosen = atoms.OrderByDescending(atom =>
    {
        var single = ArtifactMaterialSemantics.BuildDesign(level, 1);
        ArtifactMaterialSemantics.ApplyAtoms(single, new[] { atom });
        compose.recipe = single;
        compose.atoms = new[] { atom };
        return asset.ScoreFor(compose);
    }).Take(3).Select(value => new ArtifactAtomSelection(value.Atom, 1f)).ToArray();
    recipe = ArtifactMaterialSemantics.BuildDesign(level, chosen.Length);
    ArtifactMaterialSemantics.ApplyAtoms(recipe, chosen);
    compose.recipe = recipe;
    compose.atoms = chosen;
    compose.scales = ArtifactAbilityScales.Resolve(recipe);
    var design = ArtifactComposer.ComposeDesign(new ArtifactDesignRequest
    {
        Shape = shape, Level = level,
        Atoms = chosen.Select(value => value.Atom).ToArray(), Name = Name(id)
    });
    var blueprint = ArtifactBlueprintCodec.FromComposeResult(design);
    var instance = new ArtifactAbilityInstance
    {
        instance_id = id, ability_id = id,
        parameters = asset.ComposeParameters?.Invoke(compose) ?? Array.Empty<ArtifactAbilityValue>(),
        initial_state = asset.ComposeInitialState?.Invoke(compose) ?? Array.Empty<ArtifactAbilityValue>()
    };
    blueprint.AbilitySet = new ArtifactAbilitySet { abilities = new[] { instance } };
    artifactDetails = new
    {
        shape = shape.id, materials = chosen.Select(value => value.Atom.id).ToArray(),
        parameters = instance.parameters,
        parameterSource = "与器形及选用材料共同计算；演示仅保留被选能力"
    };
    artifact = ArtifactBlueprintCodec.Materialize(blueprint, caster.getName());
    owner.AddSpecialItem(artifact);
    if (!owner.EquipArtifact(artifact, locked: true, mode: ArtifactEquipMode.ForcedOperating, priority: 100))
        throw new InvalidOperationException("无法装备演示法宝：" + id);
    ArtifactLoadoutPlanner.Refresh(owner, false, 0);
    var handles = new List<ActiveAbilityHandle>();
    ActiveAbilityService.Collect(owner, handles);
    ability = handles.Single(handle => handle.Source == artifact && handle.EntryId == id);
}
    }
