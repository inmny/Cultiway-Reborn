// 仅由 DebugToolbox 临时安装；不加入 Source，不随模组发布，也不写玩家存档。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Friflo.Engine.ECS;
using DebugToolbox.Runtime.Scripting;
using Cultiway.Content;
using Cultiway.Content.Components;
using Cultiway.Content.Combat;
using Cultiway.Content.Artifacts;
using Cultiway.Content.Artifacts.Baibao;
using Cultiway.Content.Extensions;
using Cultiway.Content.KnightCombat;
using Cultiway.Content.Libraries;
using Cultiway.Core;
using Cultiway.Core.Combat.Tactical;
using Cultiway.Core.Components;
using Cultiway.Core.Semantics;
using Cultiway.Core.SkillLibV3;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Blueprints;
using Cultiway.Core.SkillLibV3.Components;
using Cultiway.Core.SkillLibV3.Components.TrajParams;
using Cultiway.Core.SkillLibV3.Editor;
using Cultiway.Core.SkillLibV3.Effects;
using Cultiway.Core.SkillLibV3.Utils;
using Cultiway.Core.SkillLibV3.Usage;
using Cultiway.Utils.Extension;
using Cultiway.Core.Visuals.Forms;
using Cultiway.Core.Skills;
using Cultiway.Content.Skills;

foreach (var old in Resources.FindObjectsOfTypeAll<MonoBehaviour>().Where(item => item != null && item.GetType().Name == "CultiwaySpellDemoRunner"))
{
    if ((bool)old.GetType().GetField("busy", BindingFlags.Instance | BindingFlags.NonPublic).GetValue(old))
        throw new InvalidOperationException("已有演示正在录制，请先等待完成或结束上一条命令");
    UnityEngine.Object.DestroyImmediate(old.gameObject);
}
var host = new GameObject("Cultiway.SpellDemo.Tool");
UnityEngine.Object.DontDestroyOnLoad(host);
var runner = host.AddComponent<CultiwaySpellDemoRunner>();
runner.Install();
return new { installed = true, catalog = runner.Root + "/catalog.json" };

/// <summary>单次安装后轮询本地请求，逐招录制；不为每招重复编译调试程序集。</summary>
public sealed class CultiwaySpellDemoRunner : MonoBehaviour
{
    /// <summary>请求与清单所在目录。</summary>
    public string Root;
    /// <summary>当前运行请求。</summary>
    private JObject request;
    /// <summary>已处理的请求编号，安装时忽略磁盘上的旧请求。</summary>
    private string handled;
    /// <summary>本次运行输出目录。</summary>
    private string output;
    /// <summary>错误时保留正在处理的稳定编号。</summary>
    private string currentCase;
    /// <summary>是否正在录制。</summary>
    private bool busy;
    /// <summary>下次检查请求的实际时间。</summary>
    private float nextPoll;
    /// <summary>准备和录制过程中出现的真实错误。</summary>
    private readonly List<string> errors = new();
    /// <summary>演示人物。</summary>
    private Actor caster;
    /// <summary>受伤友军。</summary>
    private Actor friend;
    /// <summary>用于弹丸、范围与连锁的敌军。</summary>
    private readonly List<Actor> enemies = new();
    /// <summary>冻结世界背景人物，避免长时间遍历时走入演示场地。</summary>
    private readonly HashSet<long> isolated = new();
    /// <summary>来源专属技能的原始容器，保留其真实回调和消耗。</summary>
    private readonly Dictionary<string, Entity> granted = new();
    /// <summary>本轮演示用临时技能容器。</summary>
    private Entity temporarySkill;
    /// <summary>等最后一个执行体消散后才释放的临时容器。</summary>
    private readonly List<Entity> retiringSkills = new();
    /// <summary>当前法术的实际生成次数。</summary>
    private int spawned;
    /// <summary>当前观察的技能容器。</summary>
    private Entity observed;
    /// <summary>录制前的界面状态。</summary>
    private bool previousHidden;
    /// <summary>只在录制期间隐藏画布，结束时恢复原状态。</summary>
    private readonly Dictionary<Canvas, bool> canvases = new();
    /// <summary>本招正在使用的真实法宝。</summary>
    private Entity artifact;
    /// <summary>本招真实采用的器形、材质与能力参数。</summary>
    private object artifactDetails;
    /// <summary>本段所有真实出手、接触和范围结算，独立于装饰模型计数。</summary>
    private readonly List<object> executionLog = new();
    private readonly List<object> contactsLog = new();
    private readonly List<object> areasLog = new();
    /// <summary>本段实际屏障接触和空间数据，供核对长轴、厚度与半径。</summary>
    private readonly List<object> barrierLog = new();
    private readonly Dictionary<int, object> footprints = new();
    /// <summary>逐帧收集可疑黄色精灵，供定位方块来源，不在录像时隐藏它们。</summary>
    private readonly HashSet<string> yellowObjects = new();
    private readonly List<(ActorExtend Owner, Entity Skill)> learnedForBattle = new();
    private Entity incomingSkill;
    private bool probeUsed;
    private float barrierBefore, barrierLowest;
    private Type externalView;
    private object externalViewInstance;
    /// <summary>本招法宝或战技的正式能力句柄。</summary>
    private ActiveAbilityHandle ability;
    /// <summary>正在展示的骑士战技。</summary>
    private KnightTechniqueAsset technique;
    /// <summary>公共及内部成员查询。</summary>
    private const BindingFlags Flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static | BindingFlags.Instance;

    /// <summary>导出游戏中当前实际注册的技能与兼容项目。</summary>
    public void Install()
    {
        Root = Path.Combine(Cultiway.ModClass.I.GetDeclaration().FolderPath, "artifacts/spell_demo");
        Directory.CreateDirectory(Root);
        string selection = Path.Combine(Root, "request.json");
        handled = File.Exists(selection) ? (string)JObject.Parse(File.ReadAllText(selection))["id"] : null;
        var assembly = typeof(Cultiway.ModClass).Assembly;
        var core = assembly.GetType("Cultiway.Content.CoreFormationSkills", true);
        foreach (var property in core.GetProperties(Flags).Where(property => property.PropertyType == typeof(Entity)))
        {
            Entity entity = (Entity)property.GetValue(null);
            if (entity.IsAvailable() && entity.TryGetComponent(out SkillContainer skill)) granted[skill.Asset.id] = entity;
        }
        var mod = Cultiway.ModClass.I;
        var modifiers = mod.SkillV3.ModifierLib.list.Where(asset => asset.EditorSelectable && !asset.IsDisabled).ToArray();
        var trajectories = mod.SkillV3.TrajLib.list.Where(asset => asset.EditorSelectable).ToArray();
        var rows = new List<object>();
        foreach (var asset in mod.SkillV3.SkillLib.list.OrderBy(asset => asset.id, StringComparer.Ordinal))
        {
            if (asset.Animations.Count == 0 ||
                asset.id == "Cultiway.raw_anim" || !asset.CanBeLearned && !granted.ContainsKey(asset.id) && !asset.id.Contains("BalefulWindTribulation")) continue;
            string trajectory = SkillBlueprintTrajectory.ResolveDefaultId(asset);
            SkillBlueprint blueprint = Blueprint(asset, 0, trajectory);
            var context = SkillEditContext.Create(blueprint);
            bool adjustable = asset.CanBeLearned && asset.EditorSelectable;
            rows.Add(new
            {
                id = asset.id, name = Name(asset.id), variants = asset.Animations.Count,
                group = granted.ContainsKey(asset.id) ? "金丹元婴" : asset.id.Contains("BalefulWindTribulation") ? "天劫" : asset.id.StartsWith("Cultiway.KnightTechnique.") ? "骑士战技" : "基础法术",
                adjustable, trajectory, relation = asset.UseProfile.TargetRelation.ToString(),
                trajectories = trajectories.Where(item => item.CheckEditorCompatibility(context, false).IsCompatible &&
                    SkillTrajectoryCompatibility.IsCompatible(asset, item)).Select(item => item.id).ToArray(),
                modifiers = modifiers.Where(item => item.CheckEditorCompatibility(context, item.CreateDefaultSpec()).IsCompatible)
                    .Select(item => item.id).ToArray()
            });
        }
        foreach (var asset in Cultiway.Content.Libraries.Manager.ArtifactAbilityLibrary.list.Where(asset => asset.active_use != null).OrderBy(asset => asset.id))
            rows.Add(new { id = asset.id, name = Name(asset.id), variants = 1, group = "法宝主动", adjustable = false,
                trajectory = "专属动作", relation = asset.active_use.target_mode.ToString(), trajectories = Array.Empty<string>(), modifiers = Array.Empty<string>() });
        rows.Add(new { id = "Cultiway.PalmStrike", name = Name("Cultiway.PalmStrike"), variants = 1, group = "近身掌击", adjustable = false,
            trajectory = "身体接触", relation = "Hostile", trajectories = Array.Empty<string>(), modifiers = Array.Empty<string>() });
        Write(Path.Combine(Root, "catalog.json"), new
        {
            generatedAt = DateTime.UtcNow,
            processStarted = (System.Diagnostics.Process.GetCurrentProcess().StartTime.ToUniversalTime() - new DateTime(1970, 1, 1)).TotalSeconds,
            assembly = typeof(Cultiway.ModClass).Assembly.ManifestModule.ModuleVersionId.ToString(), spells = rows,
            modifiers = modifiers.Select(item => new { id = item.id, name = Name(item.id), parameters = item.CreateDefaultSpec().Parameters }).ToArray(),
            trajectories = trajectories.Select(item => new { id = item.id, name = Name(item.id) }).ToArray()
        });
        WriteMigrationInventory(rows);
    }

    /// <summary>导出实际全部登记及引用，不把可录像项目等同于全部能力。</summary>
    /// <param name="demoRows">现有演示能直接覆盖的项目。</param>
    private void WriteMigrationInventory(List<object> demoRows)
    {
        var mod = Cultiway.ModClass.I;
        var demoIds = new HashSet<string>(demoRows.Select(row => (string)JObject.FromObject(row)["id"]));
        var entries = new List<object>();
        var references = new List<object>();
        foreach (var asset in mod.SkillV3.SkillLib.list.OrderBy(item => item.id, StringComparer.Ordinal))
        {
            entries.Add(new
            {
                key = "skill:" + asset.id, id = asset.id, name = Name(asset.id), kind = "技能资产",
                variants = asset.Animations.Count, learnable = asset.CanBeLearned,
                editable = asset.EditorSelectable, demo = demoIds.Contains(asset.id),
                source = granted.ContainsKey(asset.id) ? "修炼专属" : asset.id.StartsWith("Cultiway.KnightTechnique.") ? "骑士战技" :
                    asset.id.Contains("Tribulation") ? "天劫" : asset.CanBeLearned ? "可学习法术" : "内部或专属",
                execution = "Cultiway.Core.SkillLibV3.Manager", persistence = "WorldObjectSaveService",
                trajectory = SkillBlueprintTrajectory.ResolveDefaultId(asset), carrier = asset.CarrierRequirement.ToString(),
                callbacks = InventoryCallbacks(asset), migration = "待实施"
            });
        }
        var handlersField = typeof(ArtifactAbilityAsset).GetField("_handlers", Flags);
        foreach (var asset in Cultiway.Content.Libraries.Manager.ArtifactAbilityLibrary.list.OrderBy(item => item.id))
        {
            var handlers = (IDictionary)handlersField.GetValue(asset);
            entries.Add(new
            {
                key = "artifact:" + asset.id, id = asset.id, name = asset.GetName(), kind = "法宝能力",
                active = asset.active_use != null, demo = demoIds.Contains(asset.id),
                events = handlers.Keys.Cast<Type>().Select(type => type.FullName).OrderBy(value => value).ToArray(),
                callbacks = InventoryCallbacks(asset.active_use).Concat(InventoryCallbacks(asset.lifecycle)).ToArray(),
                parameters = asset.parameter_schema.Select(item => item.key).ToArray(),
                execution = "ArtifactAbilityDispatcher", persistence = "ArtifactAbilityInstance", migration = "待实施"
            });
        }
        foreach (var technique in KnightTechniqueCatalog.All)
        {
            entries.Add(new
            {
                key = "technique:" + technique.id, id = technique.id, name = technique.ResolveName(), kind = "战技定义",
                style = technique.Style.id, weapons = technique.Style.WeaponGroups,
                callbacks = InventoryCallbacks(technique.ActiveUse), execution = "KnightTechniqueAbilityProvider",
                persistence = "KnightTechniqueSkills.TryRestoreSavedContainer", migration = "待实施"
            });
            references.Add(new { owner = "technique:" + technique.id, target = "skill:" + technique.id + ".Execution", role = "专用执行" });
        }
        foreach (var rank in Cultiway.Content.Libraries.Manager.CreatureOrganRankLibrary.list.OrderBy(item => item.id))
        {
            entries.Add(new
            {
                key = "organ:" + rank.id, id = rank.id, name = rank.id.Localize(), kind = "器官等级",
                skills = rank.SkillContainerIds, effects = rank.EffectRanks.Select(item => new { id = item.EffectFamilyId, rank = item.Rank }).ToArray(),
                upkeep = new { resource = rank.UpkeepDescriptor.ResourceId, amount = rank.UpkeepDescriptor.AmountPerWorldMonth },
                execution = "CreaturePhenotypeActiveAbilityProvider", persistence = "CreatureComposition", migration = "待实施"
            });
            foreach (string id in rank.SkillContainerIds)
                references.Add(new { owner = "organ:" + rank.id, target = "skill:" + id, role = "器官出手" });
            foreach (var effect in rank.EffectRanks)
                references.Add(new { owner = "organ:" + rank.id, target = "effect:" + effect.EffectFamilyId, role = "器官被动" });
        }
        var families = (IDictionary)typeof(Cultiway.Content.CreatureCompositions.Combat.CreatureOrganEffectFamilies)
            .GetField("families", Flags).GetValue(null);
        foreach (DictionaryEntry item in families)
        {
            var family = (Cultiway.Content.CreatureCompositions.Combat.CreatureOrganEffectFamily)item.Value;
            entries.Add(new { key = "effect:" + family.Id, id = family.Id, name = family.Id.Localize(), kind = "器官被动效果",
                events = family.Events.ToString(), execution = family.Handler.Method.DeclaringType.FullName + "." + family.Handler.Method.Name,
                persistence = "CreatureComposition.EffectRanks", migration = "待实施" });
        }
        foreach (var asset in Cultiway.ModClass.L.StatusEffectLibrary.list.Where(item => !item.id.StartsWith("Cultiway.SpellDemo.")).OrderBy(item => item.id))
        {
            entries.Add(new
            {
                key = "status:" + asset.id, id = asset.id, name = asset.id.Localize(), kind = "状态定义",
                callbacks = InventoryCallbacks(asset), execution = "StatusEffectAsset", persistence = "原版人物状态及模组状态资料", migration = "待实施"
            });
        }
        var assembly = typeof(Cultiway.ModClass).Assembly;
        Type goals = assembly.GetType("Cultiway.Content.CollectiveProjects.CityMagicUtilityProjectGoal", true);
        Type ids = assembly.GetType("Cultiway.Content.CollectiveProjects.CityMagicUtilityProjectIds", true);
        foreach (string name in Enum.GetNames(goals))
        {
            string id = (string)ids.GetField(name, Flags).GetValue(null);
            entries.Add(new { key = "utility:" + id, id, name, kind = "城市功能工程",
                execution = "CityMagicUtilityProjectPlanner / CityMagicUtilityProjectExecutor",
                persistence = "CollectiveProjectWorldSave", migration = "待实施" });
        }
        entries.Add(new { key = "body:Cultiway.PalmStrike", id = "Cultiway.PalmStrike", name = "近身掌击", kind = "身体动作",
            execution = "PalmStrikeCombat → ConstructedAbilityService", persistence = "瞬时动作不恢复；借用身体结束解除控制", demo = true, migration = "首轮身体构造已接入，动作与美术继续完善" });
        var constructions = (IDictionary)typeof(ConstructedAbilityService).GetField("definitions", Flags).GetValue(null);
        foreach (AbilityDefinition definition in constructions.Values.Cast<AbilityDefinition>().OrderBy(value=>value.Id))
        {
            entries.Add(new { key="construction:"+definition.Id,id=definition.Id,name=definition.Name,kind="构造资料",
                execution="ConstructedAbilityService",persistence="ability_constructions / ability_knowledge",
                demo=false,migration=definition.Body==null?"首轮形体构造已接入；使用 --construction 演示":"已接入共同身体、持物及作用；使用 --construction 演示" });
        }
        Write(Path.Combine(Root, "inventory.json"), new
        {
            schema = 1, generatedAt = DateTime.UtcNow, assembly = typeof(Cultiway.ModClass).Assembly.ManifestModule.ModuleVersionId,
            environment = new { game = Application.version, unity = Application.unityVersion,
                system = SystemInfo.operatingSystem, cpu = SystemInfo.processorType, graphics = SystemInfo.graphicsDeviceName,
                memoryMb = SystemInfo.systemMemorySize, processors = SystemInfo.processorCount,
                worldfall = AppDomain.CurrentDomain.GetAssemblies().FirstOrDefault(item => item.GetType("FirstPerson.WorldBoxMod", false) != null)?.GetName().Version?.ToString() },
            entries, references,
            sourceEntrances = ((IEnumerable<IActiveAbilityProvider>)typeof(ActiveAbilityService).GetField("Providers", Flags).GetValue(null))
                .Select(provider => new { id = provider.Id, type = provider.GetType().FullName }).ToArray(),
            pending = new[] { "宗门设施及长期工程的实际触发引用", "运行对象及来源授予的完整保存对应" }
        });
    }

    /// <summary>只读取已登记委托的执行入口，不执行回调或递归序列化游戏对象。</summary>
    /// <param name="value">含委托字段的资料对象。</param>
    private static string[] InventoryCallbacks(object value) => value == null ? Array.Empty<string>() : value.GetType().GetFields(Flags)
        .Where(field => typeof(Delegate).IsAssignableFrom(field.FieldType)).Select(field => (Delegate)field.GetValue(value))
        .Where(callback => callback != null).SelectMany(callback => callback.GetInvocationList())
        .Select(callback => callback.Method.DeclaringType.FullName + "." + callback.Method.Name).Distinct().OrderBy(item => item).ToArray();

    /// <summary>接收新的本地运行请求。</summary>
    private void Update()
    {
        if (busy || Time.realtimeSinceStartup < nextPoll) return;
        nextPoll = Time.realtimeSinceStartup + .3f;
        string path = Path.Combine(Root, "request.json");
        if (!File.Exists(path)) return;
        var selected = JObject.Parse(File.ReadAllText(path));
        if ((string)selected["id"] == handled) return;
        request = selected; handled = (string)selected["id"]; output = (string)selected["output"];
        busy = true; previousHidden = Config.ui_main_hidden;
        Application.logMessageReceived += OnLog;
        Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured += OnSpawn;
        SkillHitResolver.ContactResolved += OnContact;
        SkillHitResolver.AreaResolved += OnArea;
        SkillHitResolver.BarrierContactResolved += OnBarrier;
        ConstructedAbilityService.CastStarted += OnConstructedStart;
        ConstructedAbilityService.ContactConfirmed += OnConstructedContact;
        ConstructedAbilityService.ClashConfirmed += OnConstructedClash;
        StartCoroutine(Guarded((string)request["action"] == "resources" ? ProbeFormResources() :
            (string)request["action"] == "construction" ? RecordConstruction() : Run()));
    }

    /// <summary>在请求边界记录错误，保证暂停、界面和事件订阅有明确收尾。</summary>
    /// <param name="steps">当前演示流程。</param>
    private IEnumerator Guarded(IEnumerator steps)
    {
        string failure = null;
        while (true)
        {
            bool more;
            try { more = steps.MoveNext(); }
            catch (Exception error) { failure = error.ToString(); break; }
            if (!more) break;
            yield return steps.Current;
        }
        Config.paused = true;
        Config.ui_main_hidden = previousHidden;
        CleanExecutions();
        ControllableUnit.clear(false);
        foreach (var canvas in canvases) if (canvas.Key != null) canvas.Key.enabled = canvas.Value;
        canvases.Clear();
        Application.logMessageReceived -= OnLog;
        Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured -= OnSpawn;
        SkillHitResolver.ContactResolved -= OnContact;
        SkillHitResolver.AreaResolved -= OnArea;
        SkillHitResolver.BarrierContactResolved -= OnBarrier;
        ConstructedAbilityService.CastStarted -= OnConstructedStart;
        ConstructedAbilityService.ContactConfirmed -= OnConstructedContact;
        ConstructedAbilityService.ClashConfirmed -= OnConstructedClash;
        FormVisualScene.Clear();
        Write(Path.Combine(output, "status.json"), new { done = true, current = currentCase, error = failure, errors });
        busy = false;
    }

    /// <summary>复用正式资源和两个绘制入口验证模型接入；没有伤害或自主创法验收含义。</summary>
    private IEnumerator ProbeFormResources()
    {
        var loading = LoadScene();
        while (loading.MoveNext()) yield return loading.Current;
        JObject item = (JObject)((JArray)request["cases"])[0];
        Prepare(item);
        var hold = Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.SpellDemo.Background");
        foreach (Actor actor in World.world.units.getSimpleList())
        {
            CombatStatusEffects.ApplyStatus(actor, hold, 10000, actor);
            actor.clearAttackTarget(); actor.setStatsDirty(); actor.updateStats(); Place(actor, 12, 12);
        }
        Camera();
        if (externalView != null)
        {
            var entering = EnterView();
            while (entering.MoveNext()) yield return entering.Current;
        }
        currentCase = (string)item["id"];
        string folder = Path.Combine(output, (string)item["key"]);
        Directory.CreateDirectory(Path.Combine(folder, "frames"));
        FormResource sword = FormResources.Load("sword"), branch = FormResources.Load("branch");
        var resources = new[] { sword, branch, sword, branch };
        var surfaces = new[] { null, null, "water", "ice" };
        var times = new List<double>();
        double start = World.world.getCurWorldTime(), duration = (double)request["duration"], next = 0;
        Config.paused = false;
        while (World.world.getCurWorldTime() - start < duration)
        {
            double elapsed = World.world.getCurWorldTime() - start;
            var instances = new FormVisualInstance[resources.Length];
            for (int index = 0; index < instances.Length; index++)
            {
                float phase = (float)elapsed;
                Matrix4x4 transform = Matrix4x4.TRS(new Vector3(58 + index * 6, 71, 1.5f),
                    Quaternion.Euler(Mathf.Sin(phase + index) * 14f, Mathf.Cos(phase * .8f) * 20f, Mathf.Sin(phase * .6f) * 18f), Vector3.one * 2.5f);
                var parts = new Matrix4x4[resources[index].Meshes.Length];
                for (int part = 0; part < parts.Length; part++)
                {
                    float[] p = resources[index].Description.Parts[part].Pivot;
                    Vector3 pivot = new(p[0], p[1], p[2]);
                    parts[part] = Matrix4x4.Translate(pivot) * Matrix4x4.Rotate(Quaternion.Euler(0, Mathf.Sin(phase * 1.4f + part) * (index % 2 == 1 ? 7f : 0f), 0)) * Matrix4x4.Translate(-pivot);
                }
                instances[index] = new FormVisualInstance(resources[index], transform, parts, surfaces[index]);
            }
            FormVisualScene.Publish(instances);
            Camera();
            if (elapsed >= next)
            {
                times.Add(elapsed);
                new ScreenFacade().Capture(Path.Combine(folder, "frames", (times.Count - 1).ToString("00000") + ".png"));
                next = elapsed + 1d / (int)request["fps"];
                Write(Path.Combine(output, "status.json"), new { done = false, current = item["key"], stage = "资源验证", elapsed, frames = times.Count });
            }
            yield return null;
        }
        Config.paused = true;
        Type bridge = typeof(Cultiway.ModClass).Assembly.GetType("Cultiway.Content.Compatibility.Worldfall.FormWorldfallRenderer", true);
        int submitted = (int)bridge.GetProperty("LastDrawCount", Flags).GetValue(null);
        Write(Path.Combine(folder, "result.json"), new
        {
            passed = times.Count > 0 && errors.Count == 0 && (externalView == null || submitted > 0),
            scene = "resources", validation = "仅验证资源读取及绘制提交，实际作用和美术需分别验收", item,
            frames = times.Count, times, duration, view = (string)request["view"], submitted,
            resources = new[] { sword, branch }.Select(form => new { id = form.Description.Id,
                parts = form.Meshes.Select(mesh => new { mesh.name, mesh.vertexCount, uv = mesh.uv.Length, normals = mesh.normals.Length }).ToArray(),
                anchors = form.Description.Anchors.Select(anchor => anchor.Id).ToArray(), contacts = form.Description.Contacts.Select(contact => contact.Id).ToArray() }).ToArray(), errors
        });
    }

    /// <summary>用完整构造资料登记、学习和实际施放，保留形体及作用来自相同状态的录像。</summary>
    /// <summary>正式交锋结果，录像不会用显示重叠替代真实损耗。</summary>
    private readonly List<object> clashesLog = new();

    /// <summary>记录已经确认的共同交锋、剩余作用量和实际位置。</summary>
    /// <param name="clash">正式确认的交锋事实。</param>
    private void OnConstructedClash(ConstructedClash clash) => clashesLog.Add(new
    { leftCast=clash.LeftCast,rightCast=clash.RightCast,leftSource=clash.LeftSource,rightSource=clash.RightSource,
        leftNode=clash.LeftNode,rightNode=clash.RightNode,leftAge=clash.LeftAge,rightAge=clash.RightAge,
        absorbed=clash.Absorbed,leftRemaining=clash.LeftRemaining,rightRemaining=clash.RightRemaining,
        point=new[]{clash.Position.x,clash.Position.y,clash.Position.z} });

    private IEnumerator RecordConstruction()
    {
        var loading = LoadScene();
        while (loading.MoveNext()) yield return loading.Current;
        JObject item = (JObject)((JArray)request["cases"])[0];
        currentCase = (string)item["id"]; Prepare(item); Place(caster, 60, 72);
        // 清场触发的原版倒塌和碎片先完成，避免它们混入待测招式。
        Config.paused = false;
        double settledAt = World.world.getCurWorldTime() + 1d;
        while (World.world.getCurWorldTime() < settledAt) yield return null;
        Config.paused = true;
        AbilityDefinition definition = request["construction"].ToObject<AbilityDefinition>();
        ConstructedAbilityService.Register(definition);
        var owner = caster.GetExtend(); ConstructedAbilityService.Learn(owner, definition.Id);
        if (definition.Resource == "vigor")
        {
            owner.E.RemoveComponent<Xian>();owner.AddComponent(new Knight { level=2,vigor=10000 });
        }
        if (definition.Body != null)
        {
            foreach (Actor actor in enemies) Place(actor, 12, 12);
            Actor original = enemies[0];
            var enemy = World.world.units.createNewUnit("human", World.world.GetTileSimple(67,72), pAdultAge:true);
            enemy.setKingdom(original.kingdom); enemy.addTrait("super_health");
            CombatStatusEffects.ApplyStatus(enemy, Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.SpellDemo.Hold"),10000,enemy);
            enemy.setStatsDirty(); enemy.updateStats(); enemies[0] = enemy;
            if (enemy.GetExtend().HasComponent<Magic>()) enemy.GetExtend().E.RemoveComponent<Magic>();
            enemy.setMana(0); enemy.setStatsDirty(); enemy.updateStats();
            if (owner.HasComponent<Magic>()) owner.E.RemoveComponent<Magic>();
            if (definition.Body.WeaponForm != null)
                caster.equipment.setItem(World.world.items.generateItem(AssetManager.items.get("sword_iron"),pActor:caster),caster);
            Place(caster,66,72); PositionBodyTarget();
        }
        var handles = new List<ActiveAbilityHandle>(); ActiveAbilityService.Collect(owner, handles);
        var handle = handles.Single(value => value.ProviderId == "content.constructed" && value.EntryId == definition.Id);
        if (externalView != null)
        {
            var entering = EnterView(); while (entering.MoveNext()) yield return entering.Current;
            Place(caster, definition.Body == null ? 60 : 66, 72);
        }
        if (definition.Body != null)
        {
            foreach (Entity status in owner.GetStatuses().ToArray())
                if (status.GetComponent<StatusComponent>().Type.id == "Cultiway.SpellDemo.Hold") owner.RemoveSharedStatus(status);
            owner.MarkCultiwayStatsDirty(); caster.setStatsDirty(); caster.updateStats(); caster.attack_timer=0;
            caster.lookTowardsPosition(enemies[0].current_position);
            caster.flip_angle=caster.flip?180f:0f; caster.current_rotation=new Vector3(0,caster.flip_angle,0);
            caster.target_angle=caster.current_rotation; PositionBodyTarget(); Camera();
        }
        if (definition.Resource == "mana") { caster.stats["mana"]=10000;caster.setMana(10000); }
        if (definition.Resource == "stamina") { caster.stats["stamina"]=10000;caster.setStamina(10000); }
        CompiledAbility plan = AbilityCompiler.Compile(definition);
        Actor target = plan.Impact.Targets == Cultiway.Core.SkillLibV3.Usage.SkillUseTargetRelation.Self ? caster :
            plan.Impact.Targets == Cultiway.Core.SkillLibV3.Usage.SkillUseTargetRelation.Friendly ? friend : enemies[0];
        if (target == friend) Place(friend,enemies[0].current_position.x,enemies[0].current_position.y);
        if (plan.ContactForce > 0f)
        {
            var movable = Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.SpellDemo.ForceTarget");
            if (movable == null)
            {
                var stats = new BaseStats(); stats.addTag("frozen_ai");
                movable = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.ForceTarget").SetStats(stats).SetDuration(10000).Build();
            }
            foreach (Actor actor in enemies.Concat(new[]{friend}).Concat(target == caster ? new[]{caster} : Array.Empty<Actor>()))
            {
                CombatStatusEffects.RemoveStatus(actor,Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.SpellDemo.Hold"));
                CombatStatusEffects.ApplyStatus(actor,movable,10000,actor);
                actor.GetExtend().MarkCultiwayStatsDirty();actor.setStatsDirty();actor.updateStats();
            }
        }
        if (request["targetOffset"] is JArray offset)
            Place(target,caster.current_position.x+(float)offset[0],caster.current_position.y+(float)offset[1]);
        Vector2 casterStart = caster.current_position;
        float walk = (float?)request["casterWalk"] ?? 0f;
        if (walk != 0f)
        {
            CombatStatusEffects.RemoveStatus(caster,Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.SpellDemo.Hold"));
            owner.MarkCultiwayStatsDirty(); caster.setStatsDirty(); caster.updateStats();
        }
        Vector2 targetStart = target.current_position;
        AbilityDefinition opponent = request["opponentConstruction"]?.ToObject<AbilityDefinition>();
        bool opponentUsed = false; float opponentPaid = 0f;
        var rival = target.GetExtend();
        float OpponentBalance() => opponent.Resource switch
        { "none" => 0f, "wakan" => rival.GetCultisys<Xian>().wakan, "vigor" => rival.GetCultisys<Knight>().vigor,
            "mana" => target.getMana(), "stamina" => target.getStamina(), _ => throw new InvalidOperationException("未提供对手资源规则") };
        if (opponent != null)
        {
            if (target == caster || target == friend || opponent.Id == definition.Id) throw new InvalidOperationException("对手构造需要敌方目标及独立编号");
            ConstructedAbilityService.Register(opponent);
            if (opponent.Resource == "wakan")
            { if (!rival.HasCultisys<Xian>()) rival.AddComponent(new Xian { level=2,wakan=10000 }); else rival.GetCultisys<Xian>().wakan=10000; }
            if (opponent.Resource == "vigor")
            { rival.E.RemoveComponent<Xian>(); if (!rival.HasCultisys<Knight>()) rival.AddComponent(new Knight { level=2,vigor=10000 }); else rival.GetCultisys<Knight>().vigor=10000; }
            if (opponent.Resource == "mana") { target.stats["mana"]=10000;target.setMana(10000); }
            if (opponent.Resource == "stamina") { target.stats["stamina"]=10000;target.setStamina(10000); }
            ConstructedAbilityService.Learn(rival,opponent.Id); float rivalBefore = OpponentBalance();
            opponentUsed = ActiveAbilityService.TryUse(rival,new ActiveAbilityHandle("content.constructed",rival.E,opponent.Id),
                new ActiveAbilityTarget(caster,caster.GetSimPos()),ActiveAbilityUseOrigin.Script);
            opponentPaid = rivalBefore - OpponentBalance();
            if (!opponentUsed) throw new InvalidOperationException("对手构造正式入口拒绝施放");
        }
        float health = Health(target), before = Balance();
        bool used = ActiveAbilityService.TryUse(owner, handle, new ActiveAbilityTarget(target, target.GetSimPos()), ActiveAbilityUseOrigin.Script);
        float paid = before - Balance();
        if (!used) throw new InvalidOperationException("构造施放入口拒绝：" + ActiveAbilityService.ResolveControlState(owner, handle).BlockReason);
        // 手动单招完成后不再让原版自动普攻混入录像，正式准入及动作本身已经正常执行。
        if (definition.Body != null || walk != 0f) caster.attack_timer = 999f;
        Vector2 walkDestination = casterStart + new Vector2(walk,0f);
        var movePossessed = walk == 0f ? null : (Func<Actor,float,Vector2,float>)Delegate.CreateDelegate(
            typeof(Func<Actor,float,Vector2,float>),typeof(Actor).GetMethod("updatePossessedMovementTowards",Flags));
        long sourceId = caster.id, targetId = target.id;
        string folder = Path.Combine(output, (string)item["key"]); Directory.CreateDirectory(Path.Combine(folder, "frames"));
        var times = new List<double>(); double start = World.world.getCurWorldTime(), next = 0, lastWalk = 0;
        double duration = Math.Max((double)request["duration"], definition.Lifetime + .4);
        int peak = 0;
        var materialFrames = new List<object>();
        Config.paused = false;
        while (World.world.getCurWorldTime() - start < duration)
        {
            if (File.Exists(Path.Combine(Root, "cancel"))) throw new OperationCanceledException("已取消演示");
            double elapsed = World.world.getCurWorldTime() - start;
            if (movePossessed != null)
            {
                // 附体人物使用原版输入移动，先让形体成形；速度和阻挡仍由游戏计算。
                bool moving = elapsed > .35 && Vector2.Distance(caster.current_position,walkDestination) > .01f;
                caster.setPossessedMovement(moving);
                if (moving)
                {
                    movePossessed(caster,(float)Math.Max(0,elapsed-Math.Max(.35,lastWalk)),walkDestination);
                    caster.setCurrentTile(World.world.GetTileSimple((int)caster.current_position.x,(int)caster.current_position.y));
                    caster.updatePos();
                }
                lastWalk = elapsed;
            }
            Camera(); Tooltip.hideTooltipNow();
            peak = Math.Max(peak, FormVisualScene.Instances.Count);
            if (elapsed >= next)
            {
                times.Add(elapsed); new ScreenFacade().Capture(Path.Combine(folder, "frames", (times.Count - 1).ToString("00000") + ".png"));
                materialFrames.Add(new { time=elapsed,source=new[]{caster.current_position.x,caster.current_position.y},forms=FormVisualScene.Instances.Select(form=>new {
                    form=form.Resource.Description.Id,matter=form.Matter?.Id,state=form.Matter?.State,surface=form.SurfaceFor(0),
                    position=new[]{form.Transform.m03,form.Transform.m13,form.Transform.m23},
                    absoluteHeight=form.Terrain!=null,groundHeight=form.Terrain?.Sample(form.Transform.m03,form.Transform.m13)??0f,
                    dye=form.Dye.HasValue?new[]{form.Dye.Value.r,form.Dye.Value.g,form.Dye.Value.b}:null }).ToArray() });
                next = elapsed + 1d / (int)request["fps"];
                Write(Path.Combine(output,"status.json"), new { done=false,current=item["key"],stage="构造施放",elapsed,frames=times.Count });
            }
            yield return null;
        }
        caster.setPossessedMovement(false);
        Config.paused = true; yield return null;
        JObject[] scriptCasts = executionLog.Select(JObject.FromObject).Where(value =>
            (string)value["framework"] == "construction" && (string)value["id"] == definition.Id &&
            (long?)value["source"] == sourceId && (string)value["origin"] == "Script").ToArray();
        int actualContacts = scriptCasts.Length == 1 ? contactsLog.Select(JObject.FromObject).Count(value =>
            (string)value["framework"] == "construction" && (long?)value["cast"] == (long?)scriptCasts[0]["cast"] &&
            (long?)value["source"] == sourceId && (long?)value["target"] == targetId) : 0;
        int actualClashes = scriptCasts.Length == 1 ? clashesLog.Select(JObject.FromObject).Count(value =>
            (long?)value["leftCast"] == (long?)scriptCasts[0]["cast"] || (long?)value["rightCast"] == (long?)scriptCasts[0]["cast"]) : 0;
        Write(Path.Combine(folder, "result.json"), new
        {
            passed = used && (opponent == null || opponentUsed && opponentPaid == opponent.Cost && actualClashes > 0) && scriptCasts.Length == 1 && actualContacts > 0 && peak > 0 && paid == definition.Cost && (plan.ContactDamageScale > 0f ? Health(target) < health : Health(target) == health && (plan.ContactForce == 0f || Vector2.Distance(targetStart,target.current_position) > .05f)) && errors.Count == 0 && (walk == 0f || Vector2.Distance(casterStart,caster.current_position) > .25f),
            opponent, opponentUsed, opponentPaid, actualClashes, clashesLog,
            scene = "construction", validation = "正式入口、支付、主体及实际接触；有伤害时检查扣血，纯推拉检查实际位移；美术与完整交互另行验收",
            item, definition, used, paid, resource=definition.Resource, before, after = Balance(),
            targetBefore = health, targetAfter = Health(target), targetMoved=Vector2.Distance(targetStart,target.current_position), targetStart=new[]{targetStart.x,targetStart.y}, targetEnd=new[]{target.current_position.x,target.current_position.y}, peakForms = peak, casterWalk=walk, walked=Vector2.Distance(casterStart,caster.current_position),
            times, frames=times.Count, duration, view=(string)request["view"], scriptCasts=scriptCasts.Length, actualContacts, executionLog, contactsLog, materialFrames, errors
        });
        float Balance() => definition.Resource switch
        {
            "none" => 0f,
            "wakan" => owner.GetCultisys<Xian>().wakan,
            "vigor" => owner.GetCultisys<Knight>().vigor,
            "mana" => caster.getMana(),
            "stamina" => caster.getStamina(),
            _ => throw new InvalidOperationException("未知演示资源："+definition.Resource)
        };
        void PositionBodyTarget()
        {
            float height = (float)typeof(Cultiway.ModClass).Assembly.GetType("Cultiway.Content.Combat.SpatialActorPose",true)
                .GetMethod("Height",Flags).Invoke(null,new object[]{caster});
            enemies[0].stopMovement(); enemies[0].current_position = new Vector2(66 + height * (definition.Body.WeaponForm == null ? .65f : 1.35f),72);
            if (definition.Root?.Operations?.Any(op=>op.Kind==ConstructionOperationKind.Fly)==true)
                enemies[0].current_position=new Vector2(74,72);
            enemies[0].setCurrentTile(World.world.GetTileSimple(Mathf.FloorToInt(enemies[0].current_position.x),72)); enemies[0].updatePos();
        }
    }

    /// <summary>读取独立测试世界，然后依次准备、释放和录制每一招。</summary>
    private IEnumerator Run()
    {
        var load = LoadScene();
        while (load.MoveNext()) yield return load.Current;
        int index = 0;
        foreach (JObject item in (JArray)request["cases"])
        {
            errors.Clear(); currentCase = (string)item["id"];
            string folder = Path.Combine(output, (string)item["key"]);
            Directory.CreateDirectory(folder); Directory.CreateDirectory(Path.Combine(folder, "frames"));
            Write(Path.Combine(output, "status.json"), new { done = false, index = ++index, current = item["key"], stage = "准备" });
            Prepare(item);
            // 法宝需要等待附加状态建立；掌击不提前推进，避免准备阶段先消耗近战冷却。
            if ((string)item["id"] != "Cultiway.PalmStrike")
            {
                Config.paused = false;
                for (int frame = 0; frame < 4; frame++) yield return null;
                Config.paused = true;
            }
            if (externalView != null && !(bool)externalView.GetProperty("GodShown", Flags).GetValue(externalViewInstance))
            {
                var enter = EnterView();
                while (enter.MoveNext()) yield return enter.Current;
            }
            var record = (string)request["scene"] == "battle" ? RecordBattle(item, folder) : Record(item, folder);
            while (record.MoveNext()) yield return record.Current;
        }
        CleanExecutions(); Config.paused = false;
        double ending = World.world.getCurWorldTime() + 1.5;
        while (World.world.getCurWorldTime() < ending) yield return null;
        Config.paused = true; CleanExecutions();
    }

    /// <summary>仅加载仓库中的测试夹具，不保存或覆盖玩家世界。</summary>
    private IEnumerator LoadScene()
    {
        if (SmoothLoader.isLoading()) throw new InvalidOperationException("游戏仍在加载，请稍后运行");
        Config.paused = true; Time.timeScale = 1;
        ControllableUnit.clear(false);
        // 已载入 Worldfall 时先恢复普通视角，避免录像标签与实际镜头不符。
        var external = AppDomain.CurrentDomain.GetAssemblies().Select(assembly => assembly.GetType("FirstPerson.WorldBoxMod", false)).FirstOrDefault(type => type != null);
        if (external != null)
        {
            object view = external.GetProperty("Instance", Flags).GetValue(null);
            external.GetMethod("SetGodView", Flags).Invoke(view, new object[] { false });
            external.GetMethod("ViewForTest", Flags).Invoke(view, new object[] { false });
        }
        string fixture = Path.Combine(Cultiway.ModClass.I.GetDeclaration().FolderPath, "Scripts/WorldSaveTests/Fixtures/world-format-1");
        World.world.save_manager.loadWorld(fixture);
        yield return null;
        while (SmoothLoader.isLoading()) yield return null;
        Config.paused = true;
        World.world.console.Hide();
        float slope = (float?)request["terrainSlope"] ?? 0f;
        if (slope != 0f)
            for (int y = 60; y <= 84; y++) for (int x = 54; x <= 90; x++)
                World.world.GetTileSimple(x, y).Height = Mathf.Clamp(Mathf.RoundToInt(100f + slope * (x - 60)), 0, 255);
        foreach (var screen in Resources.FindObjectsOfTypeAll<LoadingScreen>()) screen.gameObject.SetActive(false);
        foreach (Actor actor in World.world.units.getSimpleList().ToArray()) Place(actor, 12, 12);
        caster = World.world.units.createNewUnit("human", World.world.GetTileSimple(53, 72), pAdultAge: true);
        caster.data.name = "法术演示·施法者";
        var owner = caster.GetExtend();
        owner.AddComponent(new Xian { level = (int?)request["realm"] ?? 2, wakan = 10000 });
        owner.AddComponent(new Magic { level = 3 });
        owner.SetPowerLevel((float)request["power"]);
        owner.MarkCultiwayStatsDirty();
        friend = World.world.units.createNewUnit("human", World.world.GetTileSimple(70, 72), pAdultAge: true);
        friend.data.name = "法术演示·友军"; friend.setKingdom(caster.kingdom);
        for (int index = 0; index < 7; index++)
        {
            Actor enemy = World.world.units.createNewUnit("wolf", World.world.GetTileSimple(70 + index % 3 * 4, 68 + index / 3 * 4), pAdultAge: true);
            enemy.data.name = "法术演示·敌军";
            enemies.Add(enemy);
        }
        foreach (var actor in new[] { caster, friend }.Concat(enemies)) actor.addTrait("super_health");
        // 控制施法者避免自主追加其他法术；不修改全局战斗设置。
        ControllableUnit.setControllableCreatureAndSelected(caster);
        if (external != null)
        {
            object view = external.GetProperty("Instance", Flags).GetValue(null);
            external.GetMethod("SetGodView", Flags).Invoke(view, new object[] { false });
            external.GetMethod("ViewForTest", Flags).Invoke(view, new object[] { false });
            bool ready = false;
            for (int frame = 0; frame < 300; frame++)
            {
                ready = !(bool)external.GetProperty("IsFirstPerson", Flags).GetValue(view) &&
                    !(bool)external.GetProperty("GodShown", Flags).GetValue(view) &&
                    (bool)external.GetProperty("DiveDone", Flags).GetValue(view);
                if (ready) break;
                yield return null;
            }
            if (!ready) throw new InvalidOperationException("Worldfall 尚未恢复普通观察视角");
        }
        Config.ui_main_hidden = true;
        foreach (var canvas in Resources.FindObjectsOfTypeAll<Canvas>())
        {
            canvases[canvas] = canvas.enabled; canvas.enabled = false;
        }
        PossessionUI.instance.gameObject.SetActive(false);
        Config.setWorldSpeed("x" + ((int?)request["speed"] ?? 1), false);
        if ((string)request["view"] is "worldfall" or "firstperson")
        {
            if (external == null) throw new InvalidOperationException("Worldfall 未加载，不能录为三维演示");
            externalView = external; externalViewInstance = external.GetProperty("Instance", Flags).GetValue(null);
        }
        yield return null;
    }

    /// <summary>场地准备完成后再进入三维，避免外部模组提前缓存旧地形。</summary>
    private IEnumerator EnterView()
    {
        // 原版在运行帧处理建筑移除队列；先结清，再让三维端重建地形及对象缓存。
        Config.paused = false;
        for (int frame = 0; frame < 3; frame++) yield return null;
        Config.paused = true;
        object lighting = externalView.GetField("Settings", Flags).GetValue(externalViewInstance);
        lighting.GetType().GetField("TimeMode", Flags).SetValue(lighting, 1);
        object sampler = externalView.GetField("_sampler", Flags).GetValue(externalViewInstance);
        sampler.GetType().GetMethod("Invalidate", Flags).Invoke(sampler, null);
        sampler.GetType().GetMethod("EnsureWorld", Flags).Invoke(sampler, null);
        object scene = externalView.GetProperty("SceneForTest", Flags).GetValue(externalViewInstance);
        scene.GetType().GetMethod("Reset", Flags).Invoke(scene, null);
        if ((string)request["view"] == "firstperson")
        {
            externalView.GetMethod("SetGodView", Flags).Invoke(externalViewInstance, new object[] { false });
            externalView.GetMethod("ViewForTest", Flags).Invoke(externalViewInstance, new object[] { true });
            ControllableUnit.setControllableCreatureAndSelected(caster);
            bool entered = false;
            for (int frame = 0; frame < 300; frame++)
            {
                entered = (bool)externalView.GetProperty("IsFirstPerson", Flags).GetValue(externalViewInstance) &&
                    (bool)externalView.GetProperty("DiveDone", Flags).GetValue(externalViewInstance);
                if (entered) break;
                yield return null;
            }
            if (!entered) throw new InvalidOperationException("实际附身第一人称镜头未就绪");
            externalView.GetMethod("SetYaw", Flags).Invoke(externalViewInstance, new object[] { 0f });
            for (int frame = 0; frame < 4; frame++) yield return null;
            yield break;
        }
        externalView.GetMethod("SetGodView", Flags).Invoke(externalViewInstance, new object[] { true });
        externalView.GetMethod("ViewForTest", Flags).Invoke(externalViewInstance, new object[] { false });
        ControllableUnit.clear(false);
        bool ready = false;
        for (int frame = 0; frame < 300; frame++)
        {
            ready = (bool)externalView.GetProperty("GodShown", Flags).GetValue(externalViewInstance) &&
                (float)externalView.GetProperty("GodAlpha", Flags).GetValue(externalViewInstance) >= .99f;
            if (ready) break;
            yield return null;
        }
        if (!ready) throw new InvalidOperationException("三维镜头未就绪");
        if (request["construction"] is JObject && request["construction"]["Body"] is not JObject)
        {
            // 使用外部模组自身的倾斜观察，避免俯视时看不出浪唇、腹部等真实厚度。
            externalView.GetField("_godTip", Flags).SetValue(externalViewInstance, .55f);
            externalView.GetField("_godTipRate", Flags).SetValue(externalViewInstance, 0f);
        }
        if ((float?)request["zoom"] < 10f && request["construction"]?["Body"] is JObject)
        {
            // 使用Worldfall本身的贴近人物观察，避免把原版近景冒充三维近景。
            Place(caster,66,72);
            typeof(Cultiway.ModClass).Assembly.GetType("Cultiway.Core.Performance.PresentationInterpolator",true)
                .GetMethod("Reset",Flags).Invoke(null,null);
            scene.GetType().GetMethod("Reset", Flags).Invoke(scene, null);
            Vector3 mapCamera=World.world.camera.transform.position;
            World.world.camera.transform.position=new Vector3(caster.current_position.x,caster.current_position.y,mapCamera.z);
            externalView.GetMethod("GodFollowAfterDive",Flags).Invoke(externalViewInstance,new object[]{caster});
            externalView.GetField("_godClose", Flags).SetValue(externalViewInstance, (float)request["zoom"]);
            externalView.GetField("_godCloseTarget", Flags).SetValue(externalViewInstance, (float)request["zoom"]);
            externalView.GetField("_godPull", Flags).SetValue(externalViewInstance, 1f);
            bool centred = false;
            for (int frame = 0; frame < 180; frame++)
            {
                Vector2 follow=(Vector2)externalView.GetField("_godFollow",Flags).GetValue(externalViewInstance);
                centred=Vector2.Distance(follow,caster.current_position)<.02f&&
                    Vector2.Distance(World.world.camera.transform.position,caster.current_position)<.03f;
                if (centred && frame>=20) break;
                yield return null;
            }
            if (!centred) throw new InvalidOperationException("三维近景尚未对准实际施法者");
        }
    }

    /// <summary>清理上一招，并建立对本招有效的敌军、友军或地形条件。</summary>
    /// <param name="item">本招设置。</param>
    private void Prepare(JObject item)
    {
        Config.paused = true; CleanExecutions();
        // 攻击和世界效果可能杀死测试对象，下一招重新准备活体，保留本招的真实死亡结果。
        if (Health(friend) == 0) friend = CreateTarget(true, 0);
        for (int index = 0; index < enemies.Count; index++)
            if (Health(enemies[index]) == 0) enemies[index] = CreateTarget(false, index);
        friend.setKingdom(caster.kingdom);
        World.world.particles_fire.clear(); World.world.particles_smoke.clear();
        World.world.projectiles.clear();
        var mod = Cultiway.ModClass.I;
        foreach (var cloud in UnityEngine.Object.FindObjectsOfType<Cloud>()) if (cloud.active) cloud.kill();
        string id = (string)item["id"];
        artifactDetails = null;
        executionLog.Clear(); contactsLog.Clear(); clashesLog.Clear(); areasLog.Clear(); yellowObjects.Clear(); barrierLog.Clear(); footprints.Clear(); probeUsed = false;
        barrierBefore = barrierLowest = 0;
        technique = id.StartsWith("Cultiway.KnightTechnique.") ? KnightTechniqueCatalog.All.Single(value => value.id + ".Execution" == id) : null;
        caster.equipment.weapon.takeAwayItem();
        var spellAsset = mod.SkillV3.SkillLib.get(id);
        if (spellAsset != null && spellAsset.DefaultCastResourceRequirement.ResourceAssetIds.Contains(SkillCastResources.Mana.id))
            caster.equipment.setItem(World.world.items.generateItem(AssetManager.items.get("white_staff"), pActor: caster), caster);
        if (caster.GetExtend().HasComponent<Yuanshen>()) caster.GetExtend().E.RemoveComponent<Yuanshen>();
        caster.GetExtend().GetCultisys<Xian>().level = id.StartsWith("Cultiway.CoreFormation.Skill.") ? 4 : (int?)request["realm"] ?? 2;
        foreach (Actor actor in new[] { caster, friend }.Concat(enemies))
        {
            actor.finishAllStatusEffects();
            var extend = actor.GetExtend();
            foreach (Entity status in extend.GetStatuses())
            {
                extend.RemoveSharedStatus(status);
                if (status.IsAvailable() && !status.Tags.Has<TagRecycle>()) status.AddTag<TagRecycle>();
            }
            actor.clearAttackTarget(); actor.attack_timer = 0;
        }
        Place(caster, 53, 72); Place(friend, 70, 76);
        for (int index = 0; index < enemies.Count; index++)
        {
            Place(enemies[index], 70 + index % 3 * 4, 68 + index / 3 * 4);
            enemies[index].addAggro(caster); caster.addAggro(enemies[index]);
        }
        var hold = Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.SpellDemo.Hold");
        if (hold == null)
        {
            var stats = new BaseStats(); stats.addTag("frozen_ai"); stats.addTag("immovable");
            hold = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.Hold").SetStats(stats).SetDuration(10000).Build();
        }
        foreach (Actor actor in new[] { caster, friend }.Concat(enemies))
        {
            CombatStatusEffects.ApplyStatus(actor, hold, 10000, actor);
            actor.setStatsDirty(); actor.updateStats(); actor.stopMovement(); actor.data.health = Mathf.CeilToInt(actor.stats["health"]);
        }
        var background = Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.SpellDemo.Background");
        if (background == null)
        {
            var stats = new BaseStats(); stats.addTag("frozen_ai"); stats.addTag("immovable"); stats.addTag(ActorControlTags.Silenced);
            background = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.Background").SetStats(stats).SetDuration(10000).Build();
        }
        foreach (Actor actor in World.world.units.getSimpleList().ToArray())
        {
            if (actor == caster || actor == friend || enemies.Contains(actor) || !isolated.Add(actor.id)) continue;
            CombatStatusEffects.ApplyStatus(actor, background, 10000, actor);
            Place(actor, 12, 12); actor.setStatsDirty(); actor.updateStats();
        }
        // 每次还原同一片地形；世界法术则有明确的可观察前置状态。
        for (int x = 40; x < 99; x++) for (int y = 48; y < 98; y++)
        {
            var tile = World.world.GetTileSimple(x, y);
            if (tile.building != null) tile.building.removeBuildingFinal();
            tile.stopFire(); tile.removeBurn(); tile.unfreeze(99); tile.heat = 0;
            tile.removeGrass(false);
            bool patch = x >= 67 && x <= 83 && y >= 61 && y <= 80;
            bool water = patch && id.EndsWith("DrainWater");
            tile.setTileTypes(water ? TileLibrary.shallow_waters : TileLibrary.soil_low,
                              water ? null : patch && id.EndsWith("Fertilize") ? TopTileLibrary.field : TopTileLibrary.grass_low);
        }
        if (id.EndsWith("CleanLandField"))
            for (int x = 69; x <= 77; x += 2) World.world.GetTileSimple(x, 69).startFire();
        if (id.EndsWith("Fertilize"))
            for (int x = 68; x <= 80; x += 2) for (int y = 63; y <= 77; y += 2)
                World.world.buildings.addBuilding("wheat", World.world.GetTileSimple(x, y));
        if (id.EndsWith("PurificationWave")) CombatStatusEffects.ApplyStatus(friend, StatusEffects.Burn, 10, enemies[0]);
        friend.data.health = Mathf.Max(1, Mathf.CeilToInt(friend.stats["health"] * .35f));
        caster.GetExtend().GetCultisys<Xian>().wakan = 10000;
        caster.setMana(10000, pClamp: false);
        var owner = caster.GetExtend();
        if (id.StartsWith("Cultiway.CoreFormation.Skill.")) PrepareFormation(owner, id);
        if (technique != null)
        {
            if (!owner.HasCultisys<Knight>()) owner.AddComponent(new Knight { level = 8, vigor = 10000 });
            string weapon = technique.Style == KnightStyles.Lancer ? "spear_iron" : technique.Style == KnightStyles.Guardian ? "hammer_iron" : "sword_iron";
            caster.equipment.setItem(World.world.items.generateItem(AssetManager.items.get(weapon), pActor: caster), caster);
            KnightStyleMasteryService.Master(owner, technique.Style);
            var known = (IEnumerable)typeof(ActorExtend).GetMethod("GetLearnedSkillsInOrder", Flags).Invoke(owner, null);
            foreach (Entity previous in known.Cast<Entity>().ToArray())
                if (previous.TryGetComponent(out SpecializedActiveAbility specialized) && specialized.ProviderId == "content.knight_techniques")
                    SkillOwnershipService.Forget(owner, previous);
            SkillOwnershipService.Learn(owner, KnightTechniqueSkills.GetContainer(technique), true);
            int distance = technique == KnightTechniques.FormationCharge ? 4 : technique == KnightTechniques.SkyfallStrike ? 5 : 1;
            Place(caster, 70 - distance, 68);
            var handles = new List<ActiveAbilityHandle>(); ActiveAbilityService.Collect(owner, handles);
            ability = handles.Single(handle => handle.EntryId == technique.id);
            SkillCooldownService.Clear(owner, ability.Source);
        }
        if (id.StartsWith("Cultiway.ArtifactAbility.")) { Place(caster, 65, 68); PrepareArtifact(owner, id); }
        if (id == "Cultiway.PalmStrike")
        {
            Place(caster, 69, 68);
            enemies[0].current_position = new Vector2(69.55f, 68);
            enemies[0].setCurrentTile(World.world.GetTileSimple(69, 68)); enemies[0].updatePos();
        }
        owner.MarkCultiwayStatsDirty(); caster.setStatsDirty(); caster.updateStats();
        Camera();
        mod.CommandBuffer.Playback();
    }

    /// <summary>通过正式技能序列实际释放，并按世界时间截图，记录真实生成和受伤。</summary>
    /// <param name="item">本招设置。</param>
    /// <param name="folder">本段输出目录。</param>
    private IEnumerator Record(JObject item, string folder)
    {
        var mod = Cultiway.ModClass.I;
        string id = (string)item["id"];
        var asset = mod.SkillV3.SkillLib.get(id);
        if (!artifact.IsNull && (id == ArtifactAbilities.SpiritHostManifestation.id || id == ArtifactAbilities.FiveEssenceOutpouring.id))
        {
            var instance = artifact.GetComponent<ArtifactAbilitySet>().abilities[0];
            var storage = artifact.GetComponent<ArtifactStorageState>();
            ArtifactStorageOperations.Store(ref storage, id == ArtifactAbilities.SpiritHostManifestation.id
                ? ArtifactStorageOperations.SoulEssence : ArtifactStorageOperations.AbsorbedPower, instance.GetNumber("stored_resource_cost"));
            artifact.GetComponent<ArtifactStorageState>() = storage;
        }
        Entity skill = default;
        bool dedicated = !artifact.IsNull || technique != null || id == "Cultiway.PalmStrike";
        if (dedicated) skill = technique != null ? ability.Source : default;
        else if (granted.TryGetValue(asset.id, out Entity original)) skill = original;
        else
        {
            var blueprint = Blueprint(asset, (int)item["variant"], (string)item["trajectory"]);
            foreach (SkillModifierSpec spec in item["modifiers"].ToObject<SkillModifierSpec[]>())
            {
                blueprint.Modifiers.RemoveAll(value => value.AssetId == spec.AssetId);
                blueprint.Modifiers.Add(spec);
            }
            if (asset.CanBeLearned)
            {
                var compiled = new SkillBlueprintCompiler().Compile(blueprint, SkillBlueprintCompileMode.Preview);
                if (!compiled.Success) throw new InvalidOperationException("词条或轨迹不兼容：" + string.Join("；", compiled.Validation.Issues.Select(issue => issue.Message)));
                skill = compiled.Container;
            }
            else skill = new SkillContainerBuilder(asset).UseAnimation((int)item["variant"]).Build(SkillContainerBuildMode.SourceGranted);
            temporarySkill = skill;
        }
        observed = skill; spawned = 0;
        var relation = asset == null ? SkillUseTargetRelation.Hostile : asset.UseProfile.TargetRelation;
        BaseSimObject target = relation == SkillUseTargetRelation.Self ? caster : relation == SkillUseTargetRelation.Friendly ? friend : enemies[0];
        if (relation == SkillUseTargetRelation.WorldTile) target = enemies[0];
        var owner = caster.GetExtend();
        owner.GetCultisys<Xian>().wakan = 10000; caster.setMana(10000, pClamp: false);
        if (owner.HasCultisys<Knight>()) owner.GetCultisys<Knight>().vigor = caster.stats[BaseStatses.MaxVigor.id];
        float wakanBefore = owner.GetCultisys<Xian>().wakan, manaBefore = caster.getMana();
        friend.setKingdom(caster.kingdom);
        int[] health = enemies.Select(Health).ToArray();
        float friendBefore = Health(friend);
        if (technique != null || id == "Cultiway.PalmStrike")
        {
            // 准备和换镜头期间冻结，正式入口调用前解除，防止三维观察模式提前自主出手。
            foreach (Entity status in owner.GetStatuses().ToArray())
                if (status.GetComponent<StatusComponent>().Type.id == "Cultiway.SpellDemo.Hold") owner.RemoveSharedStatus(status);
            owner.MarkCultiwayStatsDirty(); caster.setStatsDirty(); caster.updateStats();
            caster.current_rotation = Vector3.zero;
        }
        if (id == "Cultiway.PalmStrike")
        {
            // 三维镜头切换会做人物避让，开拍时重新放回已核对的接触距离。
            Place(caster, 69, 68);
            enemies[0].current_position = new Vector2(69.55f, 68);
            enemies[0].setCurrentTile(World.world.GetTileSimple(69, 68)); enemies[0].updatePos();
        }
        bool used;
        if (dedicated)
        {
            if (id == "Cultiway.PalmStrike")
            {
                var handles = new List<ActiveAbilityHandle>(); ActiveAbilityService.Collect(owner, handles);
                ability = handles.Single(handle => handle.ProviderId == "content.palm_strike");
            }
            var descriptor = ActiveAbilityService.Describe(owner, ability);
            if (descriptor.TargetMode == ActiveAbilityTargetMode.Self) target = caster;
            used = ActiveAbilityService.TryUse(owner, ability, new ActiveAbilityTarget(target, target.GetSimPos()), ActiveAbilityUseOrigin.Script);
        }
        else used = owner.CastSkillV3(skill, target);
        if (!used) throw new InvalidOperationException("正式施法入口拒绝：" + id +
            (dedicated ? "；" + ActiveAbilityService.ResolveControlState(owner, ability).BlockReason : ""));
        mod.CommandBuffer.Playback();
        var times = new List<double>();
        var meshes = (IList)typeof(Cultiway.ModClass).Assembly.GetType("Cultiway.Content.Combat.CombatSpatialVisualSystem", true)
            .GetField("Meshes", Flags).GetValue(null);
        int peakMeshes = 0, previewFrame = 0;
        double start = World.world.getCurWorldTime(), duration = Math.Max((double)request["duration"], id.EndsWith(".FivePhase") ? 10.5 : 0), nextCapture = 0;
        double interval = 1d / (int)request["fps"];
        float nextStatus = Time.realtimeSinceStartup + 2;
        if ((string)request["scene"] == "shield")
        {
            if (asset?.ImpactProfile.IsBarrier != true && id != ArtifactAbilities.GoldenBellBarrier.id)
                throw new InvalidOperationException("迎击场景只支持真实墙、护盾或金钟护界：" + id);
            Place(enemies[0], 68, 72);
        }
        Config.paused = false;
        // 首帧先留出起手前的场景，往后的帧均读取真实世界时间。
        while (World.world.getCurWorldTime() - start + .00001 < duration)
        {
            if (File.Exists(Path.Combine(Root, "cancel"))) throw new OperationCanceledException("已取消演示");
            Camera(); Tooltip.hideTooltipNow();
            double elapsed = World.world.getCurWorldTime() - start;
            if ((string)request["scene"] == "shield") ProbeShield(elapsed);
            if (elapsed + .00001 >= nextCapture)
            {
                if (meshes.Count > peakMeshes) { peakMeshes = meshes.Count; previewFrame = times.Count; }
                if ((bool?)request["diagnostics"] == true && times.Count % 5 == 0) InspectYellowSprites();
                InspectFootprints();
                times.Add(elapsed);
                new ScreenFacade().Capture(Path.Combine(folder, "frames", (times.Count - 1).ToString("00000") + ".png"));
                nextCapture = (Math.Floor((elapsed + .00001) / interval) + 1) * interval;
            }
            if (Time.realtimeSinceStartup >= nextStatus)
            {
                Write(Path.Combine(output, "status.json"), new { done = false, current = item["key"], stage = "录制", elapsed, frames = times.Count });
                nextStatus = Time.realtimeSinceStartup + 2;
            }
            yield return null;
            if (errors.Count > 0) throw new InvalidOperationException(string.Join("\n", errors));
        }
        Config.paused = true;
        yield return null; // 截图在帧尾落盘，报告必须晚于最后一次截图。
        double actual = World.world.getCurWorldTime() - start;
        Write(Path.Combine(folder, "result.json"), new
        {
            passed = (spawned > 0 || dedicated && used) && errors.Count == 0 &&
                ((string)request["scene"] != "shield" || probeUsed && barrierBefore > barrierLowest), id, item, frames = times.Count, times,
            duration = actual, spawned, peakMeshes, previewFrame, artifactDetails,
            view = (string)request["view"], scene = (string)request["scene"], executionLog, contactsLog, areasLog, barrierLog, footprints = footprints.Values.ToArray(), yellowObjects,
            assembly = typeof(Cultiway.ModClass).Assembly.ManifestModule.ModuleVersionId.ToString(),
            shield = new { probeUsed, barrierBefore, barrierLowest, absorbed = barrierLowest < barrierBefore },
            validation = "仅验证施放和运行错误；美术、范围与防御效果需另外验收", wakanBefore, wakanAfter = owner.GetCultisys<Xian>().wakan,
            manaBefore, manaAfter = caster.getMana(), friendBefore, friendAfter = Health(friend), friendDied = Health(friend) == 0,
            damaged = enemies.Where((actor, index) => Health(actor) < health[index]).Count(), errors
        });
    }

    /// <summary>读取真实生命；吞噬或死亡后的对象按零记录，避免删去实际作用结果。</summary>
    private static int Health(Actor actor) => actor?.data == null || !actor.isAlive() ? 0 : actor.data.health;

    /// <summary>只在独立测试世界补充已经失效的目标，下一招不用上一招的尸体。</summary>
    private Actor CreateTarget(bool friendly, int index)
    {
        var actor = World.world.units.createNewUnit(friendly ? "human" : "wolf",
            World.world.GetTileSimple(70 + index % 3 * 4, 68 + index / 3 * 4), pAdultAge: true);
        actor.data.name = friendly ? "法术演示·友军" : "法术演示·敌军";
        actor.addTrait("super_health");
        if (friendly) actor.setKingdom(caster.kingdom);
        return actor;
    }

    /// <summary>按稳定定义建立单一法术蓝图，不读取或使用组合样板。</summary>
    /// <param name="asset">实际法术。</param>
    /// <param name="variant">旧变体编号。</param>
    /// <param name="trajectory">有效轨迹。</param>
    private static SkillBlueprint Blueprint(SkillEntityAsset asset, int variant, string trajectory)
    {
        var blueprint = new SkillBlueprint
        {
            EntityAssetId = asset.id, AnimationIndex = variant, TrajectoryAssetId = trajectory,
            CastResourceRequirement = asset.DefaultCastResourceRequirement.DeepClone(),
            AiNamingEnabled = false, NameMode = SkillBlueprintNameMode.Custom, CustomName = Name(asset.id)
        };
        SkillBlueprintModifierRules.EnsureRequiredModifiers(blueprint, asset);
        return blueprint;
    }

    /// <summary>只移除测试世界中的瞬时执行和显示缓存，不改原始资产。</summary>
    private void CleanExecutions()
    {
        var mod = Cultiway.ModClass.I;
        foreach (var learned in learnedForBattle) if (learned.Skill.IsAvailable()) SkillOwnershipService.Forget(learned.Owner, learned.Skill);
        learnedForBattle.Clear();
        if (incomingSkill.IsAvailable()) retiringSkills.Add(incomingSkill);
        incomingSkill = default;
        if (artifact.IsAvailable() && caster != null)
        {
            caster.GetExtend().UnequipArtifact(artifact, suppressAutoEquip: true);
            if (artifact.HasComponent<Position>()) artifact.GetComponent<Position>().value = new Vector3(12, 12);
        }
        artifact = default;
        typeof(Cultiway.Core.SkillLibV3.Manager).GetMethod("ClearQueuedSkillSequences", Flags).Invoke(mod.SkillV3, null);
        foreach (Entity entity in mod.W.Query<SkillCastSequence>().Entities.ToArray())
            if (!entity.Tags.Has<TagPrefab>() && !entity.Tags.Has<TagRecycle>()) entity.AddTag<TagRecycle>();
        foreach (Entity entity in mod.W.Query<SkillEntity>().Entities.ToArray())
        {
            if (entity.Tags.Has<TagPrefab>()) continue;
            if (entity.HasComponent<SkillAnimationLifecycleState>())
                entity.GetComponent<SkillAnimationLifecycleState>().Phase = SkillAnimationPhase.RecycleReady;
            if (!entity.Tags.Has<TagRecycle>()) entity.AddTag<TagRecycle>();
        }
        if (temporarySkill.IsAvailable()) retiringSkills.Add(temporarySkill);
        temporarySkill = default; observed = default;
        var referenced = new HashSet<Entity>(mod.W.Query<SkillEntity>().Entities
            .Where(entity => !entity.Tags.Has<TagPrefab>()).Select(entity => entity.GetComponent<SkillEntity>().SkillContainer));
        for (int index = retiringSkills.Count - 1; index >= 0; index--)
        {
            Entity container = retiringSkills[index];
            if (container.IsAvailable() && referenced.Contains(container)) continue;
            if (container.IsAvailable()) SkillBlueprintCompiler.Recycle(container);
            retiringSkills.RemoveAt(index);
        }
        typeof(Cultiway.ModClass).Assembly.GetType("Cultiway.Content.Visuals.BattleSpellVisualRuntime", true)
            .GetMethod("Clear", Flags).Invoke(null, null);
    }

    /// <summary>只统计当前演示容器实际建立的执行体。</summary>
    /// <param name="entity">实际执行体。</param>
    private void OnSpawn(Entity entity)
    {
        var skill = entity.GetComponent<SkillEntity>();
        if (skill.SkillContainer == observed) spawned++;
        if (skill.Asset?.ImpactProfile == null) return;
        var context = entity.GetComponent<SkillContext>();
        executionLog.Add(new { time = World.world.getCurWorldTime(), id = skill.Asset.id, source = context.SourceObj?.getID(),
            collisionRadius = SkillEffectRadius.Collision(entity), effectRadius = SkillEffectRadius.Effect(entity),
            scale = entity.GetComponent<EffectRadiusScale>().Value });
    }

    /// <summary>记录共用构造实际受理的施放及自主来源，不把脚本播放记成自主交战。</summary>
    /// <param name="started">正式受理事件。</param>
    private void OnConstructedStart(ConstructedCastStarted started) => executionLog.Add(new
    { time=started.WorldTime,id=started.AbilityId,source=started.SourceId,cast=started.CastId,origin=started.Origin.ToString(),framework="construction" });

    /// <summary>记录身体或形体实际相交后的正式结算入口。</summary>
    /// <param name="contact">真实接触事件。</param>
    private void OnConstructedContact(ConstructedContact contact) => contactsLog.Add(new
    { time=World.world.getCurWorldTime(),id=contact.AbilityId,cast=contact.CastId,source=contact.SourceId,originalSource=contact.OriginalSourceId,reflections=contact.Reflections,target=contact.TargetId,node=contact.Node,age=contact.Age,
        targetContactNumber=contact.TargetContactNumber,groupContactNumber=contact.GroupContactNumber,
        matterBefore=contact.MatterBefore,stateBefore=contact.StateBefore,matterAfter=contact.MatterAfter,stateAfter=contact.StateAfter,
        point=new[]{contact.Position.x,contact.Position.y,contact.Position.z},normal=new[]{contact.Normal.x,contact.Normal.y,contact.Normal.z},
        damageAttempted=contact.DamageAttempted,velocityChange=new[]{contact.VelocityChange.x,contact.VelocityChange.y,contact.VelocityChange.z},
        result=contact.Result.ToString(),framework="construction" });

    /// <summary>收集本次运行的游戏错误，不把启动前的历史错误算入结果。</summary>
    /// <param name="message">日志内容。</param>
    /// <param name="stack">调用位置。</param>
    /// <param name="type">日志类别。</param>
    private void OnLog(string message, string stack, LogType type)
    {
        if (type is LogType.Error or LogType.Exception or LogType.Assert) errors.Add(message + "\n" + stack);
    }

    /// <summary>记录大块黄色精灵的资源与材质，避免猜测后错误删除别的特效。</summary>
    private void InspectYellowSprites()
    {
        foreach (var system in UnityEngine.Object.FindObjectsOfType<ParticleSystem>())
        {
            if (!system.gameObject.activeInHierarchy || system.particleCount == 0) continue;
            var particles = new ParticleSystem.Particle[system.particleCount]; system.GetParticles(particles);
            var renderer = system.GetComponent<ParticleSystemRenderer>();
            foreach (var particle in particles)
            {
                Color color = particle.GetCurrentColor(system); float size = particle.GetCurrentSize(system);
                if (color.r < .7f || color.g < .5f || color.b > .6f || size < .5f) continue;
                yellowObjects.Add(system.name + " | " + renderer.sharedMaterial?.shader?.name + " | " +
                    renderer.sharedMaterial?.mainTexture?.name + " | size=" + size.ToString("F2") + " | " + particle.position);
            }
        }
        foreach (var renderer in UnityEngine.Object.FindObjectsOfType<SpriteRenderer>())
        {
            if (!renderer.enabled || !renderer.gameObject.activeInHierarchy || renderer.sprite == null) continue;
            Color color = renderer.color;
            if (color.r < .7f || color.g < .5f || color.b > .6f || renderer.bounds.size.x < 1.5f) continue;
            yellowObjects.Add(renderer.name + " | " + renderer.sprite.name + " | " + renderer.sprite.texture.name +
                " | " + renderer.sharedMaterial?.shader?.name + " | " + renderer.transform.position);
        }
    }

    /// <summary>读取已初始化的真实执行体，不从贴图尺寸推算作用区域。</summary>
    private void InspectFootprints()
    {
        foreach (var entity in Cultiway.ModClass.I.W.Query<SkillEntity>().Entities)
        {
            if (entity.Tags.Has<TagPrefab>() || entity.Tags.Has<TagRecycle>() || footprints.ContainsKey(entity.Id)) continue;
            if (footprints.Count >= 512) break;
            var skill = entity.GetComponent<SkillEntity>();
            // 法宝还会建立纯展示动画，它们没有作用配置，不属于范围核对对象。
            if (skill.Asset?.ImpactProfile == null) continue;
            if (entity.TryGetComponent(out SkillPersistentState state) && state.Kind != SkillPersistentKind.Field)
                footprints[entity.Id] = new { id = skill.Asset.id, kind = state.Kind.ToString(),
                    position = entity.GetComponent<Position>().value.ToString(), direction = entity.GetComponent<Rotation>().value.ToString(),
                    length = state.Length, width = state.Width, radius = state.Kind == SkillPersistentKind.Shield ? state.Length * .5f + state.Width : 0,
                    durability = state.Durability };
            else footprints[entity.Id] = new { id = skill.Asset.id, kind = skill.Asset.ImpactProfile.Kind.ToString(),
                position = entity.GetComponent<Position>().value.ToString(), effectRadius = SkillEffectRadius.Effect(entity),
                collisionRadius = SkillEffectRadius.Collision(entity),
                explicitTargetOnly = entity.TryGetComponent(out ColliderConfig config) && config.ExplicitTargetOnly,
                start = entity.TryGetComponent(out LinearTrajectoryState line) && line.Initialized ? line.Start.ToString() : null,
                end = entity.TryGetComponent(out LinearTrajectoryState endLine) && endLine.Initialized ? endLine.End.ToString() : null };
        }
    }

    /// <summary>真实拦截位置与吸收量。</summary>
    private void OnBarrier(Entity entity, Vector2 point, float damage) => barrierLog.Add(new
        { time = World.world.getCurWorldTime(), id = entity.GetComponent<SkillEntity>().Asset.id, point = point.ToString(), damage });

    /// <summary>记录真实接触对象；不以画面覆盖推测命中。</summary>
    private void OnContact(Entity entity, BaseSimObject target)
    {
        if (contactsLog.Count >= 512) return;
        contactsLog.Add(new { time = World.world.getCurWorldTime(), id = entity.GetComponent<SkillEntity>().Asset.id,
            target = target.getID(), position = target.GetSimPos().ToString() });
    }

    /// <summary>记录已经发生的范围结算及其最终半径。</summary>
    private void OnArea(Entity entity, Vector3 position, float radius)
    {
        if (areasLog.Count >= 512) return;
        areasLog.Add(new { time = World.world.getCurWorldTime(), id = entity.GetComponent<SkillEntity>().Asset.id,
            position = position.ToString(), radius });
    }

    /// <summary>从外部实际发射石弹，让护盾耐久变化证明拦截；不直接扣护盾。</summary>
    private void ProbeShield(double elapsed)
    {
        var barriers = Cultiway.ModClass.I.W.Query<SkillEntity, SkillPersistentState>().Entities
            .Where(entity => !entity.Tags.Has<TagPrefab>() && !entity.Tags.Has<TagRecycle>() &&
                entity.GetComponent<SkillEntity>().SkillContainer == observed).ToArray();
        float current = barriers.Length > 0 ? barriers[0].GetComponent<SkillPersistentState>().Durability : 0;
        if (!artifact.IsNull && artifact.TryGetComponent(out ArtifactAbilityRuntime runtime))
            current = runtime.abilities.First(entry => entry.instance_id == ability.EntryId).GetNumber("shield_current");
        if (barrierBefore == 0 && current > 0) barrierBefore = barrierLowest = current;
        if (probeUsed && elapsed < 2.5) barrierLowest = Mathf.Min(barrierLowest, current);
        if (probeUsed || elapsed < .45) return;
        var enemy = enemies[0].GetExtend();
        if (!enemy.HasCultisys<Xian>()) enemy.AddComponent(new Xian { level = 0, wakan = 10000 });
        enemy.GetCultisys<Xian>().wakan = 10000;
        incomingSkill = new SkillContainerBuilder(SkillEntities.RockProjectile).Build();
        probeUsed = enemy.CastSkillV3(incomingSkill, caster);
        if (!probeUsed) throw new InvalidOperationException("迎击用石弹未能正式施放");
    }

    /// <summary>只授予法术、解除控制和建立敌对关系；出手时机完全由游戏自身决定。</summary>
    private IEnumerator RecordBattle(JObject item, string folder)
    {
        var owner = caster.GetExtend();
        var rival = enemies[0].GetExtend();
        if (!rival.HasCultisys<Xian>()) rival.AddComponent(new Xian());
        rival.GetCultisys<Xian>().level = (int?)request["realm"] ?? 2;
        rival.SetPowerLevel((float)request["power"]);
        foreach (var participant in new[] { owner, rival })
        {
            foreach (string id in item["spellIds"].ToObject<string[]>())
            {
                var asset = Cultiway.ModClass.I.SkillV3.SkillLib.get(id);
                var compiled = new SkillBlueprintCompiler().Compile(Blueprint(asset, 0, SkillBlueprintTrajectory.ResolveDefaultId(asset)), SkillBlueprintCompileMode.Runtime);
                if (!compiled.Success) throw new InvalidOperationException("无法授予交战法术：" + id);
                if (SkillOwnershipService.Learn(participant, compiled.Container) != SkillOwnershipResult.Added)
                    throw new InvalidOperationException("交战法术未能学会：" + id);
                learnedForBattle.Add((participant, compiled.Container));
            }
            participant.MarkCultiwayStatsDirty(); participant.Base.setStatsDirty(); participant.Base.updateStats();
            participant.GetCultisys<Xian>().wakan = 100000; participant.Base.setMana(100000, pClamp: false);
        }
        string battleArtifact = (string)request["battleArtifact"];
        if (battleArtifact != null)
        {
            PrepareArtifact(owner, battleArtifact);
            Config.paused = false;
            for (int frame = 0; frame < 4; frame++) yield return null;
            Config.paused = true;
        }
        foreach (var participant in new[] { owner, rival })
        {
            foreach (Entity status in participant.GetStatuses().ToArray())
            {
                participant.RemoveSharedStatus(status);
                if (status.IsAvailable() && !status.Tags.Has<TagRecycle>()) status.AddTag<TagRecycle>();
            }
            participant.Base.setStatsDirty(); participant.Base.updateStats();
        }
        ControllableUnit.clear(false);
        caster.addAggro(enemies[0]); enemies[0].addAggro(caster);
        caster.setAttackTarget(enemies[0]); enemies[0].setAttackTarget(caster);
        caster.attack_timer = enemies[0].attack_timer = 0;
        executionLog.Clear(); contactsLog.Clear(); clashesLog.Clear(); areasLog.Clear(); barrierLog.Clear(); footprints.Clear();
        double start = World.world.getCurWorldTime(), next = 0, interval = 1d / (int)request["fps"];
        var times = new List<double>();
        Config.paused = false;
        while (World.world.getCurWorldTime() - start + .00001 < (double)request["duration"])
        {
            if (File.Exists(Path.Combine(Root, "cancel"))) throw new OperationCanceledException("已取消演示");
            Camera(); Tooltip.hideTooltipNow();
            double elapsed = World.world.getCurWorldTime() - start;
            if (elapsed + .00001 >= next)
            {
                if ((bool?)request["diagnostics"] == true && times.Count % 5 == 0) InspectYellowSprites();
                InspectFootprints();
                times.Add(elapsed);
                new ScreenFacade().Capture(Path.Combine(folder, "frames", (times.Count - 1).ToString("00000") + ".png"));
                next = (Math.Floor((elapsed + .00001) / interval) + 1) * interval;
            }
            yield return null;
            if (errors.Count > 0) throw new InvalidOperationException(string.Join("\n", errors));
        }
        Config.paused = true; yield return null;
        var casts = JArray.FromObject(executionLog).OfType<JObject>().Where(row => (long?)row["source"] == caster.id).ToArray();
        var rivalCasts = JArray.FromObject(executionLog).OfType<JObject>().Where(row => (long?)row["source"] == enemies[0].id).ToArray();
        bool artifactUsed = battleArtifact == null || artifact.GetComponent<ArtifactAbilityRuntime>().abilities
            .Any(entry => entry.instance_id == battleArtifact && entry.last_triggered_at >= start);
        int distinct = casts.Select(row => (string)row["id"]).Distinct().Count();
        int together = casts.GroupBy(row => (double)row["time"]).Select(group => group.Select(row => (string)row["id"]).Distinct().Count()).DefaultIfEmpty().Max();
        Write(Path.Combine(folder, "result.json"), new
        {
            passed = distinct >= 2 && together >= 2 && rivalCasts.Length > 0 && artifactUsed && errors.Count == 0, item, frames = times.Count, times,
            duration = World.world.getCurWorldTime() - start, spawned = casts.Length, distinct, together,
            rivalCasts = rivalCasts.Length, artifactUsed, artifactDetails,
            view = (string)request["view"], scene = "battle", executionLog, contactsLog, areasLog, barrierLog, footprints = footprints.Values.ToArray(), yellowObjects,
            assembly = typeof(Cultiway.ModClass).Assembly.ManifestModule.ModuleVersionId.ToString(),
            validation = "没有脚本逐帧调用施法、规划或执行；仅观察原版 AI 调度", frozen = caster.hasTag("frozen_ai"), rivalFrozen = enemies[0].hasTag("frozen_ai"), errors
        });
    }

    /// <summary>固定普通观察视角，所有法术使用同一尺度便于比较。</summary>
    private void Camera()
    {
        if (externalView != null && (string)request["view"] == "firstperson" &&
            (bool)externalView.GetProperty("IsFirstPerson", Flags).GetValue(externalViewInstance)) return;
        bool body = request["construction"]?["Body"] is JObject;
        if (body && externalView != null && (float?)request["zoom"] < 10f &&
            (bool)externalView.GetProperty("GodShown", Flags).GetValue(externalViewInstance)) return;
        bool placement = request["construction"] is JObject && request["targetOffset"] is JArray;
        World.world.camera.transform.position = new Vector3(placement ? caster.current_position.x : body ? 66.5f : 67,
            placement ? caster.current_position.y : body ? 72.5f : 73, World.world.camera.transform.position.z);
        float zoom = (float?)request["zoom"] ?? 22;
        MoveCamera.instance.forceZoom(zoom);
        // 原版滚轮最小为10；开发指定的更近取景不改游戏配置，只覆盖当前测试相机。
        if (zoom < 10f)
        { World.world.camera.orthographicSize = zoom; World.world.setZoomOrthographic(zoom); }
    }

    /// <summary>同步人物坐标与所在格子。</summary>
    /// <param name="actor">人物。</param>
    /// <param name="x">横坐标。</param>
    /// <param name="y">纵坐标。</param>
    private static void Place(Actor actor, float x, float y)
    {
        actor.stopMovement();
        if (actor.under_forces) actor.stopForce();
        actor.current_position = new Vector2(x, y);
        actor.setCurrentTile(World.world.GetTileSimple((int)x, (int)y)); actor.updatePos();
    }

    /// <summary>优先采用中文本地化，内部实体保留可搜索的稳定编号。</summary>
    /// <param name="id">稳定编号。</param>
    private static string Name(string id)
    {
        if (id.StartsWith("Cultiway.CoreFormation.Skill."))
            return id.Substring("Cultiway.CoreFormation.Skill.".Length) switch
            {
                "IronSeverance" => "金煞破锋", "WoodVenomBloom" => "青木毒息", "WoodLifeReturn" => "青木回生",
                "WaterFrostBind" => "寒流叠封", "FireBrand" => "焚烬火印", "FireEmberBurst" => "焚烬爆燃",
                "EarthWard" => "厚土结界", "EarthWardImpact" => "厚土反震", "YinDrain" => "阴气汲灵",
                "MysteriousYinDrain" => "玄阴汲灵", "YangCleanse" => "阳气涤秽", "PureYangCleanse" => "纯阳涤秽",
                "ChaosEcho" => "混沌回响", "ChaosRebirthEcho" => "归墟回响", "BalancedAdaptation" => "混元适应",
                "ReservoirOrb" => "灵渊储备", "CondensedRelease" => "凝元释放", "SpiritEcho" => "灵台回响",
                "SwordChase" => "剑气追击", "SwordEmbryoStrike" => "剑胎追击", "BodyCounter" => "真形反震",
                "PrimalBodyCounter" => "真身反震", "IllusionDecoy" => "幻身替劫", "DragonMight" => "龙威震荡",
                "DragonAspectMight" => "龙相威压", "InfantGuard" => "灵婴护命", "ChaosRebirth" => "归墟再生",
                "FivePhaseStrike" => "五相追击", "SwordEmbryoAura" => "剑胎显锋", "DragonAspectBurst" => "龙相震击",
                "SpiritPlatform" => "灵台显神", "PrimalBody" => "真身镇劫", "FivePhase" => "五相轮转",
                "PureYangDomain" => "纯阳净域", "MysteriousYinDomain" => "玄阴寒域", _ => id
            };
        if (id.EndsWith("BalefulWindTribulationCenter")) return "罡风天劫·风柱";
        if (id.EndsWith("BalefulWindTribulationWave")) return "罡风天劫·风浪";
        return id.Localize();
    }

    /// <summary>先写临时文件，再完整替换，避免外部读取到半份进度。</summary>
    /// <param name="path">结果位置。</param>
    /// <param name="value">结果内容。</param>
    private static void Write(string path, object value)
    {
        string temporary = path + ".tmp";
        File.WriteAllText(temporary, JsonConvert.SerializeObject(value, Formatting.Indented));
        if (File.Exists(path)) File.Replace(temporary, path, null);
        else File.Move(temporary, path);
    }

    /// <summary>卸载临时工具时解除订阅。</summary>
    private void OnDestroy()
    {
        Application.logMessageReceived -= OnLog;
        Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured -= OnSpawn;
        SkillHitResolver.ContactResolved -= OnContact;
        SkillHitResolver.AreaResolved -= OnArea;
        SkillHitResolver.BarrierContactResolved -= OnBarrier;
    }

    /// <summary>按来源条件建立结婴显化，主动护持读取真实形成状态。</summary>
    /// <param name="owner">演示人物。</param>
    /// <param name="id">来源技能编号。</param>
    private static void PrepareFormation(ActorExtend owner, string id)
    {
        var atoms = id.Contains("Sword") ? new[] { CoreFormationAtoms.ManifestSwordEmbryo } :
            id.Contains("Dragon") ? new[] { CoreFormationAtoms.ManifestDragonAspect } :
            id.Contains("Spirit") ? new[] { CoreFormationAtoms.ManifestSpiritPlatform } :
            id.Contains("Body") ? new[] { CoreFormationAtoms.ManifestPrimalBody } :
            id.Contains("FivePhase") ? new[] { CoreFormationAtoms.TransformFivePhase } :
            id.Contains("Yang") ? new[] { CoreFormationAtoms.TransformPureYang } :
            id.Contains("Yin") ? new[] { CoreFormationAtoms.TransformMysteriousYin } : Array.Empty<CoreFormationAtomAsset>();
        var formation = new CoreFormationSnapshot
        {
            version = CoreFormationSnapshot.CurrentVersion, signature = "spell-demo." + id, canonical_name = "演示来源",
            finalized = true, realm = CoreFormationRealm.Yuanshen, strength = 4, refinement = 4,
            quality = new ItemLevel { Stage = 2, Level = 3 }, quality_score = .6f,
            atoms = atoms.Select(atom => new CoreFormationAtomState { atom_id = atom.id, weight = 1, awakening_stage = 0 }).ToArray(),
            stats = Array.Empty<CoreFormationStatValue>(), semantics = Array.Empty<SemanticContribution>(), composition = ElementComposition.Static.Fire
        };
        owner.AddComponent(new Yuanshen { formation = formation, original_body = new PhysicalBodySnapshot { actor_asset_id = "human" } });
        CoreFormationEffectResolver.Synchronize(owner);
    }

    /// <summary>正式物化并装备法宝，能力参数由当前定义计算，不手工调用特效。</summary>
    /// <param name="owner">演示人物。</param>
    /// <param name="id">法宝能力编号。</param>
    private void PrepareArtifact(ActorExtend owner, string id)
    {
        var asset = Cultiway.Content.Libraries.Manager.ArtifactAbilityLibrary.get(id);
        var atoms = typeof(ArtifactAtoms).GetProperties(Flags).Where(property => property.PropertyType == typeof(ArtifactAtomAsset))
            .Select(property => new ArtifactAtomSelection((ArtifactAtomAsset)property.GetValue(null), 2f)).ToArray();
        var level = new ItemLevel { Stage = 2, Level = 3 };
        var recipe = ArtifactMaterialSemantics.BuildDesign(level, atoms.Length); ArtifactMaterialSemantics.ApplyAtoms(recipe, atoms);
        var compose = new ArtifactAbilityComposeContext { recipe = recipe, atoms = atoms, composition_key = "法术演示", scales = ArtifactAbilityScales.Resolve(recipe) };
        var shapes = typeof(ItemShapes).GetProperties(Flags).Where(property => property.PropertyType == typeof(ArtifactShapeAsset))
            .Select(property => (ArtifactShapeAsset)property.GetValue(null)).ToArray();
        // 专用能力使用其真实器形；通用能力才按评分选择，避免相同评分始终选中剑。
        string family = typeof(ArtifactAbilities).GetProperties(Flags).Where(property => property.PropertyType == typeof(ArtifactAbilityAsset)).Single(property => property.GetValue(null) == asset).Name;
        string shapeName = family switch
        {
            "SoulShakingChime" or "PurifyingChime" or "GoldenBellBarrier" => "Bell",
            "MountainSealFall" or "SpellBanningEdict" or "MeridianSealing" => "Seal",
            "MyriadSoulBannerArray" or "CommandingBannerField" or "SpiritHostManifestation" => "Banner",
            "SpellReflection" or "TruthRevealingMirror" or "SoulCapturingStasis" => "Mirror",
            "CloudRobeShield" or "HeavenlyConcealment" or "DamageDiversion" => "Robe",
            "TreasureTowerPrison" or "LayeredRealmWard" or "TowerShadowProjection" => "Tower",
            "HeavenSwallowingGourd" or "SpiritGourdReserve" or "FiveEssenceOutpouring" => "Gourd",
            "GaleFanSweep" or "DepartingFireFan" or "CleansingWindFan" => "Fan",
            "DingFireRefinement" or "DevouringReturn" or "HundredRefinementCore" => "Ding",
            "CelestialPearlGuard" or "FivePhasePearlStrike" or "LinkedPearlResonance" => "Pearl",
            _ => null
        };
        var shape = shapeName != null ? (ArtifactShapeAsset)typeof(ItemShapes).GetProperty(shapeName, Flags).GetValue(null)
            : shapes.OrderByDescending(value => { compose.shape = value; return asset.ScoreFor(compose); }).First();
        compose.shape = shape;
        var chosen = atoms.OrderByDescending(atom =>
        {
            var single = ArtifactMaterialSemantics.BuildDesign(level, 1); ArtifactMaterialSemantics.ApplyAtoms(single, new[] { atom });
            compose.recipe = single; compose.atoms = new[] { atom }; return asset.ScoreFor(compose);
        }).Take(3).Select(value => new ArtifactAtomSelection(value.Atom, 1f)).ToArray();
        recipe = ArtifactMaterialSemantics.BuildDesign(level, chosen.Length); ArtifactMaterialSemantics.ApplyAtoms(recipe, chosen);
        compose.recipe = recipe; compose.atoms = chosen; compose.scales = ArtifactAbilityScales.Resolve(recipe);
        var design = ArtifactComposer.ComposeDesign(new ArtifactDesignRequest { Shape = shape, Level = level,
            Atoms = chosen.Select(value => value.Atom).ToArray(), Name = Name(id) });
        var blueprint = ArtifactBlueprintCodec.FromComposeResult(design);
        var instance = new ArtifactAbilityInstance { instance_id = id, ability_id = id,
            parameters = asset.ComposeParameters?.Invoke(compose) ?? Array.Empty<ArtifactAbilityValue>(),
            initial_state = asset.ComposeInitialState?.Invoke(compose) ?? Array.Empty<ArtifactAbilityValue>() };
        blueprint.AbilitySet = new ArtifactAbilitySet { abilities = new[] { instance } };
        artifactDetails = new { shape = shape.id, materials = chosen.Select(value => value.Atom.id).ToArray(), parameters = instance.parameters,
            parameterSource = "与器形及选用材料共同计算；演示仅保留被选能力" };
        artifact = ArtifactBlueprintCodec.Materialize(blueprint, caster.getName()); owner.AddSpecialItem(artifact);
        if (!owner.EquipArtifact(artifact, locked: true, mode: ArtifactEquipMode.ForcedOperating, priority: 100))
            throw new InvalidOperationException("无法装备演示法宝：" + id);
        ArtifactLoadoutPlanner.Refresh(owner, false, 0);
        var handles = new List<ActiveAbilityHandle>(); ActiveAbilityService.Collect(owner, handles);
        ability = handles.Single(handle => handle.Source == artifact && handle.EntryId == id);
    }
}
