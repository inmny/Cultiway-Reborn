// 仅由 DebugToolbox 临时安装；不加入 Source，不随模组发布，也不写玩家存档。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Friflo.Engine.ECS;
using DebugToolbox.Runtime.Scripting;
using Cultiway.Content;
using Cultiway.Content.Components;
using Cultiway.Content.Combat;
using Cultiway.Content.Artifacts;
using Cultiway.Content.Artifacts.Baibao;
using Cultiway.Content.Extensions;
using Cultiway.Content.KnightCombat;
using Cultiway.Content.Libraries;
using Cultiway.Core;
using Cultiway.Core.Components;
using Cultiway.Core.Semantics;
using Cultiway.Core.SkillLibV3;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Blueprints;
using Cultiway.Core.SkillLibV3.Components;
using Cultiway.Core.SkillLibV3.Editor;
using Cultiway.Core.SkillLibV3.Effects;
using Cultiway.Core.SkillLibV3.Utils;
using Cultiway.Core.SkillLibV3.Usage;
using Cultiway.Utils.Extension;

foreach (var old in Resources.FindObjectsOfTypeAll<MonoBehaviour>().Where(item => item != null && item.GetType().Name == "CultiwaySpellDemoRunner"))
{
    if ((bool)old.GetType().GetField("busy", BindingFlags.Instance | BindingFlags.NonPublic).GetValue(old))
        throw new InvalidOperationException("已有演示正在录制，请先等待完成或结束上一条命令");
    UnityEngine.Object.DestroyImmediate(old.gameObject);
}
var host = new GameObject("Cultiway.SpellDemo.Tool");
UnityEngine.Object.DontDestroyOnLoad(host);
var runner = host.AddComponent<CultiwaySpellDemoRunner>();
runner.Install();
return new { installed = true, catalog = runner.Root + "/catalog.json" };

/// <summary>单次安装后轮询本地请求，逐招录制；不为每招重复编译调试程序集。</summary>
public sealed class CultiwaySpellDemoRunner : MonoBehaviour
{
    /// <summary>请求与清单所在目录。</summary>
    public string Root;
    /// <summary>当前运行请求。</summary>
    private JObject request;
    /// <summary>已处理的请求编号，安装时忽略磁盘上的旧请求。</summary>
    private string handled;
    /// <summary>本次运行输出目录。</summary>
    private string output;
    /// <summary>是否正在录制。</summary>
    private bool busy;
    /// <summary>下次检查请求的实际时间。</summary>
    private float nextPoll;
    /// <summary>准备和录制过程中出现的真实错误。</summary>
    private readonly List<string> errors = new();
    /// <summary>演示人物。</summary>
    private Actor caster;
    /// <summary>受伤友军。</summary>
    private Actor friend;
    /// <summary>用于弹丸、范围与连锁的敌军。</summary>
    private readonly List<Actor> enemies = new();
    /// <summary>冻结世界背景人物，避免长时间遍历时走入演示场地。</summary>
    private readonly HashSet<long> isolated = new();
    /// <summary>来源专属技能的原始容器，保留其真实回调和消耗。</summary>
    private readonly Dictionary<string, Entity> granted = new();
    /// <summary>本轮演示用临时技能容器。</summary>
    private Entity temporarySkill;
    /// <summary>等最后一个执行体消散后才释放的临时容器。</summary>
    private readonly List<Entity> retiringSkills = new();
    /// <summary>当前法术的实际生成次数。</summary>
    private int spawned;
    /// <summary>当前观察的技能容器。</summary>
    private Entity observed;
    /// <summary>录制前的界面状态。</summary>
    private bool previousHidden;
    /// <summary>只在录制期间隐藏画布，结束时恢复原状态。</summary>
    private readonly Dictionary<Canvas, bool> canvases = new();
    /// <summary>本招正在使用的真实法宝。</summary>
    private Entity artifact;
    /// <summary>本招法宝或战技的正式能力句柄。</summary>
    private ActiveAbilityHandle ability;
    /// <summary>正在展示的骑士战技。</summary>
    private KnightTechniqueAsset technique;
    /// <summary>公共及内部成员查询。</summary>
    private const BindingFlags Flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static | BindingFlags.Instance;

    /// <summary>导出游戏中当前实际注册的技能与兼容项目。</summary>
    public void Install()
    {
        Root = Path.Combine(Cultiway.ModClass.I.GetDeclaration().FolderPath, "artifacts/spell_demo");
        Directory.CreateDirectory(Root);
        string selection = Path.Combine(Root, "request.json");
        handled = File.Exists(selection) ? (string)JObject.Parse(File.ReadAllText(selection))["id"] : null;
        var assembly = typeof(Cultiway.ModClass).Assembly;
        var core = assembly.GetType("Cultiway.Content.CoreFormationSkills", true);
        foreach (var property in core.GetProperties(Flags).Where(property => property.PropertyType == typeof(Entity)))
        {
            Entity entity = (Entity)property.GetValue(null);
            if (entity.IsAvailable() && entity.TryGetComponent(out SkillContainer skill)) granted[skill.Asset.id] = entity;
        }
        var mod = Cultiway.ModClass.I;
        var modifiers = mod.SkillV3.ModifierLib.list.Where(asset => asset.EditorSelectable && !asset.IsDisabled).ToArray();
        var trajectories = mod.SkillV3.TrajLib.list.Where(asset => asset.EditorSelectable).ToArray();
        var rows = new List<object>();
        foreach (var asset in mod.SkillV3.SkillLib.list.OrderBy(asset => asset.id, StringComparer.Ordinal))
        {
            if (asset.Animations.Count == 0 ||
                asset.id == "Cultiway.raw_anim" || !asset.CanBeLearned && !granted.ContainsKey(asset.id) && !asset.id.Contains("BalefulWindTribulation")) continue;
            string trajectory = SkillBlueprintTrajectory.ResolveDefaultId(asset);
            SkillBlueprint blueprint = Blueprint(asset, 0, trajectory);
            var context = SkillEditContext.Create(blueprint);
            bool adjustable = asset.CanBeLearned && asset.EditorSelectable;
            rows.Add(new
            {
                id = asset.id, name = Name(asset.id), variants = asset.Animations.Count,
                group = granted.ContainsKey(asset.id) ? "金丹元婴" : asset.id.Contains("BalefulWindTribulation") ? "天劫" : asset.id.StartsWith("Cultiway.KnightTechnique.") ? "骑士战技" : "基础法术",
                adjustable, trajectory, relation = asset.UseProfile.TargetRelation.ToString(),
                trajectories = trajectories.Where(item => item.CheckEditorCompatibility(context, false).IsCompatible &&
                    SkillTrajectoryCompatibility.IsCompatible(asset, item)).Select(item => item.id).ToArray(),
                modifiers = modifiers.Where(item => item.CheckEditorCompatibility(context, item.CreateDefaultSpec()).IsCompatible)
                    .Select(item => item.id).ToArray()
            });
        }
        foreach (var asset in Cultiway.Content.Libraries.Manager.ArtifactAbilityLibrary.list.Where(asset => asset.active_use != null).OrderBy(asset => asset.id))
            rows.Add(new { id = asset.id, name = Name(asset.id), variants = 1, group = "法宝主动", adjustable = false,
                trajectory = "专属动作", relation = asset.active_use.target_mode.ToString(), trajectories = Array.Empty<string>(), modifiers = Array.Empty<string>() });
        rows.Add(new { id = "Cultiway.PalmStrike", name = Name("Cultiway.PalmStrike"), variants = 1, group = "近身掌击", adjustable = false,
            trajectory = "身体接触", relation = "Hostile", trajectories = Array.Empty<string>(), modifiers = Array.Empty<string>() });
        Write(Path.Combine(Root, "catalog.json"), new
        {
            generatedAt = DateTime.UtcNow, spells = rows,
            modifiers = modifiers.Select(item => new { id = item.id, name = Name(item.id), parameters = item.CreateDefaultSpec().Parameters }).ToArray(),
            trajectories = trajectories.Select(item => new { id = item.id, name = Name(item.id) }).ToArray()
        });
    }

    /// <summary>接收新的本地运行请求。</summary>
    private void Update()
    {
        if (busy || Time.realtimeSinceStartup < nextPoll) return;
        nextPoll = Time.realtimeSinceStartup + .3f;
        string path = Path.Combine(Root, "request.json");
        if (!File.Exists(path)) return;
        var selected = JObject.Parse(File.ReadAllText(path));
        if ((string)selected["id"] == handled) return;
        request = selected; handled = (string)selected["id"]; output = (string)selected["output"];
        busy = true; previousHidden = Config.ui_main_hidden;
        Application.logMessageReceived += OnLog;
        Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured += OnSpawn;
        StartCoroutine(Guarded(Run()));
    }

    /// <summary>在请求边界记录错误，保证暂停、界面和事件订阅有明确收尾。</summary>
    /// <param name="steps">当前演示流程。</param>
    private IEnumerator Guarded(IEnumerator steps)
    {
        string failure = null;
        while (true)
        {
            bool more;
            try { more = steps.MoveNext(); }
            catch (Exception error) { failure = error.ToString(); break; }
            if (!more) break;
            yield return steps.Current;
        }
        Config.paused = true;
        Config.ui_main_hidden = previousHidden;
        CleanExecutions();
        ControllableUnit.clear(false);
        foreach (var canvas in canvases) if (canvas.Key != null) canvas.Key.enabled = canvas.Value;
        canvases.Clear();
        Application.logMessageReceived -= OnLog;
        Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured -= OnSpawn;
        Write(Path.Combine(output, "status.json"), new { done = true, error = failure, errors });
        busy = false;
    }

    /// <summary>读取独立测试世界，然后依次准备、释放和录制每一招。</summary>
    private IEnumerator Run()
    {
        var load = LoadScene();
        while (load.MoveNext()) yield return load.Current;
        int index = 0;
        foreach (JObject item in (JArray)request["cases"])
        {
            errors.Clear();
            string folder = Path.Combine(output, (string)item["key"]);
            Directory.CreateDirectory(folder); Directory.CreateDirectory(Path.Combine(folder, "frames"));
            Write(Path.Combine(output, "status.json"), new { done = false, index = ++index, current = item["key"], stage = "准备" });
            Prepare(item);
            // 法宝需要等待附加状态建立；掌击不提前推进，避免准备阶段先消耗近战冷却。
            if ((string)item["id"] != "Cultiway.PalmStrike")
            {
                Config.paused = false;
                for (int frame = 0; frame < 4; frame++) yield return null;
                Config.paused = true;
            }
            var record = Record(item, folder);
            while (record.MoveNext()) yield return record.Current;
        }
        CleanExecutions(); Config.paused = false;
        double ending = World.world.getCurWorldTime() + 1.5;
        while (World.world.getCurWorldTime() < ending) yield return null;
        Config.paused = true; CleanExecutions();
    }

    /// <summary>仅加载仓库中的测试夹具，不保存或覆盖玩家世界。</summary>
    private IEnumerator LoadScene()
    {
        if (SmoothLoader.isLoading()) throw new InvalidOperationException("游戏仍在加载，请稍后运行");
        Config.paused = true; Time.timeScale = 1;
        ControllableUnit.clear(false);
        // 已载入 Worldfall 时先恢复普通视角，避免录像标签与实际镜头不符。
        var external = AppDomain.CurrentDomain.GetAssemblies().Select(assembly => assembly.GetType("FirstPerson.WorldBoxMod", false)).FirstOrDefault(type => type != null);
        if (external != null)
        {
            object view = external.GetProperty("Instance", Flags).GetValue(null);
            external.GetMethod("SetGodView", Flags).Invoke(view, new object[] { false });
            external.GetMethod("ViewForTest", Flags).Invoke(view, new object[] { false });
        }
        string fixture = Path.Combine(Cultiway.ModClass.I.GetDeclaration().FolderPath, "Scripts/WorldSaveTests/Fixtures/world-format-1");
        World.world.save_manager.loadWorld(fixture);
        yield return null;
        while (SmoothLoader.isLoading()) yield return null;
        Config.paused = true;
        World.world.console.Hide();
        foreach (var screen in Resources.FindObjectsOfTypeAll<LoadingScreen>()) screen.gameObject.SetActive(false);
        foreach (Actor actor in World.world.units.getSimpleList().ToArray()) Place(actor, 12, 12);
        caster = World.world.units.createNewUnit("human", World.world.GetTileSimple(53, 72), pAdultAge: true);
        caster.data.name = "法术演示·施法者";
        var owner = caster.GetExtend();
        owner.AddComponent(new Xian { level = 2, wakan = 10000 });
        owner.AddComponent(new Magic { level = 3 });
        owner.SetPowerLevel((float)request["power"]);
        owner.MarkCultiwayStatsDirty();
        friend = World.world.units.createNewUnit("human", World.world.GetTileSimple(70, 72), pAdultAge: true);
        friend.data.name = "法术演示·友军"; friend.setKingdom(caster.kingdom);
        for (int index = 0; index < 7; index++)
        {
            Actor enemy = World.world.units.createNewUnit("wolf", World.world.GetTileSimple(70 + index % 3 * 4, 68 + index / 3 * 4), pAdultAge: true);
            enemy.data.name = "法术演示·敌军";
            enemies.Add(enemy);
        }
        foreach (var actor in new[] { caster, friend }.Concat(enemies)) actor.addTrait("super_health");
        // 控制施法者避免自主追加其他法术；不修改全局战斗设置。
        ControllableUnit.setControllableCreatureAndSelected(caster);
        if (external != null)
        {
            object view = external.GetProperty("Instance", Flags).GetValue(null);
            external.GetMethod("SetGodView", Flags).Invoke(view, new object[] { false });
            external.GetMethod("ViewForTest", Flags).Invoke(view, new object[] { false });
            bool ready = false;
            for (int frame = 0; frame < 300; frame++)
            {
                ready = !(bool)external.GetProperty("IsFirstPerson", Flags).GetValue(view) &&
                    !(bool)external.GetProperty("GodShown", Flags).GetValue(view) &&
                    (bool)external.GetProperty("DiveDone", Flags).GetValue(view);
                if (ready) break;
                yield return null;
            }
            if (!ready) throw new InvalidOperationException("Worldfall 尚未恢复普通观察视角");
        }
        Config.ui_main_hidden = true;
        foreach (var canvas in Resources.FindObjectsOfTypeAll<Canvas>())
        {
            canvases[canvas] = canvas.enabled; canvas.enabled = false;
        }
        PossessionUI.instance.gameObject.SetActive(false);
        Config.setWorldSpeed("x1", false);
        yield return null;
    }

    /// <summary>清理上一招，并建立对本招有效的敌军、友军或地形条件。</summary>
    /// <param name="item">本招设置。</param>
    private void Prepare(JObject item)
    {
        Config.paused = true; CleanExecutions();
        var mod = Cultiway.ModClass.I;
        foreach (var cloud in UnityEngine.Object.FindObjectsOfType<Cloud>()) if (cloud.active) cloud.kill();
        string id = (string)item["id"];
        technique = id.StartsWith("Cultiway.KnightTechnique.") ? KnightTechniqueCatalog.All.Single(value => value.id + ".Execution" == id) : null;
        caster.equipment.weapon.takeAwayItem();
        var spellAsset = mod.SkillV3.SkillLib.get(id);
        if (spellAsset != null && spellAsset.DefaultCastResourceRequirement.ResourceAssetIds.Contains(SkillCastResources.Mana.id))
            caster.equipment.setItem(World.world.items.generateItem(AssetManager.items.get("white_staff"), pActor: caster), caster);
        if (caster.GetExtend().HasComponent<Yuanshen>()) caster.GetExtend().E.RemoveComponent<Yuanshen>();
        caster.GetExtend().GetCultisys<Xian>().level = id.StartsWith("Cultiway.CoreFormation.Skill.") ? 4 : 2;
        foreach (Actor actor in new[] { caster, friend }.Concat(enemies))
        {
            actor.finishAllStatusEffects();
            var extend = actor.GetExtend();
            foreach (Entity status in extend.GetStatuses())
            {
                extend.RemoveSharedStatus(status);
                if (status.IsAvailable() && !status.Tags.Has<TagRecycle>()) status.AddTag<TagRecycle>();
            }
            actor.clearAttackTarget(); actor.attack_timer = 0;
        }
        Place(caster, 53, 72); Place(friend, 70, 76);
        for (int index = 0; index < enemies.Count; index++)
        {
            Place(enemies[index], 70 + index % 3 * 4, 68 + index / 3 * 4);
            enemies[index].addAggro(caster); caster.addAggro(enemies[index]);
        }
        var hold = Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.SpellDemo.Hold");
        if (hold == null)
        {
            var stats = new BaseStats(); stats.addTag("frozen_ai"); stats.addTag("immovable");
            hold = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.Hold").SetStats(stats).SetDuration(10000).Build();
        }
        foreach (Actor actor in new[] { caster, friend }.Concat(enemies))
        {
            if (actor != caster || technique == null && id != "Cultiway.PalmStrike") CombatStatusEffects.ApplyStatus(actor, hold, 10000, actor);
            actor.setStatsDirty(); actor.updateStats(); actor.stopMovement(); actor.data.health = Mathf.CeilToInt(actor.stats["health"]);
        }
        var background = Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.SpellDemo.Background");
        if (background == null)
        {
            var stats = new BaseStats(); stats.addTag("frozen_ai"); stats.addTag("immovable"); stats.addTag(ActorControlTags.Silenced);
            background = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.Background").SetStats(stats).SetDuration(10000).Build();
        }
        foreach (Actor actor in World.world.units.getSimpleList().ToArray())
        {
            if (actor == caster || actor == friend || enemies.Contains(actor) || !isolated.Add(actor.id)) continue;
            CombatStatusEffects.ApplyStatus(actor, background, 10000, actor);
            Place(actor, 12, 12); actor.setStatsDirty(); actor.updateStats();
        }
        // 每次还原同一片地形；世界法术则有明确的可观察前置状态。
        for (int x = 40; x < 99; x++) for (int y = 48; y < 98; y++)
        {
            var tile = World.world.GetTileSimple(x, y);
            if (tile.building != null) tile.building.removeBuildingFinal();
            tile.stopFire(); tile.removeBurn(); tile.unfreeze(99); tile.heat = 0;
            tile.removeGrass(false);
            bool patch = x >= 67 && x <= 83 && y >= 61 && y <= 80;
            bool water = patch && id.EndsWith("DrainWater");
            tile.setTileTypes(water ? TileLibrary.shallow_waters : TileLibrary.soil_low,
                              water ? null : patch && id.EndsWith("Fertilize") ? TopTileLibrary.field : TopTileLibrary.grass_low);
        }
        if (id.EndsWith("CleanLandField"))
            for (int x = 69; x <= 77; x += 2) World.world.GetTileSimple(x, 69).startFire();
        if (id.EndsWith("Fertilize"))
            for (int x = 68; x <= 80; x += 2) for (int y = 63; y <= 77; y += 2)
                World.world.buildings.addBuilding("wheat", World.world.GetTileSimple(x, y));
        if (id.EndsWith("PurificationWave")) CombatStatusEffects.ApplyStatus(friend, StatusEffects.Burn, 10, enemies[0]);
        friend.data.health = Mathf.Max(1, Mathf.CeilToInt(friend.stats["health"] * .35f));
        caster.GetExtend().GetCultisys<Xian>().wakan = 10000;
        caster.setMana(10000, pClamp: false);
        var owner = caster.GetExtend();
        if (id.StartsWith("Cultiway.CoreFormation.Skill.")) PrepareFormation(owner, id);
        if (technique != null)
        {
            if (!owner.HasCultisys<Knight>()) owner.AddComponent(new Knight { level = 8, vigor = 10000 });
            string weapon = technique.Style == KnightStyles.Lancer ? "spear_iron" : technique.Style == KnightStyles.Guardian ? "hammer_iron" : "sword_iron";
            caster.equipment.setItem(World.world.items.generateItem(AssetManager.items.get(weapon), pActor: caster), caster);
            KnightStyleMasteryService.Master(owner, technique.Style);
            SkillOwnershipService.Learn(owner, KnightTechniqueSkills.GetContainer(technique), true);
            int distance = technique == KnightTechniques.FormationCharge ? 4 : technique == KnightTechniques.SkyfallStrike ? 5 : 1;
            Place(caster, 70 - distance, 68);
            var handles = new List<ActiveAbilityHandle>(); ActiveAbilityService.Collect(owner, handles);
            ability = handles.Single(handle => handle.EntryId == technique.id);
            SkillCooldownService.Clear(owner, ability.Source);
        }
        if (id.StartsWith("Cultiway.ArtifactAbility.")) { Place(caster, 65, 68); PrepareArtifact(owner, id); }
        if (id == "Cultiway.PalmStrike")
        {
            Place(caster, 69, 68);
            enemies[0].current_position = new Vector2(69.55f, 68);
            enemies[0].setCurrentTile(World.world.GetTileSimple(69, 68)); enemies[0].updatePos();
        }
        owner.MarkCultiwayStatsDirty(); caster.setStatsDirty(); caster.updateStats();
        Camera();
        mod.CommandBuffer.Playback();
    }

    /// <summary>通过正式技能序列实际释放，并按世界时间截图，记录真实生成和受伤。</summary>
    /// <param name="item">本招设置。</param>
    /// <param name="folder">本段输出目录。</param>
    private IEnumerator Record(JObject item, string folder)
    {
        var mod = Cultiway.ModClass.I;
        string id = (string)item["id"];
        var asset = mod.SkillV3.SkillLib.get(id);
        if (!artifact.IsNull && (id == ArtifactAbilities.SpiritHostManifestation.id || id == ArtifactAbilities.FiveEssenceOutpouring.id))
        {
            var instance = artifact.GetComponent<ArtifactAbilitySet>().abilities[0];
            var storage = artifact.GetComponent<ArtifactStorageState>();
            ArtifactStorageOperations.Store(ref storage, id == ArtifactAbilities.SpiritHostManifestation.id
                ? ArtifactStorageOperations.SoulEssence : ArtifactStorageOperations.AbsorbedPower, instance.GetNumber("stored_resource_cost"));
            artifact.GetComponent<ArtifactStorageState>() = storage;
        }
        Entity skill = default;
        bool dedicated = !artifact.IsNull || technique != null || id == "Cultiway.PalmStrike";
        if (dedicated) skill = technique != null ? ability.Source : default;
        else if (granted.TryGetValue(asset.id, out Entity original)) skill = original;
        else
        {
            var blueprint = Blueprint(asset, (int)item["variant"], (string)item["trajectory"]);
            foreach (SkillModifierSpec spec in item["modifiers"].ToObject<SkillModifierSpec[]>())
            {
                blueprint.Modifiers.RemoveAll(value => value.AssetId == spec.AssetId);
                blueprint.Modifiers.Add(spec);
            }
            if (asset.CanBeLearned)
            {
                var compiled = new SkillBlueprintCompiler().Compile(blueprint, SkillBlueprintCompileMode.Preview);
                if (!compiled.Success) throw new InvalidOperationException("词条或轨迹不兼容：" + string.Join("；", compiled.Validation.Issues.Select(issue => issue.Message)));
                skill = compiled.Container;
            }
            else skill = new SkillContainerBuilder(asset).UseAnimation((int)item["variant"]).Build(SkillContainerBuildMode.SourceGranted);
            temporarySkill = skill;
        }
        observed = skill; spawned = 0;
        var relation = asset == null ? SkillUseTargetRelation.Hostile : asset.UseProfile.TargetRelation;
        BaseSimObject target = relation == SkillUseTargetRelation.Self ? caster : relation == SkillUseTargetRelation.Friendly ? friend : enemies[0];
        if (relation == SkillUseTargetRelation.WorldTile) target = enemies[0];
        var owner = caster.GetExtend();
        owner.GetCultisys<Xian>().wakan = 10000; caster.setMana(10000, pClamp: false);
        if (owner.HasCultisys<Knight>()) owner.GetCultisys<Knight>().vigor = caster.stats[BaseStatses.MaxVigor.id];
        float wakanBefore = owner.GetCultisys<Xian>().wakan, manaBefore = caster.getMana();
        int[] health = enemies.Select(actor => actor.data.health).ToArray();
        float friendBefore = friend.data.health;
        bool used;
        if (dedicated)
        {
            if (id == "Cultiway.PalmStrike")
            {
                var handles = new List<ActiveAbilityHandle>(); ActiveAbilityService.Collect(owner, handles);
                ability = handles.Single(handle => handle.ProviderId == "content.palm_strike");
            }
            var descriptor = ActiveAbilityService.Describe(owner, ability);
            if (descriptor.TargetMode == ActiveAbilityTargetMode.Self) target = caster;
            used = ActiveAbilityService.TryUse(owner, ability, new ActiveAbilityTarget(target, target.GetSimPos()), ActiveAbilityUseOrigin.Script);
        }
        else used = owner.CastSkillV3(skill, target);
        if (!used) throw new InvalidOperationException("正式施法入口拒绝：" + id +
            (dedicated ? "；" + ActiveAbilityService.ResolveControlState(owner, ability).BlockReason : ""));
        mod.CommandBuffer.Playback();
        var times = new List<double>();
        var meshes = (IList)typeof(Cultiway.ModClass).Assembly.GetType("Cultiway.Content.Combat.CombatSpatialVisualSystem", true)
            .GetField("Meshes", Flags).GetValue(null);
        int peakMeshes = 0, previewFrame = 0;
        double start = World.world.getCurWorldTime(), duration = Math.Max((double)request["duration"], id.EndsWith(".FivePhase") ? 10.5 : 0), nextCapture = 0;
        double interval = 1d / (int)request["fps"];
        float nextStatus = Time.realtimeSinceStartup + 2;
        Config.paused = false;
        // 首帧先留出起手前的场景，往后的帧均读取真实世界时间。
        while (World.world.getCurWorldTime() - start < duration)
        {
            if (File.Exists(Path.Combine(Root, "cancel"))) throw new OperationCanceledException("已取消演示");
            Camera(); Tooltip.hideTooltipNow();
            double elapsed = World.world.getCurWorldTime() - start;
            if (elapsed >= nextCapture)
            {
                if (meshes.Count > peakMeshes) { peakMeshes = meshes.Count; previewFrame = times.Count; }
                times.Add(elapsed);
                new ScreenFacade().Capture(Path.Combine(folder, "frames", (times.Count - 1).ToString("00000") + ".png"));
                nextCapture = elapsed + interval;
            }
            if (Time.realtimeSinceStartup >= nextStatus)
            {
                Write(Path.Combine(output, "status.json"), new { done = false, current = item["key"], stage = "录制", elapsed, frames = times.Count });
                nextStatus = Time.realtimeSinceStartup + 2;
            }
            yield return null;
            if (errors.Count > 0) throw new InvalidOperationException(string.Join("\n", errors));
        }
        Config.paused = true;
        yield return null; // 截图在帧尾落盘，报告必须晚于最后一次截图。
        double actual = World.world.getCurWorldTime() - start;
        Write(Path.Combine(folder, "result.json"), new
        {
            passed = (spawned > 0 || dedicated && used) && errors.Count == 0, id, item, frames = times.Count, times,
            duration = actual, spawned, peakMeshes, previewFrame, wakanBefore, wakanAfter = owner.GetCultisys<Xian>().wakan,
            manaBefore, manaAfter = caster.getMana(), friendBefore, friendAfter = friend.data.health,
            damaged = enemies.Where((actor, index) => actor.data.health < health[index]).Count(), errors
        });
    }

    /// <summary>按稳定定义建立单一法术蓝图，不读取或使用组合样板。</summary>
    /// <param name="asset">实际法术。</param>
    /// <param name="variant">旧变体编号。</param>
    /// <param name="trajectory">有效轨迹。</param>
    private static SkillBlueprint Blueprint(SkillEntityAsset asset, int variant, string trajectory)
    {
        var blueprint = new SkillBlueprint
        {
            EntityAssetId = asset.id, AnimationIndex = variant, TrajectoryAssetId = trajectory,
            CastResourceRequirement = asset.DefaultCastResourceRequirement.DeepClone(),
            AiNamingEnabled = false, NameMode = SkillBlueprintNameMode.Custom, CustomName = Name(asset.id)
        };
        SkillBlueprintModifierRules.EnsureRequiredModifiers(blueprint, asset);
        return blueprint;
    }

    /// <summary>只移除测试世界中的瞬时执行和显示缓存，不改原始资产。</summary>
    private void CleanExecutions()
    {
        var mod = Cultiway.ModClass.I;
        if (artifact.IsAvailable() && caster != null)
        {
            caster.GetExtend().UnequipArtifact(artifact, suppressAutoEquip: true);
            if (artifact.HasComponent<Position>()) artifact.GetComponent<Position>().value = new Vector3(12, 12);
        }
        artifact = default;
        typeof(Cultiway.Core.SkillLibV3.Manager).GetMethod("ClearQueuedSkillSequences", Flags).Invoke(mod.SkillV3, null);
        foreach (Entity entity in mod.W.Query<SkillCastSequence>().Entities.ToArray())
            if (!entity.Tags.Has<TagPrefab>() && !entity.Tags.Has<TagRecycle>()) entity.AddTag<TagRecycle>();
        foreach (Entity entity in mod.W.Query<SkillEntity>().Entities.ToArray())
        {
            if (entity.Tags.Has<TagPrefab>()) continue;
            if (entity.HasComponent<SkillAnimationLifecycleState>())
                entity.GetComponent<SkillAnimationLifecycleState>().Phase = SkillAnimationPhase.RecycleReady;
            if (!entity.Tags.Has<TagRecycle>()) entity.AddTag<TagRecycle>();
        }
        if (temporarySkill.IsAvailable()) retiringSkills.Add(temporarySkill);
        temporarySkill = default; observed = default;
        var referenced = new HashSet<Entity>(mod.W.Query<SkillEntity>().Entities
            .Where(entity => !entity.Tags.Has<TagPrefab>()).Select(entity => entity.GetComponent<SkillEntity>().SkillContainer));
        for (int index = retiringSkills.Count - 1; index >= 0; index--)
        {
            Entity container = retiringSkills[index];
            if (container.IsAvailable() && referenced.Contains(container)) continue;
            if (container.IsAvailable()) SkillBlueprintCompiler.Recycle(container);
            retiringSkills.RemoveAt(index);
        }
        typeof(Cultiway.ModClass).Assembly.GetType("Cultiway.Content.Visuals.BattleSpellVisualRuntime", true)
            .GetMethod("Clear", Flags).Invoke(null, null);
    }

    /// <summary>只统计当前演示容器实际建立的执行体。</summary>
    /// <param name="entity">实际执行体。</param>
    private void OnSpawn(Entity entity)
    {
        if (entity.GetComponent<SkillEntity>().SkillContainer == observed) spawned++;
    }

    /// <summary>收集本次运行的游戏错误，不把启动前的历史错误算入结果。</summary>
    /// <param name="message">日志内容。</param>
    /// <param name="stack">调用位置。</param>
    /// <param name="type">日志类别。</param>
    private void OnLog(string message, string stack, LogType type)
    {
        if (type is LogType.Error or LogType.Exception or LogType.Assert) errors.Add(message + "\n" + stack);
    }

    /// <summary>固定普通观察视角，所有法术使用同一尺度便于比较。</summary>
    private static void Camera()
    {
        World.world.camera.transform.position = new Vector3(67, 73, World.world.camera.transform.position.z);
        MoveCamera.instance.forceZoom(22);
    }

    /// <summary>同步人物坐标与所在格子。</summary>
    /// <param name="actor">人物。</param>
    /// <param name="x">横坐标。</param>
    /// <param name="y">纵坐标。</param>
    private static void Place(Actor actor, int x, int y)
    {
        actor.stopMovement();
        if (actor.under_forces) actor.stopForce();
        actor.current_position = new Vector2(x, y);
        actor.setCurrentTile(World.world.GetTileSimple(x, y)); actor.updatePos();
    }

    /// <summary>优先采用中文本地化，内部实体保留可搜索的稳定编号。</summary>
    /// <param name="id">稳定编号。</param>
    private static string Name(string id)
    {
        if (id.StartsWith("Cultiway.CoreFormation.Skill."))
            return id.Substring("Cultiway.CoreFormation.Skill.".Length) switch
            {
                "IronSeverance" => "金煞破锋", "WoodVenomBloom" => "青木毒息", "WoodLifeReturn" => "青木回生",
                "WaterFrostBind" => "寒流叠封", "FireBrand" => "焚烬火印", "FireEmberBurst" => "焚烬爆燃",
                "EarthWard" => "厚土结界", "EarthWardImpact" => "厚土反震", "YinDrain" => "阴气汲灵",
                "MysteriousYinDrain" => "玄阴汲灵", "YangCleanse" => "阳气涤秽", "PureYangCleanse" => "纯阳涤秽",
                "ChaosEcho" => "混沌回响", "ChaosRebirthEcho" => "归墟回响", "BalancedAdaptation" => "混元适应",
                "ReservoirOrb" => "灵渊储备", "CondensedRelease" => "凝元释放", "SpiritEcho" => "灵台回响",
                "SwordChase" => "剑气追击", "SwordEmbryoStrike" => "剑胎追击", "BodyCounter" => "真形反震",
                "PrimalBodyCounter" => "真身反震", "IllusionDecoy" => "幻身替劫", "DragonMight" => "龙威震荡",
                "DragonAspectMight" => "龙相威压", "InfantGuard" => "灵婴护命", "ChaosRebirth" => "归墟再生",
                "FivePhaseStrike" => "五相追击", "SwordEmbryoAura" => "剑胎显锋", "DragonAspectBurst" => "龙相震击",
                "SpiritPlatform" => "灵台显神", "PrimalBody" => "真身镇劫", "FivePhase" => "五相轮转",
                "PureYangDomain" => "纯阳净域", "MysteriousYinDomain" => "玄阴寒域", _ => id
            };
        if (id.EndsWith("BalefulWindTribulationCenter")) return "罡风天劫·风柱";
        if (id.EndsWith("BalefulWindTribulationWave")) return "罡风天劫·风浪";
        return id.Localize();
    }

    /// <summary>先写临时文件，再完整替换，避免外部读取到半份进度。</summary>
    /// <param name="path">结果位置。</param>
    /// <param name="value">结果内容。</param>
    private static void Write(string path, object value)
    {
        string temporary = path + ".tmp";
        File.WriteAllText(temporary, JsonConvert.SerializeObject(value, Formatting.Indented));
        if (File.Exists(path)) File.Replace(temporary, path, null);
        else File.Move(temporary, path);
    }

    /// <summary>卸载临时工具时解除订阅。</summary>
    private void OnDestroy()
    {
        Application.logMessageReceived -= OnLog;
        Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured -= OnSpawn;
    }

    /// <summary>按来源条件建立结婴显化，主动护持读取真实形成状态。</summary>
    /// <param name="owner">演示人物。</param>
    /// <param name="id">来源技能编号。</param>
    private static void PrepareFormation(ActorExtend owner, string id)
    {
        var atoms = id.Contains("Sword") ? new[] { CoreFormationAtoms.ManifestSwordEmbryo } :
            id.Contains("Dragon") ? new[] { CoreFormationAtoms.ManifestDragonAspect } :
            id.Contains("Spirit") ? new[] { CoreFormationAtoms.ManifestSpiritPlatform } :
            id.Contains("Body") ? new[] { CoreFormationAtoms.ManifestPrimalBody } :
            id.Contains("FivePhase") ? new[] { CoreFormationAtoms.TransformFivePhase } :
            id.Contains("Yang") ? new[] { CoreFormationAtoms.TransformPureYang } :
            id.Contains("Yin") ? new[] { CoreFormationAtoms.TransformMysteriousYin } : Array.Empty<CoreFormationAtomAsset>();
        var formation = new CoreFormationSnapshot
        {
            version = CoreFormationSnapshot.CurrentVersion, signature = "spell-demo." + id, canonical_name = "演示来源",
            finalized = true, realm = CoreFormationRealm.Yuanshen, strength = 4, refinement = 4,
            quality = new ItemLevel { Stage = 2, Level = 3 }, quality_score = .6f,
            atoms = atoms.Select(atom => new CoreFormationAtomState { atom_id = atom.id, weight = 1, awakening_stage = 0 }).ToArray(),
            stats = Array.Empty<CoreFormationStatValue>(), semantics = Array.Empty<SemanticContribution>(), composition = ElementComposition.Static.Fire
        };
        owner.AddComponent(new Yuanshen { formation = formation, original_body = new PhysicalBodySnapshot { actor_asset_id = "human" } });
        CoreFormationEffectResolver.Synchronize(owner);
    }

    /// <summary>正式物化并装备法宝，能力参数由当前定义计算，不手工调用特效。</summary>
    /// <param name="owner">演示人物。</param>
    /// <param name="id">法宝能力编号。</param>
    private void PrepareArtifact(ActorExtend owner, string id)
    {
        var asset = Cultiway.Content.Libraries.Manager.ArtifactAbilityLibrary.get(id);
        var atoms = typeof(ArtifactAtoms).GetProperties(Flags).Where(property => property.PropertyType == typeof(ArtifactAtomAsset))
            .Select(property => new ArtifactAtomSelection((ArtifactAtomAsset)property.GetValue(null), 2f)).ToArray();
        var level = new ItemLevel { Stage = 2, Level = 3 };
        var recipe = ArtifactMaterialSemantics.BuildDesign(level, atoms.Length); ArtifactMaterialSemantics.ApplyAtoms(recipe, atoms);
        var compose = new ArtifactAbilityComposeContext { recipe = recipe, atoms = atoms, composition_key = "法术演示", scales = ArtifactAbilityScales.Resolve(recipe) };
        var shapes = typeof(ItemShapes).GetProperties(Flags).Where(property => property.PropertyType == typeof(ArtifactShapeAsset))
            .Select(property => (ArtifactShapeAsset)property.GetValue(null)).ToArray();
        var shape = shapes.OrderByDescending(value => { compose.shape = value; return asset.ScoreFor(compose); }).First(); compose.shape = shape;
        var design = ArtifactComposer.ComposeDesign(new ArtifactDesignRequest { Shape = shape, Level = level, Atoms = new[] { ArtifactAtoms.Iron }, Name = Name(id) });
        var blueprint = ArtifactBlueprintCodec.FromComposeResult(design);
        var instance = new ArtifactAbilityInstance { instance_id = id, ability_id = id,
            parameters = asset.ComposeParameters?.Invoke(compose) ?? Array.Empty<ArtifactAbilityValue>(),
            initial_state = asset.ComposeInitialState?.Invoke(compose) ?? Array.Empty<ArtifactAbilityValue>() };
        blueprint.AbilitySet = new ArtifactAbilitySet { abilities = new[] { instance } };
        artifact = ArtifactBlueprintCodec.Materialize(blueprint, caster.getName()); owner.AddSpecialItem(artifact);
        if (!owner.EquipArtifact(artifact, locked: true, mode: ArtifactEquipMode.ForcedOperating, priority: 100))
            throw new InvalidOperationException("无法装备演示法宝：" + id);
        ArtifactLoadoutPlanner.Refresh(owner, false, 0);
        var handles = new List<ActiveAbilityHandle>(); ActiveAbilityService.Collect(owner, handles);
        ability = handles.Single(handle => handle.Source == artifact && handle.EntryId == id);
    }
}
