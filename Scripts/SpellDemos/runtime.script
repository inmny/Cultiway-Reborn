    node = wave.Node, time = wave.WorldTime,
    operation = wave.Operation, pulse = wave.Pulse, waterCasts = wave.WaterCasts,
    route = wave.Route.Select(p => new[] { p.x, p.y, p.z }).ToArray(), targets = wave.Targets,
    before = wave.HealthBefore, after = wave.HealthAfter, spent = wave.Spent, remaining = wave.Remaining,
    responses = wave.Responses.Select(r => new
    {
        target = r.TargetId, forceApplied = r.ForceApplied, staggerSeconds = r.StaggerSeconds,
        bindSeconds = r.BindSeconds,
        lost = r.Damage.HealthLost, shieldAbsorbed = r.Damage.ShieldAbsorbed,
        velocityChange = new[] { r.VelocityChange.x, r.VelocityChange.y, r.VelocityChange.z }
    }).ToArray()
});

