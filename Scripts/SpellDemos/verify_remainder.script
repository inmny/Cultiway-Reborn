// 正常结束后的真实余量、分支分配、材料、身份、回退、正式命中和独立保存。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using UnityEngine;
using Cultiway.Core;
using Cultiway.Core.Skills;
using Cultiway.Core.Visuals.Forms;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Content.Skills;
using Cultiway.Content.Combat;
using Cultiway.Content.Components;
using Cultiway.Utils.Extension;
const BindingFlags Flags=BindingFlags.Instance|BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/remainder");Directory.CreateDirectory(folder);
var checks=new List<string>();void Check(bool v,string name){if(!v)throw new InvalidOperationException(name);checks.Add(name);}
void Reject(AbilityDefinition d,string name){try{AbilityCompiler.Compile(d);}catch(InvalidDataException){checks.Add(name);return;}throw new InvalidOperationException(name);}
AbilityDefinition Read(string name)=>JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/"+name+".json")));
AbilityDefinition Basic()=>new AbilityDefinition{Id="test.remainder",Resource="none",Cost=0,Lifetime=5,Root=new ConstructionNode{Id="source",Form="sword",Matter="water",Offset=new[]{2f,0f,1f},DisappearAt=1,ContactGroup="shared",Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Fly,Vector=new[]{3f,0f,0f},WorldVelocity=true,InheritVelocity=false}},Children=new[]{new ConstructionNode{Id="after",Form="branch",Matter="wood",DisappearAt=2,Activation=new ConstructionActivation{Trigger=ConstructionChangeTrigger.End,InheritRemainder=true}}}}};
AbilityCast Cast(AbilityDefinition d)=>new(AbilityCompiler.Compile(d),Matrix4x4.identity,inputs:new AbilityInputs(Vector3.zero,Vector3.right*16,Vector3.right,1),force:20);
List<FormVisualInstance> Views(AbilityCast c){var list=new List<FormVisualInstance>();c.AppendVisuals(list);return list;}
List<AbilityCapsule> Shapes(AbilityCast c){var list=new List<AbilityCapsule>();c.AppendContacts(list);return list;}
void Spend(AbilityCast c,int node,float amount)=>typeof(AbilityCast).GetMethod("ConsumeForce",Flags).Invoke(c,new object[]{node,amount});
void End(AbilityCast c,int node)=>typeof(AbilityCast).GetMethod("EndNode",Flags).Invoke(c,new object[]{node});
int Authority(AbilityCast c,int node)=>(int)typeof(AbilityCast).GetMethod("AuthorityNode",Flags).Invoke(c,new object[]{node});
var d=Basic();var c=Cast(d);Check(c.NodeAge(1)<0&&c.RemainingForce(1)==0&&Views(c).Count==1,"等待后段没有预分配力量或提前显示");c.Advance(.4f,Vector3.zero);Spend(c,0,5);Check(c.RemainingForce(0)==15&&c.RemainingForce(1)==0,"未结束时保留来源真正余力");c.Advance(1.01f-c.Age,Vector3.zero);Check(c.RemainingForce(0)==0&&c.RemainingForce(1)==15&&Mathf.Abs(c.NodeAge(1)-.01f)<.00001f,"正常结束在共同边界交接十五点余力并清空来源");Check(Views(c).Count==1&&Views(c)[0].Resource.Description.Id=="branch"&&c.Matter(1).Id=="water","后段更换真实形体并继承结束时的实际材料");Check(c.Velocity(1)==new Vector3(3,0,0)&&Authority(c,1)==0,"独立后段继承真实速度和控制身份");Check(c.ContactGroup(0)==c.ContactGroup(1),"来源与后段使用相同真实命中预算");var pos=Views(c)[0].Transform.GetColumn(3);c.Advance(.2f,Vector3.zero);Check(Mathf.Abs(Views(c)[0].Transform.m03-pos.x-.6f)<.0001f,"继承运动从实际结束点继续而非回到原放置位置");c.Advance(2,Vector3.zero);Check(c.Finished&&Views(c).Count==0,"后段按自己的存在窗口回收");
var split=Basic();split.Root.Children=new[]{new ConstructionNode{Id="left",Form="branch",Strength=3,DisappearAt=2,Activation=new ConstructionActivation{Trigger=ConstructionChangeTrigger.End,InheritRemainder=true}},new ConstructionNode{Id="right",Form="branch",Strength=1,DisappearAt=2,Activation=new ConstructionActivation{Trigger=ConstructionChangeTrigger.End,Delay=.2f,InheritRemainder=true}}};c=Cast(split);c.Advance(.2f,Vector3.zero);Spend(c,0,4);End(c,0);Check(c.RemainingForce(1)==12&&c.RemainingForce(2)==4&&c.RemainingForce(0)==0,"多个后段按三比一分配真实十六点余力");Check(c.NodeAge(2)<0&&c.RemainingForce(2)==4,"延迟后段保留已确认的份额且尚未生效");c.Advance(.21f,Vector3.zero);Check(c.NodeAge(2)>=0&&c.RemainingForce(2)==4,"来源清理不取消已经接受的延迟交接");
var nested=Basic();nested.Root.Children[0].Children=new[]{new ConstructionNode{Id="child",Form="sword",Strength=3},new ConstructionNode{Id="decoration",Form="branch",ContactRole=ConstructionContactRole.Decoration}};c=Cast(nested);Check(Enumerable.Range(1,3).All(i=>c.RemainingForce(i)==0),"嵌套分支的普通后代同样没有额外初始力量");c.Advance(.2f,Vector3.zero);Spend(c,0,4);End(c,0);Check(c.RemainingForce(1)==4&&c.RemainingForce(2)==12&&c.RemainingForce(3)==0,"分支内部也按真实作用部位分配，装饰不吞占或增加攻击量");Check(Enumerable.Range(1,3).All(i=>c.ContactGroup(i)==c.ContactGroup(0)&&c.Matter(i).Id=="water"&&Authority(c,i)==0),"嵌套部位延续共同接触组、材料和真实控制者");
var chain=Basic();chain.Root.Children[0].DisappearAt=.6f;chain.Root.Children[0].Children=new[]{new ConstructionNode{Id="third",Form="sword",Activation=new ConstructionActivation{Trigger=ConstructionChangeTrigger.End,InheritRemainder=true}}};c=Cast(chain);c.Advance(1.8f,Vector3.zero);Check(c.RemainingForce(0)==0&&c.RemainingForce(1)==0&&c.RemainingForce(2)==20&&c.NodeAge(2)>=0,"后段可以再次交接，力量没有翻倍");
var early=Basic();early.Root.Children[0].Children=new[]{new ConstructionNode{Id="early",Form="sword",Activation=new ConstructionActivation{Source="root",Trigger=ConstructionChangeTrigger.ActorContact}}};c=Cast(early);c.ConfirmContact(0,1);Check(c.NodeAge(2)<0&&Views(c).Count==1,"接收分支里的独立事件即使先到达，也要等待真实交接开始");c.Advance(1.01f,Vector3.zero);Check(c.NodeAge(2)>=0&&c.NodeAge(2)<.02f&&c.RemainingForce(1)==10&&c.RemainingForce(2)==10,"等待中的事件保留事实，真实交接后从零开始且共享原余力");
var frozen=Basic();frozen.Root.Operations=frozen.Root.Operations.Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.ConvertMatter,Matter="ice",At=.5f}}).ToArray();c=Cast(frozen);c.Advance(1.1f,Vector3.zero);Check(c.Matter(1).Id=="ice"&&c.IsShapeHeld(1),"材料变化后的冰态和保持状态随真实结束继承");
c=Cast(Basic());c.Advance(.3f,Vector3.zero);typeof(AbilityCast).GetMethod("Reflect",Flags).Invoke(c,new object[]{0,Vector3.right,Vector3.zero,new Vector3(-8,0,0)});End(c,0);Check(c.Reflections(1)==1&&c.Velocity(1).x<0&&Authority(c,1)==0,"反射后结束沿用新方向和身份键");typeof(AbilityCast).GetMethod("Reflect",Flags).Invoke(c,new object[]{1,Vector3.right,Vector3.zero,Vector3.right*8});Check(Authority(c,1)==1&&c.Reflections(1)==2,"后段再次被反射时取得自身新身份，不修改已结束来源");
c=Cast(Basic());c.Advance(.3f,Vector3.zero);Spend(c,0,20);Check(c.RemainingForce(1)==0&&Shapes(c).Count==0&&Views(c).Count==1,"真正耗尽仍可形成无害残留，零余力不提供攻击形状");
c=Cast(split);c.Advance(.3f,Vector3.zero);typeof(AbilityCast).GetMethod("SaveStep",Flags).Invoke(c,null);Spend(c,0,4);c.Advance(1,Vector3.zero);var expected=Views(c).Select(v=>v.Transform).ToArray();typeof(AbilityCast).GetMethod("RestoreStep",Flags).Invoke(c,null);Check(c.RemainingForce(0)==20&&c.RemainingForce(1)==0&&c.NodeAge(1)<0,"预测回退恢复未发生的交接及初始力量");Spend(c,0,4);c.Advance(1,Vector3.zero);Check(Views(c).Select(v=>v.Transform).SequenceEqual(expected)&&c.RemainingForce(1)==12&&c.RemainingForce(2)==4,"回退重跑得到相同姿态、余力和延迟");
c=Cast(Basic());c.Cancel();c.Advance(2,Vector3.zero);Check(c.Finished&&c.NodeAge(1)<0,"取消施放不会生成结束后段");var limited=Basic();limited.Root.DisappearAt=null;c=Cast(limited);c.Advance(5,Vector3.zero);Check(c.Finished&&c.NodeAge(1)<0,"整次上限结束不越界生成新后段");var old=Basic();old.Root.Children[0].Activation.InheritRemainder=false;c=Cast(old);End(c,0);Check(c.RemainingForce(1)==20&&c.Matter(1).Id=="wood","旧事件资料保留原本独立部位的语义");
var bad=Basic();bad.Root.Children[0].Activation.Trigger=ConstructionChangeTrigger.Clash;Reject(bad,"非结束事件不能偷偷转移余量");bad=Basic();bad.Root.Children[0].Activation.Placement=ConstructionEventPlacement.Attached;Reject(bad,"已经结束的来源不能承载交接分支");bad=Basic();bad.Root.ContactRole=ConstructionContactRole.Decoration;Reject(bad,"装饰来源不能伪造可交接力量");bad=Basic();bad.Root.Contact=new ConstructionContactPolicy{MaximumPerTarget=1};bad.Root.Children[0].Contact=new ConstructionContactPolicy{MaximumPerTarget=2};Reject(bad,"交接分支不能绕开原接触组的次数规则");
var water=Read("鲸散后流");var wood=Read("枯枝余势");var ward=Read("余流验证迎击");

Config.paused=true;Game.Resume();Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;
var runnerType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=runnerType.GetProperty("Instance").GetValue(null);bool Boundary()=>(bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner);await Game.WaitUntil(Boundary,1800);
var stats=new BaseStats();stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.MotionHold").SetStats(stats).SetDuration(10000).Build();
void Place(Actor a,float x,float y){a.stopMovement();a.current_position=new Vector2(x,y);a.setCurrentTile(World.world.GetTileSimple((int)x,(int)y));a.updatePos();}
foreach(var a in World.world.units.getSimpleList().ToArray()){CombatStatusEffects.ApplyStatus(a,hold,10000,a);a.setStatsDirty();a.updateStats();Place(a,12,12);}
Actor Make(string name,int x,int y){var a=World.world.units.createNewUnit("human",World.world.GetTileSimple(x,y),pAdultAge:true,pSpawnWithItems:false);a.data.name=name;a.addTrait("super_health");CombatStatusEffects.ApplyStatus(a,hold,10000,a);a.setStatsDirty();a.updateStats();a.attack_timer=999;Place(a,x,y);return a;}
var actor=Make("余量交接创造者",64,72);var first=Make("第一接触目标",72,72);var wolf=World.world.units.createNewUnit("wolf",World.world.GetTileSimple(12,12),pAdultAge:true);CombatStatusEffects.ApplyStatus(wolf,hold,10000,wolf);
foreach(var enemy in new[]{first}){enemy.setKingdom(wolf.kingdom);actor.addAggro(enemy);enemy.addAggro(actor);}var owner=actor.GetExtend();owner.AddComponent(new Xian{level=2,wakan=10000});

var rival=first.GetExtend();rival.AddComponent(new Xian{level=2,wakan=10000});ConstructedAbilityService.Register(ward);ConstructedAbilityService.Learn(rival,ward.Id);foreach(var definition in new[]{water,wood}){ConstructedAbilityService.Register(definition);ConstructedAbilityService.Learn(owner,definition.Id);}
async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,1800);Config.paused=true;await Game.WaitUntil(Boundary,1800);}
bool Fire(AbilityDefinition definition)=>ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,definition.Id),new ActiveAbilityTarget(first,first.GetSimPos()),ActiveAbilityUseOrigin.Script);
var clashes=new List<ConstructedClash>();void Clash(ConstructedClash hit){if(hit.LeftSource==actor.id||hit.RightSource==actor.id)clashes.Add(hit);}ConstructedAbilityService.ClashConfirmed+=Clash;
var contacts=new List<ConstructedContact>();void Hit(ConstructedContact hit){if(hit.SourceId==actor.id)contacts.Add(hit);}ConstructedAbilityService.ContactConfirmed+=Hit;
try{Place(first,80,72);foreach(var definition in new[]{water,wood}){int startClashes=clashes.Count;float balance=owner.GetCultisys<Xian>().wakan;Check(ActiveAbilityService.TryUse(rival,new ActiveAbilityHandle("content.constructed",rival.E,ward.Id),new ActiveAbilityTarget(actor,actor.GetSimPos()),ActiveAbilityUseOrigin.Script)&&Fire(definition),definition.Name+"经正式学习和施放入口受理");await Advance(definition.Lifetime+.2f);Check(balance-owner.GetCultisys<Xian>().wakan==definition.Cost,definition.Name+"结束后的真实后段不重复支付");Check(clashes.Count>startClashes,definition.Name+"原形在结束前承受真实交锋损耗");Check(contacts.Any(h=>h.AbilityId==definition.Id&&h.Node>0&&h.TargetId==first.id),definition.Name+"交接后的独立部位真实命中指定目标");}}
finally{ConstructedAbilityService.ContactConfirmed-=Hit;ConstructedAbilityService.ClashConfirmed-=Clash;Config.paused=true;}
var created=new List<AbilityDefinition>();for(int seed=0;seed<24;seed++)created.Add(ConstructionEditing.Access.Read(ConstructedAbilityService.Create(owner,seed)));bool HasRemainder(ConstructionNode node)=>node!=null&&(node.Activation?.InheritRemainder==true||node.Children.Any(HasRemainder));Check(created.Any(a=>HasRemainder(a.Root)),"修士创作可使用同一余量交接条件");
foreach(var unit in World.world.units.getSimpleList())foreach(var state in unit.GetExtend().GetStatuses().ToArray())if(state.GetComponent<Cultiway.Core.Components.StatusComponent>().Type.id==hold.id)unit.GetExtend().RemoveSharedStatus(state);
SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));var saves=Cultiway.ModClass.I.WorldSaves;File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,actor=actor.id,rival=first.id,opponent=saves.Actors.Capture(rival,"remainder"),world=saves.World.Capture(World.world,"remainder"),person=saves.Actors.Capture(owner,"remainder")},Formatting.Indented));
var result=new{passed=true,checks,clashes=clashes.Select(h=>new{h.LeftSource,h.RightSource,h.Absorbed,h.LeftRemaining,h.RightRemaining,h.LeftAge}).ToArray(),created=created.Count,inherited=created.Count(a=>HasRemainder(a.Root)),contacts=contacts.Select(h=>new{h.AbilityId,h.CastId,h.Node,h.TargetId,h.Age}).ToArray()};File.WriteAllText(Path.Combine(folder,"checks.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
