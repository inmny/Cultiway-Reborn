// 同一原塔起飞、搭载、移动和回到手边，验证实际景象和乘客恢复。
PrepareArtifactArena(59, 83, 65, 80);
Actor source = Make(64.35f), passenger = Make(72f);
var owner = source.GetExtend();
Entity rider = passenger.GetExtend().E;
CombatStatusEffects.ApplyStatus(source, boost, 10000f, source);
owner.MarkCultiwayStatsDirty();
Ready(source);
await Advance(.13f);
Place(source, 64.35f);
Place(passenger, 72f);
passenger.joinKingdom(source.kingdom);
World.world.console.Hide();
WorldTip.hideNow();
Tooltip.hideTooltipNow();

var asset = ArtifactAbilities.ArtifactRiding;
var recipe = ArtifactBlueprintCodec.FromComposeResult(ArtifactComposer.ComposeDesign(new ArtifactDesignRequest
{
    Shape = ItemShapes.Tower,
    Atoms = [ArtifactAtoms.RealmTower, ArtifactAtoms.SpatialCrystal, ArtifactAtoms.VoidSailCore, ArtifactAtoms.CloudRidingScript],
    Level = new ItemLevel { Stage = 3, Level = 8 }, Name = "御器载行原塔"
}));
var abilities = recipe.AbilitySet.abilities.Select(value => value.ability_id).ToArray();
Check(abilities.Contains(asset.id), "正式配方得到御器载行", abilities);
Entity item = ArtifactBlueprintCodec.Materialize(recipe, source.getName());
owner.AddSpecialItem(item);
Check(owner.EquipArtifact(item, locked: true, mode: ArtifactEquipMode.ForcedOperating, priority: 100),
    "正式装备载具原件");
await Advance(.24f);

var ability = item.GetComponent<ArtifactAbilitySet>().abilities.Single(value => value.ability_id == asset.id);
var toggle = service.Assembly.GetType("Cultiway.Content.ControlledCultivatorFlightControls")
    .GetMethod("ToggleManualFlight", F);
var nativeMove = typeof(Actor).GetMethod("updatePossessedMovementTowards", F);
var poseReader = typeof(ArtifactAppearanceRenderer).GetMethod("TryGetSpatialPose", F);
var meshes = (IEnumerable)service.Assembly.GetType("Cultiway.Content.Combat.CombatSpatialVisualSystem")
    .GetField("Meshes", F).GetValue(null);
object windModel = service.Assembly.GetType("Cultiway.Content.Visuals.ArtifactVehicleWakeGeometry")
    .GetField("Surface", F).GetValue(null);
object[] Wake() => meshes.Cast<object>().Where(row => ReferenceEquals(Field(row, "Model"), windModel)).ToArray();
Vector3 Pose()
{
    object[] args = { item, null };
    return (bool)poseReader.Invoke(null, args) ? (Vector3)Field(args[1], "Position") : Vector3.negativeInfinity;
}
bool Flying() => source.data.hasFlag(ContentActorDataKeys.IsFlying_flag);
bool Toggle() => (bool)toggle.Invoke(null, null);
bool Vehicle()
{
    var links = owner.E.GetRelations<ArtifactVehicleRelation>();
    return links.Length == 1 && links[0].artifact == item && links[0].ability_instance_id == ability.instance_id;
}
bool Rider()
{
    var links = owner.E.GetRelations<ArtifactVehiclePassengerRelation>();
    return links.Length == 1 && links[0].passenger == rider &&
           rider.TryGetComponent(out ArtifactVehiclePassenger seat) && seat.driver == owner.E && seat.seat_index == 0;
}
float Speed()
{
    source.precalcMovementSpeed(true);
    return (float)Field(source, "_current_combined_movement_speed");
}

try
{
    float groundSpeed = Speed();
    Place(passenger, 65.7f);
    Check(!ArtifactVehicleService.TryBoard(source, passenger) && !Vehicle() && Wake().Length == 0,
        "地面不能搭载，器身没有飞行风面");
    Place(passenger, 72f);
    bool started = Toggle();
    Check(started && Flying() && Vehicle() && !Rider() && ControllableUnit.isControllingUnit(source) &&
          !owner.HasComponent<Xian>(),
        "原控制入口真实起飞，远处同伴没有被拉上载具",
        new { started, flying = Flying(), vehicle = Vehicle(), boarded = Rider(),
            state = item.GetComponent<ArtifactAbilityRuntime>().control_state.ToString() });
    await Advance(.53f);
    float multiplier = ability.GetNumber("vehicle_speed_multiplier");
    int capacity = ability.GetInteger("passenger_capacity");
    float flightSpeed = Speed();
    Check(ArtifactVehicleService.TryResolve(source, out var candidate) && candidate.artifact == item &&
          candidate.passenger_capacity == capacity && Mathf.Abs(flightSpeed - groundSpeed * multiplier) < .1f &&
          source.position_height >= ContentSetting.FlyHeight - .1f && !ArtifactVehicleService.TryBoard(source, passenger) &&
          Wake().Length == 0,
        "实际飞行使用原速度和容量，悬停没有前行风面",
        new { capacity, multiplier, groundSpeed, flightSpeed, height = source.position_height });

    Place(passenger, 65.7f);
    bool oldFlying = passenger.isFlying();
    Check(ArtifactVehicleService.TryBoard(source, passenger) && Rider() && passenger.isFlying() &&
          ArtifactVehicleService.TryBoard(source, passenger),
        "近旁同伴进入原件的首个座位，重复确认仍为同一座位");
    Vector3 before = Pose();
    Vector2 start = source.current_position;
    for (int i = 0; i < 14; i++)
    {
        // 复用原附身移动函数，输入期望方向，由游戏计算速度和位移。
        nativeMove.Invoke(source, new object[] { .036f, source.current_position + Vector2.right * 2f });
        source.updatePos();
        await Advance(.036f);
    }
    await Game.NextFrame();
    Vector3 after = Pose();
    object[] wind = Wake();
    bool anchored = wind.Length == 1 && Vector3.Distance((Vector3)Field(wind[0], "Position"), after) < .35f &&
        Vector3.Dot((Quaternion)Field(wind[0], "Rotation") * Vector3.up, Vector3.right) > .85f;
    float distance = source.current_position.x - start.x;
    float seatDistance = Vector2.Distance(passenger.current_position, source.current_position + Vector2.down * .38f);
    float seatHeight = passenger.position_height - source.position_height;
    bool boarded = Rider(), passengerFlying = passenger.isFlying();
    Check(distance > .75f && after.x - before.x > .75f && boarded && passengerFlying &&
          seatDistance < .15f && Mathf.Abs(seatHeight - .12f) < .02f && anchored,
        "原塔和乘客随实际位移，唯一的宽风面从器身按移动方向展开",
        new { distance, towerDistance = after.x - before.x, height = after.z, wake = wind.Length, anchored,
            boarded, passengerFlying, seatDistance, seatHeight });

    if (shots)
    {
        WorldTip.hideNow();
        await CaptureArtifactViews("riding-flight", source.current_position, 2.6f,
            () => Flying() && Vehicle() && Rider() && Wake().Length == 1, nativeZoom: 3.1f, closeSubject: source,
            nativeCenter: source.current_position + Vector2.up * source.position_height);
    }
    await Advance(.32f);
    Check(Vehicle() && Rider() && Wake().Length == 0, "空中停住时收起风面，保留载具与当前乘员");
    Check(Toggle() && !Flying() && !Vehicle() && !Rider() && passenger.isFlying() == oldFlying,
        "同一入口关闭飞行，原件回收且乘客恢复进入前状态");
    await WaitFor(() => source.position_height < .1f && passenger.position_height < .1f, 2.4f);
    Check(source.position_height < .1f && passenger.position_height < .1f &&
          !rider.HasComponent<ArtifactVehiclePassenger>() &&
          Wake().Length == 0 && owner.GetItems().Contains(item),
        "实际落地后无残留座位与风面，原塔仍在原主人手里",
        new { height = source.position_height, passengerHeight = passenger.position_height });

    return new { passed = true, process = System.Diagnostics.Process.GetCurrentProcess().Id, distance, multiplier, capacity };
}
finally
{
    if (Flying() && ControllableUnit.isControllingUnit(source)) Toggle();
    ControllableUnit.clear(false);
    ConstructedAbilityService.CastEnded -= Ended;
    ConstructedAbilityService.ContactConfirmed -= Hit;
}
