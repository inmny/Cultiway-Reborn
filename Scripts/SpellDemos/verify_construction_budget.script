// 3.10：结构、依赖、维持及继承运动的有限预算。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using Newtonsoft.Json;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Core.Visuals.Forms;




const BindingFlags Flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static | BindingFlags.Instance;
            string root = Cultiway.ModClass.I.GetDeclaration().FolderPath, folder = Path.Combine(root, "artifacts/skill_rebuild/construction-budget"); Directory.CreateDirectory(folder);
            var checks = new List<object>(); void Check(bool pass, string name, object evidence = null) => checks.Add(new { pass, name, evidence });
            bool Near(double a, double b) => Math.Abs(a - b) < .0002 * Math.Max(1, Math.Abs(b));
            void Reject(AbilityDefinition d, string field, string name) { bool rejected = false; string message = null; try { AbilityCompiler.Compile(d, false); } catch (InvalidDataException error) { message = error.Message; rejected = message.Contains(field); } Check(rejected, name, message); }
            AbilityDefinition Basic() => new() { Id = "test.budget.base", Lifetime = 3, Cost = 2, Root = new ConstructionNode { Id = "root", Form = "pivot", ContactRole = ConstructionContactRole.Decoration } };
            ConstructionNode Part(string id) => new() { Id = id, Form = "sword" };
            var basic = Basic(); var wide = Basic(); wide.Root.Children = Enumerable.Range(0, 127).Select(i => Part("part_" + i)).ToArray(); var widePlan = AbilityCompiler.Compile(wide, false); Check(widePlan.FormCount == 128 && widePlan.Budget.Forms == 128, "最大128个真实部位可编译，预算读取完整展开结果"); wide.Root.Children = wide.Root.Children.Append(Part("overflow")).ToArray(); Reject(wide, "128", "第129个实际部位拒绝，不只限制显式根的数量"); wide.Root.Children = Enumerable.Range(0, 129).Select(i => Part("part_" + i)).ToArray(); Reject(wide, "Children", "大子数组在展开和分配前被拒绝");
            var deep = Basic(); var node = deep.Root; for (int i = 0; i < 16; i++) { node.Children = new[] { new ConstructionNode { Id = "level_" + i, Form = "pivot", ContactRole = ConstructionContactRole.Decoration } }; node = node.Children[0]; }
            Check(AbilityCompiler.Compile(deep, false).FormCount == 17, "原有16层嵌套上限内仍合法"); node.Children = new[] { Part("too_deep") }; Reject(deep, "16", "超过16层在序列化与递归复制前拒绝"); var cycle = Basic(); cycle.Root.Children = new[] { cycle.Root }; Reject(cycle, "16", "对象循环引用不能绕过有限展开进入缓存序列化");
            var many = Basic(); many.Root.Form = "missing_resource"; many.Root.Operations = Enumerable.Range(0, 33).Select(i => new ConstructionOperation()).ToArray(); Reject(many, "Operations", "单部位33项原操作在解析资源和分配执行数组前拒绝"); var full = Basic(); full.Root = Part("full"); full.Root.Operations = Enumerable.Range(0, 16).Select(i => new ConstructionOperation { Kind = ConstructionOperationKind.ConvertMatter, Matter = i % 2 == 0 ? "water" : "ice" }).Concat(Enumerable.Range(0, 16).Select(i => new ConstructionOperation { Kind = ConstructionOperationKind.Spin, When = new ConstructionCondition() })).ToArray(); var fullPlan = AbilityCompiler.Compile(full, false); Check(fullPlan.Budget.Operations == 32, "32项合法操作边界保留，原物态变化和条件各自遵守原上限");
            var tooMany = Basic(); tooMany.Steps = Enumerable.Range(0, 129).Select(i => new ConstructionStep { Id = "step_" + i }).ToArray(); Reject(tooMany, "128", "命名步骤原数组超过128时立即拒绝");
            var one = Basic(); one.Root = Part("edge"); var copies = ConstructionMagnitudeEdits.Repeat(one, 64, 0, 0); Check(AbilityCompiler.Compile(copies, false).Budget.Forms == 65, "64份复制连同组织中心采用同一展开预算"); var fragment = Basic(); fragment.Root = Part("slab"); fragment.Root.Form = "fracture_slab"; fragment.Root.Operations = new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Fracture, At = .2f, Fracture = new ConstructionFracture { Seconds = 1 } } }; var fragments = AbilityCompiler.Compile(fragment, false); Check(fragments.Budget.Forms == 9, "八片真实碎片计入原主体的整次容量"); bool copyRejected = false; string copyError = null; try { ConstructionMagnitudeEdits.Repeat(fragment, 15, 0, 0); } catch (InvalidDataException error) { copyRejected = error.Message.Contains("128"); copyError = error.Message; }
            Check(copyRejected, "复制在拷贝隐式碎片前拒绝超过整次部位预算", copyError);
            var flows = Basic(); flows.Root.Children = Enumerable.Range(0, 16).Select(i => new ConstructionNode { Id = "water_" + i, Form = "water_flow", Matter = "water", Operations = new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Flow, Flow = new ConstructionFlow { Cells = 64 } } } }).ToArray(); var flowPlan = AbilityCompiler.Compile(flows, false); Check(flowPlan.Budget.FlowCells == 65536 && flowPlan.Budget.ContactShapes == ConstructionBudget.MaximumContacts, "16份最大流散可编译，按真实计算格和动态作用容量计数"); flows.Root.Children = flows.Root.Children.Append(new ConstructionNode { Id = "water_extra", Form = "water_flow", Matter = "water", Operations = new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Flow, Flow = new ConstructionFlow { Cells = 64 } } } }).ToArray(); Reject(flows, "预算", "第17份最大流散在分配单次运行状态前拒绝");
            AbilityDefinition Motion(float lifetime = 6) => new() { Id = "test.budget.motion", Lifetime = lifetime, Cost = 2, Root = new ConstructionNode { Id = "wave", Form = "water_wave", Matter = "water" }, Steps = new[] { new ConstructionStep { Id = "first", Operation = new ConstructionOperation { Kind = ConstructionOperationKind.Animate, Clip = "break" }, Inputs = new() { ["part"] = new ConstructionOutputReference { Node = "root" } } }, new ConstructionStep { Id = "after", Operation = new ConstructionOperation { Kind = ConstructionOperationKind.Animate, Clip = "recede" }, Inputs = new() { ["part"] = new ConstructionOutputReference { Step = "first", Output = "part" }, ["after"] = new ConstructionOutputReference { Step = "first", Output = "animation" } } } } };
            var chain = Motion(); Check(AbilityCompiler.Compile(chain, false).Budget.Steps == 2, "有真实完成输出的两段制作动作保留有限依赖"); chain.Lifetime = 2; Reject(chain, "after", "前一动作最早完成已过整次截止时拒绝等待后段"); chain = Motion(); chain.Steps[1].Operation.Hold = new ConstructionHold { At = .5f, Seconds = 3 }; chain.Lifetime = 5; Reject(chain, "after", "依赖完成后的维持不能绕过全局截止");
            var loop = Motion(); loop.Root.Form = "water_whale"; loop.Steps[0].Operation.Clip = "swim"; loop.Steps[1].Operation.Clip = "swim"; Reject(loop, "循环", "无限循环动作不能提供从未存在的自然完成输出"); loop.Steps[1].Inputs.Remove("after"); Check(AbilityCompiler.Compile(loop, false).Budget.Steps == 2, "循环动作仍能通过实际开始后的部位继续组合，没有被整体禁用");
            var native = Motion(6); native.Steps = Array.Empty<ConstructionStep>(); native.Root.ActiveUntilMarker = "fall"; native.Root.Operations = new[] { new ConstructionOperation { Id = "motion", Kind = ConstructionOperationKind.Animate, Clip = "break", Hold = new ConstructionHold { At = 1, Seconds = 2 } } }; native.Root.DisappearAt = 3; Reject(native, "维持", "原操作内维持也检查标记有效阶段的实际截止"); native.Root.ActiveUntilMarker = null; native.Root.DisappearAt = 2; Reject(native, "Hold", "没有阶段标记时也不能在主体消失后维持");
            var finalHold = Motion(6); finalHold.Steps = finalHold.Steps.Take(1).ToArray(); finalHold.Steps[0].Operation.Hold = new ConstructionHold { At = 2.8f, Seconds = 1 }; var input = new AbilityInputs(Vector3.zero, new Vector3(30, 0, 0), Vector3.right, 1); var held = new AbilityCast(AbilityCompiler.Compile(finalHold, false), Matrix4x4.identity, inputs: input); held.Advance(3.2f, input.Target); Check(held.StepStateOf("first") == ConstructionStepState.Running, "在末帧维持时不能提前报告动作完成"); held.Advance(1f, input.Target); Check(held.StepStateOf("first") == ConstructionStepState.Completed, "末帧维持实际结束后才给完成输出");
            var gate = Basic(); gate.Root.Children = new[] { new ConstructionNode { Id = "born", Form = "sword", Activation = new ConstructionActivation { Source = "root", Trigger = ConstructionChangeTrigger.End }, Children = new[] { Part("attached") } } }; Check(AbilityCompiler.Compile(gate, false).Budget.Forms == 3, "事件出生与附着后代仍有限展开，不把动态出生时钟误当作固定零时刻");
            AbilityDefinition OrbitThrow(bool curve) { var d = Basic(); d.Binding = new ConstructionBinding { Anchor = AbilityAnchor.Source, FaceTarget = true }; d.Root.Operations = curve ? new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Fly, InheritVelocity = false, Path = new ConstructionPath { Forward = null, Keys = new[] { new ConstructionPathKey(), new ConstructionPathKey { At = 1, Point = new[] { 8f, 0, 0 } } } } } } : new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Spin, Vector = new[] { 0f, 0, 180 } } }; d.Root.Children = new[] { new ConstructionNode { Id = "edge", Form = "sword", Scale = .1f, Offset = curve ? new float[3] : new[] { 2f, 0, 0 }, Operations = curve ? new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Detach, At = .5f }, new ConstructionOperation { Kind = ConstructionOperationKind.Fly, At = .5f } } : new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Detach, At = .5f } } } }; return d; }
            float Actual(AbilityDefinition d, float height = 1) { var c = new AbilityCast(AbilityCompiler.Compile(d, false), Matrix4x4.identity, inputs: new AbilityInputs(Vector3.zero, input.Target, Vector3.right, height)); c.Advance(2.8f, input.Target); var shapes = new List<AbilityCapsule>(); c.AppendContacts(shapes); return shapes.Where(shape => shape.Node == 1).Select(shape => Mathf.Max(shape.A.magnitude, shape.B.magnitude) + shape.Radius).Max(); }
            var thrown = OrbitThrow(false); var thrownPlan = AbilityCompiler.Compile(thrown, false); float actual = Actual(thrown); Check(actual > 10 && thrownPlan.Reach.Selection() >= actual, "父体旋转脱落的真实切向速度与后续路程进入范围预算", new { actual, budget = thrownPlan.Reach.Selection() }); thrown.Binding.ScaleByBody = true; Check(AbilityCompiler.Compile(thrown, false).Reach.Selection(2) >= Actual(thrown, 2), "体高同时影响旋转半径及继承速度，未只放大静态几何"); var curved = OrbitThrow(true); var curvePlan = AbilityCompiler.Compile(curved, false); actual = Actual(curved); Check(actual > 20 && curvePlan.Reach.Selection() >= actual, "曲线上脱落继承真实瞬时速度，不能只计原路径总长", new { actual, budget = curvePlan.Reach.Selection() }); Check(curvePlan.Budget.PathSegments == 1, "循环和继承都不复制曲段数组");
            var huge = Basic(); huge.TargetRange = 10; var bottom = huge.Root; for (int i = 0; i < 16; i++) { bottom.Scale = 10000; bottom.Children = new[] { new ConstructionNode { Id = "x" + i, Form = "pivot", ContactRole = ConstructionContactRole.Decoration } }; bottom = bottom.Children[0]; }
            Reject(huge, "有限数", "明确选取距离不能绕过组合缩放溢出的姿态预算");
            var cached = Basic(); cached.Root = Part("cached_edge"); cached.Id = "test.budget.cached"; var pinned = AbilityCompiler.Compile(cached); var running = new AbilityCast(pinned, Matrix4x4.identity); for (int i = 0; i <= ConstructionBudget.MaximumCachedPlans; i++) { var d = Basic(); d.Id = "test.budget.revision." + i; AbilityCompiler.Compile(d); }
            Check(AbilityCompiler.CachedPlans == ConstructionBudget.MaximumCachedPlans, "连续创作和修订不能使编译缓存无限增长"); running.Advance(.1f, Vector3.zero); Check(ReferenceEquals(running.Plan, pinned) && running.Age > 0, "缓存回收不破坏已经开始的施放"); Check(!ReferenceEquals(AbilityCompiler.Compile(cached), pinned), "被回收构造可正常重建，旧施放仍保留开始版本");
            var beforeReload = AbilityCompiler.Compile(cached); var oldCast = new AbilityCast(beforeReload, Matrix4x4.identity); FormResources.Reload(); var afterReload = AbilityCompiler.Compile(cached); Check(afterReload.ResourceVersion != beforeReload.ResourceVersion && !ReferenceEquals(afterReload, beforeReload) && AbilityCompiler.CachedPlans <= ConstructionBudget.MaximumCachedPlans, "资源重载同时重建缓存顺序，最新计划使用新资源版本"); oldCast.Advance(.1f, Vector3.zero); var oldShapes = new List<AbilityCapsule>(); oldCast.AppendContacts(oldShapes); Check(oldCast.Age > 0 && oldShapes.Count > 0 && ReferenceEquals(oldCast.Plan, beforeReload), "资源重载后旧施放继续使用开始计划和真实作用形状");
            bool Pass(object value) => (bool)value.GetType().GetProperty("pass").GetValue(value); var report = new { passed = checks.All(Pass), checks, process = System.Diagnostics.Process.GetCurrentProcess().Id }; File.WriteAllText(Path.Combine(folder, "checks.json"), JsonConvert.SerializeObject(report, Formatting.Indented)); return new { report.passed, checks = checks.Count };
