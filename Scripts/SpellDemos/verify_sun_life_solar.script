var ray = Learn(source, SkillEntities.SolarBeam);
var shield = Learn(source, SkillEntities.YangShield);
var yin = Learn(victim, SkillEntities.YinBolt);
var outside = Make(67); outside.setKingdom(victim.kingdom);
var clashes = new List<ConstructedClash>();
void Clash(ConstructedClash fact) => clashes.Add(fact);
ConstructedAbilityService.ClashConfirmed += Clash;
long beamCast = 0, shieldCast = 0;
int stage = 0, hpAtShield = 0, hpBeforeFollowup = 0;
float initialForce = 0f, afterArrow = 0f, afterYin = 0f;
bool retreat = false, raySeen = false, domeSeen = false;
double mark = -1;
const float duration = 5.35f;
void ShootYin(float force)
{
    manager.SpawnSkillAtPosition(yin, victim, new Vector3(69.5f,72,.5f), source, new Vector3(64,72,.5f), force, 0);
}
void Followup()
{
    // 复用上半段已验证的正式光束入口，从相反方向对破盾者施放。
    var enemy = victim.GetExtend();
    enemy.NewCultisys(Cultisyses.Xian); enemy.GetCultisys<Xian>().level = 2;
    victim.setStatsDirty(); victim.updateStats();
    var attack = Learn(victim, SkillEntities.SolarBeam);
    Ready(victim); Place(source,64); Place(victim,69.5f);
    enemy.GetCultisys<Xian>().wakan = victim.stats[BaseStatses.MaxWakan.id] * .85f;
    victim.addAggro(source); source.addAggro(victim);
    Vector3 point = source.GetSimPos();
    Check(ActiveAbilityService.TryUse(enemy, new ActiveAbilityHandle("core.learned_skill",attack),
        new ActiveAbilityTarget(source, point, selectionArea: new SkillTargetSelectionArea(true, point, .1f)), ActiveAbilityUseOrigin.Script),
        "破层后从原来袭方向受理正式光束追击");
    victim.attack_timer = 999;
    CombatStatusEffects.ApplyStatus(victim,hold,10000,victim); victim.updateStats(); ControllableUnit.clear(false);
}
void Stage(double elapsed)
{
    raySeen |= Shows("solar_ray_luminous"); domeSeen |= Shows("solar_aegis");
    if (Shows("solar_scale_release")) { retreat = true; if (mark < 0) mark = elapsed; }
    if (stage == 0 && elapsed >= .14) { CastNative(ray, victim, victim.GetSimPos()); stage++; }
    if (stage == 1 && elapsed >= 1.28)
    {
        beamCast = LastCast();
        Check(seen[beamCast].Finished && raySeen && contacts.Any(t => t.CastId == beamCast && t.TargetId == victim.id && t.Damage.HealthLost > 0)
            && contacts.All(t => t.CastId != beamCast || t.TargetId != outside.id),
            "阳光束只能沿实测宽度伤人，退场后没有新接触", new { beamCast, raySeen, contacts = contacts.Count });
        CastNative(shield, source, source.GetSimPos()); stage++;
    }
    if (stage == 2 && elapsed >= 1.74)
    {
        shieldCast = LastCast(); initialForce = seen[shieldCast].RemainingForce(0); hpAtShield = source.getHealth();
        Check(domeSeen && initialForce > 0, "阳罡是正式拦截壳，并有有限强度", new { initialForce });
        World.world.projectiles.spawn(victim, source, "arrow", new Vector3(69,72,0), new Vector3(64,72,0), .4f, .4f);
        stage++;
    }
    if (stage == 3 && elapsed >= 2.25)
    {
        afterArrow = seen[shieldCast].RemainingForce(0);
        Check(afterArrow > 0 && afterArrow < initialForce && source.getHealth() == hpAtShield,
            "原版箭在壳上消耗容量，没有穿透伤害", new { initialForce, afterArrow, health = source.getHealth(), hpAtShield });
        ShootYin(afterArrow * .32f); stage++;
    }
    if (stage == 4 && elapsed >= 2.95)
    {
        afterYin = seen[shieldCast].RemainingForce(0);
        Check(afterYin > 0 && afterYin < afterArrow && source.getHealth() == hpAtShield,
            "阴系射击也只耗掉有限容量", new { afterArrow, afterYin, health = source.getHealth(), hpAtShield });
        ShootYin(afterYin); stage++;
    }
    if (stage == 5 && elapsed >= 3.58)
    {
        var remainingContacts = new List<AbilityCapsule>();
        seen[shieldCast].AppendContacts(remainingContacts);
        Check(seen[shieldCast].RemainingForce(0) <= .01f && retreat && remainingContacts.Count == 0,
            "容量耗尽后主体不再挡，只有真实破层后的余光", new { retreat, remaining = seen[shieldCast].RemainingForce(0), clash = clashes.Count });
        hpBeforeFollowup = source.getHealth();
        Followup(); stage++;
    }
    if (stage == 6 && elapsed >= 4.42)
    {
        Check(source.getHealth() < hpBeforeFollowup && seen[shieldCast].Finished && !Shows("solar_scale_release"),
            "破后下一击正常结算，余光消退不伤人", new {hpBeforeFollowup, after=source.getHealth(), finished=seen[shieldCast].Finished, hits=contacts.Count(x=>x.TargetId==source.id)});
        CastNative(shield, source, source.GetSimPos()); stage++;
    }
}
try
{
    if (recordView.Length > 0) await SetCamera(6.5f);
    Place(source,64); Place(victim,69.5f); Place(outside,67,75);
    double start = World.world.getCurWorldTime();
    var times = new List<double>();
    if (recordView.Length > 0) times = await Film(duration, () => Stage(World.world.getCurWorldTime() - start));
    else
        while (World.world.getCurWorldTime() - start < duration) { Stage(World.world.getCurWorldTime() - start); await Advance(.045f); }
    Check(stage == 7 && LastCast() != shieldCast && seen[LastCast()].RemainingForce(0) > 0 && spent.Count >= 3 && spent.All(value => value > 0),
        "破层后重新施放成功；原入口记录灵气实扣", new { stage, spent });
    return new { passed=true, scene="construction", resource="wakan", paid=spent.Sum(), duration, times, view=recordView, spent, initialForce, afterArrow, afterYin, previewFrame=times.FindIndex(t => t >= mark) };
}
finally
{
    ConstructedAbilityService.ClashConfirmed -= Clash;
    StopDebit();
    foreach (var cast in seen.Values) cast.Cancel();
    ReleaseChecks();
}
