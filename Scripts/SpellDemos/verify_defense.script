// 保留重兵档中的铁锤和人物，使用正式铁盾试挡同一锤头。
const string shieldAssetId = "cultiway_iron_shield";
const string hammerId = "Cultiway.Body.HeavyHammerDrop";
string attackId = selection == "overflow" ? hammerId + ".Overflow" : hammerId;
bool cold = selection == "cold";
bool fullBlock = selection == "front" || cold;
var saved = cold ? JObject.Parse(File.ReadAllText(Path.Combine(archived, "expected.json"))) : null;
string guardId = cold ? (string)saved["edited"] : BodyActionCatalog.ShieldGuardId;
long attackCast = 0, guardCast = 0;
AbilityCast attackLive = null, guardLive = null;
var clashes = new List<ConstructedClash>();
void Started(ConstructedCastStarted fact)
{
    if (fact.AbilityId == attackId && fact.SourceId == source.id)
    {
        attackCast = fact.CastId;
        attackLive = Running(attackCast);
    }
    if (fact.AbilityId == guardId && fact.SourceId == target.id)
    {
        guardCast = fact.CastId;
        guardLive = Running(guardCast);
    }
}
AbilityCast Running(long id)
{
    var state = ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>()
        .Single(entry => (long)Field(entry, "Id") == id);
    return (AbilityCast)Field(state, "Cast");
}
void Clashed(ConstructedClash value)
{
    if (value.LeftCast == attackCast && value.RightCast == guardCast) clashes.Add(value);
}

var clock = Config.time_scale_asset;
float speed = clock.multiplier;
ConstructedAbilityService.CastStarted += Started;
ConstructedAbilityService.ClashConfirmed += Clashed;
try
{
    owner.E.RemoveComponent<ConstructedKnowledge>();
    Ready(source);
    source.attack_timer = target.attack_timer = 999;
    await Advance(.18f);
    clock.multiplier = speed * .32f;
    var guard = ConstructionEditing.Access.Read(guardId);
    var hammer = source.getWeapon();
    if (cold)
    {
        Check(System.Diagnostics.Process.GetCurrentProcess().Id != (int)saved["process"] &&
              hammer?.data.id == (long)saved["weapon"] && target.getWeapon()?.data.id == (long)saved["shield"],
            "新进程读回原人物及同一铁锤、铁盾");
        var restored = saved["definitions"].Select(before =>
        {
            string id = (string)before["Id"];
            var definition = ConstructionEditing.Access.Read(id);
            var snapshot = JToken.Parse(JsonConvert.SerializeObject(definition));
            return new { id, knows = ConstructedAbilityService.Knows(target.GetExtend(), id),
                same = JToken.DeepEquals(before, snapshot), snapshot };
        }).ToArray();
        if (restored.Any(value => !value.knows || !value.same))
            File.WriteAllText(Path.Combine(folder, "restored-definitions.json"),
                JsonConvert.SerializeObject(restored, Formatting.Indented));
        Check(restored.All(value => value.knows && value.same) &&
              guard?.Body.Guard is { Capacity: 82f, HalfAngle: 52f } &&
              guard.Body.Guard.Normal[1] == .12f && guard.Body.ActiveFrom == .28f,
            "新进程恢复原招及改造的完整资料和学习关系",
            restored.Select(value => new { value.id, value.knows, value.same }).ToArray());
    }
    var shieldAsset = AssetManager.items.get(shieldAssetId);
    Check(hammer?.getAsset().id == "hammer_iron" && shieldAsset?.group_id == "shield" &&
          shieldAsset.gameplay_sprites?.Length == 1 && shieldAsset.gameplay_sprites[0] != null &&
          AssetManager.items.pot_weapon_assets_unlocked.Contains(shieldAsset),
        "同一原铁锤和正式铁盾、持物图及原版装备入口可用");
    Place(source, 64.35f);
    Place(target, 64.98f);
    CombatStatusEffects.RemoveStatus(target, quiet);
    target.updateStats();
    target.cancelAllBeh();
    source.addAggro(target);
    target.addAggro(source);
    if (selection == "front")
    {
        ConstructedAbilityService.Learn(target.GetExtend(), guardId);
        var handle = new ActiveAbilityHandle("content.constructed", target.GetExtend().E, guardId);
        target.data.stamina = 100;
        target.attack_timer = 0;
        bool refused = !ActiveAbilityService.TryUse(target.GetExtend(), handle,
            new ActiveAbilityTarget(source, source.GetSimPos()), ActiveAbilityUseOrigin.Script);
        target.attack_timer = 999;
        Check(refused && target.data.stamina == 100 && !BodyControlState.IsBusy(target.id),
            "没有真正铁盾时架盾拒绝，保留体力和控制");
    }

    Item shield = cold ? target.getWeapon() : Equip(target, shieldAssetId);
    var heavy = ConstructionEditing.Access.Read(hammerId);
    if (selection == "overflow")
    {
        heavy.Id = attackId;
        heavy.Power *= 1.8f;
    }
    int health = target.data.health;
    if (selection != "late") await Guard();
    source.data.stamina = 100;
    await Fire(heavy, source, target);
    owner.E.RemoveComponent<ConstructedKnowledge>();
    if (selection == "late")
    {
        await Advance(.49f);
        await Guard();
    }
    float recoil = 0;
    if (fullBlock)
    {
        await Advance(.69f);
        if (guardLive.BodyPose is BodyPose pose)
        {
            BodyFrame frame = (BodyFrame)Field(guardLive, "bodyFrame");
            BodyPose withoutContact = guardLive.Plan.Body.Sample(pose.WorldAge, in frame);
            recoil = Vector3.Distance(withoutContact.Hand, withoutContact.Shoulder) -
                     Vector3.Distance(pose.Hand, pose.Shoulder);
        }
    }
    await Advance(Mathf.Max(heavy.Lifetime, guard.Lifetime) + .30f);
    var touch = contacts.Where(hit => hit.CastId == attackCast && hit.TargetId == target.id).ToArray();
    var clash = clashes.FirstOrDefault();
    var detail = new
    {
        selected = selection, health, after = target.data.health, recoil,
        clash.LeftAge, clash.RightAge, clash.Absorbed, clash.LeftRemaining, clash.RightRemaining,
        facing = clash.GuardFacing.ToString("F5"), point = clash.Position.ToString("F5"),
        attackResult = attackLive.BodyResult, guardResult = guardLive.BodyResult,
        hits = touch.Select(hit => new { hit.Age, hit.ForceApplied, change = hit.VelocityChange.ToString("F5") }).ToArray()
    };
    if (fullBlock)
        Check(clashes.Count == 1 && clash.GuardShape >= 0 && clash.LeftRemaining == 0f && clash.RightRemaining > 0f &&
              attackLive.BodyResult == BodyActionResult.Blocked && touch.Length == 0 && target.data.health == health &&
              recoil > .005f && Mathf.Abs(clash.Absorbed + clash.RightRemaining - guard.Body.Guard.Capacity) < .001f,
            "正式盾面迎接锤头，截住全部来势并沿实际握持回弹", detail);
    else if (selection == "overflow")
        Check(clashes.Count == 1 && clash.GuardShape >= 0 && clash.RightRemaining == 0f && clash.LeftRemaining > 0f &&
              touch.Length == 1 && touch[0].ForceApplied && touch[0].VelocityChange.sqrMagnitude > .001f &&
              target.data.health < health && touch[0].Age >= clash.LeftAge,
            "锤势超过盾的额度时，实际余力继续产生伤害和推力", detail);
    else
        Check(clashes.Count == 0 && touch.Length == 1 && touch[0].ForceApplied && target.data.health < health,
            "背对或未架稳时锤头仍沿实际路径命中", detail);
    Check(!BodyControlState.IsBusy(source.id) && !BodyControlState.IsBusy(target.id) &&
          ReferenceEquals(hammer, source.getWeapon()) && ReferenceEquals(shield, target.getWeapon()),
        "双方动作结束后归还控制并保留各自实际物件");
    return new { passed = true, selection, checks };

    async Task Guard()
    {
        target.data.stamina = 100;
        Vector3? behind = selection == "rear" ? new Vector3(65.66f, 72f, 0f) : (Vector3?)null;
        if (cold)
        {
            var defender = target.GetExtend();
            var handle = new ActiveAbilityHandle("content.constructed", defender.E, guardId);
            target.attack_timer = 0;
            bool used = ActiveAbilityService.TryUse(defender, handle,
                new ActiveAbilityTarget(source, source.GetSimPos()), ActiveAbilityUseOrigin.Player);
            target.attack_timer = 999;
            Check(used, "新进程直接从已学副本入口架盾");
        }
        else await Fire(guard, target, source, aim: behind);
        target.GetExtend().E.RemoveComponent<ConstructedKnowledge>();
        Check(guardLive != null && Mathf.Abs(100 - target.data.stamina - guard.Cost) < .001f,
            "正式盾架成功受理且只支付一次");
    }
}
finally
{
    ConstructedAbilityService.CastStarted -= Started;
    ConstructedAbilityService.ClashConfirmed -= Clashed;
    ConstructedAbilityService.ContactConfirmed -= Hit;
    ConstructedAbilityService.CastEnded -= Ended;
    Config.paused = true;
    clock.multiplier = speed;
    ControllableUnit.clear(false);
}
