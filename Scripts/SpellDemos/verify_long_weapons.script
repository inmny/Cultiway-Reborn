// 真正的铁枪沿同一杆身滑动，手内握点和实际枪尖同刻比较。
const string thrustId = "Cultiway.Body.LongSpearThrust", sweepId = "Cultiway.Body.LongSpearSweep";
var bindingType = service.Assembly.GetType("Cultiway.Content.Skills.BodyActionBinding");
AbilityCast live = null;
object binding = null;
long castId = 0;
void Started(ConstructedCastStarted fact)
{
    if (fact.SourceId != source.id || !fact.AbilityId.StartsWith("Cultiway.Body.LongSpear")) return;
    var running = ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>()
        .Single(entry => (long)Field(entry, "Id") == fact.CastId);
    live = (AbilityCast)Field(running, "Cast");
    binding = Field(running, "Body");
    castId = fact.CastId;
}

var clock = Config.time_scale_asset;
float speed = clock.multiplier;
ConstructedAbilityService.CastStarted += Started;
try
{
    Ready(source);
    source.attack_timer = target.attack_timer = 999;
    await Advance(.18f);
    clock.multiplier = speed * .32f;
    Item weapon = Equip(source, "spear_iron");
    var form = FormResources.Load("spear");
    if (selection is "all" or "strike" or "near")
    {
        var thrust = ConstructionEditing.Access.Read(thrustId);
        var plan = ConstructionEditing.Access.Validate(thrust).Body;
        var fixedForward = ConstructionEditing.Copy(thrust);
        fixedForward.Body.SlideGrip = null;
        foreach (BodyMotionKey key in fixedForward.Body.Keys) key.GripSlide = 0f;
        float shortReach = ConstructionEditing.Access.Validate(fixedForward).Body.ContactReach;
        Check(plan.ContactReach > shortReach + .30f, "后握送尖才取得较长的实际范围",
            new { forward = shortReach, rear = plan.ContactReach });
        var invalid = ConstructionEditing.Copy(thrust);
        invalid.Body.SlideGrip = invalid.Body.Grip;
        bool refused = false;
        try { ConstructionEditing.Access.Validate(invalid); }
        catch (InvalidDataException error) { refused = error.Message.Contains("SlideGrip"); }
        Check(refused, "相同握点没有可滑动的实杆，拒绝登记");
    }
    var heightMethod = service.Assembly.GetType("Cultiway.Content.Combat.SpatialActorPose").GetMethod("Height", F);
    float height = (float)heightMethod.Invoke(null, new object[] { source });

    foreach (string test in new[] { "strike", "near", "sweep", "interrupt" }.Where(value => selection == "all" || selection == value))
    {
        bool twoHands = test is "sweep" or "interrupt";
        string ability = twoHands ? sweepId : thrustId;
        var definition = ConstructionEditing.Access.Read(ability);
        float distance = twoHands ? 1.12f : test == "strike" ? 2.02f : .68f;
        Place(source, 64.35f);
        if (test == "sweep") await CheckLeftControl(definition, distance);
        Place(target, 64.35f + height * distance);
        target.setHealth(target.getMaxHealth());
        source.data.stamina = 100;
        int health = target.data.health;
        source.addAggro(target);
        target.addAggro(source);
        ConstructedAbilityService.Learn(owner, ability);
        var handle = new ActiveAbilityHandle("content.constructed", owner.E, ability);
        source.attack_timer = 0;
        live = null;
        bool used = ActiveAbilityService.TryUse(owner, handle, new ActiveAbilityTarget(target, target.GetSimPos()), ActiveAbilityUseOrigin.Script);
        source.attack_timer = 999;
        owner.E.RemoveComponent<ConstructedKnowledge>();
        Check(used && live != null && ReferenceEquals(Field(binding, "Weapon"), weapon) &&
              Mathf.Abs(100f - source.data.stamina - definition.Cost) < .001f,
            test + " 正式施放借原铁枪并支付", new { height, used, paid = 100f - source.data.stamina });

        if (test == "interrupt")
        {
            await Advance(.21f);
            Check(ConstructedAbilityService.TryGetBodyPose(source.id, BodyOccupancy.LeftArm, out _),
                "起势时副手已实际握持");
            Item replacement = Equip(source, "spear_iron");
            await Advance(.11f);
            Check(!BodyControlState.IsBusy(source.id) && ReferenceEquals(source.getWeapon(), replacement) &&
                  !ReferenceEquals(replacement, weapon) &&
                  endings.Any(end => end.Fact.CastId == castId && end.Fact.Cancelled) &&
                  !contacts.Any(hit => hit.CastId == castId) && target.data.health == health,
                "换同款真枪也中断旧动作，两手归还且旧杆没有补伤");
            continue;
        }

        var start = form.Grip(definition.Body.Grip);
        var rear = form.Grip(definition.Body.SlideGrip ?? definition.Body.Grip);
        if (test == "strike")
        {
            await Advance(.15f);
            var gather = live.BodyPose.Value;
            VerifyPose(gather);
            Check(gather.GripSlide > 0f && gather.GripSlide < 1f, "起势中使用两处真实握点之间的位置",
                new { gather.WorldAge, gather.GripSlide });
            await Advance(.371f - live.Age);
            var thrust = live.BodyPose.Value;
            VerifyPose(thrust, "tip", "iron");
            Check(thrust.GripSlide > .999f, "送尖时手已到后握",
                new { thrust.WorldAge, thrust.GripSlide });
            await Advance(.755f - live.Age);
            var withdraw = live.BodyPose.Value;
            VerifyPose(withdraw);
            Check(withdraw.GripSlide > 0f && withdraw.GripSlide < gather.GripSlide + .16f,
                "收枪沿杆抽回前握",
                new { withdraw.WorldAge, withdraw.GripSlide });

        }
        if (test == "sweep")
        {
            await Advance(.408f);
            BodyPose entering = live.BodyPose.Value;
            AbilityCapsule first = VerifyPose(entering, "shaft", "wood");
            await Advance(.559f - live.Age);
            BodyPose through = live.BodyPose.Value;
            AbilityCapsule last = VerifyPose(through, "shaft", "wood");
            float butt = Vector3.Distance(first.A, last.A), front = Vector3.Distance(first.B, last.B);
            Check(butt > .12f && front > .12f && through.Turn > entering.Turn + 22f,
                "转胯带动两段实际杆端横过站位", new { butt, front, entering = entering.Turn, through = through.Turn });
        }

        await Advance(definition.Cooldown + .08f);
        var hits = contacts.Where(hit => hit.CastId == castId && hit.TargetId == target.id).ToArray();
        if (test == "strike")
            Check(hits.Length == 1 && hits[0].Node == -1 && hits[0].Age >= definition.Body.ActiveFrom - .001f &&
                  hits[0].Age <= definition.Body.ActiveUntil + .001f && target.data.health < health,
                "枪尖在正式刺入时段命中一次",
                new { health, after = target.data.health, hits = hits.Select(hit => new { hit.Age, point = hit.Position.ToString("F4") }) });
        else if (test == "sweep")
            Check(hits.Length == 1 && hits[0].Node == -1 && hits[0].Age >= definition.Body.ActiveFrom - .001f &&
                  hits[0].Age <= definition.Body.ActiveUntil + .001f && hits[0].ForceApplied && target.data.health < health,
                "实际木杆横扫只击中一次，并对目标实际施力",
                new { health, after = target.data.health, hits = hits.Select(hit => new
                    { hit.Age, point = hit.Position.ToString("F4"), force = hit.VelocityChange.ToString("F4") }) });
        else
            Check(hits.Length == 0 && target.data.health == health, "目标在枪尖内侧，仅杆身经过时无伤害");
        Check(!BodyControlState.IsBusy(source.id) && ReferenceEquals(weapon, source.getWeapon()) &&
              endings.Any(end => end.Fact.CastId == castId && !end.Fact.Cancelled),
            test + " 自然收势并归还实际控制，原铁枪仍在原手");

        AbilityCapsule VerifyPose(BodyPose pose, string contact = null, string matter = null)
        {
            var views = new List<FormVisualInstance>();
            bindingType.GetMethod("AppendVisuals", F).Invoke(binding, new object[] { source, pose, views, null });
            var held = views.Single(instance => instance.Resource == form);
            var hand = views.Single(instance => instance.BodySegment == BodyVisualSegment.RightHand);
            Vector3 grip = Vector3.Lerp(start.Transform.GetColumn(3), rear.Transform.GetColumn(3), pose.GripSlide);
            Vector3 socket = hand.Resource.Anchors.Single(anchor => anchor.Id == "grip").Transform.GetColumn(3);
            Check(Vector3.Distance(held.Transform.MultiplyPoint3x4(grip), hand.Transform.MultiplyPoint3x4(socket)) < .0001f,
                "枪杆实际握点与画面里的手内坐标重合", pose.WorldAge);
            if (twoHands)
            {
                var leftHand = views.Single(instance => instance.BodySegment == BodyVisualSegment.LeftHand);
                bool published = ConstructedAbilityService.TryGetBodyPose(source.id, BodyOccupancy.LeftArm, out BodyPose left);
                Vector3 front = form.Grip("forward").Transform.GetColumn(3);
                var frame = (BodyFrame)bindingType.GetMethod("Frame", F, null, new[] { typeof(Actor) }, null)
                    .Invoke(binding, new object[] { source });
                var adapted = left.OtherArm.GetValueOrDefault();
                Check(published && left.OtherArm.HasValue && left.WorldAge == pose.WorldAge &&
                      Vector3.Distance(held.Transform.MultiplyPoint3x4(front), leftHand.Transform.MultiplyPoint3x4(socket)) < .0001f &&
                      Vector3.Distance(left.Hand, pose.Hand) > .20f * height &&
                      Mathf.Abs(Vector3.Distance(left.Shoulder, left.Elbow) - frame.UpperLength) < .0002f &&
                      Mathf.Abs(Vector3.Distance(left.Elbow, left.Hand) - frame.LowerLength) < .0002f &&
                      Mathf.Abs(Vector3.Distance(adapted.Shoulder, adapted.Elbow) - adapted.Upper) < .0002f &&
                      Mathf.Abs(Vector3.Distance(adapted.Elbow, left.Hand) - adapted.Lower) < .0002f,
                    "同一根枪杆有前后两处闭合握持，原版与三维的左臂保持各自骨长",
                    new { pose.WorldAge, right = pose.Hand.ToString("F4"), left = left.Hand.ToString("F4") });
            }
            if (contact == null) return default;
            var shapes = new List<AbilityCapsule>();
            bindingType.GetMethod("AppendContacts", F).Invoke(binding, new object[] { pose, shapes });
            int index = Array.FindIndex(form.Description.Contacts, part => part.Id == contact);
            var shape = shapes.SingleOrDefault();
            Check(shapes.Count == 1 && shape.Shape == index && shape.Matter == matter &&
                  Vector3.Distance(shape.A, held.Transform.MultiplyPoint3x4(form.Contacts[index].A)) < .0001f &&
                  Vector3.Distance(shape.B, held.Transform.MultiplyPoint3x4(form.Contacts[index].B)) < .0001f,
                "实际接触从指定部位取得，并沿用该段材质",
                new { contact, shape.Matter, a = shape.A.ToString("F4"), b = shape.B.ToString("F4"), pose.WorldAge });
            return shape;
        }
    }
    return new { passed = true, selection, checks };

    async Task CheckLeftControl(AbilityDefinition sweep, float sweepDistance)
    {
        const BodyOccupancy both = BodyOccupancy.RightArm | BodyOccupancy.LeftArm;
        var plan = ConstructionEditing.Access.Validate(sweep).Body;
        Check((plan.Occupancy & both) == both && plan.Construction.SupportGrip == "forward",
            "完整资料同时预留双手，从同一枪杆取到前握");
        var invalid = ConstructionEditing.Copy(sweep);
        invalid.Body.Construction.Relations.Single(relation => relation.Id == "support").ToAnchor = "grip";
        bool refused = false;
        try { ConstructionEditing.Access.Validate(invalid); }
        catch (InvalidDataException error) { refused = error.Message.Contains("/Grip"); }
        Check(refused, "双手引用同一握点时拒绝登记");

        var guard = BodyActionCatalog.Create("test.long-spear.left-arm", "左手独立占用",
            new BodyActionRequest { Effector = "hand.left", Kind = BodyActionKind.Guard, Seconds = .64f });
        guard.Cost = 0f;
        foreach (BodyMotionKey key in guard.Body.Keys) key.Torso = new float[3];
        Check(ConstructionEditing.Access.Validate(guard).Body.Occupancy == BodyOccupancy.LeftArm,
            "占用测试的架掌只取得左手");
        Place(target, 64.35f + height * .42f);
        await Fire(guard, source, target);
        Place(target, 64.35f + height * sweepDistance);
        ConstructedAbilityService.Learn(owner, sweep.Id);
        var handle = new ActiveAbilityHandle("content.constructed", owner.E, sweep.Id);
        source.data.stamina = 100;
        source.attack_timer = 0;
        bool blocked = !ActiveAbilityService.TryUse(owner, handle,
            new ActiveAbilityTarget(target, target.GetSimPos()), ActiveAbilityUseOrigin.Script);
        source.attack_timer = 999;
        owner.E.RemoveComponent<ConstructedKnowledge>();
        Check(blocked && source.data.stamina == 100, "左手被占用时拒绝双手持枪，体力保持");
        await Advance(guard.Lifetime + .06f);
        Check(!BodyControlState.IsBusy(source.id), "左手结束后可再次受理双手动作");
    }
}
finally
{
    ConstructedAbilityService.CastStarted -= Started;
    ConstructedAbilityService.ContactConfirmed -= Hit;
    ConstructedAbilityService.CastEnded -= Ended;
    Config.paused = true;
    clock.multiplier = speed;
    ControllableUnit.clear(false);
}
