// 真正重启后恢复原版水面和独立水层；旧电击不重放，新形体仍按实际水路作用。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Content.Skills;
using Cultiway.Content.Components;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Usage;
using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;
JObject SavedMaterial(JToken token){var data=new JObject{["Records"]=new JArray(new JObject{["Material"]=token.DeepClone()})};if(token["ShapeHeld"]==null){var migration=(Cultiway.Core.Persistence.ISaveMigration)Activator.CreateInstance(typeof(AbilityCast).Assembly.GetType("Cultiway.Content.Skills.WorldMaterialsV3ToV4"),true);data=migration.Apply(data);}return JObject.FromObject(data["Records"][0]["Material"].ToObject<AbilityMaterialData>());}
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/conduction-domains");var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}
Check((int)expected["process"]!=System.Diagnostics.Process.GetCurrentProcess().Id,"保存与恢复来自不同的游戏进程");
async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;var t=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=t.GetProperty("Instance").GetValue(null);await Game.WaitUntil(()=>(bool)t.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);}
Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;var saves=Cultiway.ModClass.I.WorldSaves;var document=JObject.Parse(saves.World.Capture(World.world,"conduction-domains"));var rows=(JArray)document["sections"]["world_materials"]["data"]["Records"];Check((int)document["sections"]["world_materials"]["version"]==4&&rows.Count==1,"既有正式第二版材料经逐版本转换完整恢复到第四版");Check(JToken.DeepEquals(SavedMaterial(rows.Single()["Material"]),SavedMaterial(expected["material"]["Material"]))&&new[]{"Id","Lineage","WorldGrid","Provider","Controller","Resource"}.All(k=>JToken.DeepEquals(rows.Single()[k],expected["material"][k])),"独立编号、归属、原支付、水格、速度、边缘及总量精确恢复");
Check(Enumerable.Range(60,21).All(x=>World.world.GetTileSimple(x,72).Type.ocean&&World.world.GetTileSimple(x,72).Type.id!="ice"),"原版海水地块由原版世界保存恢复");
var defs=(IDictionary)typeof(ConstructedAbilityService).GetField("definitions",F).GetValue(null);string id="test.domain.closed.branch";Check(defs.Contains(id)&&((AbilityDefinition)defs[id]).Root.Operations.Any(o=>o.Kind==ConstructionOperationKind.Conduct),"导电参数由普通已学构造资料恢复");
Check((saves.LastReport.Skipped.Count==0&&saves.LastReport.BackupError==null),"恢复没有缺失临时状态或局部丢弃报告");
var source=World.world.units.get((long)expected["actor"]);var target=World.world.units.get((long)expected["target"]);var middle=World.world.units.get((long)expected["middle"]);Check(source!=null&&target!=null&&middle!=null,"来源和两名受击人物按原稳定编号恢复");source.addAggro(target);source.addAggro(middle);
var stats=new BaseStats();stats["mana"]=256;stats["damage"]=40;stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.ConductionDomainRestartHold").SetStats(stats).SetDuration(10000).Build();foreach(var p in new[]{source,target,middle}){Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(p,hold,10000,p);p.GetExtend().MarkCultiwayStatsDirty();p.setStatsDirty();p.updateStats();p.setMana(128);}
var waves=new List<ConstructedConduction>();void Wave(ConstructedConduction e)=>waves.Add(e);ConstructedAbilityService.ConductionConfirmed+=Wave;
try{
 await Advance(.4f);Check(waves.Count==0,"恢复暂停再继续不会重放旧电击");var use=new ActiveAbilityHandle("content.constructed",source.GetExtend().E,id);Check(ActiveAbilityService.TryUse(source.GetExtend(),use,new ActiveAbilityTarget(target,target.GetSimPos()),ActiveAbilityUseOrigin.Script),"恢复后的枝体通过正式知识、支付和目标入口施放");await Advance(.7f);var wave=waves.Single(w=>w.AbilityId==id);File.WriteAllText(Path.Combine(folder,"cold-wave.json"),JsonConvert.SerializeObject(new{route=wave.Route.Length,wave.Targets,wave.Spent,source=new[]{source.current_position.x,source.current_position.y},target=new[]{target.current_position.x,target.current_position.y}},Formatting.Indented));Check(wave.Targets.Contains(target.id)&&wave.Targets.Contains(middle.id)&&wave.Targets.Distinct().Count()==wave.Targets.Length,"第二种形体在恢复后仍真实通过独立水层到达两人并去重");Check(wave.HealthBefore.Zip(wave.HealthAfter,(a,b)=>a>b).All(v=>v)&&wave.OriginalSourceId==source.id&&wave.OwnerId==source.id,"恢复后电击实际扣血并保留正确来源和控制者");var restored=JObject.Parse(saves.World.Capture(World.world,"conduction-domains"))["sections"]["world_materials"]["data"]["Records"];Check(Math.Abs((double)restored.Single()["Material"]["Volume"]-(double)expected["material"]["Material"]["Volume"])<.02&&Math.Abs((double)restored.Single()["Material"]["Resource"]-(double)expected["material"]["Material"]["Resource"])<.0001,"重启后的传播不领走原有水量与原支付份额");
 var result=new{passed=true,checks,savedProcess=(int)expected["process"],process=System.Diagnostics.Process.GetCurrentProcess().Id,route=wave.Route.Length,targets=wave.Targets,wave.Spent};File.WriteAllText(Path.Combine(folder,"restart.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{ConstructedAbilityService.ConductionConfirmed-=Wave;foreach(var p in new[]{source,target,middle})Cultiway.Content.Combat.CombatStatusEffects.RemoveStatus(p,hold);Config.paused=true;}
