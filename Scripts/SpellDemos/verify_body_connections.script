// 4.23首批：手部和目标身体表面；其他部位与完整关系验收仍继续本项。
var selectedCases = Array.Empty<string>();
var relations = new List<ConstructedBodyConnection>();
var made = new List<Actor>();
var observed = new List<object>();

void Related(ConstructedBodyConnection fact)
{
    relations.Add(fact);
    if (fact.Reason == "BodyChanged")
    {
        object running = ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>()
            .SingleOrDefault(c => (long)Field(c, "Id") == fact.CastId);
        object connection = running == null ? null : Field(running, "Connection");
        if (connection != null)
        {
            var spatial = service.Assembly.GetType("Cultiway.Content.Combat.SpatialActorPose");
            Actor from = (Actor)Field(running, "Source"), to = (Actor)Field(connection, "Target");
            object binding = Field(connection, "SurfaceBinding");
            object appearance = service.Assembly.GetType("Cultiway.Content.Skills.BodySurfaceBinding")
                .GetField("appearance", F).GetValue(binding);
            File.WriteAllText(Path.Combine(folder, "body-change.json"), JsonConvert.SerializeObject(new
            {
                sourceAssetSame = ReferenceEquals(Field(connection, "SourceAsset"), from.asset),
                targetAssetSame = ReferenceEquals(Field(connection, "TargetAsset"), to.asset),
                sourceHeight = Field(connection, "SourceHeight"),
                sourceNow = spatial.GetMethod("Height", F).Invoke(null, new object[] { from }),
                targetHeight = Field(connection, "TargetHeight"),
                targetNow = spatial.GetMethod("Height", F).Invoke(null, new object[] { to }),
                bindingChanged = binding.GetType().GetProperty("ChangedReason", F).GetValue(binding),
                appearanceSame = ReferenceEquals(appearance, to.animation_container)
            }, Formatting.Indented));
        }
    }

    File.WriteAllText(Path.Combine(folder, "relations.json"), JsonConvert.SerializeObject(relations.Select(r =>
        new
        {
            r.CastId, r.SourceId, r.TargetId, r.RelationId, r.Kind, r.State, r.WorldTime, r.Until, r.Remaining,
            r.Reason,
            source = new[] { r.SourcePoint.x, r.SourcePoint.y, r.SourcePoint.z },
            target = new[] { r.TargetPoint.x, r.TargetPoint.y, r.TargetPoint.z }
        }), Formatting.Indented));
}

ConstructedAbilityService.BodyConnectionChanged += Related;
try
{
    var triangle = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Skills.AbilityTriangleSweep")
        .GetMethod("Find", F);
    var capsule = typeof(AbilityCapsule).GetConstructors(F).Single();

    object Sphere(Vector3 from, Vector3 to, float radius, Vector3 half = default) => capsule.Invoke(new object[]
        { -1, from, to, radius, null, 0, 0, null, half, 1f });

    Vector3 ta = new(0, -1, -1), tb = new(0, 1, -1), tc = new(0, 0, 1);

    void Sweep(string name, object from, object to, Vector3 a0, Vector3 b0, Vector3 c0,
        Vector3 a1, Vector3 b1, Vector3 c1, bool expected, float at = 0f)
    {
        object[] arguments = { from, to, a0, b0, c0, a1, b1, c1, 0f, Vector3.zero, Vector3.zero };
        bool found = (bool)triangle.Invoke(null, arguments);
        Check(found == expected && (!expected || Mathf.Abs((float)arguments[8] - at) < .0002f),
            "真实三角面：" + name, new { found, fraction = arguments[8], expected, at });
    }

    object sphereFrom = Sphere(Vector3.left * 2, Vector3.left * 2, .25f),
        sphereTo = Sphere(Vector3.right * 2, Vector3.right * 2, .25f),
        centre = Sphere(Vector3.zero, Vector3.zero, .25f);
    Sweep("高速穿过面内部", sphereFrom, sphereTo, ta, tb, tc, ta, tb, tc, true, .4375f);
    Sweep("三角面向静止手部移动", centre, centre, ta + Vector3.right * 2, tb + Vector3.right * 2,
        tc + Vector3.right * 2, ta - Vector3.right * 2, tb - Vector3.right * 2, tc - Vector3.right * 2, true,
        .4375f);
    Sweep("已经重叠", centre, centre, ta, tb, tc, ta, tb, tc, true);
    Sweep("有限边缘接触", Sphere(new Vector3(-2, 1.1f, -1), new Vector3(-2, 1.1f, -1), .25f),
        Sphere(new Vector3(2, 1.1f, -1), new Vector3(2, 1.1f, -1), .25f), ta, tb, tc, ta, tb, tc, true,
        (2 - Mathf.Sqrt(.25f * .25f - .1f * .1f)) / 4f);
    Sweep("面外擦过不扩大成整身", Sphere(new Vector3(-2, 1.4f, -1), new Vector3(-2, 1.4f, -1), .25f),
        Sphere(new Vector3(2, 1.4f, -1), new Vector3(2, 1.4f, -1), .25f), ta, tb, tc, ta, tb, tc, false);
    Sweep("有限箱体接触面", Sphere(Vector3.left * 2, Vector3.left * 2, 0f, Vector3.one * .2f),
        Sphere(Vector3.right * 2, Vector3.right * 2, 0f, Vector3.one * .2f), ta, tb, tc, ta, tb, tc, true,
        .45f);
    Sweep("三角面完全在箱内", Sphere(Vector3.zero, Vector3.zero, 0f, Vector3.one * 3),
        Sphere(Vector3.zero, Vector3.zero, 0f, Vector3.one * 3), ta, tb, tc, ta, tb, tc, true);
    Sweep("有限轴穿面", Sphere(Vector3.left, Vector3.right, 0f), Sphere(Vector3.left, Vector3.right, 0f),
        ta, tb, tc, ta, tb, tc, true);
    Sweep("退化成实际点", sphereFrom, sphereTo, Vector3.zero, Vector3.zero, Vector3.zero,
        Vector3.zero, Vector3.zero, Vector3.zero, true, .4375f);

    void CheckSurface(Actor actor, ConstructedBodyConnection connection, string sample)
    {
        object[] surfaceArgs = { actor.id, null, null };
        Check((bool)service.GetMethod("TryGetBodySurface", F).Invoke(null, surfaceArgs), sample + "同轮真实表面已发布");
        object pose = surfaceArgs[2];
        var matrices = (Matrix4x4[])Field(pose, "Matrices");
        var parts = (Array)Field(pose, "Parts");
        object running = ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>()
            .Single(c => (long)Field(c, "Id") == connection.CastId);
        object anchor = Field(Field(running, "Connection"), "Anchor");
        int anchorPart = (int)Field(anchor, "Part"), anchorTriangle = (int)Field(anchor, "Triangle");
        Vector3 weights = (Vector3)Field(anchor, "Weights"),
            local = (Vector3)anchor.GetType().GetMethod("Local", F).Invoke(anchor, new[] { pose }),
            world = (Vector3)anchor.GetType().GetMethod("Point", F).Invoke(anchor, new[] { pose });
        object selected = parts.GetValue(anchorPart);
        Vector3[] pointsOnPart = (Vector3[])Field(selected, "Vertices");
        int[] selectedIndices = (int[])Field(selected, "Triangles");
        object probe = Sphere(local, local, 0f);
        Vector3 faceA = pointsOnPart[selectedIndices[anchorTriangle]],
            faceB = pointsOnPart[selectedIndices[anchorTriangle + 1]],
            faceC = pointsOnPart[selectedIndices[anchorTriangle + 2]];
        object[] localArgs =
            { probe, probe, faceA, faceB, faceC, faceA, faceB, faceC, 0f, Vector3.zero, Vector3.zero };
        Check(weights.x >= 0f && weights.y >= 0f && weights.z >= 0f &&
              Mathf.Abs(weights.x + weights.y + weights.z - 1f) < .000001f &&
              (bool)triangle.Invoke(null, localArgs) &&
              Vector3.Distance(world, connection.TargetPoint) < .0001f,
            sample + "实际连接点位于原部件的真实三角面上", new
            {
                anchorPart, anchorTriangle,
                worldError = Vector3.Distance(world, connection.TargetPoint)
            });
        var external = AppDomain.CurrentDomain.GetAssemblies()
            .FirstOrDefault(a => a.GetType("FirstPerson.People") != null);
        if (external == null)
        {
            Sprite body = (Sprite)Field(surfaceArgs[1], "sprite"), head = (Sprite)Field(surfaceArgs[1], "head");
            Vector2 headAt = (Vector2)Field(surfaceArgs[1], "headPosition");
            int pieces = 0, invisible = 0;
            foreach (object part in parts)
            {
                Sprite image = (string)Field(part, "Id") == "head" ? head : body;
                Vector2 offset = image == head ? (headAt - body.pivot) / body.pixelsPerUnit : Vector2.zero;
                var points = (Vector3[])Field(part, "Vertices");
                for (int i = 0; i < points.Length; i += 8)
                {
                    Vector3 centre = (points[i] + points[i + 1] + points[i + 2] + points[i + 3]) * .25f;
                    int x = (int)image.rect.x +
                            Mathf.FloorToInt((centre.x - offset.x) * image.pixelsPerUnit + image.pivot.x),
                        y = (int)image.rect.y +
                            Mathf.FloorToInt((centre.y + centre.z - offset.y) * image.pixelsPerUnit +
                                             image.pivot.y);
                    if (image.texture.GetPixel(x, y).a == 0f) invisible++;
                    pieces++;
                }
            }

            Check(pieces > 0 && invisible == 0, sample + "原版表面投影位于实际可见像素内", new { pieces, invisible });
            return;
        }

        object figure = ((System.Collections.IDictionary)external.GetType(actor.asset.is_humanoid
                ? "FirstPerson.People"
                : "FirstPerson.Creatures")
            .GetField(actor.asset.is_humanoid ? "Figures" : "States", F).GetValue(null))[actor];
        object mesh = Field(figure, "Mesh");
        var adapter =
            service.Assembly.GetType("Cultiway.Content.Compatibility.Worldfall.BodyWorldfallRenderer");
        var transform = adapter.GetMethod("TransformPoint", F);
        Vector3 shift = (Vector3)service.Assembly
            .GetType("Cultiway.Content.Compatibility.Worldfall.WorldfallVisualBridge")
            .GetMethod("BodyShift", F).Invoke(null, new object[] { actor });
        float error = 0f;
        int vertices = 0, faces = 0;
        for (int i = 0; i < parts.Length; i++)
        {
            object part = parts.GetValue(i);
            if (((int[])Field(part, "Triangles")).Length == 0) continue;
            int transformIndex = (int)Field(part, "TransformIndex");
            if (transformIndex < 0) transformIndex = i;
            object drawnMesh = mesh;
            int drawnPart = transformIndex;
            Matrix4x4? organDraw = null;
            if (((string)Field(part, "Id")).StartsWith("organ:", StringComparison.Ordinal))
            {
                object attached = ((IEnumerable)Field(surfaceArgs[1], "organs")).Cast<object>()
                    .First(o => (int)Field(o, "Transform") == transformIndex);
                object prepared = ((IEnumerable)service.Assembly
                    .GetType("Cultiway.Content.Compatibility.Worldfall.BodyOrganWorldfall")
                    .GetField("Prepared", F)
                    .GetValue(null)).Cast<object>().Single(o => (long)Field(o, "Item1") == actor.id &&
                                                                (string)Field(o, "Item2") ==
                                                                (string)Field(attached, "Layer"));
                organDraw = (Matrix4x4)Field(prepared, "Item4");
            }

            string attachment = (string)Field(part, "Attachment");
            if (attachment?.StartsWith("armor.", StringComparison.Ordinal) == true)
            {
                var armour = (Array)Field(figure, "Armor");
                drawnMesh = armour.Cast<object>().Take((int)Field(figure, "ArmorShown")).First(m => m != null &&
                    ((ulong)Field(m, "Hidden") &
                     (1UL << transformIndex)) == 0);
            }
            else if (attachment == "item")
            {
                object held = ((IEnumerable)Field(surfaceArgs[1], "held")).Cast<object>().First(p =>
                    transformIndex >= (int)Field(p, "Start") &&
                    transformIndex < (int)Field(p, "Start") + ((Array)Field(p, "Parts")).Length);
                drawnMesh = Field(held, "Display");
                drawnPart = transformIndex - (int)Field(held, "Start");
            }

            faces += ((int[])Field(part, "Triangles")).Length / 3;
            foreach (Vector3 point in (Vector3[])Field(part, "Vertices"))
            {
                Vector3 drawn = organDraw.HasValue
                    ? organDraw.Value.MultiplyPoint3x4(point)
                    : (Vector3)transform.Invoke(null, new object[] { drawnMesh, drawnPart, point });
                error = Mathf.Max(error,
                    Vector3.Distance(drawn, matrices[transformIndex].MultiplyPoint3x4(point) + shift));
                vertices++;
            }
        }

        observed.Add(new { sample, vertices, faces, surfaceDisplayError = error });
        Check(vertices > 0 && faces > 0 && error < .0001f,
            sample + "三维可见身体逐顶点使用同一表面姿态", new { vertices, faces, error });
    }

    foreach (Building b in World.world.buildings.getSimpleList().ToArray()) b.removeBuildingFinal();
    var worldfall = AppDomain.CurrentDomain.GetAssemblies()
        .Select(a => a.GetType("FirstPerson.WorldBoxMod", false)).FirstOrDefault(t => t != null);
    if (worldfall != null)
    {
        object mod = worldfall.GetProperty("Instance", F).GetValue(null),
            sampler = worldfall.GetField("_sampler", F).GetValue(mod);
        sampler.GetType().GetMethod("Invalidate", F).Invoke(sampler, null);
        sampler.GetType().GetMethod("EnsureWorld", F).Invoke(sampler, null);
    }

    ControllableUnit.clear(false);
    var quietStats = new BaseStats();
    quietStats.addTag("frozen_ai");
    var quiet = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.Verify.Connections.Quiet")
        .SetStats(quietStats).SetDuration(10000).Build();
    var resistance = Cultiway.Core.Libraries.StatusEffectAsset
        .StartBuild("Cultiway.Verify.Connections.Resistance")
        .SetStats(new BaseStats { [BaseStatses.KnockbackReduction.id] = 3f }).SetDuration(10000).Build();

    void Quiet(Actor actor)
    {
        CombatStatusEffects.RemoveStatus(actor, hold);
        CombatStatusEffects.ApplyStatus(actor, quiet, 10000, actor);
        actor.updateStats();
    }

    Actor New(float x)
    {
        Actor actor = Make(x);
        made.Add(actor);
        Quiet(actor);
        return actor;
    }

    void Park()
    {
        Check(((IDictionary)service.GetField("bodySurfaces", F).GetValue(null)).Count == 0,
            "上一招结束后已释放目标表面，不把旧位置和朝向交给下一招");
        foreach (Actor actor in made)
        {
            CombatStatusEffects.ApplyStatus(actor, hold, 10000, actor);
            Place(actor, 12, 12);
        }

        made.Clear();
    }

    AbilityDefinition Action(string name, BodyRelationKind kind = BodyRelationKind.Grab, bool withdraw = false)
    {
        var d = JsonConvert.DeserializeObject<AbilityDefinition>(
            File.ReadAllText(Path.Combine(root, "Content/Skills/Body/palm-strike.json")));
        d.Id = "test.body-footwork.connections." + name;
        d.Name = "双方连接 " + name;
        d.Lifetime = 2f;
        d.Cooldown = 0f;
        d.Body.ActiveUntil = 1.5f;
        d.Body.ImpactRecoil = 0f;
        d.Body.Impact = new ConstructionImpact { DamageScale = 0f };
        var keys = d.Body.Keys.ToList();
        keys[keys.Count - 1].At = 2f;
        var stay = JsonConvert.DeserializeObject<BodyMotionKey>(
            JsonConvert.SerializeObject(keys[keys.Count - 2]));
        stay.At = 1.5f;
        if (withdraw)
        {
            stay.At = .8f;
            stay.Hand = new[] { .02f, .2f, .52f };
        }

        keys.Insert(keys.Count - 1, stay);
        d.Body.Keys = keys.ToArray();
        d.Body.Effector = "palm";
        d.Body.Construction = new BodyConstructionDefinition
        {
            Parts = new[]
            {
                new BodyPartInput { Id = "palm", Subject = BodyPartSubject.Source, Part = "hand.right" },
                new BodyPartInput { Id = "body", Subject = BodyPartSubject.Target, Part = "surface" }
            },
            Relations = new[]
                { new BodyRelationDefinition { Id = "hold", From = "palm", To = "body", Kind = kind } }
        };
        return d;
    }

    // BODY_CONNECTION_SCENARIOS_BEGIN
    var numbers = Action("numbers");
    var plan = AbilityCompiler.Compile(numbers, false);
    var f = new BodyFrame(Vector3.zero, Vector3.right, 1f, new Vector3(0, .16f, .62f), .28f, .27f, 1f);
    BodyPose origin = plan.Body.Sample(.25f, f);
    BodyHandConstraint pin = new(origin.Hand, Vector3.zero);
    BodyPose pinned = plan.Body.Sample(.5f, f.WithHandConstraint(pin));
    Check(Vector3.Distance(pinned.Hand, origin.Hand) < .0001f &&
          Mathf.Abs(Vector3.Distance(pinned.Shoulder, pinned.Elbow) - f.UpperLength) < .0001f &&
          Mathf.Abs(Vector3.Distance(pinned.Elbow, pinned.Hand) - f.LowerLength) < .0001f, "共同约束保持连接及原有双段骨长");
    BodyPose prior = plan.Body.Sample(.18f, f);
    Vector3 fixedPoint = prior.Hand;
    for (int i = 1; i <= 30; i++)
    {
        prior = plan.Body.Sample(.18f + i * .006f,
            f.WithHandConstraint(new BodyHandConstraint(fixedPoint, Vector3.zero)), previous: prior);
        Check(Vector3.Distance(prior.Hand, fixedPoint) < .0001f, "身体连续转向时仍固定原世界连接点，第" + i + "步");
    }

    // 真正两套身体尺寸及局部接触偏移，不能只用没有模型的裸关节代表实机。
    Actor fitActor = New(64);
    object fitBinding = null;
    await Game.WaitUntil(() => (fitBinding = Binding(fitActor, plan)) != null, 300);
    Check(fitBinding != null, "新生人物实际身体适配已就绪");
    BodyFrame realFrame = Frame(fitBinding, fitActor);
    var realPrior = plan.Body.Sample(.1712596f, realFrame);
    Vector3 localAnchor = new(.0074f, .0148f, .0285f);
    Vector3 realPoint = realPrior.Hand + realPrior.EffectorRotation * localAnchor;
    var realInput = realFrame.WithHandConstraint(new BodyHandConstraint(realPoint, localAnchor));
    for (int i = 1; i <= 30; i++)
    {
        realPrior = plan.Body.Sample(.1712596f + i * .0034f, realInput, previous: realPrior);
        Check(Vector3.Distance(realPrior.Hand + realPrior.EffectorRotation * localAnchor, realPoint) < .0001f,
            "两套实际身体和局部抓点在连续小转角下保持连接，第" + i + "步");
    }

    var far = plan.Body.Sample(.5f,
        f.WithHandConstraint(new BodyHandConstraint(new Vector3(5, 0, 0), Vector3.zero)));
    Check(
        Vector3.Distance(far.Hand, far.Shoulder) <= f.UpperLength + f.LowerLength + .0001f &&
        Vector3.Distance(far.Hand, new Vector3(5, 0, 0)) > 1f,
        "不可达连接不能伸长骨骼或把腕点强移到远处");
    // 控制条件逐项变化，保持同一对实际身体；外观组合另行覆盖，避免把随机衣型差异当成关系规则变化。
    Actor fixtureSource = New(64), fixtureTarget = New(64.25f);
    foreach (string sample in new[]
             {
                 "grab", "brace", "torso", "torsogap", "headgap", "envelope", "withdraw", "gap", "busy",
                 "immovable",
                 "external", "force", "resistance",
                 "walk", "speed", "pause"
             }.Where(sample => selectedCases.Length == 0 || selectedCases.Contains(sample)))
    {
        Park();
        float targetX = sample == "envelope" ? 64.35f :
            sample == "torsogap" || worldfall == null ? 64.25f : 64.18f;
        Actor source = fixtureSource, target = fixtureTarget;
        source.finishAngryStatus();
        target.finishAngryStatus();
        CombatStatusEffects.RemoveStatus(target, resistance);
        Quiet(source);
        Quiet(target);
        made.Add(source);
        made.Add(target);
        Place(source, 64, 72);
        Place(target, targetX, worldfall == null ? 72f : 71.87f);
        target.setKingdom(World.world.units.getSimpleList().First(a => a.kingdom != source.kingdom).kingdom);
        await Advance(.3f);
        var d = Action(sample, sample is "brace" or "withdraw" ? BodyRelationKind.Brace : BodyRelationKind.Grab,
            sample == "withdraw");
        if (sample is "torso" or "torsogap" or "headgap")
            d.Body.Construction.Parts.Single(p => p.Subject == BodyPartSubject.Target).Part =
                sample == "headgap" ? "head" : "torso";

        if (sample == "immovable")
        {
            CombatStatusEffects.ApplyStatus(target, hold, 10000, target);
            target.updateStats();
        }

        if (sample == "resistance")
        {
            CombatStatusEffects.ApplyStatus(target, resistance, 10000, target);
            target.updateStats();
        }

        if (sample == "walk")
        {
            target.setKingdom(source.kingdom);
            d.Body.Impact.Targets = SkillUseTargetRelation.Friendly;
            d.Impact = new ConstructionImpact { DamageScale = 0f, Targets = SkillUseTargetRelation.Friendly };
        }

        BodyControlLease other = sample == "busy"
            ? BodyControlState.TryAcquire(target.id, BodyOccupancy.LeftArm)
            : null;
        CombatStatusEffects.RemoveStatus(source, quiet);
        source.updateStats();
        source.cancelAllBeh();
        Place(source, 64, 72);
        Vector2 rootBefore = target.current_position;
        float hp = target.data.health;
        int start = relations.Count;
        Config.setWorldSpeed(sample == "speed" ? "x5" : "x1", false);
        await Fire(d, source, target, aggro: sample != "walk");
        if (sample is "gap" or "torsogap" or "headgap" or "envelope")
        {
            if (sample == "gap") Place(target, 65.3f, 72);
            await Advance(2.1f);
            Check(relations.Count == start && !BodyControlState.IsBusy(target.id),
                sample + "未碰到所选真实表面就不会建立关系或占用目标");
            continue;
        }

        Config.paused = false;
        await Game.WaitUntil(() => relations.Count > start, 900);
        Config.paused = true;
        await Game.WaitUntil(Boundary, 600);
        ConstructedBodyConnection began = relations[start];
        if (sample is "busy" or "immovable")
        {
            Check(
                began.State == ConstructedBodyConnectionState.Rejected &&
                began.Reason == (sample == "busy" ? "Occupied" : "Immovable"), sample + "真实接触后明确拒绝，不能夺取已有控制");
            if (other != null)
            {
                Check(BodyControlState.HasControl(target.id, BodyOccupancy.LeftArm), "拒绝抓持保留对方原凭据");
                other.Dispose();
            }

            await Advance(2.1f);
            continue;
        }

        var active = ConstructedAbilityService.GetBodyConnections()
            .SingleOrDefault(c => c.CastId == began.CastId);
        Check(began.State == ConstructedBodyConnectionState.Active &&
              active.State == ConstructedBodyConnectionState.Active && active.CastId == began.CastId &&
              BodyControlState.HasControl(target.id, BodyOccupancy.Stance), sample + "真实接触后取得并维持目标身体控制",
            new
            {
                began.State, events = relations.Skip(start).Select(r => new { r.State, r.Reason }),
                active.CastId
            });
        Check(
            Vector3.Distance(active.SourcePoint, active.TargetPoint) < .0001f &&
            target.current_position == rootBefore,
            sample + "双方连接点一致，未将目标拉向施术者");
        if (sample is "grab" or "brace")
        {
            if (worldfall != null) await Pair(source, sample, 0, true);
            else
            {
                World.world.camera.transform.position = new Vector3(64, 72.5f, 0);
                MoveCamera.instance.forceZoom(2.2f);
                World.world.console.Hide();
                for (int frame = 0; frame < 6; frame++) await Game.NextFrame();
                Tooltip.hideTooltipNow();
                Screen.Capture(Path.Combine(folder, sample + "-native.png"));
                for (int frame = 0; frame < 4; frame++) await Game.NextFrame();
            }

            CheckSurface(target, active, sample);
        }

        // 取样会临时启用人物控制；还原夹具的攻击间隔，避免收势后原版普通攻击混入。
        source.attack_timer = 999;
        if (sample == "pause")
        {
            double now = World.world.getCurWorldTime();
            float remaining = active.Remaining;
            for (int i = 0; i < 8; i++) await Game.NextFrame();
            Check(
                World.world.getCurWorldTime() == now && ConstructedAbilityService.GetBodyConnections()
                    .Single(c => c.CastId == began.CastId).Remaining == remaining,
                "暂停绘制不会消耗维持预算或重复建立关系");
        }

        if (sample == "walk")
        {
            CombatStatusEffects.RemoveStatus(target, quiet);
            target.updateStats();
            target.cancelAllBeh();
            target.goTo(World.world.GetTileSimple(70, 72));
        }

        if (sample == "external") Place(target, 69f, 72f);
        if (sample == "force")
        {
            Actor attacker = New(68);
            var push = JsonConvert.DeserializeObject<AbilityDefinition>(JsonConvert.SerializeObject(d));
            push.Id += ".push";
            push.Body = null;
            push.Lifetime = .5f;
            push.Binding = new ConstructionBinding { Anchor = AbilityAnchor.Source };
            push.Root = new ConstructionNode
            {
                Id = "touch", Form = "sword",
                Offset = new[] { target.current_position.x - 68f, target.current_position.y - 72f, 0f },
                OnContact = ConstructionContactResponse.End
            };
            push.Impact = new ConstructionImpact
                { DamageScale = 0f, Impulse = new[] { 4f, 0f, 0f }, SlideSeconds = .18f };
            await Fire(push, attacker, target);
        }

        await Advance(sample == "resistance" ? .6f : sample is "external" or "force" ? .2f : .4f);
        bool shouldEnd = sample is "external" or "force" or "resistance";
        if (!shouldEnd && sample != "withdraw")
        {
            var held = ConstructedAbilityService.GetBodyConnections().Single(c => c.CastId == began.CastId);
            Check(
                Vector3.Distance(held.SourcePoint, held.TargetPoint) < .0001f &&
                target.current_position == rootBefore, sample + "跨多步维持真实接触点和位置");
        }

        await Advance(2.1f);
        var ended = relations.Skip(start)
            .Where(c => c.CastId == began.CastId && c.State == ConstructedBodyConnectionState.Released)
            .ToArray();
        Check(
            ended.Length == 1 && !BodyControlState.IsBusy(target.id) && !ConstructedAbilityService
                .GetBodyConnections().Any(c => c.CastId == began.CastId), sample + "只解除一次并归还目标控制");
        if (sample == "external")
            Check(ended[0].Reason == "ExternalMove" && target.current_position.x > 68f, "外部搬移解除旧关系，不把目标拉回旧根点");
        if (sample == "force")
            Check(ended[0].Reason == "Interrupted" && target.current_position != rootBefore,
                "实际法术受力解除抓持并继续推动目标");
        if (sample == "resistance")
            Check(ended[0].Reason == "Exhausted" && ended[0].WorldTime < ended[0].Until - .5d,
                "目标抗性消耗同一份预算并提前脱离");
        if (sample == "withdraw") Check(ended[0].Reason == "Withdrawn", "抵住在原动作收手时解除");
        if (sample == "walk")
        {
            target.goTo(World.world.GetTileSimple(70, 72));
            await Advance(1f);
            Check(Vector2.Distance(target.current_position, rootBefore) > .1f, "释放后原版真实移动恢复");
        }

        if (sample != "force")
            Check(target.data.health == hp, sample + "关系本身不重复造成伤害",
                new { before = hp, after = target.data.health });
        observed.Add(new
            { sample, began.CastId, reason = ended[0].Reason, span = ended[0].WorldTime - began.WorldTime });
        Config.setWorldSpeed("x1", false);
    }

    File.WriteAllText(Path.Combine(folder, "observed.json"),
        JsonConvert.SerializeObject(observed, Formatting.Indented));
    return new { passed = true, checks = checks.Count };
}
// BODY_CONNECTION_CLEANUP_BEGIN
finally
{
    ConstructedAbilityService.BodyConnectionChanged -= Related;
    ConstructedAbilityService.ContactConfirmed -= Hit;
    ConstructedAbilityService.CastEnded -= Ended;
    ControllableUnit.clear(false);
    Config.paused = true;
    Config.setWorldSpeed("x1", false);
}
