// 固定有限种子覆盖新接触创作；沿用原模型及运动，不扩身体装备。
Actor source = Make(64); var owner = source.GetExtend(); owner.NewCultisys(Cultisyses.Xian); owner.GetCultisys<Xian>().level = 2;
owner.MarkCultiwayStatsDirty(); source.setStatsDirty(); source.updateStats(); owner.GetCultisys<Xian>().wakan = 10000;
var current = ConstructedAbilityService.ReadInspiration(owner);
var inspiration = new ConstructionInspiration(current.Elements, current.Aggression, current.Control, current.CanProject, 12);
JObject Canon(AbilityDefinition definition) { var value = JObject.FromObject(definition); value.Remove("Id"); value.Remove("Creator"); return value; }
IEnumerable<ConstructionNode> Nodes(ConstructionNode node) { if (node == null) yield break; yield return node; foreach (var child in node.Children) foreach (var nested in Nodes(child)) yield return nested; }
var representatives = new Dictionary<string, AbilityDefinition>(); var attempts = new List<object>();
var capture = service.GetMethod("CaptureCreationResources", F);
try
{
    Check(inspiration.Rules == 12, "复现已交付的第十二版规则");
    for (int seed = 0; seed < 24 && (!representatives.ContainsKey("hostile") || !representatives.ContainsKey("support")); seed++)
    {
        try
        {
            var resources = (SynthesisResources)capture.Invoke(null, new object[] { owner, seed, inspiration });
            var generated = ConstructedAbilityService.Generate(owner, seed, inspiration, resources: resources);
            Check(JToken.DeepEquals(Canon(generated), Canon(ConstructedAbilityService.Generate(owner, seed, inspiration, resources: resources))), "同一冻结输入重现完整结果 " + seed);
            var impacts = Nodes(generated.Root).Select(n => n.Impact ?? generated.Impact).Where(v => v != null).Concat(generated.Body?.Impact == null ? Array.Empty<ConstructionImpact>() : new[] { generated.Body.Impact }).ToArray();
            if (impacts.Any(v => v.Targets == Cultiway.Core.SkillLibV3.Usage.SkillUseTargetRelation.Hostile && v.Statuses?.Length > 0)) representatives["hostile"] = generated;
            if (impacts.Any(v => v.Targets == Cultiway.Core.SkillLibV3.Usage.SkillUseTargetRelation.Friendly && (v.Restoration != null || v.Statuses?.Length > 0))) representatives["support"] = generated;
            attempts.Add(new { seed, generated.Id, generated.Cost });
        }
        catch (InvalidDataException error) { attempts.Add(new { seed, rejected = error.Message }); }
        await Game.NextFrame();
    }
    File.WriteAllText(Path.Combine(folder, "attempts.json"), JsonConvert.SerializeObject(attempts, Formatting.Indented));
    Check(representatives.ContainsKey("hostile") && representatives.ContainsKey("support"), "独立创作出现负状态和沿原几何运动的友方恢复或祝福");
    var basis = JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root, "Scripts/SpellDemos/fixtures/construction-batch/01-charge.json")));
    basis.Id = "test.contact-creation.original"; basis.Resource = "wakan"; basis.Root.Operations[0].Id = "outward";
    basis.Steps = new[] { new ConstructionStep { Id = "spin", Operation = new ConstructionOperation { Kind = ConstructionOperationKind.Spin, Vector = new[] { 0f, 0f, 90f } }, Inputs = new Dictionary<string, ConstructionOutputReference> { ["part"] = new() { Node = "root" }, ["after"] = new() { Node = "root", Operation = "outward", Output = "flight", Stage = ConstructionOutputStage.Started } } } };
    AbilityDefinition derived = null; int chosenSeed = -1;
    for (int seed = 0; seed < 32 && derived == null; seed++)
    {
        try
        {
            var result = ConstructedAbilityService.Generate(owner, seed, inspiration, basis);
            if (result.Parent.Change == "接触作用") { derived = result; chosenSeed = seed; }
        }
        catch (InvalidDataException error) { attempts.Add(new { seed, otherDerivationRejected = error.Message }); }
        await Game.NextFrame();
    }
    Check(derived != null && JToken.DeepEquals(JArray.FromObject(basis.Steps), JArray.FromObject(derived.Steps)) && JToken.DeepEquals(JArray.FromObject(basis.Root.Operations), JArray.FromObject(derived.Root.Operations)), "正式接触派生保留其他运动、时点、命名步骤及输出引用", new { chosenSeed });
    var plan = AbilityCompiler.Compile(derived, false); var oldPrice = ConstructionPricing.Price(ConstructionEditing.Copy(derived)); var newPrice = ConstructionPricing.Price(ConstructionEditing.Copy(derived), contactRules: 12);
    var expectedPrice = ConstructionPricing.Reprice(basis, ConstructionEditing.Copy(derived), contactRules: 12);
    Check(plan.Measure.ContactEffectsWork > 0 && newPrice.Cost > oldPrice.Cost && derived.Cost == expectedPrice.Cost && derived.Cost > basis.Cost, "新状态和恢复计入真实创作费用，原计算仍可重现", new { plan.Measure.Work, plan.Measure.ContactEffectsWork, oldCost = oldPrice.Cost, newCost = newPrice.Cost });
    File.WriteAllText(Path.Combine(folder, "derivation-attempts.json"), JsonConvert.SerializeObject(attempts, Formatting.Indented));
    File.WriteAllText(Path.Combine(folder, "source.json"), JsonConvert.SerializeObject(basis, Formatting.Indented));
    File.WriteAllText(Path.Combine(folder, "derived.json"), JsonConvert.SerializeObject(derived, Formatting.Indented));
    File.WriteAllText(Path.Combine(folder, "selected.json"), JsonConvert.SerializeObject(new { seed = chosenSeed }, Formatting.Indented));
    File.WriteAllText(Path.Combine(folder, "representatives.json"), JsonConvert.SerializeObject(representatives, Formatting.Indented));
    return new { passed = true, closed = "接触独立创作和原术派生", checks, chosenSeed, process = System.Diagnostics.Process.GetCurrentProcess().Id };
}
finally { ConstructedAbilityService.ContactConfirmed -= Hit; ConstructedAbilityService.CastEnded -= Ended; Config.paused = true; ControllableUnit.clear(false); }
