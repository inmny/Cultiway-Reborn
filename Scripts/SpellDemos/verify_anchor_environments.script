// 使用真正地块、原版受力与本人附身检查挂点；不手动推进技能系统。
using System;
using System.IO;
using System.Linq;
using System.Collections;
using System.Collections.Generic;
using System.Reflection;
using System.Threading.Tasks;
using Newtonsoft.Json;
using UnityEngine;
using Friflo.Engine.ECS;
using Cultiway.Core;
using Cultiway.Core.Components;
using Cultiway.Core.Skills;
using Cultiway.Core.SkillLibV3;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Components;
using Cultiway.Core.Visuals.Forms;
using Cultiway.Content.Components;
using Cultiway.Content.Combat;
using Cultiway.Content.Skills;
using Cultiway.Content.CreatureCompositions.Services;
using Cultiway.Content.CreatureCompositions.ActiveAbilities;
using Cultiway.Content.CreatureCompositions.Visuals;
using Cultiway.Content.YaoBeasts;
using Cultiway.Utils.Extension;

const BindingFlags Flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static | BindingFlags.Instance;
        object Get(object o, string n) => o.GetType().GetField(n, Flags)?.GetValue(o) ?? o.GetType().GetProperty(n, Flags).GetValue(o);
        object Call(object o, string n, params object[] a) => o.GetType().GetMethod(n, Flags).Invoke(o, a);
        float[] Point(Vector3 p) => new[] { p.x, p.y, p.z };
        async Task Frames(int count = 5) { for (int i = 0; i < count; i++) { Config.paused = true; await Game.NextFrame(); } }
        async Task Until(Func<bool> condition) { Config.paused = false; await Game.WaitUntil(condition, 1800); Config.paused = true; await Frames(); }
        async Task Advance(float seconds) { double end = World.world.getCurWorldTime() + seconds; await Until(() => World.world.getCurWorldTime() >= end); }
        void Place(Actor a, float x) { a.stopForce(); a.stopMovement(); a.position_height = 0; a.current_position = new Vector2(x, 64.5f); a.setCurrentTile(World.world.GetTileSimple((int)x, 64)); a.updatePos(); a.checkIsInLiquid(); }
        string root = Cultiway.ModClass.I.GetDeclaration().FolderPath;
        string folder = Path.Combine(root, "artifacts/skill_rebuild/body-anchors/environments"); Directory.CreateDirectory(folder);
        var checks = new List<object>(); var samples = new List<object>(); var births = new List<object>(); var items = new List<object>();
        void Check(bool pass, string name, object evidence = null) => checks.Add(new { pass, name, evidence });
        Game.Resume(); Config.paused = true; ControllableUnit.clear(false);
        World.world.save_manager.loadWorld(Path.Combine(root, "artifacts/skill_rebuild/performance-baseline/cultiway/worlds/none"));
        await Game.NextFrame(); await Game.WaitUntil(() => !SmoothLoader.isLoading(), 3600); await Frames();
        World.world.console.Hide(); foreach (var loading in Resources.FindObjectsOfTypeAll<LoadingScreen>()) loading.gameObject.SetActive(false);
        Cultiway.Const.GeneralSettings.SwitchSkillSystems(true); Config.setWorldSpeed("x1", false);
        var stats = new BaseStats(); stats.addTag("frozen_ai"); stats.addTag("immovable");
        var hold = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.Verify.AnchorEnvironments.Hold").SetStats(stats).SetDuration(10000).Build();
        foreach (Actor other in World.world.units.getSimpleList().ToArray()) CombatStatusEffects.ApplyStatus(other, hold, 10000, other);
        Actor actor = World.world.units.createNewUnit("human", World.world.GetTileSimple(64, 64), pAdultAge: true, pSpawnWithItems: false);
        Actor enemy = World.world.units.createNewUnit("human", World.world.GetTileSimple(65, 64), pAdultAge: true, pSpawnWithItems: false);
        enemy.setKingdom(World.world.kingdoms_wild.get(AssetManager.actor_library.get("wolf").kingdom_id_wild));
        actor.addTrait("super_health"); enemy.addTrait("super_health");
        CombatStatusEffects.ApplyStatus(enemy, hold, 10000, enemy);
        var owner = actor.GetExtend(); owner.AddComponent(new Xian { level = 2, wakan = 10000 });
        ConstructedAbilityService.Learn(owner, BodyActionCatalog.PalmId);
        actor.setStatsDirty(); actor.updateStats(); enemy.setStatsDirty(); enemy.updateStats();
        var assembly = AppDomain.CurrentDomain.GetAssemblies().First(a => a.GetType("FirstPerson.WorldBoxMod", false) != null);
        object mod = assembly.GetType("FirstPerson.WorldBoxMod").GetProperty("Instance", Flags).GetValue(null);
        object sampler = Get(mod, "_sampler");
        var renderer = typeof(Cultiway.ModClass).Assembly.GetType("Cultiway.Content.Compatibility.Worldfall.FormWorldfallRenderer", true);
        var bodyBinding = typeof(Cultiway.ModClass).Assembly.GetType("Cultiway.Content.Skills.BodyActionBinding", true);
        var native = Cultiway.ModClass.I.GeneralRenderSystems.ChildSystems.OfType<FormNativeRenderSystem>().Single();
        var nativeViews = (IList)typeof(FormNativeRenderSystem).GetField("views", Flags).GetValue(native);
        Actor beast = World.world.units.createNewUnit("wolf", World.world.GetTileSimple(66, 64), pAdultAge: true);
        var yao = beast.GetExtend(); yao.E.RemoveComponent<Xian>(); yao.E.RemoveComponent<Knight>(); yao.E.RemoveComponent<Magic>();
        Check(YaoAwakeningService.TryAwakenByRain(yao), "实际启灵狼身");
        Check(YaoFormPlanService.TrySetOrgans(yao, YaoFormIds.TrueForm, new[] {
    new YaoOrganRecord { SlotId = YaoContent.Slots.Surface, OrganId = "yao.scale.basic", Rank = 1, Origin = YaoOrganOrigin.Innate },
    new YaoOrganRecord { SlotId = YaoContent.Slots.Head, OrganId = "yao.horn.thunder", Rank = 2, Origin = YaoOrganOrigin.GodEdited }
}), "雷角实际安装");
        beast.setStatsDirty(); beast.updateStats(); beast.addTrait("super_health"); CombatStatusEffects.ApplyStatus(beast, hold, 10000, beast);
        yao.GetCultisys<Yao>().yao_power = 1000;
        CreatureOrganSkillRegistry.EnsureBuilt(); CreatureOrganSkillRegistry.TryGetContainer("Cultiway.ChainLightning", out Entity container);
        Action<Entity> created = e =>
        {
            var c = e.GetComponent<SkillContext>(); if (c.SourceId != beast.id) return;
            Vector3 p = e.GetComponent<Position>().value;
            bool resolved = SkillCastPlanner.TryResolveSourcePosition(yao, container, out Vector3 outlet);
            births.Add(new { position = Point(p), outlet = Point(outlet), resolved, error = Vector3.Distance(p, outlet), height = beast.position_height, frame = beast.calculateMainSprite().name, time = World.world.getCurWorldTime() });
        };
        Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured += created;
        try
        {
            foreach (string mode in new[] { "native", "firstperson" })
            {
                Call(mod, "ViewForTest", false); Call(mod, "SetGodView", false); ControllableUnit.clear(false); await Frames(30);
                World.world.camera.transform.position = new Vector3(65, 64, 0); MoveCamera.instance.forceZoom(5);
                if (mode == "firstperson")
                {
                    Call(mod, "ViewForTest", true); ControllableUnit.setControllableCreatureAndSelected(actor);
                    await Game.WaitUntil(() => (bool)Get(mod, "IsFirstPerson") && (bool)Get(mod, "DiveDone"), 3600);
                    Call(mod, "SetYaw", 0f); Call(mod, "SetPitchDegrees", -18f);
                    Check(ReferenceEquals(ControllableUnit.getControllableUnit(), actor), "第一人称附身实际施法者本人");
                }
                else
                {
                    await Game.WaitUntil(() => !(bool)Get(mod, "GodShown") && !(bool)Get(mod, "IsFirstPerson"), 3600);
                    Check(!(bool)Get(mod, "GodShown") && !(bool)Get(mod, "IsFirstPerson"), "原版视角实际启用");
                }
                foreach (string environment in new[] { "flat", "slope", "water", "jump" })
                {
                    for (int y = 60; y <= 69; y++) for (int x = 60; x <= 69; x++)
                            World.world.GetTileSimple(x, y).setTileTypes(environment == "water" ? TileLibrary.shallow_waters : environment == "slope" && x >= 65 ? TileLibrary.hills : TileLibrary.soil_low, null, true);
                    Call(sampler, "Invalidate"); Call(sampler, "EnsureWorld"); await Frames(10);
                    Place(actor, 64.5f); Place(enemy, 65.02f); Place(beast, 66.5f);
                    if (actor.hasWeapon()) actor.equipment.weapon.takeAwayItem(); actor.setStatsDirty(); actor.updateStats();
                    if (environment == "water") Check(actor.isAffectedByLiquid() && beast.isAffectedByLiquid(), mode + "身体真实进入水中");
                    if (environment == "slope") Check(Mathf.Abs((float)Call(Get(sampler, "Cache"), "SampleHeight", 65.5f, 64.5f) - (float)Call(Get(sampler, "Cache"), "SampleHeight", 63.5f, 64.5f)) > .1f, mode + "实际地块存在坡度");
                    actor.lookTowardsPosition(enemy.current_position); actor.attack_timer = 0;
                    Check(ActiveAbilityService.TryUse(owner, new ActiveAbilityHandle("content.constructed", owner.E, BodyActionCatalog.PalmId), new ActiveAbilityTarget(enemy, enemy.GetSimPos()), ActiveAbilityUseOrigin.Script), mode + "/" + environment + "正式掌击受理");
                    actor.attack_timer = 999; enemy.attack_timer = 999;
                    if (environment == "jump") { actor.addForce(0, 0, 1.4f); beast.addForce(0, 0, 1.4f); }
                    await Advance(.08f);
                    Check(ConstructedAbilityService.TryGetBodyPose(actor.id, out var pose), mode + "/" + environment + "发布实际动作");
                    var hand = FormVisualScene.Instances.Single(i => i.GroundActorId == actor.id && i.Resource.Description.Id == "hand");
                    Vector3 wrist = hand.PartTransform(0).MultiplyPoint3x4(new Vector3(0, -.04f, 0));
                    Check(Vector3.Distance(wrist, pose.Hand) < .0001f, mode + "/" + environment + "共同腕点保持接触位置");
                    if (environment == "jump") Check(actor.under_forces && actor.position_height > 0 && beast.under_forces && beast.position_height > 0, mode + "真实原版受力抬起两个身体");
                    if (mode == "native")
                    {
                        int index = 0; Matrix4x4 actual = default;
                        foreach (var instance in FormVisualScene.Instances) { if (instance.GroundActorId == actor.id && instance.Resource.Description.Id == "hand") break; index += instance.PartCount; }
                        actual = (Matrix4x4)Get(Get(nativeViews[index], "Draw"), "Transform");
                        Vector3 shift = actor.move_jump_offset + actor.shake_offset;
                        Check(Vector3.Distance(actual.MultiplyPoint3x4(new Vector3(0, -.04f, 0)), pose.Hand + shift) < .0001f, environment + "原版实际绘制腕点随身体显示偏移");
                    }
                    else
                    {
                        var draws = ((IEnumerable)renderer.GetField("solids", Flags).GetValue(null)).Cast<object>().ToArray();
                        Check(draws.Any(d => ReferenceEquals(Get(d, "Resource"), hand.Resource)), environment + "本人第一人称提交实际手部");
                        Screen.Capture(Path.Combine(folder, "self-" + environment + ".png")); await Frames();
                    }
                    int before = births.Count; beast.flip = environment != "slope";
                    var plan = SkillCastPlanner.CreatePlan(yao, container, enemy, 1);
                    Check(Cultiway.ModClass.I.SkillV3.StartSkillSequence(yao, container, plan, 1), mode + "/" + environment + "正式器官施放受理");
                    await Until(() => births.Count > before);
                    samples.Add(new { mode, environment, height = actor.position_height, force = actor.under_forces, tile = actor.current_tile.Type.id, hand = Point(pose.Hand), time = World.world.getCurWorldTime() });
                    await Advance(.8f);
                }
            }
            // 不把同一剑模型冒称成不同器物；核对真实装备类型及当前明确拒绝的边界。
            var sword = AbilityCompiler.Compile(JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root, "Content/Skills/Body/sword-thrust.json"))));
            foreach (string group in new[] { "sword", "axe", "spear", "bow" })
            {
                var asset = AssetManager.items.list.First(i => i.group_id == group);
                if (actor.hasWeapon()) actor.equipment.weapon.takeAwayItem();
                Item item = World.world.items.generateItem(asset, pActor: actor); actor.equipment.setItem(item, actor); actor.setStatsDirty(); actor.updateStats();
                bool supported = (bool)bodyBinding.GetMethod("CanBind", Flags).Invoke(null, new object[] { owner, sword.Body });
                Check(supported == (group == "sword"), group + "真实器物的握持适配边界", new { asset.id, supported });
                items.Add(new { asset.id, group, supported, limitation = supported ? "已有共用剑形及握点" : "尚缺专属资源与握持资料，当前拒绝套用剑动作" });
            }
            Check(births.Count == 8 && births.All(b => (bool)Get(b, "resolved") && (float)Get(b, "error") < .0001f), "八次实际环境施放出生点与器官出口一致", births);
        }
        finally
        {
            Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured -= created;
            File.WriteAllText(Path.Combine(folder, "observations.json"), JsonConvert.SerializeObject(new { checks, samples, births, items }, Formatting.Indented));
            ControllableUnit.clear(false); Call(mod, "ViewForTest", false); Call(mod, "SetGodView", false); Config.paused = true;
        }
        var report = new
        {
            passed = checks.All(c => (bool)Get(c, "pass")),
            checks,
            samples,
            births,
            items,
            process = System.Diagnostics.Process.GetCurrentProcess().Id,
            scope = "原版真实地形与腾起、施法者本人第一人称、器物支持边界；不代表三维器官或完整装备制作验收"
        };
        File.WriteAllText(Path.Combine(folder, "checks.json"), JsonConvert.SerializeObject(report, Formatting.Indented));
        return new { report.passed, checks = checks.Count, samples = samples.Count, births = births.Count };
