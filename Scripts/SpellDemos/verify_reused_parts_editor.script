try
{
    Child();
    var blade = Session().Draft.Root.Children[0];
    Check(blade.Form == "sword_grave_right" && Gate().Trigger == ConstructionChangeTrigger.Handoff &&
          Gate().InheritRemainder && !Gate().KeepSourcePosition, "同一编辑入口读取真实交锋点落下的原刃片");
    Row("KeepSourcePosition").GetComponentsInChildren<Toggle>(false).Single().isOn = true;
    Check(Gate().KeepSourcePosition && Button("Replace").interactable, "可用同一开关改为从原根位置接替");
    Click("Undo");
    Check(!Gate().KeepSourcePosition, "撤销恢复交锋点及原刃片");
    Row("ResetContacts").GetComponentsInChildren<Toggle>(false).Single().isOn = false;
    await Capture("cz");
    Click("Replace");
    var saved = ConstructionEditing.Access.Read(Session().SourceId);
    Click("Close");
    await Frames();
    LocalizedTextManager.instance.setLanguage("en");
    WindowWanfaConstructionEditor.Open(saved.Id, source);
    await Frames();
    Child();
    Check(!Gate().KeepSourcePosition && !Gate().ResetContacts &&
          Session().Draft.Root.Children[0].Operations.Any(op => op.When?.Trigger == ConstructionChangeTrigger.WorldContact),
          "正式保存并重开后保留改造及实际触地条件");
    await Capture("en");
    return new { passed = true };
}
finally
{
    if (Field(editor, "session") != null) typeof(WindowWanfaConstructionEditor).GetMethod("CloseNow", F).Invoke(editor, null);
    ReleaseChecks();
    LocalizedTextManager.instance.setLanguage("cz");
}
