// 使用正式主动能力入口，核对原器官和实际出手。
const string provider = "content.creature_phenotype";
const string thunder = "yao.horn.thunder";
const string layer = "yao.layer.horn_thunder";
const long cancelled = 100901, fired = 100902;
Actor source = Make(64f, "wolf"), enemy = Make(69f);
ActorExtend owner = source.GetExtend();
Check(YaoAwakeningService.TryAwakenByRain(owner), "对练狼经正式启灵");
var organs = new[]
{
    new YaoOrganRecord { SlotId = YaoContent.Slots.Surface, OrganId = "yao.scale.basic", Rank = 1, Origin = YaoOrganOrigin.Innate },
    new YaoOrganRecord { SlotId = YaoContent.Slots.Head, OrganId = thunder, Rank = 2, Origin = YaoOrganOrigin.GodEdited }
};
Check(YaoFormPlanService.TrySetOrgans(owner, YaoFormIds.TrueForm, organs), "正式组合基础鳞与雷角");
source.setStatsDirty();
source.updateStats();
source.addAggro(enemy);
enemy.addAggro(source);
owner.GetCultisys<Yao>().yao_power = 1000f;
CreatureOrganSkillRegistry.EnsureBuilt();

ActiveAbilityHandle[] Entries()
{
    var handles = new List<ActiveAbilityHandle>();
    ActiveAbilityService.Collect(owner, handles);
    return handles.Where(handle => handle.ProviderId == provider).ToArray();
}
bool Use(ActiveAbilityHandle handle, long correlation)
{
    source.attack_timer = 0f;
    bool accepted = ActiveAbilityService.TryUse(owner, handle, new ActiveAbilityTarget(enemy, enemy.GetSimPos(),
        runtimeData: new SkillCastRuntimeData { CorrelationId = correlation }), ActiveAbilityUseOrigin.Script);
    source.attack_timer = 999f;
    return accepted;
}
bool Pending(long correlation) => Cultiway.ModClass.I.W.Query<SkillCastSequence>().Entities.Any(e =>
    !e.Tags.Has<TagRecycle>() && e.GetComponent<SkillCastSequence>().RuntimeData.CorrelationId == correlation);
Vector3 Outlet()
{
    var body = owner.E.GetComponent<CreaturePhenotype>();
    if (!CreaturePhenotypeCompiler.TryGetCompiled(body.CompiledIndex, body.Signature, out var compiled) ||
        !CreatureAppearanceService.TryGetAnchor(compiled, source, layer, "cast", out Vector3 point))
        throw new InvalidOperationException("当前头部没有正式雷角出口");
    return point;
}
var starts = new List<(ConstructedCastStarted Fact, Vector3 Point, Vector3 Outlet)>();
var spending = new List<float>();
var hits = new List<ConstructedContact>();
void Spend(ActorExtend actor, YaoPowerMutation mutation)
{
    if (actor == owner && mutation.Kind == YaoPowerMutationKind.Spend) spending.Add(-mutation.Delta);
}
void Started(ConstructedCastStarted fact)
{
    if (fact.SourceId != source.id || fact.CorrelationId is not (cancelled or fired)) return;
    var running = ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>()
        .Single(value => (long)Field(value, "Id") == fact.CastId);
    starts.Add((fact, (Vector3)Field(running, "LastSourceFoot"), Outlet()));
}
void Contact(ConstructedContact fact)
{
    if (starts.Any(value => value.Fact.CastId == fact.CastId)) hits.Add(fact);
}
ConstructedAbilityService.CastStarted += Started;
ConstructedAbilityService.ContactConfirmed += Contact;
YaoResourceService.MutationCommitted += Spend;
try
{
    var former = Entries().Single();
    float cost = SkillCastCost.CalculateStepDemand(former.Source);
    Check(cost > 0f && Use(former, cancelled) && Pending(cancelled) && spending.Count == 0,
        "真实器官入口受理，实际发射前没有扣妖力", new { cost, entry = former.EntryId });
    Check(YaoFormPlanService.TryReplaceOrgan(owner, YaoFormIds.TrueForm, YaoContent.Slots.Head,
        "yao.spirit.sense", 1, YaoOrganOrigin.GodEdited), "保持合法身体并换去雷角");
    Check(Entries().Length == 0 && !Use(former, cancelled + 10), "被撤换的原器官入口立即失效");
    await Advance(.18f);
    Check(!Pending(cancelled) && starts.Count == 0 && spending.Count == 0,
        "等待中的原器官释放结束，没有出手或扣费");

    Check(YaoFormPlanService.TrySetOrgans(owner, YaoFormIds.TrueForm, organs), "恢复同一具身体的雷角");
    source.setStatsDirty();
    source.updateStats();
    var current = Entries().Single();
    Vector3 before = Outlet();
    Check(Use(current, fired) && Pending(fired), "重新取得的器官入口可以施法");
    Place(source, 66f);
    ConstructedAbilityService.NotifyActorChanged(source);
    await Advance(.38f);
    var hit = starts.Single();
    Check(hit.Fact.CorrelationId == fired && spending.Count == 1 && Mathf.Abs(spending[0] - cost) < .002f &&
          Vector2.Distance(hit.Point, hit.Outlet) < .001f && Vector2.Distance(hit.Point, before) > 1f &&
          hits.Any(value => value.TargetId == enemy.id) && !Pending(fired),
        "真实雷链从移动后的器官发出，只扣实际妖力并接触对练对象",
        new { before = before.ToString(), emitted = hit.Point.ToString(), outlet = hit.Outlet.ToString(),
              cost, spending, targets = hits.Select(value => value.TargetId).ToArray() });
    return new { passed = true, process = System.Diagnostics.Process.GetCurrentProcess().Id };
}
finally
{
    YaoResourceService.MutationCommitted -= Spend;
    ConstructedAbilityService.ContactConfirmed -= Contact;
    ConstructedAbilityService.CastStarted -= Started;
    ConstructedAbilityService.CastEnded -= Ended;
    Config.paused = true;
}
