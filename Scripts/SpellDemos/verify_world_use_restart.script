// 真正重启后，恢复可选使用规则及尚未完成的日常需求；不重放旧回能。
using System;using System.IO;using System.Linq;using System.Reflection;using System.Collections.Generic;using System.Threading.Tasks;using Newtonsoft.Json;using Newtonsoft.Json.Linq;using UnityEngine;using DebugToolbox.Runtime.Scripting;using Cultiway.Core;using Cultiway.Core.Skills;using Cultiway.Core.SkillLibV3.ActiveAbilities;using Cultiway.Content.Skills;using Cultiway.Content.Components;using Cultiway.Content.Combat;using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/world-use");var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));bool capture=false;var frameTimes=new List<double>();Directory.CreateDirectory(Path.Combine(folder,"frames"));var checks=new List<string>();void Check(bool v,string n){if(!v)throw new InvalidOperationException(n);checks.Add(n);Log.Info(n);}JToken Section(string json,string id)=>JObject.Parse(json)["sections"][id];
Check(System.Diagnostics.Process.GetCurrentProcess().Id!=(int)expected["process"],"使用另一个实际游戏进程恢复");var holdStats=new BaseStats();holdStats.addTag("frozen_ai");holdStats.addTag("immovable");var hold=Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.WorldUseHold")??Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.WorldUseHold").SetStats(holdStats).SetDuration(10000).Build();
var quiet=Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.WorldUseQuiet")??Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.WorldUseQuiet").SetStats(new BaseStats{["multiplier_speed"]=-1f}).SetDuration(10000).Build();
var runnerType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=runnerType.GetProperty("Instance").GetValue(null);async Task Boundary()=>await Game.WaitUntil(()=>(bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;if(!capture)await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);else{double start=World.world.getCurWorldTime(),next=start;while(World.world.getCurWorldTime()<until){await Game.NextFrame();double now=World.world.getCurWorldTime();if(now<next)continue;World.world.camera.transform.position=new Vector3(69,73,World.world.camera.transform.position.z);MoveCamera.instance.forceZoom(8);World.world.camera.orthographicSize=8;World.world.setZoomOrthographic(8);new ScreenFacade().Capture(Path.Combine(folder,"frames",frameTimes.Count.ToString("00000")+".png"));frameTimes.Add(now-start);next=now+.1;}}Config.paused=true;await Boundary();}
Config.paused=true;Game.Resume();ControllableUnit.clear(false);World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();World.world.console.Hide();foreach(var screen in Resources.FindObjectsOfTypeAll<LoadingScreen>())screen.gameObject.SetActive(false);var actor=World.world.units.get((long)expected["owner"]);var other=World.world.units.get((long)expected["other"]);Check(actor!=null&&other!=null,"恢复两个真实原支付者");var owner=actor.GetExtend();var saves=Cultiway.ModClass.I.WorldSaves;Check(JToken.DeepEquals(Section((string)expected["world"],"ability_constructions"),Section(saves.World.Capture(World.world,"world-use"),"ability_constructions")),"完整构造、世界场景和地点规则原样恢复");Check(JToken.DeepEquals(Section((string)expected["person"],"ability_knowledge"),Section(saves.Actors.Capture(owner,"world-use"),"ability_knowledge")),"原人物的已学关系及各能力冷却原样恢复");Check(saves.LastReport.Skipped.Count==0&&saves.LastReport.BackupError==null,"当前正式格式恢复没有资料丢弃或备份错误");string safe=(string)expected["safe"];var definition=ConstructionEditing.Access.Read(safe);Check(definition.Use.Channels==ActiveAbilityChannel.World&&definition.Use.Target==ActiveAbilityTargetMode.Point&&definition.Root.Operations.Single().Recovery.TemporaryOnly,"正式保存的实际选择与永久结构保护保持");
var selectable=new List<ActiveAbilityHandle>();typeof(ActorExtend).Assembly.GetType("Cultiway.Core.ControlledCultivatorSkillControls").GetMethod("CollectSelectableAbilities",F).Invoke(null,new object[]{actor,selectable});Check(selectable.Any(h=>h.EntryId==safe&&h.ProviderId=="content.constructed"),"原有附体能力选择入口包含恢复后的世界地点能力");
JArray Rows()=>(JArray)Section(saves.World.Capture(World.world,"world-use"),"world_materials")["data"]["Records"];long pending=(long)expected["pending"],completed=(long)expected["completed"],kept=(long)expected["kept"],theirs=(long)expected["theirs"];var before=Rows();Check(before.Any(r=>(long)r["Id"]==pending)&&!before.Any(r=>(long)r["Id"]==completed),"只恢复尚未回收的材料，不复活旧完成材料");Check(before.Any(r=>(long)r["Id"]==kept)&&before.Any(r=>(long)r["Id"]==theirs),"永久结构和另一支付者材料仍是实际世界事实");Check(actor.hasTag("frozen_ai"),"等待状态随人物恢复，加载过程不会抢先施放");
var starts=new List<ConstructedCastStarted>();var changes=new List<WorldMaterialChange>();void Start(ConstructedCastStarted c){if(c.SourceId==actor.id)starts.Add(c);}void Change(WorldMaterialChange c){changes.Add(c);}ConstructedAbilityService.CastStarted+=Start;WorldMaterialService.Changed+=Change;
try{await Advance(2.5f);Check(starts.Count==0,"仍然冻结自主行为时，恢复的需求不代替人物施放");CombatStatusEffects.RemoveStatus(actor,hold);actor.setStatsDirty();actor.updateStats();capture=true;await Advance(5);capture=false;Check(starts.Count==1&&starts[0].Origin==ActiveAbilityUseOrigin.Autonomous&&starts[0].AbilityId==safe,"真实重启后从已学构造与世界材料重建一次自主使用");Check(changes.Any(c=>c.Id==pending&&c.Kind=="recover")&&changes.Where(c=>c.Id==pending&&c.Kind=="credit").Sum(c=>c.Granted)>7.49,"新恢复需求实际收束并入账原资源");Check(!changes.Any(c=>c.Id==completed&&c.Kind=="credit"),"读档没有再次发放已完成的旧回能");Check(!changes.Any(c=>(c.Id==kept||c.Id==theirs)&&c.Kind=="recover"),"恢复后的自主选择继续保留永久材料及其他支付者材料");var after=Rows();Check(!after.Any(r=>(long)r["Id"]==pending)&&after.Any(r=>(long)r["Id"]==kept)&&after.Any(r=>(long)r["Id"]==theirs),"实际世界结果与需求完成一致");int count=starts.Count;await Advance(3);Check(starts.Count==count,"恢复后的需求完成后继续停止重复支付");var result=new{passed=true,checks,process=System.Diagnostics.Process.GetCurrentProcess().Id,autonomous=starts.Count,frameTimes,credited=changes.Where(c=>c.Id==pending&&c.Kind=="credit").Sum(c=>c.Granted)};File.WriteAllText(Path.Combine(folder,"restart-result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;}finally{ConstructedAbilityService.CastStarted-=Start;WorldMaterialService.Changed-=Change;Config.paused=true;}
