// 正式反射后的原支付者、最后路径、来源失效与清世界提交边界。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using UnityEngine;
using Cultiway.Content.Skills;
using Cultiway.Content.Combat;
using Cultiway.Content.Components;
using Cultiway.Core.Skills;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Static|BindingFlags.Instance;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/recovery");var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}Config.paused=true;Game.Resume();Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;
var runnerType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=runnerType.GetProperty("Instance").GetValue(null);bool Boundary()=>(bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner);async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,1800);Config.paused=true;await Game.WaitUntil(Boundary,1800);}
var stats=new BaseStats();stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.RecoveryBoundaryHold").SetStats(stats).SetDuration(10000).Build();void Place(Actor a,float x,float y){a.stopMovement();a.current_position=new Vector2(x,y);a.setCurrentTile(World.world.GetTileSimple((int)x,(int)y));a.updatePos();}foreach(var a in World.world.units.getSimpleList().ToArray()){CombatStatusEffects.ApplyStatus(a,hold,10000,a);Place(a,12,12);}
Actor Make(int x){var a=World.world.units.createNewUnit("human",World.world.GetTileSimple(x,72),pAdultAge:true,pSpawnWithItems:false);a.addTrait("super_health");CombatStatusEffects.ApplyStatus(a,hold,10000,a);a.attack_timer=999;var owner=a.GetExtend();owner.AddComponent(new Xian{level=2,wakan=100});owner.MarkCultiwayStatsDirty();a.setStatsDirty();a.updateStats();Place(a,x,72);return a;}
var left=Make(64);var right=Make(72);var wolf=World.world.units.createNewUnit("wolf",World.world.GetTileSimple(12,12),pAdultAge:true);CombatStatusEffects.ApplyStatus(wolf,hold,10000,wolf);right.setKingdom(wolf.kingdom);left.addAggro(right);right.addAggro(left);await Advance(.1f);
var rec=new List<ConstructedRecovery>();var refs=new List<ConstructedReflection>();var hits=new List<ConstructedContact>();void R(ConstructedRecovery r){if(r.AbilityId.StartsWith("test.recover.boundary"))rec.Add(r);}void Reflect(ConstructedReflection r){if(r.AbilityId.StartsWith("test.recover.boundary"))refs.Add(r);}void Hit(ConstructedContact r){if(r.AbilityId.StartsWith("test.recover.boundary"))hits.Add(r);}ConstructedAbilityService.RecoveryConfirmed+=R;ConstructedAbilityService.ReflectionConfirmed+=Reflect;ConstructedAbilityService.ContactConfirmed+=Hit;
void Fire(AbilityDefinition d,Actor from,Actor to){ConstructedAbilityService.Register(d);var owner=from.GetExtend();ConstructedAbilityService.Learn(owner,d.Id);Check(ActiveAbilityService.TryUse(owner,new ActiveAbilityHandle("content.constructed",owner.E,d.Id),new ActiveAbilityTarget(to,to.GetSimPos()),ActiveAbilityUseOrigin.Script),d.Id+"正式施放");}
var clear=typeof(ConstructedAbilityService).GetMethod("Clear",F);
AbilityDefinition Shot(string id,float recoverAt)=>new(){Id="test.recover.boundary."+id,Resource="wakan",Cost=8,Cooldown=0,Lifetime=2.5f,TargetRange=24,Binding=new ConstructionBinding{Anchor=AbilityAnchor.Source},Root=new ConstructionNode{Id="shot",Form="sword",Matter="iron",Scale=.2f,Offset=new[]{1f,0f,.4f},Rotation=new[]{0f,90f,0f},Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Fly,Vector=new[]{10f,0f,0f},WorldVelocity=true,InheritVelocity=false},new ConstructionOperation{Kind=ConstructionOperationKind.Recover,At=recoverAt,Seconds=.5f,Recovery=new ConstructionRecovery{Efficiency=.75f}}}}};
try{
var ward=Shot("ward",1.5f);ward.Resource="none";ward.Cost=0;ward.Power=1000/right.stats["damage"];ward.Root.ContactRole=ConstructionContactRole.Barrier;ward.Root.Interception=ConstructionInterception.Reflect;ward.Root.Offset=new[]{-1f,0f,.4f};ward.Root.Operations=Array.Empty<ConstructionOperation>();Fire(ward,right,left);var shot=Shot("reflected",.8f);left.GetExtend().GetCultisys<Xian>().wakan=50;right.GetExtend().GetCultisys<Xian>().wakan=50;Fire(shot,left,right);await Advance(1.4f);Check(refs.Count==1,"来袭主体通过正式交锋真实反射一次");Check(hits.Count==0,"收束发生在折返接触原人物之前，未用掉的部分仍可回收");Check(rec.Where(r=>r.AbilityId==shot.Id).All(r=>r.ProviderId==left.id)&&Math.Abs(rec.Where(r=>r.AbilityId==shot.Id).Sum(r=>r.Granted)-6)<.001,"反射后仍向原支付者返还六点，当前控制者不取得退款");Check(!rec.Any(r=>r.ProviderId==right.id&&r.Granted>0),"反射者没有取得他人的支付份额；自然恢复不计作本次退款");
clear.Invoke(null,null);refs.Clear();rec.Clear();hits.Clear();Place(left,64,72);Place(right,72,72);ward.Id+=".death";Fire(ward,right,left);shot.Id+=".death";shot.Root.Operations[1].At=1.1f;Fire(shot,left,right);await Advance(.65f);Check(refs.Count==1,"来源失效场景先真实交接了控制");left.data.health=0;typeof(Actor).GetMethod("die",F).Invoke(left,new object[]{false,AttackType.Other,true,true});Check(!left.isAlive()||!left.hasHealth(),"实际死亡入口已使原支付者失效");await Advance(1.2f);Check(rec.Where(r=>r.AbilityId==shot.Id).All(r=>r.Granted==0),"原支付者失去生命后不把回能给反射者或失效人物");
// 使用新来源检查最后一小段运动不会被开始收束的零力量吞掉。
clear.Invoke(null,null);rec.Clear();hits.Clear();var source=Make(64);Place(right,72,72);var early=Shot("last-path",.05f);early.Root.Scale=.03f;early.Root.Offset=new[]{0f,0f,.4f};early.Root.Operations[0].Vector=new[]{200f,0f,0f};Fire(early,source,right);await Advance(.2f);Check(hits.Any(h=>h.AbilityId==early.Id&&h.TargetId==right.id&&h.Age<.05f),"开始收束前最后路径实际命中，不被预测后的零力量漏掉");await Advance(.6f);Check(rec.Where(r=>r.AbilityId==early.Id).Sum(r=>r.Granted)==0,"最后路径先消费预算，随后收束不能退款");
clear.Invoke(null,null);var first=Shot("clear-first",.05f);first.Root.ContactRole=ConstructionContactRole.Decoration;first.Root.Operations[0].Vector=new float[3];var second=ConstructionEditing.Copy(first);second.Id="test.recover.boundary.clear-second";Fire(first,source,right);Fire(second,source,right);bool cleared=false;void ClearOnReturn(ConstructedRecovery r){if(!cleared&&r.AbilityId==first.Id&&r.Granted>0){cleared=true;clear.Invoke(null,null);}}ConstructedAbilityService.RecoveryConfirmed+=ClearOnReturn;int old=rec.Count;try{await Advance(.4f);}finally{ConstructedAbilityService.RecoveryConfirmed-=ClearOnReturn;}Check(cleared,"回能提交事件中实际清理了旧世界执行");Check(!rec.Skip(old).Any(r=>r.AbilityId==second.Id&&r.Granted>0),"清理后同轮其他旧施放不继续写资源");
}finally{ConstructedAbilityService.RecoveryConfirmed-=R;ConstructedAbilityService.ReflectionConfirmed-=Reflect;ConstructedAbilityService.ContactConfirmed-=Hit;Config.paused=true;}
var result=new{passed=true,checks,reflections=refs.Count,recoveries=rec.Count};File.WriteAllText(Path.Combine(folder,"boundaries.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
