// 真正退出重启后恢复正式构造，运行资源版本和缓存不进入存档。
using System;
using System.IO;
using System.Linq;
using System.Collections.Generic;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Core.Visuals.Forms;
using Cultiway.Utils.Extension;
string folder=Path.Combine(Cultiway.ModClass.I.GetDeclaration().FolderPath,"artifacts/skill_rebuild/resource-versions");var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));
var checks=new List<string>();void Check(bool value,string name){if(!value)throw new InvalidOperationException(name);checks.Add(name);}
Check((int)expected["process"]!=System.Diagnostics.Process.GetCurrentProcess().Id,"使用真正退出重启后的另一游戏进程");Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;
var actor=World.world.units.get((long)expected["actor"]);var saves=Cultiway.ModClass.I.WorldSaves;JToken Section(string value,string id)=>JObject.Parse(value)["sections"][id]["data"];
Check(actor!=null,"原版存档恢复实际创造者");Check(JToken.DeepEquals(Section((string)expected["world"],"ability_constructions"),Section(saves.World.Capture(World.world,"resource"),"ability_constructions")),"更新后的完整构造在冷启动后恢复");Check(JToken.DeepEquals(Section((string)expected["person"],"ability_knowledge"),Section(saves.Actors.Capture(actor.GetExtend(),"resource"),"ability_knowledge")),"学习关系在冷启动后恢复");
var access=ConstructionEditing.Access;var d=access.Read((string)expected["id"]);Check(d.Revision==1&&d.Cost==6&&d.Root.Scale==1.4f,"同修订的实际更新资料完整保留");var plan=access.Validate(d);Check(plan.ResourceVersion==FormResources.Version&&ReferenceEquals(plan,access.Validate(ConstructionEditing.Copy(d))),"读档按当前已安装资源重新建立共享计划");
Check(FormResources.Load("water_wave").Rig.Motion("recede")!=null,"临时删除的动作已经恢复为正式资源");Check(!((string)expected["world"]).Contains("ResourceVersion")&&!((string)expected["person"]).Contains("ResourceVersion"),"存档不携带运行资源版本及对象缓存");Check(!saves.LastReport.RequiresBackup,"恢复未要求丢弃构造或其他世界进度");
var result=new{passed=true,checks,process=System.Diagnostics.Process.GetCurrentProcess().Id,version=FormResources.Version};File.WriteAllText(Path.Combine(folder,"restart-result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
