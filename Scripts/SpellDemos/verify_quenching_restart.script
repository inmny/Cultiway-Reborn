// 真正冷启动恢复失水后的世界材料和已学火术，不重放旧蒸散或旧伤害。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using Cultiway.Core.Skills;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Usage;
using Cultiway.Content.Skills;
using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/quenching");var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));var checks=new List<string>();void Check(bool value,string name){if(!value)throw new Exception(name);checks.Add(name);}
Check((int)expected["process"]!=System.Diagnostics.Process.GetCurrentProcess().Id,"正式保存与恢复使用不同游戏进程");async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;var type=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=type.GetProperty("Instance").GetValue(null);await Game.WaitUntil(()=>(bool)type.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);}
Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;var saves=Cultiway.ModClass.I.WorldSaves;Check((saves.LastReport.Skipped.Count==0&&saves.LastReport.BackupError==null),"正式存档没有局部丢弃或临时状态缺失");var doc=JObject.Parse(saves.World.Capture(World.world,"quenching"));var before=JObject.Parse((string)expected["world"]);var oldRows=(JArray)before["sections"]["world_materials"]["data"]["Records"];var rows=(JArray)doc["sections"]["world_materials"]["data"]["Records"];Check(rows.Count>0&&rows.Count==oldRows.Count&&JToken.DeepEquals(rows,oldRows),"世界水体的真实失水、支付、动量、蒸散去向及来源完整恢复");Check(((IList)typeof(ConstructedAbilityService).GetField("casts",F).GetValue(null)).Count==0,"读档不重建已经结束的火施放");var defs=(IDictionary)typeof(ConstructedAbilityService).GetField("definitions",F).GetValue(null);var definition=expected["definition"].ToObject<AbilityDefinition>();Check(defs.Contains(definition.Id)&&JToken.DeepEquals(JObject.FromObject(defs[definition.Id]),JObject.FromObject(definition)),"火质、连续火体及轨迹由正式已学资料恢复");
var source=World.world.units.get((long)expected["actor"]);var target=World.world.units.get((long)expected["target"]);Check(source!=null&&target!=null&&source.isAlive()&&target.isAlive(),"原来源和目标稳定编号恢复");var stats=new BaseStats();stats["mana"]=1024;stats["damage"]=40;stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.QuenchingRestartHold").SetStats(stats).SetDuration(10000).Build();foreach(var actor in new[]{source,target}){Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(actor,hold,10000,actor);actor.GetExtend().MarkCultiwayStatsDirty();actor.setStatsDirty();actor.updateStats();actor.setMana(512);}var contacts=new List<ConstructedContact>();void Contact(ConstructedContact c)=>contacts.Add(c);ConstructedAbilityService.ContactConfirmed+=Contact;var reactions=new List<ConstructedQuenching>();void Reaction(ConstructedQuenching e)=>reactions.Add(e);ConstructedAbilityService.QuenchingConfirmed+=Reaction;
try{await Advance(.2f);Check(reactions.Count==0,"恢复后继续世界不重放旧蒸散");source.addAggro(target);target.addAggro(source);var handle=new ActiveAbilityHandle("content.constructed",source.GetExtend().E,definition.Id);float mana=source.getMana(),hp=target.data.health;Check(ActiveAbilityService.TryUse(source.GetExtend(),handle,new ActiveAbilityTarget(target,target.GetSimPos()),ActiveAbilityUseOrigin.Script)&&source.getMana()==mana-definition.Cost,"已学火术再次经正式入口支付施放");await Advance(3.1f);Check(reactions.Count>0&&reactions.All(e=>e.WaterCast==0&&e.WorldWater.Length>0),"重新施放真实接触已恢复的世界水体");Check(reactions.Last().Remaining==0&&contacts.Count==0,"恢复后的水域继续以真实余量灭火，人物没有受到完整旧伤害");var afterRows=(JArray)JObject.Parse(saves.World.Capture(World.world,"quenching"))["sections"]["world_materials"]["data"]["Records"];Check(afterRows.Sum(r=>(double)r["Material"]["Volume"])<rows.Sum(r=>(double)r["Material"]["Volume"]),"新反应继续消耗现有材料而非重新补满水量");var result=new{passed=true,checks,savedProcess=(int)expected["process"],process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"restart.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;}finally{ConstructedAbilityService.ContactConfirmed-=Contact;ConstructedAbilityService.QuenchingConfirmed-=Reaction;foreach(var actor in new[]{source,target})Cultiway.Content.Combat.CombatStatusEffects.RemoveStatus(actor,hold);Config.paused=true;}
