// 用原有铁枪在正式窗口改握点、曲线、尺寸和接触面。
WanfaEditorRow PoseRow(int index) => editor.GetComponentsInChildren<WanfaEditorRow>(false)
    .Single(row => ((Text)Field(row, "_title")).text == string.Format(T("BodyKey"), index));

void SetNumber(WanfaEditorRow row, string key, string value)
{
    var input = row.GetComponentsInChildren<InputField>(false).Single(field => field.name == key);
    input.text = value;
    input.onEndEdit.Invoke(value);
}

async Task Shot(string key, string name)
{
    World.world.console.Hide();
    Tooltip.hideTooltipNow();
    foreach (var loading in Resources.FindObjectsOfTypeAll<LoadingScreen>()) loading.gameObject.SetActive(false);
    var row = (RectTransform)Row(key).transform;
    var scroll = row.GetComponentInParent<ScrollRect>();
    var content = scroll.content;
    Vector2 point = content.InverseTransformPoint(row.position);
    float travel = content.rect.height - scroll.viewport.rect.height;
    if (travel > 0)
        scroll.verticalNormalizedPosition = Mathf.Clamp01(1f - (content.rect.yMax - point.y - 35f) / travel);
    await Frames();
    Screen.Capture(Path.Combine(folder, name + ".png"));
    await Frames();
}

try
{
    Click("Page2");
    Check(((Text)Field(Row("HeldForm"), "_detail")).text.StartsWith("长枪"), "中文身体页显示长枪名称");
    Select("MartialGrip", T("MartialGripMiddle"));
    Check(Session().Draft.Body.Grip == "mid", "主手可以改用同一枪杆上的中握");
    Click("Undo");
    Check(JToken.DeepEquals(original, JToken.FromObject(Session().Draft)), "撤销握点后完整恢复原招");

    Select("MartialSlideGrip", T("MartialGripMiddle"));
    Select("BodyValues", T("BodyGripSlide"));
    SetNumber(PoseRow(2), "BodyGripSlide", ".5");
    var validSlide = JToken.FromObject(Session().Draft);
    SetNumber(PoseRow(2), "BodyGripSlide", "1.2");
    Check(Session().Draft.Body.Keys[1].GripSlide == .5f && JToken.DeepEquals(validSlide, JToken.FromObject(Session().Draft)),
        "逐姿态修改滑握比例，越过两端时保留上一份有效草稿");
    SetNumber(Row("MartialWeaponScale"), "MartialWeaponScale", ".49");
    var scaled = JToken.FromObject(Session().Draft);
    SetNumber(Row("MartialWeaponScale"), "MartialWeaponScale", ".7");
    Check(Session().Draft.Body.WeaponScale == .49f && JToken.DeepEquals(scaled, JToken.FromObject(Session().Draft)),
        "尺寸修改遵守实际柄粗，过粗时保留原有可握尺寸");

    Select("MartialTouchShape", T("MartialShape.shaft"));
    var rod = ConstructionEditing.Access.Validate(Session().Draft).Body;
    Check(rod.Construction.Relations.Single(relation => relation.Kind == BodyRelationKind.Touch).FromAnchor == "shaft",
        "可以选择实际杆段作为普通接触，不改变滑握曲线");
    Click("Undo");
    var tip = ConstructionEditing.Access.Validate(Session().Draft).Body;
    var originalBody = ConstructionEditing.Access.Validate(basis).Body;
    Check(JToken.DeepEquals(scaled, JToken.FromObject(Session().Draft)) && tip.ContactReach > originalBody.ContactReach + .05f &&
          tip.ContactReach > rod.ContactReach,
        "从实际尖端和杆身分别计算距离", new { original = originalBody.ContactReach, tip = tip.ContactReach, rod = rod.ContactReach });
    await Shot("MartialWeaponScale", "long-weapon-edit-cz");
    Click("Replace");
    string edited = Session().SourceId;
    Check(edited != basisId && JToken.DeepEquals(scaled["Body"], JToken.FromObject(ConstructionEditing.Access.Read(edited))["Body"]) &&
          JToken.DeepEquals(original, JToken.FromObject(ConstructionEditing.Access.Read(basisId))),
        "正式应用保留尺寸、滑握和原招资料");
    Click("Close");
    await Frames();
    LocalizedTextManager.instance.setLanguage("en");
    WindowWanfaConstructionEditor.Open(edited, source);
    await Frames();
    Click("Page2");
    Check(((Text)Field(Row("HeldForm"), "_detail")).text.StartsWith("Long spear"), "英文身体页显示长枪名称");
    Check(Session().Draft.Body.WeaponScale == .49f && Session().Draft.Body.SlideGrip == "mid",
        "正式改造重开后仍显示改造尺寸和滑握终点");
    await Shot("MartialWeaponScale", "long-weapon-edit-en");
    Click("Close");
    await Frames();

    const string sweep = "Cultiway.Body.LongSpearSweep";
    ConstructedAbilityService.Learn(source.GetExtend(), sweep);
    WindowWanfaConstructionEditor.Open(sweep, source);
    await Frames();
    Click("Page2");
    var originalSweep = JToken.FromObject(Session().Draft);
    Select("MartialSupportGrip", T("MartialGripStandard"));
    Check(JToken.DeepEquals(originalSweep, JToken.FromObject(Session().Draft)), "两手不能使用同一处握点");
    Select("MartialSupportGrip", T("MartialGripMiddle"));
    var left = ConstructionEditing.Access.Validate(Session().Draft).Body;
    Check(left.Grip == "grip" && left.Construction.SupportGrip == "mid",
        "只调整左手托握时，主手仍握原处");
    Click("Close");
    await Frames();
    File.WriteAllText(Path.Combine(folder, "edited-definition.json"),
        JsonConvert.SerializeObject(ConstructionEditing.Access.Read(edited), Formatting.Indented));
    if (selection == "archive") SaveWorld(edited);
    return new { passed = true, selection, edited, checks };
}
finally
{
    ConstructedAbilityService.ContactConfirmed -= Hit;
    ConstructedAbilityService.CastEnded -= Ended;
    LocalizedTextManager.instance.setLanguage("cz");
    Config.paused = true;
}

void SaveWorld(string edited)
{
    var target = Make(66f);
    target.setKingdom(World.world.kingdoms_wild.get(AssetManager.actor_library.get("wolf").kingdom_id_wild));
    Item weapon = World.world.items.generateItem(AssetManager.items.get("spear_iron"), pActor: source);
    source.equipment.setItem(weapon, source);
    foreach (Actor actor in new[] { source, target })
    {
        CombatStatusEffects.RemoveStatus(actor, hold);
        actor.setStatsDirty();
        actor.updateStats();
        actor.attack_timer = 999;
    }

    var ids = new[] { basisId, "Cultiway.Body.LongSpearSweep", "Cultiway.Body.LongSpearDeflect", edited };
    foreach (string id in ids) ConstructedAbilityService.Learn(source.GetExtend(), id);
    World.world.units.checkContainer();
    World.world.items.checkLists();
    foreach (Actor actor in World.world.units.getSimpleList()) CombatStatusEffects.RemoveStatus(actor, hold);
    Place(source, 64.35f);
    Place(target, 66f);
    Check(ReferenceEquals(weapon, source.getWeapon()) && World.world.units.getSimpleList().Contains(source) &&
          World.world.units.getSimpleList().Contains(target) && World.world.items.list.Contains(weapon),
        "原铁枪和两名对练人物已进入世界保存",
        new { source = source.id, target = target.id, weapon = weapon.data.id });
    string archive = Path.Combine(folder, "archive");
    SaveManager.saveWorldToDirectory(archive);
    Check(File.Exists(Path.Combine(archive, "map.wbox")), "正式世界档已经写入");
    File.WriteAllText(Path.Combine(folder, "expected.json"), JsonConvert.SerializeObject(new
    {
        process = System.Diagnostics.Process.GetCurrentProcess().Id, source = source.id, target = target.id,
        weapon = weapon.data.id, edited, definitions = ids.Select(ConstructionEditing.Access.Read).ToArray()
    }, Formatting.Indented));
}
