const BindingFlags Flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static | BindingFlags.Instance;
            string root = Cultiway.ModClass.I.GetDeclaration().FolderPath, folder = Path.Combine(root, "artifacts/skill_rebuild/range-motion-hold"); Directory.CreateDirectory(folder);
            var checks = new List<object>(); void Check(bool pass, string name, object evidence = null) => checks.Add(new { pass, name, evidence });
            bool Near(double a, double b) => Math.Abs(a - b) < .0002 * Math.Max(1, Math.Abs(b));
            bool Same(Matrix4x4 a, Matrix4x4 b) { for (int i = 0; i < 16; i++) if (!Near(a[i], b[i])) return false; return true; }
            var inputs = new AbilityInputs(Vector3.zero, new Vector3(26, 0, 0), Vector3.right, 1);
            AbilityCast Cast(AbilityDefinition d, BodyFrame? body = null) => new(AbilityCompiler.Compile(d, false), Matrix4x4.identity, body, inputs);
            List<FormVisualInstance> Views(AbilityCast cast) { var values = new List<FormVisualInstance>(); cast.AppendVisuals(values); return values; }
            List<AbilityCapsule> Contacts(AbilityCast cast) { var values = new List<AbilityCapsule>(); cast.AppendContacts(values); return values; }
            AbilityDefinition Wave() => new() { Id = "test.range-hold.wave", Lifetime = 5, Cost = 4, Cooldown = .3f, Binding = new ConstructionBinding { Anchor = AbilityAnchor.Source, FaceTarget = true }, Root = new ConstructionNode { Id = "wave", Form = "water_wave", Matter = "water", ActiveFromMarker = "rise", ActiveUntilMarker = "fall" }, Steps = new[] { new ConstructionStep { Id = "move", Operation = new ConstructionOperation { Kind = ConstructionOperationKind.Fly, Vector = new[] { 0f, 0, 2 }, InheritVelocity = false }, Inputs = new() { ["part"] = new ConstructionOutputReference { Node = "root" } } }, new ConstructionStep { Id = "break", Operation = new ConstructionOperation { Kind = ConstructionOperationKind.Animate, Clip = "break", At = .4f }, Inputs = new() { ["part"] = new ConstructionOutputReference { Node = "root" } } } } };
            var source = Wave(); string original = JsonConvert.SerializeObject(source); var sustained = ConstructionMagnitudeEdits.Sustain(source, 1.2f); var hold = sustained.Steps[1].Operation.Hold;
            Check(hold != null && Near(hold.At, 1.008) && Near(hold.Seconds, 1.2) && sustained.Root.Hold == null, "命名动作使用从实际启动算起的独立维持，保留真实阶段");
            var paused = Cast(sustained); paused.Advance(.4f + hold.At + .2f, inputs.Target); var first = Views(paused).Single(); var firstSkin = first.Skin.ToArray(); float firstX = first.Transform.m03; paused.Advance(.5f, inputs.Target); var second = Views(paused).Single();
            Check(firstSkin.Zip(second.Skin, Same).All(x => x) && Near(second.Transform.m03 - firstX, 1), "维持期间真实骨架固定，独立投送仍以原速度前进");
            Check(Contacts(paused).Count > 0 && paused.StepStateOf("break") == ConstructionStepState.Running, "制作阶段与实际作用共同维持，不能提前报告动作完成");
            typeof(AbilityCast).GetMethod("SaveStep", Flags).Invoke(paused, null); paused.Advance(.3f, inputs.Target); var predicted = Views(paused).Single().Skin.ToArray(); typeof(AbilityCast).GetMethod("RestoreStep", Flags).Invoke(paused, null); paused.Advance(.3f, inputs.Target); Check(predicted.Zip(Views(paused).Single().Skin, Same).All(x => x), "共同预测回退保留动作已用维持时间，重放姿态一致");
            var resumed = Cast(sustained); resumed.Advance(3.6f, inputs.Target); var baseCast = Cast(source); baseCast.Advance(2.4f, inputs.Target); Check(Views(resumed).Single().Skin.Zip(Views(baseCast).Single().Skin, Same).All(x => x), "维持结束后按原速继续收势，未跳到未来姿态");
            resumed.Advance(1f, inputs.Target); Check(resumed.StepStateOf("break") == ConstructionStepState.Completed, "完整动作结束才给后续步骤真实完成输出");
            var stretched = ConstructionMagnitudeEdits.Duration(sustained, 2); Check(Near(stretched.Steps[1].Operation.Hold.At, hold.At * 2) && Near(stretched.Steps[1].Operation.Hold.Seconds, 2.4), "整段伸缩同步动作局部维持"); var slow = Cast(stretched); slow.Advance(3.6f * 2, inputs.Target); Check(Views(slow).Single().Skin.Zip(Views(resumed).Single().Skin, Same).Any(x => !x), "不同真实动作进度不会被错误固定成同一姿态");
            var copies = ConstructionMagnitudeEdits.Repeat(sustained, 2, 0, .5f); Check(copies.Steps.Where(s => s.Operation.Hold != null).All(s => Near(s.Operation.Hold.At, hold.At)) && Near(copies.Steps[3].Operation.At, .9), "错时复制只推迟启动，不重复推迟动作内部维持");
            var palm = ConstructionEditing.Access.Read(BodyActionCatalog.PalmId); var gated = Wave(); gated.Body = ConstructionEditing.Copy(palm).Body; gated.Steps[1].Operation.At = 0; gated.Steps[1].Operation.When = new ConstructionCondition { Source = "body", Trigger = ConstructionChangeTrigger.End }; var gatedHold = ConstructionMagnitudeEdits.Sustain(gated, 1.2f); var frame = new BodyFrame(Vector3.zero, Vector3.right, 2, new Vector3(0, .16f, .62f), .48f, .54f, 1); var waiting = Cast(gatedHold, frame); float begin = AbilityCompiler.Compile(gated).Body.Duration; waiting.Advance(begin + hold.At + .1f, inputs.Target); firstSkin = Views(waiting).Single().Skin.ToArray(); waiting.Advance(.5f, inputs.Target); Check(firstSkin.Zip(Views(waiting).Single().Skin, Same).All(x => x), "等待真实身体事件不会提前消耗命名动作的维持秒数");
            var chain = Wave(); chain.Steps = chain.Steps.Skip(1).ToArray(); chain.Steps = chain.Steps.Concat(new[] { new ConstructionStep { Id = "recede", Operation = new ConstructionOperation { Kind = ConstructionOperationKind.Animate, Clip = "recede" }, Inputs = new() { ["part"] = new ConstructionOutputReference { Step = "break", Output = "part" }, ["after"] = new ConstructionOutputReference { Step = "break", Output = "animation" } } } }).ToArray(); chain.Root.ActiveUntilMarker = "spread"; chain.Lifetime = 5.2f; var chainHeld = ConstructionMagnitudeEdits.Sustain(chain, 1); Check(Near(chainHeld.Lifetime, 7.2), "等待完成的两段动作各维持一秒，整次截止容纳最长因果链"); var sequence = Cast(chainHeld); sequence.Advance(7.1f, inputs.Target); Check(sequence.StepStateOf("break") == ConstructionStepState.Completed && sequence.StepStateOf("recede") == ConstructionStepState.Completed, "两段真实动作均完成，未被只延长一次的总寿命截断");
            var native = Wave(); native.Root.ActiveFromMarker = null; native.Root.ActiveUntilMarker = null; native.Root.Operations = new[] { new ConstructionOperation { Kind = ConstructionOperationKind.Animate, Clip = "break", Hold = new ConstructionHold { At = 1, Seconds = 1 } } }; native.Steps = Array.Empty<ConstructionStep>(); var nativeCast = Cast(native); nativeCast.Advance(1.2f, inputs.Target); firstSkin = Views(nativeCast).Single().Skin.ToArray(); nativeCast.Advance(.5f, inputs.Target); Check(firstSkin.Zip(Views(nativeCast).Single().Skin, Same).All(x => x), "原定时动作也接受相同的可保存动作维持资料");
            bool rejected = false; var invalid = Wave(); invalid.Steps[1].Operation.Hold = new ConstructionHold { At = 20, Seconds = 1 }; try { AbilityCompiler.Compile(invalid, false); } catch (InvalidDataException error) { rejected = error.Message.Contains("Hold"); }
            Check(rejected, "动作维持超过真实动作或总寿命时给具体字段提示"); Check(JsonConvert.SerializeObject(source) == original, "范围和维持改造不修改来源资料");
            var sword = JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root, "Doc/技能系统全面重构/构造输入/命名步骤行剑.json"))); sword.TargetRange = null; sword.Lifetime = 2; sword.Steps = sword.Steps.Take(1).ToArray(); sword.Steps[0].Operation.Vector = new[] { 0f, 0, 16 }; var plan = AbilityCompiler.Compile(sword, false); Check(plan.Reach.Selection() > 27 && plan.Reach.Selection() < 40, "来源处命名投送按真实速度、有效时段和形状推导距离，不沿用十二格常量", plan.Reach.Selection());
            var nativeFlight = ConstructionEditing.Copy(sword); nativeFlight.Steps = Array.Empty<ConstructionStep>(); nativeFlight.Root.Operations = nativeFlight.Root.Operations.Concat(new[] { sword.Steps[0].Operation }).ToArray(); Check(Near(plan.Reach.Selection(), AbilityCompiler.Compile(nativeFlight, false).Reach.Selection()), "相同原操作和命名投送采用同一范围推导");
            var concealed = ConstructionEditing.Copy(sword); concealed.Root.AppearAt = 1; Check(Near(AbilityCompiler.Compile(concealed, false).Reach.Selection(), plan.Reach.Selection()), "显现前仍在推进的真实运动不会被漏出候选范围");
            var accelerated = ConstructionEditing.Copy(sword); accelerated.Steps[0].Operation.Acceleration = new[] { 0f, 0, 4 }; Check(AbilityCompiler.Compile(accelerated, false).Reach.Selection() > plan.Reach.Selection(), "加速度增加实际投送包络"); var shorter = ConstructionEditing.Copy(sword); shorter.Root.DisappearAt = 1; Check(AbilityCompiler.Compile(shorter, false).Reach.Selection() < plan.Reach.Selection(), "真实存在截止缩短可达范围，不拿整次寿命计满");
            var stationary = ConstructionEditing.Copy(sword); stationary.Steps = Array.Empty<ConstructionStep>(); stationary.Root.Operations = Array.Empty<ConstructionOperation>(); var large = ConstructionMagnitudeEdits.Resize(stationary, 2); Check(Near(AbilityCompiler.Compile(large, false).Reach.Selection(), 2 * AbilityCompiler.Compile(stationary, false).Reach.Selection()), "来源处静态作用形状随真实尺寸扩大候选包络"); stationary.Binding.ScaleByBody = true; var scaled = AbilityCompiler.Compile(stationary, false); Check(Near(scaled.Reach.Selection(2), 2 * scaled.Reach.Selection()), "真实体高缩放只应用于布局和形状"); var movingScale = ConstructionEditing.Copy(sword); movingScale.Binding.ScaleByBody = true; var scaledMoving = AbilityCompiler.Compile(movingScale, false); Check(scaledMoving.Reach.Selection(2) < scaledMoving.Reach.Selection() * 1.2, "世界速度不会因为人物变高再乘一次体高");
            var explicitRange = ConstructionEditing.Copy(sword); explicitRange.TargetRange = 80; Check(AbilityCompiler.Compile(explicitRange, false).Reach.Selection() == 80, "作者明确选择距离继续保留，不冒充实际接触半径"); var placed = ConstructionEditing.Copy(stationary); placed.Binding.Anchor = AbilityAnchor.Target; Check(AbilityCompiler.Compile(placed, false).Reach.Selection() == 12, "目标处生成保留缺省控制距离，不能从零投送误推为无法施放");
            var bodyPlan = AbilityCompiler.Compile(palm, false); Check(bodyPlan.Reach.Selection(2) > bodyPlan.Reach.Selection(1) && Near(bodyPlan.Reach.Selection(2, .4f) - bodyPlan.Reach.Selection(2), .4f), "真实身体和目标半径参与候选范围，实际形状独立保留");

            Game.Resume(); Config.paused = true; World.world.save_manager.loadWorld(Path.Combine(root, "Scripts/WorldSaveTests/Fixtures/world-format-1")); await Game.NextFrame(); await Game.WaitUntil(() => !SmoothLoader.isLoading(), 3600); Config.paused = true; var runnerType = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner"); object runner = runnerType.GetProperty("Instance").GetValue(null); async Task Boundary() => await Game.WaitUntil(() => (bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner), 3600); await Boundary();
            var groundProvider = (Func<Rect, AbilityHeightField>)typeof(ConstructedAbilityService).GetField("GroundProvider", Flags).GetValue(null);
            var sampler = groundProvider.Target.GetType().GetField("sampler", Flags).GetValue(groundProvider.Target); sampler.GetType().GetMethod("ScanLandformsForTest", Flags).Invoke(sampler, null);
            var ground = groundProvider(new Rect(60, 68, 66, 8));
            void Place(Actor actor, float x, float y) { actor.stopMovement(); actor.current_position = new Vector2(x, y); actor.setCurrentTile(World.world.GetTileSimple((int)x, (int)y)); actor.updatePos(); ConstructedAbilityService.NotifyActorChanged(actor); }
            var stats = new BaseStats(); stats.addTag("frozen_ai"); stats.addTag("immovable"); var status = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("test.range-hold.stop").SetStats(stats).SetDuration(10000).Build(); foreach (var unit in World.world.units.getSimpleList().ToArray()) { CombatStatusEffects.ApplyStatus(unit, status, 10000, unit); Place(unit, 12, 12); }
            Actor Make(string name, int x) { var unit = World.world.units.createNewUnit("human", World.world.GetTileSimple(x, 72), pAdultAge: true, pSpawnWithItems: false); unit.data.name = name; unit.addTrait("super_health"); unit.setStatsDirty(); unit.updateStats(); CombatStatusEffects.ApplyStatus(unit, status, 10000, unit); return unit; }
            var actor = Make("结构范围施放者", 64); var enemy = Make("二十六格实际目标", 90); var wolf = World.world.units.createNewUnit("wolf", World.world.GetTileSimple(12, 12), pAdultAge: true); enemy.setKingdom(wolf.kingdom); actor.addAggro(enemy); enemy.addAggro(actor); var owner = actor.GetExtend(); owner.AddComponent(new Xian { level = 2, wakan = 10000 }); owner.MarkCultiwayStatsDirty(); actor.setStatsDirty(); actor.updateStats(); Place(actor, 64, 72);
            float targetHeight = (float)typeof(AbilityCast).Assembly.GetType("Cultiway.Content.Combat.SpatialActorPose").GetMethod("Height", Flags).Invoke(null, new object[] { enemy });
            sword.Binding.Height = targetHeight * .4f;
            // 使用真实三维地面算入射速度，旧样例的水平投送不能当作坡地自动瞄准。
            sword.Steps[0].Operation.WorldVelocity = true;
            sword.Steps[0].Operation.Vector = new[] { 16f, 0f, (ground.Sample(90, 72) - ground.Sample(64, 72)) / 26f * 16f };
            Check(!Near(ground.Sample(64, 72), ground.Sample(90, 72)), "实机场地保留Worldfall真实高差，投送采用实际入射方向", new { source = ground.Sample(64, 72), target = ground.Sample(90, 72) });
            sword.Id = "test.range-hold.formal"; ConstructionPricing.Price(sword); ConstructedAbilityService.Register(sword); ConstructedAbilityService.Learn(owner, sword.Id); var handle = new ActiveAbilityHandle("content.constructed", owner.E, sword.Id); var hits = new List<ConstructedContact>(); void Hit(ConstructedContact contact) { if (contact.AbilityId == sword.Id && contact.SourceId == actor.id) hits.Add(contact); }
            ConstructedAbilityService.ContactConfirmed += Hit;
            try { float balance = owner.GetCultisys<Xian>().wakan; Place(enemy, 120, 72); Check(!ActiveAbilityService.TryUse(owner, handle, new ActiveAbilityTarget(enemy, enemy.GetSimPos()), ActiveAbilityUseOrigin.Script) && owner.GetCultisys<Xian>().wakan == balance, "实际可达范围外拒绝施放且不扣费"); Place(enemy, 90, 72); int health = enemy.data.health; Check(ActiveAbilityService.TryUse(owner, handle, new ActiveAbilityTarget(enemy, enemy.GetSimPos()), ActiveAbilityUseOrigin.Script) && Near(balance - owner.GetCultisys<Xian>().wakan, sword.Cost), "取消明确距离的命名投送在二十六格正式受理并一次付费"); Config.paused = false; double until = World.world.getCurWorldTime() + 2.4; await Game.WaitUntil(() => World.world.getCurWorldTime() >= until, 3600); Config.paused = true; await Boundary(); Check(hits.Count == 1 && hits[0].TargetId == enemy.id && enemy.data.health < health, "实际投送跨越旧十二格限制命中并扣血，候选包络没有代替接触判定", hits.Select(h => new { h.Age, h.Node }).ToArray()); } finally { ConstructedAbilityService.ContactConfirmed -= Hit; Config.paused = true; }
            ConstructedAbilityService.Register(sustained); ConstructedAbilityService.Learn(owner, sustained.Id); var data = JObject.FromObject(sustained); File.WriteAllText(Path.Combine(folder, "held-definition.json"), data.ToString());
            bool Pass(object value) => (bool)value.GetType().GetProperty("pass").GetValue(value); var report = new { passed = checks.All(Pass), checks, process = System.Diagnostics.Process.GetCurrentProcess().Id }; File.WriteAllText(Path.Combine(folder, "checks.json"), JsonConvert.SerializeObject(report, Formatting.Indented)); return new { report.passed, checks = checks.Count };
