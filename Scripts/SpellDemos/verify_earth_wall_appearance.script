// 复用 B21 的土墙、场地和人物；按入口选择通行边缘或 9.03 B 的出现与收势。
async Task FrameEarthWallSide(Vector3 center)
{
    var external = AppDomain.CurrentDomain.GetAssemblies()
        .Select(assembly => assembly.GetType("FirstPerson.WorldBoxMod", false)).FirstOrDefault(type => type != null);
    if (external == null) return;
    object view = external.GetProperty("Instance", F).GetValue(null);
    void Set(string field, object value) => external.GetField(field, F).SetValue(view, value);
    object Read(string name) => external.GetField(name, F)?.GetValue(view) ?? external.GetProperty(name, F).GetValue(view);
    var setView = external.GetMethod("SetGodView", F);
    var canvases = Resources.FindObjectsOfTypeAll<Canvas>().Where(canvas => canvas.enabled).ToArray();
    try
    {
        World.world.console.Hide();
        foreach (var canvas in canvases) canvas.enabled = false;
        World.world.camera.transform.position = new Vector3(center.x, center.y, World.world.camera.transform.position.z);
        MoveCamera.instance.forceZoom(8);
        setView.Invoke(view, new object[] { true });
        await Game.WaitUntil(() => (bool)Read("GodShown") && (float)Read("GodAlpha") >= .999f, 600);
        Set("_godClose", 7f); Set("_godCloseTarget", 7f); Set("_godPull", 1f);
        Set("_godTurn", -.25f); Set("_godTurnRate", 0f); Set("_godTip", .35f); Set("_godTipRate", 0f);
        int before = (int)Read("_godGpuApplied");
        await Game.WaitUntil(() => (int)Read("_godGpuApplied") >= before + 3, 600);
        string file = Path.Combine(folder, "earth-wall-side.png");
        Screen.Capture(file);
        await Game.WaitUntil(() => File.Exists(file), 600);
    }
    finally
    {
        setView.Invoke(view, new object[] { false });
        foreach (var canvas in canvases) if (canvas != null) canvas.enabled = true;
    }
}

const bool captureWall = true;
const bool verifyMotion = false;
AbilityCast live = null;
try
{
    PrepareAppearanceBackdrop(60, 75, 67, 78);
    var skill = Build();
    ResetPeople();
    source.addAggro(target);
    target.addAggro(source);
    Check(Use(skill), "原已学土墙正常受理");
    await Advance(verifyMotion ? .045f : .30f);
    live = ((IEnumerable)service.GetField("casts", F).GetValue(null)).Cast<object>()
        .Where(run => starts.Count != 0 && (long)Field(run, "Id") == starts.Last().CastId)
        .Select(run => (AbilityCast)Field(run, "Cast")).SingleOrDefault();
    Check(live != null && oldWalls == 0 && Views(live).Single().Resource.Description.Id == "earth_wall_strata_motion" &&
          Views(live).Single().SurfaceFor(0) == "stone_strata" && Shapes(live).Count == 11,
        "原入口实际使用新岩壁和分层石面，且沿用原 11 段阻挡");
    Vector3 center = Center(live);
    if (captureWall)
    {
        await FrameAppearance("earth-wall-near", center.x, 73, 5);
        await FrameAppearance("earth-wall-far", center.x, 73, 20);
        await FrameEarthWallSide(center);
    }
    CombatStatusEffects.RemoveStatus(target, hold);
    target.updateStats();
    Check(!target.isImmovable(), "路线人物解除测试定身");
    typeof(Actor).GetField("is_immovable", F).SetValue(target, false);
    var precalc = typeof(Actor).GetMethod("precalcMovementSpeed", F);
    var update = typeof(Actor).GetMethod("u10_checkSmoothMovement", F);
    var updated = typeof(Actor).GetField("_update_done", F);
    var speed = typeof(Actor).GetField("_current_combined_movement_speed", F);
    float Walk(float y, float distance = 6.05f)
    {
        target.position_height = 0;
        Place(target, 64, y);
        precalc.Invoke(target, new object[] { true });
        float movement = (float)speed.GetValue(target);
        if (movement <= 0) throw new InvalidOperationException("测试人物没有实际移动速度");
        target.next_step_position = new Vector2(70, y);
        updated.SetValue(target, false);
        update.Invoke(target, new object[] { distance / movement });
        return target.current_position.x;
    }
    if (verifyMotion)
    {
        var timeline = new List<object>();
        void Stage(string phase, List<AbilityCapsule> shapes, List<FormVisualInstance> frames, float walk)
        {
            timeline.Add(new { phase, live.Age, contacts = shapes.Select(shape => new
            {
                bottom = new[] { shape.A.x, shape.A.y, shape.A.z },
                top = new[] { shape.B.x, shape.B.y, shape.B.z }, shape.Radius
            }).ToArray(), forms = frames.Select(frame => frame.Resource.Description.Id).ToArray(), walk });
            File.WriteAllText(Path.Combine(folder, "timeline.json"), JsonConvert.SerializeObject(timeline, Formatting.Indented));
        }
        var earlyShapes = Shapes(live);
        float earlyWalk = Walk(72);
        Stage("support", earlyShapes, Views(live), earlyWalk);
        Check(earlyShapes.Count == 11 && earlyWalk == 64, "岩层未落稳时，地脚已经实际挡路");
        await FrameAppearance("earth-wall-support", center.x, 73, 5);
        await Advance(.30f);
        var settled = Shapes(live);
        var lifted = settled.Zip(earlyShapes, (after, before) => after.B.z - before.B.z).ToArray();
        float settledWalk = Walk(72);
        Stage("settled", settled, Views(live), settledWalk);
        Check(settled.Count == 11 && settledWalk == 64 && lifted.Max() > .15f &&
              settled.Zip(earlyShapes, (after, before) => Vector3.Distance(after.A, before.A) < .001f &&
                  Mathf.Abs(after.Radius - before.Radius) < .001f).All(kept => kept),
            "上层接触随岩层落稳，十一处地脚和宽度没有漂移", new { lifted });
        await FrameAppearance("earth-wall-settled", center.x, 73, 5);
        var asset = SkillEntities.EarthWall;
        float lifespan = (float)typeof(SkillEntityAsset).GetMethod("ResolveRuntimeLifetime", F).Invoke(asset,
            new object[] { skill, asset.ImpactProfile.Lifetime * asset.ImpactTuning.LifetimeMultiplier });
        await Advance(lifespan - live.Age - .075f);
        float lastWalk = Walk(72);
        Stage("before-end", Shapes(live), Views(live), lastWalk);
        Check(live.Age < lifespan && Shapes(live).Count == 11 && lastWalk == 64,
            "原作用时长以内，完整墙身继续挡路", new { live.Age, lifespan });
        await Advance(lifespan - live.Age + .16f);
        var rubble = Views(live);
        float through = Walk(72);
        Stage("rubble", Shapes(live), rubble, through);
        Check(rubble.Count == 1 && rubble[0].Resource.Description.Id == "earth_wall_strata_rubble" &&
              rubble[0].Resource.Description.Parts.Length == 7 && rubble[0].Skin != null && !live.Finished && Shapes(live).Count == 0 && through > center.x + 1,
            "原寿命到期后只有独立碎块，真实人物已经穿过原墙面", new { live.Age, lifespan, through });
        await FrameAppearance("earth-wall-rubble", center.x, 73, 5);
        await Advance(.45f);
        Stage("clear", Shapes(live), Views(live), through);
        Check(live.Finished && Views(live).Count == 0 && Shapes(live).Count == 0 &&
              endings.Any(e => e.Fact.CastId == starts.Last().CastId && !e.Fact.Cancelled), "碎块自然沉入地表并撤除");
        await FrameAppearance("earth-wall-cleared", center.x, 73, 5);
        return new { passed = true, process = System.Diagnostics.Process.GetCurrentProcess().Id };
    }
    var shapes = Shapes(live);
    float end = shapes.Max(shape => Mathf.Max(shape.A.y, shape.B.y) + shape.Radius);
    float height = (float)service.Assembly.GetType("Cultiway.Content.Combat.SpatialActorPose")
        .GetMethod("Height", F).Invoke(null, new object[] { target });
    float radius = height * .24f;
    float farFace = shapes.Max(shape => Mathf.Max(shape.A.x, shape.B.x) + shape.Radius) + radius;
    float inside = end + radius - .06f, outside = end + radius + .06f;
    float front = Walk(72), edge = Walk(inside), around = Walk(outside);
    float partial = Walk(72, 4f);
    Check(front == 64 && edge == 64 && around > farFace && partial == 64,
        "实际一步在墙正面和端部内侧停下，从端部外可绕行",
        new { center = new[] { center.x, center.y, center.z }, end, height, farFace, inside, outside, front, edge, around, partial });
    await Advance(4.6f);
    float cleared = Walk(72);
    Check(live.Finished && Views(live).Count == 0 && Shapes(live).Count == 0 && cleared > farFace &&
          endings.Any(e => e.Fact.CastId == starts.Last().CastId && !e.Fact.Cancelled),
        "自然结束后，墙身、碎块和阻挡已撤除，正面步行恢复", new { cleared, farFace });
    await FrameAppearance("earth-wall-cleared", center.x, 73, 5);
    return new { passed = true, process = System.Diagnostics.Process.GetCurrentProcess().Id };
}
finally
{
    if (live != null && !live.Finished) live.Cancel();
    ConstructedAbilityService.CastStarted -= Started;
    Cultiway.Core.SkillLibV3.Manager.ExecutionConfigured -= Old;
    ConstructedAbilityService.ContactConfirmed -= Hit;
    ConstructedAbilityService.CastEnded -= Ended;
    ControllableUnit.clear(false);
    Config.paused = true;
}
