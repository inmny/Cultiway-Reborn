// 正式留水、越区、两位修士交汇、局部归属与跨分区整数回收。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using System.Collections;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Usage;
using Cultiway.Content.Skills;
using Cultiway.Content.Components;
using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/world-matter");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}var saves=Cultiway.ModClass.I.WorldSaves;
JObject Archive()=>JObject.Parse(saves.World.Capture(World.world,"world-matter"))["sections"]["world_materials"]["data"] as JObject;JArray Rows()=>(JArray)Archive()["Records"];
async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;var type=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=type.GetProperty("Instance").GetValue(null);await Game.WaitUntil(()=>(bool)type.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);}
Config.paused=true;Game.Resume();Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;
var stats=new BaseStats();stats["mana"]=256;stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.MatterWorldHold").SetStats(stats).SetDuration(10000).Build();
Actor Actor(int x){var p=World.world.units.createNewUnit("human",World.world.GetTileSimple(x,72),pAdultAge:true,pSpawnWithItems:false);p.addTrait("super_health");p.GetExtend().AddComponent(new Xian{level=2,wakan=100});Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(p,hold,10000,p);p.GetExtend().MarkCultiwayStatsDirty();p.setStatsDirty();p.updateStats();p.GetExtend().GetCultisys<Xian>().wakan=Mathf.Min(100,p.stats[Cultiway.Content.BaseStatses.MaxWakan.id]*.5f);p.setMana(128);return p;}
var actor=Actor(64);var other=Actor(80);await Advance(.1f);
bool Fire(Actor actor,AbilityDefinition d){ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(actor.GetExtend(),d.Id);return ActiveAbilityService.TryUse(actor.GetExtend(),new ActiveAbilityHandle("content.constructed",actor.GetExtend().E,d.Id),new ActiveAbilityTarget(actor,actor.GetSimPos()),ActiveAbilityUseOrigin.Script);}
AbilityDefinition Definition(bool incoming=false){var d=JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/"+(incoming?"迎流留水":"跨区留水")+".json")));d.Impact.Targets=SkillUseTargetRelation.Self;return d;}
var events=new List<WorldMaterialChange>();var initial=new Dictionary<long,JToken>();void Event(WorldMaterialChange e){events.Add(e);if(e.Kind=="leave")initial[e.Provider]=Rows().Single(r=>(long)r["Id"]==e.Id).DeepClone();}WorldMaterialService.Changed+=Event;
double Sum(long provider,string field)=>Rows().Where(r=>(long)r["Provider"]==provider).Sum(r=>(double)r["Material"][field]);
try{
 Check(Fire(actor,Definition()),"第一位修士正式留置世界水流");Check(Fire(other,Definition(true)),"第二位修士独立支付并留水");await Advance(3);
 var before=Rows().DeepClone();double volume=Rows().Sum(r=>(double)r["Material"]["Volume"]),resource=Rows().Sum(r=>(double)r["Material"]["Resource"]);
 AbilityDefinition Convert(string name)=>JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/"+name+".json")));
 double Ice()=>Rows().Where(r=>(string)r["Material"]["State"]=="solid"&&(string)r["Material"]["Matter"]=="water").Sum(r=>(double)r["Material"]["Volume"]);
 // 用实际部位形状检查容量耗尽；临时占用的是预算，未建立假的材料。
 var service=typeof(WorldMaterialService);var reserved=service.GetField("reservedCells",F);int savedReserved=(int)reserved.GetValue(null);var capacityBefore=Rows().DeepClone();
 var areaCast=new AbilityCast(AbilityCompiler.Compile(Convert("范围凝水")),Matrix4x4.Translate(actor.GetSimPos()),inputs:new AbilityInputs(actor.GetSimPos(),actor.GetSimPos(),Vector3.right,1));var selection=new List<AbilityCapsule>();typeof(AbilityCast).GetMethod("MaterialSelection",F).Invoke(areaCast,new object[]{0,selection});
 var ruleType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Skills.CompiledWorldMatter");var rule=Activator.CreateInstance(ruleType,F,null,new object[]{new ConstructionWorldMatter{FromMatter="water",FromState="liquid",MaximumVolume=8},"quota",0},null);
 try{reserved.SetValue(null,262144-(int)service.GetField("cells",F).GetValue(null));service.GetMethod("ConvertMatter",F).Invoke(null,new object[]{actor.id,selection,AbilityMatters.Resolve("ice","solid","test"),rule,World.world.getCurWorldTime(),0L,"test.quota"});}finally{reserved.SetValue(null,savedReserved);}
 Check(JToken.DeepEquals(capacityBefore,Rows()),"没有接收容量时保留全部原材料与逐格支付份额");
 var freeze=Convert("范围凝水");Check(Fire(actor,freeze),"普通定时转换正式选择世界水层");await Advance(.5f);
 Check(Math.Abs(Ice()-12)<.002,"转换体积上限真实限制为十二立方格");Check(Math.Abs(Rows().Sum(r=>(double)r["Material"]["Volume"])-volume)<.003&&Math.Abs(Rows().Sum(r=>(double)r["Material"]["Resource"])-resource)<.0002,"部分冻结守恒共同水量和全部原支付份额");
 Check(events.Any(e=>e.Kind=="matter"&&e.AbilityId==freeze.Id&&e.CastId>0)&&!events.Any(e=>e.Kind=="credit"),"实际转换事件关联正式施放，不把冻结当退款");
 Check(Rows().Where(r=>(string)r["Material"]["State"]=="solid").All(r=>((JArray)r["Material"]["Flow"]["Water"]).Where((_,i)=>i%3!=0).All(v=>(float)v==0)&&r["Material"]["Flow"]["Bed"] is JArray),"冰层保存实际基底并停止水流动量");
 foreach(var p in new[]{actor,other})Check(Math.Abs(Sum(p.id,"Resource")-8)<.0002,"冻结后原支付者仍持有自己的八点份额："+p.id);
 var actualRows=((IDictionary)service.GetField("rows",F).GetValue(null)).Values.Cast<object>().ToArray();object Value(object o,string field)=>o.GetType().GetField(field,F).GetValue(o);var solids=actualRows.Where(r=>(bool)Value(r,"WorldGrid")&&((AbilityMatter)Value(Value(r,"Material"),"Matter")).HoldsShape).ToArray();int supported=0;
 foreach(var solid in solids){var flow=Value(Value(solid,"Material"),"Flow");var origin=(Vector2)Value(flow,"Origin");var water=(Vector3[])Value(flow,"Water");var bed=(float[])Value(flow,"Ground");for(int i=0;i<256;i++)if(water[i].x>0){float depth=solids.Where(r=>(Vector2)Value(Value(Value(r,"Material"),"Flow"),"Origin")==origin).Sum(r=>((Vector3[])Value(Value(Value(r,"Material"),"Flow"),"Water"))[i].x);foreach(var liquid in actualRows.Where(r=>(bool)Value(r,"WorldGrid")&&!((AbilityMatter)Value(Value(r,"Material"),"Matter")).HoldsShape)){var lf=Value(Value(liquid,"Material"),"Flow");if((Vector2)Value(lf,"Origin")!=origin||((Vector3[])Value(lf,"Water"))[i].x<=0)continue;if(((float[])Value(lf,"Ground"))[i]+.00001<bed[i]+depth)throw new Exception("流水基底穿入冰层");supported++;}}}Check(supported>0,"本次确有冰与流水共存的实际承托格");
 var frozenRows=Rows().Where(r=>(string)r["Material"]["State"]=="solid").ToArray();var frozenJson=frozenRows.ToDictionary(r=>(long)r["Id"],r=>r["Material"].ToString(Formatting.None));await Advance(1);
 Check(frozenJson.All(pair=>Rows().Any(r=>(long)r["Id"]==pair.Key&&r["Material"].ToString(Formatting.None)==pair.Value)),"独立冰层推进后保持真实形状、体积及支付份额");
 var thaw=Convert("范围融冰");Check(Fire(other,thaw),"另一修士用普通法术解冻他人水层");await Advance(.5f);Check(Ice()<.0001,"解冻后实际固态水量清零");Check(Math.Abs(Sum(actor.id,"Resource")-8)<.0002&&Math.Abs(Sum(other.id,"Resource")-8)<.0002,"他人解冻不改变原支付归属");Check(Rows().Where(r=>(bool)r["WorldGrid"]&&(double)r["Material"]["Volume"]>0).GroupBy(r=>r["Lineage"]+":"+r["Material"]["Matter"]+":"+r["Material"]["State"]+":"+r["Material"]["Flow"]["X"]+":"+r["Material"]["Flow"]["Y"]).All(g=>g.Count()==1),"解冻重新接入原来源，重复同区容器已合并");
 freeze.Root.Operations[0].WorldMatter.OwnedOnly=true;freeze.Root.Operations[0].WorldMatter.MaximumVolume=8;Check(Fire(actor,freeze),"所有权筛选通过同一个转换入口");await Advance(.5f);Check(Math.Abs(Ice()-8)<.002&&Rows().Where(r=>(string)r["Material"]["State"]=="solid"&&(double)r["Material"]["Volume"]>0).All(r=>(long)r["Provider"]==actor.id),"只冻结自身原支付水量，其他来源继续流动");
 var iron=JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/器物独立留置.json")));Check(Fire(actor,iron),"正式支付并留下刚性金属");await Advance(1.2f);var metalBefore=Rows().Single(r=>(string)r["Material"]["Matter"]=="iron").DeepClone();var melt=Convert("范围熔金");Check(Fire(other,melt),"另一种材料也使用普通形状转换");await Advance(.5f);Check(Rows().Any(r=>(string)r["Material"]["Matter"]=="iron"&&(string)r["Material"]["State"]=="liquid"&&r["Material"]["Flow"] is JObject),"熔融金属具有真实流散而非换色");Check(Math.Abs(Rows().Where(r=>(string)r["Material"]["Matter"]=="iron").Sum(r=>(double)r["Material"]["Volume"])-(double)metalBefore["Material"]["Volume"])<.003,"金属转换守恒按实际尺寸计算的体积");Check(Rows().Where(r=>(string)r["Material"]["Matter"]=="iron").All(r=>(long)r["Provider"]==actor.id&&(long)r["Lineage"]==(long)metalBefore["Lineage"]),"金属变形仍保留原支付者及来源链");
 int created=0;var definitions=(IDictionary)typeof(ConstructedAbilityService).GetField("definitions",F).GetValue(null);
 for(int seed=0;seed<2000&&created<4;seed++){var random=new System.Random(seed);if(random.Next(6)!=0||random.Next(2)!=0)continue;random.NextDouble();random.NextDouble();random.Next(3);if(random.Next(4)!=0)continue;string id=ConstructedAbilityService.Create(actor.GetExtend(),seed);var generated=(AbilityDefinition)definitions[id];Check(generated.Root.Operations.Any(o=>o.WorldMatter!=null),"修士自主创作保存实际世界材料选择："+seed);AbilityCompiler.Compile(generated);created++;}Check(created==4,"四份自主创作使用同一普通编译和转换结构");
 // 去掉临时测试状态后保存真实冰层、流水和熔融金属，下一进程继续验证。
 foreach(var p in new[]{actor,other}){Cultiway.Content.Combat.CombatStatusEffects.RemoveStatus(p,hold);p.GetExtend().MarkCultiwayStatsDirty();p.setStatsDirty();p.updateStats();}actor.setMana(actor.getMaxMana()/2);
 SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,actor=actor.id,other=other.id,world=saves.World.Capture(World.world,"world-matter")},Formatting.Indented));
 var result=new{passed=true,checks,ice=Ice(),volume=Rows().Sum(r=>(double)r["Material"]["Volume"]),events=events.Select(e=>new{e.Id,e.Provider,e.Kind,e.AbilityId,e.CastId,e.Matter,e.State,e.ConvertedVolume,e.Volume,e.Granted}).ToArray()};File.WriteAllText(Path.Combine(folder,"runtime.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{WorldMaterialService.Changed-=Event;Config.paused=true;}
