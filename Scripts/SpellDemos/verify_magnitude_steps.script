// 3.09的必要接入：命名步骤参与尺寸、速度、历时、复制与真实支付命中。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core;
using Cultiway.Core.Skills;
using Cultiway.Core.Visuals.Forms;
using Cultiway.Core.Persistence;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Usage;
using Cultiway.Core.Components;
using Cultiway.Content.Skills;
using Cultiway.Content.Components;
using Cultiway.Content.Combat;
using Cultiway.Utils.Extension;

const BindingFlags Flags = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static | BindingFlags.Instance;
string root = Cultiway.ModClass.I.GetDeclaration().FolderPath, folder = Path.Combine(root, "artifacts/skill_rebuild/magnitude-steps"); Directory.CreateDirectory(folder);
var checks = new List<object>(); void Check(bool pass, string name, object evidence = null) => checks.Add(new { pass, name, evidence });
var source = JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root, "Doc/技能系统全面重构/构造输入/命名步骤行剑.json"))); string original = JsonConvert.SerializeObject(source);
var inputs = new AbilityInputs(Vector3.zero, new Vector3(10, 0, 0), Vector3.right, 1);
AbilityCast Cast(AbilityDefinition d, BodyFrame? body = null) => new(AbilityCompiler.Compile(d, false), Matrix4x4.identity, body, inputs);
List<FormVisualInstance> Views(AbilityCast cast) { var views = new List<FormVisualInstance>(); cast.AppendVisuals(views); return views; }
Vector3 Position(AbilityCast cast) => Views(cast).Single().Transform.GetColumn(3);
bool Same(Matrix4x4 a, Matrix4x4 b) { for (int i = 0; i < 16; i++) if (Math.Abs(a[i] - b[i]) > .0002f) return false; return true; }
var fast = ConstructionMagnitudeEdits.Haste(source, 2); Check(fast.Steps[0].Operation.Vector[2] == 12 && fast.Steps[1].Operation.Vector[2] == 120, "急速同步改变命名投送与旋转，不只改变部位内操作"); var first = Cast(source); var quicker = Cast(fast); first.Advance(.9f, inputs.Target); quicker.Advance(.6f, inputs.Target); Check(Same(Views(first).Single().Transform, Views(quicker).Single().Transform), "准备时点保留，命名运动在对应进度到达相同位置及朝向");
var slowed = ConstructionMagnitudeEdits.Duration(source, 2); var slow = Cast(slowed); slow.Advance(1.8f, inputs.Target); Check(slowed.Steps[0].Operation.At == .6f && slowed.Steps[0].Operation.Vector[2] == 3 && Same(Views(first).Single().Transform, Views(slow).Single().Transform), "完整历时同时伸缩原成形、命名投送和后续输出依赖");
var repeated = ConstructionMagnitudeEdits.Repeat(source, 3, 1, .4f); Check(repeated.Steps.Length == 6 && repeated.Steps.Select(s => s.Id).Distinct().Count() == 6, "三份构造各有独立步骤名称，不共用一次操作状态"); Check(repeated.Steps[0].Inputs["part"].Node == "root/copy_0" && repeated.Steps[2].Inputs["after"].Node == "root/copy_1" && repeated.Steps[3].Inputs["part"].Step == "copy_1/launch", "每份保留真实部位、原命名操作和同份步骤输出关系"); Check(Math.Abs(repeated.Steps[4].Operation.At - 1.1f) < .0001f && Math.Abs(repeated.Lifetime - 2.8f) < .0001f && repeated.Cost == 6, "按整次时钟延后各份操作并保留各自完整寿命，总费用只汇总一次");
var copies = Cast(repeated); copies.Advance(1.3f, inputs.Target); var copyViews = Views(copies); Check(copyViews.Count == 3 && copyViews.Zip(new[] { 6f, 3.6f, 1.2f }, (v, x) => Math.Abs(v.Transform.m03 - x)).Max() < .001f, "三份命名投送各自独立飞行，未误驱动公共支点", copyViews.Select(v => v.Transform.m03).ToArray()); Check(copies.ContactGroup(1) != copies.ContactGroup(2) && copies.ContactGroup(2) != copies.ContactGroup(3), "复制保持独立真实接触组");
var enlarged = ConstructionMagnitudeEdits.Resize(repeated, 2); var large = Cast(enlarged); large.Advance(1.3f, inputs.Target); Check(Views(large).Count == 3 && Math.Abs(Views(large)[0].Transform.lossyScale.x / copyViews[0].Transform.lossyScale.x - 2) < .001f, "复制后的命名构造继续接受真实尺寸改造");
var timed = ConstructionEditing.Copy(source); timed.Root.Operations = Array.Empty<ConstructionOperation>(); timed.Root.ActiveFrom = 0; timed.Steps = new[] { new ConstructionStep { Id = "motion", Operation = new ConstructionOperation { Kind = ConstructionOperationKind.Animate, Clip = "swim", At = .2f }, Inputs = new() { ["part"] = new ConstructionOutputReference { Node = "root" } } } }; timed.Root.Form = "water_whale"; timed.Lifetime = 6; var duration = ConstructionMagnitudeEdits.Duration(timed, 2); Check(duration.Steps[0].Operation.Seconds == FormResources.Load("water_whale").Rig.Motion("swim").Duration * 2, "命名制作动作先固定实际资源时长，再伸缩，缺省零不会失效"); var animated = Cast(timed); var stretched = Cast(duration); animated.Advance(.7f, inputs.Target); stretched.Advance(1.4f, inputs.Target); Check(Views(animated).Single().Skin.Zip(Views(stretched).Single().Skin, (a, b) => Same(a, b)).All(x => x), "命名动作的真实骨架在对应进度保持一致");
var spatial = ConstructionEditing.Copy(source); spatial.Root.Operations = Array.Empty<ConstructionOperation>(); spatial.Steps = new[] { new ConstructionStep { Id = "conduct", Operation = new ConstructionOperation { Kind = ConstructionOperationKind.Conduct, At = .2f, Conduction = new ConstructionConduction { Range = 8, Pulses = 3, Interval = .3f, MaximumCells = 16, MaximumTargets = 2 } }, Inputs = new() { ["part"] = new ConstructionOutputReference { Node = "root" } } }, new ConstructionStep { Id = "matter", Operation = new ConstructionOperation { Kind = ConstructionOperationKind.ConvertMatter, Matter = "ice", WorldMatter = new ConstructionWorldMatter { MaximumVolume = 2 } }, Inputs = new() { ["part"] = new ConstructionOutputReference { Node = "root" } } } }; var wide = ConstructionMagnitudeEdits.Resize(spatial, 2); Check(wide.Steps[0].Operation.Conduction.Range == 16 && wide.Steps[0].Operation.Conduction.MaximumCells == 64 && wide.Steps[1].Operation.WorldMatter.MaximumVolume == 16, "尺寸改造同步命名世界操作的传播范围、数量与体积需求"); Check(Math.Abs(ConstructionMagnitudeEdits.Duration(spatial, 2).Steps[0].Operation.Conduction.Interval - .6f) < .0001f, "完整历时改变命名多波的真实间隔，波数保留");
bool refused = false; try { ConstructionPlacementEdits.Follow(source, AbilityAnchor.Source); } catch (InvalidDataException error) { refused = error.Message.Contains("launch"); }
Check(refused, "随动移除投送后，不能伪造仍被依赖的飞行输出"); var direct = ConstructionEditing.Copy(source); direct.Steps = direct.Steps.Take(1).ToArray(); var following = ConstructionPlacementEdits.Follow(direct, AbilityAnchor.Source); Check(following.Steps.Length == 0, "没有后续输出依赖的命名投送可正常改成随动");
var spin = ConstructionEditing.Copy(source); spin.Root.Operations = Array.Empty<ConstructionOperation>(); spin.Root.ActiveFrom = 0; spin.Steps = new[] { new ConstructionStep { Id = "spin", Operation = new ConstructionOperation { Kind = ConstructionOperationKind.Spin, Vector = new[] { 0f, 0, 60 } }, Inputs = new() { ["part"] = new ConstructionOutputReference { Node = "root" } } } }; var orbit = ConstructionPlacementEdits.Orbit(spin, AbilityAnchor.Source, 2, 3); Check(orbit.Steps.Single().Inputs["part"].Node == "root/blade", "环绕包装也重定位命名步骤，局部旋转不再错误指向组织中心");
var palm = ConstructionEditing.Access.Read(BodyActionCatalog.PalmId); var bodySource = ConstructionEditing.Copy(spin); bodySource.Body = ConstructionEditing.Copy(palm).Body; bodySource.Steps[0].Operation.When = new ConstructionCondition { Source = "body", Trigger = ConstructionChangeTrigger.End }; var bodyCopies = ConstructionMagnitudeEdits.Repeat(bodySource, 3, 1, .3f); Check(bodyCopies.Steps.Select(s => s.Operation.When.Delay).SequenceEqual(new[] { 0f, .3f, .6f }) && bodyCopies.Steps.All(s => s.Operation.At == 0), "身体只发一次收势事件，各份接受后分别等待，不因延后门槛漏事件"); var frame = new BodyFrame(Vector3.zero, Vector3.right, 2, new Vector3(0, .16f, .62f), .48f, .54f, 1); var bodyCast = Cast(bodyCopies, frame); bodyCast.Advance(1.2f, inputs.Target); copyViews = Views(bodyCast); bool phases = copyViews.Count == 3; for (int i = 0; i < copyViews.Count; i++) { var baseline = Cast(bodySource, frame); baseline.Advance(1.2f - i * .3f, inputs.Target); phases &= Vector3.Distance(copyViews[i].Transform.MultiplyVector(Vector3.right), Views(baseline).Single().Transform.MultiplyVector(Vector3.right)) < .001f; }
Check(phases, "真实身体单次事件实际驱动三份错时旋转");
var gated = ConstructionEditing.Copy(bodySource); gated.Steps[0].Operation.When = null; gated.Steps[0].Operation.At = .1f; gated.Root.Activation = new ConstructionActivation { Source = "body", Trigger = ConstructionChangeTrigger.End, Delay = .1f }; var gatedCopies = ConstructionMagnitudeEdits.Repeat(gated, 3, 1, .3f); Check(gatedCopies.Steps.All(s => s.Operation.At == .1f), "事件开始后的局部步骤不重复增加整次延迟"); var gateCast = Cast(gatedCopies, frame); gateCast.Advance(1.4f, inputs.Target); copyViews = Views(gateCast); phases = copyViews.Count == 3; for (int i = 0; i < copyViews.Count; i++) { var baseline = Cast(gated, frame); baseline.Advance(1.4f - i * .3f, inputs.Target); phases &= Vector3.Distance(copyViews[i].Transform.MultiplyVector(Vector3.right), Views(baseline).Single().Transform.MultiplyVector(Vector3.right)) < .001f; }
Check(phases, "事件出生、局部步骤和复制延迟共同保持对应姿态");
Check(JsonConvert.SerializeObject(source) == original, "所有改造都不改变原操作、输出引用或数组");

Game.Resume(); Config.paused = true; World.world.save_manager.loadWorld(Path.Combine(root, "Scripts/WorldSaveTests/Fixtures/world-format-1")); await Game.NextFrame(); await Game.WaitUntil(() => !SmoothLoader.isLoading(), 3600); Config.paused = true; var runnerType = typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner"); object runner = runnerType.GetProperty("Instance").GetValue(null); async Task Boundary() => await Game.WaitUntil(() => (bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner), 3600); await Boundary();
void Place(Actor actor, float x, float y) { actor.stopMovement(); actor.current_position = new Vector2(x, y); actor.setCurrentTile(World.world.GetTileSimple((int)x, (int)y)); actor.updatePos(); }
var stats = new BaseStats(); stats.addTag("frozen_ai"); stats.addTag("immovable"); var hold = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("test.magnitude-steps.hold").SetStats(stats).SetDuration(10000).Build(); foreach (var unit in World.world.units.getSimpleList().ToArray()) { CombatStatusEffects.ApplyStatus(unit, hold, 10000, unit); Place(unit, 12, 12); }
Actor Make(string name, int x) { var actor = World.world.units.createNewUnit("human", World.world.GetTileSimple(x, 72), pAdultAge: true, pSpawnWithItems: false); actor.data.name = name; actor.addTrait("super_health"); actor.setStatsDirty(); actor.updateStats(); CombatStatusEffects.ApplyStatus(actor, hold, 10000, actor); return actor; }
var actor = Make("命名步骤施放者", 64); var enemy = Make("命名步骤真实目标", 70); var wolf = World.world.units.createNewUnit("wolf", World.world.GetTileSimple(12, 12), pAdultAge: true); enemy.setKingdom(wolf.kingdom); actor.addAggro(enemy); enemy.addAggro(actor); var owner = actor.GetExtend(); owner.AddComponent(new Xian { level = 2, wakan = 100 }); owner.MarkCultiwayStatsDirty(); actor.setStatsDirty(); actor.updateStats(); repeated = ConstructionMagnitudeEdits.Repeat(source, 3, 0, .4f); repeated.Id = "test.magnitude-steps.formal"; ConstructedAbilityService.Register(repeated); ConstructedAbilityService.Learn(owner, repeated.Id); var handle = new ActiveAbilityHandle("content.constructed", owner.E, repeated.Id); var hits = new List<ConstructedContact>(); void Hit(ConstructedContact contact) { if (contact.AbilityId == repeated.Id && contact.SourceId == actor.id) hits.Add(contact); }
ConstructedAbilityService.ContactConfirmed += Hit;
try { float balance = owner.GetCultisys<Xian>().wakan; Check(ActiveAbilityService.TryUse(owner, handle, new ActiveAbilityTarget(enemy, enemy.GetSimPos()), ActiveAbilityUseOrigin.Script) && balance - owner.GetCultisys<Xian>().wakan == 6, "三份命名构造由正式入口一次支付总额6"); balance = owner.GetCultisys<Xian>().wakan; Check(!ActiveAbilityService.TryUse(owner, handle, new ActiveAbilityTarget(enemy, enemy.GetSimPos()), ActiveAbilityUseOrigin.Script) && owner.GetCultisys<Xian>().wakan == balance, "同一构造的独立冷却实际阻止再次支付"); Config.paused = false; double until = World.world.getCurWorldTime() + 3; await Game.WaitUntil(() => World.world.getCurWorldTime() >= until, 3600); Config.paused = true; await Boundary(); Check(hits.Count == 3 && hits.Select(h => h.Node).Distinct().Count() == 3, "三份命名步骤实际独立命中，不是只有资料复制", hits.Select(h => new { h.Node, h.Age }).ToArray()); } finally { ConstructedAbilityService.ContactConfirmed -= Hit; Config.paused = true; }
var saves = Cultiway.ModClass.I.WorldSaves; var sections = (System.Collections.IDictionary)saves.World.GetType().GetField("sections", Flags).GetValue(saves.World); object section = sections["ability_constructions"]; var data = (JObject)section.GetType().GetMethod("Capture", Flags).Invoke(section, new object[] { World.world }); var envelope = new JObject { ["formatVersion"] = 1, ["sections"] = new JObject { ["ability_constructions"] = new JObject { ["version"] = 5, ["data"] = data } } }; saves.World.Restore(World.world, envelope.ToString(), new SaveLoadReport(), "magnitude-steps", item => item.Id == "ability_constructions"); var restored = ConstructionEditing.Access.Read(repeated.Id); Check(restored.Cost == 6 && restored.Steps.Length == 6 && restored.Steps[3].Inputs["part"].Step == "copy_1/launch", "正式恢复保留独立步骤、实际引用和整次费用");
bool Pass(object value) => (bool)value.GetType().GetProperty("pass").GetValue(value); var report = new { passed = checks.All(Pass), checks, process = System.Diagnostics.Process.GetCurrentProcess().Id }; File.WriteAllText(Path.Combine(folder, "checks.json"), JsonConvert.SerializeObject(report, Formatting.Indented)); return new { report.passed, checks = checks.Count };
