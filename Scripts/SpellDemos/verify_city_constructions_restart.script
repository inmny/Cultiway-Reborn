// 另一游戏进程恢复明确城市足迹，继续真正自主工作，并录制过程。
using System;using System.IO;using System.Linq;using System.Reflection;using System.Collections;using System.Collections.Generic;using System.Threading.Tasks;using Newtonsoft.Json;using Newtonsoft.Json.Linq;using UnityEngine;using DebugToolbox.Runtime.Scripting;using Cultiway.Core;using Cultiway.Core.Skills;using Cultiway.Core.CollectiveProjects;using Cultiway.Core.SkillLibV3.ActiveAbilities;using Cultiway.Content.Skills;using Cultiway.Content.Combat;using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Static|BindingFlags.Instance|BindingFlags.Public|BindingFlags.NonPublic;string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/city-constructions");var input=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));var checks=new List<string>();void Check(bool ok,string n){if(!ok)throw new InvalidOperationException(n);checks.Add(n);Log.Info(n);}Check(System.Diagnostics.Process.GetCurrentProcess().Id!=(int)input["process"],"真实退出后使用另一游戏进程恢复城市任务");var stats=new BaseStats();stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.ModClass.L.StatusEffectLibrary.get("Cultiway.CityConstructionHold")??Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.CityConstructionHold").SetStats(stats).SetDuration(10000).Build();var rt=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=rt.GetProperty("Instance").GetValue(null);async Task Boundary()=>await Game.WaitUntil(()=>(bool)rt.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);async Task Advance(float sec){Config.paused=false;double end=World.world.getCurWorldTime()+sec;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=end,3600);Config.paused=true;await Boundary();}
Config.paused=true;Game.Resume();ControllableUnit.clear(false);Config.setWorldSpeed("x1",false);bool build=DebugConfig.isOn(DebugOption.SystemBuildTick);DebugConfig.setOption(DebugOption.SystemBuildTick,false);World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();World.world.console.Hide();foreach(var s in Resources.FindObjectsOfTypeAll<LoadingScreen>())s.gameObject.SetActive(false);long actorId=(long)input["actor"],cityId=(long)input["city"],projectId=(long)input["project"];var actor=World.world.units.get(actorId);Check(actor!=null&&actor.isAlive()&&actor.city?.id==cityId,"正式原版存档恢复人物及城市成员关系");var owner=actor.GetExtend();var saves=Cultiway.ModClass.I.WorldSaves;JToken Section(string text,string key)=>JObject.Parse(text)["sections"][key];Check(JToken.DeepEquals(Section((string)input["world"],"ability_constructions"),Section(saves.World.Capture(World.world,"city"),"ability_constructions")),"完整构造资料恢复，未重新随机生成");Check(JToken.DeepEquals(Section((string)input["person"],"ability_knowledge"),Section(saves.Actors.Capture(owner,"city"),"ability_knowledge")),"已学关系及独立冷却恢复");Check(saves.LastReport.Skipped.Count==0&&saves.LastReport.BackupError==null,"新足迹正式恢复没有局部丢弃或备份错误");Check(CollectiveProjectService.TryGetProject(projectId,out var planned)&&planned.State==CollectiveProjectState.Planned,"保存的待执行工程仍处于可重新认领状态");int[] footprint=(int[])planned.Payload.GetType().GetField("PlannedActionTileIds",F).GetValue(planned.Payload);Check(footprint.Length>0&&footprint.All(id=>id>=0&&id<World.world.tiles_list.Length),"主作用足迹按实际地图编号恢复");Check(footprint.Count(id=>World.world.tiles_list[id].top_type?.wasteland==true)>=8,"正式原版地形中保存的实际救灾需求仍存在");var starts=new List<ConstructedCastStarted>();var ends=new List<ConstructedCastEnded>();var contacts=new List<ConstructedWorldContact>();void Started(ConstructedCastStarted e){if(e.SourceId==actorId)starts.Add(e);}void Ended(ConstructedCastEnded e){if(e.SourceId==actorId)ends.Add(e);}void Contact(ConstructedWorldContact e){if(e.SourceId==actorId)contacts.Add(e);}ConstructedAbilityService.CastStarted+=Started;ConstructedAbilityService.CastEnded+=Ended;ConstructedAbilityService.WorldContactConfirmed+=Contact;int EmergencyCompletions()=>((IEnumerable)typeof(CollectiveProjectService).GetField("CompletionHistory",F).GetValue(null)).Cast<object>().Count(h=>(string)h.GetType().GetProperty("HistoryTag").GetValue(h)=="clean.emergency"&&((CollectiveProjectOwnerKey)h.GetType().GetProperty("Owner").GetValue(h)).OwnerId==cityId);int completedBefore=EmergencyCompletions();var times=new List<double>();try{
await Advance(.5f);Check(starts.Count==0&&ends.Count==0&&contacts.Count==0,"旧进程的施放与结束监听不在读取后重放");string frames=Path.Combine(folder,"frames");if(Directory.Exists(frames))Directory.Delete(frames,true);Directory.CreateDirectory(frames);CombatStatusEffects.RemoveStatus(actor,hold);actor.setStatsDirty();actor.updateStats();double start=World.world.getCurWorldTime(),next=start,finished=-1;Config.paused=false;while(World.world.getCurWorldTime()<start+25){await Game.NextFrame();double now=World.world.getCurWorldTime();if(now>=next){World.world.camera.transform.position=new Vector3(66,79,World.world.camera.transform.position.z);MoveCamera.instance.forceZoom(9);World.world.camera.orthographicSize=9;World.world.setZoomOrthographic(9);new ScreenFacade().Capture(Path.Combine(frames,times.Count.ToString("00000")+".png"));times.Add(now-start);next=now+.1;}if(finished<0&&EmergencyCompletions()>completedBefore)finished=now;if(finished>0&&now>finished+1)break;}Config.paused=true;await Boundary();Check(starts.Any(e=>e.Origin==ActiveAbilityUseOrigin.Autonomous&&e.AbilityId==(string)input["ability"]&&e.CorrelationId>0),"恢复的城市工人自主认领并以新令牌释放已学构造");Check(ends.Any(e=>!e.Cancelled&&e.WorldChanges>0)&&contacts.Any(e=>e.Action=="land.cleanse"&&e.Result.Changed),"真实结束与净化结果来自恢复后的实际施放");Check(EmergencyCompletions()>completedBefore,"恢复需求经当前世界重新规划后，通过原有实际结果验收");Check(footprint.Any(id=>World.world.tiles_list[id].top_type?.wasteland!=true),"原足迹上的真实污染已经清除");CombatStatusEffects.ApplyStatus(actor,hold,10000,actor);actor.setStatsDirty();actor.updateStats();SaveManager.saveWorldToDirectory(Path.Combine(folder,"resave"));int ended=ends.Count;World.world.save_manager.loadWorld(Path.Combine(folder,"resave"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;await Boundary();await Advance(.6f);Check(ends.Count==ended,"完成工程的后续存读档不重复发布旧结束");Check(saves.LastReport.Skipped.Count==0,"再次正式恢复仍无局部丢弃");var result=new{passed=true,checks,starts,ends,contacts,times,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"restart-result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{ConstructedAbilityService.CastStarted-=Started;ConstructedAbilityService.CastEnded-=Ended;ConstructedAbilityService.WorldContactConfirmed-=Contact;DebugConfig.setOption(DebugOption.SystemBuildTick,build);Config.paused=true;File.WriteAllText(Path.Combine(folder,"restart-partial.json"),JsonConvert.SerializeObject(new{checks,starts,ends,contacts,times},Formatting.Indented));}
