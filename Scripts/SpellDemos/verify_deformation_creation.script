Actor source = Make(64); var owner = source.GetExtend(); owner.NewCultisys(Cultisyses.Xian); owner.GetCultisys<Xian>().level = 2;
owner.MarkCultiwayStatsDirty(); source.setStatsDirty(); source.updateStats();
var attempts = new List<object>();
JObject Canon(AbilityDefinition value) { var json = JObject.FromObject(value); json.Remove("Id"); json.Remove("Creator"); return json; }
IEnumerable<ConstructionNode> Nodes(ConstructionNode node)
{
    if (node == null) yield break;
    yield return node;
    foreach (var child in node.Children) foreach (var nested in Nodes(child)) yield return nested;
}
bool HasShape(AbilityDefinition value) => Nodes(value.Root).SelectMany(node => node.Operations).Concat(value.Steps.Select(step => step.Operation))
    .Any(operation => operation.Kind == ConstructionOperationKind.Deform);
try
{
    var inspiration = ConstructedAbilityService.ReadInspiration(owner);
    Check(inspiration.Rules == 24, "当前创法机会冻结自由控制规则24");
    var resources = (SynthesisResources)service.GetMethod("CaptureCreationResources", F).Invoke(null, new object[] { owner, 0, inspiration });
    Check(resources.Forms.All(form => form.Kind != null && form.Controls != null) &&
        resources.DeformationForms.Any(form => form.Id == "fracture_slab") && resources.DeformationForms.All(form => form.Deformable),
        "基础选择顺序之外的其他真实可变模型和控制进入冻结输入");
    var copy = (SynthesisResources)typeof(SynthesisResources).GetMethod("Copy", F).Invoke(resources, null);
    string originalControl = resources.DeformationForms[0].Controls[0]; copy.DeformationForms[0].Controls[0] = "changed.in.copy";
    Check(resources.DeformationForms[0].Controls[0] == originalControl, "冻结控制列表独立复制，其他请求不能改写原输入");
    AbilityDefinition independent = null;
    for (int seed = 0; seed < 96 && independent == null; seed++)
    {
        try
        {
            var made = ConstructedAbilityService.Generate(owner, seed, inspiration, resources: resources);
            attempts.Add(new { seed, shape = HasShape(made) });
            if (HasShape(made)) independent = made;
        }
        catch (InvalidDataException error) { attempts.Add(new { seed, rejected = error.Message }); }
        await Game.NextFrame();
    }
    Check(independent != null && JToken.DeepEquals(Canon(independent), Canon(ConstructedAbilityService.Generate(owner, independent.Seed, inspiration, resources: resources))),
        "修士独立创作实际产生自由形变，固定输入重现完整结构与费用");
    var basis = Definition(); basis.Id = "test.deformation.creation.basis"; basis.Root.Form = "fracture_slab";
    basis.Root.Scale = .1f; basis.Root.Children = Array.Empty<ConstructionNode>(); basis.Root.Operations = Array.Empty<ConstructionOperation>(); basis.Steps = Array.Empty<ConstructionStep>();
    string original = JsonConvert.SerializeObject(basis); AbilityDefinition derived = null;
    for (int seed = 0; seed < 96 && derived == null; seed++)
    {
        var made = ConstructedAbilityService.Generate(owner, seed, inspiration, basis, resources);
        if (made.Parent.Change == "结构形变") derived = made;
        await Game.NextFrame();
    }
    Check(derived != null && HasShape(derived) && derived.Root.Form == "fracture_slab" && JsonConvert.SerializeObject(basis) == original,
        "原术衍生直接改变其他可变模型，保留原部位和原始资料");
    var forming = ConstructionEditing.Copy(basis); forming.Root.Form = "root_network"; forming.Root.Operations = new[]
    { new ConstructionOperation { Kind = ConstructionOperationKind.Animate, Clip = "form", Seconds = 1 } };
    string formingBefore = JsonConvert.SerializeObject(forming); AbilityDefinition following = null;
    for (int seed = 0; seed < 96 && following == null; seed++)
    {
        var made = ConstructedAbilityService.Generate(owner, seed, inspiration, forming, resources);
        if (made.Parent.Change == "结构形变") following = made;
        await Game.NextFrame();
    }
    Check(following != null && following.Steps.Any(step => step.Operation.Kind == ConstructionOperationKind.Deform &&
        step.Inputs.TryGetValue("after", out var reference) && reference.Output == "animation" && reference.Stage == ConstructionOutputStage.Completed) &&
        JsonConvert.SerializeObject(forming) == formingBefore, "已有逐段成形通过实际完成输出再启动形变，原术保持");
    File.WriteAllText(Path.Combine(folder, "independent.json"), JsonConvert.SerializeObject(independent, Formatting.Indented));
    File.WriteAllText(Path.Combine(folder, "basis.json"), JsonConvert.SerializeObject(basis, Formatting.Indented));
    File.WriteAllText(Path.Combine(folder, "derived.json"), JsonConvert.SerializeObject(derived, Formatting.Indented));
    File.WriteAllText(Path.Combine(folder, "formed-then-deformed.json"), JsonConvert.SerializeObject(following, Formatting.Indented));
    return new { passed = true, closed = "冻结自由控制、独立创作及原术衍生", process = System.Diagnostics.Process.GetCurrentProcess().Id };
}
finally
{
    File.WriteAllText(Path.Combine(folder, "attempts.json"), JsonConvert.SerializeObject(attempts, Formatting.Indented));
    ConstructedAbilityService.ContactConfirmed -= Hit; ConstructedAbilityService.CastEnded -= Ended;
    Config.paused = true; ControllableUnit.clear(false);
}
