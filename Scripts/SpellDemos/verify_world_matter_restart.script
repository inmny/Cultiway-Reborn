// 真正退出后的另一个进程：共同水流、逐格份额和跨区整数累计继续；另核对版本1转换。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using Cultiway.Core.Skills;
using Cultiway.Content.Skills;
using Cultiway.Utils.Extension;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/world-matter");var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}var expected=JObject.Parse(File.ReadAllText(Path.Combine(folder,"restart-expected.json")));Check((int)expected["process"]!=System.Diagnostics.Process.GetCurrentProcess().Id,"保存来自真正退出前的另一进程");var saves=Cultiway.ModClass.I.WorldSaves;JObject Section(string json)=>(JObject)JObject.Parse(json)["sections"]["world_materials"];JObject Archive()=>Section(saves.World.Capture(World.world,"world-matter"))["data"] as JObject;
var changes=new List<WorldMaterialChange>();void Event(WorldMaterialChange e)=>changes.Add(e);WorldMaterialService.Changed+=Event;
try{
 Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(folder,"save"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;var before=Section((string)expected["world"]);var after=Archive();Check((int)before["version"]==2,"本批实际保存世界材料版本2");Check(JToken.DeepEquals(before["data"]["RecoveryGroups"],after["RecoveryGroups"]),"跨区域的原资源累计账本完整恢复");var previous=(JArray)before["data"]["Records"];var current=(JArray)after["Records"];Check(previous.Count==current.Count&&(long)before["data"]["Next"]==(long)after["Next"],"区域、来源及稳定编号集合恢复");Check(previous.All(row=>{var r=current.Single(v=>(long)v["Id"]==(long)row["Id"]);return JToken.DeepEquals(JObject.FromObject(row["Material"].ToObject<AbilityMaterialData>()),JObject.FromObject(r["Material"].ToObject<AbilityMaterialData>()))&&new[]{"Lineage","WorldGrid","Provider","Controller","Resource","Recovering","RecoveryGroup","Progress","Confirmed"}.All(k=>JToken.DeepEquals(row[k],r[k]));}),"冰层基底、水深、动量、逐格份额、来源链和实际材料原样恢复");Check(changes.Count==0&&!saves.LastReport.RequiresBackup,"暂停读档不重放转交或入账，有效资料没有丢弃");Check(Cultiway.Core.Visuals.Forms.FormVisualScene.Instances.Any(v=>v.Layer!=null&&v.Layer.Sources>0),"共同水面暂停时立即恢复");
 Check(current.Any(r=>(string)r["Material"]["Matter"]=="water"&&(string)r["Material"]["State"]=="solid"&&(double)r["Material"]["Volume"]>0),"真正冷启动恢复正体积冰层");Check(current.Any(r=>(string)r["Material"]["Matter"]=="iron"&&(string)r["Material"]["State"]=="liquid"),"另一类材料的实际流态恢复");
 var oldCreated=((JArray)JObject.Parse((string)expected["world"])["sections"]["ability_constructions"]["data"]["Definitions"]).Where(d=>((string)d["Id"]).StartsWith("Cultiway.Created.")).ToArray();var restoredDefinitions=(JArray)JObject.Parse(saves.World.Capture(World.world,"world-matter"))["sections"]["ability_constructions"]["data"]["Definitions"];Check(oldCreated.Length==4&&oldCreated.All(d=>restoredDefinitions.Any(r=>JToken.DeepEquals(d,r))),"四份自主创作的来源筛选、输出、容量及创作种子原样恢复");
 var actor=World.world.units.get((long)expected["actor"]);var other=World.world.units.get((long)expected["other"]);Check(actor!=null&&other!=null,"原支付者身份恢复");var holdStats=new BaseStats();holdStats.addTag("frozen_ai");holdStats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.MatterColdHold").SetStats(holdStats).SetDuration(10000).Build();foreach(var person in new[]{actor,other}){Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(person,hold,10000,person);person.setStatsDirty();person.updateStats();}var frozen=current.Where(r=>(string)r["Material"]["State"]=="solid").ToDictionary(r=>(long)r["Id"],r=>r["Material"].ToString(Formatting.None));double until=World.world.getCurWorldTime()+1;Config.paused=false;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;var type=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=type.GetProperty("Instance").GetValue(null);await Game.WaitUntil(()=>(bool)type.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);Check(frozen.All(pair=>((JArray)Archive()["Records"]).Any(r=>(long)r["Id"]==pair.Key&&r["Material"].ToString(Formatting.None)==pair.Value)),"冷启动后冰层保持原形，不被世界水流推进");
 var thaw=JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/范围融冰.json")));thaw.Impact.Targets=Cultiway.Core.SkillLibV3.Usage.SkillUseTargetRelation.Self;ConstructedAbilityService.Register(thaw);ConstructedAbilityService.Learn(other.GetExtend(),thaw.Id);other.stats["mana"]=100;other.setMana(100);Check(Cultiway.Core.SkillLibV3.ActiveAbilities.ActiveAbilityService.TryUse(other.GetExtend(),new Cultiway.Core.SkillLibV3.ActiveAbilities.ActiveAbilityHandle("content.constructed",other.GetExtend().E,thaw.Id),new Cultiway.Core.SkillLibV3.ActiveAbilities.ActiveAbilityTarget(other,other.GetSimPos()),Cultiway.Core.SkillLibV3.ActiveAbilities.ActiveAbilityUseOrigin.Script),"冷启动后仍能通过正式入口解冻");until=World.world.getCurWorldTime()+.6;Config.paused=false;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;await Game.WaitUntil(()=>(bool)type.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);Check(!((JArray)Archive()["Records"]).Any(r=>(string)r["Material"]["Matter"]=="water"&&(string)r["Material"]["State"]=="solid"&&(double)r["Material"]["Volume"]>.0001),"读档后实际解冻清除冰量并重新流动");Check(changes.Any(e=>e.Kind=="matter"&&e.ConvertedVolume>0)&&!changes.Any(e=>e.Kind=="credit"),"读档后转换有实际量且不会重发资源");
 double refundable=((JArray)Archive()["Records"]).Where(r=>(long)r["Provider"]==actor.id).Sum(r=>(double)r["Material"]["Resource"])*.75;var recall=JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/范围凝水.json")));recall.Id="test.world-matter.cold-recall";recall.Name="转换后原份额回收";recall.Lifetime=1.5f;recall.Root.Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Recover,At=.1f,Seconds=.8f,Recovery=new ConstructionRecovery{WorldMaterials=true,Efficiency=.75f}}};ConstructedAbilityService.Register(recall);ConstructedAbilityService.Learn(actor.GetExtend(),recall.Id);actor.GetExtend().GetCultisys<Cultiway.Content.Components.Xian>().wakan=0;actor.stats["mana"]=100;actor.setMana(100);Check(Cultiway.Core.SkillLibV3.ActiveAbilities.ActiveAbilityService.TryUse(actor.GetExtend(),new Cultiway.Core.SkillLibV3.ActiveAbilities.ActiveAbilityHandle("content.constructed",actor.GetExtend().E,recall.Id),new Cultiway.Core.SkillLibV3.ActiveAbilities.ActiveAbilityTarget(actor,actor.GetSimPos()),Cultiway.Core.SkillLibV3.ActiveAbilities.ActiveAbilityUseOrigin.Script),"冷启动后的转换材料仍能由原支付者正式回收");until=World.world.getCurWorldTime()+1.5;Config.paused=false;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;await Game.WaitUntil(()=>(bool)type.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);double granted=changes.Where(e=>e.Kind=="credit"&&e.Provider==actor.id).Sum(e=>e.Granted);Check(refundable>0&&Math.Abs(granted-refundable)<.0001,"冻结、他人解冻和金属熔化后仍按原份额实际回能，不重复支付或多返");Check(!changes.Any(e=>e.Kind=="credit"&&e.Provider==other.id),"原支付者回收时没有领走另一修士的材料份额");
 var result=new{passed=true,checks,process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"restart.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{WorldMaterialService.Changed-=Event;Config.paused=true;}
