// 4.01：由真实游戏系统驱动煞风会话，核对受理、九波接触和结束。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using UnityEngine;
using Friflo.Engine.ECS;
using Cultiway.Core;
using Cultiway.Core.Components;
using Cultiway.Core.Skills;
using Cultiway.Content;
using Cultiway.Content.Components;
using Cultiway.Content.Combat;
using Cultiway.Utils.Extension;
const BindingFlags F = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static |
                       BindingFlags.Instance;
string root = Cultiway.ModClass.I.GetDeclaration().FolderPath;
string folder = Path.Combine(root, "artifacts/skill_rebuild/source-sessions");
Directory.CreateDirectory(folder);
var checks = new List<object>();

void Check(bool pass, string name, object data = null)
{
    checks.Add(new { pass, name, data });
    if (!pass) throw new InvalidOperationException(name);
}

var rt = typeof(ActorExtend).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");
object runner = rt.GetProperty("Instance").GetValue(null);

async Task Boundary() =>
    await Game.WaitUntil(() => (bool)rt.GetProperty("IsAtCycleBoundary").GetValue(runner), 1800);

Game.Resume();
Config.paused = true;
ControllableUnit.clear(false);
Config.setWorldSpeed("x1", false);
World.world.save_manager.loadWorld(Path.Combine(root, "Scripts/WorldSaveTests/Fixtures/world-format-1"));
while (SmoothLoader.isLoading())
{
    Config.paused = true;
    await Game.NextFrame();
}

await Boundary();
var stats = new BaseStats();
stats.addTag("frozen_ai");
stats.addTag("immovable");
var hold = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("test.source-sessions.hold").SetStats(stats)
    .SetDuration(10000).Build();
foreach (var a in World.world.units.getSimpleList().ToArray())
    CombatStatusEffects.ApplyStatus(a, hold, 10000, a);
var boost = Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("test.source-sessions.boost")
    .SetStats(new BaseStats { [BaseStatses.MaxWakan.id] = 10000 }).SetDuration(10000).Build();

ActorExtend Make(int x, int level)
{
    var a = World.world.units.createNewUnit("human", World.world.GetTileSimple(x, 72), pAdultAge: true,
        pSpawnWithItems: false);
    a.addTrait("super_health");
    CombatStatusEffects.ApplyStatus(a, hold, 10000, a);
    CombatStatusEffects.ApplyStatus(a, boost, 10000, a);
    var ae = a.GetExtend();
    ae.AddComponent(new Xian { level = level, wakan = 9000 });
    ae.MarkCultiwayStatsDirty();
    a.setStatsDirty();
    a.updateStats();
    a.restoreHealth(a.getMaxHealth());
    return ae;
}

try
{
    // 渡劫只核对实际会话；逐帧治疗用于让测试人物承受全部九波，不改变风、碰撞或结算。
    var tribulation = Make(80, 3);
    tribulation.AddComponent(new Yuanying { formation = new CoreFormationSnapshot { refinement = 9 } });
    var wind = typeof(ActorExtend).Assembly.GetType("Cultiway.Content.BalefulWindTribulationSkillService");
    var start = wind.GetMethod("Start", F, null, new[] { typeof(ActorExtend) }, null);
    bool Passed() => (bool)wind.GetMethod("IsPassed", F).Invoke(null, new object[] { tribulation });
    Check(
        (bool)start.Invoke(null, new object[] { tribulation }) &&
        !(bool)start.Invoke(null, new object[] { tribulation }), "真实煞风会话正式开始一次，重复启动被拒绝");
    double deadline = World.world.getCurWorldTime() + 40;
    Config.paused = false;
    while (!Passed() && World.world.getCurWorldTime() < deadline)
    {
        tribulation.Base.restoreHealth(tribulation.Base.getMaxHealth());
        await Game.NextFrame();
    }

    Config.paused = true;
    await Boundary();
    var state = wind.GetMethod("CaptureWorldSave", F).Invoke(null, null);
    var records = ((System.Collections.IEnumerable)state.GetType().GetField("Sessions").GetValue(state))
        .Cast<object>();
    var record = records.Single(s => (long)s.GetType().GetField("Actor").GetValue(s) == tribulation.Base.id);
    var resultType = record.GetType();
    var resolved = (int[])resultType.GetField("Resolved").GetValue(record);
    Check(
        Passed() && (bool)resultType.GetField("Completed").GetValue(record) &&
        (int)resultType.GetField("Survived").GetValue(record) == 9 && resolved.Sum() == 45,
        "煞风由真实系统完成九波四十五次接触，实际会话完成后才记录成功", new { resolved });
    wind.GetMethod("Cleanup", F, null, new[] { typeof(ActorExtend) }, null)
        .Invoke(null, new object[] { tribulation });
    Check(!(bool)wind.GetMethod("IsInProgress", F).Invoke(null, new object[] { tribulation }) && !Passed(),
        "正式领取清理后移除煞风完成记录和会话引用");
    var result = new { passed = true, checks, process = System.Diagnostics.Process.GetCurrentProcess().Id };
    File.WriteAllText(Path.Combine(folder, "checks.json"),
        JsonConvert.SerializeObject(result, Formatting.Indented));
    return new { result.passed, checks = checks.Count };
}
finally
{
    Config.paused = true;
    File.WriteAllText(Path.Combine(folder, "partial.json"),
        JsonConvert.SerializeObject(new { checks }, Formatting.Indented));
}
