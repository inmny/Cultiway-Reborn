// 有限连续放电、准确时序、断路恢复、共同预算、中断及正式保存。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using HarmonyLib;
using Cultiway.Core.Skills;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Usage;
using Cultiway.Core.SkillLibV3.Effects;
using Cultiway.Core.EventSystem.Events;
using Cultiway.Core.EventSystem.Systems;
using Cultiway.Content.Skills;
using Cultiway.Content.Components;
using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/conduction-pulses");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}
async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;var t=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=t.GetProperty("Instance").GetValue(null);await Game.WaitUntil(()=>(bool)t.GetProperty("IsAtCycleBoundary").GetValue(runner),3600);}
Config.paused=true;Game.Resume();Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;
for(int y=48;y<100;y++)for(int x=44;x<124;x++)World.world.GetTileSimple(x,y).setTileTypes("sand",null);for(int y=70;y<75;y++)for(int x=60;x<=80;x++)World.world.GetTileSimple(x,y).setTileTypes("shallow_waters",null);
var stats=new BaseStats();stats["mana"]=256;stats["damage"]=40;stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.ConductionPulsesHold").SetStats(stats).SetDuration(10000).Build();
Actor NewActor(int x,int y){var p=World.world.units.createNewUnit("human",World.world.GetTileSimple(x,y),pAdultAge:true,pSpawnWithItems:false);p.addTrait("super_health");p.GetExtend().AddComponent(new Xian{level=2,wakan=100});Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(p,hold,10000,p);p.GetExtend().MarkCultiwayStatsDirty();p.setStatsDirty();p.updateStats();p.setMana(128);return p;}
void Place(Actor p,float x,float y){p.stopMovement();p.current_position=new Vector2(x,y);p.setCurrentTile(World.world.GetTileSimple((int)x,(int)y));p.updatePos();}
var source=NewActor(60,72);source.equipment.setItem(World.world.items.generateItem(AssetManager.items.get("sword_iron"),pActor:source),source);source.setStatsDirty();source.updateStats();var target=NewActor(76,72);var middle=NewActor(68,72);var air=NewActor(70,72);var friend=NewActor(68,90);var wolf=World.world.units.createNewUnit("wolf",World.world.GetTileSimple(12,12),pAdultAge:true);Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(wolf,hold,10000,wolf);foreach(var p in new[]{target,middle,air}){p.setKingdom(wolf.kingdom);source.addAggro(p);p.addAggro(source);}await Advance(.1f);
AbilityDefinition Spell(string name)=>JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/"+name+".json")));
void Learn(Actor actor,AbilityDefinition d){ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(actor.GetExtend(),d.Id);}
bool Fire(Actor actor,Actor to,AbilityDefinition d){Learn(actor,d);return ActiveAbilityService.TryUse(actor.GetExtend(),new ActiveAbilityHandle("content.constructed",actor.GetExtend().E,d.Id),new ActiveAbilityTarget(to,to.GetSimPos()),ActiveAbilityUseOrigin.Script);}
AbilityDefinition Attack(string id){var d=Spell("循水连雷");d.Id=id;d.Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Conduct).At=.2f;return d;}
IList Casts()=>(IList)typeof(ConstructedAbilityService).GetField("casts",F).GetValue(null);AbilityCast Running(string id)=>Casts().Cast<object>().Select(r=>(AbilityCast)r.GetType().GetField("Cast",F).GetValue(r)).Single(c=>c.Plan.Id==id&&!c.Finished);
var waves=new List<ConstructedConduction>();var recovered=new List<ConstructedRecovery>();void Wave(ConstructedConduction e){waves.Add(e);File.WriteAllText(Path.Combine(folder,"waves.json"),JsonConvert.SerializeObject(waves.Select(w=>new{w.AbilityId,w.Pulse,w.Operation,w.WorldTime,w.Spent,w.Remaining,w.Targets,w.HealthBefore,w.HealthAfter,w.WaterCasts}),Formatting.Indented));}void Recovery(ConstructedRecovery e)=>recovered.Add(e);ConstructedAbilityService.ConductionConfirmed+=Wave;ConstructedAbilityService.RecoveryConfirmed+=Recovery;
try{
 var native=Attack("test.pulses.native");Check(Fire(source,target,native),"持剑修士正式支付并开始四波连续放电");await Advance(1.65f);var first=waves.Where(w=>w.AbilityId==native.Id).ToArray();Check(first.Select(w=>w.Pulse).SequenceEqual(new[]{1,2,3,4})&&first.All(w=>w.Targets.Contains(target.id)&&w.Targets.Contains(middle.id)),"原版水面四波均真实作用两人，波序号不重开");Check(first.Zip(first.Skip(1),(a,b)=>Math.Abs(b.WorldTime-a.WorldTime-.4)<.0002).All(v=>v),"每波按共同世界时钟准确间隔，不由渲染帧决定");Check(first.All(w=>w.Targets.Distinct().Count()==w.Targets.Length&&w.HealthBefore.Zip(w.HealthAfter,(a,b)=>a>b).All(v=>v)),"每波人物去重且实际扣血，跨波允许再次作用");Check(first.Skip(1).Select((w,i)=>Math.Abs(first[i].Remaining-w.Spent-w.Remaining)<.0002).All(v=>v),"四波连续扣同一份余力，不重建攻击预算");
 var broken=Attack("test.pulses.break");Check(Fire(source,target,broken),"断路再恢复场景正常施放");await Advance(.35f);for(int y=70;y<75;y++)for(int x=60;x<=80;x++)World.world.GetTileSimple(x,y).setTopTileType(TopTileLibrary.ice);await Advance(.4f);for(int y=70;y<75;y++)for(int x=60;x<=80;x++)World.world.GetTileSimple(x,y).setTopTileType(null);await Advance(.8f);var resumed=waves.Where(w=>w.AbilityId==broken.Id).ToArray();Check(resumed.Select(w=>w.Pulse).SequenceEqual(new[]{1,3,4}),"第二波冻结断路不假造伤害，解冻后用剩余第三及第四波继续");Check(resumed.All(w=>w.Targets.Contains(target.id))&&Math.Abs(resumed[1].WorldTime-resumed[0].WorldTime-.8)<.0002,"恢复水路不重置轮次或补发错过的波");
 var low=Attack("test.pulses.low");low.Power=.01f;Check(Fire(source,target,low),"低余力连续放电仍走正式支付");await Advance(1.6f);var limited=waves.Where(w=>w.AbilityId==low.Id).ToArray();Check(limited.Length>0&&limited.Length<4&&limited.All(w=>w.Targets.Length==0),"不足完整人物消耗的余力不会被多波最低伤害放大");
 Place(source,94,72);Place(target,110,72);Place(middle,102,72);var supply=Spell("活动导电验证水流");target.GetExtend().GetCultisys<Xian>().wakan=target.stats[Cultiway.Content.BaseStatses.MaxWakan.id];Check(Fire(target,target,supply),"另一修士正式支付并维持活动导体");await Advance(1.4f);Place(target,109,72);var water=Running(supply.Id);double volume=water.RemainingVolume(0),budget=water.RemainingResource(0);var shared=Attack("test.pulses.shared");shared.Root.Operations=shared.Root.Operations.Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Recover,At=1.8f,Seconds=.6f,Recovery=new ConstructionRecovery{Efficiency=.75f}}}).ToArray();Check(Fire(source,target,shared),"借活动水体多波放电并收束，正式支付一次");Config.setWorldSpeed("x3",false);await Advance(1.65f);Config.setWorldSpeed("x1",false);var group=waves.Where(w=>w.AbilityId==shared.Id).ToArray();Check(group.Select(w=>w.Pulse).SequenceEqual(new[]{1,2,3,4})&&group.All(w=>w.Targets.Contains(target.id)&&w.Targets.Contains(middle.id)),"游戏加速仍在活动水体中逐波确认实际作用");Check(group.Zip(group.Skip(1),(a,b)=>Math.Abs(b.WorldTime-a.WorldTime-.4)<.0002).All(v=>v),"加速不会把连续放电折叠或拖到同一时点");Check(Math.Abs(water.RemainingVolume(0)-volume)<.002&&Math.Abs(water.RemainingResource(0)-budget)<.0001,"连续电流不领走供水者的水量或原支付");double refund=Math.Floor(8*group.Last().Remaining/(group.First().Remaining+group.First().Spent)*.75+1e-8);await Advance(.9f);Check(recovered.Where(r=>r.AbilityId==shared.Id).Sum(r=>r.Granted)==refund&&refund<6,"连续放电后的收束只返还真实未耗支付份额");
 var own=Spell("流水连雷");own.Id="test.pulses.cancel";own.Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Conduct).At=.2f;Check(Fire(source,middle,own),"同一水体的连续导电正常开始");await Advance(.35f);Running(own.Id).Cancel();await Advance(1.3f);Check(waves.Where(w=>w.AbilityId==own.Id).Select(w=>w.Pulse).SequenceEqual(new[]{1}),"整次取消后不重放后续三波");
 var interrupted=Attack("test.pulses.water-ended");Check(Fire(source,target,interrupted),"供水者终止场景开始连续放电");await Advance(.35f);Cultiway.Content.Combat.CombatStatusEffects.RemoveStatus(target,hold);typeof(Actor).GetMethod("die",F).Invoke(target,new object[]{false,AttackType.Other,true,false});await Advance(1.3f);Check(!target.isAlive()&&waves.Where(w=>w.AbilityId==interrupted.Id).Select(w=>w.Pulse).SequenceEqual(new[]{1}),"供水者真实死亡后，后续波重新检查并停止伤害");
 var created=new List<AbilityDefinition>();foreach(int seed in new[]{58,106,146}){string id=ConstructedAbilityService.Create(source.GetExtend(),seed);var defs=(IDictionary)typeof(ConstructedAbilityService).GetField("definitions",F).GetValue(null);created.Add((AbilityDefinition)defs[id]);}Check(created.Any(d=>d.Root.Operations.Any(o=>o.Kind==ConstructionOperationKind.Conduct&&o.Conduction.Pulses>1)),"修士普通创作可生成有限多波构造");
 var saved=Spell("流水连雷");saved.Id="test.pulses.restored";Learn(source,saved);foreach(var p in World.world.units.dict.Values.ToArray()){Cultiway.Content.Combat.CombatStatusEffects.RemoveStatus(p,hold);p.GetExtend().MarkCultiwayStatsDirty();p.setStatsDirty();p.updateStats();}SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,actor=source.id,target=middle.id,definition=saved,world=Cultiway.ModClass.I.WorldSaves.World.Capture(World.world,"conduction-pulses")},Formatting.Indented));
 var result=new{passed=true,checks,native=first.Select(w=>new{w.Pulse,w.WorldTime,w.Spent,w.Remaining}),shared=group.Select(w=>new{w.Pulse,w.WorldTime,w.Spent,w.Remaining}),refunded=refund};File.WriteAllText(Path.Combine(folder,"runtime.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{ConstructedAbilityService.ConductionConfirmed-=Wave;ConstructedAbilityService.RecoveryConfirmed-=Recovery;Config.setWorldSpeed("x1",false);Config.paused=true;}
