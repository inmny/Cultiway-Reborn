// 正式学习、支付、非默认固体留置、共同层部分凝固与液化、归属及保存。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Cultiway.Core.Skills;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Core.SkillLibV3.Usage;
using Cultiway.Content.Skills;
using Cultiway.Content.Components;
using Cultiway.Utils.Extension;
const BindingFlags F=BindingFlags.Instance|BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/solid-layers");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new Exception(n);checks.Add(n);}
async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,3600);Config.paused=true;var t=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var r=t.GetProperty("Instance").GetValue(null);await Game.WaitUntil(()=>(bool)t.GetProperty("IsAtCycleBoundary").GetValue(r),3600);}
Config.paused=true;Game.Resume();Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;for(int y=30;y<110;y++)for(int x=30;x<120;x++)World.world.GetTileSimple(x,y).setTileTypes("sand",null);
var stats=new BaseStats();stats["mana"]=1024;stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.SolidLayerHold").SetStats(stats).SetDuration(10000).Build();
Actor Actor(int x,int y){var p=World.world.units.createNewUnit("human",World.world.GetTileSimple(x,y),pAdultAge:true,pSpawnWithItems:false);p.GetExtend().AddComponent(new Xian{level=2,wakan=100});Cultiway.Content.Combat.CombatStatusEffects.ApplyStatus(p,hold,10000,p);p.GetExtend().MarkCultiwayStatsDirty();p.setStatsDirty();p.updateStats();p.setMana(512);return p;}var first=Actor(50,50);var second=Actor(90,50);await Advance(.1f);
void Place(Actor p,float x,float y){p.stopMovement();p.current_position=new Vector2(x,y);p.setCurrentTile(World.world.GetTileSimple((int)x,(int)y));p.updatePos();}
AbilityDefinition Read(string name)=>JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/"+name+".json")));
bool Fire(Actor actor,AbilityDefinition d){ConstructedAbilityService.Register(d);ConstructedAbilityService.Learn(actor.GetExtend(),d.Id);return ActiveAbilityService.TryUse(actor.GetExtend(),new ActiveAbilityHandle("content.constructed",actor.GetExtend().E,d.Id),new ActiveAbilityTarget(actor,actor.GetSimPos()),ActiveAbilityUseOrigin.Script);}
JObject Section()=>JObject.Parse(Cultiway.ModClass.I.WorldSaves.World.Capture(World.world,"solid-layers"))["sections"]["world_materials"] as JObject;JArray Rows()=>(JArray)Section()["data"]["Records"];
var events=new List<WorldMaterialChange>();void Changed(WorldMaterialChange e)=>events.Add(e);WorldMaterialService.Changed+=Changed;
try{
foreach(var pair in new[]{(first,"iron"),(second,"wood")}){var d=Read("流水凝固留置");d.Id="test.solid-layers.leave."+pair.Item2;d.Root.Volume=16;d.Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.ConvertMatter).Matter=pair.Item2;Check(Fire(pair.Item1,d),"普通活动水层正式凝成并留下："+pair.Item2);}await Advance(1.8f);
var independent=Rows().Where(r=>!(bool)r["WorldGrid"]).ToArray();Check(independent.Length==2&&independent.All(r=>(bool)r["Material"]["ShapeHeld"]),"两种普通固体留置后保持真实定形状态");Check(independent.All(r=>r["Material"]["Flow"]["Bed"] is JArray&&((JArray)r["Material"]["Flow"]["Water"]).Where((_,i)=>i%3!=0).All(v=>(float)v==0)),"留存金属与木层保存原基底和零内部动量");var held=independent.ToDictionary(r=>(long)r["Id"],r=>r["Material"].DeepClone());await Advance(.4f);Check(held.All(p=>JToken.DeepEquals(p.Value,Rows().Single(r=>(long)r["Id"]==p.Key)["Material"])),"不占用活动施放的固体继续世界时间也不流动");Check((int)Section()["version"]==4,"正式第四版显式记录定形状态");
Place(first,64,72);Place(second,64,72);foreach(var p in new[]{first,second}){var water=Read("跨区留水");water.Id="test.solid-layers.water."+p.id;water.Resource="mana";water.Impact.Targets=SkillUseTargetRelation.Self;water.Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Fly).Vector=new float[3];Check(Fire(p,water),"独立支付后留下共同水源："+p.id);}await Advance(.5f);Check(Rows().Count(r=>(bool)r["WorldGrid"]&&(double)r["Material"]["Volume"]>0)>=2,"两位修士的来源分别接入共同水层");double total=Rows().Sum(r=>(double)r["Material"]["Volume"]),budget=Rows().Sum(r=>(double)r["Material"]["Resource"]);
AbilityDefinition Change(string id,string from,string fromState,string to,string state,float maximum,bool own=false){var d=Read("范围凝水");d.Id=id;d.Root.Operations[0].Matter=to;d.Root.Operations[0].State=state;d.Root.Operations[0].WorldMatter=new ConstructionWorldMatter{FromMatter=from,FromState=fromState,MaximumVolume=maximum,OwnedOnly=own};return d;}
var iron=Change("test.solid-layers.world.iron","water","liquid","iron","solid",8);Check(Fire(first,iron),"普通世界转换接受金属固态输出");await Advance(.3f);var wood=Change("test.solid-layers.world.wood","water","liquid","wood","solid",4);Check(Fire(first,wood),"普通世界转换也接受木质固态输出");await Advance(.3f);
var solids=Rows().Where(r=>(bool)r["WorldGrid"]&&(bool)r["Material"]["ShapeHeld"]&&(double)r["Material"]["Volume"]>0).ToArray();Check(Math.Abs(solids.Where(r=>(string)r["Material"]["Matter"]=="iron").Sum(r=>(double)r["Material"]["Volume"])-8)<.002&&Math.Abs(solids.Where(r=>(string)r["Material"]["Matter"]=="wood").Sum(r=>(double)r["Material"]["Volume"])-4)<.002,"真实部分凝固分别受八格和四格体积上限约束");Check(solids.All(r=>r["Material"]["Flow"]["Bed"] is JArray&&((JArray)r["Material"]["Flow"]["Water"]).Where((_,i)=>i%3!=0).All(v=>(float)v==0)),"共同固态层停止内部动量并保存实际基底");Check(solids.GroupBy(r=>(string)r["Material"]["Matter"]).All(g=>g.Select(r=>(long)r["Provider"]).Distinct().Count()==2),"部分凝固同时保留两位原支付者的混流份额");Check(Math.Abs(Rows().Sum(r=>(double)r["Material"]["Volume"])-total)<.005&&Math.Abs(Rows().Sum(r=>(double)r["Material"]["Resource"])-budget)<.0001,"世界换材保留总材料及全部原支付，不发生退款");
var fixedRows=solids.ToDictionary(r=>(long)r["Id"],r=>r["Material"].DeepClone());await Advance(.3f);Check(fixedRows.All(p=>JToken.DeepEquals(p.Value,Rows().Single(r=>(long)r["Id"]==p.Key)["Material"])),"共同金属和木层不被水流系统继续推进");
object Value(object o,string field)=>o.GetType().GetField(field,F).GetValue(o);var actual=((IDictionary)typeof(WorldMaterialService).GetField("rows",F).GetValue(null)).Values.Cast<object>().Where(r=>(bool)Value(r,"WorldGrid")&&!(bool)Value(r,"Finished")).ToArray();int supported=0;foreach(var group in actual.Where(r=>(bool)Value(Value(r,"Material"),"ShapeHeld")).GroupBy(r=>((AbilityMatter)Value(Value(r,"Material"),"Matter")).Id+":"+((Vector2)Value(Value(Value(r,"Material"),"Flow"),"Origin")).ToString())){var sources=group.ToArray();var flow=Value(Value(sources[0],"Material"),"Flow");var origin=(Vector2)Value(flow,"Origin");for(int i=0;i<256;i++){float depth=sources.Sum(r=>((Vector3[])Value(Value(Value(r,"Material"),"Flow"),"Water"))[i].x);if(depth<=0)continue;float top=((float[])Value(flow,"Ground"))[i]+depth;foreach(var r in actual.Where(r=>!(bool)Value(Value(r,"Material"),"ShapeHeld"))){var f=Value(Value(r,"Material"),"Flow");if((Vector2)Value(f,"Origin")!=origin||((Vector3[])Value(f,"Water"))[i].x<=0)continue;if(((float[])Value(f,"Ground"))[i]+.0001f<top)throw new Exception("液体实际基底穿入固体表面");supported++;}}}Check(supported>0,"本次确有液体与普通固态层共存的承托格");
var thaw=Change("test.solid-layers.world.thaw","iron","solid","water","liquid",3,true);Check(Fire(second,thaw),"另一修士可以只液化自己原份额中的金属层");await Advance(.3f);var ownIron=Rows().Where(r=>(bool)r["WorldGrid"]&&(long)r["Provider"]==second.id&&(string)r["Material"]["Matter"]=="iron").Sum(r=>(double)r["Material"]["Volume"]);Check(Math.Abs(ownIron-1)<.002,"限定归属只液化本人的三格，另一人的金属份额不变");Check(Math.Abs(Rows().Where(r=>(bool)r["WorldGrid"]&&(long)r["Provider"]==first.id&&(string)r["Material"]["Matter"]=="iron").Sum(r=>(double)r["Material"]["Volume"])-4)<.002,"操作者不能取走其他原支付者的固态份额");Check(events.Any(e=>e.Kind=="matter"&&e.AbilityId==thaw.Id&&e.ConvertedVolume>0)&&!events.Any(e=>e.Kind=="credit"),"液化记录同次正式转换及实际体积，不伪造回能");
foreach(var p in World.world.units.dict.Values.ToArray()){Cultiway.Content.Combat.CombatStatusEffects.RemoveStatus(p,hold);p.GetExtend().MarkCultiwayStatsDirty();p.setStatsDirty();p.updateStats();}SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,first=first.id,second=second.id,world=Cultiway.ModClass.I.WorldSaves.World.Capture(World.world,"solid-layers")},Formatting.Indented));Check(File.Exists(Path.Combine(folder,"save/map.wbox")),"非默认固态、共同层和来源份额完成真实保存");var result=new{passed=true,checks,supported,events=events.Select(e=>new{e.Id,e.Provider,e.Kind,e.Matter,e.State,e.ConvertedVolume,e.CastId,e.AbilityId}),process=System.Diagnostics.Process.GetCurrentProcess().Id};File.WriteAllText(Path.Combine(folder,"runtime.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
}finally{WorldMaterialService.Changed-=Changed;Config.paused=true;}
