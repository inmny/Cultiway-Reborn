// 固定真实人物输入检查逐部位生成，记录实际结构而不是只比较名称和倍率。
using System;using System.IO;using System.Linq;using System.Collections.Generic;using System.Reflection;using Newtonsoft.Json;using Newtonsoft.Json.Linq;using Cultiway.Core;using Cultiway.Core.Skills;using Cultiway.Core.Visuals.Forms;using UnityEngine;using Cultiway.Core.Components;using Cultiway.Const;using Cultiway.Content.Components;using Cultiway.Content.Skills;using Cultiway.Content.Extensions;using Cultiway.Utils.Extension;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/synthesis");Directory.CreateDirectory(folder);var checks=new List<string>();void Check(bool v,string n){if(!v)throw new InvalidOperationException(n);checks.Add(n);Log.Info(n);}Config.paused=true;Game.Resume();World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;
var actor=World.world.units.createNewUnit("human",World.world.GetTileSimple(60,72),pAdultAge:true,pSpawnWithItems:false);actor.addTrait("super_health");var owner=actor.GetExtend();owner.AddComponent(new Xian{level=2,wakan=10000});actor.setStatsDirty();actor.updateStats();var access=ConstructionEditing.Access;int before=access.List().Count;var natural=ConstructedAbilityService.ReadInspiration(owner);Check(natural.Rules==2,"当前真实活动默认选择逐部位创作规则");
IEnumerable<ConstructionNode> Nodes(ConstructionNode n){if(n==null)yield break;yield return n;foreach(var c in n.Children)foreach(var v in Nodes(c))yield return v;}int Depth(ConstructionNode n)=>n==null?0:1+(n.Children.Length==0?0:n.Children.Max(Depth));JObject Canon(AbilityDefinition d){var j=JObject.Parse(JsonConvert.SerializeObject(d));j.Remove("Id");return j;}string Structure(ConstructionNode n)=>n==null?"":n.Form+":"+n.Matter+":"+n.ContactRole+":"+n.Anchor+":"+n.Activation?.Trigger+":"+string.Join(",",n.Operations.Select(o=>o.Kind+(o.When==null?"":":"+o.When.Trigger)))+"["+string.Join(";",n.Children.Select(Structure))+"]";
ActorExtend Make(string species,int x,int element){var a=World.world.units.createNewUnit(species,World.world.GetTileSimple(x,72),pAdultAge:true,pSpawnWithItems:false);a.addTrait("super_health");var e=a.GetExtend();e.AddComponent(new Xian{level=2,wakan=10000});var values=new float[ElementIndex.Count];values[element]=2;e.AddComponent(new ElementRoot(values));e.MarkCultiwayStatsDirty();a.setStatsDirty();a.updateStats();return e;}var owners=new[]{owner,Make("human",64,ElementIndex.Water),Make("human",68,ElementIndex.Wood),Make("wolf",72,ElementIndex.Iron)};var inputs=owners.Select(ConstructedAbilityService.ReadInspiration).ToArray();Check(inputs[1].Elements.water>inputs[1].Elements.wood&&inputs[2].Elements.wood>inputs[2].Elements.water&&!inputs[3].CanProject,"水木修士和非人身体的实际资料进入不同创作输入");foreach(string form in new[]{"sword","hand","branch","water_flow","water_wave","water_whale","fire_body"}){var resource=FormResources.Load(form);Vector3 V(float[] a)=>new Vector3(a[0],a[1],a[2]);Check(resource.RestSize>0&&(resource.Facing*V(resource.Description.Forward).normalized-Vector3.forward).sqrMagnitude<.00001f&&(resource.Facing*V(resource.Description.Up).normalized-Vector3.up).sqrMagnitude<.00001f,form+"制作前上向和绑定姿态实际尺寸有效");}
var wave=FormResources.Load("water_wave");var description=JsonConvert.DeserializeObject<FormDescription>(JsonConvert.SerializeObject(wave.Description));description.Forward=new float[3];try{typeof(FormResource).GetConstructors(BindingFlags.Instance|BindingFlags.NonPublic).Single(c=>c.GetParameters().Length==3).Invoke(new object[]{description,wave.Meshes,typeof(FormResource).GetField("Generation",BindingFlags.Instance|BindingFlags.NonPublic).GetValue(wave)});throw new Exception("零前向未拒绝");}catch(TargetInvocationException invalidFrame){Check(invalidFrame.InnerException is InvalidDataException,"无效制作坐标在资源读取边界拒绝");}
var signatures=new HashSet<string>();var errors=new List<object>();var examples=new Dictionary<string,AbilityDefinition>();var forms=new HashSet<string>();var materials=new HashSet<string>();var operations=new HashSet<string>();int largest=0,deepest=0;int cache=AbilityCompiler.CachedPlans;var clock=System.Diagnostics.Stopwatch.StartNew();
for(int profile=0;profile<inputs.Length;profile++)for(int seed=0;seed<256;seed++)try{
 var d=ConstructedAbilityService.Generate(owners[profile],seed,inputs[profile]);var plan=AbilityCompiler.Compile(d,false);var nodes=Nodes(d.Root).ToArray();void Sizes(ConstructionNode n,float inherited){float size=inherited*n.Scale;if(n.ContactRole!=ConstructionContactRole.Decoration){float actual=size*FormResources.Load(n.Form).RestSize;if(actual<.79f||actual>4.01f)throw new Exception("部位的实际地图尺寸越界："+actual);}foreach(var child in n.Children)Sizes(child,size);}Sizes(d.Root,1);largest=Math.Max(largest,plan.FormCount);deepest=Math.Max(deepest,Depth(d.Root));signatures.Add(Structure(d.Root));foreach(var n in nodes){forms.Add(n.Form);if(n.ContactRole!=ConstructionContactRole.Decoration)materials.Add(n.Matter);foreach(var o in n.Operations)operations.Add(o.Kind.ToString());}
 void Example(string key,bool eligible){if(eligible&&!examples.ContainsKey(key)&&!examples.Values.Any(prior=>prior.Seed==d.Seed&&prior.Creator==d.Creator)){examples[key]=d;File.WriteAllText(Path.Combine(folder,key+".json"),JsonConvert.SerializeObject(d,Formatting.Indented));}}
 Example("nested",Depth(d.Root)>=3&&nodes.Select(n=>n.Matter).Distinct().Count()>=3);Example("event",nodes.Any(n=>n.Activation!=null));Example("curve",nodes.Any(n=>n.Operations.Any(o=>o.Path!=null)));Example("body",d.Body!=null&&nodes.Length>3);Example("flow",nodes.Any(n=>n.Operations.Any(o=>o.Kind==ConstructionOperationKind.Flow)));Example("barrier",nodes.Any(n=>n.ContactRole==ConstructionContactRole.Barrier));Example("conversion",nodes.Any(n=>n.Operations.Any(o=>o.Kind==ConstructionOperationKind.ConvertMatter)));
 if(seed<4&&!JToken.DeepEquals(Canon(d),Canon(ConstructedAbilityService.Generate(owners[profile],seed,inputs[profile]))))throw new Exception("相同输入不确定");
 }catch(Exception e){if(errors.Count<20)errors.Add(new{profile,seed,error=e.Message});}
clock.Stop();var measurements=new{profiles=owners.Select((e,i)=>new{actor=e.Base.id,species=e.Base.asset.id,input=inputs[i]}).ToArray(),samples=inputs.Length*256,errors,structures=signatures.Count,largest,deepest,forms,materials,operations,examples=examples.Keys,elapsedMs=clock.Elapsed.TotalMilliseconds,cacheBefore=cache,cacheAfter=AbilityCompiler.CachedPlans};File.WriteAllText(Path.Combine(folder,"generation.json"),JsonConvert.SerializeObject(measurements,Formatting.Indented));Check(errors.Count==0,"1024份固定输入均经过同一正式编译，没有重抽掩盖失败");Check(signatures.Count>128&&deepest>=4&&largest<=13,"生成不同层次和连接结构，明确展开预算和实际地图尺寸");Check(forms.Count>=7&&materials.Count==5&&examples.Count==7,"实际结果覆盖形体、材料、嵌套、事件、曲线、身体、流散、屏障和换材");Check(!Nodes(examples["event"].Root).Any(n=>n.Anchor?.EndsWith("*")==true),"真实挂点逐个指定，不用通配符放大展开");Check(access.List().Count==before&&AbilityCompiler.CachedPlans==cache,"批量草稿不登记世界能力，也不留下长期编译计划");Check(inputs[3].CanProject==false&&Enumerable.Range(0,32).All(seed=>ConstructedAbilityService.Generate(owner,seed,inputs[3]).Body==null),"不支持显化的身体不会被随机授予借手动作");
var invalid=ConstructionEditing.Copy(examples["nested"]);invalid.Root.Form="missing.synthesis.form";try{ConstructedAbilityService.Create(owner,1,natural,invalid);throw new Exception("未拒绝缺失形体");}catch(FileNotFoundException e){Check(e.Message.Contains("missing.synthesis.form"),"缺失资源明确报告实际编号");}catch(InvalidDataException e){Check(e.Message.Contains("missing.synthesis.form"),"缺失资源明确报告实际编号");}Check(access.List().Count==before&&access.List(owner).Count==0,"无效输入在正式登记和授予前拒绝");
var result=new{passed=true,checks,measurements};File.WriteAllText(Path.Combine(folder,"structure-result.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
