// 真实分件、当前姿态、余力交接、反射、回退和正式交锋，独立保存世界。
using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Collections;
using System.Collections.Generic;
using System.Threading.Tasks;
using Newtonsoft.Json;
using UnityEngine;
using Cultiway.Core;
using Cultiway.Core.Skills;
using Cultiway.Core.Visuals.Forms;
using Cultiway.Core.SkillLibV3.ActiveAbilities;
using Cultiway.Content.Skills;
using Cultiway.Content.Combat;
using Cultiway.Content.Components;
using Cultiway.Utils.Extension;
const BindingFlags Flags=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;
string root=Cultiway.ModClass.I.GetDeclaration().FolderPath,folder=Path.Combine(root,"artifacts/skill_rebuild/fracture");Directory.CreateDirectory(folder);
var checks=new List<string>();void Check(bool value,string name){if(!value)throw new InvalidOperationException(name);checks.Add(name);}
void Reject(AbilityDefinition d,string name){try{AbilityCompiler.Compile(d);}catch(InvalidDataException){checks.Add(name);return;}throw new InvalidOperationException(name);}
AbilityDefinition Read(string name)=>JsonConvert.DeserializeObject<AbilityDefinition>(File.ReadAllText(Path.Combine(root,"Doc/技能系统全面重构/构造输入/"+name+".json")));
AbilityDefinition Basic()=>new AbilityDefinition{Id="test.fracture.base",Resource="none",Cost=0,Lifetime=5,Root=new ConstructionNode{Id="sword",Form="sword",Matter="iron",Offset=new[]{2f,1f,4f},Rotation=new[]{0f,90f,0f},Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Fly,Vector=new[]{3f,0f,0f},WorldVelocity=true},new ConstructionOperation{Kind=ConstructionOperationKind.Fracture,When=new ConstructionCondition{Trigger=ConstructionChangeTrigger.ForceBelow,Threshold=.8f},Fracture=new ConstructionFracture{Speed=0,Spin=0,Gravity=0,ActiveParts=new[]{"blade"}}}}}};
AbilityCast Cast(AbilityDefinition d)=>new(AbilityCompiler.Compile(d),Matrix4x4.identity,inputs:new AbilityInputs(Vector3.zero,Vector3.right*16,Vector3.right,1),force:20);
List<FormVisualInstance> Views(AbilityCast cast){var list=new List<FormVisualInstance>();cast.AppendVisuals(list);return list;}
List<AbilityCapsule> Contacts(AbilityCast cast){var list=new List<AbilityCapsule>();cast.AppendContacts(list);return list;}
void Confirm(AbilityCast cast,int node,float amount)=>typeof(AbilityCast).GetMethod("ConfirmClash",Flags).Invoke(cast,new object[]{node,cast.ContactOrigin(node),amount});
void Spend(AbilityCast cast,int node,float amount)=>typeof(AbilityCast).GetMethod("ConsumeForce",Flags).Invoke(cast,new object[]{node,amount,null,0});
void Clash(AbilityCast cast,int node,float amount){Confirm(cast,node,amount);Spend(cast,node,amount);}
var d=Basic();var c=Cast(d);Check(c.Plan.FormCount==5&&Views(c).Count==1,"编译预留四个真实分件，未碎解前只显示完整剑体");Check(Enumerable.Range(1,4).All(i=>c.NodeAge(i)<0),"等待中的碎片没有提前生效");c.Advance(.3f,Vector3.zero);var before=Views(c).Single();Clash(c,0,5);var pieces=Views(c);Check(pieces.Count==4&&pieces.All(p=>p.Resource.Meshes.Length==1),"真实损耗后按四个不同几何分件碎解，原整物退出");for(int part=0;part<4;part++){var piece=pieces.Single(p=>p.Resource.Description.Parts[0].Id==before.Resource.Description.Parts[part].Id);Check(ReferenceEquals(piece.Resource.Meshes[0],before.Resource.Meshes[part]),"分件共享真实原网格："+piece.Resource.Description.Parts[0].Id);Check(piece.PartTransform(0)==before.PartTransform(part),"出生姿态与原分件完全一致："+piece.Resource.Description.Parts[0].Id);}
Check(c.RemainingForce(0)==0&&Mathf.Abs(Enumerable.Range(1,4).Sum(c.RemainingForce)-15)<.00001f,"主体清零，分件只继承真实扣减后的十五点余力");var bladeContacts=Contacts(c);int bladeShapes=pieces.Single(piece=>piece.Resource.Description.Parts[0].Id=="blade").Resource.Description.Contacts.Length;Check(bladeShapes>0&&bladeContacts.Count==bladeShapes&&bladeContacts.All(shape=>shape.Node==1),"仅明确的剑刃继续作用，护手和握柄等不添加攻击形状");Check(Mathf.Abs(c.Velocity(1).x-3)<.001f,"碎片继承最近稳定数值步的实际平移");var atBirth=pieces[0].Transform;c.Advance(.2f,Vector3.zero);Check(Mathf.Abs(Views(c)[0].Transform.m03-atBirth.m03-.6f)<.001f,"片体继续运动时保持几何坐标，不因重心重定位跳变");c.Advance(2f,Vector3.zero);Check(c.Finished&&Views(c).Count==0,"碎片存在窗口结束后完整回收");
var pending=Basic();pending.Root.Operations[1].When=new ConstructionCondition{Trigger=ConstructionChangeTrigger.Clash};c=Cast(pending);c.Advance(.3f,Vector3.zero);Confirm(c,0,5);Check(Views(c).Count==1&&c.RemainingForce(0)==20,"交锋通知尚未扣减时不会提前分配完整作用量");Spend(c,0,5);Check(Views(c).Count==4&&Enumerable.Range(1,4).Sum(c.RemainingForce)==15,"完成本次真实扣减后才分件交接");
c=Cast(d);c.Advance(.2f,Vector3.zero);Clash(c,0,20);Check(Views(c).Count==4&&Contacts(c).Count==0&&Enumerable.Range(1,4).All(i=>c.RemainingForce(i)==0),"完全耗尽仍有无害碎片，零余力不会变成最低伤害");
c=Cast(pending);c.Advance(.3f,Vector3.zero);typeof(AbilityCast).GetMethod("Reflect",Flags).Invoke(c,new object[]{0,Vector3.right,Vector3.zero,new Vector3(-8,0,0)});Confirm(c,0,0);Check(Views(c).Count==4&&Enumerable.Range(1,4).All(i=>c.Reflections(i)==1),"没有扣减的反射交锋直接按反射后状态碎解");Check(c.Velocity(1).x< -2.99f,"反射后的碎片继承新方向，不沿用反射前点运动");
var animated=Basic();animated.Root.Form="water_whale";animated.Root.Matter="water";animated.Root.Tint=new[]{.6f,.8f,1f};animated.Root.Operations[1].Fracture.ActiveParts=new[]{"body"};animated.Root.Operations=animated.Root.Operations.Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Animate,Clip=FormResources.Load("water_whale").Description.Motions[0].Id},new ConstructionOperation{Kind=ConstructionOperationKind.ConvertMatter,Matter="ice",When=new ConstructionCondition{Trigger=ConstructionChangeTrigger.Clash}}}).ToArray();c=Cast(animated);c.Advance(1.1f,Vector3.zero);before=Views(c).Single();Clash(c,0,5);pieces=Views(c);Check(pieces.Count==7&&pieces.All(p=>p.Matter.Id=="ice"&&p.Dye==before.Dye),"七个骨架分件继承交锋后实际冰态和染色");bool poseEqual=true;foreach(var piece in pieces){int index=Array.FindIndex(before.Resource.Description.Parts,p=>p.Id==piece.Resource.Description.Parts[0].Id);poseEqual&=piece.PartTransform(0)==before.PartTransform(index);for(int control=0;control<before.Skin.Length;control++)poseEqual&=piece.Skin[control]==before.Skin[control];}Check(poseEqual,"曲面、鳍及眼部保留当时完整骨架姿态，没有退回绑定模型");
var nested=Basic();nested.Root.Children=new[]{new ConstructionNode{Id="twig",Form="branch",Matter="wood",Anchor="tip",Scale=.4f}};c=Cast(nested);c.Advance(.4f,Vector3.zero);Clash(c,0,5);Check(Views(c).Count==5&&Views(c).Any(v=>v.Resource.Description.Id=="branch"),"已经存在的附属枝体按合同脱落并保持自己的材料");c.Advance(.1f,Vector3.zero);Check(Views(c).Any(v=>v.Resource.Description.Id=="branch"),"原主体结束后已经脱离的附属结构继续存在");nested.Root.Operations[1].Fracture.ReleaseChildren=false;c=Cast(nested);c.Advance(.4f,Vector3.zero);Clash(c,0,5);Check(Views(c).Count==4&&!Views(c).Any(v=>v.Resource.Description.Id=="branch"),"明确选择结束依赖时不会偷偷保留原附属结构");
var gathered=Basic();gathered.Root=new ConstructionNode{Id="assembly",Form="pivot",ContactRole=ConstructionContactRole.Decoration,Children=new[]{gathered.Root}};var subject=gathered.Root.Children[0];subject.Operations=subject.Operations.Where(o=>o.Kind!=ConstructionOperationKind.Fly).Concat(new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Gather,At=0,Seconds=.8f,Vector=new[]{4f,0f,4f}}}).ToArray();c=Cast(gathered);c.Advance(.5f,Vector3.zero);before=Views(c).Single();Clash(c,1,5);Check(Views(c).Count==4&&Views(c).All(v=>v.Transform==before.Transform),"聚合途中的主体可按实际中途姿态碎解，不跳到目标布局");
var saved=Cast(pending);saved.Advance(.3f,Vector3.zero);typeof(AbilityCast).GetMethod("SaveStep",Flags).Invoke(saved,null);Clash(saved,0,5);saved.Advance(.4f,Vector3.zero);var expected=Views(saved).Select(v=>v.Transform).ToArray();typeof(AbilityCast).GetMethod("RestoreStep",Flags).Invoke(saved,null);Check(Views(saved).Count==1&&saved.NodeAge(1)<0,"预测回退恢复原整物及尚未出生的分件");Clash(saved,0,5);saved.Advance(.4f,Vector3.zero);Check(Views(saved).Select(v=>v.Transform).SequenceEqual(expected)&&Enumerable.Range(1,4).Sum(saved.RemainingForce)==15,"回退后碎解时点、重心、运动和余力完全一致");
var timed=Basic();timed.Root.Operations[1].When=null;timed.Root.Operations[1].At=.6f;c=Cast(timed);c.Advance(.59f,Vector3.zero);Check(Views(c).Count==1,"定时碎解不会提前发生");c.Advance(.6f-c.Age,Vector3.zero);Check(Views(c).Count==4,"定时碎解在共同边界进入同一分件执行");
var ground=Basic();ground.Root.Operations=ground.Root.Operations.Where(o=>o.Kind==ConstructionOperationKind.Fracture).ToArray();ground.Root.Operations[0].When=null;ground.Root.Operations[0].At=.1f;ground.Root.Operations[0].Fracture.Gravity=4;ground.Root.Operations[0].Fracture.Seconds=4;ground.Root.Offset=new[]{0f,0f,1f};c=Cast(ground);c.Advance(1.3f,Vector3.zero);var landed=Views(c).Select(v=>v.Transform).ToArray();c.Advance(.3f,Vector3.zero);Check(Views(c).Select(v=>v.Transform).SequenceEqual(landed),"有作用及仅装饰分件都能着地，之后不因中心坐标重复偏移");
var plain=Basic();plain.Root.Operations=plain.Root.Operations.Where(o=>o.Kind!=ConstructionOperationKind.Fracture).ToArray();Check(typeof(AbilityCast).GetField("fractures",Flags).GetValue(Cast(plain))==null,"普通施放不分配碎解状态或分件运动数组");var bad=Basic();bad.Root.Operations[1].Fracture.ActiveParts=new[]{"grip"};Reject(bad,"没有作用形状的握柄不能冒充攻击碎片");bad=Basic();bad.Root.Operations[1].Fracture.ActiveParts=new[]{"missing"};Reject(bad,"未知真实分件在共同入口拒绝");bad=Basic();bad.Root.Operations[1].Fracture.Seconds=0;Reject(bad,"无效碎片窗口在共同入口拒绝");bad=Basic();bad.Root.Operations[1].Fracture.Spin=8000;Reject(bad,"超过动作预算的转动在创建边界拒绝");
var adjusted=ConstructionMagnitudeEdits.Duration(Basic(),2).Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Fracture).Fracture;Check(adjusted.Seconds==4&&adjusted.Speed==0&&adjusted.Spin==0,"完整历时改造同步延长碎片存在时间");var moving=Basic();moving.Root.Operations[1].Fracture.Speed=2;moving.Root.Operations[1].Fracture.Spin=80;moving.Root.Operations[1].Fracture.Gravity=4;adjusted=ConstructionMagnitudeEdits.Duration(moving,2).Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Fracture).Fracture;Check(adjusted.Speed==1&&adjusted.Spin==40&&adjusted.Gravity==1,"完整历时按一次及平方比例改变碎片速度和下落");adjusted=ConstructionMagnitudeEdits.Haste(moving,2).Root.Operations.Single(o=>o.Kind==ConstructionOperationKind.Fracture).Fracture;Check(adjusted.Seconds==2&&adjusted.Speed==4&&adjusted.Spin==160&&adjusted.Gravity==16,"急速改造保留窗口并同步改变碎片数值运动");bad=Basic();bad.Root.Children=Enumerable.Range(0,25).Select(i=>new ConstructionNode{Id="piece_"+i,Form="sword",Operations=new[]{new ConstructionOperation{Kind=ConstructionOperationKind.Fracture,At=.5f,Fracture=new ConstructionFracture{ActiveParts=new[]{"blade"}}}}}).ToArray();Reject(bad,"隐藏碎片同样计入共同128部位预算");
var sword=Read("破锋余刃");var wood=Read("断枝散落");var swordWard=Read("碎锋验证护锋");var woodWard=Read("断枝验证护锋");
Config.paused=true;Game.Resume();Config.setWorldSpeed("x1",false);World.world.save_manager.loadWorld(Path.Combine(root,"Scripts/WorldSaveTests/Fixtures/world-format-1"));await Game.WaitUntil(()=>!SmoothLoader.isLoading(),1800);Config.paused=true;
var runnerType=typeof(AbilityCast).Assembly.GetType("Cultiway.Core.Performance.CooperativeSimulationRunner");var runner=runnerType.GetProperty("Instance").GetValue(null);bool Boundary()=>(bool)runnerType.GetProperty("IsAtCycleBoundary").GetValue(runner);await Game.WaitUntil(Boundary,1800);
var stats=new BaseStats();stats.addTag("frozen_ai");stats.addTag("immovable");var hold=Cultiway.Core.Libraries.StatusEffectAsset.StartBuild("Cultiway.SpellDemo.MotionHold").SetStats(stats).SetDuration(10000).Build();
void Place(Actor a,float x,float y){a.stopMovement();a.current_position=new Vector2(x,y);a.setCurrentTile(World.world.GetTileSimple((int)x,(int)y));a.updatePos();}
foreach(var a in World.world.units.getSimpleList().ToArray()){CombatStatusEffects.ApplyStatus(a,hold,10000,a);a.setStatsDirty();a.updateStats();Place(a,12,12);}
Actor Make(string name,int x,int y){var a=World.world.units.createNewUnit("human",World.world.GetTileSimple(x,y),pAdultAge:true,pSpawnWithItems:false);a.data.name=name;a.addTrait("super_health");CombatStatusEffects.ApplyStatus(a,hold,10000,a);a.setStatsDirty();a.updateStats();a.attack_timer=999;Place(a,x,y);return a;}
var actor=Make("阈值过程创造者",64,72);var first=Make("第一接触目标",72,72);var wolf=World.world.units.createNewUnit("wolf",World.world.GetTileSimple(12,12),pAdultAge:true);CombatStatusEffects.ApplyStatus(wolf,hold,10000,wolf);
foreach(var enemy in new[]{first}){enemy.setKingdom(wolf.kingdom);actor.addAggro(enemy);enemy.addAggro(actor);}var owner=actor.GetExtend();owner.AddComponent(new Xian{level=2,wakan=10000});

var rival=first.GetExtend();rival.AddComponent(new Xian{level=2,wakan=10000});foreach(var definition in new[]{sword,wood}){ConstructedAbilityService.Register(definition);ConstructedAbilityService.Learn(owner,definition.Id);}foreach(var definition in new[]{swordWard,woodWard}){ConstructedAbilityService.Register(definition);ConstructedAbilityService.Learn(rival,definition.Id);}
async Task Advance(float seconds){Config.paused=false;double until=World.world.getCurWorldTime()+seconds;await Game.WaitUntil(()=>World.world.getCurWorldTime()>=until,1800);Config.paused=true;await Game.WaitUntil(Boundary,1800);}
bool Fire(AbilityDefinition definition,Actor from,Actor to)=>ActiveAbilityService.TryUse(from.GetExtend(),new ActiveAbilityHandle("content.constructed",from.GetExtend().E,definition.Id),new ActiveAbilityTarget(to,to.GetSimPos()),ActiveAbilityUseOrigin.Script);
var contacts=new List<ConstructedContact>();var clashes=new List<ConstructedClash>();void Hit(ConstructedContact contact){if(contact.SourceId==actor.id)contacts.Add(contact);}void Meet(ConstructedClash clash){if(clash.LeftSource==actor.id||clash.RightSource==actor.id)clashes.Add(clash);}ConstructedAbilityService.ContactConfirmed+=Hit;ConstructedAbilityService.ClashConfirmed+=Meet;
try{Place(first,80,72);foreach(var pair in new[]{new[]{sword,swordWard},new[]{wood,woodWard}}){var definition=pair[0];int priorClashes=clashes.Count;float balance=owner.GetCultisys<Xian>().wakan,other=rival.GetCultisys<Xian>().wakan;Check(Fire(pair[1],first,actor)&&Fire(definition,actor,first),definition.Name+"攻守双方均由正式已学入口受理");await Advance(definition.Lifetime+.3f);Check(balance-owner.GetCultisys<Xian>().wakan==definition.Cost&&other-rival.GetCultisys<Xian>().wakan==pair[1].Cost,definition.Name+"只结算双方原本的一次支付");Check(clashes.Count>priorClashes&&contacts.Any(h=>h.AbilityId==definition.Id&&h.Node>0&&h.TargetId==first.id),definition.Name+"真实交锋后由独立分件实际命中目标");}}
finally{ConstructedAbilityService.ContactConfirmed-=Hit;ConstructedAbilityService.ClashConfirmed-=Meet;Config.paused=true;}
var created=new List<AbilityDefinition>();for(int seed=0;seed<24;seed++)created.Add(ConstructionEditing.Access.Read(ConstructedAbilityService.Create(owner,seed)));bool HasFracture(ConstructionNode node)=>node!=null&&(node.Operations.Any(o=>o.Kind==ConstructionOperationKind.Fracture)||node.Children.Any(HasFracture));Check(created.Any(a=>HasFracture(a.Root)),"修士创作使用同一真实分件碎解资料");
foreach(var unit in World.world.units.getSimpleList())foreach(var state in unit.GetExtend().GetStatuses().ToArray())if(state.GetComponent<Cultiway.Core.Components.StatusComponent>().Type.id==hold.id)unit.GetExtend().RemoveSharedStatus(state);
SaveManager.saveWorldToDirectory(Path.Combine(folder,"save"));var saves=Cultiway.ModClass.I.WorldSaves;File.WriteAllText(Path.Combine(folder,"restart-expected.json"),JsonConvert.SerializeObject(new{process=System.Diagnostics.Process.GetCurrentProcess().Id,actor=actor.id,rival=first.id,world=saves.World.Capture(World.world,"fracture"),person=saves.Actors.Capture(owner,"fracture"),opponent=saves.Actors.Capture(rival,"fracture")},Formatting.Indented));
var result=new{passed=true,checks,created=created.Count,fractured=created.Count(a=>HasFracture(a.Root)),contacts=contacts.Select(h=>new{h.AbilityId,h.CastId,h.Node,h.TargetId,h.Age}).ToArray(),clashes=clashes.Select(h=>new{h.LeftCast,h.RightCast,h.LeftRemaining,h.RightRemaining,h.Absorbed}).ToArray()};File.WriteAllText(Path.Combine(folder,"checks.json"),JsonConvert.SerializeObject(result,Formatting.Indented));return result;
